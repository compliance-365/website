---
// src/pages/contact.astro
import Base from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const base = import.meta.env.BASE_URL || '/';

// 🔗 Your AWS API Gateway endpoint
const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';
---
<Base title="Contact — Compliance365" description="Ask a question or request a call. We'll reply within 1 business day.">
  <Section title="Contact us">
    <div class="card">
      <p>
        Email us at <a href="mailto:info@compliance365.com.au">info@compliance365.com.au</a>
        or use the form below.
      </p>

      <!-- 🚫 No action attribute -> JS will POST to Lambda -->
      <form id="contactForm" novalidate>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <input id="inputName" name="name" placeholder="Your name" required
                 autocomplete="name"
                 style="padding:12px;border-radius:10px;border:1px solid #d8dde8">
          <input id="inputEmail" name="email" type="email" placeholder="Work email" required
                 autocomplete="email"
                 style="padding:12px;border-radius:10px;border:1px solid #d8dde8">
        </div>

        <input id="inputSubject" name="subject" placeholder="Subject"
               style="margin-top:12px;padding:12px;border-radius:10px;border:1px solid #d8dde8;width:100%">
        <textarea id="inputMessage" name="message" placeholder="How can we help?" rows="6"
                  style="margin-top:12px;padding:12px;border-radius:10px;border:1px solid #d8dde8;width:100%"></textarea>

        <p id="contactError" class="small" style="color:#b91c1c;display:none;margin:.4rem 0 0"></p>

        <button id="contactSubmit" class="btn btn-primary" style="margin-top:12px" type="submit">
          Send
        </button>
      </form>

      <p class="muted" style="font-size:.9rem;margin-top:10px">
        We’ll respond within 1 business day. By submitting, you agree to our
        <a href={base + 'privacy'}>Privacy Policy</a>.
      </p>
    </div>
  </Section>

  <script is:inline>
    const API_URL = "{API_URL}";
    const form  = document.getElementById('contactForm');
    const btn   = document.getElementById('contactSubmit');
    const errEl = document.getElementById('contactError');

    function validEmail(v){ return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v); }

    form.addEventListener('submit', async (e)=>{
      e.preventDefault();
      errEl.style.display = 'none';
      const name    = (document.getElementById('inputName').value || '').trim();
      const email   = (document.getElementById('inputEmail').value || '').trim();
      const subject = (document.getElementById('inputSubject').value || '').trim();
      const message = (document.getElementById('inputMessage').value || '').trim();

      if(name.length < 2){ errEl.textContent = 'Please enter your full name.'; errEl.style.display = 'block'; return; }
      if(!validEmail(email)){ errEl.textContent = 'Please enter a valid work email.'; errEl.style.display = 'block'; return; }

      btn.disabled = true;

      try{
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, subject, message })
        });

        if(!res.ok){
          throw new Error('Request failed: ' + res.status);
        }

        alert('Your message has been submitted successfully! We will get back to you soon.');
        form.reset();
      }catch(err){
        console.error(err);
        errEl.textContent = 'There was an error submitting the form. Please try again.';
        errEl.style.display = 'block';
      }finally{
        btn.disabled = false;
      }
    });
  </script>
</Base>
