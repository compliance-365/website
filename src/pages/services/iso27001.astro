---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// CTA (use your global pattern)
const ctaUrl   = base + 'book';    // or Calendly if you prefer
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 27001 Certification Support',
  serviceType: 'ISO 27001 Certification',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso27001',
  description:
    'Get your ISMS certified in 8–12 weeks. Gap assessment, policies, risk, Statement of Applicability, internal audit and audit readiness — with automated evidence in Microsoft 365 & SharePoint.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does ISO 27001 certification take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most SMBs complete in 8–12 weeks with a tight scope and automated evidence in Microsoft 365.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need to buy a new platform?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We embed process and automation inside your Microsoft 365 stack so evidence lives in SharePoint.'
      }
    },
    {
      '@type': 'Question',
      name: 'What’s included in your ISO 27001 engagement?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Gap assessment, policy suite, risk register, Statement of Applicability, control implementation, internal audit, and audit readiness with the certifying body.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do you help with audits?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We prepare evidence packs, handle auditor Q&A and guide interviews. We can also perform annual internal audits.'
      }
    }
  ]
};
---

<Base
  title="ISO 27701 (Privacy) — Compliance365"
  description="Extend your ISMS with a PIMS: DPIAs, ROPAs, privacy controls and training mapped to ISO 27701."
  schema={{
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://www.compliance365.com.au/services/iso27701#service",
        "name": "ISO 27701 (Privacy) Consulting",
        "url": "https://www.compliance365.com.au/services/iso27701",
        "description": "Extend your ISMS with a Privacy Information Management System (PIMS): DPIAs, ROPAs, privacy controls and awareness — aligned to ISO 27701.",
        "provider": {
          "@type": "Organization",
          "name": "Compliance365",
          "url": "https://www.compliance365.com.au"
        },
        "areaServed": { "@type": "Country", "name": "Australia" },
        "offers": {
          "@type": "Offer",
          "url": "https://www.compliance365.com.au/services/iso27701",
          "priceCurrency": "AUD",
          "availability": "https://schema.org/InStock"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://www.compliance365.com.au/services/iso27701#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is ISO 27701?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "ISO 27701 extends ISO 27001 with privacy controls to build a Privacy Information Management System (PIMS)."
            }
          },
          {
            "@type": "Question",
            "name": "What deliverables do you include?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "DPIA framework, ROPA and lifecycle, privacy controls, third-party management, training and audit-ready evidence."
            }
          }
        ]
      }
    ]
  }}
>
  <Header />

  <!-- HERO -->
  <section class="container section">
    <div class="grid-2" style="align-items:center">
      <div>
        <h1>ISO 27001 Certification</h1>
        <p class="muted">
          Most ISO 27001 projects drag on with endless workshops and manual evidence. We deliver a
          <strong>certified ISMS in 8–12 weeks</strong> — and keep auditors happy by
          <strong>automating evidence inside Microsoft 365 &amp; SharePoint</strong>.
          <em>No new tools. No wasted effort.</em>
        </p>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px">
          <span class="pill">Gap assessment</span>
          <span class="pill">Policies &amp; ISMS</span>
          <span class="pill">Risk register</span>
          <span class="pill">Statement of Applicability</span>
          <span class="pill">Internal audit</span>
          <span class="pill">Audit readiness</span>
        </div>

        <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
          <a class="btn btn-ghost" href={base + 'case-studies'}>See ISO 27001 results</a>
          <a class="btn btn-ghost" href={base + 'checklist/iso27001'}>Try the readiness checklist</a>
        </div>
      </div>

      <div class="card" style="padding:0;overflow:hidden;border-radius:22px">
        <img src={(import.meta.env.BASE_URL)+'assets/illus-iso27001.svg'} alt="ISO 27001 ISMS flow and audit evidence in SharePoint" style="width:100%;height:auto"/>
      </div>
    </div>
  </section>

  <!-- OUTCOMES -->
  <section class="container section">
    <h2>Outcomes you can count on</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>Certified faster</h3>
        <p class="muted">Clear scope, week-by-week plan and velocity. SMBs typically certify in <strong>8–12 weeks</strong>.</p>
      </div>
      <div class="card">
        <h3>Auditor-ready evidence</h3>
        <p class="muted">Automations pull artefacts from <strong>SharePoint, Entra, Defender, Purview, Intune &amp; Sentinel</strong>.</p>
      </div>
      <div class="card">
        <h3>No new platform</h3>
        <p class="muted">Evidence lives in <strong>Microsoft 365</strong> where your team already works — no duplicate tools or licenses.</p>
      </div>
    </div>
  </section>

  <!-- WHAT’S INCLUDED -->
  <section class="container section">
    <h2>What’s included</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>Gap assessment</h3>
        <p class="muted">Scope, context, risk profile, roadmap and resourcing plan aligned to ISO&nbsp;27001:2022.</p>
      </div>
      <div class="card">
        <h3>Policies &amp; ISMS</h3>
        <p class="muted">Policy suite, objectives, roles, awareness and governance cadence (management review).</p>
      </div>
      <div class="card">
        <h3>Risk &amp; SoA</h3>
        <p class="muted">Risk register, treatment plan, control selection and <strong>Statement of Applicability</strong> (Annex A).</p>
      </div>
      <div class="card">
        <h3>Implementation</h3>
        <p class="muted">Control build with automated evidence capture and task tracking in SharePoint/Teams.</p>
      </div>
      <div class="card">
        <h3>Internal audit</h3>
        <p class="muted">Independent internal audit with findings and corrective actions (CAPA).</p>
      </div>
      <div class="card">
        <h3>Audit readiness</h3>
        <p class="muted">Liaison with the certifying body, evidence packs, interview prep and support.</p>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="container section">
    <h2>Timeline</h2>
    <div class="card">
      <p class="muted" style="margin:0">
        <strong>Week 1–2:</strong> Gap, scope, plan • 
        <strong>Week 3–6:</strong> Policies, risk, SoA, control build • 
        <strong>Week 7–8:</strong> Internal audit • 
        <strong>Week 9–12:</strong> Remediation &amp; external audit
      </p>
    </div>
  </section>

  <!-- FAQ (on-page + JSON-LD) -->
  <section class="container section">
    <h2>ISO 27001 FAQs</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>How long does it take?</h3>
        <p class="muted">Most SMBs complete in <strong>8–12 weeks</strong> when scope is tight and evidence is automated.</p>
      </div>
      <div class="card">
        <h3>Do we need a new platform?</h3>
        <p class="muted"><strong>No.</strong> We embed in Microsoft 365 and store evidence in SharePoint with retention/versioning.</p>
      </div>
      <div class="card">
        <h3>Can you handle audits?</h3>
        <p class="muted">Yes — evidence packs, auditor Q&amp;A and interviews. We also run annual internal audits.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Ready to certify ISO 27001?</h3>
        <p class="muted" style="margin:0">We’ll map your shortest path — and automate the evidence.</p>
      </div>
      <a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
    </div>
  </section>

  <Footer />

</Base>
