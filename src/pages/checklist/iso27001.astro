---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27001 (Information Security)';

// ── Environment capture (Stage 1) ─────────────────────────
const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–100','100–500','500–1,000','Over 1,000'] },
  { id: 'env-licensing',label: 'Microsoft licensing tier',             type: 'select', required: false, options: ['Microsoft 365 E5','Microsoft 365 E3','Microsoft 365 Business Premium','Microsoft 365 Business Standard','No Microsoft 365','Not sure'] },
  { id: 'trigger',      label: 'What is prompting you to look at ISO 27001 now?', type: 'select', required: true, options: ['Enterprise customer requiring certification','Government tender or procurement gate','Cyber insurance renewal','Investor or board requirement','Recent security incident or near-miss','Internal initiative — no external pressure yet','Other / multiple drivers'] },
  { id: 'timeline',     label: 'When do you need to be audit-ready?', type: 'select', required: false, options: ['Within 3 months','3–6 months','6–12 months','12+ months','No fixed deadline'] },
];

// ── Questions — 15 sharpened, 4 sections ───────────────────
const QUESTIONS = [
  // Governance
  { id:'isms-scope',  group:'gov',      label:'ISMS scope is defined and approved — covering locations, systems, services, and explicit exclusions', hint:'A clear scope statement is the first thing an auditor checks. Vague or missing scope is the most common Stage 1 finding.', examples:['One-page scope statement listing sites, cloud environments, core systems, and customer-facing services in scope','Diagram showing boundaries — e.g. "Production AWS + corporate M365 in scope; personal devices and lab environments out"','Documented exclusions with justification and any compensating controls'] },
  { id:'leadership',  group:'gov',      label:'Top management has assigned roles, committed resources, and is visibly engaged in security governance', hint:'Auditors want evidence that security is owned at executive level — not just delegated to IT.', examples:['ISMS governance chart showing sponsor, ISMS owner, risk owners, and control owners','Leadership-approved policy statement and management review minutes showing security on the agenda','Resourcing decisions (budget, roles, priorities) tied to documented security risks'] },
  { id:'policy',      group:'gov',      label:'Information security policy and supporting policies are current, approved, communicated, and reviewed periodically', hint:'Policies must be version-controlled, dated, and demonstrably acknowledged by staff.', examples:['InfoSec policy with version control, approval date, and next review date documented','Supporting policies covering access control, incident response, change management, supplier security, and acceptable use','Evidence of communication — intranet links, staff acknowledgements, onboarding training records'] },
  { id:'risk-method', group:'gov',      label:'Risk assessment methodology is defined and applied consistently — with criteria, scoring, and risk appetite documented', hint:'Repeatability matters more than complexity. The same method should produce comparable results regardless of who runs the assessment.', examples:['Risk matrix with likelihood and impact definitions, plus scoring guidance for each level','Documented risk acceptance thresholds — who can approve risks at what level','Worked example showing two assessors producing comparable ratings using the methodology'] },
  // Controls & SoA
  { id:'risk-register', group:'controls', label:'A live risk register is maintained — with named owners, treatment plans, due dates, and review cadence', hint:'Auditors look for a register that is actively maintained — not a spreadsheet last updated at certification.', examples:['Risk register entries showing description, affected assets, owner, treatment plan, due date, and current status','Monthly or quarterly review cadence with updates and decisions documented','Linked evidence — tickets, remediation plans, change records, or signed risk acceptance forms'] },
  { id:'soa',         group:'controls', label:'Statement of Applicability is complete — included/excluded controls, justifications, status, owner, and evidence pointers', hint:'The SoA is the audit index. A weak SoA undermines an otherwise strong ISMS.', examples:['Each Annex A control marked applicable / not applicable with documented justification','Implementation status (Implemented / In Progress / Excluded) and named control owner','Direct link to evidence location — SharePoint folder path, configuration export, or system report'] },
  { id:'assets',      group:'controls', label:'Information assets and systems are inventoried, classified, and have assigned owners', hint:'You need to know what you have and what matters most before you can prioritise protection.', examples:['Asset inventory covering applications, infrastructure, data stores, endpoints, and key SaaS tools','Data classification or "crown jewels" register identifying critical systems and sensitive data','Lifecycle process — onboarding, periodic review, and retirement documented'] },
  { id:'access',      group:'controls', label:'Access control is governed — joiner/mover/leaver process, role-based access, MFA, and privileged access controls', hint:'Access reviews and privileged access governance are among the most heavily sampled controls in ISO 27001 audits.', examples:['Documented joiner/mover/leaver process with timelines, approvals, and audit trail','Role-based access groups with periodic access reviews — quarterly for sensitive systems','Privileged access separated, with MFA, just-in-time elevation (e.g. Entra PIM), and centralised logging'] },
  { id:'suppliers',   group:'controls', label:'Third-party and supplier security is governed — risk tiering, contract clauses, and ongoing review', hint:'Supply chain risk is increasingly scrutinised — especially after SolarWinds, Log4j, and MOVEit.', examples:['Vendor risk assessment process tiering suppliers by criticality and data access','Contract clauses covering security obligations, breach notification, audit rights, and sub-processor controls','Annual review of critical suppliers — SOC reports, ISO certificates, questionnaires, incident history'] },
  // Operations & resilience
  { id:'logging',  group:'ops',   label:'Centralised security logging and alerting is in place for identity, endpoints, cloud, and critical applications', hint:'Logs must support both detection and investigation. Without log retention and review evidence, controls fail audit testing.', examples:['Centralised logging covering Entra/SSO, endpoints, cloud audit logs, and key applications','Alert rules for high-risk patterns — impossible travel, admin role changes, excessive failed logins','Documented log retention period and access controls; evidence of alert review and triage'] },
  { id:'vulns',    group:'ops',   label:'A repeatable vulnerability management process is in place — scanning, patching, prioritisation, and verified closure', hint:'Auditors want to see SLAs being met or exceptions being managed — not just that scanning happens.', examples:['Regular vulnerability scanning across infrastructure and applications, with documented frequency and scope','Patch SLAs (e.g. critical within 14 days) with a documented exception process','Remediation tracking — tickets and evidence that high/critical vulnerabilities are resolved or formally accepted'] },
  { id:'incident', group:'ops',   label:'Incident response plan is documented, tested, and improved after exercises or real incidents', hint:'Plans that have never been tested often fail when needed. A tabletop exercise outcome is strong evidence.', examples:['Incident response runbook covering roles, severity levels, escalation paths, and contact list','Tabletop exercise outcomes with lessons learned and an action plan','Post-incident review records showing improvements made after incidents or near-misses'] },
  { id:'backups',  group:'ops',   label:'Backups are configured, monitored, and restore-tested — with RTO and RPO targets aligned to business needs', hint:'Untested backups are not evidence — auditors will sample restore test records.', examples:['Defined RTO and RPO per critical system','Backup schedule, scope, and monitoring/alerts for failed jobs','Documented restore tests and DR/BCP exercises with outcomes and improvements'] },
  // Audit & improvement
  { id:'internal-audit',    group:'audit', label:'Internal ISMS audits are performed against a plan — with findings tracked to verified closure', hint:'Internal audit is mandatory under ISO 27001. The audit must cover all clauses and a sample of Annex A controls.', examples:['Annual internal audit plan covering ISO 27001:2022 clauses 4–10 and a rotating sample of Annex A controls','Audit reports with findings, root cause, corrective actions, owners, and due dates','Evidence that corrective actions are verified closed — not just marked "done"'] },
  { id:'management-review', group:'audit', label:'Management reviews are held at planned intervals — covering risks, incidents, KPIs, audit results, and improvements', hint:'Management review minutes are mandatory evidence and one of the first documents auditors request.', examples:['Management review agenda and minutes covering all required ISO 27001 inputs','Recorded decisions on resourcing, policy changes, risk acceptance, and improvement priorities','Action register with owners, due dates, and closure tracking'] },
];

const GROUPS = [
  { key:'gov',      title:'Governance & ISMS Foundation',  blurb:'Scope, leadership, policy, and risk methodology.', icon:'📋' },
  { key:'controls', title:'Annex A Controls & SoA',         blurb:'Controls, SoA, assets, access, and supplier risk.', icon:'🔐' },
  { key:'ops',      title:'Security Operations & Resilience', blurb:'Logging, vulnerabilities, incidents, backups.', icon:'🛡️' },
  { key:'audit',    title:'Audit, Measurement & Improvement', blurb:'Internal audit and management review.', icon:'📊' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="Free ISO 27001 Readiness Checklist — Score Your ISMS in 15 Minutes | Compliance365"
  description="Interactive ISO 27001:2022 readiness assessment. Score your ISMS across governance, risk, controls, operations, and audit — and download a prioritised PDF roadmap."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#1e40af;margin-bottom:1rem;">Free Readiness Assessment</p>
      <h1>ISO 27001 Readiness Checklist</h1>
      <p class="section-lead muted" style="max-width:760px;">
        Score your Information Security Management System against ISO 27001:2022 in 15 minutes. Tell us about your environment, answer 15 sharpened questions, and download a branded PDF roadmap with your top gaps and recommended next steps.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#1e40af;color:white;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill" data-stage="2" style="flex:1;min-width:140px;background:#e2e8f0;color:#64748b;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill" data-stage="3" style="flex:1;min-width:140px;background:#e2e8f0;color:#64748b;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#f8fafc;padding:2rem 0;border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">⏱️</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">~15 minutes</strong><p class="muted small" style="margin:2px 0 0;">15 sharpened questions across 4 ISMS domains, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">🎯</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">Mapped to ISO 27001:2022</strong><p class="muted small" style="margin:2px 0 0;">Calibrated to clauses 4–10 and Annex A controls — the same criteria certification auditors sample.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">📄</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top gaps, and a prioritised 90-day action plan. Emailed copy + instant download.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN -->
  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- ───── STAGE 1: Environment ───── -->
      <div id="stage-1" class="stage">
        <div class="card" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0f172a;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} data-required={field.required ? 'true' : 'false'} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} data-required={field.required ? 'true' : 'false'} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} data-required={field.required ? 'true' : 'false'} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">— Select an option —</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>

          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>

          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #e2e8f0;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment →</button>
          </div>
        </div>
      </div>

      <!-- ───── STAGE 2: Questions ───── -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;" id="stage-2-grid">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #e2e8f0;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="font-size:1.5rem;">{grp.icon}</span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0f172a;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:#1e40af;">0/{grpQs.length}</div>
                    </div>
                  </div>

                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #f1f5f9;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:#eff6ff;color:#1e40af;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0f172a;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:#1e40af;font-size:0.8rem;font-weight:600;">View evidence examples →</summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                            <button type="button" class="opt" data-v="2" style="padding:8px 18px;border:1px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.85rem;">✓ Yes</button>
                            <button type="button" class="opt" data-v="1" style="padding:8px 18px;border:1px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.85rem;">~ Partial</button>
                            <button type="button" class="opt" data-v="0" style="padding:8px 18px;border:1px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.85rem;">✗ No</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;">← Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #f1f5f9;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:#1e40af;line-height:1;">—</div>
                <div id="readiness-band" style="font-size:0.85rem;color:#64748b;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:#374151;font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#cbd5e1;">—</span>
                    </div>
                    <div style="background:#f1f5f9;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#cbd5e1;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #f1f5f9;">
                <div style="font-size:0.75rem;color:#64748b;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#f1f5f9;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#1e40af;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ───── STAGE 3: Confirmation ───── -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">✓</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://calendly.com/matt-nicholas-compliance365/30min" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = "ISO 27001 (Information Security)";
      const API_URL  = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

      // Mirror server data on the client
      const GROUPS = [
        { key:'gov',      title:'Governance & ISMS Foundation' },
        { key:'controls', title:'Annex A Controls & SoA' },
        { key:'ops',      title:'Security Operations & Resilience' },
        { key:'audit',    title:'Audit, Measurement & Improvement' },
      ];

      const QUESTIONS = [
        { id:'isms-scope',        group:'gov',      label:'ISMS scope is defined and approved — covering locations, systems, services, and explicit exclusions' },
        { id:'leadership',        group:'gov',      label:'Top management has assigned roles, committed resources, and is visibly engaged in security governance' },
        { id:'policy',            group:'gov',      label:'Information security policy and supporting policies are current, approved, communicated, and reviewed periodically' },
        { id:'risk-method',       group:'gov',      label:'Risk assessment methodology is defined and applied consistently — with criteria, scoring, and risk appetite documented' },
        { id:'risk-register',     group:'controls', label:'A live risk register is maintained — with named owners, treatment plans, due dates, and review cadence' },
        { id:'soa',               group:'controls', label:'Statement of Applicability is complete — included/excluded controls, justifications, status, owner, and evidence pointers' },
        { id:'assets',            group:'controls', label:'Information assets and systems are inventoried, classified, and have assigned owners' },
        { id:'access',            group:'controls', label:'Access control is governed — joiner/mover/leaver, role-based access, MFA, and privileged access controls' },
        { id:'suppliers',         group:'controls', label:'Third-party and supplier security is governed — risk tiering, contract clauses, and ongoing review' },
        { id:'logging',           group:'ops',      label:'Centralised security logging and alerting is in place for identity, endpoints, cloud, and critical applications' },
        { id:'vulns',             group:'ops',      label:'A repeatable vulnerability management process is in place — scanning, patching, prioritisation, and verified closure' },
        { id:'incident',          group:'ops',      label:'Incident response plan is documented, tested, and improved after exercises or real incidents' },
        { id:'backups',           group:'ops',      label:'Backups are configured, monitored, and restore-tested — with RTO and RPO targets aligned to business needs' },
        { id:'internal-audit',    group:'audit',    label:'Internal ISMS audits are performed against a plan — with findings tracked to verified closure' },
        { id:'management-review', group:'audit',    label:'Management reviews are held at planned intervals — covering risks, incidents, KPIs, audit results, and improvements' },
      ];

      const TOTAL_Q = QUESTIONS.length;

      // State
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        // Stage transitions
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#1e40af' : (s < n ? '#16a34a' : '#e2e8f0');
            p.style.color = (s <= n) ? 'white' : '#64748b';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Stage 1 → 2
        document.getElementById('to-stage-2').addEventListener('click', () => {
          let valid = true;
          document.querySelectorAll('.env-field').forEach(wrap => {
            const id = wrap.dataset.fieldId;
            const inp = wrap.querySelector('input, select');
            if (!inp) return;
            env[id] = inp.value.trim();
            if (inp.dataset.required === 'true' && !env[id]) {
              valid = false;
              inp.style.borderColor = '#dc2626';
            } else {
              inp.style.borderColor = '#cbd5e1';
            }
          });
          const err = document.getElementById('env-error');
          if (!valid) { err.style.display = 'block'; err.scrollIntoView({behavior:'smooth', block:'center'}); return; }
          err.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        // Click-to-answer
        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white';
              o.style.color = '#0f172a';
              o.style.borderColor = '#cbd5e1';
            });
            btn.classList.add('active');
            // Colour by value
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'white'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'white'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        // Reset
        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white';
            o.style.color = '#0f172a';
            o.style.borderColor = '#cbd5e1';
          });
          update();
        });

        // PDF generation
        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true;
          btn.textContent = 'Generating…';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
          } catch (err) {
            console.error(err);
            alert('Something went wrong — your PDF should still have downloaded.');
          } finally {
            btn.disabled = false;
            btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => {
          if (state[id] !== null) { answered++; sum += state[id]; }
        });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { key: 'na', label: 'Not started', desc: 'Answer questions to score', color: '#64748b' };
        if (score >= 86) return { key: 'cr', label: 'Certification-Ready', desc: 'Strong posture — focus on validation and audit packaging', color: '#16a34a' };
        if (score >= 61) return { key: 'nar', label: 'Nearly Audit-Ready', desc: 'Close minor gaps and focus on evidence packaging', color: '#1e40af' };
        if (score >= 31) return { key: 'pr', label: 'Partially Ready', desc: 'Many core elements in place — focus and prioritisation needed', color: '#d97706' };
        return { key: 'hr', label: 'High Risk', desc: 'Missing foundational controls — structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#cbd5e1';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);

        // Overall
        document.getElementById('overall-score').textContent = answered === 0 ? '—' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? ' — ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        // Per-section
        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#f1f5f9';
            el.style.color = a === total ? '#166534' : '#475569';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) {
              bar.style.width = '0%'; bar.style.background = '#cbd5e1';
              pctEl.textContent = '—'; pctEl.style.color = '#cbd5e1';
            } else {
              bar.style.width = pct + '%'; bar.style.background = barColor(pct);
              pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct);
            }
          }
        });

        // Enable PDF
        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone;
        btn.style.cursor = allDone ? 'pointer' : 'not-allowed';
        btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone
          ? 'Click to generate and email your report'
          : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
      }

      // Submit to AWS Lambda
      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const sectionScores = GROUPS.map(g => ({ title: g.title, ...computeSection(g.key) }));

        const lines = [];
        lines.push('=== ISO 27001 READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Microsoft licensing: ${env['env-licensing'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Audit-ready timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        sectionScores.forEach(s => lines.push(`  ${s.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`));
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          const label = v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED';
          lines.push(`[${label}] ${q.label}`);
        });

        const payload = {
          name: env['contact-name'] || env['org-name'] || 'Anonymous',
          email: env['contact-email'] || 'noreply@compliance365.com.au',
          subject: `ISO 27001 Checklist — ${env['org-name'] || 'Anonymous'} — ${score}%`,
          message: lines.join('\n'),
        };

        try {
          await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.warn('API submission failed:', err);
        }
      }

// ===========================================================
      // PDF Generation — branded, multi-page, executive-ready
      // ===========================================================
      function generatePDF() {
        const { jsPDF } = window.jspdf || {};
        if (!jsPDF) { alert('PDF library not loaded.'); return; }

        const doc = new jsPDF('p', 'mm', 'a4');
        const W = 210, H = 297, LM = 14, RM = 14;
        let y = 16;

        const NAVY = [15, 23, 42];
        const BLUE = [30, 64, 175];
        const LIGHT_BLUE = [186, 230, 253];
        const GREY = [100, 116, 139];
        const LIGHT = [241, 245, 249];
        const GREEN = [22, 163, 74];
        const AMBER = [217, 119, 6];
        const RED = [220, 38, 38];

        const { score, answered } = compute();
        const band = getBand(score, answered);

        function colorForPct(p) {
          if (p === null || p === undefined) return GREY;
          if (p >= 75) return GREEN;
          if (p >= 50) return AMBER;
          return RED;
        }

        function ensure(needed) {
          if (y + needed > H - 20) {
            doc.addPage();
            footer();
            y = 16;
          }
        }

        function footer() {
          const pNum = doc.internal.getNumberOfPages();
          doc.setFontSize(8);
          doc.setTextColor(...GREY);
          doc.text('Compliance365 · ISO 27001 Readiness Report', LM, H - 8);
          doc.text(`Page ${pNum}`, W - RM, H - 8, { align: 'right' });
        }

        // ─── Cover Page ─────────────────────────────────────
        doc.setFillColor(...NAVY);
        doc.rect(0, 0, W, H, 'F');
        doc.setFillColor(...BLUE);
        doc.rect(0, 0, W, 3, 'F');

        // Brand mark
        doc.setFillColor(255, 255, 255);
        doc.roundedRect(LM, 25, 22, 22, 3, 3, 'F');
        doc.setTextColor(...BLUE);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(11);
        doc.text('365', LM + 11, 39, { align: 'center' });

        doc.setTextColor(255, 255, 255);
        doc.setFontSize(11);
        doc.setFont('helvetica', 'bold');
        doc.text('COMPLIANCE365', LM + 28, 33);
        doc.setFontSize(8);
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(...LIGHT_BLUE);
        doc.text('Cyber · Privacy · AI Governance', LM + 28, 40);

        // Title
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(11);
        doc.setFont('helvetica', 'normal');
        doc.text('READINESS ASSESSMENT REPORT', LM, 90);

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(28);
        doc.text('ISO 27001:2022', LM, 105);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(16);
        doc.setTextColor(...LIGHT_BLUE);
        doc.text('Information Security Management', LM, 115);

        // Org block
        doc.setDrawColor(...BLUE);
        doc.setLineWidth(1);
        doc.line(LM, 145, LM + 25, 145);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.setTextColor(...LIGHT_BLUE);
        doc.text('PREPARED FOR', LM, 153);
        doc.setFontSize(16);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(255, 255, 255);
        doc.text(env['org-name'] || 'Your Organisation', LM, 163);

        doc.setFontSize(10);
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(...LIGHT_BLUE);
        if (env['org-sector']) doc.text(env['org-sector'], LM, 171);
        if (env['org-size']) doc.text(`${env['org-size']} FTE`, LM, 178);

        // Score teaser
        doc.setFillColor(255, 255, 255);
        doc.roundedRect(W - RM - 60, 145, 60, 50, 3, 3, 'F');
        doc.setTextColor(...GREY);
        doc.setFontSize(8);
        doc.setFont('helvetica', 'bold');
        doc.text('READINESS SCORE', W - RM - 30, 155, { align: 'center' });
        doc.setTextColor(...colorForPct(score));
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(28);
        doc.text(score + '%', W - RM - 30, 175, { align: 'center' });
        doc.setTextColor(...NAVY);
        doc.setFontSize(9);
        doc.text(band.label, W - RM - 30, 188, { align: 'center' });

        // Footer date
        const today = new Date().toLocaleDateString('en-AU', { day: '2-digit', month: 'long', year: 'numeric' });
        doc.setFontSize(8);
        doc.setTextColor(...LIGHT_BLUE);
        doc.text('REPORT GENERATED', LM, H - 22);
        doc.setFontSize(10);
        doc.setTextColor(255, 255, 255);
        doc.setFont('helvetica', 'bold');
        doc.text(today, LM, H - 16);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.setTextColor(...LIGHT_BLUE);
        doc.text('compliance365.com.au', W - RM, H - 16, { align: 'right' });

        // ─── Page 2: Executive Summary ──────────────────────
        doc.addPage();
        footer();
        y = 16;

        doc.setTextColor(...NAVY);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(20);
        doc.text('Executive Summary', LM, y);
        y += 10;

        // Score hero
        doc.setFillColor(...LIGHT);
        doc.roundedRect(LM, y, W - LM - RM, 38, 4, 4, 'F');
        doc.setTextColor(...GREY);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.text('OVERALL ISMS READINESS SCORE', LM + 8, y + 9);
        doc.setTextColor(...colorForPct(score));
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(28);
        doc.text(score + '%', LM + 8, y + 28);

        doc.setTextColor(...NAVY);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(13);
        doc.text(band.label, LM + 60, y + 17);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(...GREY);
        const bandDescLines = doc.splitTextToSize(band.desc, W - LM - RM - 70);
        doc.text(bandDescLines, LM + 60, y + 24);
        y += 46;

        // Engagement context
        doc.setTextColor(...NAVY);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.text('Engagement Context', LM, y);
        y += 7;

        const ctx = [
          ['Organisation', env['org-name'] || '—'],
          ['Sector', env['org-sector'] || '—'],
          ['Size', env['org-size'] || '—'],
          ['Microsoft licensing', env['env-licensing'] || '—'],
          ['Primary trigger', env['trigger'] || '—'],
          ['Audit-ready timeline', env['timeline'] || '—'],
        ];

        doc.setFontSize(9);
        ctx.forEach(([k, v]) => {
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(...GREY);
          doc.text(k, LM, y);
          doc.setFont('helvetica', 'bold');
          doc.setTextColor(...NAVY);
          const vLines = doc.splitTextToSize(String(v), W - LM - RM - 50);
          doc.text(vLines, LM + 50, y);
          y += vLines.length * 5 + 1.5;
        });
        y += 6;

        // Domain breakdown
        ensure(40);
        doc.setTextColor(...NAVY);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.text('Domain Breakdown', LM, y);
        y += 8;

        GROUPS.forEach(grp => {
          ensure(20);
          const { pct, answered: a, total } = computeSection(grp.key);
          const c = colorForPct(pct);

          doc.setTextColor(...NAVY);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(10);
          doc.text(grp.title, LM, y);
          doc.setTextColor(...c);
          doc.setFontSize(11);
          doc.text(pct === null ? 'N/A' : pct + '%', W - RM, y, { align: 'right' });
          y += 3;

          // Bar
          const barW = W - LM - RM;
          doc.setFillColor(...LIGHT);
          doc.roundedRect(LM, y, barW, 4, 2, 2, 'F');
          if (pct !== null && pct > 0) {
            doc.setFillColor(...c);
            doc.roundedRect(LM, y, barW * (pct / 100), 4, 2, 2, 'F');
          }
          y += 6;

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8);
          doc.setTextColor(...GREY);
          doc.text(`${a}/${total} answered`, W - RM, y, { align: 'right' });
          y += 6;
        });

        // ─── Top Priority Gaps ───────────────────────────────
        const gaps = [];
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          if (v === 0 || v === 1) {
            gaps.push({ q, severity: v === 0 ? 2 : 1, group: GROUPS.find(g => g.key === q.group).title });
          }
        });
        gaps.sort((a, b) => b.severity - a.severity);
        const topGaps = gaps.slice(0, 5);

        if (topGaps.length > 0) {
          ensure(20);
          y += 4;
          doc.setTextColor(...NAVY);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(14);
          doc.text('Top Priority Gaps', LM, y);
          y += 6;
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          doc.setTextColor(...GREY);
          doc.text(`The ${topGaps.length} highest-priority gaps from your assessment, ranked by severity.`, LM, y);
          y += 8;

          topGaps.forEach((gap, i) => {
            const sevC = gap.severity === 2 ? RED : AMBER;
            const sevL = gap.severity === 2 ? 'NOT IN PLACE' : 'PARTIAL';

            const qLines = doc.splitTextToSize(gap.q.label, W - LM - RM - 14);
            const blockH = 8 + qLines.length * 4 + 2;
            ensure(blockH);

            // Numbered circle
            doc.setFillColor(...sevC);
            doc.circle(LM + 4, y + 3, 3.5, 'F');
            doc.setTextColor(255, 255, 255);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8);
            doc.text(String(i + 1), LM + 4, y + 4.5, { align: 'center' });

            // Severity + section
            doc.setTextColor(...sevC);
            doc.setFontSize(7);
            doc.setFont('helvetica', 'bold');
            doc.text(sevL, LM + 11, y + 1.5);
            doc.setFont('helvetica', 'normal');
            doc.setTextColor(...GREY);
            doc.text('· ' + gap.group.toUpperCase(), LM + 11 + doc.getTextWidth(sevL) + 1, y + 1.5);

            // Question
            doc.setTextColor(...NAVY);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(9);
            doc.text(qLines, LM + 11, y + 6);
            y += blockH + 2;
          });
        }

        // ─── 90-Day Action Plan ──────────────────────────────
        ensure(40);
        y += 4;
        doc.setTextColor(...NAVY);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.text('Recommended 90-Day Roadmap', LM, y);
        y += 5;
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(...GREY);
        doc.text('A practical, phased plan based on your current readiness — adjust to your context.', LM, y);
        y += 8;

        const isLowScore = score < 50;
        const phaseFoundation = isLowScore
          ? ['Define ISMS scope and obtain leadership approval', 'Establish ISMS governance roles and responsibilities', 'Document risk methodology with criteria and appetite', 'Begin asset inventory and classification']
          : ['Refresh ISMS scope and validate governance roles', 'Update risk register with current risks and treatments', 'Validate Statement of Applicability against current scope', 'Confirm management review cadence and inputs'];
        const phaseImplementation = isLowScore
          ? ['Implement Statement of Applicability with control owners', 'Stand up access control with JML, RBAC and MFA', 'Establish supplier risk assessment programme', 'Deploy logging and alerting for identity and endpoints']
          : ['Close highest-priority control gaps from this report', 'Verify access reviews are operating to schedule', 'Refresh supplier assessments for critical vendors', 'Run an alert review and tuning cycle'];
        const phaseAuditReady = isLowScore
          ? ['Conduct first internal ISMS audit with full clause coverage', 'Test incident response with a tabletop exercise', 'Validate backup restore and DR for critical systems', 'Hold management review and document decisions']
          : ['Schedule internal audit covering identified gaps', 'Run an incident response tabletop on a current threat', 'Test restore for critical systems and update RTO and RPO', 'Prepare evidence pack for surveillance audit'];

        const phases = [
          { name: 'WEEKS 1 TO 4 — FOUNDATION',              items: phaseFoundation },
          { name: 'WEEKS 5 TO 8 — CONTROL IMPLEMENTATION',  items: phaseImplementation },
          { name: 'WEEKS 9 TO 12 — AUDIT READINESS',        items: phaseAuditReady },
        ];

        phases.forEach(phase => {
          const blockH = 8 + phase.items.length * 6 + 4;
          ensure(blockH);
          doc.setFillColor(...BLUE);
          doc.roundedRect(LM, y, W - LM - RM, 7, 2, 2, 'F');
          doc.setTextColor(255, 255, 255);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(9);
          doc.text(phase.name, LM + 4, y + 5);
          y += 11;
          doc.setTextColor(...NAVY);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          phase.items.forEach(item => {
            doc.setTextColor(...BLUE);
            doc.text('•', LM + 3, y);
            doc.setTextColor(...NAVY);
            const lines = doc.splitTextToSize(item, W - LM - RM - 8);
            doc.text(lines, LM + 7, y);
            y += lines.length * 5 + 1;
          });
          y += 3;
        });

        // ─── Detailed Responses Appendix ─────────────────────
        doc.addPage();
        footer();
        y = 16;

        doc.setTextColor(...NAVY);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(16);
        doc.text('Appendix — Detailed Responses', LM, y);
        y += 6;
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(...GREY);
        doc.text('Your full response to every assessment question.', LM, y);
        y += 8;

        GROUPS.forEach(grp => {
          ensure(15);
          doc.setTextColor(...BLUE);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(11);
          doc.text(grp.title, LM, y);
          y += 6;

          QUESTIONS.filter(q => q.group === grp.key).forEach((q, i) => {
            const v = state[q.id];
            const lbl = v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : '—';
            const lblC = v === 2 ? GREEN : v === 1 ? AMBER : v === 0 ? RED : GREY;

            const qLines = doc.splitTextToSize(`${i + 1}. ${q.label}`, W - LM - RM - 30);
            const blockH = qLines.length * 4 + 3;
            ensure(blockH);

            doc.setTextColor(...NAVY);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9);
            doc.text(qLines, LM, y);

            doc.setTextColor(...lblC);
            doc.setFont('helvetica', 'bold');
            doc.text(lbl, W - RM, y, { align: 'right' });

            y += blockH;
          });
          y += 3;
        });

        // ─── Final Page: Next Steps ──────────────────────────
        doc.addPage();
        footer();
        y = 0;

        doc.setFillColor(...NAVY);
        doc.rect(0, 0, W, 60, 'F');
        doc.setTextColor(255, 255, 255);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(22);
        doc.text("What's next?", LM, 28);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(11);
        doc.setTextColor(...LIGHT_BLUE);
        const nextLines = doc.splitTextToSize('Three paths forward — pick the one that matches your situation, timeline, and resourcing.', W - LM - RM);
        doc.text(nextLines, LM, 42);

        y = 75;

        const paths = [
          { title: 'Self-led', sub: 'DIY using this roadmap', desc: 'Use the priority gaps and 90-day plan as your internal action list. Free Compliance365 resources, blog posts, and the SoA guide can support implementation.' },
          { title: 'Structured assessment', sub: '2–3 week formal gap assessment', desc: 'A senior practitioner reviews your environment, validates this self-assessment, and produces a board-ready remediation roadmap with effort estimates.' },
          { title: 'Full programme', sub: '8–14 week certification programme', desc: 'End-to-end implementation from current state to certification — fixed-price, milestone-gated, with audit-ready evidence at every step.' },
        ];

        paths.forEach((p, i) => {
          ensure(36);
          doc.setFillColor(...LIGHT);
          doc.roundedRect(LM, y, W - LM - RM, 32, 3, 3, 'F');
          doc.setTextColor(...BLUE);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(8);
          doc.text(`OPTION ${i + 1}`, LM + 5, y + 7);
          doc.setTextColor(...NAVY);
          doc.setFontSize(13);
          doc.text(p.title, LM + 5, y + 14);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          doc.setTextColor(...GREY);
          doc.text(p.sub, LM + 5, y + 19);
          doc.setTextColor(...NAVY);
          doc.setFontSize(8);
          const dLines = doc.splitTextToSize(p.desc, W - LM - RM - 10);
          doc.text(dLines, LM + 5, y + 25);
          y += 36;
        });

        // CTA banner
        ensure(28);
        y += 4;
        doc.setFillColor(...BLUE);
        doc.roundedRect(LM, y, W - LM - RM, 24, 3, 3, 'F');
        doc.setTextColor(255, 255, 255);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.text('Ready to discuss your results?', LM + 6, y + 10);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.text('Book a free 30-minute call — no obligation.', LM + 6, y + 17);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.text('compliance365.com.au/book', W - RM - 6, y + 14, { align: 'right' });
        doc.link(LM, y, W - LM - RM, 24, { url: 'https://compliance365.com.au/book' });

        // Save
        const safeOrg = (env['org-name'] || 'Report').replace(/[^a-z0-9]/gi, '-');
        doc.save(`ISO27001-Readiness-${safeOrg}.pdf`);
      }
    })();
  </script>

  <style>
    .opt:hover:not(.active) { border-color:#1e40af !important; }
    .question.answered { background:#fafbfc; }
    @media (max-width:900px) {
      #stage-2-grid { grid-template-columns:1fr !important; }
      #score-panel { position:static !important; }
    }
  </style>
</Base>
