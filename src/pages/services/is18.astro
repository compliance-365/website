---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CheckpointShot from '../../components/CheckpointShot.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import ScopingWidget from '../../components/ScopingWidget.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'IS18 (QGEA) Compliance — Queensland Government',
  serviceType: 'IS18 — Information and Cyber Security Policy Compliance',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: [
    { '@type': 'State', name: 'Queensland' },
    { '@type': 'City', name: 'Brisbane' },
    { '@type': 'Country', name: 'Australia' },
  ],
  url: 'https://www.compliance365.com.au/services/is18/',
  description:
    'IS18 (QGEA) compliance for Queensland Government agencies, statutory bodies and their ICT suppliers — a baseline assessment against all five IS18 policy requirements and reporting, tested Essential Eight results, a costed path to minimum compliance, a roadmap to the accountable officer\'s annual return, and support to deliver it. Delivered inside your own Microsoft 365 tenant; no data ever leaves it.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does IS18 actually require?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Information and cyber security policy (IS18), version 10 issued in June 2026, sets five requirements: an ISMS based on ISO 27001 covering all services, information and technology; a systematic approach to security risk, built into corporate risk management; minimum security requirements, including the QGISCF, the Data Encryption Standard, the QGAF and the ASD Essential Eight; security assurance scaled to system criticality, with a cyber incident simulation at least once a year; and an accountable officer attestation. Agencies also lodge an endorsed annual return with the Cyber Security Unit by 30 September, report applicable incidents at the earliest opportunity, report proposed offshore storage of higher-impact information, and follow ICT profiling reporting. For ICT suppliers, the obligations flow down through contracts and panel arrangements.'
      }
    },
    {
      '@type': 'Question',
      name: 'Where does our compliance data live during the engagement?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Inside your own Microsoft 365 tenant, and nowhere else. Our Checkpoint console has no backend and no vendor database — every register (risks, controls, evidence, incidents, audit trail) is a SharePoint list in your tenant, and posture checks are read from Microsoft Graph at scan time in the browser. Nothing is copied to a third-party GRC platform, which matters when the data describes a government agency\'s security posture.'
      }
    },
    {
      '@type': 'Question',
      name: 'How is the Essential Eight requirement handled?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We test it rather than take it on trust. Where we can, we run the ASD Essential Eight Maturity Verification Tool on your devices, inspect configuration, and rate every requirement for each environment you run, including those your IT provider manages. Each gap is marked as a fix (the control is not working) or an evidence gap (it may be working but nobody can show it), because the second is usually much quicker to close. IS18 does not set a number: your agency selects its target maturity based on risk appetite, and we help you set it. ASD published the Essentials, the successor to the Essential Eight, on 15 October 2026; ASD has said existing Essential Eight work counts toward it, but controls should be checked rather than assumed to be equivalent, and we track both through the transition.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does IS18 compliance take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A baseline assessment against all five IS18 requirements and reporting, with a costed roadmap, typically takes 6–10 weeks for an agency or statutory body and 3–4 weeks for a supplier. The work to reach a credible first annual return then depends on your current maturity, your IT provider and how many separate environments you run. Organisations with an existing ISO 27001 or ASD-aligned programme move faster.'
      }
    },
    {
      '@type': 'Question',
      name: 'We already hold ISO 27001 — what does IS18 add?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A genuine ISO 27001 programme covers a large part of IS18. What remains is Queensland-specific: QGISCF classification, the Data Encryption Standard and QGAF, Essential Eight results against a target your agency selects, assurance scaled to system criticality, incident reporting to the Cyber Security Unit, data breach obligations under the Information Privacy Act, and the accountable officer\'s annual return. We map your existing ISMS across so only the genuinely new work gets done.'
      }
    },
    {
      '@type': 'Question',
      name: 'Does IS18 apply to statutory bodies and suppliers, or only to departments?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'IS18 applies to all Queensland Government departments. It applies to statutory bodies under the Financial and Performance Management Standard 2019 for internal controls, financial information management systems and risk management, and many statutory bodies choose to report against it in full. It reaches ICT suppliers through contract schedules, deeds of standing offer and panel requirements. We deliver the same programme shaped to each.'
      }
    },
    {
      '@type': 'Question',
      name: 'What will it cost to become compliant?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Our assessments cost the path to minimum compliance gap by gap, with effort, one-off and ongoing costs and a delivery option for each. We separate your own staff time from new spend, show contingency separately, and state what is excluded and why, so the number holds up when it reaches your executive or audit committee.'
      }
    }
  ]
};
---

<Base
  title="IS18 Compliance for Queensland Government | Compliance365"
  description="IS18 compliance for QLD Government agencies and suppliers — ISO 27001-aligned ISMS, Essential Eight uplift, and the 30 September annual return."
  ogImage="https://www.compliance365.com.au/og/og-is18.png"
  schema={[serviceLd, faqLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Services', url: 'https://www.compliance365.com.au/services/' },
    { name: 'IS18 (QGEA)', url: 'https://www.compliance365.com.au/services/is18/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">IS18 · QGEA · Queensland Government · Brisbane</p>
        <h1>IS18 compliance <em>that never leaves your tenant.</em></h1>
        <p class="section-lead">
          IS18 asks for an ISO 27001-based ISMS, the Essential Eight and a set of Queensland obligations, then asks your accountable officer to sign for all of it. We assess where you really stand, cost the path to minimum compliance, and help you get there, with every register, control and piece of evidence living in <em>your</em> Microsoft 365 tenant.
        </p>

        <ul class="trust-signals">
          <li>All five IS18 requirements, plus reporting</li>
          <li>Essential Eight tested, not self-assessed</li>
          <li>Costed to minimum compliance, exclusions stated</li>
          <li>Data sovereignty — no external platform</li>
          <li>Brisbane-based, senior-led, fixed-price</li>
        </ul>

        <div class="hero-ctas">
          <a href={`${base}checklist/is18/`} class="btn-hdk-primary">Free IS18 readiness check</a>
          <a href={ctaUrl} class="btn-hdk-ghost">Book a 30-min call</a>
        </div>
        <p class="small" style="margin-top:0.75rem;opacity:.8;">22 questions, about 10 minutes, with a PDF of your priority gaps. For agencies and suppliers.</p>
      </div>

      <div class="svc-hero-image">
        <img
          src={`${base}assets/illus-is18.svg`}
          alt="IS18 version 10's five requirements (ISMS, risk, minimum security requirements, assurance and accountable officer attestation) above its reporting obligations to the Cyber Security Unit, led by the annual return due 30 September"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- WHY IS18 IS RIGHT FOR ME — self-qualifier -->
  <section class="section svc-fit" id="is-this-me" style="padding-top:3rem;padding-bottom:3rem;background:rgba(190, 74, 30,0.06);">
    <div class="container" style="max-width:960px;">
      <h2 class="center" style="margin-bottom:0.5rem;">Why is IS18 right for me?</h2>
      <p class="muted center" style="max-width:680px;margin:0.75rem auto 2.5rem;">
        A 20-second self-check. IS18 is your obligation if any one of these describes you.
      </p>

      <div class="svc-fit-grid">
        <div class="svc-fit-card">
          <span class="svc-fit-num">1</span>
          <h3>You're a Queensland Government department or statutory body</h3>
          <p class="muted small">
            IS18 applies to every department, and to statutory bodies for internal controls, financial information systems and risk management. Many statutory bodies choose to report against it in full. Either way, your accountable officer endorses an annual return due every 30 September.
          </p>
        </div>
        <div class="svc-fit-card">
          <span class="svc-fit-num">2</span>
          <h3>You supply ICT services to Queensland Government</h3>
          <p class="muted small">
            Your contract, deed of standing offer or panel arrangement flows IS18 down to you, and you've been asked for an IS18 compliance statement with substantiating evidence to win — or keep — panel eligibility.
          </p>
        </div>
        <div class="svc-fit-card">
          <span class="svc-fit-num">3</span>
          <h3>"Just get ISO 27001" or "just do the Essential Eight" didn't fit</h3>
          <p class="muted small">
            You handle OFFICIAL: Sensitive or PROTECTED Queensland Government information and a generic framework doesn't match what the agency asked for. IS18 includes ISO 27001 and the Essential Eight, then adds the Queensland layer — QGISCF classification, E8 maturity reporting and CSU incident reporting.
          </p>
        </div>
      </div>

      <p class="center muted small" style="margin-top:2rem;">
        Not sure whether a contract schedule flows IS18 down to you, or which requirements you already cover? That's the first thing we settle on a call — <a href={ctaUrl} style="color:var(--accent-ink);font-weight:600;">book 30 minutes</a> and we'll tell you plainly, no pitch.
      </p>

      <!-- pre-empted quick questions -->
      <div class="svc-preempt">
        <div>
          <h4>"We already hold ISO 27001 — isn't that enough?"</h4>
          <p class="muted small">A genuine ISO 27001 programme covers a large part of IS18. What's left is Queensland-specific: QGISCF classification, Essential Eight results, assurance by system criticality, CSU incident reporting, breach obligations and the annual return.</p>
        </div>
        <div>
          <h4>"We're a supplier, not an agency — do we really need it?"</h4>
          <p class="muted small">If your deed, standing offer or panel arrangement flows it down, yes. An evidence-backed compliance statement — honest about gaps, with a credible roadmap — is what keeps panel eligibility and wins the risk assessment.</p>
        </div>
        <div>
          <h4>"What Essential Eight level do we need?"</h4>
          <p class="muted small">IS18 doesn't set a number. Your agency selects its target based on risk appetite. We recommend Maturity Level 1 as the floor and help you decide where a higher level is warranted, environment by environment.</p>
        </div>
        <div>
          <h4>"When is it actually due?"</h4>
          <p class="muted small">The accountable officer's annual return is due 30 September. Posture should be evidenced continuously — Checkpoint's automated checks keep it current, so September is a report of what the register already shows, not a scramble.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE SOVEREIGNTY ARGUMENT -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">The question every agency should ask a GRC vendor first</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto 3rem;">
        "Where does our security posture data live?" For most compliance platforms the honest answer is <em>on our servers</em> — a third-party SaaS database holding a detailed map of a government agency's control gaps. Ours is different by architecture, not by policy.
      </p>

      <div class="grid-2" style="max-width:960px;margin:0 auto;gap:2rem;align-items:stretch;">
        <div class="card spot" style="border:1px solid #DDD8CF;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">Typical GRC platform</p>
          <h3 style="margin:0 0 1.25rem;">Your gaps, on their servers</h3>
          <ul class="muted" style="padding-left:1.2rem;line-height:2;margin:0;">
            <li>Registers and evidence copied into a vendor SaaS database</li>
            <li>Hosting location and access controlled by the vendor</li>
            <li>Another supplier to security-assess and contract-manage</li>
            <li>Per-seat platform licensing, forever</li>
            <li>Offboarding means exporting and hoping</li>
          </ul>
        </div>

        <div class="card spot" style="border:2px solid #BE4A1E;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:var(--accent-ink);text-transform:uppercase;margin:0 0 0.5rem;">Checkpoint + Compliance365</p>
          <h3 style="margin:0 0 1.25rem;color:#A63A12;">Your gaps, in your tenant</h3>
          <ul class="muted" style="padding-left:1.2rem;line-height:2;margin:0;">
            <li>Every register is a SharePoint list inside your own Microsoft 365 tenant</li>
            <li>No backend, no vendor database — posture checks are read at scan time and never leave the browser</li>
            <li>Access governed by your existing Entra ID and SharePoint permissions</li>
            <li>Read-only Microsoft Graph permissions, consented incrementally by your admin</li>
            <li>Everything stays yours on day one and on the day we leave</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- THE FIVE REQUIREMENTS -->
  <section class="section" id="pillars">
    <div class="container">
      <h2 class="center">IS18's five requirements — and how we deliver each</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        IS18 (version 10, June 2026) sets five policy requirements and a set of reporting obligations, and ends with an attestation your accountable officer personally signs. We assess and build each one on a shared control set, so nothing is done twice.
      </p>

      <div class="grid-3" style="margin-top:3rem;gap:1.5rem;">
        <div class="card feature spot">
          <h3>1. An ISMS based on ISO 27001</h3>
          <p class="muted small">
            Covering all services, information and technology. Scope, policy, Statement of Applicability, internal audit and management review that actually run, not just a framework on paper.
          </p>
        </div>
        <div class="card feature spot">
          <h3>2. Security risk management</h3>
          <p class="muted small">
            A repeatable approach built into corporate risk, with owners recording decisions on risks above appetite, and operational technology considered alongside corporate IT.
          </p>
        </div>
        <div class="card feature spot">
          <h3>3. Minimum security requirements</h3>
          <p class="muted small">
            QGISCF classification and handling, the Data Encryption Standard, the QGAF and the ASD Essential Eight at the target your agency selects, delivered with your existing Microsoft 365 tooling.
          </p>
        </div>
        <div class="card feature spot">
          <h3>4. Security assurance</h3>
          <p class="muted small">
            Testing scaled to each system's criticality using the QGISCF business impact method, plus a cyber incident simulation at least once a year.
          </p>
        </div>
        <div class="card feature spot">
          <h3>5. Accountable officer attestation</h3>
          <p class="muted small">
            Everything the accountable officer needs to endorse the annual return and attest with confidence, including recorded departures where a control can't be met.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Reporting obligations</h3>
          <p class="muted small">
            The annual return to the Cyber Security Unit by 30 September, applicable incidents at the earliest opportunity, proposed offshore storage of higher-impact information, and ICT profiling.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">What you get from an IS18 baseline assessment</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Plain-language reports your executive can act on, and working files your team can keep using. Every document links to the others, so a finding traces to its cost, its date and the controls it delivers.
      </p>
      <div class="grid-3" style="margin-top:3rem;gap:1.5rem;">
        <div class="card feature spot">
          <h3>Compliance baseline</h3>
          <p class="muted small">Where you stand against every IS18 requirement, with findings rated and evidenced, and ratings laid out to match the annual return template.</p>
        </div>
        <div class="card feature spot">
          <h3>Tested Essential Eight results</h3>
          <p class="muted small">Every requirement rated for each environment you run, with fixes separated from evidence gaps and a Level 1 uplift plan your team and IT provider can track.</p>
        </div>
        <div class="card feature spot">
          <h3>Gap register and validation pack</h3>
          <p class="muted small">Every gap with an owner, plus a pack for your managers to confirm the facts and record their response before anything is finalised.</p>
        </div>
        <div class="card feature spot">
          <h3>Costed minimum compliance</h3>
          <p class="muted small">Effort, one-off and ongoing cost for every gap, with your own staff time separated from new spend, contingency shown, and exclusions stated.</p>
        </div>
        <div class="card feature spot">
          <h3>Roadmap to your first return</h3>
          <p class="muted small">Activities, owners, milestones and dates up to 30 September, each linked to the Statement of Applicability controls it delivers.</p>
        </div>
        <div class="card feature spot">
          <h3>Return readiness and briefing</h3>
          <p class="muted small">A readiness statement and plan for the attestation, and a short briefing for your executive and audit and risk committee.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT ASSESSMENTS MISS -->
  <section class="section">
    <div class="container">
      <h2 class="center">What most IS18 assessments miss</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        The gaps that hurt at attestation time are rarely the obvious ones. These are the areas we look at closely.
      </p>
      <div class="grid-2" style="margin-top:3rem;gap:2rem;max-width:960px;margin-left:auto;margin-right:auto;">
        <div class="card feature spot">
          <h3>Controls your IT provider runs</h3>
          <p class="muted small">Your accountable officer signs for controls a shared IT provider or managed service operates. We test what we can, show which controls can't be evidenced, and help you agree a shared responsibility model with your provider.</p>
        </div>
        <div class="card feature spot">
          <h3>Laboratory, operational and legacy systems</h3>
          <p class="muted small">Older systems that can't be patched or replaced quickly need formal departures with compensating controls, an owner and a review date, not silence in the return.</p>
        </div>
        <div class="card feature spot">
          <h3>Incident and breach reporting</h3>
          <p class="muted small">Two separate tests: IS18 reporting to the Cyber Security Unit, and data breach assessment under the Information Privacy Act. We check both have actually happened for past events.</p>
        </div>
        <div class="card feature spot">
          <h3>Evidence gaps versus real gaps</h3>
          <p class="muted small">A control nobody can evidence looks the same as a missing one in a self-assessment. Separating the two often shows the quickest wins and keeps the budget honest.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AFTER THE ASSESSMENT -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">After the assessment: oversight and uplift</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Most of the work can be done by your own team. Where capacity is the constraint, we can help, on a fixed price.
      </p>
      <div class="grid-3" style="margin-top:3rem;gap:1.5rem;">
        <div class="card feature spot">
          <h3>Program oversight</h3>
          <p class="muted small">Monthly progress reviews, evidence checks and steering reports through to the return, so slippage shows early.</p>
        </div>
        <div class="card feature spot">
          <h3>ISMS framework build</h3>
          <p class="muted small">Policies, Statement of Applicability, risk method, internal audit and management review, written to describe what you actually do.</p>
        </div>
        <div class="card feature spot">
          <h3>Essential Eight uplift with your provider</h3>
          <p class="muted small">Tracking the uplift plan, chasing evidence and checking fixes with your IT provider. The final retest should be independent of whoever does the remediation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHECKPOINT IS18 MODULE -->
  <section class="section">
    <div class="container">
      <h2 class="center">The Checkpoint IS18 module — compliance that maintains itself</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Every IS18 engagement runs on our Checkpoint console, deployed into your tenant with a dedicated IS18 register — 32 controls across governance, risk, classification, Essential Eight, incidents, suppliers and the annual return, each with implementation guidance and evidence expectations written for Microsoft 365.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3>Automated posture checks</h3>
          <p class="muted small">
            25 checks read your tenant's real state — MFA and Conditional Access, application control, patching, macros, privileged access, sensitivity labels, DLP, external sharing, encryption, logging and alerting — and 19 of them map straight onto IS18 controls, suggesting status updates a practitioner confirms with one click.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Drift detection between returns</h3>
          <p class="muted small">
            An optional scheduled monitor (deployed into your own Azure subscription, never ours) re-runs the checks unattended and raises an alert the day a control that passed starts failing — so the posture attested in September is still true in March.
          </p>
        </div>
        <div class="card feature spot">
          <h3>ISO 27001 + Essential Eight included</h3>
          <p class="muted small">
            The IS18 module is licensed as a bundle: full ISO 27001 and Essential Eight registers are included because IS18 is built on both. One cross-mapped control set — implement once, evidence once, report three ways.
          </p>
        </div>
      </div>

      <div style="max-width:1060px;margin:0 auto;">
        <CheckpointShot id="soaEssential8" label="Requirement 3 — Essential Eight maturity, by strategy" />
        <CheckpointShot id="postureScan" label="The posture checks behind it" />
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section">
    <div class="container">
      <h2 class="center">Who this is for</h2>
      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3>Queensland agencies &amp; statutory bodies</h3>
          <p class="muted small">
            Departments and statutory bodies carrying the IS18 obligation directly — especially teams facing the annual return with a register that lives in spreadsheets, or an Essential Eight self-assessment they can't currently substantiate.
          </p>
        </div>
        <div class="card feature spot">
          <h3>ICT suppliers to QLD Government</h3>
          <p class="muted small">
            Panel holders and contractors whose deeds and schedules flow IS18 down to them. An evidence-backed compliance statement — honest about gaps, with a credible roadmap — is what keeps panel eligibility and wins the risk assessment.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Managed service &amp; SaaS providers</h3>
          <p class="muted small">
            Providers hosting or processing OFFICIAL: Sensitive material for agencies, who need IS18 alignment plus the ISO 27001 certification path for their broader market — one programme, both outcomes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">Common questions</h2>
      <div style="max-width:760px;margin:3rem auto 0;">
        <details class="acc-item">
          <summary>What does IS18 actually require?</summary>
          <p class="acc-body">
            The Information and cyber security policy (IS18), version 10 issued in June 2026, sets five requirements: an ISMS based on ISO 27001; systematic security risk management; minimum security requirements (QGISCF, the Data Encryption Standard, the QGAF and the Essential Eight); security assurance scaled to system criticality, with an annual incident simulation; and an accountable officer attestation. Agencies also lodge an endorsed annual return by 30 September and report applicable incidents, proposed offshore storage and ICT profiling. Suppliers inherit obligations through contracts and panel deeds.
          </p>
        </details>
        <details class="acc-item">
          <summary>Is the Essential Eight being retired — does that affect our IS18 obligations?</summary>
          <p class="acc-body">
            ASD published the Essentials, the successor to the Essential Eight, on 15 October 2026. ASD has said existing Essential Eight work counts toward it, but that controls should be checked against the Essentials rather than assumed to be equivalent, and the transition will run over the next year or two. IS18 still names the Essential Eight — we track ASD and QGEA guidance as it updates and fold any changes into your programme rather than leaving you to catch it yourself.
          </p>
        </details>
        <details class="acc-item">
          <summary>Where does our data live?</summary>
          <p class="acc-body">
            In your own Microsoft 365 tenant, full stop. Checkpoint has no backend and no vendor database — registers are SharePoint lists in your tenant, and posture checks never leave the browser. There is no third-party platform holding your security posture.
          </p>
        </details>
        <details class="acc-item">
          <summary>How long does it take?</summary>
          <p class="acc-body">
            Baseline assessment with a costed roadmap: typically 6–10 weeks for an agency or statutory body, 3–4 weeks for a supplier. The work to a credible first annual return then depends on your current maturity, your IT provider and how many separate environments you run.
          </p>
        </details>
        <details class="acc-item">
          <summary>We already hold ISO 27001 — what's left?</summary>
          <p class="acc-body">
            The Queensland-specific layer: QGISCF classification, the Data Encryption Standard and QGAF, Essential Eight results against the target you select, assurance by system criticality, CSU incident reporting, breach obligations under the Information Privacy Act, and the annual return. We map your existing ISMS across so only the new work gets done.
          </p>
        </details>
        <details class="acc-item">
          <summary>What Essential Eight level do we need?</summary>
          <p class="acc-body">
            IS18 doesn't set a number: your agency selects its target maturity based on risk appetite, guided by ASD's Essential Eight guidance. We recommend Maturity Level 1 as the floor and help you decide where a higher level is warranted, environment by environment.
          </p>
        </details>
        <details class="acc-item">
          <summary>Does IS18 apply to statutory bodies?</summary>
          <p class="acc-body">
            IS18 applies to all departments. For statutory bodies it applies to internal controls, financial information management systems and risk management, under the Financial and Performance Management Standard 2019, and many statutory bodies choose to report against it in full. We'll confirm your position on the first call.
          </p>
        </details>
        <details class="acc-item">
          <summary>What will it cost to become compliant?</summary>
          <p class="acc-body">
            We cost the path to minimum compliance gap by gap, with effort, one-off and ongoing cost and a delivery option for each. Your own staff time is separated from new spend, contingency is shown separately, and exclusions are stated with their likely scale, so the number holds up when it reaches your executive or audit committee.
          </p>
        </details>
        <details class="acc-item">
          <summary>Can you work with our existing security team?</summary>
          <p class="acc-body">
            That's the model. We deliver senior-led and hands-on, but the registers, the console and the evidence pipeline are built to be operated by your team after handover — with the automated checks doing the between-audit maintenance.
          </p>
        </details>
      </div></div>
