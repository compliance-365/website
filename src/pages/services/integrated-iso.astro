---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import CheckpointShot from '../../components/CheckpointShot.astro';
import { MODULES, BUNDLE_RATE_PCT, BUNDLE_MIN_MODULES, CONSULTING_DAY_RATE, computeQuote, fmtAud } from '../../data/pricing.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const demoUrl = `${base}checkpoint-console/demo/`;

const trio = ['iso27001', 'iso27701', 'iso42001'];
const micro = computeQuote(trio, [], 'micro');
const growth = computeQuote(trio, [], 'growth');
const each = (id: string) => MODULES.find((m) => m.id === id)!;

// What is done once for all three standards. Each line describes how
// Checkpoint actually behaves: shared registers, one audit programme and
// one management review, clause evidence carried across the 4-10
// structure, and the ISO 27701 controls mapped to their ISO 27001 twins.
const shared = [
  { h: 'One set of registers', p: 'One risk register and one action register, plus shared asset, supplier, incident, training and objectives registers. AI systems have their own register, which feeds ISO 42001.' },
  { h: 'One internal audit programme', p: 'A single audit programme covers the whole system. Plan it by risk, run it in Checkpoint, and raise findings into the same action register.' },
  { h: 'One management review', p: 'The review pack draws its inputs from every shared register, including incidents and AI systems, so top management meets once, not three times.' },
  { h: 'Clause evidence used once', p: 'All three standards follow the same clause 4–10 structure. One approved document or register, such as the risk method or the audit programme, counts as evidence for the same clause in each.' },
  { h: 'Controls that overlap', p: 'The security controls in ISO 27701 are mapped to their ISO 27001 counterparts, and the mapping view shows where one piece of work counts for several standards.' },
  { h: 'One tenant, one licence file', p: 'All three run in the same SharePoint site in your own Microsoft 365 tenant. Nothing is installed three times, and nothing leaves your tenant.' }
];

// What stays separate, because certification bodies audit each
// standard against its own requirements.
const separate = [
  { h: 'Clause records per standard', p: 'Clause 4.1 exists once for each standard, with its own status, owner and evidence, so an auditor can review the AI management system on its own.' },
  { h: 'A Statement of Applicability per standard', p: 'ISO 27001 Annex A, ISO 27701 privacy controls and ISO 42001 AI controls, each with its own inclusions, exclusions and justifications.' },
  { h: 'Documents per standard', p: 'Each standard shows only the policies that belong to it. The privacy policy and AI policy sit alongside the information security policy, not inside it.' },
  { h: 'Readiness per standard', p: 'Readiness and certification packs are built per standard, so you can certify all three together or one at a time.' }
];

const steps = [
  { h: 'Start with ISO 27001', p: 'Import your existing risk register, actions, Statement of Applicability and policies, or build them with the guided set-up.' },
  { h: 'Switch on ISO 27701 and ISO 42001', p: 'Shared clause evidence counts straight away, so both standards start part-way through rather than from zero.' },
  { h: 'Add only the new work', p: 'A personal information inventory and privacy risks for ISO 27701; an AI system register and AI impact assessments for ISO 42001.' },
  { h: 'Audit and review once a year', p: 'One internal audit and one management review cover all three standards.' },
  { h: 'Certify the way that suits you', p: 'An integrated audit with one certification body, or each standard on its own timeline.' }
];

const faq = [
  { q: 'Do we need ISO 27001 before ISO 27701 or ISO 42001?', a: 'No. ISO/IEC 27701:2025 and ISO/IEC 42001 can each be certified on their own. Most organisations that already hold ISO 27001 build on it, because the management system clauses, the risk process and many records are the same.' },
  { q: 'Can we certify all three in one audit?', a: 'Many certification bodies offer an integrated audit for management systems that share a scope. Ask yours how it would sample across the three. Checkpoint keeps separate records per standard, so either approach works.' },
  { q: 'How much consulting does this need?', a: `Usually a few days rather than weeks: a privacy workshop, AI impact workshops with your system owners, and a readiness check. Checkpoint writes the documents and builds the registers. Days are ${fmtAud(CONSULTING_DAY_RATE)} each, ex GST, billed only as used.` },
  { q: 'What does it cost?', a: `Each standard is an annual licence, and licensing ${BUNDLE_MIN_MODULES} or more together takes ${BUNDLE_RATE_PCT}% off. All three for under 50 staff is ${fmtAud(micro.total)} a year; for 50–250 staff, ${fmtAud(growth.total)} a year. Prices are AUD, ex GST.` }
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};
---
<Base
  title="ISO 27001, ISO 27701 and ISO 42001 together | Compliance365"
  description="Run security, privacy and AI governance as one management system in Checkpoint: shared registers, one internal audit and one management review, separate records per standard."
  schema={[faqLd]}
>
<Header />
<main id="main-content" tabindex="-1">

<section class="svc-hero">
  <CinematicBackground static />
  <div class="svc-hero-inner">
    <div class="svc-hero-copy">
      <p class="eyebrow">ISO 27001 + ISO 27701 + ISO 42001</p>
      <h1>Security, privacy and AI governance <em>as one system</em></h1>
      <p class="section-lead">
        Three standards, one set of registers, one internal audit and one management review. Checkpoint does the shared work once and keeps each standard's records separate where an auditor expects them to be.
      </p>
      <div class="hero-ctas">
        <a href={demoUrl} class="btn-hdk-primary">Open the live demo</a>
        <a href={ctaUrl} class="btn-hdk-ghost">Book a call</a>
      </div>
    </div>
    <div class="svc-hero-image">
      <img src={`${base}assets/illus-integrated-iso.svg`} alt="Illustration of ISO 27001, ISO 27701 and ISO 42001 as overlapping circles, sharing risk and asset registers, one internal audit and one management review" width="720" height="470" loading="eager" />
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:1080px;">
    <p class="eyebrow" style="text-align:center;">Done once</p>
    <h2 style="text-align:center;margin-bottom:2rem;">What the three standards share</h2>
    <div class="ims-grid">
      {shared.map((c) => (
        <div class="ims-card"><h3>{c.h}</h3><p>{c.p}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section" style="background:#F7F4EE;">
  <div class="container" style="max-width:1080px;">
    <p class="eyebrow" style="text-align:center;">Kept separate</p>
    <h2 style="text-align:center;margin-bottom:.75rem;">What each standard keeps for itself</h2>
    <p style="text-align:center;max-width:640px;margin:0 auto 2rem;color:var(--muted,#555);">Certification bodies audit each standard against its own requirements, so these stay per standard.</p>
    <div class="ims-grid ims-grid-2">
      {separate.map((c) => (
        <div class="ims-card"><h3>{c.h}</h3><p>{c.p}</p></div>
      ))}
    </div>
    <CheckpointShot id="soaIso42001" label="ISO 42001 keeps its own Statement of Applicability" caption="The 'also satisfies' column shows where an ISO 42001 control is already evidenced by ISO 27001 or ISO 27701 work." />
    <CheckpointShot id="soaIso27701" label="So does ISO 27701" />
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow" style="text-align:center;">In practice</p>
    <h2 style="text-align:center;margin-bottom:2rem;">Adding privacy and AI to an existing ISMS</h2>
    <ol class="ims-steps">
      {steps.map((s) => <li><b>{s.h}.</b> {s.p}</li>)}
    </ol>
  </div>
</section>

<section class="section" style="background:#F7F4EE;">
  <div class="container" style="max-width:900px;">
    <p class="eyebrow" style="text-align:center;">Pricing</p>
    <h2 style="text-align:center;margin-bottom:.75rem;">Three licences, {BUNDLE_RATE_PCT}% off together</h2>
    <p style="text-align:center;max-width:640px;margin:0 auto 2rem;color:var(--muted,#555);">Annual licences, AUD ex GST. The bundle discount applies whenever {BUNDLE_MIN_MODULES} or more frameworks are licensed together.</p>
    <div class="ims-price-wrap">
      <table class="ims-price">
        <thead><tr><th>Standard</th><th>Under 50 staff</th><th>50–250 staff</th></tr></thead>
        <tbody>
          {trio.map((id) => (
            <tr><td>{each(id).name} <span>{each(id).tag}</span></td><td>{fmtAud(each(id).prices.micro)}</td><td>{fmtAud(each(id).prices.growth)}</td></tr>
          ))}
          <tr class="ims-disc"><td>Bundle discount ({BUNDLE_RATE_PCT}%)</td><td>−{fmtAud(micro.discount ? micro.discount.amount : 0)}</td><td>−{fmtAud(growth.discount ? growth.discount.amount : 0)}</td></tr>
          <tr class="ims-total"><td>All three, per year</td><td>{fmtAud(micro.total)}</td><td>{fmtAud(growth.total)}</td></tr>
        </tbody>
      </table>
    </div>
    <p style="text-align:center;margin-top:1.25rem;font-size:.92rem;color:var(--muted,#555);">Want help with the parts that need judgement? See <a href={`${base}pricing/#how-much-consulting`} style="color:#A63A12;font-weight:600;">how much consulting you're likely to need</a>.</p>
    <p style="text-align:center;margin-top:1rem;">
      <a href={`${base}start/?modules=${trio.join(',')}&tier=growth`} class="btn-hdk-primary">Start with all three</a>
    </p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px;">
    <p class="eyebrow" style="text-align:center;">Questions</p>
    <h2 style="text-align:center;margin-bottom:2rem;">Running the three together</h2>
    <div class="ims-faq">
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
    <p style="text-align:center;margin-top:2rem;font-size:.95rem;color:var(--muted,#555);">
      Each standard on its own: <a href={`${base}services/iso27001/`}>ISO 27001</a> · <a href={`${base}services/iso27701/`}>ISO 27701</a> · <a href={`${base}services/iso42001/`}>ISO 42001</a>
    </p>
  </div>
</section>

<section class="svc-final-cta">
  <CinematicBackground static />
  <div class="container">
    <h2>See how it works before you talk to anyone</h2>
    <p>The public demo shows the registers, clauses, Statement of Applicability and management review on example data. No sign-up needed.</p>
    <div class="final-buttons">
      <a href={demoUrl} class="btn-hdk-primary">Open the live demo</a>
      <a href={ctaUrl} class="btn-hdk-ghost">Book a call</a>
    </div>
  </div>
</section>

</main>
<Footer />

<style>
  .ims-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .ims-grid-2 { grid-template-columns: repeat(2, 1fr); }
  .ims-card { background: #fff; border: 1px solid #E4DFD5; border-radius: 14px; padding: 1.35rem 1.4rem; }
  .ims-card h3 { margin: 0 0 .45rem; font-size: 1.05rem; }
  .ims-card p { margin: 0; color: #4A4740; line-height: 1.55; font-size: .94rem; }
  .ims-steps { list-style: none; counter-reset: step; padding: 0; display: flex; flex-direction: column; gap: 1.1rem; }
  .ims-steps li { counter-increment: step; position: relative; padding-left: 3rem; line-height: 1.6; }
  .ims-steps li::before { content: counter(step); position: absolute; left: 0; top: -2px; width: 2rem; height: 2rem; border-radius: 50%; background: #0B0B0C; color: #FAF7F1; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .95rem; }
  .ims-price-wrap { overflow-x: auto; }
  .ims-price { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #DDD8CF; font-size: .95rem; }
  .ims-price th { background: #0B0B0C; color: #FAF7F1; text-align: right; padding: .7rem .9rem; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; }
  .ims-price th:first-child, .ims-price td:first-child { text-align: left; }
  .ims-price td { text-align: right; padding: .75rem .9rem; border-top: 1px solid #F0ECE4; color: #3A3632; }
  .ims-price td span { display: block; font-size: .78rem; color: #6B6860; }
  .ims-disc td { color: #A63A12; font-weight: 700; }
  .ims-total td { font-weight: 800; color: #0B0B0C; background: #FBF7EF; }
  .ims-faq details { border-bottom: 1px solid #E4DFD5; padding: 1rem 0; }
  .ims-faq summary { cursor: pointer; font-weight: 700; font-size: 1.05rem; color: #0B0B0C; }
  .ims-faq p { margin: .8rem 0 0; color: #555; line-height: 1.7; }
  @media (max-width: 860px) { .ims-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .ims-grid, .ims-grid-2 { grid-template-columns: 1fr; } }
</style>
</Base>
