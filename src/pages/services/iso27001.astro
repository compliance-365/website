---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// CTA (use your global pattern)
const ctaUrl   = base + 'book';    // or Calendly if you prefer
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 27001 Certification Support',
  serviceType: 'ISO 27001 Certification',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso27001',
  description:
    'Get your ISMS certified in 8–12 weeks. Gap assessment, policies, risk, Statement of Applicability, internal audit and audit readiness — with automated evidence in Microsoft 365 & SharePoint.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does ISO 27001 certification take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most SMBs complete in 8–12 weeks with a tight scope and automated evidence in Microsoft 365.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need to buy a new platform?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We embed process and automation inside your Microsoft 365 stack so evidence lives in SharePoint.'
      }
    },
    {
      '@type': 'Question',
      name: 'What’s included in your ISO 27001 engagement?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Gap assessment, policy suite, risk register, Statement of Applicability, control implementation, internal audit, and audit readiness with the certifying body.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do you help with audits?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We prepare evidence packs, handle auditor Q&A and guide interviews. We can also perform annual internal audits.'
      }
    }
  ]
};
---

<Base
  title="ISO 27001 Certification & ISMS Consulting — Australia | Compliance365"
  description="ISO 27001 certification in 8–12 weeks. ISMS implementation, risk, SoA and internal audit — with audit-ready evidence captured in Microsoft 365 & SharePoint."
  schema={[
    {
      "@type":"Service",
      "@id":"https://www.compliance365.com.au/services/iso27001#service",
      "serviceType":"ISO 27001 Certification & ISMS",
      "name":"ISO 27001 Consulting (Australia)",
      "url":"https://www.compliance365.com.au/services/iso27001",
      "areaServed":{"@type":"Country","name":"Australia"},
      "provider":{"@type":"Organization","name":"Compliance365","url":"https://www.compliance365.com.au"},
      "offers":{"@type":"Offer","availability":"https://schema.org/InStock"}
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Services","item":"https://www.compliance365.com.au/services"},
        {"@type":"ListItem","position":3,"name":"ISO 27001","item":"https://www.compliance365.com.au/services/iso27001"}
      ]
    }
  ]}
/>
  <Header />

  <Fragment slot="faq">
    <script type="application/ld+json">
      {JSON.stringify(faqLd)}
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="container section">
    <div class="grid-2" style="align-items:center">
      <div>
      <h1>ISO 27001 Certification — Simplified & Accelerated</h1>
      <p class="muted">
        ISO 27001 doesn’t need to take six months. We help you build a <strong>certified ISMS in 8–12 weeks</strong>
        by working inside your existing Microsoft 365 environment — no new platforms, no wasted effort.
      </p>
      <p class="muted">
        Our process turns policies and controls into live evidence that auditors can verify instantly in
        <strong>SharePoint, Entra ID, Defender, Intune and Purview</strong>.
      </p>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px">
          <span class="pill">Gap assessment</span>
          <span class="pill">Policies &amp; ISMS</span>
          <span class="pill">Risk register</span>
          <span class="pill">Statement of Applicability</span>
          <span class="pill">Internal audit</span>
          <span class="pill">Audit readiness</span>
        </div>

        <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
          <a class="btn btn-ghost" href={base + 'case-studies'}>See ISO 27001 results</a>
          <a class="btn btn-ghost" href={base + 'checklist/iso27001'}>Try the readiness checklist</a>
        </div>
      </div>

      <div class="card" style="padding:0;overflow:hidden;border-radius:22px">
        <img src={(import.meta.env.BASE_URL)+'assets/illus-iso27001.svg'} alt="ISO 27001 ISMS flow and audit evidence in SharePoint" style="width:100%;height:auto"/>
      </div>
    </div>
  </section>

  <!-- Why it matters -->
<h2>Why ISO 27001 matters</h2>
<p class="muted">
  ISO 27001 is the globally recognised standard for managing information security.
  It gives customers, partners and regulators confidence that your business
  <strong>protects data, manages risk, and responds effectively to incidents</strong>.
</p>
<div class="grid-3" style="margin-top:14px">
  <div class="card feature center">
    <h3>Build customer trust</h3>
    <p class="muted small">Demonstrate that you take security seriously — often a prerequisite for enterprise and government contracts.</p>
  </div>
  <div class="card feature center">
    <h3>Reduce risk & downtime</h3>
    <p class="muted small">Identify, assess and treat security risks before they impact operations or reputation.</p>
  </div>
  <div class="card feature center">
    <h3>Streamline compliance</h3>
    <p class="muted small">Meet overlapping requirements across ISO 27017, 27701, 42001 and SOC 2 with one coherent framework.</p>
  </div>
</div>

  <!-- OUTCOMES -->
  <section class="container section">
    <h2>Outcomes you can count on</h2>
<div class="grid-3">
  <div class="card">
    <h3>Certified faster</h3>
    <p class="muted">SMBs typically certify in <strong>8–12 weeks</strong> with a clear scope and automated evidence workflow.</p>
  </div>
  <div class="card">
    <h3>Auditor-ready from day one</h3>
    <p class="muted">All artefacts traceable in <strong>SharePoint</strong> with version history and timestamps.</p>
  </div>
  <div class="card">
    <h3>Proven success</h3>
    <p class="muted">Certified environments for <strong>health, finance and technology</strong> sectors across Australia.</p>
  </div>
</div>
  </section>

 <!-- How we Work-->
<h2>How we work</h2>
<div class="grid-3">
  <div class="card feature center">
    <h3>1) Assess</h3>
    <p class="muted small">We define your scope, identify quick wins and map maturity using live tenant data.</p>
  </div>
  <div class="card feature center">
    <h3>2) Implement</h3>
    <p class="muted small">Policies, risk register, SoA, and technical controls — built directly in Microsoft 365.</p>
  </div>
  <div class="card feature center">
    <h3>3) Validate</h3>
    <p class="muted small">Internal audit, corrective actions and auditor preparation for certification.</p>
  </div>
</div>

  <!-- WHAT’S INCLUDED -->
  <section class="container section">
    <h2>What you get</h2>
<ul class="muted">
  <li><strong>Gap Assessment & Roadmap</strong> — Clear view of current vs target state with week-by-week plan.</li>
  <li><strong>Policy Suite & ISMS Framework</strong> — All required documents aligned to ISO 27001:2022.</li>
  <li><strong>Risk Register & SoA</strong> — Traceable risks, treatments and controls in a single source of truth.</li>
  <li><strong>Implementation Support</strong> — Configuration of M365 controls and evidence automation.</li>
  <li><strong>Internal Audit & Readiness</strong> — Findings, CAPA tracking and final audit preparation.</li>
</ul>
  </section>

  <!-- TIMELINE -->
  <section class="container section">
    <h2>Timeline</h2>
    <div class="card">
      <p class="muted" style="margin:0">
        <strong>Week 1–2:</strong> Gap, scope, plan • 
        <strong>Week 3–6:</strong> Policies, risk, SoA, control build • 
        <strong>Week 7–8:</strong> Internal audit • 
        <strong>Week 9–12:</strong> Remediation &amp; external audit
      </p>
    </div>
  </section>

<!-- COMMON CHALLENGES WE SOLVE -->
<section class="container section">
  <h2>Common challenges we solve</h2>
  <p class="muted" style="max-width:820px;margin-top:-4px">
    Most teams start ISO 27001 projects with the same concerns — limited time, unclear scope,
    and pressure from auditors. We’ve solved them all before.
  </p>

  <div class="grid-3" style="margin-top:14px">
    <div class="card">
      <h3>“We don’t have time.”</h3>
      <p class="muted small">
        We streamline workshops and automate evidence so teams stay productive without losing
        weeks to documentation.
      </p>
    </div>

    <div class="card">
      <h3>“Our auditor needs proof.”</h3>
      <p class="muted small">
        Every control has live evidence, screenshots or exports traceable in SharePoint —
        ready for audit at any time.
      </p>
    </div>

    <div class="card">
      <h3>“We’re worried about scope.”</h3>
      <p class="muted small">
        We right-size your ISMS — starting with what’s critical to certify first, then
        scaling to other systems over time.
      </p>
    </div>
  </div>
</section>

  <!-- FAQ (on-page + JSON-LD) -->
  <section class="container section">
    <h2>ISO 27001 FAQs</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>How long does it take?</h3>
        <p class="muted">Most SMBs complete in <strong>8–12 weeks</strong> when scope is tight and evidence is automated.</p>
      </div>
      <div class="card">
        <h3>Do we need a new platform?</h3>
        <p class="muted"><strong>No.</strong> We embed in Microsoft 365 and store evidence in SharePoint with retention/versioning.</p>
      </div>
      <div class="card">
        <h3>Can you handle audits?</h3>
        <p class="muted">Yes — evidence packs, auditor Q&amp;A and interviews. We also run annual internal audits.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Let’s get you ISO 27001-ready</h3>
<p class="muted" style="margin:0">Map your shortest path to certification and automate the evidence along the way.</p>
<a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
    </div>
  </section>

<section class="container section">
  <div class="card" style="display:flex;gap:12px;flex-wrap:wrap">
    <strong style="margin-right:8px">Related services:</strong>
    <a class="pill" href="/services/iso27001">ISO 27001</a>
    <a class="pill" href="/services/iso27701">ISO 27701</a>
    <a class="pill" href="/services/iso42001">ISO 42001</a>
    <a class="pill" href="/services/soc2">SOC 2</a>
    <a class="pill" href="/services/essential-eight">Essential Eight</a>
    <a class="pill" href="/services/nist-csf">NIST CSF</a>
    <a class="pill" href="/services/disp-ism-irap">DISP / ISM / IRAP</a>
  </div>
</section>
  <Footer />

</Base>
