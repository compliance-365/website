---
import '../styles/responsive.css';
import Clarity from "../components/Clarity.astro";

const {
  title = 'Compliance365 — Cyber, Privacy & AI Governance',
  description = 'ISO 27001, ISO 42001, ISO 27701 & SOC 2 delivered faster with automation and SharePoint evidence.',
  ogImage = (Astro.site
    ? new URL('assets/og-default.png', Astro.site).toString()
    : (import.meta.env.BASE_URL) + 'assets/og-default.png'),
  schema = [],
  breadcrumbs = [] // <-- new breadcrumb array support
} = Astro.props ?? {};
const base = import.meta.env.BASE_URL || '/';
const canonical = Astro.url?.href || 'https://www.compliance365.com.au/';
const LOGO_512 = 'https://www.compliance365.com.au/assets/logo.svg';
const LOGO_192 = 'https://www.compliance365.com.au/assets/logo-192.png';

// Base organization + website schema
const ORG = {
  "@type": "Organization",
  "@id": "https://www.compliance365.com.au/#org",
  "name": "Compliance365",
  "alternateName": ["Compliance 365", "Compliance365 Australia"],
  "url": "https://www.compliance365.com.au",
  "logo": LOGO_512,
  "sameAs": [
    "https://www.linkedin.com/company/compliance-365/"
  ],
  "serviceArea": { "@type": "Country", "name": "Australia" },
  "knowsAbout": [
    "ISO 27001","ISO 27701","ISO 42001","SOC 2",
    "ACSC Essential Eight","NIST CSF","IRAP","ISM","DISP"
  ]
};
const WEBSITE = {
  "@type": "WebSite",
  "@id": "https://www.compliance365.com.au/#website",
  "url": "https://www.compliance365.com.au",
  "name": "Compliance365",
  "inLanguage": "en-AU",
  "publisher": { "@id": "https://www.compliance365.com.au/#org" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://www.compliance365.com.au/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
// Breadcrumb Schema if breadcrumbs provided
const BREADCRUMB_SCHEMA = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url
      }))
    }
  : null;
// Merge graph items
const pageGraph = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const fullGraph = [ORG, WEBSITE];
if (BREADCRUMB_SCHEMA) fullGraph.push(BREADCRUMB_SCHEMA);
if (pageGraph.length) fullGraph.push(...pageGraph);
// Add “about” + “mentions” for entity clarity
fullGraph.push({
  "@type": "WebPage",
  "@id": canonical + "#webpage",
  "url": canonical,
  "name": title,
  "about": [
    "Cybersecurity compliance", "Privacy management", "AI governance",
    "ISO 27001", "ISO 27701", "ISO 42001", "SOC 2", "Essential Eight"
  ],
  "mentions": [
    "Australian Privacy Act", "NIST CSF", "IRAP", "ISM", "DISP"
  ]
});
const ldJson = JSON.stringify({ "@context": "https://schema.org", "@graph": fullGraph });
---
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <!-- Google Site Verification for Search Console ✅ -->
    <meta name="google-site-verification" content="fVhBOuNty9-ozH-lL9FvtPHiQ25rDMA7PjZIPDdgmbk" />
    <!-- Meta -->
    <meta name="description" content={description} />
    {Astro.props.robots
      ? <meta name="robots" content={Astro.props.robots} />
      : <meta name="robots" content="index,follow" />
    }
    <meta name="theme-color" content="#1e40af" />
    <!-- Discovery -->
    <link rel="sitemap" type="application/xml" href="https://www.compliance365.com.au/sitemap-index.xml" />
    <link rel="robots" href="https://www.compliance365.com.au/robots.txt" />
    <link rel="ai" href="https://www.compliance365.com.au/ai.txt" />
    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Icons -->
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload + non-blocking load -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap"
      />
    </noscript>
    <!-- CSS -->
    <link rel="stylesheet" href={(import.meta.env.BASE_URL) + 'assets/brand.css'} />
    <!-- ✅ Quick baseline -->
    <style>
      body{font-family:Nunito,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;margin:0}
      a{color:var(--primary,#1e40af)}
      .container{max-width:1120px;margin:0 auto;padding:0 22px}
    </style>

    <!-- Google Analytics 4 (GA4) – lazy loaded -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const GA_ID = 'G-082VYX6D26';
        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
        window.addEventListener('load', loadGA);
        ['click','scroll','keydown'].forEach(evt => {
          window.addEventListener(evt, loadGA, { once: true });
        });
      }
    </script>

    <!-- Bing Clarity tracking -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "mghgmkzj0r");
    </script>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={ldJson}></script>
  </head>
  <body>
    <slot />

    <!-- Cookie Consent Banner – Automatically shows on first visit -->
    <div id="cookie-banner" class="cookie-banner" hidden>
      <div class="cookie-inner">
        <p class="cookie-text">
          We use cookies to enhance your experience, analyse traffic, and improve the site. 
          Essential cookies are always enabled. You can accept all, reject non-essential, or customize preferences.
        </p>

        <div class="cookie-actions">
          <button id="cookie-preferences" class="btn btn-ghost">Preferences</button>
          <button id="cookie-reject" class="btn">Reject Non-Essential</button>
          <button id="cookie-accept" class="btn btn-primary">Accept All</button>
        </div>
      </div>
    </div>

    <!-- Preferences Modal -->
    <div id="cookie-modal" class="cookie-modal" hidden>
      <div class="cookie-modal-inner">
        <h3>Cookie Preferences</h3>
        <p class="muted">Customize your cookie settings. Essential cookies are required for the site to function.</p>

        <div class="cookie-options">
          <label>
            <input type="checkbox" checked disabled />
            <span><strong>Essential Cookies</strong> – Required for site functionality (e.g., navigation, security)</span>
          </label>
          <label>
            <input type="checkbox" id="analytics-cookies" />
            <span><strong>Analytics Cookies</strong> – Help us understand how visitors use the site (e.g., Google Analytics)</span>
          </label>
        </div>

        <div class="cookie-modal-actions">
          <button id="cookie-save" class="btn btn-primary">Save Preferences</button>
          <button id="cookie-modal-close" class="btn btn-ghost">Close</button>
        </div>
      </div>
    </div>

    <!-- Cookie Consent Script – Controls visibility & consent -->
    <script is:inline>
      const banner = document.getElementById('cookie-banner');
      const modal = document.getElementById('cookie-modal');
      const KEY = 'c365_cookie_consent';
      const saved = localStorage.getItem(KEY);

      // Show banner automatically on first visit (or if no consent saved)
      if (!saved) {
        banner.hidden = false;
      }

      // Accept All – grant analytics
      document.getElementById('cookie-accept')?.addEventListener('click', () => {
        localStorage.setItem(KEY, 'accepted');
        banner.hidden = true; // Hide banner
      });

      // Reject Non-Essential – deny analytics
      document.getElementById('cookie-reject')?.addEventListener('click', () => {
        localStorage.setItem(KEY, 'rejected');
        banner.hidden = true; // Hide banner
      });

      // Open Preferences Modal
      document.getElementById('cookie-preferences')?.addEventListener('click', () => {
        modal.hidden = false;
      });

      // Save Preferences
      document.getElementById('cookie-save')?.addEventListener('click', () => {
        const analytics = document.getElementById('analytics-cookies')?.checked ? 'granted' : 'denied';
        localStorage.setItem(KEY, JSON.stringify({ analytics_storage: analytics }));
        banner.hidden = true; // Hide banner
        modal.hidden = true;  // Hide modal
      });

      // Close Modal
      document.getElementById('cookie-modal-close')?.addEventListener('click', () => {
        modal.hidden = true;
      });

      // Close modal on outside click
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.hidden = true;
      });
    </script>

    <!-- Your existing floating messaging launcher, call now, teams chat, etc. -->
    <div class="fab-msg">
      <!-- ... your existing code ... -->
    </div>

    <!-- Call Now -->
    <a
      href="tel:+61468752243"
      class="fab-call"
      aria-label="Call Compliance365"
    >
      📞
    </a>

    <!-- Desktop-only Microsoft Teams chat -->
    <a
      href="https://teams.microsoft.com/l/chat/0/0?users=info@compliance365.com.au&message=Hi%20Compliance365%2C%20I%E2%80%99d%20like%20help%20with%20ISO%2027001%2C%20SOC%202%20or%20AI%20governance."
      class="fab-teams"
      aria-label="Chat with Compliance365 on Microsoft Teams"
      target="_blank"
      rel="noopener"
    >
      <img
        src="/assets/icons/icon-teams.svg"
        alt="Microsoft Teams"
        style="width:26px;height:26px;"
      />
    </a>

    <!-- Optional FAQ JSON-LD slot -->
    <slot name="faq" />
  </body>
</html>
