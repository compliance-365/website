---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

const services = [
  {
    title: 'ISO 27001 (Security)',
    summary: 'Get certified fast — gap analysis, risk treatment, SoA, and audit-ready evidence, all automated in your Microsoft 365 environment.',
    url: '/services/iso27001',
    image: base + 'assets/illus-iso27001.svg',
    tags: ['Gap analysis', 'SoA']
  },
  {
    title: 'ISO 27701 (Privacy)',
    summary: 'Extend security into privacy — DPIAs, ROPAs, data rights workflows, and training, without adding new tools.',
    url: '/services/iso27701',
    image: base + 'assets/illus-iso27001.svg',
    tags: ['DPIA', 'ROPA']
  },
  {
    title: 'ISO 42001 (AI Governance)',
    summary: 'Build responsible AI — model inventory, risk assessment, oversight, and monitoring, all inside your existing stack.',
    url: '/services/iso42001',
    image: base + 'assets/illus-iso27001.svg',
    tags: ['AI risk', 'Oversight']
  },
  {
    title: 'SOC 2 Readiness (Type I/II)',
    summary: 'Trust Services Criteria mapped to your systems. Type 1 & Type 2 readiness with reusable, automated evidence for sales.',
    url: '/services/soc2',
    image: base + 'assets/illus-soc2.svg',
    tags: ['Type 1', 'Type 2']
  },
  {
    title: 'Essential Eight Uplift',
    summary: 'Practical maturity uplift — patching, macros, app control, MFA, backups — all leveraging your Microsoft E5 stack.',
    url: '/services/essential-eight',
    image: base + 'assets/illus-essential-eight.svg',
    tags: ['MFA', 'App control']
  },
  {
    title: 'DISP, ISM & IRAP',
    summary: 'Defence-grade uplift and alignment — automated evidence and audit support within Microsoft 365.',
    url: '/services/disp-ism-irap',
    image: base + 'assets/illus-disp-ism-irap.svg',
    tags: ['DISP', 'ISM', 'IRAP']
  },
  {
    title: 'NIST Cybersecurity Framework',
    summary: 'Align to NIST CSF (Identify → Protect → Detect → Respond → Recover) — mapped to ISO 27001 and Essential Eight.',
    url: '/services/nist-csf',
    image: base + 'assets/illus-nist-csf.svg',
    tags: ['NIST CSF', 'Mapping']
  }
];
---

<Base
  title="Our Services — Fast, Practical Compliance for Australian Teams"
  description="ISO 27001, SOC 2, AI Governance, Privacy, Essential Eight — delivered in weeks inside your existing environment, with automated evidence."
>
  <Header />

  <!-- HERO / SERVICES INTRO -->
  <section class="hero-wrap">
    <div class="container">
      <div class="section-head center">
        <h1>Compliance Services Built for Speed & Results</h1>
        <p class="section-lead muted">
          Pick the outcome you need. We map the shortest path, automate evidence in Microsoft 365, and help you close deals faster — without new tools or disruption.
        </p>
      </div>

      <!-- Trust bar -->
      <div class="trust-badges center" style="margin:2.5rem 0;">
        <span>No New Tools</span>
        <span>No Disruption</span>
        <span>Revenue-Focused</span>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="section">
    <div class="container">
      <div class="grid-3">
        {services.map((s) => (
          <a href={s.url} class="card feature" style="text-decoration:none;color:inherit;">
            <div class="cover">
              <img src={s.image} alt={`${s.title} illustration`} loading="lazy" />
            </div>
            <h3>{s.title}</h3>
            <p class="muted">{s.summary}</p>
            <div class="pill-row" style="margin-top:1rem;">
              {s.tags.map((t, i) => (
                <span class={`pill ${i === 0 ? 'brand' : ''}`}>{t}</span>
              ))}
            </div>
          </a>
        ))}
      </div>

      <!-- Final CTA under grid -->
      <div class="cta-center" style="text-align:center;margin-top:5rem;">
        <a href={ctaUrl} class="btn btn-primary large">
          Book a Free Call — Let’s Map Your Fastest Path
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* === Services-specific tweaks (aligned with Home) =========== */
  .hero-wrap {
    padding: 8rem 0 6rem;
    background: linear-gradient(135deg, #f0f7ff 0%, white 100%);
  }

  .section-head.center h1 {
    font-size: clamp(2.8rem, 5vw, 3.8rem);
    margin-bottom: 1rem;
  }

  .trust-badges span {
    background: white;
    padding: 0.7rem 1.4rem;
    border-radius: 2rem;
    border: 1px solid #e2e8f0;
    font-weight: 600;
    font-size: 1rem;
    margin: 0.5rem;
  }

  .card.feature {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.08);
  }

  .card.feature:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px -15px rgba(30,64,175,0.25);
  }

  .cover {
    aspect-ratio: 16/9;
    background: #f8fafc;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .cover img {
    width: 100%;
    height: 180px;
    object-fit: contain;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: flex-start;
  }

  .pill {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .pill.brand {
    background: var(--primary);
    color: white;
  }

  @media (max-width: 1024px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .grid-3 { grid-template-columns: 1fr; }
    .cover img { height: 160px; }
  }
</style>
