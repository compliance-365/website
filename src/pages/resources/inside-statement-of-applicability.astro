---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book';
const templateUrl = `${base}assets/templates/soa-template.xlsx`;
const pageTitle = 'Inside a Statement of Applicability (SoA): ISO 27001, 27701 & 42001 Explained';
const pageDesc =
  'Learn what a Statement of Applicability (SoA) is, why auditors rely on it, and how to design one that links risk, controls and evidence across ISO 27001, ISO 27701 and ISO 42001.';
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={[
    {
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDesc,
      "about": [
        {"@type":"Thing","name":"ISO 27001"},
        {"@type":"Thing","name":"ISO 27701"},
        {"@type":"Thing","name":"ISO 42001"},
        {"@type":"Thing","name":"Statement of Applicability"},
        {"@type":"Thing","name":"Information Security Management System"}
      ],
      "isPartOf": {"@id": "https://www.compliance365.com.au#website"}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Resources","item":"https://www.compliance365.com.au/resources"},
        {"@type":"ListItem","position":3,"name":"Inside a Statement of Applicability","item":"https://www.compliance365.com.au/resources/inside-statement-of-applicability"}
      ]
    }
  ]}
>
  <Header />

  <!-- HERO – Impactful & professional -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1 class="hero-title">{pageTitle}</h1>
          <p class="section-lead muted">
            The Statement of Applicability (SoA) is the beating heart of your management system — whether ISO 27001 (security), ISO 27701 (privacy), or ISO 42001 (AI governance). It connects risks to controls and evidence, proving your program is intentional and effective.
          </p>
          <div class="pill-row" style="margin:2rem 0;">
            <span class="pill">ISO 27001</span>
            <span class="pill">ISO 27701</span>
            <span class="pill">ISO 42001</span>
            <span class="pill">Risk linkage</span>
            <span class="pill">Audit-ready</span>
          </div>
          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">Book a SoA Assessment</a>
            <a href={`${base}resources`} class="btn btn-outline">Back to Resources</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/guide-soa.svg`}
            alt="Statement of Applicability linking risks, controls and evidence"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IT IS -->
  <section class="section">
    <div class="container">
      <h2 class="center">What is the Statement of Applicability?</h2>
      <p class="muted center" style="max-width:880px;margin:1.5rem auto;">
        The SoA is the central document in ISO 27001, ISO 27701, and ISO 42001. It lists every relevant control from the respective Annex A, declares whether it is applied, excluded, or substituted, and justifies the decision with risk evidence.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Links Risk to Controls</h3>
          <p class="muted small">
            Shows how each selected control addresses identified risks — ensuring your program is intentional, not arbitrary.
          </p>
        </div>
        <div class="card feature center">
          <h3>Defines Implementation</h3>
          <p class="muted small">
            Documents where each control lives — in policy, process, technology, or people — with clear ownership.
          </p>
        </div>
        <div class="card feature center">
          <h3>Enables Auditability</h3>
          <p class="muted small">
            Provides the evidence path and review cadence for every control — auditors start here.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Why the SoA Matters to Your Certification</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        A well-built SoA gives auditors confidence in your control design and maturity — and gives your team clarity on what’s required.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Transparency for Auditors</h3>
          <p class="muted small">
            A current SoA shows your controls are deliberate and tied to real risks — building trust fast.
          </p>
        </div>
        <div class="card feature center">
          <h3>Clarity for Management</h3>
          <p class="muted small">
            Summarises what’s in scope, what’s excluded, and the residual risk rationale — easy for executives to understand.
          </p>
        </div>
        <div class="card feature center">
          <h3>Efficiency for Teams</h3>
          <p class="muted small">
            Prevents duplicated effort and streamlines evidence collection — saving weeks during audits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- AUDITOR EXPECTATIONS -->
  <section class="section">
    <div class="container">
      <h2 class="center">What Auditors Look For</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Auditors start with the SoA — it’s the index for your entire management system.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Traceability</h3>
          <p class="muted small">
            Each selected/excluded control links back to the risk register.
          </p>
        </div>
        <div class="card feature center">
          <h3>Implementation Detail</h3>
          <p class="muted small">
            Where and how the control operates — policy, process, technology, or people.
          </p>
        </div>
        <div class="card feature center">
          <h3>Evidence Pointers</h3>
          <p class="muted small">
            Screenshots, exports, approvals, and review logs — clear and current.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO STRUCTURE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Designing a Maintainable SoA</h2>
      <p class="muted center" style="max-width:880px;margin:1.5rem auto;">
        The best SoAs live inside your existing tools — a SharePoint list or Excel-in-SharePoint with versioning beats a static Word file. It keeps ownership clear and evidence current.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Scope & Risk</h3>
          <p class="muted small">
            State scope, context, and risk methodology — keep it concise but specific.
          </p>
        </div>
        <div class="card feature center">
          <h3>Selection Rationale</h3>
          <p class="muted small">
            Explain inclusions, exclusions, and any compensating controls.
          </p>
        </div>
        <div class="card feature center">
          <h3>Evidence Map</h3>
          <p class="muted small">
            Reference folders and monthly snapshots — auditors can verify status instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SAMPLE SOA TABLE – Enterprise-Grade -->
<section class="section">
  <div class="container">
    <h2 class="center">Sample Statement of Applicability (SoA) Table</h2>
    <p class="muted center" style="max-width:880px;margin:1.5rem auto;">
      Here’s a realistic example table (ISO 27001, 27701 & 42001 integrated). Auditors love this format — traceable, current, and evidence-linked.
    </p>

    <div class="soa-table-wrapper">
      <table class="soa-table">
        <thead>
          <tr>
            <th>Control ID</th>
            <th>Title</th>
            <th>Framework</th>
            <th>Risk Link / Rationale</th>
            <th>Status</th>
            <th>Owner</th>
            <th>Evidence Location</th>
            <th>Review Cadence</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>A.5.1</td>
            <td>Information Security Policies</td>
            <td><span class="framework-badge iso27001">ISO 27001</span></td>
            <td>Risk of inconsistent security practices</td>
            <td><span class="status-badge implemented">Implemented</span></td>
            <td>CISO</td>
            <td>/Evidence/Policies/InfoSec-Policy-v2.pdf</td>
            <td>Annual</td>
          </tr>
          <tr>
            <td>A.8.2.1</td>
            <td>Classification of Information</td>
            <td><span class="framework-badge iso27001">ISO 27001</span></td>
            <td>Risk of data leakage</td>
            <td><span class="status-badge implemented">Implemented</span></td>
            <td>Data Owner</td>
            <td>/Evidence/Classification/Labels-Purview-Export.csv</td>
            <td>Quarterly</td>
          </tr>
          <tr>
            <td>A.7.2.1</td>
            <td>Data Subject Rights Handling</td>
            <td><span class="framework-badge iso27701">ISO 27701</span></td>
            <td>Risk of non-compliance with privacy rights</td>
            <td><span class="status-badge implemented">Implemented</span></td>
            <td>Privacy Officer</td>
            <td>/Evidence/27701/DSR-Requests-Log.xlsx</td>
            <td>Monthly</td>
          </tr>
          <tr>
            <td>A.5.1 (42001)</td>
            <td>AI Governance Policy</td>
            <td><span class="framework-badge iso42001">ISO 42001</span></td>
            <td>Risk of unethical AI use</td>
            <td><span class="status-badge implemented">Implemented</span></td>
            <td>AI Governance Lead</td>
            <td>/Evidence/42001/AI-Policy-v1.pdf</td>
            <td>Annual</td>
          </tr>
          <tr>
            <td>A.8.28</td>
            <td>Secure Development</td>
            <td><span class="framework-badge iso27001">ISO 27001</span></td>
            <td>Risk of vulnerabilities in code</td>
            <td><span class="status-badge excluded">Excluded</span></td>
            <td>N/A</td>
            <td>Compensating control: 3rd-party pen testing</td>
            <td>N/A</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

  <!-- SUMMARY CARD – Replaces Flowchart -->
<section class="section" style="background:#f8fafc;">
  <div class="container">
    <div class="card" style="max-width:900px;margin:0 auto;padding:2.5rem;border-radius:20px;box-shadow:var(--shadow);background:white;">
      <h2 class="center" style="margin:0 0 1.5rem;">How the SoA Drives Your Compliance</h2>
      <p class="muted center" style="max-width:720px;margin:0 auto 2rem;">
        The Statement of Applicability is the bridge between your risks and your controls — ensuring everything is intentional, auditable, and defensible.
      </p>

      <div class="grid-3" style="margin-top:2rem;">
        <div class="feature center">
          <div class="icon" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
              <path d="M12 6v12" />
            </svg>
          </div>
          <h3>Risks Identified</h3>
          <p class="muted small">Start with your risk register — every control decision ties back here.</p>
        </div>
        <div class="feature center">
          <div class="icon" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M2 12h20" />
            </svg>
          </div>
          <h3>Controls Decided</h3>
          <p class="muted small">The SoA documents what applies, what’s excluded, and why — with clear rationale.</p>
        </div>
        <div class="feature center">
          <div class="icon" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M8 10h8M8 14h8" />
            </svg>
          </div>
          <h3>Evidence Linked</h3>
          <p class="muted small">Direct pointers to screenshots, logs, exports — auditors verify in seconds.</p>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- INTEGRATION ACROSS FRAMEWORKS -->
  <section class="section">
    <div class="container">
      <h2 class="center">How the SoA Works Across ISO 27001, 27701 & 42001</h2>
      <p class="muted center" style="max-width:880px;margin:1.5rem auto;">
        The beauty of a unified SoA is that one table can cover multiple standards — reducing duplication and creating a single source of truth.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>ISO 27001 (Security)</h3>
          <p class="muted small">
            Core focus: protect information assets from threats — Annex A 93 controls.
          </p>
        </div>
        <div class="card feature center">
          <h3>ISO 27701 (Privacy)</h3>
          <p class="muted small">
            Extends ISO 27001 with privacy controls (Annex A/B) — ROPA, DPIA, rights handling.
          </p>
        </div>
        <div class="card feature center">
          <h3>ISO 42001 (AI Governance)</h3>
          <p class="muted small">
            Adds responsible AI controls — model inventory, risk assessment, oversight, monitoring.
          </p>
        </div>
      </div>

      <p class="muted center" style="margin-top:2rem;max-width:880px;">
        Use one SoA — map overlapping controls (e.g. access control appears in all three) — and maintain a single evidence register. This saves time, reduces audit fatigue, and proves to stakeholders you have a cohesive program.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Statement of Applicability FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>Is the SoA mandatory?</h3>
          <p class="muted">
            Yes — it’s a core requirement of ISO 27001 Clause 6.1.3 and Annex A (also applies to ISO 27701 & ISO 42001).
          </p>
        </div>
        <div class="card">
          <h3>How often should it be reviewed?</h3>
          <p class="muted">
            At least annually, or whenever scope, risk, or controls change.
          </p>
        </div>
        <div class="card">
          <h3>Can we reuse it for other frameworks?</h3>
          <p class="muted">
            Yes — map controls to ISO 27701, ISO 42001, NIST CSF or SOC 2 to reduce duplicate effort.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA – Matching Home page blue -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Ready to Simplify Your SoA?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        Book a free 30-minute call — we’ll show you how to build a maintainable SoA that links risks, controls and evidence across ISO 27001, 27701 and 42001.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Book Free Call Now
        </a>
        <a href={`${base}resources`} class="btn btn-outline large" style="color:white;border-color:white;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Back to Resources
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
        Most teams build a strong SoA foundation in under 4 weeks.
      </p>
    </div>
  </section>

  <Footer />
</Base>
