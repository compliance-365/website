  <Footer />
</Base>

<!-- ============================================================
  AI CHAT AGENT — ComplianceBot
  Drop-in widget that uses the Anthropic API (proxied through
  your Astro backend) to answer compliance questions, recommend
  frameworks, and qualify leads — 24/7 without you on the phone.

  HOW TO WIRE UP THE BACKEND:
  1. Create src/pages/api/chat.ts (see companion file)
  2. Set ANTHROPIC_API_KEY in your .env file
  3. The widget POSTs to /api/chat — no client-side key exposure

  CUSTOMISATION:
  - Change WELCOME_MESSAGE to match your tone
  - Add more QUICK_REPLIES to guide common queries
  - Swap the avatar SVG for your logo
============================================================ -->
<div id="chatWidget" class="chat-widget" aria-label="ComplianceBot — AI compliance assistant" role="complementary">

  <!-- Launcher button -->
  <button id="chatLauncher" class="chat-launcher" aria-label="Open ComplianceBot" aria-expanded="false" aria-controls="chatPanel">
    <span class="launcher-icon-closed" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </span>
    <span class="launcher-icon-open" aria-hidden="true">✕</span>
    <span class="launcher-label">Ask ComplianceBot</span>
  </button>

  <!-- Chat panel -->
  <div id="chatPanel" class="chat-panel" role="dialog" aria-modal="true" aria-label="ComplianceBot chat window" hidden>
    <div class="chat-header">
      <div class="chat-avatar" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
          <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <div class="chat-header-info">
        <strong>ComplianceBot</strong>
        <span class="chat-status">● Online — usually replies instantly</span>
      </div>
      <button class="chat-close-btn" aria-label="Close chat" id="chatClose">✕</button>
    </div>

    <div class="chat-messages" id="chatMessages" aria-live="polite" aria-relevant="additions">
      <!-- Welcome message injected by JS -->
    </div>

    <!-- Quick-reply suggestions -->
    <div class="quick-replies" id="quickReplies" aria-label="Suggested questions">
      <button class="qr-btn" data-msg="Which compliance framework do I need?">Which framework do I need?</button>
      <button class="qr-btn" data-msg="How long does ISO 27001 take?">How long does ISO 27001 take?</button>
      <button class="qr-btn" data-msg="What does it cost?">What does it cost?</button>
      <button class="qr-btn" data-msg="Do I need ISO 42001 for AI?">Do I need ISO 42001?</button>
    </div>

    <form class="chat-input-row" id="chatForm" aria-label="Send a message to ComplianceBot">
      <input
        type="text"
        id="chatInput"
        class="chat-input"
        placeholder="Ask about ISO 27001, SOC 2, AI governance…"
        autocomplete="off"
        maxlength="500"
        aria-label="Message"
      />
      <button type="submit" class="chat-send-btn" aria-label="Send message">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<!-- ============================================================
  JAVASCRIPT
============================================================ -->
<script>
// ── Testimonial Carousel ────────────────────────────────────
(function () {
  const track  = document.getElementById('testimonialTrack');
  const slides = track?.children;
  const prevBtn = document.getElementById('tPrev');
  const nextBtn = document.getElementById('tNext');
  const dotsContainer = document.getElementById('tDots');
  if (!track || !slides || !prevBtn || !nextBtn || !dotsContainer) return;

  let currentIndex = 0;

  Array.from(slides).forEach((_, i) => {
    const dot = document.createElement('button');
    dot.classList.add('t-dot');
    dot.setAttribute('role', 'tab');
    dot.setAttribute('aria-label', `Go to testimonial ${i + 1}`);
    if (i === 0) { dot.classList.add('active'); dot.setAttribute('aria-selected', 'true'); }
    dot.addEventListener('click', () => goToSlide(i));
    dotsContainer.appendChild(dot);
  });

  const dots = dotsContainer.children;

  function goToSlide(index) {
    currentIndex = index;
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    Array.from(dots).forEach((d, i) => {
      d.classList.toggle('active', i === currentIndex);
      d.setAttribute('aria-selected', String(i === currentIndex));
    });
  }

  prevBtn.addEventListener('click', () => goToSlide((currentIndex - 1 + slides.length) % slides.length));
  nextBtn.addEventListener('click', () => goToSlide((currentIndex + 1) % slides.length));

  let autoPlay = setInterval(() => goToSlide((currentIndex + 1) % slides.length), 6000);
  const carousel = document.getElementById('testimonialCarousel');
  if (carousel) {
    carousel.addEventListener('mouseenter', () => clearInterval(autoPlay));
    carousel.addEventListener('mouseleave', () => {
      autoPlay = setInterval(() => goToSlide((currentIndex + 1) % slides.length), 6000);
    });
  }
})();

// ── Industry Tabs ───────────────────────────────────────────
(function () {
  const tabs   = document.querySelectorAll('.ind-tab');
  const panels = document.querySelectorAll('.ind-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-tab');
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      document.getElementById(`tab-${id}`)?.classList.add('active');
    });
  });
})();

// ── AI Chat Agent ───────────────────────────────────────────
(function () {
  const launcher  = document.getElementById('chatLauncher');
  const panel     = document.getElementById('chatPanel');
  const closeBtn  = document.getElementById('chatClose');
  const form      = document.getElementById('chatForm');
  const input     = document.getElementById('chatInput');
  const messages  = document.getElementById('chatMessages');
  const qrBtns    = document.querySelectorAll('.qr-btn');

  if (!launcher || !panel || !form || !input || !messages) return;

  // System prompt — edit to match your exact services and tone
  const SYSTEM = `You are ComplianceBot, a friendly and knowledgeable AI assistant for Compliance365 (compliance365.com.au), an Australian compliance consultancy based in Brisbane.

Your role: help SaaS founders, CTOs, VPs Engineering, and security leads understand compliance frameworks, recommend the right certification path for their business, and answer pre-sales questions.

Key facts about Compliance365:
- Delivers ISO 27001, SOC 2, ISO 42001 (AI Governance), ISO 27701 (Privacy), Essential Eight, DISP/ISM/IRAP, NIST CSF
- Audit-ready in 8–12 weeks (vs 6–18 months for traditional consultants)
- 60–80% less than large consulting firms — fixed pricing, no scope creep
- Works entirely inside existing Microsoft 365/SharePoint environments — no new tools
- 100% first-time certification pass rate
- Serves Government, Healthcare/MedTech, SaaS, Finance, Defence industries
- Phone: +61 468 752243 | Email: info@compliance365.com.au

Guidelines:
- Be concise, practical, and direct — your audience is technical and time-poor
- Always recommend booking a free 30-min strategy call for specific scoping: https://calendly.com/matt-nicholas-compliance365/30min
- If someone asks about pricing, say it's fixed and typically 60–80% less than big firms, and offer to get them a specific quote on a call
- If someone describes their situation (industry, target market, size), recommend the most relevant framework(s)
- Never make up facts, certifications, or timelines you're not sure about
- Keep responses under 150 words unless a detailed answer is genuinely needed
- End responses with a relevant next step (book a call, try the free checklist, etc.)`;

  const conversationHistory = [];

  const WELCOME = `👋 Hi! I'm ComplianceBot — I can help you figure out which compliance framework you need, how long it takes, what it costs, and whether Compliance365 is a good fit.\n\nWhat's on your mind?`;

  function renderWelcome() {
    appendMessage('bot', WELCOME);
  }

  function appendMessage(role, text) {
    const div = document.createElement('div');
    div.classList.add('chat-msg', role === 'bot' ? 'msg-bot' : 'msg-user');
    // Safely render newlines
    div.innerHTML = text.replace(/</g, '&lt;').replace(/\n/g, '<br>');
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.classList.add('chat-msg', 'msg-bot', 'typing-indicator');
    div.id = 'typingIndicator';
    div.innerHTML = '<span></span><span></span><span></span>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function removeTyping() {
    document.getElementById('typingIndicator')?.remove();
  }

  async function sendMessage(text) {
    if (!text.trim()) return;

    // Hide quick replies after first message
    document.getElementById('quickReplies')?.style.setProperty('display', 'none');

    appendMessage('user', text);
    conversationHistory.push({ role: 'user', content: text });
    input.value = '';
    showTyping();

    try {
      // ── BACKEND CALL ──────────────────────────────────────
      // This calls your Astro API route at /api/chat
      // See the companion api/chat.ts file for the backend code
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          system: SYSTEM,
          messages: conversationHistory,
        }),
      });

      if (!res.ok) throw new Error('API error');

      const data = await res.json();
      const reply = data.content?.[0]?.text || 'Sorry, something went wrong. Please try again or call us on +61 468 752243.';

      removeTyping();
      appendMessage('bot', reply);
      conversationHistory.push({ role: 'assistant', content: reply });

    } catch {
      removeTyping();
      appendMessage('bot', 'Sorry, I\'m having trouble connecting. Please email info@compliance365.com.au or call +61 468 752243 — we\'d love to help.');
    }
  }

  // ── Event listeners ───────────────────────────────────────
  launcher.addEventListener('click', () => {
    const isOpen = !panel.hidden;
    panel.hidden = isOpen;
    launcher.setAttribute('aria-expanded', String(!isOpen));
    if (!isOpen && messages.childElementCount === 0) renderWelcome();
    if (!isOpen) input.focus();
  });

  closeBtn.addEventListener('click', () => {
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
    launcher.focus();
  });

  form.addEventListener('submit', e => {
    e.preventDefault();
    sendMessage(input.value);
  });

  qrBtns.forEach(btn => {
    btn.addEventListener('click', () => sendMessage(btn.getAttribute('data-msg') || ''));
  });

  // Close on Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !panel.hidden) {
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
    }
  });
})();
</script>

