---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'IS18 (Queensland Government Information and Cyber Security Policy)';

const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourorganisation.com.au' },
  { id: 'org-sector',   label: 'Your relationship to IS18',            type: 'select', required: true,  options: ['Queensland Government department or agency','Statutory body or government-owned corporation','ICT supplier or managed service provider to Queensland Government','Software or SaaS vendor to Queensland Government','Not sure yet'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–99','100–499','500–1 999','2 000+'] },
  { id: 'trigger',      label: 'What is driving this assessment?',     type: 'select', required: true,  options: ['Annual information security return','An agency has asked for an IS18 compliance statement','New contract, tender or panel','Essential Eight uplift','Internal readiness review','Other'] },
  { id: 'classification',label: 'Highest classification of Queensland Government information you handle', type: 'select', required: false, options: ['Not yet confirmed','OFFICIAL','SENSITIVE','PROTECTED'] },
  { id: 'timeline',     label: 'Target timeline',                      type: 'select', required: false, options: ['Not yet decided','Within 3 months','3–6 months','6–12 months','12+ months'] },
  { id: 'heard-about',  label: 'How did you hear about us?',          type: 'select', required: false, options: ['Google search','Google ad','LinkedIn','Referral or word of mouth','AI assistant (ChatGPT, Copilot and similar)','Event or webinar','Other'] },
];

const QUESTIONS = [
  {
    id: 'isms-scope',
    group: 'isms',
    label: 'The scope of our information security management system (ISMS) is defined and documented, covering the systems and services that hold Queensland Government information.',
    hint: 'IS18 requires an ISMS aligned to ISO 27001. A clear scope is the first thing an agency or assessor will ask for.',
    examples: [
      'Documented ISMS scope with systems, locations and services in and out of scope.',
      'Scope approved by senior management.',
      'Scope reviewed when systems or contracts change.'
    ]
  },
  {
    id: 'isms-policy',
    group: 'isms',
    label: 'An information security policy and supporting policies are approved by senior management, communicated to staff and reviewed at least annually.',
    hint: 'Approved, current policies are the backbone of the ISMS and the first evidence requested.',
    examples: [
      'Signed or approved information security policy.',
      'Supporting policies such as access control, acceptable use and incident response.',
      'Version history showing review in the last 12 months.'
    ]
  },
  {
    id: 'isms-risk',
    group: 'isms',
    label: 'We use a documented information security risk assessment method and keep a current risk register with owners and treatments.',
    hint: 'Risk management drives which controls you apply and is central to an ISO 27001-aligned ISMS.',
    examples: [
      'Documented risk assessment methodology.',
      'Risk register with likelihood, consequence, owner and treatment.',
      'Evidence of risks reviewed in the last 12 months.'
    ]
  },
  {
    id: 'isms-soa',
    group: 'isms',
    label: 'A Statement of Applicability records which controls apply, why, and how each is implemented.',
    hint: 'The Statement of Applicability shows an assessor or agency exactly how each control is handled.',
    examples: [
      'Statement of Applicability against ISO 27001 Annex A.',
      'Justification for each excluded control.',
      'Implementation status and evidence location for each control.'
    ]
  },
  {
    id: 'isms-review',
    group: 'isms',
    label: 'Management reviews the ISMS at least once a year, and an internal audit has been carried out in the last 12 months.',
    hint: 'Management review and internal audit prove the ISMS is operating, not just documented.',
    examples: [
      'Minutes of the most recent management review.',
      'Internal audit report and findings.',
      'Actions from the review and audit tracked to closure.'
    ]
  },
  {
    id: 'e8-assessed',
    group: 'e8',
    label: 'We have assessed all eight Essential Eight strategies against the maturity model, and know our current maturity level for each.',
    hint: 'IS18 requires the Essential Eight. Your agency selects its target maturity level based on its risk appetite, and reports against it.',
    examples: [
      'Essential Eight self-assessment per strategy.',
      'Evidence supporting each maturity rating.',
      'Date of the most recent assessment.'
    ]
  },
  {
    id: 'e8-target',
    group: 'e8',
    label: 'We have an agreed target maturity level and a roadmap, with owners and dates, to close the gap.',
    hint: 'A documented roadmap is what procurement teams look for when current maturity is below target.',
    examples: [
      'Endorsed target maturity level, chosen by risk appetite.',
      'Roadmap with milestones, owners and dates.',
      'Progress reported to senior management.'
    ]
  },
  {
    id: 'e8-mfa',
    group: 'e8',
    label: 'Multi-factor authentication is enforced for all users, and phishing-resistant methods are used for privileged and remote access.',
    hint: 'MFA is one of the most-tested Essential Eight strategies and one of the most commonly overstated.',
    examples: [
      'Conditional Access or equivalent policies requiring MFA.',
      'Report showing MFA registration across all users.',
      'Stronger MFA enforced for administrators.'
    ]
  },
  {
    id: 'e8-patch',
    group: 'e8',
    label: 'Applications and operating systems are patched within the Essential Eight timeframes, and unsupported software is removed.',
    hint: 'Patching timeframes are specific and auditable. Gaps here are common findings.',
    examples: [
      'Patch compliance reports for devices and servers.',
      'Process for urgent patches for internet-facing services.',
      'List of unsupported software and its removal plan.'
    ]
  },
  {
    id: 'e8-admin',
    group: 'e8',
    label: 'Administrative privileges are restricted and reviewed, and backups are taken, tested and protected from change.',
    hint: 'Privileged access and backups are where incidents are won or lost.',
    examples: [
      'List of privileged accounts with justification.',
      'Periodic access review records.',
      'Backup restore test results.'
    ]
  },
  {
    id: 'class-scheme',
    group: 'class',
    label: 'We have adopted the Queensland Government Information Security Classification Framework (QGISCF), and know which information we hold at OFFICIAL, SENSITIVE or PROTECTED.',
    hint: 'Classification determines the handling controls IS18 expects, so it needs to be settled early.',
    examples: [
      'Information asset register with classifications.',
      'Classification procedure based on the QGISCF.',
      'Owners assigned to key information assets.'
    ]
  },
  {
    id: 'class-label',
    group: 'class',
    label: 'Documents and emails are labelled with their classification, and staff know how to apply labels.',
    hint: 'Labels make classification visible and enforceable, for example through Microsoft Purview sensitivity labels.',
    examples: [
      'Sensitivity labels published to staff.',
      'Guidance or training on choosing a label.',
      'Reports showing labels in use.'
    ]
  },
  {
    id: 'class-handle',
    group: 'class',
    label: 'Handling rules are enforced for SENSITIVE and PROTECTED information, including sharing, storage and transfer controls.',
    hint: 'Handling controls such as data loss prevention and external sharing limits are what stop classified information leaking.',
    examples: [
      'External sharing restrictions for labelled content.',
      'Data loss prevention policies.',
      'Encryption for information that must not leave agency control.'
    ]
  },
  {
    id: 'inc-plan',
    group: 'inc',
    label: 'An incident response plan defines roles, escalation and when to report to the Queensland Government Cyber Security Unit.',
    hint: 'IS18 requires significant incidents to be reported. The plan must say who reports, when and how.',
    examples: [
      'Incident response plan with reporting triggers.',
      'Contact details for the Cyber Security Unit and affected agencies.',
      'Incident register with recent entries.'
    ]
  },
  {
    id: 'inc-breach',
    group: 'inc',
    label: 'Data breaches involving personal information are assessed and notified in line with the Information Privacy Act 2009 (Qld) mandatory notification requirements.',
    hint: 'Queensland\'s mandatory data breach notification scheme sets assessment and notification obligations.',
    examples: [
      'Breach assessment procedure.',
      'Notification templates for individuals and the regulator.',
      'Record of past breach assessments.'
    ]
  },
  {
    id: 'inc-test',
    group: 'inc',
    label: 'The incident response plan has been tested in the last 12 months, for example with a tabletop exercise.',
    hint: 'An untested plan is a common gap in IS18 and ISO 27001 assessments.',
    examples: [
      'Exercise scenario and attendance record.',
      'Lessons learned report.',
      'Actions from the exercise tracked to closure.'
    ]
  },
  {
    id: 'ret-officer',
    group: 'ret',
    label: 'An accountable officer is identified for information security and receives regular reporting on our posture.',
    hint: 'IS18 makes a named accountable officer responsible for the annual attestation.',
    examples: [
      'Named accountable officer.',
      'Regular security reporting to that officer or the executive.',
      'Record of decisions taken on security risks.'
    ]
  },
  {
    id: 'ret-return',
    group: 'ret',
    label: 'We could produce our annual information security return, or an IS18 compliance statement for an agency, within two weeks, with evidence for each claim.',
    hint: 'Agencies submit an annual return by 30 September. Suppliers are increasingly asked for a compliance statement with evidence.',
    examples: [
      'Draft or previous annual return or compliance statement.',
      'Evidence index supporting each statement.',
      'Process and owner for preparing it each year.'
    ]
  },
  {
    id: 'ret-evidence',
    group: 'ret',
    label: 'Evidence for our controls is kept in one place and kept current, not gathered at the last minute.',
    hint: 'Continuous evidence is what turns an annual scramble into a routine report.',
    examples: [
      'Central evidence library or register.',
      'Evidence dated within the last 12 months.',
      'Owners responsible for keeping evidence current.'
    ]
  },
  {
    id: 'sup-contracts',
    group: 'sup',
    label: 'We know which of our contracts, panels or deeds pass IS18 obligations to us, or which suppliers we pass them to.',
    hint: 'IS18 reaches suppliers through contract schedules and panel arrangements.',
    examples: [
      'List of contracts with IS18 or security schedules.',
      'Summary of obligations in each.',
      'Owner responsible for meeting them.'
    ]
  },
  {
    id: 'sup-assess',
    group: 'sup',
    label: 'Suppliers and cloud services that handle Queensland Government information are assessed for security before use and reviewed regularly.',
    hint: 'Supplier assessment is one of the most common gaps in IS18 assessments.',
    examples: [
      'Supplier register with criticality ratings.',
      'Security questionnaires or certifications on file.',
      'Review dates for critical suppliers.'
    ]
  },
  {
    id: 'sup-location',
    group: 'sup',
    label: 'We know where Queensland Government information is stored and processed, including offshore locations and sub-processors.',
    hint: 'Agencies will ask where their information lives, especially for SENSITIVE and PROTECTED information.',
    examples: [
      'Data location register.',
      'Sub-processor list.',
      'Approvals for any offshore storage or access.'
    ]
  },
];

const GROUPS = [
  { key: 'isms', title: 'ISMS aligned to ISO 27001',        icon: 'clipboard',  blurb: 'Scope, policies, risk, Statement of Applicability and review.' },
  { key: 'e8',   title: 'Essential Eight maturity',         icon: 'lock',       blurb: 'Maturity assessment, target, MFA, patching, admin and backups.' },
  { key: 'class',title: 'QGISCF classification & handling', icon: 'search',     blurb: 'Classification, labelling and handling rules.' },
  { key: 'inc',  title: 'Incidents & data breaches',        icon: 'government', blurb: 'Cyber Security Unit reporting, breach notification and testing.' },
  { key: 'ret',  title: 'Accountability & annual return',   icon: 'people',     blurb: 'Accountable officer, the return or compliance statement, and evidence.' },
  { key: 'sup',  title: 'Suppliers & contracts',            icon: 'factory',    blurb: 'Contract obligations, supplier assessment and data location.' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="Free IS18 Readiness Check for Queensland Government | Compliance365"
  description="Free IS18 readiness check for Queensland Government agencies and their ICT suppliers. Score your ISMS, Essential Eight, classification and incident controls and get a prioritised gap report."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'IS18 Readiness Check', url: 'https://www.compliance365.com.au/checklist/is18/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Free Readiness Assessment</p>
      <h1>IS18 Readiness Check</h1>
      <p class="section-lead" style="max-width:760px;">
        For Queensland Government agencies and the ICT suppliers that work with them. Answer 22 questions across the IS18 obligations: the ISMS, Essential Eight, QGISCF classification, incidents, the annual return and suppliers. Get an instant score and a PDF report of your priority gaps.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#BE4A1E;color:var(--on-accent);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill band-light" data-stage="2" style="flex:1;min-width:140px;background:#DDD8CF;color:var(--text-subtle);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill band-light" data-stage="3" style="flex:1;min-width:140px;background:#DDD8CF;color:var(--text-subtle);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#FAF7F1;padding:2rem 0;border-top:1px solid #DDD8CF;border-bottom:1px solid #DDD8CF;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--accent-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-clock"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">About 10 minutes</strong><p class="muted small" style="margin:2px 0 0;">22 questions across the six areas an agency or assessor will ask about.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--ok-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-check-seal"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Built around IS18</strong><p class="muted small" style="margin:2px 0 0;">Each question names the evidence an agency, panel or assessor will ask to see.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--accent-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-note"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">PDF report</strong><p class="muted small" style="margin:2px 0 0;">Your score for each area and your priority gaps, ready for your accountable officer or contract team.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;">DISP / ISM / IRAP</a>
        <a href={`${base}checklist/is18/`} style="padding:5px 12px;border-radius:6px;background:#BE4A1E;color:var(--on-accent);font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">IS18</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- STAGE 1 -->
      <div id="stage-1" class="stage">
        <div class="card spot" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your IS18 report. Required fields are marked <span style="color:var(--danger-ink);">*</span>.</p>
          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0B0B0C;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:var(--danger-ink);">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>
          <label for="followup-ok" style="display:flex;gap:10px;align-items:flex-start;margin-top:1.25rem;font-size:0.9rem;cursor:pointer;">
            <input type="checkbox" id="followup-ok" name="followup-ok" style="margin-top:3px;width:16px;height:16px;flex:none;accent-color:#BE4A1E;" />
            <span>Email me a short follow-up on my results: what my top gaps mean and how other organisations closed them. Three emails at most, and you can unsubscribe at any time.</span>
          </label>
          <div id="env-error" style="display:none;background:#F9E9EA;border:1px solid #fecaca;color:var(--danger-ink);padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #DDD8CF;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- STAGE 2 -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;">
          <div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #DDD8CF;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#F5F0E8;color:var(--text-subtle);font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #DDD8CF;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="width:1.75rem;height:1.75rem;display:inline-flex;align-items:center;justify-content:center;color:var(--accent-ink);flex-shrink:0;"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><use href={`#ic-${grp.icon}`}/></svg></span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0B0B0C;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:var(--accent-ink);">0/{grpQs.length}</div>
                    </div>
                  </div>
                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #F5F0E8;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:rgba(190, 74, 30,0.06);color:var(--accent-ink);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0B0B0C;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:var(--accent-ink);font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid rgba(190, 74, 30,0.2);background:rgba(190, 74, 30,0.06);color:var(--accent-ink);border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:var(--danger-ink);border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card spot" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #F5F0E8;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:var(--accent-ink);line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:var(--text-muted);margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:var(--text-subtle);font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#C8C3B8;"> - </span>
                    </div>
                    <div style="background:#F5F0E8;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#C8C3B8;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #F5F0E8;">
                <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#F5F0E8;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#BE4A1E;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid rgba(190, 74, 30,0.2);background:rgba(190, 74, 30,0.06);color:var(--accent-ink);border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- STAGE 3 -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card spot" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  </main>

  <Footer />

  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>
  <script is:inline src={`${base}assets/checklist-report.js`} defer></script>
  <script type="application/json" id="cl-guidance" set:html={JSON.stringify(Object.fromEntries(QUESTIONS.map((q) => [q.id, { hint: q.hint || "", examples: q.examples || [] }])))} />

  <script is:inline>
    (() => {
      'use strict';
      const STANDARD = 'IS18 (Queensland Government Information and Cyber Security Policy)';
      const API_URL  = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';

      const GROUPS = [
        { key:'isms', title:'ISMS aligned to ISO 27001' },
        { key:'e8', title:'Essential Eight maturity' },
        { key:'class', title:'QGISCF classification & handling' },
        { key:'inc', title:'Incidents & data breaches' },
        { key:'ret', title:'Accountability & annual return' },
        { key:'sup', title:'Suppliers & contracts' },
      ];

      const QUESTIONS = [
        { id:'isms-scope', group:'isms', label:'The scope of our information security management system (ISMS) is defined and documented, covering the systems and services that hold Queensland Government information.' },
        { id:'isms-policy', group:'isms', label:'An information security policy and supporting policies are approved by senior management, communicated to staff and reviewed at least annually.' },
        { id:'isms-risk', group:'isms', label:'We use a documented information security risk assessment method and keep a current risk register with owners and treatments.' },
        { id:'isms-soa', group:'isms', label:'A Statement of Applicability records which controls apply, why, and how each is implemented.' },
        { id:'isms-review', group:'isms', label:'Management reviews the ISMS at least once a year, and an internal audit has been carried out in the last 12 months.' },
        { id:'e8-assessed', group:'e8', label:'We have assessed all eight Essential Eight strategies against the maturity model, and know our current maturity level for each.' },
        { id:'e8-target', group:'e8', label:'We have an agreed target maturity level and a roadmap, with owners and dates, to close the gap.' },
        { id:'e8-mfa', group:'e8', label:'Multi-factor authentication is enforced for all users, and phishing-resistant methods are used for privileged and remote access.' },
        { id:'e8-patch', group:'e8', label:'Applications and operating systems are patched within the Essential Eight timeframes, and unsupported software is removed.' },
        { id:'e8-admin', group:'e8', label:'Administrative privileges are restricted and reviewed, and backups are taken, tested and protected from change.' },
        { id:'class-scheme', group:'class', label:'We have adopted the Queensland Government Information Security Classification Framework (QGISCF), and know which information we hold at OFFICIAL, SENSITIVE or PROTECTED.' },
        { id:'class-label', group:'class', label:'Documents and emails are labelled with their classification, and staff know how to apply labels.' },
        { id:'class-handle', group:'class', label:'Handling rules are enforced for SENSITIVE and PROTECTED information, including sharing, storage and transfer controls.' },
        { id:'inc-plan', group:'inc', label:'An incident response plan defines roles, escalation and when to report to the Queensland Government Cyber Security Unit.' },
        { id:'inc-breach', group:'inc', label:'Data breaches involving personal information are assessed and notified in line with the Information Privacy Act 2009 (Qld) mandatory notification requirements.' },
        { id:'inc-test', group:'inc', label:'The incident response plan has been tested in the last 12 months, for example with a tabletop exercise.' },
        { id:'ret-officer', group:'ret', label:'An accountable officer is identified for information security and receives regular reporting on our posture.' },
        { id:'ret-return', group:'ret', label:'We could produce our annual information security return, or an IS18 compliance statement for an agency, within two weeks, with evidence for each claim.' },
        { id:'ret-evidence', group:'ret', label:'Evidence for our controls is kept in one place and kept current, not gathered at the last minute.' },
        { id:'sup-contracts', group:'sup', label:'We know which of our contracts, panels or deeds pass IS18 obligations to us, or which suppliers we pass them to.' },
        { id:'sup-assess', group:'sup', label:'Suppliers and cloud services that handle Queensland Government information are assessed for security before use and reviewed regularly.' },
        { id:'sup-location', group:'sup', label:'We know where Queensland Government information is stored and processed, including offshore locations and sub-processors.' },
      ];

      const TOTAL_Q = QUESTIONS.length;
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#BE4A1E' : (s < n ? '#046A4E' : '#DDD8CF');
            p.style.color = (s === n) ? 'var(--on-accent)' : (s < n ? 'var(--on-status)' : 'var(--text-subtle)');
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('to-stage-2').addEventListener('click', function() {
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger','classification','timeline','heard-about'];
          var reqIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];
          allIds.forEach(function(id) { var el = document.getElementById(id); if (el) env[id] = el.value ? el.value.trim() : ''; });
          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) { valid = false; el.style.borderColor = '#9B1C2E'; el.style.background = '#F9E9EA'; }
            else { el.style.borderColor = '#C8C3B8'; el.style.background = 'white'; }
          });
          var errEl = document.getElementById('env-error');
          if (!valid) { errEl.style.display = 'block'; errEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
          errEl.style.display = 'none';
          // Stop disposable, mistyped and non-existent email addresses before the lead is sent
          var goStage2 = function() { errEl.style.display = 'none'; setStage(2); if (typeof window.c365Track === 'function') window.c365Track('checklist_started', { framework: 'IS18' }); };
          if (window.c365EmailGate) { window.c365EmailGate(document.getElementById('contact-email'), goStage2); } else { goStage2(); }
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white'; o.style.color = '#0B0B0C'; o.style.borderColor = '#C8C3B8';
            });
            btn.classList.add('active');
            if (val === 2) { btn.style.background = '#046A4E'; btn.style.color = 'var(--on-status)'; btn.style.borderColor = '#046A4E'; }
            else if (val === 1) { btn.style.background = '#A63A12'; btn.style.color = 'var(--on-status)'; btn.style.borderColor = '#A63A12'; }
            else { btn.style.background = '#9B1C2E'; btn.style.color = 'white'; btn.style.borderColor = '#9B1C2E'; }
            update();
          });
        });

        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the IS18 readiness check for Queensland Government. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') window.c365OpenChat(msg);
          });
        });

        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white'; o.style.color = '#0B0B0C'; o.style.borderColor = '#C8C3B8';
          });
          update();
        });

        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true; btn.textContent = 'Generating...';
          try { generatePDF(); await submitToApi(); setStage(3); if (typeof window.c365Track === 'function') window.c365Track('checklist_completed', { framework: 'IS18' }); }
          catch (err) { console.error(err); alert('Something went wrong — your PDF should still have downloaded.'); }
          finally { btn.disabled = false; btn.textContent = 'Generate PDF report'; }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => { if (state[id] !== null) { answered++; sum += state[id]; } });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { label: 'Not started', desc: 'Answer questions to score', color: '#6B6860' };
        if (score >= 86) return { label: 'Ready', desc: 'Strong position: keep evidence current and prepare the return or compliance statement', color: '#046A4E' };
        if (score >= 61) return { label: 'Nearly Ready', desc: 'Close remaining gaps and complete evidence packaging', color: '#BE4A1E' };
        if (score >= 31) return { label: 'Partially Ready', desc: 'Many controls in place — structured remediation needed', color: '#A63A12' };
        return { label: 'High Risk', desc: 'Significant gaps: a structured programme is needed before you can attest to IS18', color: '#9B1C2E' };
      }

      function barColor(pct) {
        if (pct === null) return '#C8C3B8';
        if (pct >= 75) return '#046A4E';
        if (pct >= 50) return '#A63A12';
        return '#9B1C2E';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the IS18 readiness check on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('Highest classification handled: ' + (env['classification'] || 'Not specified'));
        lines.push('Target timeline: ' + (env['timeline'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Domain scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) { lines.push('  [' + (state[q.id] === 1 ? 'PARTIAL' : 'NO') + '] ' + q.label); });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest IS18 gaps, what to prioritise, and what a realistic path to an evidence-backed annual return or compliance statement looks like for my organisation?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);
        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#EAF4EF' : '#F5F0E8';
            el.style.color = a === total ? '#166534' : '#3A3632';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) { bar.style.width = '0%'; bar.style.background = '#C8C3B8'; pctEl.textContent = ' - '; pctEl.style.color = '#C8C3B8'; }
            else { bar.style.width = pct + '%'; bar.style.background = barColor(pct); pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct); }
          }
        });

        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone; btn.style.cursor = allDone ? 'pointer' : 'not-allowed'; btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone ? 'Click to generate and email your report' : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) { aiBtn.disabled = !allDone; aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed'; aiBtn.style.opacity = allDone ? '1' : '0.5'; }
      }

      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const lines = [];
        lines.push('=== IS18 READINESS CHECK SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Classification: ${env['classification'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        GROUPS.forEach(g => { const s = computeSection(g.key); lines.push(`  ${g.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`); });
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          lines.push(`[${v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED'}] ${q.label}`);
        });
        if (typeof window.c365SendLead === 'function') window.c365SendLead({ email: env['contact-email'], name: env['contact-name'], company: env['org-name'], heard: env['heard-about'] || '', score: score, followup: !!(document.getElementById('followup-ok') || {}).checked, form: 'IS18 readiness check', subject: `IS18 readiness check: ${score}%`, message: `Readiness score ${score}% (${answered}/${TOTAL_Q} answered).` });
        try {
          await fetch(API_URL, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: env['contact-name'] || env['org-name'] || 'Anonymous',
              email: env['contact-email'] || 'noreply@compliance365.com.au',
              subject: `IS18 Readiness Check - ${env['org-name'] || 'Anonymous'} - ${score}%`,
              message: lines.join('\n') + (env['heard-about'] ? '\n\nHow they heard about us: ' + env['heard-about'] : '') + (typeof window.c365LeadSource === 'function' ? window.c365LeadSource() : ''),
            }),
          });
        } catch (err) { console.warn('API submission failed:', err); }
      }

      function generatePDF() {
        /* The report itself is drawn by /assets/checklist-report.js, shared by every checklist. */
        if (typeof window.c365ChecklistReport !== 'function') { alert('The report is still loading. Please try again in a moment.'); return; }
        var comp = compute();
        return window.c365ChecklistReport({
          title: "IS18 readiness report", framework: "IS18", fileStem: "is18_readiness_",
          org: env['org-name'], contact: env['contact-name'],
          details: [["Relationship to IS18", env["org-sector"]], ["Size", env["org-size"]], ["Driver", env["trigger"]], ["Highest classification", env["classification"]]],
          score: comp.score, answered: comp.answered, total: QUESTIONS.length, band: getBand(comp.score, comp.answered),
          groups: GROUPS.map(function (g) { return { key: g.key, title: g.title, pct: computeSection(g.key).pct }; }),
          questions: QUESTIONS.map(function (q) { return { id: q.id, group: q.group, label: q.label, value: state[q.id] }; })
        });
      }
    })();
  </script>
</Base>
