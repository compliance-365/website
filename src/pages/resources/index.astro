<style>
  .rf-bar {
    border: 1px solid #DDD8CF;
    border-radius: 10px;
    background: #FFFFFF;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .rf-row { display: flex; gap: .85rem; align-items: baseline; flex-wrap: wrap; }
  .rf-legend {
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #6B6860;          /* 5.20:1 on white */
    min-width: 74px;
    flex-shrink: 0;
    padding-top: .3rem;
  }
  .rf-pills { display: flex; gap: .4rem; flex-wrap: wrap; flex: 1; }
  .rf-pill {
    font: 600 .8rem/1 Manrope, system-ui, sans-serif;
    color: #3A3632;          /* 11.2:1 on white */
    background: #FAF7F1;
    border: 1px solid #DDD8CF;
    border-radius: 999px;
    padding: 0 .75rem;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
  }
  .rf-pill:hover { border-color: #A9812E; background: #FFFFFF; }
  .rf-pill:focus-visible { outline: 2px solid #A9812E; outline-offset: 2px; }
  .rf-pill.is-on {
    background: #0B0B0C;
    border-color: #0B0B0C;
    color: #FAF7F1;          /* 18.4:1 */
  }
  .rf-n {
    font-size: .7rem;
    font-variant-numeric: tabular-nums;
    color: #6B6860;
  }
  .rf-pill.is-on .rf-n { color: rgba(250,247,241,.75); }
  .rf-status {
    margin: 0;
    font-size: .8rem;
    color: #57534B;          /* 7.16:1 on white */
    min-height: 1.2em;
  }
  .rf-empty {
    border: 1px dashed #C8C3B8;
    border-radius: 10px;
    padding: 2rem 1.5rem;
    text-align: center;
    color: #57534B;
    font-size: .9rem;
  }
  .rf-empty button {
    font: 600 .85rem/1 Manrope, system-ui, sans-serif;
    color: #8B6820;          /* 4.79:1 on cream */
    background: none;
    border: none;
    border-bottom: 1px solid currentColor;
    padding: 0 0 2px;
    cursor: pointer;
  }
  [data-rf-item][hidden] { display: none !important; }

  /* Touch targets get the full 44px; desktop keeps the tighter bar. */
  @media (max-width: 640px) {
    .rf-pill { min-height: 44px; }
    .rf-legend { min-width: 100%; padding-top: 0; }
  }
</style>

<script is:inline>
  /* Filters all three resource sections at once. Cards carry their own
     type and framework tags (derived at build time from the badge already
     printed on the card), so this reads the DOM rather than keeping a
     second copy of the library in JS that could drift out of sync.

     State lives in the URL hash so a filtered view is shareable and
     survives a back-navigation — "which ISO 42001 resources do you have"
     becomes a link you can send. */
  (function () {
    var bar = document.querySelector('.rf-bar');
    if (!bar) return;

    var items = Array.prototype.slice.call(document.querySelectorAll('[data-rf-item]'));
    var sections = Array.prototype.slice.call(document.querySelectorAll('[data-rf-section]'));
    var statusEl = document.getElementById('rf-status');
    var state = { type: 'all', fw: 'all' };

    function pillsFor(kind) {
      return Array.prototype.slice.call(bar.querySelectorAll('[data-filter="' + kind + '"]'));
    }

    function matches(el) {
      if (state.type !== 'all' && el.getAttribute('data-rf-type') !== state.type) return false;
      if (state.fw !== 'all') {
        var tags = (el.getAttribute('data-rf-tags') || '').split('|');
        if (tags.indexOf(state.fw) === -1) return false;
      }
      return true;
    }

    function apply(push) {
      var shown = 0;
      items.forEach(function (el) {
        var ok = matches(el);
        el.hidden = !ok;
        if (ok) shown++;
      });

      /* A section whose every card is filtered out hides its heading and
         blurb too — otherwise the page reads as a run of empty headings. */
      sections.forEach(function (sec) {
        var any = sec.querySelector('[data-rf-item]:not([hidden])');
        sec.hidden = !any;
      });

      ['type', 'fw'].forEach(function (kind) {
        pillsFor(kind).forEach(function (p) {
          var on = p.getAttribute('data-value') === state[kind];
          p.classList.toggle('is-on', on);
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      });

      var filtered = state.type !== 'all' || state.fw !== 'all';
      if (statusEl) {
        statusEl.textContent = !filtered
          ? ''
          : shown === 0
            ? 'Nothing matches that combination.'
            : 'Showing ' + shown + ' of ' + items.length + ' resources.';
      }

      var empty = document.getElementById('rf-empty');
      if (shown === 0 && !empty) {
        empty = document.createElement('div');
        empty.id = 'rf-empty';
        empty.className = 'rf-empty container';
        empty.innerHTML = 'No resources match that combination yet. <button type="button" id="rf-reset">Clear the filters</button>';
        bar.parentNode.appendChild(empty);
        document.getElementById('rf-reset').addEventListener('click', function () {
          state = { type: 'all', fw: 'all' };
          apply(true);
        });
      } else if (shown > 0 && empty) {
        empty.parentNode.removeChild(empty);
      }

      if (push) {
        var parts = [];
        if (state.type !== 'all') parts.push('type=' + encodeURIComponent(state.type));
        if (state.fw !== 'all') parts.push('fw=' + encodeURIComponent(state.fw));
        var hash = parts.length ? '#' + parts.join('&') : ' ';
        history.replaceState(null, '', hash === ' ' ? location.pathname + location.search : hash);
      }
    }

    bar.addEventListener('click', function (e) {
      var pill = e.target.closest('[data-filter]');
      if (!pill) return;
      state[pill.getAttribute('data-filter')] = pill.getAttribute('data-value');
      apply(true);
    });

    /* Restore from the hash on load, ignoring anything that isn't a real
       filter value so a stale or hand-edited link can't blank the page. */
    var h = (location.hash || '').replace(/^#/, '');
    if (h) {
      h.split('&').forEach(function (kv) {
        var bits = kv.split('=');
        var k = bits[0], v = decodeURIComponent(bits[1] || '');
        if (k !== 'type' && k !== 'fw') return;
        var known = pillsFor(k).some(function (p) { return p.getAttribute('data-value') === v; });
        if (known) state[k] = v;
      });
    }
    apply(false);
  })();
</script>
