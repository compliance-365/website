---
import Base from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

// ✅ define base here, like in your other pages
const base = import.meta.env.BASE_URL || '/';
const FORMSPREE = 'https://formspree.io/f/mnngvoqe';
---

<Base title="Contact — Compliance365">
  <Section title="Book a 20-minute roadmap call">
    <div class="card">
      <p>
        Email us at <a href="mailto:info@compliance365.com.au">info@compliance365.com.au</a>
        or complete the form below.
      </p>

      <form id="contactForm" novalidate>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
    <input id="name" name="name" placeholder="Your name" required
           style="padding:10px;border-radius:8px;border:1px solid #ccc">
    <input id="email" name="email" type="email" placeholder="Email" required
           style="padding:10px;border-radius:8px;border:1px solid #ccc">
  </div>

  <input id="subject" name="subject" placeholder="Subject"
         style="margin-top:12px;padding:10px;border-radius:8px;border:1px solid #ccc;width:100%">
  <textarea id="message" name="message" placeholder="Your message..." rows="6"
            style="margin-top:12px;padding:10px;border-radius:8px;border:1px solid #ccc;width:100%"></textarea>

  <button class="btn-primary" id="sendBtn" style="margin-top:12px">Send</button>
  <p id="formMsg" class="small muted" style="margin:.5rem 0 0"></p>
</form>

<script is:inline>
  const API_URL = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  const form = document.getElementById('contactForm');
  const msg = document.getElementById('formMsg');
  const btn = document.getElementById('sendBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = {
      name: form.name.value.trim(),
      email: form.email.value.trim(),
      subject: form.subject.value.trim(),
      message: form.message.value.trim(),
    };

    // simple email validation
    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.email)) {
      msg.textContent = "Please enter a valid email.";
      msg.style.color = "#b91c1c";
      return;
    }

    btn.disabled = true;
    msg.textContent = "Sending...";
    msg.style.color = "#6b7280";

    try {
      const res = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        msg.textContent = "✅ Message sent successfully!";
        msg.style.color = "#047857";
        form.reset();
      } else {
        msg.textContent = "⚠️ Error submitting form.";
        msg.style.color = "#b91c1c";
      }
    } catch (err) {
      msg.textContent = "⚠️ Could not connect to server.";
      msg.style.color = "#b91c1c";
    } finally {
      btn.disabled = false;
    }
  });
</script>

      <p class="muted" style="font-size:.9rem;margin-top:8px">
        We’ll respond within 1 business day. By submitting, you agree to our
        <a href={base + 'privacy'}>Privacy Policy</a>.
      </p>
    </div>
  </Section>
</Base>
