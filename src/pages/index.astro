      var ARC = Math.PI*1.72;
      var ringMat = new THREE.MeshStandardMaterial({color:0xFAF7F1,metalness:.55,roughness:.35});
      var ring = new THREE.Mesh(new THREE.TorusGeometry(1.9,.13,32,200,ARC),ringMat);
      ring.rotation.z=(Math.PI*2-ARC)/2; group.add(ring);
      [(Math.PI*2-ARC)/2,(Math.PI*2-ARC)/2+ARC].forEach(function(a){
        var cap=new THREE.Mesh(new THREE.SphereGeometry(.13,24,24),ringMat);
        cap.position.set(Math.cos(a)*1.9,Math.sin(a)*1.9,0); group.add(cap);
      });

      var checkpoint=new THREE.Mesh(new THREE.SphereGeometry(.17,32,32),
        new THREE.MeshStandardMaterial({color:0xA9812E,emissive:0xA9812E,emissiveIntensity:.55,metalness:.4,roughness:.3}));
      checkpoint.position.set(1.9,0,0); group.add(checkpoint);
      var goldLight=new THREE.PointLight(0xD8BA78,1.2,4);
      goldLight.position.set(1.9,0,.4); group.add(goldLight);

      var core=new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.IcosahedronGeometry(.55,1)),
        new THREE.LineBasicMaterial({color:0xA9812E,transparent:true,opacity:.28}));
      group.add(core);
      /* a second, smaller wireframe counter-spinning inside the first — a subtle gyroscope layer */
      var core2=new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.OctahedronGeometry(.32,0)),
        new THREE.LineBasicMaterial({color:0xFAF7F1,transparent:true,opacity:.22}));
      group.add(core2);

      function badgeSprite(txt,sub){
        /* ISO badges get a second, smaller gold line naming the discipline — Security / AI / Privacy —
           so the framework number isn't the only clue to what it covers */
        var H=sub?104:80;
        var c=document.createElement('canvas'); c.width=256; c.height=H;
        var g=c.getContext('2d');
        var grad=g.createLinearGradient(0,10,0,H-10);
        grad.addColorStop(0,'rgba(26,24,20,.95)'); grad.addColorStop(1,'rgba(12,11,10,.95)');
        g.fillStyle=grad;
        g.shadowColor='rgba(216,186,120,.65)'; g.shadowBlur=14;
        g.strokeStyle='rgba(216,186,120,.7)'; g.lineWidth=2;
        if(g.roundRect){g.beginPath();g.roundRect(4,10,248,H-20,10);g.fill();g.stroke();}
        else{g.fillRect(4,10,248,H-20);g.strokeRect(4,10,248,H-20);}
        g.shadowBlur=0;
        g.fillStyle='#FAF7F1'; g.font='700 23px Manrope,sans-serif';
        g.textAlign='center'; g.textBaseline='middle';
        if(sub){
          g.fillText(txt.toUpperCase(),128,H*0.4);
          g.fillStyle='#D8BA78'; g.font='700 15px Manrope,sans-serif';
          g.fillText(sub.toUpperCase(),128,H*0.4+26);
        } else {
          g.fillText(txt.toUpperCase(),128,H/2+1);
        }
        var sp=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true}));
        /* sized to sit inside the ring's interior, clear of both the ring stroke and the core */
        var w=.78, h=w*(H/256);
        sp.scale.set(w,h,1); sp.userData.base=w; sp.userData.baseH=h;
        return sp;
      }
      /* framework badges sit on a slow-turning dial pinned inside the ring — part of the
         logo's own rigid body, not a separate tilted shell orbiting outside it. They keep
         a fixed order and spacing (never drift independently), auto-rotate gently when idle,
         and freeze instantly on hover so the badge under your cursor never moves mid-click. */
      var dial=new THREE.Group(); group.add(dial);
      var DIAL_R=1.25, keys=Object.keys(FW);
      group.add(new THREE.Mesh(new THREE.TorusGeometry(DIAL_R,.006,8,128),
        new THREE.MeshBasicMaterial({color:0xD8BA78,transparent:true,opacity:.16})));
      var sprites=[];
      keys.forEach(function(k,i){
        var sp=badgeSprite(FW[k].badge,FW[k].sub), a=-Math.PI/2+i*(Math.PI*2/keys.length);
        sp.userData.fw=k;
        sp.position.set(DIAL_R*Math.cos(a),DIAL_R*Math.sin(a),.08);
        dial.add(sp); sprites.push(sp);
      });

      var N=400,pos=new Float32Array(N*3);
      for(var i=0;i<N*3;i++) pos[i]=(Math.random()-.5)*13;
      var pGeo=new THREE.BufferGeometry();
      pGeo.setAttribute('position',new THREE.BufferAttribute(pos,3));
      var dust=new THREE.Points(pGeo,new THREE.PointsMaterial({color:0xD8BA78,size:.015,transparent:true,opacity:.35,blending:THREE.AdditiveBlending,depthWrite:false}));
      scene.add(dust);

      var key=new THREE.DirectionalLight(0xFFF4E0,1.6); key.position.set(-3,4,5); scene.add(key);
      scene.add(new THREE.AmbientLight(0x404040,1.1));

      window.addEventListener('resize',function(){
        var w=stage.clientWidth,h=stage.clientHeight;
        camera.aspect=w/h; camera.updateProjectionMatrix(); renderer.setSize(w,h);
      });

      /* ── interaction: drag + inertia + chip card ── */
      var tx=0,ty=0,userY=0,userX=0,velY=0,velX=0;
      var dragging=false,moved=0,px=0,py=0;
      var raycaster=new THREE.Raycaster(),mouse=new THREE.Vector2(),hovered=null;

      window.addEventListener('mousemove',function(e){
        tx=(e.clientX/window.innerWidth-.5)*.5;
        ty=(e.clientY/window.innerHeight-.5)*.35;
      });

      function pointerXY(e){ return e.touches?{x:e.touches[0].clientX,y:e.touches[0].clientY}:{x:e.clientX,y:e.clientY}; }

      /* raycast at a screen point — shared by hover (mouse) and tap-detection (touch) */
      function updateHover(x,y){
        var r=renderer.domElement.getBoundingClientRect();
        mouse.x=((x-r.left)/r.width)*2-1;
        mouse.y=-((y-r.top)/r.height)*2+1;
        raycaster.setFromCamera(mouse,camera);
        var hits=raycaster.intersectObjects(sprites);
        var h=hits.length?hits[0].object:null;
        if(h!==hovered){
          hovered=h;
          renderer.domElement.style.cursor=h?'pointer':(dragging?'grabbing':'grab');
          window.dispatchEvent(new CustomEvent('cinebg:pulse',{detail:{active:!!h}}));
        }
      }

      function down(e){
        var p=pointerXY(e); dragging=true; moved=0; px=p.x; py=p.y;
        stage.classList.add('grabbing','touched');
        updateHover(p.x,p.y); /* a tap with no drag still needs a hit-test before touchend fires */
      }
      function move(e){
        var p=pointerXY(e);
        updateHover(p.x,p.y);
        if(!dragging) return;
        var dx=p.x-px,dy=p.y-py;
        moved+=Math.abs(dx)+Math.abs(dy);
        velY=dx*.006; velX=dy*.004;
        userY+=velY; userX=Math.max(-.5,Math.min(.5,userX+velX));
        px=p.x; py=p.y;
      }
      function up(){
        dragging=false; stage.classList.remove('grabbing');
        if(moved<6&&hovered&&hovered.userData.fw) selectFW(hovered.userData.fw);
      }
      renderer.domElement.addEventListener('mousedown',down);
      renderer.domElement.addEventListener('touchstart',down,{passive:true});
      window.addEventListener('mousemove',move);
      renderer.domElement.addEventListener('touchmove',move,{passive:true});
      window.addEventListener('mouseup',up);
      window.addEventListener('touchend',up);

      var chip=document.getElementById('fwChip'),chipTimer=null;
      function selectFW(k){
        document.getElementById('fwName').textContent=FW[k].sub?k+' — '+FW[k].sub:k;
        document.getElementById('fwDesc').textContent=FW[k].d;
        document.getElementById('fwLink').href=FW[k].u;
        chip.classList.add('show');
        pulseT=0;
        clearTimeout(chipTimer);
        chipTimer=setTimeout(function(){ chip.classList.remove('show'); },9000);
      }

      var visible=true;
      if('IntersectionObserver' in window)
        new IntersectionObserver(function(en){visible=en[0].isIntersecting;}).observe(stage);

      var clock=new THREE.Clock(),pulseT=10,dialSpin=0;
      function tick(){
        requestAnimationFrame(tick);
        if(!visible) return;
        var t=clock.getElapsedTime(),dt=clock.getDelta()+.016;
        if(!reduced){
          var sc=group.scale.x+(1-group.scale.x)*.06; group.scale.set(sc,sc,sc);
          if(!dragging){velY*=.94;velX*=.9;userY+=velY;userX+=velX;userY*=.985;userX*=.97;}
          /* freeze the ring the instant a badge is hovered — a still target is a clickable target */
          var settle=hovered?0:.06;
          group.rotation.y+=((Math.sin(t*.25)*.28+tx+userY)-group.rotation.y)*settle;
          group.rotation.x+=((Math.sin(t*.18)*.10+ty+userX)-group.rotation.x)*settle;
          core.rotation.y=-t*.25; core.rotation.x=t*.12;
          core2.rotation.y=t*.4; core2.rotation.z=-t*.22;
          /* the dial only turns when idle — hovering or dragging holds every badge dead still */
          if(!hovered&&!dragging) dialSpin+=dt*.045;
          dial.rotation.z=dialSpin;
          sprites.forEach(function(sp){
            var target=sp===hovered?1.18:1;
            var cur=sp.scale.x/sp.userData.base;
            var nx=cur+(target-cur)*.15;
            sp.scale.set(sp.userData.base*nx,sp.userData.baseH*nx,1);
          });
          dust.rotation.y=t*.012;
          pulseT+=dt;
          var pulse=Math.max(0,1-pulseT*1.4);
          checkpoint.material.emissiveIntensity=.45+Math.sin(t*1.6)*.18+pulse*1.2;
          var cs=1+pulse*.6; checkpoint.scale.set(cs,cs,cs);
          goldLight.intensity=1+Math.sin(t*1.6)*.35+pulse*2;
        }
        renderer.render(scene,camera);
      }
      stage.classList.add('ready');
      tick();
    } catch(e){ stage.classList.add('no3d'); }
  }
})();
</script>

</Base>
