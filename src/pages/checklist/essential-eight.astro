---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'Essential Eight (ACSC)';

// Groups (we’ll show bars per strategy)
const GROUPS = [
  { key:'app-ctrl',  title:'1) Application Control',         blurb:'Allow-lists; only approved executables/libraries/scripts run.' },
  { key:'patch-app', title:'2) Patch Applications',          blurb:'Timely patching incl. security-critical apps & browsers.' },
  { key:'macro',     title:'3) Configure Office Macros',     blurb:'Blocked by default; signed; limited to trusted locations.' },
  { key:'hardening', title:'4) User App Hardening',          blurb:'Block risky features (Flash/Java legacy), ad/JS in browsers.' },
  { key:'admin',     title:'5) Restrict Admin Privileges',   blurb:'Least-privilege, just-in-time/just-enough admin, reviews.' },
  { key:'patch-os',  title:'6) Patch Operating Systems',     blurb:'Timely OS patches, supported versions only.' },
  { key:'mfa',       title:'7) Multi-Factor Authentication', blurb:'MFA for remote, privileged and sensitive access.' },
  { key:'backups',   title:'8) Regular Backups',             blurb:'Frequent, offline/immutable, tested restores.' },
];

// Questions (Yes=2, Partial=1, No=0). Keep them crisp & audit-oriented.
const QUESTIONS = [
  // 1 Application Control
  { id:'ac-policy',     label:'Executable/DLL/script allow-listing enforced on servers and workstations?', group:'app-ctrl' },
  { id:'ac-publish',    label:'Change control & publishing process for allow-list updates documented?',    group:'app-ctrl' },

  // 2 Patch Applications
  { id:'pa-sla',        label:'Patch SLAs set (e.g., critical ≤48–72h) with monitoring of overdue items?', group:'patch-app' },
  { id:'pa-browsers',   label:'Browsers/plug-ins auto-update or centrally patched within SLA?',            group:'patch-app' },

  // 3 Office Macros
  { id:'macro-block',   label:'Macros blocked by default from the internet/untrusted sources?',            group:'macro' },
  { id:'macro-signed',  label:'Only signed macros from trusted publishers or locations are allowed?',      group:'macro' },

  // 4 User Application Hardening
  { id:'uh-features',   label:'Legacy/risky app features disabled (e.g., Flash/Java, browser ads/JS where applicable)?', group:'hardening' },
  { id:'uh-downloads',  label:'Downloads/executables restricted; SmartScreen/ATP configured?',                      group:'hardening' },

  // 5 Restrict Admin Privileges
  { id:'ra-jit',        label:'Admin access is JIT/JEA with separate admin accounts and approvals?',       group:'admin' },
  { id:'ra-review',     label:'Privileged access reviewed at least quarterly with removals tracked?',      group:'admin' },

  // 6 Patch Operating Systems
  { id:'pos-support',   label:'Only supported OS versions in use; unsupported versions isolated/retired?', group:'patch-os' },
  { id:'pos-deploy',    label:'Central patch deployment with compliance reporting and reboot cadence?',    group:'patch-os' },

  // 7 MFA
  { id:'mfa-remote',    label:'MFA enforced for VPN/remote, privileged & sensitive app access?',           group:'mfa' },
  { id:'mfa-phish',     label:'Phishing-resistant MFA where feasible (FIDO2/number-matching)?',            group:'mfa' },

  // 8 Backups
  { id:'bu-schedule',   label:'Regular backups incl. critical SaaS; RPO/RTO defined and monitored?',       group:'backups' },
  { id:'bu-immutable',  label:'Backups are offline/immutable; restoration tests performed and logged?',    group:'backups' },
];
---

<Base title="Essential Eight Readiness Checklist" description="Answer quick questions, get an instant score and a downloadable PDF.">
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>Essential Eight Readiness Checklist</h1>
    <p class="muted" style="max-width:800px">
      Quick-scan against the ACSC Essential Eight maturity model. Assess control design/operation and
      generate a branded PDF with a score dial, strategy breakdown, gaps and detailed responses.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">Gauge maturity across the eight mitigation strategies with practical next steps.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small">Choose <strong>Yes / Partial / No</strong>. We total a readiness score and per-strategy coverage.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a clean PDF for internal updates or stakeholder briefings.</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill" aria-current="page">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 8px;">{q.label}</label>
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
  (() => {
    'use strict';

    const STANDARD  = "Essential Eight (ACSC)";
    const GROUPS = [
      { key:'app-ctrl',  title:'Application Control' },
      { key:'patch-app', title:'Patch Applications' },
      { key:'macro',     title:'Configure Office Macros' },
      { key:'hardening', title:'User Application Hardening' },
      { key:'admin',     title:'Restrict Admin Privileges' },
      { key:'patch-os',  title:'Patch Operating Systems' },
      { key:'mfa',       title:'Multi-Factor Authentication' },
      { key:'backups',   title:'Regular Backups' },
    ];
    const QUESTIONS = [
      { id:'ac-policy',   label:'Executable/DLL/script allow-listing enforced on servers and workstations?', group:'app-ctrl' },
      { id:'ac-publish',  label:'Change control & publishing process for allow-list updates documented?',    group:'app-ctrl' },
      { id:'pa-sla',      label:'Patch SLAs set (e.g., critical ≤48–72h) with monitoring of overdue items?', group:'patch-app' },
      { id:'pa-browsers', label:'Browsers/plug-ins auto-update or centrally patched within SLA?',            group:'patch-app' },
      { id:'macro-block', label:'Macros blocked by default from the internet/untrusted sources?',            group:'macro' },
      { id:'macro-signed',label:'Only signed macros from trusted publishers or locations are allowed?',      group:'macro' },
      { id:'uh-features', label:'Legacy/risky features disabled (Flash/Java legacy, browser ad/JS controls)?', group:'hardening' },
      { id:'uh-downloads',label:'Downloads/executables restricted; SmartScreen/ATP configured?',             group:'hardening' },
      { id:'ra-jit',      label:'Admin access JIT/JEA with separate admin accounts and approvals?',          group:'admin' },
      { id:'ra-review',   label:'Privileged access reviewed at least quarterly with removals tracked?',      group:'admin' },
      { id:'pos-support', label:'Only supported OS versions in use; unsupported versions isolated/retired?', group:'patch-os' },
      { id:'pos-deploy',  label:'Central patch deployment with compliance reporting and reboot cadence?',    group:'patch-os' },
      { id:'mfa-remote',  label:'MFA enforced for VPN/remote, privileged & sensitive app access?',           group:'mfa' },
      { id:'mfa-phish',   label:'Phishing-resistant MFA (FIDO2/number-match) where feasible?',               group:'mfa' },
      { id:'bu-schedule', label:'Regular backups incl. critical SaaS; RPO/RTO defined and monitored?',       group:'backups' },
      { id:'bu-immutable',label:'Backups offline/immutable; restoration tests performed and logged?',        group:'backups' },
    ];

    (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

    function setup(){
      const form       = document.getElementById('form');
      const bar        = document.getElementById('bar');
      const scoreNum   = document.getElementById('scoreNum');
      const scoreLabel = document.getElementById('scoreLabel');
      const scoreHint  = document.getElementById('scoreHint');
      const resetBtn   = document.getElementById('resetBtn');
      const pdfBtn     = document.getElementById('pdfBtn');

      const modal      = document.getElementById('leadModal');
      const leadForm   = document.getElementById('leadForm');
      const cancelLead = document.getElementById('cancelLead');
      const nameEl     = document.getElementById('name');
      const emailEl    = document.getElementById('email');

      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

      // Per-group counters
      refreshGroupCounters();
      function refreshGroupCounters(){
        GROUPS.forEach(grp => {
          const total = QUESTIONS.filter(q=>q.group===grp.key).length;
          const ansd  = QUESTIONS.filter(q=>q.group===grp.key).map(q=>state[q.id]).filter(v=>v!==null).length;
          const el = document.getElementById('g-'+grp.key);
          if(el) el.textContent = `${ansd}/${total} answered`;
        });
      }

      form.addEventListener('click', (e)=>{
        const btn = e.target.closest('button.opt'); if(!btn || !form.contains(btn)) return;
        const field = btn.closest('.field'); if(!field) return;
        const id  = field.dataset.id;
        const val = Number(btn.dataset.v);
        state[id] = val;
        field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
        btn.classList.add('active');
        refreshGroupCounters();
        update();
      });

      resetBtn?.addEventListener('click', ()=>{
        Object.keys(state).forEach(k => state[k] = null);
        form.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
        refreshGroupCounters();
        update();
      });

      pdfBtn.addEventListener('click', ()=>{
        const { answered } = compute(state);
        if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
        openModal();
      });

      function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
      function closeModal(){ if(modal){ modal.style.display = 'none'; } }
      cancelLead?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
      document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

      // Lead capture → (optional POST) → PDF
      leadForm?.addEventListener('submit', async (e)=>{
        e.preventDefault();
        const name  = (nameEl?.value || '').trim();
        const email = (emailEl?.value || '').trim();
        if(!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ alert('Please enter your name and a valid email.'); return; }

        // Optional: POST to Lambda/CRM here if you want.

        closeModal();
        generatePDF(state, { name, email });
      });

      // Active chip style
      const s = document.createElement('style');
      s.textContent = `button.opt{cursor:pointer} button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
      document.head.appendChild(s);

      update();

      function update(){
        const { answered, score } = compute(state);
        const pct = Math.round((answered / QUESTIONS.length) * 100);
        bar.style.width = pct + '%';
        scoreNum.textContent = `${score}%`;

        let label='Not started', hint='Answer the questions to see your readiness.';
        if (answered>0 && score<40)      { label='Early stage';  hint='Start with allow-listing and patch SLAs.'; }
        else if (score<70)               { label='In progress';  hint='Harden macros, apps and tighten admin.'; }
        else if (score<90)               { label='Nearly ready'; hint='Push MFA coverage and DR restore tests.'; }
        else                             { label='Strong posture'; hint='Sustain cadence and quarterly reviews.'; }
        scoreLabel.textContent = label;
        scoreHint.textContent  = hint;
      }
    }

    function compute(state){
      const vals = Object.values(state);
      const answered = vals.filter(v => v !== null).length;
      const scoreRaw = vals.reduce((a,v)=> a + (v ?? 0), 0);
      const score    = Math.round((scoreRaw / (vals.length * 2)) * 100);
      return { answered, score: isNaN(score) ? 0 : score };
    }

    // PDF generator (matching your house style)
    function generatePDF(state, lead){
      const { jsPDF } = window.jspdf || {};
      if(!jsPDF){ alert('PDF library not loaded.'); return; }

      const doc = new jsPDF('p','mm','a4');
      const W=210, LM=14, RM=14; let y=16;

      const now = new Date();
      const fmt = (d)=> d.toLocaleDateString(undefined, { year:'numeric', month:'short', day:'numeric' });
      const hr = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

      // Header band
      doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
      doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

      // Logo & title
      try{
        const logoEl = document.getElementById('pdfLogo');
        doc.setTextColor(255,255,255);
        doc.setFont('helvetica','bold'); doc.setFontSize(15);
        if (logoEl && logoEl.complete) {
          const targetW = 18;
          const ratio = (logoEl.naturalHeight||logoEl.height||120) / (logoEl.naturalWidth||logoEl.width||120);
          const targetH = Math.min(18, targetW * ratio);
          doc.addImage(logoEl, 'PNG', LM, 6, targetW, targetH, undefined, 'FAST');
          doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
          doc.setFont('helvetica','normal'); doc.setFontSize(11);
          doc.text(`${STANDARD} quick-scan summary`, LM + targetW + 4, 22);
        } else {
          doc.text('Compliance365 — Readiness Report', LM, 16);
          doc.setFont('helvetica','normal'); doc.setFontSize(11);
          doc.text(`${STANDARD} quick-scan summary`, LM, 22);
        }
      }catch(_){}

      // Meta right
      doc.setFontSize(10);
      doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
      if(lead?.name || lead?.email){
        const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
        doc.text(prepared, W-RM, 22, { align:'right' });
      }

      // Summary & dial
      y = 38;
      doc.setTextColor(0); doc.setFont('helvetica','bold'); doc.setFontSize(13);
      doc.text('Your Readiness at a Glance', LM, y); y += 8;

      const vals = Object.values(state);
      const answered = vals.filter(v => v !== null).length;
      const scoreRaw = vals.reduce((a,v)=> a + (v ?? 0), 0);
      const score    = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
      const STATUS = (answered===0)?'Not started' : (score<40)?'Early stage' : (score<70)?'In progress' : (score<90)?'Nearly ready' : 'Strong posture';

      // dial
      const dialX = LM + 26, dialY = y + 24;
      doc.setDrawColor(230,233,242); doc.setLineWidth(6);
      doc.circle(dialX, dialY, 20, 'S');
      doc.setDrawColor(79,70,229);
      const pct = Math.max(0,Math.min(score,100))/100;
      const segs = Math.max(1, Math.round(60*pct));
      for(let i=0;i<segs;i++){
        const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
        const a2 = a1 + 0.1;
        doc.line(dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
                 dialX+20*Math.cos(a2), dialY+20*Math.sin(a2));
      }
      doc.setFont('helvetica','bold'); doc.setFontSize(14); doc.setTextColor(17,24,39);
      doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

      // meta text
      doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
      doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
      doc.text('Status:',    LM+56, y+12);
      doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
      doc.text(STATUS, LM+74, y+12);

      // next steps
      doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
      doc.text('Next steps:', LM+56, y+20);
      const tips = (score<40)
        ? ['Stand up allow-listing on workstations first','Define patch SLAs & enforcement','Block internet-origin macros']
        : (score<70)
          ? ['Expand allow-listing to servers','Quarterly privileged access reviews','Roll out MFA to all sensitive apps']
          : (score<90)
            ? ['Test DR restores quarterly','Harden browser/scripting defaults','Adopt phishing-resistant MFA']
            : ['Sustain cadence & dashboards','Quarterly risk/maturity refresh','Automate evidence exports'];
      tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, y+26 + i*5));
      y += 54;

      // Domain bars (per strategy)
      doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
      doc.text('Strategy Breakdown', LM, y); y += 5;

      const DOMAINS = {
        'Application Control': ['ac-policy','ac-publish'],
        'Patch Applications': ['pa-sla','pa-browsers'],
        'Configure Office Macros': ['macro-block','macro-signed'],
        'User Application Hardening': ['uh-features','uh-downloads'],
        'Restrict Admin Privileges': ['ra-jit','ra-review'],
        'Patch Operating Systems': ['pos-support','pos-deploy'],
        'Multi-Factor Authentication': ['mfa-remote','mfa-phish'],
        'Regular Backups': ['bu-schedule','bu-immutable'],
      };

      Object.entries(DOMAINS).forEach(([name, ids])=>{
        const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
        const max = ids.length*2;
        const p   = Math.round((got/max)*100) || 0;

        doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(17,24,39);
        doc.text(name, LM, y+5);

        const barX = LM + 64, barW = W - LM - RM - 64;
        doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
        doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
        const fillW = Math.max(0, Math.min(barW*(p/100), barW));
        doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

        doc.setFont('helvetica','bold'); doc.setTextColor(70);
        doc.text(`${p}%`, barX + barW + 4, y+5);

        y += 11;
      });

      y = hr(y, 6);

      // Gaps
      doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
      doc.text('Top Gaps & Risks', LM, y); y += 6;

      const GAPMAP = {
        'ac-policy':'Allow-listing not enforced',
        'ac-publish':'Allow-list change control missing',
        'pa-sla':'Patch SLAs/overdue monitoring weak',
        'pa-browsers':'Browser/plug-in patching weak',
        'macro-block':'Internet macros not blocked',
        'macro-signed':'Unsigned macros allowed',
        'uh-features':'Risky features enabled',
        'uh-downloads':'Download/exe restrictions weak',
        'ra-jit':'No JIT/JEA or separate admin accounts',
        'ra-review':'Privileged review cadence weak',
        'pos-support':'Unsupported OS in use',
        'pos-deploy':'Patch deployment/reporting weak',
        'mfa-remote':'MFA coverage gaps',
        'mfa-phish':'No phishing-resistant MFA',
        'bu-schedule':'Backup schedule/RPO unclear',
        'bu-immutable':'No offline/immutable backups or tests',
      };
      const highs=[], meds=[];
      Object.keys(GAPMAP).forEach(id=>{
        const v = state[id];
        if(v===0) highs.push(GAPMAP[id]);
        else if(v===1) meds.push(GAPMAP[id]);
      });

      const colW = (W - LM - RM - 6)/2;
      const drawList = (title, items, x, color) =>{
        if(items.length===0) return y;
        doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(...color);
        doc.text(title, x, y);
        let yy = y + 4;
        doc.setFont('helvetica','normal'); doc.setTextColor(17,24,39); doc.setFontSize(10);
        items.forEach(t=>{
          const lines = doc.splitTextToSize(`- ${t}`, colW);
          doc.text(lines, x, yy);
          yy += lines.length*4.2 + 1.5;
        });
        return yy;
      };
      const yLeftEnd  = drawList('High (No): address immediately', highs, LM, [239,68,68]);
      const yRightEnd = drawList('Medium (Partial): tighten soon', meds, LM + colW + 6, [99,102,241]);
      y = Math.max(yLeftEnd, yRightEnd) + 4;

      y = hr(y, 4);

      // Detailed responses
      doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
      doc.text('Detailed Responses', LM, y); y += 5;

      const FLAT = [
        { id:'ac-policy', label:'Executable/DLL/script allow-listing enforced on servers and workstations?' },
        { id:'ac-publish', label:'Change control & publishing process for allow-list updates documented?' },
        { id:'pa-sla', label:'Patch SLAs set (e.g., critical ≤48–72h) with monitoring of overdue items?' },
        { id:'pa-browsers', label:'Browsers/plug-ins auto-update or centrally patched within SLA?' },
        { id:'macro-block', label:'Macros blocked by default from the internet/untrusted sources?' },
        { id:'macro-signed', label:'Only signed macros from trusted publishers or locations are allowed?' },
        { id:'uh-features', label:'Legacy/risky features disabled (Flash/Java legacy, browser ad/JS controls)?' },
        { id:'uh-downloads', label:'Downloads/executables restricted; SmartScreen/ATP configured?' },
        { id:'ra-jit', label:'Admin access JIT/JEA with separate admin accounts and approvals?' },
        { id:'ra-review', label:'Privileged access reviewed at least quarterly with removals tracked?' },
        { id:'pos-support', label:'Only supported OS versions in use; unsupported versions isolated/retired?' },
        { id:'pos-deploy', label:'Central patch deployment with compliance reporting and reboot cadence?' },
        { id:'mfa-remote', label:'MFA enforced for VPN/remote, privileged & sensitive app access?' },
        { id:'mfa-phish', label:'Phishing-resistant MFA (FIDO2/number-match) where feasible?' },
        { id:'bu-schedule', label:'Regular backups incl. critical SaaS; RPO/RTO defined and monitored?' },
        { id:'bu-immutable', label:'Backups offline/immutable; restoration tests performed and logged?' },
      ];

      const drawRow = (idx, text, val)=>{
        if(y>275){ doc.addPage(); y=16; }
        const rowH = 12 + Math.max(0, doc.splitTextToSize(text, W-LM-RM-40).length-1)*4.2;
        doc.setFillColor(245,247,255);
        doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

        doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
        const wrapW = W - LM - RM - 40;
        const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
        doc.text(lines, LM+4, y+4);

        const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
        let fill=[229,231,235], txt=[107,114,128];
        if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
        else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
        else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

        doc.setFont('helvetica','bold'); doc.setFontSize(10);
        const tw = doc.getTextWidth(label);
        const pillW = Math.max(22, tw + 8);
        const chipX = W - RM - pillW - 4;
        const chipY = y - 1;
        doc.setDrawColor(222,226,236);
        doc.setFillColor(...fill);
        doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
        doc.setTextColor(...txt);
        doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

        y += rowH + 8;
      };
      FLAT.forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

      // CTA button
      if(y>246){ doc.addPage(); y=16; }
      y += 4;
      const btnW = 178, btnH = 18, btnX = LM, btnY = y;
      doc.setFillColor(79,70,229);
      doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
      doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);
      doc.text('Need help closing gaps? Book a roadmap call', btnX + 6, btnY + 12);
      doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

      // footer
      doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
      doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

      doc.save('essential_eight_readiness.pdf');
    }
  })();
  </script>

