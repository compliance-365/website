  description="ISO 27001, SOC 2, Essential Eight, ISO 42001 AI Governance — fixed-price, evidence-backed, delivered inside Microsoft 365. Serving Australian mid-market organisations from Brisbane."
>

<Header />

<!-- Nav dropdown z-index fix — hero-wrap creates a stacking context that traps the dropdown -->
<style>
  /* Ensure header sits above all page content */
  body > header,
  body > div > header { position: relative; z-index: 200; }
  /* Dropdown must be higher */
  body > header nav ul,
  body > header nav li > ul,
  body > header nav li > div,
  body > header .dropdown,
  body > header [class*="drop"] { z-index: 9999 !important; }
  /* Keep hero and announcement below header stacking context */
  .hero-wrap { z-index: 1 !important; position: relative; }
  .announce-bar { z-index: 1 !important; position: relative; }
</style>

<!-- ANNOUNCEMENT BAR — position:static to avoid trapping header dropdown -->
<div class="announce-bar" style="position:relative;z-index:1;">
