---
// src/pages/services/nist-csf.astro
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = `${base}book`;

// FAQ structured data (minimal but useful)
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is NIST CSF 2.0?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The NIST Cybersecurity Framework 2.0 is a voluntary, risk-based framework with six core functions (Govern, Identify, Protect, Detect, Respond, Recover) to manage cybersecurity risk."
      }
    },
    {
      "@type": "Question",
      "name": "Do Australian organisations need NIST CSF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While not mandatory, many regulators (ACSC, APRA, ASIC) accept NIST CSF evidence, especially for cross-border data flows and critical infrastructure."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a NIST CSF engagement take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Current profile: 2–4 weeks; Target + Roadmap: 4–6 weeks; Ongoing measurement: quarterly cadence."
      }
    }
  ]
};
---
<Base
  title="NIST CSF 2.0 Consulting, Profiles & Roadmap – Australia | Compliance365"
  description="NIST CSF 2.0 current & target profiles, risk-based roadmaps and board-ready metrics – delivered in Australia by Compliance365."
  schema={[
    {
      "@type":"Service",
      "@id":"https://www.compliance365.com.au/services/nist-csf#service",
      "serviceType":"NIST CSF 2.0 Consulting",
      "name":"NIST CSF 2.0 Implementation (Australia)",
      "url":"https://www.compliance365.com.au/services/nist-csf",
      "areaServed":{"@type":"Country","name":"Australia"},
      "provider":{"@type":"Organization","name":"Compliance365","url":"https://www.compliance365.com.au"},
      "offers":{"@type":"Offer","availability":"https://schema.org/InStock"}
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Services","item":"https://www.compliance365.com.au/services"},
        {"@type":"ListItem","position":3,"name":"NIST CSF","item":"https://www.compliance365.com.au/services/nist-csf"}
      ]
    }
  ]}
/>

<Header />

<!-- FAQ LD -->
<Fragment slot="faq">
  <script type="application/ld+json">
    {JSON.stringify(faqLd)}
  </script>
</Fragment>

<!-- HERO -->
<section class="container section">
  <div class="grid-2" style="align-items:center;gap:2rem">
    <div>
      <h1>NIST CSF 2.0</h1>
      <p class="h4 muted" style="margin-top:0.5rem">
        From <strong>Current Profile → Target Profile</strong> with a prioritised, measurable roadmap.
      </p>
      <p class="muted">
        We turn the NIST framework into quarterly wins, board-level scorecards and audit-ready evidence — all tailored to Australian risk appetites.
      </p>

      <div class="pill-row" style="margin:1rem 0">
        <span class="pill">Current profile</span>
        <span class="pill">Target profile</span>
        <span class="pill">Roadmap</span>
        <span class="pill">Metrics</span>
        <span class="pill">Board reporting</span>
      </div>

      <div class="btn-row" style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-primary" href={ctaUrl}>Start NIST CSF</a>
        <a class="btn btn-ghost" href={`${base}case-studies`}>See Results</a>
      </div>

      <p class="small muted" style="margin-top:1rem">
        <strong>Trusted by 40+ Australian enterprises</strong> – APRA-regulated, critical infrastructure, SaaS.
      </p>
    </div>

    <div class="card" style="padding:0;overflow:hidden;border-radius:22px">
      <img
        src={`${base}assets/illus-nist-csf.svg`}
        alt="NIST CSF 2.0 journey: Current → Gap → Target → Metrics"
        width="600" height="400"
        loading="lazy" decoding="async"
        style="width:100%;height:auto;display:block"
      />
    </div>
  </div>
</section>

<!-- FRAMEWORK OVERVIEW (new) -->
<section class="container section bg-light" style="padding:3rem 0">
  <h2 class="center">What is NIST CSF 2.0?</h2>
  <div class="grid-2" style="align-items:start;gap:2rem">
    <div>
      <p class="muted">
        Released in <strong>February 2024</strong>, NIST CSF 2.0 introduces a sixth function — <strong>Govern</strong> — and expands to cover <em>all</em> organisations, not just critical infrastructure.
      </p>
      <ul class="muted">
        <li><strong>Govern (GV)</strong> – policies, roles, supply-chain risk</li>
        <li><strong>Identify (ID)</strong> – asset management, risk assessment</li>
        <li><strong>Protect (PR)</strong> – access control, data security</li>
        <li><strong>Detect (DE)</strong> – monitoring, anomaly detection</li>
        <li><strong>Respond (RS)</strong> – incident response, mitigation</li>
        <li><strong>Recover (RC)</strong> – resilience, lessons learned</li>
      </ul>
      <p class="muted">
        The framework uses <strong>Implementation Tiers</strong> (Partial → Risk-Informed → Repeatable → Adaptive) and <strong>Profiles</strong> to map <em>current</em> vs <em>target</em> maturity.
      </p>
  </div>
</section>

<section class="container section">
  <h2 class="center">Simplifying NIST CSF with Microsoft 365</h2>
  <p class="muted">
    We operationalise NIST CSF 2.0 directly inside your Microsoft 365 tenant — no new tools required.
    Each function maps to built-in Microsoft capabilities for faster evidence and measurable results.
  </p>

  <div class="grid-3" style="margin-top:1.5rem">
    <div class="card small">
      <h3>Govern & Identify</h3>
      <p class="muted small">
        <strong>Tools:</strong> Purview, Entra ID, SharePoint  
        <strong>Use:</strong> Role-based access reviews, data mapping, risk registers, and ownership tracking.
      </p>
    </div>

    <div class="card small">
      <h3>Protect & Detect</h3>
      <p class="muted small">
        <strong>Tools:</strong> Defender for Endpoint, M365 Security Center, Sentinel  
        <strong>Use:</strong> Continuous monitoring, DLP, vulnerability dashboards, and alert response workflows.
      </p>
    </div>

    <div class="card small">
      <h3>Respond & Recover</h3>
      <p class="muted small">
        <strong>Tools:</strong> Teams, Power Automate, SharePoint, OneDrive  
        <strong>Use:</strong> IR runbooks, automated notifications, post-incident reviews, and evidence retention.
      </p>
    </div>
  </div>

  <p class="muted" style="margin-top:1rem">
    This approach simplifies evidence capture and aligns directly with ISO 27001 controls and Essential Eight maturity uplift.
  </p>
</section>

<!-- DELIVERABLES -->
<section class="container section">
  <h2 class="center">Core Deliverables</h2>
  <div class="grid-3" style="margin-top:1.5rem">
    <div class="card">
      <h3>Cyber Profile Assessment (Current → Target)</h3>
      <p class="muted"><strong>Outcome:</strong> Defensible baseline with evidence paths inside Microsoft 365.</p>
      <ul class="muted small">
        <li>Scoring by <em>Function → Category → Subcategory</em></li>
        <li>Implementation Tier guidance (Partial → Adaptive)</li>
        <li>Evidence links: SharePoint, Entra ID, Purview, Defender</li>
        <li>Prioritised gaps & dependency notes</li>
      </ul>
    </div>

    <div class="card">
      <h3>Prioritised Risk & Funding Roadmap</h3>
      <p class="muted"><strong>Outcome:</strong> 12-month plan grouped by NIST functions with owners and costs.</p>
      <ul class="muted small">
        <li>Quarterly milestones with RACI/owners</li>
        <li>Cost/effort vs risk-reduction view</li>
        <li>Runbooks & repeatable test scripts</li>
        <li>Audit-ready artefact catalogue</li>
      </ul>
    </div>

    <div class="card">
      <h3>Continuous Measurement & Reporting</h3>
      <p class="muted"><strong>Outcome:</strong> Real-time posture scorecards, not activity logs.</p>
      <ul class="muted small">
        <li>Power BI / Excel dashboard with trendlines</li>
        <li>Evidence freshness & control-coverage tracking</li>
        <li>Cross-walk to ISO 27001, Essential Eight & SOC 2</li>
        <li>Monthly executive summary & board pack</li>
      </ul>
    </div>
  </div>
</section>

<p class="muted center" style="margin-top:1.5rem">
  <em>Each NIST CSF function is pre-mapped to ISO 27001 Annex A controls, Essential Eight strategies, and SOC 2 criteria — reducing duplication and audit fatigue.</em>
</p>

<!-- HOW WE WORK -->
<section class="container section bg-light">
  <h2 class="center">Our Proven 3-Phase Approach</h2>
  <div class="process-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:1.5rem;position:relative">
    <!-- Arrow connector (desktop only) -->
    <div class="process-arrow" style="position:absolute;top:4.5rem;left:22%;right:22%;height:2px;background:var(--clr-primary);display:none;@media(min-width:768px){display:block}"></div>

    <div class="card feature center">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" aria-label="Step 1"><path d="M4 7h16M4 12h12M4 17h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </div>
      <h3>1. Profile & Risk</h3>
      <p class="muted small">Scope, risk register, current-state workshop (2–4 weeks).</p>
    </div>

    <div class="card feature center">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" aria-label="Step 2"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </div>
      <h3>2. Target & Roadmap</h3>
      <p class="muted small">Define target tier, prioritise initiatives, agree metrics (4–6 weeks).</p>
    </div>

    <div class="card feature center">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" aria-label="Step 3"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3>3. Execute & Report</h3>
      <p class="muted small">Quarterly sprints, evidence vault, board pack (ongoing).</p>
    </div>
  </div>
</section>

<!-- TESTIMONIAL SNIPPET (optional but powerful) -->
<section class="container section-tight center">
  <blockquote class="testimonial">
    <p>“Compliance365 turned our NIST CSF gap analysis into a funded 12-month program with clear ROI. The board now sees cyber posture lift every quarter.”</p>
    <cite>— CISO, ASX-listed financial services firm</cite>
  </blockquote>
</section>

<section class="container section bg-light">
  <h2 class="center">Who Benefits from NIST CSF?</h2>
  <div class="grid-3" style="margin-top:1.5rem">
    <div class="card small">
      <h3>Health & SaaS Providers</h3>
      <p class="muted small">Show regulators and enterprise customers a measurable cybersecurity maturity baseline aligned to global frameworks.</p>
    </div>
    <div class="card small">
      <h3>APRA & ASIC-Regulated Entities</h3>
      <p class="muted small">Leverage NIST CSF 2.0 evidence for CPS 234 or CPG 234 compliance with clear traceability to Microsoft 365 controls.</p>
    </div>
    <div class="card small">
      <h3>Critical Infrastructure Operators</h3>
      <p class="muted small">Integrate NIST CSF with ISM and DISP alignment for a single, defensible security posture across suppliers.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="container section-tight" style="padding-bottom:4rem">
  <div class="card cta-card" style="display:flex;gap:1.5rem;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
    <div>
      <h3 style="margin:0 0 .4rem">Ready to operationalise NIST CSF 2.0?</h3>
      <p class="muted" style="margin:0">Profile → Roadmap → Measurable Progress — all in 8–12 weeks.</p>
    </div>
    <a class="btn btn-primary" href={ctaUrl}>Book a Scoping Call</a>
  </div>
</section>

<!-- RELATED SERVICES -->
<section class="container section">
  <div class="card" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
    <strong style="margin-right:8px">Related services:</strong>
    <a class="pill" href="/services/iso27001">ISO 27001</a>
    <a class="pill" href="/services/iso27701">ISO 27701 (Privacy)</a>
    <a class="pill" href="/services/iso42001">ISO 42001 (AI)</a>
    <a class="pill" href="/services/soc2">SOC 2</a>
    <a class="pill" href="/services/essential-eight">Essential Eight</a>
    <a class="pill" href="/services/disp-ism-irap">DISP / ISM / IRAP</a>
  </div>
</section>

<Footer />
</Base>

<style>
  .pill-row { display:flex; gap:.5rem; flex-wrap:wrap; }
  .btn-row { margin-top:1rem; }
  .testimonial { max-width:680px; margin:0 auto; font-style:italic; }
  .testimonial cite { display:block; margin-top:.5rem; font-weight:600; font-style:normal; }
  .process-arrow { z-index:1; }
  @media (max-width:767px) { .process-arrow { display:none; } }
</style>
