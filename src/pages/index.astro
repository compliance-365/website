<div>
  <h1 class="hero-title" style="margin:0 0 10px">
    Get certified. Keep moving.
  </h1>

  <p class="hero-sub muted" style="max-width:620px;margin:0">
    We help teams achieve <strong>ISO&nbsp;27001, ISO&nbsp;27701, ISO&nbsp;42001, SOC&nbsp;2</strong> and the
    <strong>Essential Eight</strong> <em>in weeks, not months</em>. No new software to learn —
    we capture auditor-ready evidence <strong>inside Microsoft&nbsp;365</strong>.
  </p>

  <!-- CTAs -->
  <div class="hero-ctas" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:18px">
    <a class="btn btn-primary" href={ctaUrl}>Book a roadmap call</a>
    <a class="btn btn-ghost" href={resourcesUrl}>Get the checklists</a>
  </div>

  <!-- Credibility strip -->
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
    <span class="chip chip-check">Clear plan in 1 week</span>
    <span class="chip chip-check">Auditor-ready evidence</span>
    <span class="chip chip-check">Works in Microsoft&nbsp;365</span>
  </div>

  <!-- Social proof -->
  <p class="muted small" style="margin:10px 0 0">
    Trusted by government, health and technology organisations across Australia.
  </p>
</div>

