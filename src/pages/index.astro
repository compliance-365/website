  <!-- HERO FORM SCRIPT (kept from your original) -->
  <script is:inline>
    const API_URL = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

    const form   = document.getElementById("hero-form");
    const email  = document.getElementById("hero-email");
    const submit = document.getElementById("hero-submit");
    const status = document.getElementById("hero-status");

    function validEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

    if (form && email && submit && status) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        status.textContent = "";
        submit.disabled = true;

        try {
          const payload = {
            name: "Website visitor",
            email: email.value.trim(),
            subject: "Website enquiry (hero form)",
            message: "Lead from homepage hero form",
            source: "hero-email",
            page: location.pathname
          };

          const res  = await fetch(API_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          const text = await res.text().catch(() => "");

          if (!res.ok) {
            console.error("Hero submit failed", { status: res.status, text });
            status.textContent = `Sorry, something went wrong (HTTP ${res.status}).`;
            status.style.color = "crimson";
            return;
          }

          form.reset();
          status.textContent = "Thanks — we’ll be in touch shortly.";
          status.style.color = "var(--primary)";
        } catch (err) {
          console.error("Hero form error:", err);
          status.textContent = "Sorry, something went wrong. Please try again.";
          status.style.color = "crimson";
        } finally {
          submit.disabled = false;
        }
      });
    }
  </script>

