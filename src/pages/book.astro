---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const bookingsUrl = 'https://outlook.office365.com/owa/calendar/Compliance3652@compliance365.com.au/bookings/';

// ✅ Your AWS API Gateway endpoint (same as your working site)
const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';
---

<Base title="Book a Call — Compliance365" description="Pick a 15 or 30 minute slot or send us a quick message.">
  <Header />

  <section class="container section">
    <div class="grid-2" style="align-items:start;gap:40px">
      <!-- LEFT: Microsoft Bookings -->
      <div>
        <h1>Book a call</h1>
        <p class="muted" style="margin-bottom:10px;">
          Choose a time that works for you — or send us a quick message if you'd prefer.
        </p>
        <ul class="muted" style="margin-bottom:16px;">
          <li>15 or 30 minutes</li>
          <li>Microsoft Teams link auto-generated</li>
          <li>No selling — just practical next steps</li>
        </ul>

        <div class="card spot" style="padding:0;overflow:hidden;border-radius:16px;">
          <iframe
            src={bookingsUrl}
            title="Book a call with Compliance365"
            style="display:block;width:100%;min-width:320px;height:800px;border:none;"
            loading="lazy"
          ></iframe>
        </div>
        <p class="muted small" style="margin-top:10px;">
          Booking window not loading? <a href={bookingsUrl} target="_blank" rel="noopener noreferrer">Open it in a new tab →</a>
        </p>
      </div>

      <!-- RIGHT: Contact form -->
      <div>
        <h2 style="margin-top:0">Prefer to send a message?</h2>
        <p class="muted">We'll reply within 1 business day. Just tell us a bit about what you need help with.</p>

        <div class="card spot" style="padding:22px;border-radius:16px;">
          <form id="quickMsgForm" novalidate style="display:grid;gap:12px;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div style="display:flex;flex-direction:column;gap:4px">
                <label for="qName" style="font-size:0.85rem;font-weight:600;color:#374151">Your name <span aria-hidden="true" style="color:#b91c1c">*</span></label>
                <input id="qName" name="name" placeholder="Jane Smith" required
                       style="padding:10px;border-radius:8px;border:1px solid #ccc;">
              </div>
              <div style="display:flex;flex-direction:column;gap:4px">
                <label for="qEmail" style="font-size:0.85rem;font-weight:600;color:#374151">Email <span aria-hidden="true" style="color:#b91c1c">*</span></label>
                <input id="qEmail" name="email" type="email" placeholder="jane@company.com.au" required
                       style="padding:10px;border-radius:8px;border:1px solid #ccc;">
              </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:4px">
              <label for="qCompany" style="font-size:0.85rem;font-weight:600;color:#374151">Company</label>
              <input id="qCompany" name="company" placeholder="Acme Pty Ltd"
                     style="padding:10px;border-radius:8px;border:1px solid #ccc;">
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
              <label for="qMessage" style="font-size:0.85rem;font-weight:600;color:#374151">Message</label>
              <textarea id="qMessage" name="message" placeholder="What do you need help with?" rows="6"
                        style="padding:10px;border-radius:8px;border:1px solid #ccc;"></textarea>
            </div>

            <p id="qError" class="small" style="color:#b91c1c;display:none;margin:.4rem 0 0"></p>
            <p id="qSuccess" class="small" style="color:#059669;display:none;margin:.6rem 0 0"></p>

            <button id="qSubmit" type="submit" class="btn btn-primary" style="margin-top:6px;">Send message</button>
          </form>

          <p class="muted small" style="margin-top:8px;">
            By submitting, you agree to our <a href={base + 'privacy'}>Privacy Policy</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script is:inline>
  // ✅ Use your working Lambda URL
  const API_URL = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  const form = document.getElementById('quickMsgForm');
  const btn  = document.getElementById('qSubmit');
  const err  = document.getElementById('qError');
  const ok   = document.getElementById('qSuccess');

  function validEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();                     // ← stops navigation to the Lambda JSON
    err.style.display = 'none';
    ok.style.display  = 'none';

    const name    = (document.getElementById('qName').value || '').trim();
    const email   = (document.getElementById('qEmail').value || '').trim();
    const company = (document.getElementById('qCompany').value || '').trim();
    const message = (document.getElementById('qMessage').value || '').trim();

    if(name.length < 2){ err.textContent = 'Please enter your full name.'; err.style.display='block'; return; }
    if(!validEmail(email)){ err.textContent = 'Please enter a valid email.'; err.style.display='block'; return; }

    btn.disabled = true;

    try{
      // Your Lambda expects JSON (we confirmed this earlier)
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ name, email, subject: '', message })
      });

      if(!res.ok) throw new Error('Request failed: ' + res.status);

      form.reset();
      ok.textContent = 'Your message has been sent. We\'ll reply within 1 business day.';
      ok.style.display = 'block';
      if (typeof gtag === 'function') gtag('event', 'quick_message_submit', { page_location: window.location.href });
    }catch(e){
      console.error(e);
      err.textContent = 'Could not send right now. Please email info@compliance365.com.au or try again.';
      err.style.display = 'block';
    }finally{
      btn.disabled = false;
    }
  });
</script>
</Base>
