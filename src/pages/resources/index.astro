---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const FORMSPREE = 'https://formspree.io/f/mnngvoqe';

// helper to resolve images under public/ with BASE_URL, but allow absolute URLs
function resolveImg(src) {
  if (!src) return null;
  if (/^https?:\/\//i.test(src)) return src; // external
  // ensure exactly one slash between base and path
  return (base + String(src).replace(/^\/+/, '')).replace(/\/{2,}/g, '/');
}

// === Featured guides (ungated pages) ===
const GUIDES = [
  {
    slug: 'inside-statement-of-applicability',
    title: 'Inside a Statement of Applicability (SoA)',
    desc: 'What auditors expect, how risk links to Annex A, and practical evidence tips.',
    img: resolveImg('/assets/guide-soa.svg'),
    cta: 'Read guide',
  },
  {
    slug: 'what-a-good-ropa-looks-like',
    title: 'What a Good ROPA Looks Like (and Common Mistakes)',
    desc: 'The anatomy of a useful ROPA with examples of good vs. risky entries.',
    img: resolveImg('/assets/guide-ropa.svg'),
    cta: 'Read guide',
  },
  {
    slug: 'ai-governance-readiness',
    title: 'AI Governance Readiness (ISO 42001)',
    desc: 'Model inventory, AI risk, human oversight and monitoring—explained simply.',
    img: resolveImg('/assets/guide-42001.svg'),
    cta: 'Read guide',
  },
  {
    slug: 'automating-compliance',
    title: 'Automating Compliance in Microsoft 365, Azure & AWS',
    desc: 'Turn evidence, access reviews and posture into continuous assurance—no new platform.',
    img: resolveImg('/assets/guide-automating.svg'),
    cta: 'Read guide',
  },
];

// === Interactive checklists (reuse your modal) ===
const CHECKLISTS = [
  {
    title: 'ISO 27001 Readiness Checklist',
    desc: '10-point scorecard for scope, risk, controls, SoA and internal audit.',
    img: resolveImg('/assets/blog-iso27001.svg'),
    target: base + 'checklist/iso27001',
  },
  {
    title: 'ISO 27701 (Privacy) Checklist',
    desc: 'ROPA, DPIA, rights handling, data lifecycle, privacy controls.',
    img: resolveImg('/assets/blog-iso27701.svg'),
    target: base + 'checklist/iso27701',
  },
  {
    title: 'ISO 42001 (AI) Checklist',
    desc: 'AIMS governance, model inventory, AI risk, human oversight and monitoring.',
    img: resolveImg('/assets/blog-iso42001-v2.svg'),
    target: base + 'checklist/iso42001',
  },
];
---

<Base title="Resources — Compliance365"
      description="Guides and checklists for ISO 27001, ISO 27701 and ISO 42001. Practical, no-fluff content.">
  <Header />

  <section class="container section">
    <h1>Resources</h1>
    <p class="muted" style="max-width:1000px">
      Practical content that builds confidence and momentum—no fluff. Read the short guides, or use the interactive checklists to score your readiness.
    </p>

    <!-- Featured Guides -->
    <h2 style="margin-top:28px">Featured Guides</h2>
    <div class="grid-3" style="margin-top:12px">
      {GUIDES.map((g) => (
  <a href={`${base}resources/${g.slug}`} class="card lift" style="display:flex;flex-direction:column;gap:12px;color:inherit">
    <div class="cover">
      <img
        src={g.img}
        alt={g.title}
        loading="lazy"
        decoding="async"
        style="width:100%;aspect-ratio:16/9;object-fit:contain;background:#fff;border-radius:12px;border:1px solid rgba(10,18,32,.06);padding:10px;"
      />
    </div>

    <h3 style="margin:.4rem 0 0">{g.title}</h3>
    <p class="muted">{g.desc}</p>

    <div style="margin-top:auto;display:flex;gap:10px;flex-wrap:wrap">
      <span class="btn btn-ghost" role="button" aria-label={g.cta}>{g.cta}</span>
    </div>
  </a>
))}

    <!-- Checklists -->
    <h2 style="margin-top:34px">Interactive Checklists</h2>
    <div class="grid-3" style="margin-top:12px">
      {CHECKLISTS.map((c) => (
        <article class="card lift" style="display:flex;flex-direction:column;gap:12px">
          <div class="cover">
            {c.img ? (
              <img
                class="guide-img"
                src={c.img}
                alt={c.title}
                width="960" height="420"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <div class="cover-fallback">
              <span class="muted">Preview unavailable</span>
            </div>
          </div>

          <h3 style="margin:.4rem 0 0">{c.title}</h3>
          <p class="muted">{c.desc}</p>

          <div style="margin-top:auto;display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn btn-primary dl" href={c.target} data-target={c.target}>Start checklist</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Footer />

  <!-- Lead modal (shared, reused for checklists) -->
  <div id="leadModal" role="dialog" aria-modal="true" aria-labelledby="leadTitle"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); align-items:center; justify-content:center; z-index:2500;">
    <div style="background:#fff; padding:22px; border-radius:16px; width:min(94vw,460px); box-shadow:0 16px 40px rgba(0,0,0,.18); border:1px solid rgba(10,18,32,.08)">
      <h3 id="leadTitle" style="margin:0 0 6px">Before you continue</h3>
      <p class="muted small" style="margin-top:0">Tell us where to send the checklist and related resources.</p>

      <form id="leadForm" novalidate>
        <input type="hidden" name="form-name" value="Resources Modal" />
        <label class="small" for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required
               style="width:100%;margin:6px 0 10px;padding:12px;border:1px solid #d8dde8;border-radius:10px">

        <label class="small" for="email">Work email</label>
        <input id="email" name="email" type="email" autocomplete="email" required
               style="width:100%;margin:6px 0 2px;padding:12px;border:1px solid #d8dde8;border-radius:10px">

        <p id="leadError" class="small" style="color:#b91c1c;display:none;margin:.25rem 0 0"></p>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:14px">
          <button type="button" class="btn btn-ghost" id="leadCancel">Cancel</button>
          <button type="submit" class="btn btn-primary" id="leadSubmit">Continue</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
  const FORMSPREE = {JSON.stringify(FORMSPREE)};
  let pendingTarget = null;

  const modal      = document.getElementById('leadModal');
  const form       = document.getElementById('leadForm');
  const err        = document.getElementById('leadError');
  const cancelBtn  = document.getElementById('leadCancel');
  const submitBtn  = document.getElementById('leadSubmit');
  const nameEl     = document.getElementById('name');
  const emailEl    = document.getElementById('email');

  function openModal(target){
    pendingTarget = target;
    err.style.display = 'none';
    form.reset();
    modal.style.display = 'flex';
    setTimeout(()=> nameEl?.focus(), 0);
  }
  function closeModal(){
    modal.style.display = 'none';
    pendingTarget = null;
  }
  function validEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

  // Intercept clicks on BOTH anchors and buttons with class "dl"
  document.addEventListener('click', (e)=>{
    const el = e.target.closest('a.dl, button.dl');
    if(!el) return;
    e.preventDefault(); // we’ll navigate manually
    const target = el.dataset.target || el.getAttribute('href');
    if(!target){ return; }
    openModal(target);
  });

  // Basic close controls
  cancelBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

  // Submit → Formspree (best-effort) → always navigate
  form?.addEventListener('submit', async (e)=>{
    e.preventDefault();

    const name  = (nameEl?.value || '').trim();
    const email = (emailEl?.value || '').trim();

    if(!name || !validEmail(email)){
      err.textContent = 'Please enter your name and a valid email.';
      err.style.display = 'block';
      return;
    }
    const target = pendingTarget;
    if(!target){ closeModal(); return; }

    submitBtn.disabled = true;
    try{
      // If FORMSPREE isn’t configured, skip the post
      if(FORMSPREE){
        await fetch(FORMSPREE, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, source:'resources', intent:'checklist', target })
        });
      }
    }catch(_err){
      // swallow — we’ll still let them through
    }finally{
      closeModal();
      submitBtn.disabled = false;
      window.location.href = target;
    }
  });
</script>
</Base>
