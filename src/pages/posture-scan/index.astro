---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Free M365 Compliance Posture Scan — Essential Eight, ISO 27001, ISO 27701 & ISO 42001 | Compliance365"
  description="Sign in read-only with Microsoft and get an instant compliance posture score across Essential Eight, ISO 27001, ISO 27701 and ISO 42001 — all computed live from your existing M365 tenant data."
  robots="index,follow"
>
  <Header />
  <script src="/assets/msal-browser.min.js" is:inline></script>

  <style is:global>
    .ps-root {
      background: #F8FAFC;
      min-height: 60vh;
      font-family: 'Inter','Segoe UI',system-ui,-apple-system,sans-serif;
      -webkit-font-smoothing: antialiased;
      --ps-gold:#A9812E; --ps-gold-light:#D8BA78; --ps-green:#10B981; --ps-purple:#8B5CF6;
      --ps-amber:#D97706; --ps-red:#EF4444; --ps-ink:#0F172A; --ps-ink2:#1E293B;
      --ps-slate:#64748B; --ps-muted:#94A3B8; --ps-line:#E2E8F0; --ps-line2:#F1F5F9;
      --ps-bg:#F8FAFC; --ps-card:#FFFFFF;
      --ps-shadow:0 1px 3px rgba(15,23,42,.07),0 1px 2px rgba(15,23,42,.05);
      --ps-shadow-lg:0 10px 30px -8px rgba(15,23,42,.12),0 2px 8px rgba(15,23,42,.06);
      --ps-radius:14px;
    }
    .ps-wrap { max-width:880px; margin:0 auto; padding:0 28px; }

    /* INTRO */
    .ps-intro { padding:72px 0 88px; }
    .ps-eyebrow {
      display:inline-flex; align-items:center; gap:8px;
      font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
      color:var(--ps-gold); background:rgba(169,129,46,0.08); border:1px solid rgba(169,129,46,.18);
      padding:5px 12px; border-radius:999px; margin-bottom:24px;
    }
    .ps-eyebrow-dot {
      width:6px; height:6px; border-radius:50%; background:var(--ps-gold-light);
      animation:ps-pulse 2s ease-in-out infinite;
    }
    @keyframes ps-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.75)} }
    .ps-intro h1 {
      font-size:clamp(30px,5vw,46px); line-height:1.07; letter-spacing:-.03em;
      font-weight:800; color:var(--ps-ink); max-width:660px; margin:0 0 20px;
    }
    .ps-intro h1 em {
      font-style:normal;
      background:linear-gradient(135deg,var(--ps-gold),var(--ps-gold-light));
      -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
    }
    .ps-lede { font-size:17px; color:var(--ps-slate); line-height:1.7; max-width:580px; margin:0 0 32px; }
    .ps-fw-strip { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:36px; }
    .ps-fw-chip { font-size:12px; font-weight:600; padding:5px 13px; border-radius:999px; letter-spacing:.01em; }
    .ps-scan-btn {
      display:inline-flex; align-items:center; gap:12px;
      background:var(--ps-ink); color:#fff; border:none; padding:15px 28px; border-radius:12px;
      font-size:15px; font-weight:700; cursor:pointer; font-family:inherit; letter-spacing:-.01em;
      box-shadow:0 4px 14px rgba(15,23,42,.2),0 1px 0 rgba(255,255,255,.08) inset;
      transition:transform .15s,box-shadow .15s;
    }
    .ps-scan-btn:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(15,23,42,.25),0 1px 0 rgba(255,255,255,.08) inset; }
    .ps-trust { display:flex; align-items:center; gap:20px; margin-top:20px; flex-wrap:wrap; }
    .ps-trust-item { display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--ps-muted); font-weight:500; }
    .ps-errbox { background:#FEF2F2; border:1px solid #FECACA; color:#991B1B; padding:14px 18px; border-radius:var(--ps-radius); font-size:14px; margin-top:20px; line-height:1.5; }

    /* TRUST MODAL */
    .ps-modal-overlay {
      position:fixed; inset:0; z-index:10000;
      background:rgba(15,23,42,.55); -webkit-backdrop-filter:blur(4px); backdrop-filter:blur(4px);
      display:flex; align-items:center; justify-content:center; padding:20px;
    }
    .ps-modal-card {
      background:#fff; border-radius:20px; max-width:740px; width:100%;
      box-shadow:0 25px 60px -10px rgba(15,23,42,.35),0 2px 8px rgba(15,23,42,.1);
      overflow:hidden; max-height:90vh; overflow-y:auto;
    }
    .ps-modal-top {
      background:linear-gradient(135deg,var(--ps-gold) 0%,var(--ps-gold) 60%,var(--ps-gold-light) 100%);
      padding:28px 32px; display:flex; align-items:flex-start; gap:18px;
    }
    .ps-modal-shield {
      width:44px; height:44px; background:rgba(255,255,255,.15); border-radius:12px;
      display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;
    }
    .ps-modal-top-text h1 { font-size:20px; font-weight:800; color:#fff; letter-spacing:-.02em; margin:0 0 6px; }
    .ps-modal-top-text p  { font-size:14px; color:rgba(255,255,255,.8); margin:0; line-height:1.5; }
    .ps-modal-body { padding:28px 32px; display:grid; grid-template-columns:1fr 1fr; gap:28px; }
    .ps-modal-section-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--ps-muted); margin-bottom:14px; }
    .ps-mock-dialog {
      border:1.5px solid var(--ps-line); border-radius:12px; overflow:hidden;
      box-shadow:var(--ps-shadow-lg);
    }
    .ps-mock-dialog-top {
      background:#F8FAFC; border-bottom:1px solid var(--ps-line);
      padding:12px 16px; display:flex; align-items:center; gap:10px;
    }
    .ps-mock-ms-ring {
      width:28px; height:28px; border-radius:50%;
      background:linear-gradient(135deg,#00A4EF,#0078D4);
      display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }
    .ps-mock-dialog-head { font-size:13px; font-weight:700; color:var(--ps-ink2); }
    .ps-mock-dialog-sub  { font-size:11px; color:var(--ps-muted); }
    .ps-mock-dialog-body { padding:14px 16px; }
    .ps-mock-app-name { font-size:13px; font-weight:700; color:var(--ps-ink2); margin-bottom:10px; }
    .ps-mock-perm {
      display:flex; align-items:flex-start; gap:8px; padding:7px 0;
      border-bottom:1px solid var(--ps-line2); font-size:12px; color:var(--ps-slate); line-height:1.4;
    }
    .ps-mock-perm:last-child { border-bottom:none; }
    .ps-mock-perm-dot { width:5px; height:5px; border-radius:50%; background:var(--ps-gold-light); flex-shrink:0; margin-top:5px; }
    .ps-guarantee-list { display:flex; flex-direction:column; gap:14px; }
    .ps-guarantee {
      display:flex; align-items:flex-start; gap:12px;
      padding:12px 14px; background:#F0FDF4; border-radius:10px; border:1px solid #BBF7D0;
    }
    .ps-guarantee-check {
      width:22px; height:22px; border-radius:50%; background:#16A34A;
      display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px;
    }
    .ps-guarantee-text strong { font-size:13px; font-weight:700; color:#14532D; display:block; margin-bottom:2px; }
    .ps-guarantee-text p { font-size:12px; color:#166534; margin:0; line-height:1.45; }
    .ps-modal-footer {
      padding:20px 32px 28px; border-top:1px solid var(--ps-line);
      display:flex; flex-direction:column; align-items:flex-start; gap:12px;
    }
    .ps-modal-footer-note { font-size:12px; color:var(--ps-muted); line-height:1.5; }
    .ps-modal-cancel { background:none; border:none; color:var(--ps-muted); font-size:13px; cursor:pointer; text-decoration:underline; padding:0; font-family:inherit; }
    .ps-modal-cancel:hover { color:var(--ps-slate); }
    @media (max-width:600px) {
      .ps-modal-body { grid-template-columns:1fr; }
      .ps-modal-top, .ps-modal-footer { padding:20px; }
      .ps-modal-body { padding:20px; }
    }

    /* LOADING */
    .ps-loading { padding:120px 0; text-align:center; }
    .ps-scan-progress { max-width:420px; margin:0 auto; }
    .ps-scan-ring { width:72px; height:72px; margin:0 auto 28px; }
    .ps-scan-ring svg { animation:ps-spin .85s linear infinite; }
    @keyframes ps-spin { to { transform:rotate(360deg); } }
    .ps-scan-status { font-size:16px; color:var(--ps-ink2); font-weight:600; margin-bottom:6px; }
    .ps-scan-sub { font-size:13px; color:var(--ps-muted); }
    .ps-progress-bar { height:3px; background:var(--ps-line); border-radius:2px; margin-top:24px; overflow:hidden; }
    .ps-progress-fill { height:100%; background:linear-gradient(90deg,var(--ps-gold),var(--ps-gold-light)); border-radius:2px; transition:width .4s ease; }

    /* RESULTS */
    .ps-results { padding:8px 0 80px; }
    .ps-summary {
      background:var(--ps-card); border:1px solid var(--ps-line); border-radius:20px;
      padding:32px 36px; display:flex; gap:36px; align-items:center; flex-wrap:wrap;
      box-shadow:var(--ps-shadow-lg);
    }
    .ps-gauge-wrap { position:relative; flex-shrink:0; }
    .ps-gauge-label { position:absolute; top:50%; left:50%; transform:translate(-50%,-52%); text-align:center; pointer-events:none; }
    .ps-gauge-pct { font-size:34px; font-weight:800; letter-spacing:-.04em; line-height:1; color:var(--ps-ink); }
    .ps-gauge-word { font-size:10px; color:var(--ps-muted); font-weight:700; text-transform:uppercase; letter-spacing:.08em; margin-top:3px; }
    .ps-summary-body { flex:1; min-width:200px; }
    .ps-summary-org { font-size:12px; color:var(--ps-muted); font-weight:600; text-transform:uppercase; letter-spacing:.06em; margin-bottom:4px; }
    .ps-summary-title { font-size:22px; font-weight:800; letter-spacing:-.02em; margin-bottom:6px; color:var(--ps-ink); }
    .ps-summary-meta { font-size:14px; color:var(--ps-slate); line-height:1.5; }
    .ps-stat-pills { display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; }
    .ps-stat-pill { font-size:12px; font-weight:600; padding:5px 11px; border-radius:8px; display:flex; align-items:center; gap:6px; }
    .ps-stat-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }

    /* TOOLBAR */
    .ps-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:28px 0 0; flex-wrap:wrap; }
    .ps-tabs { display:flex; gap:8px; flex-wrap:wrap; }
    .ps-tab {
      padding:10px 18px; border-radius:11px; font-size:13px; font-weight:600; cursor:pointer;
      border:1.5px solid var(--ps-line); background:var(--ps-card); color:var(--ps-slate);
      transition:all .18s; font-family:inherit; display:flex; align-items:center; gap:9px; white-space:nowrap;
      box-shadow:var(--ps-shadow);
    }
    .ps-tab:hover { border-color:var(--ps-muted); color:var(--ps-ink2); }
    .ps-tab.active { color:#fff; border-color:transparent; box-shadow:var(--ps-shadow-lg); }
    .ps-tab-score { opacity:.85; font-weight:700; font-size:12px; }
    .ps-tab-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .ps-tab-ml { font-size:10px; font-weight:700; letter-spacing:.04em; opacity:.8; }

    /* SORT */
    .ps-sort-wrap { display:flex; align-items:center; gap:8px; }
    .ps-sort-label { font-size:12px; font-weight:600; color:var(--ps-muted); white-space:nowrap; }
    .ps-sort-select {
      font-size:13px; font-weight:600; color:var(--ps-ink2); font-family:inherit;
      border:1.5px solid var(--ps-line); background:var(--ps-card); border-radius:9px;
      padding:7px 12px; cursor:pointer; outline:none; transition:border-color .15s;
    }
    .ps-sort-select:focus { border-color:var(--ps-gold); }

    /* CONTROLS CARD */
    .ps-controls-card {
      background:var(--ps-card); border:1px solid var(--ps-line); border-radius:20px;
      overflow:hidden; box-shadow:var(--ps-shadow-lg); margin-top:14px;
    }
    .ps-controls-header {
      padding:16px 28px; border-bottom:1px solid var(--ps-line);
      display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
    }
    .ps-controls-label { font-size:11px; font-weight:700; color:var(--ps-muted); text-transform:uppercase; letter-spacing:.07em; }
    .ps-controls-count { font-size:13px; color:var(--ps-muted); }
    .ps-quickwins-banner {
      padding:10px 28px; background:linear-gradient(90deg,#EFF6FF,#F0FDF4);
      border-bottom:1px solid var(--ps-line); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
    }
    .ps-quickwins-label { font-size:13px; font-weight:600; color:var(--ps-gold); display:flex; align-items:center; gap:7px; }
    .ps-quickwins-toggle {
      font-size:12px; font-weight:700; color:var(--ps-gold); background:none; border:1.5px solid rgba(169,129,46,.25);
      border-radius:7px; padding:5px 12px; cursor:pointer; font-family:inherit; transition:background .12s;
    }
    .ps-quickwins-toggle:hover { background:rgba(169,129,46,.06); }
    .ps-control-row { border-bottom:1px solid var(--ps-line2); }
    .ps-control-row:last-child { border-bottom:none; }
    .ps-row-head {
      width:100%; display:flex; align-items:center; gap:14px; padding:16px 28px;
      background:none; border:none; cursor:pointer; text-align:left; transition:background .12s; font-family:inherit;
    }
    .ps-row-head:hover { background:var(--ps-line2); }
    .ps-status-bar { width:3px; min-height:32px; border-radius:2px; flex-shrink:0; align-self:stretch; }
    .ps-row-text { flex:1; min-width:0; }
    .ps-row-title { font-size:14px; font-weight:600; color:var(--ps-ink2); line-height:1.35; }
    .ps-row-meta { display:flex; align-items:center; gap:8px; margin-top:3px; flex-wrap:wrap; }
    .ps-row-clause { font-size:11.5px; color:var(--ps-muted); font-weight:500; }
    .ps-method-badge { font-size:10px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; padding:3px 9px; border-radius:7px; flex-shrink:0; white-space:nowrap; }
    .ps-method-auto   { background:rgba(169,129,46,0.08); color:var(--ps-gold); }
    .ps-method-attest { background:#F5F3FF; color:var(--ps-purple); }
    .ps-status-badge { font-size:11px; font-weight:700; padding:4px 12px; border-radius:999px; flex-shrink:0; white-space:nowrap; }
    .ps-badge-pass    { background:#F0FDF4; color:#15803D; }
    .ps-badge-partial { background:#FFFBEB; color:#B45309; }
    .ps-badge-fail    { background:#FEF2F2; color:#DC2626; }
    .ps-badge-attest  { background:#F5F3FF; color:var(--ps-purple); }
    .ps-effort-badge { font-size:10px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; padding:3px 9px; border-radius:7px; flex-shrink:0; white-space:nowrap; }
    .ps-effort-quick    { background:#F0FDF4; color:#166534; }
    .ps-effort-moderate { background:#FFFBEB; color:#92400E; }
    .ps-effort-project  { background:#FEF2F2; color:#991B1B; }
    .ps-ml-badge { font-size:10px; font-weight:700; padding:3px 9px; border-radius:7px; white-space:nowrap; background:rgba(169,129,46,0.08); color:var(--ps-gold); }
    .ps-trend-badge { font-size:11px; font-weight:700; padding:3px 9px; border-radius:7px; flex-shrink:0; white-space:nowrap; }
    .ps-trend-up   { background:#F0FDF4; color:#15803D; }
    .ps-trend-down { background:#FEF2F2; color:#DC2626; }
    .ps-trend-same { background:#F1F5F9; color:var(--ps-slate); }
    .ps-chevron { color:var(--ps-muted); font-size:18px; line-height:1; transition:transform .2s; flex-shrink:0; width:18px; text-align:center; }
    .ps-chevron.open { transform:rotate(90deg); }

    /* DETAIL PANEL */
    .ps-row-detail { padding:0 28px 20px 45px; display:none; }
    .ps-row-detail.open { display:block; }
    .ps-detail-text { font-size:14px; color:var(--ps-slate); line-height:1.65; margin-bottom:12px; }
    .ps-detail-fix {
      font-size:14px; color:var(--ps-ink2); line-height:1.65;
      padding:12px 16px; background:var(--ps-line2); border-radius:10px; border-left:3px solid var(--ps-gold);
      margin-bottom:10px;
    }
    .ps-detail-fix strong { color:var(--ps-gold); font-weight:700; }
    .ps-detail-portal {
      display:flex; align-items:center; gap:8px;
      font-size:12px; color:var(--ps-slate); font-weight:500;
      background:var(--ps-bg); border:1px solid var(--ps-line); border-radius:8px; padding:8px 12px;
      margin-bottom:10px;
    }
    .ps-detail-portal svg { flex-shrink:0; color:var(--ps-muted); }
    .ps-detail-portal code { font-family:'SF Mono',SFMono-Regular,Menlo,monospace; font-size:11.5px; color:var(--ps-ink2); }
    .ps-detail-service-cta {
      display:inline-flex; align-items:center; gap:7px;
      font-size:12.5px; font-weight:700; color:var(--ps-gold); text-decoration:none;
      background:rgba(169,129,46,0.08); border:1.5px solid rgba(169,129,46,.2); border-radius:8px;
      padding:7px 14px; transition:background .12s,transform .12s;
    }
    .ps-detail-service-cta:hover { background:#DBEAFE; transform:translateY(-1px); }

    /* CTA BAND */
    .ps-cta-band {
      margin-top:28px; border-radius:20px; padding:36px 40px; color:#fff; position:relative; overflow:hidden;
      background:linear-gradient(135deg,var(--ps-gold) 0%,var(--ps-gold) 55%,var(--ps-gold-light) 100%);
      box-shadow:0 20px 40px -10px rgba(169,129,46,.4);
    }
    .ps-cta-band::before { content:''; position:absolute; top:-60px; right:-60px; width:260px; height:260px; border-radius:50%; background:rgba(255,255,255,.05); }
    .ps-cta-band::after  { content:''; position:absolute; bottom:-40px; left:30%; width:180px; height:180px; border-radius:50%; background:rgba(255,255,255,.03); }
    .ps-cta-head { font-size:24px; font-weight:800; letter-spacing:-.02em; margin-bottom:10px; position:relative; z-index:1; }
    .ps-cta-body { font-size:15px; opacity:.88; line-height:1.65; margin-bottom:22px; max-width:560px; position:relative; z-index:1; }
    .ps-cta-btns { display:flex; gap:12px; flex-wrap:wrap; position:relative; z-index:1; }
    .ps-cta-link {
      display:inline-flex; align-items:center; gap:8px; background:#fff; color:var(--ps-gold);
      font-weight:700; font-size:15px; padding:13px 24px; border-radius:11px; text-decoration:none;
      transition:transform .15s,box-shadow .15s; box-shadow:0 4px 14px rgba(0,0,0,.15);
    }
    .ps-cta-link:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(0,0,0,.2); }
    .ps-pdf-btn {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(255,255,255,.12); color:#fff; border:1.5px solid rgba(255,255,255,.3);
      font-weight:700; font-size:15px; padding:13px 24px; border-radius:11px; cursor:pointer;
      font-family:inherit; transition:background .15s,transform .15s;
    }
    .ps-pdf-btn:hover { background:rgba(255,255,255,.2); transform:translateY(-1px); }
    .ps-reset-btn { margin-top:20px; background:none; border:none; color:var(--ps-muted); font-size:13px; cursor:pointer; text-decoration:underline; padding:4px 0; font-family:inherit; }
    .ps-reset-btn:hover { color:var(--ps-slate); }

    /* CAPTURE PANEL */
    .ps-capture {
      background:var(--ps-card); border:1px solid var(--ps-line); border-radius:20px;
      padding:32px 36px; margin-top:28px; box-shadow:var(--ps-shadow-lg); border-left:4px solid var(--ps-gold);
    }
    .ps-capture-head { font-size:18px; font-weight:800; letter-spacing:-.02em; color:var(--ps-ink); margin-bottom:6px; }
    .ps-capture-sub { font-size:14px; color:var(--ps-slate); line-height:1.6; margin-bottom:22px; }
    .ps-capture-form { display:flex; flex-direction:column; gap:14px; }
    .ps-capture-row { display:flex; gap:14px; flex-wrap:wrap; }
    .ps-capture-field { display:flex; flex-direction:column; gap:5px; flex:1; min-width:180px; }
    .ps-capture-label { font-size:12px; font-weight:700; color:var(--ps-ink2); letter-spacing:.02em; }
    .ps-capture-input {
      padding:10px 14px; border-radius:9px; border:1.5px solid var(--ps-line);
      font-size:14px; font-family:inherit; color:var(--ps-ink); background:var(--ps-bg);
      transition:border-color .15s; outline:none;
    }
    .ps-capture-input:focus { border-color:var(--ps-gold); background:#fff; }
    .ps-capture-submit {
      display:inline-flex; align-items:center; gap:10px;
      background:var(--ps-gold); color:#fff; border:none; padding:12px 24px; border-radius:10px;
      font-size:14px; font-weight:700; cursor:pointer; font-family:inherit; transition:background .15s,transform .15s; align-self:flex-start;
    }
    .ps-capture-submit:hover { background:#8B6820; transform:translateY(-1px); }
    .ps-capture-note { font-size:12px; color:var(--ps-muted); margin-top:4px; line-height:1.5; }
    .ps-capture-sent { display:none; align-items:center; gap:10px; background:#F0FDF4; border:1px solid #86EFAC; border-radius:10px; padding:14px 18px; color:#166534; font-size:14px; font-weight:600; }
    .ps-capture-sent.show { display:flex; }

    /* PRINT VIEW */
    .ps-print-view { display:none; }
    @media print {
      body > *:not(.ps-print-view) { display:none !important; }
      .ps-print-view {
