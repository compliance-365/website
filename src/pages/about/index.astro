---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
---

<Base
  title="About Compliance365"
  description="Founded by Matt Nicholas, Compliance365 helps Australian organisations simplify cyber, privacy and AI governance with practical frameworks and automation."
>
  <Header />

  <!-- HERO INTRO — PERSONAL CREDIBILITY -->
  <section
    class="container section"
    style="max-width:820px;margin:0 auto;text-align:center;"
  >
    <!-- Profile Image -->
    <img
      src={`${base}assets/matt-profile.png`}
      alt="Matt Nicholas — Founder of Compliance365"
      style="
        width:240px;
        height:auto;
        border-radius:18px;
        margin:0 auto 24px auto;
        display:block;
        box-shadow:0 8px 30px rgba(0,0,0,.08);
      "
      loading="eager"
      decoding="async"
    />

    <!-- Name + Title -->
    <h1 style="margin-top:0;">Matt Nicholas</h1>
    <p class="muted" style="margin-top:-6px;">Founder — Compliance365</p>

    <!-- Badges -->
    <div
      style="
        display:flex;
        justify-content:center;
        gap:18px;
        margin:12px 0 22px;
        align-items:center;
        flex-wrap:wrap;
      "
    >
      <img
        src={`${base}assets/badges/cism.png`}
        alt="CISM Certified Information Security Manager"
        style="height:54px;width:auto;"
      />
      <img
        src={`${base}assets/badges/iso-27001-lead-auditor.png`}
        alt="ISO Lead Auditor"
        style="height:54px;width:auto;"
      />
    </div>

    <!-- Short founder bio -->
    <p class="muted" style="max-width:760px;margin:0 auto;">
      I help organisations simplify cyber, privacy and AI governance using practical frameworks and
      automation. After leading ISO 27001, ISO 27701 and ISO 42001 programs across multiple
      industries, I launched Compliance365 to give organisations a clearer, faster and more
      sustainable path to compliance.
    </p>
  </section>

  <!-- ABOUT COMPLIANCE365 -->
  <section class="container section">
    <h2>About Compliance365</h2>
    <p class="muted" style="max-width:760px">
      Compliance shouldn’t slow teams down. Certifications, assurance reviews and audit cycles
      should be repeatable, predictable and aligned with business outcomes — not a constant reset.
      Compliance365 helps organisations build security, privacy and AI governance that is
      practical, auditable and sustainable.
    </p>
  </section>

  <!-- OUR STORY -->
  <section class="container section">
    <div class="grid-2" style="align-items:center;gap:32px">
      <div>
        <h2>Our Story</h2>
        <p>
          Founded in Brisbane, <strong>Compliance365</strong> exists to remove the complexity that
          often comes with cyber, privacy and AI frameworks. Most organisations already have the
          right technology — what’s missing is the strategy, clarity and automation to connect
          people, process and platform.
        </p>
        <p>
          We help teams achieve readiness and certification across ISO&nbsp;27001, ISO&nbsp;27701,
          ISO&nbsp;42001, SOC&nbsp;2 and the Essential&nbsp;Eight, with evidence automated directly
          inside the customer’s environment.
        </p>
        <p>
          The outcome is a lean, auditable and scalable program that reduces manual work, shortens
          sales cycles, improves vendor confidence and strengthens organisational trust.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="container section">
    <h2>What we do</h2>
    <div class="grid-3" style="margin-top:16px">
      <div class="card feature">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
        </div>
        <h3>Cybersecurity</h3>
        <p class="muted">
          ISO&nbsp;27001, Essential Eight, SOC&nbsp;2 and DISP — control design, uplift and audit
          readiness.
        </p>
      </div>

      <div class="card feature">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none">
            <rect
              x="4"
              y="10"
              width="16"
              height="10"
              rx="2"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <path
              d="M8 10V7a4 4 0 1 1 8 0v3"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
        </div>
        <h3>Privacy</h3>
        <p class="muted">
          ISO&nbsp;27701, AU Privacy Act, GDPR — ROPA, DPIAs, consent workflows and third-party
          governance.
        </p>
      </div>

      <div class="card feature">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none">
            <rect
              x="7"
              y="7"
              width="10"
              height="10"
              rx="2"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <path
              d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M19 5l-2 2"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
        </div>
        <h3>AI Governance</h3>
        <p class="muted">
          ISO&nbsp;42001 — AI risk, model inventory, oversight, assurance and responsible AI
          controls.
        </p>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="container section">
    <h2>Our Values — PRIDE</h2>
    <div class="grid-3" style="margin-top:16px">
      <div class="card feature">
        <h3>P — Put the Customer First</h3>
        <p class="muted small">Frameworks tailored to your organisation — not generic templates.</p>
      </div>

      <div class="card feature">
        <h3>R — Reward Relationships</h3>
        <p class="muted small">
          Long-term partnerships built on trust, clarity and reliability.
        </p>
      </div>

      <div class="card feature">
        <h3>I — Inspire Trust</h3>
        <p class="muted small">
          Evidence-driven outcomes that auditors and stakeholders can rely on.
        </p>
      </div>

      <div class="card feature">
        <h3>D — Deliver with Excellence</h3>
        <p class="muted small">
          High-quality work, measurable outcomes and continuous improvement.
        </p>
      </div>

      <div class="card feature">
        <h3>E — Empower Simplicity</h3>
        <p class="muted small">
          Remove complexity so teams can focus on innovation, not admin.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="container section">
    <h2>How we work</h2>
    <p class="muted">A repeatable approach that keeps compliance simple, scalable and sustainable.</p>

    <div class="grid-4" style="margin-top:16px">
      <div class="card feature">
        <h3>Assess</h3>
        <p class="muted small">Risk, gaps, roadmap and priorities.</p>
      </div>
      <div class="card feature">
        <h3>Implement</h3>
        <p class="muted small">Controls, workflows, policies and automation.</p>
      </div>
      <div class="card feature">
        <h3>Assure</h3>
        <p class="muted small">Evidence, internal audit and assessor support.</p>
      </div>
      <div class="card feature">
        <h3>Improve</h3>
        <p class="muted small">Metrics, reviews and continuous uplift.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container section">
    <div class="card" style="text-align:center;padding:40px;border-radius:22px">
      <h2>Ready to simplify compliance?</h2>
      <p class="muted">
        Book a roadmap call — we’ll map your fastest path and automate the evidence.
      </p>
      <a href={ctaUrl} class="btn btn-primary" style="margin-top:8px">
        Book a consultation
      </a>
    </div>
  </section>

  <Footer />
</Base>
