---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReadinessChecklist from '../../components/ReadinessChecklist.astro';

const base = import.meta.env.BASE_URL || '/';
---
<Base
  title="Free Compliance Readiness Checklist — ISO 27001, ISO 27701 & ISO 42001 | Compliance365"
  description="Take our free 10-question readiness assessment for ISO 27001, ISO 27701, or ISO 42001. Get an instant maturity score and a downloadable PDF report showing exactly what to fix before your audit."
>
  <Header />
  <section class="container section">
    <p style="font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:#1e40af;margin:0 0 .75rem;">Free Tool</p>
    <h1>Interactive Compliance Readiness Checklist</h1>
    <p class="muted" style="max-width:720px">
      Choose a framework below, answer 10 quick questions about your current controls and documentation, and get an instant readiness score with a downloadable PDF report you can share with your leadership team or auditor.
    </p>
  </section>

  <ReadinessChecklist />

  <!-- Why this matters -->
  <section class="section" style="background:#f8fafc;">
    <div class="container" style="max-width:860px;">
      <h2>Why a readiness assessment matters</h2>
      <p class="muted">
        Most certification timelines slip not because the framework is complex, but because gaps are discovered late — during the Stage 1 audit instead of months earlier when there's time to fix them. A readiness assessment gives you an honest baseline before you commit to an audit date.
      </p>
      <p class="muted">
        This checklist mirrors the questions an auditor or experienced consultant would ask in a scoping call: do you have a documented ISMS scope, risk register, access control policy, incident response plan, and evidence of management review? Your score highlights where you're audit-ready and where work is still needed.
      </p>

      <h2 style="margin-top:2.5rem;">What you'll get</h2>
      <ul class="muted" style="line-height:2;">
        <li>An instant percentage score across the 10 core readiness areas</li>
        <li>A downloadable PDF report you can share internally or with your board</li>
        <li>A clear view of which controls are in place, partial, or missing</li>
        <li>A realistic starting point for scoping your certification timeline</li>
      </ul>

      <h2 style="margin-top:2.5rem;">Go deeper with a framework-specific checklist</h2>
      <p class="muted">
        Prefer a more detailed walkthrough for a specific framework? Our dedicated checklists cover each standard's requirements in more depth:
      </p>
      <div class="grid-3" style="margin-top:1.5rem;">
        <a href={`${base}checklist/iso27001/`} class="card" style="text-decoration:none;color:inherit;">
          <h3 style="margin:0 0 .5rem;font-size:1rem;">ISO 27001 Checklist</h3>
          <p class="muted small" style="margin:0;">Information security management readiness</p>
        </a>
        <a href={`${base}checklist/iso27701/`} class="card" style="text-decoration:none;color:inherit;">
          <h3 style="margin:0 0 .5rem;font-size:1rem;">ISO 27701 Checklist</h3>
          <p class="muted small" style="margin:0;">Privacy information management readiness</p>
        </a>
        <a href={`${base}checklist/iso42001/`} class="card" style="text-decoration:none;color:inherit;">
          <h3 style="margin:0 0 .5rem;font-size:1rem;">ISO 42001 Checklist</h3>
          <p class="muted small" style="margin:0;">AI management system readiness</p>
        </a>
        <a href={`${base}checklist/soc2/`} class="card" style="text-decoration:none;color:inherit;">
          <h3 style="margin:0 0 .5rem;font-size:1rem;">SOC 2 Checklist</h3>
          <p class="muted small" style="margin:0;">Trust Service Criteria readiness</p>
        </a>
        <a href={`${base}checklist/essential-eight/`} class="card" style="text-decoration:none;color:inherit;">
          <h3 style="margin:0 0 .5rem;font-size:1rem;">Essential Eight Checklist</h3>
          <p class="muted small" style="margin:0;">ASD maturity level readiness</p>
        </a>
        <a href={`${base}checklist/disp-ism-irap/`} class="card" style="text-decoration:none;color:inherit;">
          <h3 style="margin:0 0 .5rem;font-size:1rem;">DISP / ISM / IRAP Checklist</h3>
          <p class="muted small" style="margin:0;">Defence security readiness</p>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
