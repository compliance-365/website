---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
---

<Base
  title="About Compliance365 — Simplifying Cyber, Privacy & AI Governance"
  description="We help Australian SaaS, tech, healthcare and finance teams achieve fast, defensible compliance without disruption or new tools."
>
  <Header />

  <!-- HERO POSITIONING -->
  <section class="hero-wrap">
    <div class="container">
      <div class="section-head center">
        <h1>Built to make compliance simpler, faster and trusted</h1>
        <p class="section-lead muted">
          Compliance365 turns cyber, privacy and AI governance into a repeatable system — not a painful project.
        </p>

        <div class="pill-row" style="margin:2rem 0;">
          <a href={`${base}services/iso27001`} class="pill">Cyber</a>
          <a href={`${base}services/iso27701`} class="pill">Privacy</a>
          <a href={`${base}services/iso42001`} class="pill">AI Governance</a>
          <a href={`${base}services/soc2`} class="pill">SOC 2</a>
          <a href={`${base}services/essential-eight`} class="pill">Essential Eight</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY WE EXIST / OUR STORY -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h2>Why Compliance365 Exists</h2>
          <p class="muted">
            Compliance too often feels broken — slow, expensive, disruptive, and disconnected from real business needs.
          </p>
          <p class="muted">
            We’ve seen the same pattern across fast-growing SaaS, tech, and regulated organisations in Australia:
          </p>
          <ul class="muted small" style="padding-left:1.5rem;margin:1.2rem 0;list-style:none;">
            <li>• Over-scoped audits that never seem to end</li>
            <li>• Generic templates that don’t reflect reality</li>
            <li>• New tools pushed as “mandatory”</li>
            <li>• Long timelines that stall deals</li>
            <li>• High costs that drain resources</li>
            <li>• Burnt-out teams chasing evidence</li>
          </ul>
          <p class="muted">
            The truth? Most organisations already have most of what they need. What’s missing is a clear, defensible way to turn existing reality into proof that auditors, customers, and procurement teams can trust — without the chaos.
          </p>
          <p class="muted">
            At Compliance365, we stripped compliance back to what actually matters: what auditors really look for, what evidence genuinely proves control, and what minimum viable remediation looks like without gold-plating or disruption.
          </p>
          <p class="muted">
            That consistent, repeatable approach became ComplianceReady™ — delivering faster audits, lower cost, and far less friction.
          </p>
          <p class="muted" style="font-weight:600;margin-top:1.5rem;">
            You shouldn’t have to choose between growth and doing the right thing.
          </p>
        </div>

        <div>
          <img
            src="/assets/about.png"
            alt="Compliance365 delivering fast, trusted compliance for Australian teams"
            class="cover-img"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE HELP YOU ACHIEVE -->
  <section class="section">
    <div class="container">
      <h2 class="center">What We Help You Achieve</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <circle cx="12" cy="9" r="3" />
            </svg>
          </div>
          <h3>Cybersecurity</h3>
          <p class="muted">
            ISO 27001, Essential Eight, SOC 2, DISP — practical controls, fast uplift and audit-ready evidence.
          </p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="4" width="16" height="16" rx="2" />
              <path d="M12 8v8M8 12h8" />
            </svg>
          </div>
          <h3>Privacy</h3>
          <p class="muted">
            ISO 27701, Australian Privacy Act — DPIAs, ROPAs, consent, third-party risk — all streamlined.
          </p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
          </div>
          <h3>AI Governance</h3>
          <p class="muted">
            ISO 42001 — responsible AI, risk assessment, model inventory, oversight and assurance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES - PRIDE with icons (full set, customer-focused) -->
<section class="section">
  <div class="container">
    <h2 class="center">Our Values — PRIDE</h2>
    <p class="section-lead muted center" style="max-width:760px;margin:1.5rem auto;">
      At Compliance365, we believe compliance should protect growth, not slow it down. Our core values guide everything we do to eliminate the fears that kill deals and deliver the confidence your team needs.
    </p>

    <div class="grid-3" style="margin-top:3rem;">
      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 8v8" />
          </svg>
        </div>
        <h3>P — Put the Customer First</h3>
        <p class="muted small">
          We start with your biggest fears — lost deals, high-risk labels, last-minute scrambles — and build tailored solutions that turn compliance into a deal accelerator, not a blocker.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <path d="M12 6v12" />
          </svg>
        </div>
        <h3>R — Reward Relationships</h3>
        <p class="muted small">
          Long-term trust matters. We deliver clear, defensible answers that procurement and auditors love, so you can move through gates faster and build stronger partnerships — without the chaos.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M2 12h20" />
          </svg>
        </div>
        <h3>I — Inspire Trust</h3>
        <p class="muted small">
          We give you instant confidence when customers ask hard questions — with clean, reusable evidence that stands up to scrutiny and turns “high risk” into “trusted partner.”
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h3>D — Deliver with Excellence</h3>
        <p class="muted small">
          No shortcuts, no surprises. We focus on real auditor expectations and high-quality outcomes — so you get audit-ready compliance fast, without months of delays.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h3>E — Empower Simplicity</h3>
        <p class="muted small">
          We remove complexity so your team stays calm and focused on growth — not spreadsheets, tribal knowledge, or endless fire drills.
        </p>
      </div>
    </div>
  </div>
</section>

  <!-- FINAL CTA - Exact same blue style as Home page -->
  <section class="final-cta" style="background:var(--primary); color:white; text-align:center; padding:8rem 0;">
    <div class="container">
      <h2>Trusted by teams in Government, Healthcare SaaS, and Technology</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        Book a free 30-minute call — we’ll show you how to get audit-ready fast, close more deals, and avoid months of delays.
      </p>

      <div class="final-buttons" style="display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap; margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white; color:var(--primary); font-size:1.25rem; padding:1.2rem 2.8rem;">
          Book Free Call Now
        </a>
        <a href={`${base}checklist/`} class="btn btn-outline large" style="color:white; border-color:white; font-size:1.25rem; padding:1.2rem 2.8rem;">
          Get Your Free Readiness Score
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem; color:rgba(255,255,255,0.8);">
        Limited spots available — most teams see results in under 4 weeks.
      </p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* === On-brand icons styling (same as Home) ================= */
  .icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.2rem;
    background: linear-gradient(135deg, rgba(30,64,175,0.12), rgba(30,58,138,0.08));
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--primary);
    border: 2px solid var(--primary);
  }

  .icon svg {
    width: 36px;
    height: 36px;
    stroke-width: 2.2;
  }

  .card.feature.center {
    text-align: center;
  }

  .section-head.center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .section-lead {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-top: 1rem;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin: 1.5rem 0;
  }

  .cover-img {
    width: 100%;
    border-radius: 1rem;
    box-shadow: 0 20px 60px -20px rgba(0,0,0,0.12);
  }

  @media (max-width: 980px) {
    .grid-3, .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
