---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL || '/';
---
<Base
  title="Cookie Policy — Compliance365"
  description="How Compliance365 uses cookies. We use Google Analytics and Microsoft Clarity for site analytics only — no advertising or personalisation cookies. Manage your preferences here."
  robots="index,follow"
>
  <Header />

  <section class="section" style="background:#FAF7F1;">
    <div class="container" style="max-width:860px;">
      <p style="font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:#A9812E;margin:0 0 .75rem;">Privacy & Cookies</p>
      <h1>Cookie Policy</h1>
      <p class="muted" style="max-width:680px;">
        We keep our cookie use minimal. This page explains what cookies we use, why, and how to control them.
        Last updated: May 2026.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:860px;">

      <!-- Preferences card -->
      <div class="card" style="border-left:4px solid #A9812E;margin-bottom:3rem;">
        <h2 style="margin:0 0 .5rem;">Your cookie preferences</h2>
        <p class="muted small" style="margin:0 0 1.25rem;">
          Strictly necessary cookies cannot be disabled — they make the site work. You can opt out of analytics cookies below at any time.
        </p>

        <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#FAF7F1;border-radius:8px;padding:12px 16px;">
            <div>
              <strong style="font-size:.9rem;">Strictly necessary</strong>
              <p class="muted small" style="margin:.2rem 0 0;">Required for the site to function. Cannot be disabled.</p>
            </div>
            <span style="font-size:.75rem;font-weight:700;color:#166534;background:#f0fdf4;border:1px solid #86efac;padding:3px 10px;border-radius:999px;">Always on</span>
          </div>

          <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#FAF7F1;border-radius:8px;padding:12px 16px;">
            <div>
              <strong style="font-size:.9rem;">Analytics cookies</strong>
              <p class="muted small" style="margin:.2rem 0 0;">Google Analytics & Microsoft Clarity — help us understand how visitors use the site. No personal data is shared with advertisers.</p>
            </div>
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;flex-shrink:0;">
              <input id="analyticsToggle" type="checkbox" style="width:18px;height:18px;cursor:pointer;" />
              <span class="muted small" id="toggleLabel">Off</span>
            </label>
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
          <button id="saveBtn" class="btn btn-primary">Save preferences</button>
          <button id="acceptAllBtn" class="btn" style="background:#f0fdf4;color:#166534;border:1.5px solid #86efac;">Accept all</button>
          <button id="rejectAllBtn" class="btn" style="background:#FAF7F1;color:#6B6860;border:1.5px solid #DDD8CF;">Reject analytics</button>
        </div>

        <div id="saveConfirm" style="display:none;margin-top:1rem;padding:10px 14px;background:#f0fdf4;border-radius:8px;color:#166534;font-size:.875rem;font-weight:600;">
          ✓ Preferences saved.
        </div>
      </div>

      <!-- What are cookies -->
      <h2>What are cookies?</h2>
      <p class="muted">
        Cookies are small text files stored on your device when you visit a website. They help sites remember your preferences and understand how people use the site. We only use cookies that are necessary to operate the site or to improve it through anonymised analytics.
      </p>

      <!-- Cookie table -->
      <h2 style="margin-top:2.5rem;">Cookies we use</h2>

      <div style="overflow-x:auto;margin-top:1rem;">
        <table style="width:100%;border-collapse:collapse;font-size:.875rem;">
          <thead>
            <tr style="background:#F5F0E8;text-align:left;">
              <th style="padding:10px 14px;font-weight:600;color:#374151;border-bottom:1px solid #DDD8CF;">Cookie</th>
              <th style="padding:10px 14px;font-weight:600;color:#374151;border-bottom:1px solid #DDD8CF;">Provider</th>
              <th style="padding:10px 14px;font-weight:600;color:#374151;border-bottom:1px solid #DDD8CF;">Purpose</th>
              <th style="padding:10px 14px;font-weight:600;color:#374151;border-bottom:1px solid #DDD8CF;">Category</th>
              <th style="padding:10px 14px;font-weight:600;color:#374151;border-bottom:1px solid #DDD8CF;">Expires</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid #F5F0E8;">
              <td style="padding:10px 14px;color:#0B0B0C;font-weight:500;">c365_consent</td>
              <td style="padding:10px 14px;color:#374151;">Compliance365</td>
              <td style="padding:10px 14px;color:#374151;">Stores your cookie consent preferences</td>
              <td style="padding:10px 14px;"><span style="background:#f0fdf4;color:#166534;border:1px solid #86efac;border-radius:999px;padding:2px 8px;font-size:.75rem;font-weight:700;">Necessary</span></td>
              <td style="padding:10px 14px;color:#374151;">1 year</td>
            </tr>
            <tr style="border-bottom:1px solid #F5F0E8;background:#fafafa;">
              <td style="padding:10px 14px;color:#0B0B0C;font-weight:500;">_ga, _ga_*</td>
              <td style="padding:10px 14px;color:#374151;">Google Analytics</td>
              <td style="padding:10px 14px;color:#374151;">Counts page visits and traffic sources to understand site performance</td>
              <td style="padding:10px 14px;"><span style="background:rgba(169,129,46,0.06);color:#7A5C1E;border:1px solid rgba(169,129,46,0.2);border-radius:999px;padding:2px 8px;font-size:.75rem;font-weight:700;">Analytics</span></td>
              <td style="padding:10px 14px;color:#374151;">2 years</td>
            </tr>
            <tr style="border-bottom:1px solid #F5F0E8;">
              <td style="padding:10px 14px;color:#0B0B0C;font-weight:500;">_clck, _clsk</td>
              <td style="padding:10px 14px;color:#374151;">Microsoft Clarity</td>
              <td style="padding:10px 14px;color:#374151;">Records anonymised session data to identify usability issues</td>
              <td style="padding:10px 14px;"><span style="background:rgba(169,129,46,0.06);color:#7A5C1E;border:1px solid rgba(169,129,46,0.2);border-radius:999px;padding:2px 8px;font-size:.75rem;font-weight:700;">Analytics</span></td>
              <td style="padding:10px 14px;color:#374151;">1 year / session</td>
            </tr>
            <tr style="border-bottom:1px solid #F5F0E8;background:#fafafa;">
              <td style="padding:10px 14px;color:#0B0B0C;font-weight:500;">apollo_*</td>
              <td style="padding:10px 14px;color:#374151;">Apollo.io</td>
              <td style="padding:10px 14px;color:#374151;">Identifies the organisation visiting the site (company-level, not individual) to help us understand which businesses are interested in our services</td>
              <td style="padding:10px 14px;"><span style="background:#f0fdf4;color:#166534;border:1px solid #86efac;border-radius:999px;padding:2px 8px;font-size:.75rem;font-weight:700;">Necessary</span></td>
              <td style="padding:10px 14px;color:#374151;">Session</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- No ad cookies -->
      <div style="background:#f0fdf4;border-left:4px solid #16a34a;border-radius:0 8px 8px 0;padding:16px 20px;margin:2rem 0;">
        <strong style="color:#166534;">We do not use advertising or personalisation cookies.</strong>
        <p class="muted small" style="margin:.4rem 0 0;">No data is shared with ad networks. No cross-site tracking. No profiling.</p>
      </div>

      <!-- Third parties -->
      <h2 style="margin-top:2.5rem;">Third-party services</h2>
      <p class="muted">
        Google Analytics and Microsoft Clarity process anonymised usage data on their own infrastructure. Both are configured with IP anonymisation enabled. You can review their privacy policies directly:
      </p>
      <ul class="muted" style="margin-top:.75rem;line-height:2;">
        <li><a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google Privacy Policy</a></li>
        <li><a href="https://privacy.microsoft.com/en-us/privacystatement" target="_blank" rel="noopener">Microsoft Privacy Statement</a></li>
      </ul>

      <!-- Contact -->
      <h2 style="margin-top:2.5rem;">Questions?</h2>
      <p class="muted">
        If you have questions about how we handle your data, see our <a href={`${base}privacy/`}>Privacy Policy</a> or <a href={`${base}contact/`}>contact us</a> directly.
      </p>

    </div>
  </section>

  <Footer />

  <script is:inline>
    var CONSENT_KEY = 'c365_consent';
    var toggle = document.getElementById('analyticsToggle');
    var toggleLabel = document.getElementById('toggleLabel');
    var confirmEl = document.getElementById('saveConfirm');

    function loadSaved() {
      try {
        var saved = JSON.parse(localStorage.getItem(CONSENT_KEY));
        if (saved) {
          var granted = saved.analytics_storage === 'granted';
          toggle.checked = granted;
          toggleLabel.textContent = granted ? 'On' : 'Off';
        }
      } catch(_) {}
    }

    toggle.addEventListener('change', function() {
      toggleLabel.textContent = toggle.checked ? 'On' : 'Off';
    });

    function saveConsent(analyticsGranted) {
      // Delegate to CookieBanner's consent manager (handles gtag update + Clarity)
      if (window.__c365Consent) {
        window.__c365Consent.save(analyticsGranted);
      } else {
        var consent = {
          ad_user_data: 'denied', ad_personalization: 'denied', ad_storage: 'denied',
          analytics_storage: analyticsGranted ? 'granted' : 'denied',
          functionality_storage: 'granted', security_storage: 'granted'
        };
        localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
        if (window.gtag) window.gtag('consent', 'update', consent);
      }
      toggle.checked = analyticsGranted;
      toggleLabel.textContent = analyticsGranted ? 'On' : 'Off';
      confirmEl.style.display = 'block';
      setTimeout(function() { confirmEl.style.display = 'none'; }, 3000);
    }

    document.getElementById('saveBtn').addEventListener('click', function() { saveConsent(toggle.checked); });
    document.getElementById('acceptAllBtn').addEventListener('click', function() { saveConsent(true); });
    document.getElementById('rejectAllBtn').addEventListener('click', function() { saveConsent(false); });

    loadSaved();
  </script>
</Base>
