---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'DISP, ISM & IRAP (Defence Security)';

const QUESTIONS = [
  { id:'disp-scope',   label:'DISP scope & membership categories selected (Gov, Info, Personnel, Physical)?' },
  { id:'security-off', label:'Security officer & governance forums appointed with reporting to executives?' },
  { id:'pspf',         label:'PSPF alignment assessed; gaps and remediation actions logged?' },
  { id:'ism-baseline', label:'ISM baseline controls selected per system classification & context?' },
  { id:'clearance',    label:'Personnel screening/clearances completed for roles handling sensitive info?' },
  { id:'facility',     label:'Physical security/facility controls assessed (zones, alarms, storage, escorts)?' },
  { id:'iat',          label:'ICT security: hardening, patching, malware protection and configuration baselines?' },
  { id:'system-desc',  label:'System boundary/topology documented (diagrams, data flows, dependencies)?' },
  { id:'ssp',          label:'System Security Plan (SSP) completed with control implementations & responsibilities?' },
  { id:'srmp',         label:'Security Risk Management Plan (SRMP) with threat assessment and treatments?' },
  { id:'scoping',      label:'Assessment scope agreed with IRAP assessor (assets, sites, accounts, periods)?' },
  { id:'vuln',         label:'Vulnerability management (scanning cadence, remediation SLAs, evidence)?' },
  { id:'logging',      label:'Centralised logging & monitoring with retention aligned to ISM requirements?' },
  { id:'backup-dr',    label:'Backups/BCP/DR aligned to classification with periodic restoration tests?' },
  { id:'crypto',       label:'Approved cryptography used; key management procedures documented?' },
  { id:'evidence',     label:'Evidence register prepared for IRAP (samples, screenshots, exports)?' },
  { id:'poam',         label:'Plan of Actions & Milestones (POA&M) maintained and tracked to closure?' },
  { id:'contracts',    label:'Contracts/subcontractors include security obligations and sovereign hosting (if required)?' }
];
---

<Base title="DISP / ISM / IRAP Readiness Checklist" description="Answer quick questions, get an instant score and a downloadable PDF.">
  <Header />

  <section class="container section">
    <h1>{STANDARD} Readiness Checklist</h1>

    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill" aria-current="page">DISP / ISM / IRAP</a>
    </div>

    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:14px;">
        {QUESTIONS.map((q, i) => (
          <div class="field" data-id={q.id} style="padding:10px 12px;border:1px solid rgba(10,18,32,.08);border-radius:12px">
            <label style="display:block;font-weight:800;margin:0 0 8px;">{i + 1}. {q.label}</label>
            <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="opt pill" data-v="2" type="button">Yes</button>
              <button class="opt pill" data-v="1" type="button">Partial</button>
              <button class="opt pill" data-v="0" type="button">No</button>
            </div>
          </div>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
  const STANDARD  = "DISP / ISM / IRAP";
  const QUESTIONS = [
    { id:'disp-scope', label:'DISP membership level and obligations confirmed with roles assigned?' },
    { id:'ism-align', label:'ISM control alignment assessed with remediation plan?' },
    { id:'info-class', label:'Information classification & handling aligned to ISM/Defence requirements?' },
    { id:'personnel', label:'Personnel checks, clearances and vetting where required?' },
    { id:'physical', label:'Physical security (zones, storage, visitor controls) appropriate?' },
    { id:'tech-controls', label:'Technical controls operating (logging, hardening, patching, backups)?' },
    { id:'irap-prep', label:'IRAP approach defined (scope, assessor, evidence packs, timeline)?' },
    { id:'evidence', label:'SharePoint evidence and approvals captured for audit readiness?' }
  ];

  (function init(){(document.readyState==='loading')?document.addEventListener('DOMContentLoaded',setup):setup();})();
  function setup(){
    const form=document.getElementById('form'), bar=document.getElementById('bar');
    const scoreNum=document.getElementById('scoreNum'), scoreLabel=document.getElementById('scoreLabel'), scoreHint=document.getElementById('scoreHint');
    const resetBtn=document.getElementById('resetBtn'), pdfBtn=document.getElementById('pdfBtn');
    const state=Object.fromEntries(QUESTIONS.map(q=>[q.id,null]));

    form.addEventListener('click',(e)=>{const btn=e.target.closest('button.opt'); if(!btn) return;
      const field=btn.closest('.field'); const id=field.dataset.id; state[id]=Number(btn.dataset.v);
      field.querySelectorAll('button.opt').forEach(o=>o.classList.remove('active')); btn.classList.add('active'); update();});

    resetBtn.addEventListener('click',()=>{Object.keys(state).forEach(k=>state[k]=null); document.querySelectorAll('button.opt.active').forEach(o=>o.classList.remove('active')); update();});
    pdfBtn.addEventListener('click',()=>{const {answered}=compute(); if(answered<QUESTIONS.length){alert('Please answer all questions first.');return;} generatePDF(state);});

    function compute(){const answered=Object.values(state).filter(v=>v!==null).length;
      const scoreRaw=Object.values(state).reduce((a,v)=>a+(v??0),0);
      const score=Math.round((scoreRaw/(Object.keys(state).length*2))*100); return {answered,score:isNaN(score)?0:score};}
    function update(){const {answered,score}=compute(); const pct=Math.round((answered/Object.keys(state).length)*100);
      bar.style.width=pct+'%'; scoreNum.textContent=`${score}%`;
      let label='Not started', hint='Answer the questions to see your readiness.';
      if(answered>0 && score<40){label='Early stage'; hint='Start with DISP scope and ISM gap.';}
      else if(score<70){label='In progress'; hint='Harden personnel/physical and technical controls.';}
      else if(score<90){label='Nearly ready'; hint='IRAP preparation and evidence cadences.';}
      else {label='Assessment-ready'; hint='You look ready for an IRAP engagement.';}
      scoreLabel.textContent=label; scoreHint.textContent=hint;}
    function generatePDF(state){const { jsPDF }=window.jspdf||{}; if(!jsPDF){alert('PDF library not loaded.'); return;}
      const doc=new jsPDF(); let y=20; doc.setFillColor(79,70,229); doc.rect(0,0,210,20,'F'); doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(14); doc.text("Compliance365 Readiness Checklist",14,14);
      doc.setTextColor(0,0,0); doc.setFont('helvetica','bold'); doc.setFontSize(16); y+=20; doc.text(`${STANDARD} — Readiness Summary`,14,y); y+=10;
      const {score,answered}=compute(); doc.setFont('helvetica','normal'); doc.setFontSize(12); doc.text(`Score: ${score}% • Answered ${answered}/${QUESTIONS.length}`,14,y); y+=10;
      doc.setDrawColor(200,200,200); doc.line(14,y,196,y); y+=10;
      QUESTIONS.forEach((q,i)=>{const v=state[q.id]; const label=v===2?'Yes':v===1?'Partial':v===0?'No':'—';
        if(y>270){doc.addPage(); y=20;} doc.setFontSize(11); doc.text(`${i+1}. ${q.label}`,14,y);
        doc.setFont('helvetica','bold'); doc.text(label,180,y,{align:'right'}); doc.setFont('helvetica','normal'); y+=8;});
      doc.setFontSize(10); doc.setTextColor(100); y=285; doc.text("Generated with Compliance365 — www.compliance365.com.au",14,y);
      doc.save('disp_ism_irap_readiness.pdf');}
    const s=document.createElement('style'); s.textContent=`button.opt{cursor:pointer}button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`; document.head.appendChild(s); update();
  }
  </script>
</Base>
