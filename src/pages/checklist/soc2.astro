---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'SOC 2 (Trust Services Criteria)';

const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–99','100–499','500–1 999','2 000+'] },
  { id: 'trigger',      label: 'What is driving this assessment?',     type: 'select', required: true,  options: ['Customer or enterprise requirement','Investor or board mandate','Regulatory obligation','Preparing for SOC 2 Type 1','Preparing for SOC 2 Type 2','Renewing an existing SOC 2 report','Other'] },
  { id: 'report-type',  label: 'Target report type',                   type: 'select', required: false, options: ['Not yet decided','Type 1 (point-in-time)','Type 2 (period of time — 6–12 months)'] },
  { id: 'timeline',     label: 'Target timeline',                      type: 'select', required: false, options: ['Not yet decided','Within 6 months','6–12 months','12–18 months','18+ months'] },
];

const QUESTIONS = [
  // Governance & Scope
  {
    id: 'scope',
    group: 'gov',
    label: 'Our system boundary and in-scope services are clearly defined and documented for the SOC 2 system description.',
    hint: 'The system description is the foundation of a SOC 2 report — auditors will check it closely.',
    examples: [
      'A system description defining in-scope products, services, infrastructure and data flows.',
      'Clear inclusions and exclusions (e.g. production systems in scope; internal test labs excluded).',
      'Boundary diagrams showing users, systems, third parties and data movement.'
    ]
  },
  {
    id: 'governance',
    group: 'gov',
    label: 'Board or management actively oversees security and compliance — evidenced by charters and meeting minutes.',
    hint: 'Active leadership oversight is a foundational SOC 2 common criteria requirement.',
    examples: [
      'A security or risk committee charter approved by the board or executive team.',
      'Meeting minutes showing review of incidents, risks and audit readiness.',
      'Assigned executive accountability for SOC 2 compliance.'
    ]
  },
  {
    id: 'policies',
    group: 'gov',
    label: 'Security policies and standards are approved, communicated to staff and reviewed at least annually.',
    hint: 'Policies must be current, approved and demonstrably communicated — not just written.',
    examples: [
      'Approved security, access control, incident response and change management policies.',
      'Version control with review and approval dates documented.',
      'Evidence of staff communication or acknowledgement (training, intranet, onboarding).'
    ]
  },

  // TSC Mapping & Risk
  {
    id: 'tsc-map',
    group: 'tsc',
    label: 'Controls are mapped to the applicable Trust Services Criteria (CC1–CC9 plus any selected attribute criteria) with clear rationale.',
    hint: 'Auditors expect traceability from each control to the applicable Trust Services Criteria.',
    examples: [
      'A control matrix mapping controls to CC1–CC9 and any selected Availability, Confidentiality, Processing Integrity or Privacy criteria.',
      'Written rationale explaining why criteria are in or out of scope.',
      'Consistent naming between policies, procedures and control descriptions.'
    ]
  },
  {
    id: 'risk',
    group: 'tsc',
    label: 'A risk assessment has been performed and risks are linked to specific controls and monitoring activities.',
    hint: 'Risk assessment should drive control selection and monitoring focus for SOC 2.',
    examples: [
      'Documented risk assessment covering security, availability and processing risks.',
      'Risks linked to specific SOC 2 controls with owners and treatment plans.',
      'Monitoring or KPIs aligned to high-risk areas reviewed at defined cadences.'
    ]
  },

  // Controls & Operations
  {
    id: 'change',
    group: 'ops',
    label: 'Change management includes approvals, testing, rollback procedures and separation of duties where feasible.',
    hint: 'SOC 2 auditors sample change records — they need to show authorisation, testing and recoverability.',
    examples: [
      'Change tickets with approvals, test evidence and rollback plans.',
      'Separation of duties between development and production deployment.',
      'Emergency change procedure with post-implementation review records.'
    ]
  },
  {
    id: 'access',
    group: 'ops',
    label: 'Access is provisioned on least privilege, reviewed periodically and recertified — with a joiners/movers/leavers process.',
    hint: 'Access controls are heavily sampled in SOC 2 Type 2 — expect auditors to pull JML records.',
    examples: [
      'Joiner/mover/leaver process with documented approvals for each event.',
      'Quarterly or semi-annual access reviews for critical systems.',
      'Privileged access controls including MFA, separate admin accounts and logging.'
    ]
  },
  {
    id: 'proc-int',
    group: 'ops',
    label: 'Processing integrity is ensured through SDLC gates, peer review and automated testing.',
    hint: 'Systems must process data accurately, completely and as authorised.',
    examples: [
      'SDLC stages with mandatory peer review and testing requirements.',
      'Automated tests validating data accuracy, completeness and integrity.',
      'Defect tracking and resolution records retained.'
    ]
  },
  {
    id: 'vendor',
    group: 'ops',
    label: 'Third-party and subprocessor risks are assessed at onboarding and monitored on an ongoing basis with contractual controls in place.',
    hint: 'SOC 2 requires you to manage risk introduced by vendors who access or process your systems.',
    examples: [
      'Vendor risk assessments based on criticality and data access before onboarding.',
      'Contracts including security, confidentiality and incident notification clauses.',
      'Ongoing monitoring via SOC reports, certifications or performance reviews.'
    ]
  },

  // Logging, Incidents & Evidence
  {
    id: 'logging',
    group: 'mon',
    label: 'Key security events are centrally logged and monitored, with alerts linked to tickets and reviewed at a defined cadence.',
    hint: 'Monitoring must demonstrate timely detection and response to security events.',
    examples: [
      'Centralised logging for identity, infrastructure and application events.',
      'Alerts integrated with ticketing or incident management tools.',
      'Evidence of alert review and response at defined intervals.'
    ]
  },
  {
    id: 'incident',
    group: 'mon',
    label: 'An incident response plan exists, has been tested through exercises, and post-incident reviews drive corrective actions.',
    hint: 'Preparedness and learning from incidents is a key SOC 2 common criteria expectation.',
    examples: [
      'Incident response plan with defined roles, severity levels and escalation paths.',
      'Tabletop or simulated incident exercises conducted at least annually.',
      'Post-incident reviews with corrective actions tracked to verified closure.'
    ]
  },
  {
    id: 'evidence',
    group: 'mon',
    label: 'Evidence is catalogued in a central library with a defined sampling cadence and retention policy.',
    hint: 'Type 2 auditors sample evidence across the audit period — it must be organised and retrievable.',
    examples: [
      'An evidence library in SharePoint with folder structure aligned to controls.',
      'Defined sampling cadence (monthly, quarterly) for continuous evidence collection.',
      'Retention and versioning enabled for all audit artefacts.'
    ]
  },

  // Attribute Criteria
  {
    id: 'availability',
    group: 'attr',
    label: 'Availability controls are in place — including capacity monitoring, redundancy and tested disaster recovery with RTO/RPO evidence.',
    hint: 'If Availability is in scope, auditors will look for both architecture and tested recovery evidence.',
    examples: [
      'Capacity and performance monitoring reports covering production systems.',
      'Redundancy architecture diagrams showing failover capability.',
      'Disaster recovery or backup restore test evidence demonstrating RTO/RPO is met.'
    ]
  },
  {
    id: 'confidential',
    group: 'attr',
    label: 'Confidentiality controls cover encryption at rest and in transit, with documented key management procedures.',
    hint: 'Sensitive data must be protected throughout its lifecycle — encryption configuration is sampled.',
    examples: [
      'Documented encryption standards for data at rest and in transit.',
      'Key management procedures including access controls and rotation schedules.',
      'Evidence of encryption configuration in production systems.'
    ]
  },
  {
    id: 'privacy',
    group: 'attr',
    label: 'If Privacy criteria are in scope, we have a privacy notice, a process for handling data subject requests and defined retention and disposal procedures.',
    hint: 'Privacy criteria require evidence of notice, consent handling and individual rights management.',
    examples: [
      'Published privacy notice describing data use, rights and contact details.',
      'Process for handling data subject access, deletion and correction requests.',
      'Documented retention schedules and secure disposal procedures.'
    ]
  },

  // Audit Readiness
  {
    id: 'type',
    group: 'audit',
    label: 'The audit type (Type 1 or Type 2), reporting period, population and sampling windows have been agreed with the auditor.',
    hint: 'Clear planning aligned with your auditor reduces delays and scope disputes.',
    examples: [
      'Defined audit type (Type 1 or Type 2) and agreed reporting period.',
      'Agreed population and sampling approach documented with the auditor.',
      'Audit readiness checklist and milestone timeline prepared.'
    ]
  },
];

const GROUPS = [
  { key: 'gov',   title: 'Governance & Scope',            icon: '🏛️', blurb: 'System boundary, leadership oversight and approved policies.' },
  { key: 'tsc',   title: 'TSC Mapping & Risk',            icon: '🗺️', blurb: 'Control mapping to Trust Services Criteria and risk assessment.' },
  { key: 'ops',   title: 'Controls & Operations',         icon: '⚙️', blurb: 'Change management, access, SDLC and third-party risk.' },
  { key: 'mon',   title: 'Logging, Incidents & Evidence', icon: '📡', blurb: 'Centralised monitoring, incident response and evidence management.' },
  { key: 'attr',  title: 'Attribute Criteria',            icon: '🔒', blurb: 'Availability, Confidentiality, Processing Integrity and Privacy.' },
  { key: 'audit', title: 'Audit Readiness',               icon: '✅', blurb: 'Type 1/2 planning, period, population and sampling windows.' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="SOC 2 Free Readiness Checklist | Compliance365"
  description="Free SOC 2 readiness checklist for SaaS and service organisations. Score your Trust Services Criteria coverage, download a PDF roadmap and see what to fix before your Type 1 or Type 2 audit."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'SOC 2 Checklist', url: 'https://www.compliance365.com.au/checklist/soc2/' }
  ]}
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#1e40af;margin-bottom:1rem;">Free Readiness Assessment</p>
      <h1>SOC 2 Readiness Checklist</h1>
      <p class="section-lead muted" style="max-width:760px;">
        Score your SOC 2 readiness across governance, TSC mapping, controls, monitoring and evidence. Answer 16 questions, get an instant score and download a branded PDF roadmap to your Type 1 or Type 2 report.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#1e40af;color:white;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill" data-stage="2" style="flex:1;min-width:140px;background:#e2e8f0;color:#64748b;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill" data-stage="3" style="flex:1;min-width:140px;background:#e2e8f0;color:#64748b;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#f8fafc;padding:2rem 0;border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">&#9200;</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">~15 minutes</strong><p class="muted small" style="margin:2px 0 0;">16 questions across 6 TSC domains, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">&#9989;</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">Mapped to Trust Services Criteria</strong><p class="muted small" style="margin:2px 0 0;">Calibrated to CC1–CC9 plus Availability, Confidentiality, Processing Integrity and Privacy.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">&#128196;</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top gaps and a prioritised action plan. Emailed copy + instant download.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#f8fafc;border-bottom:1px solid #e2e8f0;padding:0.75rem 0;">
    <div class="container">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#1e40af;color:white;font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;">DISP / ISM / IRAP</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- STAGE 1 -->
      <div id="stage-1" class="stage">
        <div class="card" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your SOC 2 roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>
          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0f172a;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>
          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #e2e8f0;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- STAGE 2 -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #e2e8f0;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="font-size:1.5rem;">{grp.icon}</span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0f172a;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:#1e40af;">0/{grpQs.length}</div>
                    </div>
                  </div>
                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #f1f5f9;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:#eff6ff;color:#1e40af;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0f172a;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:#1e40af;font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid #bfdbfe;background:#eff6ff;color:#1e40af;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #f1f5f9;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:#1e40af;line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#64748b;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:#374151;font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#cbd5e1;"> - </span>
                    </div>
                    <div style="background:#f1f5f9;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#cbd5e1;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #f1f5f9;">
                <div style="font-size:0.75rem;color:#64748b;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#f1f5f9;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#1e40af;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid #bfdbfe;background:#eff6ff;color:#1e40af;border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- STAGE 3 -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://calendly.com/matt-nicholas-compliance365/30min" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />

  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = 'SOC 2 (Trust Services Criteria)';
      const API_URL  = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';

      const GROUPS = [
        { key:'gov',   title:'Governance & Scope' },
        { key:'tsc',   title:'TSC Mapping & Risk' },
        { key:'ops',   title:'Controls & Operations' },
        { key:'mon',   title:'Logging, Incidents & Evidence' },
        { key:'attr',  title:'Attribute Criteria' },
        { key:'audit', title:'Audit Readiness' },
      ];

      const QUESTIONS = [
        { id:'scope',        group:'gov',   label:'System boundary and in-scope services defined and documented for the SOC 2 system description' },
        { id:'governance',   group:'gov',   label:'Board or management actively oversees security and compliance — evidenced by charters and minutes' },
        { id:'policies',     group:'gov',   label:'Security policies approved, communicated to staff and reviewed at least annually' },
        { id:'tsc-map',      group:'tsc',   label:'Controls mapped to applicable Trust Services Criteria (CC1–CC9 plus attribute criteria) with rationale' },
        { id:'risk',         group:'tsc',   label:'Risk assessment performed — risks linked to specific controls and monitoring activities' },
        { id:'change',       group:'ops',   label:'Change management includes approvals, testing, rollback and separation of duties' },
        { id:'access',       group:'ops',   label:'Access provisioned on least privilege with JML process, periodic reviews and recertification' },
        { id:'proc-int',     group:'ops',   label:'Processing integrity ensured through SDLC gates, peer review and automated testing' },
        { id:'vendor',       group:'ops',   label:'Third-party risks assessed at onboarding and monitored ongoing with contractual controls' },
        { id:'logging',      group:'mon',   label:'Key security events centrally logged and monitored with alerts linked to tickets' },
        { id:'incident',     group:'mon',   label:'Incident response plan tested through exercises with post-incident reviews driving corrective actions' },
        { id:'evidence',     group:'mon',   label:'Evidence catalogued in a central library with defined sampling cadence and retention policy' },
        { id:'availability', group:'attr',  label:'Availability controls in place — capacity monitoring, redundancy and tested DR with RTO/RPO evidence' },
        { id:'confidential', group:'attr',  label:'Confidentiality controls cover encryption at rest and in transit with key management procedures' },
        { id:'privacy',      group:'attr',  label:'Privacy criteria covered — notice, data subject rights handling and retention/disposal procedures' },
        { id:'type',         group:'audit', label:'Audit type (Type 1/2), reporting period, population and sampling windows agreed with auditor' },
      ];

      const TOTAL_Q = QUESTIONS.length;
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#1e40af' : (s < n ? '#16a34a' : '#e2e8f0');
            p.style.color = (s <= n) ? 'white' : '#64748b';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('to-stage-2').addEventListener('click', function() {
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger','report-type','timeline'];
          var reqIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];
          allIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) env[id] = el.value ? el.value.trim() : '';
          });
          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) {
              valid = false;
              el.style.borderColor = '#dc2626';
              el.style.background  = '#fef2f2';
            } else {
              el.style.borderColor = '#cbd5e1';
              el.style.background  = 'white';
            }
          });
          var errEl = document.getElementById('env-error');
          if (!valid) { errEl.style.display = 'block'; errEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white'; o.style.color = '#0f172a'; o.style.borderColor = '#cbd5e1';
            });
            btn.classList.add('active');
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'white'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'white'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the SOC 2 readiness checklist. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') window.c365OpenChat(msg);
          });
        });

        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white'; o.style.color = '#0f172a'; o.style.borderColor = '#cbd5e1';
          });
          update();
        });

        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true; btn.textContent = 'Generating...';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
          } catch (err) {
            console.error(err);
            alert('Something went wrong — your PDF should still have downloaded.');
          } finally {
            btn.disabled = false; btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => { if (state[id] !== null) { answered++; sum += state[id]; } });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { label: 'Not started', desc: 'Answer questions to score', color: '#64748b' };
        if (score >= 86) return { label: 'Audit-Ready', desc: 'Strong posture — focus on evidence packaging and audit scheduling', color: '#16a34a' };
        if (score >= 61) return { label: 'Nearly Ready', desc: 'Close minor gaps and tighten evidence packaging', color: '#1e40af' };
        if (score >= 31) return { label: 'Partially Ready', desc: 'Many core controls in place — focus and prioritisation needed', color: '#d97706' };
        return { label: 'High Risk', desc: 'Missing foundational controls — structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#cbd5e1';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the SOC 2 readiness checklist on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('Target report type: ' + (env['report-type'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('Target timeline: ' + (env['timeline'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Domain scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) {
            lines.push('  [' + (state[q.id] === 1 ? 'PARTIAL' : 'NO') + '] ' + q.label);
          });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest SOC 2 gaps, what I should prioritise, and what a realistic path to a SOC 2 report looks like for my organisation?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);
        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#f1f5f9';
            el.style.color = a === total ? '#166534' : '#475569';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) { bar.style.width = '0%'; bar.style.background = '#cbd5e1'; pctEl.textContent = ' - '; pctEl.style.color = '#cbd5e1'; }
            else { bar.style.width = pct + '%'; bar.style.background = barColor(pct); pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct); }
          }
        });

        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone; btn.style.cursor = allDone ? 'pointer' : 'not-allowed'; btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone ? 'Click to generate and email your report' : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) { aiBtn.disabled = !allDone; aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed'; aiBtn.style.opacity = allDone ? '1' : '0.5'; }
      }

      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const lines = [];
        lines.push('=== SOC 2 READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Report type: ${env['report-type'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        GROUPS.forEach(g => { const s = computeSection(g.key); lines.push(`  ${g.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`); });
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          lines.push(`[${v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED'}] ${q.label}`);
        });
        try {
          await fetch(API_URL, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: env['contact-name'] || env['org-name'] || 'Anonymous',
              email: env['contact-email'] || 'noreply@compliance365.com.au',
              subject: `SOC 2 Checklist - ${env['org-name'] || 'Anonymous'} - ${score}%`,
              message: lines.join('\n'),
            }),
          });
        } catch (err) { console.warn('API submission failed:', err); }
      }

      function generatePDF() {
        var jsPDFLib = window.jspdf || {};
        var jsPDF = jsPDFLib.jsPDF;
        if (!jsPDF) { alert('PDF library not loaded — please wait and try again.'); return; }
        var doc = new jsPDF('p','mm','a4');
        var W=210, LM=18, RM=16, CW=W-LM-RM, y=0;
        var PRIMARY=[30,64,175], GREEN=[5,150,105], AMBER=[180,110,0], RED=[200,30,30];
        var WHITE=[255,255,255], LIGHT=[248,250,252], MUTED=[100,116,139], DARK=[17,24,39];
        var comp=compute(), sc=comp.score, ansCount=comp.answered, band=getBand(sc,ansCount);
        var orgName=env['org-name']||'Your Organisation';
        var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
        var scoreCol=sc>=75?GREEN:sc>=50?AMBER:RED;
        var scoreBand=sc>=86?'Audit-Ready':sc>=61?'Nearly Ready':sc>=31?'Partially Ready':'High Risk';
        doc.setFillColor(...PRIMARY); doc.rect(0,0,W,42,'F');
        doc.setFillColor(6,182,212); doc.rect(0,40,W,2,'F');
        var logoEl=document.getElementById('pdfLogo');
        doc.setTextColor(...WHITE); doc.setFont('helvetica','bold'); doc.setFontSize(18);
        if (logoEl&&logoEl.complete&&logoEl.naturalWidth>0) { doc.addImage(logoEl,'PNG',LM,8,20,20,undefined,'FAST'); doc.text('Compliance365',LM+24,18); }
        else { doc.text('Compliance365',LM,18); }
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text('SOC 2 Readiness Report', LM+(logoEl&&logoEl.complete?24:0), 26);
        doc.setFontSize(9); doc.text(orgName+'  |  '+today, LM+(logoEl&&logoEl.complete?24:0), 34);
        y=56;
        doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,28,4,4,'F');
        doc.setFillColor(...scoreCol); doc.roundedRect(LM,y,6,28,2,2,'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(28); doc.setTextColor(...scoreCol);
        doc.text(sc+'%',LM+16,y+18);
        doc.setFontSize(12); doc.setTextColor(...DARK); doc.text(scoreBand,LM+44,y+12);
        doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(...MUTED);
        doc.text(band.desc,LM+44,y+19,{maxWidth:CW-50});
        doc.text(ansCount+'/'+TOTAL_Q+' questions answered',LM+44,y+25);
        y+=36;
        doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text('Domain Breakdown',LM,y); y+=6;
        GROUPS.forEach(function(grp) {
          var s=computeSection(grp.key), p=s.pct===null?0:s.pct, col=p>=75?GREEN:p>=50?AMBER:RED;
          doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,12,2,2,'F');
          doc.setFillColor(...col); doc.roundedRect(LM,y,4,12,1,1,'F');
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...DARK);
          doc.text(grp.title,LM+8,y+7.5);
          var barX=LM+CW-60, barW=50;
          doc.setFillColor(226,232,240); doc.roundedRect(barX,y+4,barW,4,1,1,'F');
          if (p>0) { doc.setFillColor(...col); doc.roundedRect(barX,y+4,barW*(p/100),4,1,1,'F'); }
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...col);
          doc.text(s.pct===null?'-':p+'%',barX+barW+4,y+7.5);
          y+=15;
        });
        y+=4;
        var gaps=QUESTIONS.filter(function(q){ return state[q.id]===0||state[q.id]===1; });
        if (gaps.length) {
          doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
          doc.text('Priority Gaps',LM,y); y+=6;
          gaps.forEach(function(q) {
            if (y>270) { doc.addPage(); y=16; }
            var v=state[q.id], col=v===0?RED:AMBER, lbl=v===0?'NO':'PARTIAL';
            doc.setFillColor(...(v===0?[255,225,225]:[255,241,194]));
            doc.roundedRect(LM,y,CW,10,2,2,'F');
            doc.setFillColor(...col); doc.roundedRect(LM,y,3,10,1,1,'F');
            var lines=doc.splitTextToSize(q.label,CW-40);
            doc.setFont('helvetica','normal'); doc.setFontSize(8.5); doc.setTextColor(...DARK);
            doc.text(lines,LM+7,y+6.5);
            doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.setTextColor(...col);
            doc.text(lbl,W-RM-14,y+6.5);
            y+=13;
          });
        }
        doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(...MUTED);
        doc.text('Generated by Compliance365  |  compliance365.com.au  |  SOC 2 Readiness Report',LM,290);
        doc.save('soc2_readiness_'+(orgName.replace(/[^a-z0-9]/gi,'-')||'report')+'.pdf');
      }
    })();
  </script>
</Base>
