---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// Images
const images = {
  winDeals: `${base}assets/win-deals-faster-illustration.png`,
  procurement: `${base}assets/procurement-no-friction.png`,
  confidence: `${base}assets/confidence-when-asked.png`,
  fourPhases: `${base}assets/4phases.png`,
  fearsInfographic: `${base}assets/3-fears-infographic.png`,
};
---

<Base
  title="Enterprise Compliance That Closes Deals Faster — Compliance365"
  description="ISO 27001, SOC 2, ISO 42001 AI Governance, Essential Eight — delivered in weeks, inside your environment, revenue-focused."
>
  <Header />

  <!-- Announcement -->
  <div class="announce">
    <div class="container">
      <span>Cyber • Privacy • AI Governance • SOC 2 • Essential Eight • Built for SaaS & Tech Teams • No New Tools Needed</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Enterprise Compliance<br>That Closes Deals Faster</h1>
        <p class="hero-sub">Guaranteed ISO 27001, SOC 2, AI Governance & Privacy — in weeks, inside your stack, at a fraction of the cost.</p>
        <div class="hero-ctas">
          <a href={ctaUrl} class="btn btn-primary">Book Free Strategy Call</a>
          <a href={`${base}checklist/`} class="btn btn-outline">Get Your Free Score</a>
        </div>
        <div class="trust-badges">
          <span>No New Tools</span>
          <span>No Engineering Disruption</span>
          <span>Revenue-First Approach</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 BIGGEST FEARS -->
  <section class="section fears">
    <div class="container">
      <h2>The 3 Biggest Fears Killing Enterprise Deals</h2>
      <p class="section-lead">
        Strong product. Strong pipeline. Still losing revenue because compliance proof can't be delivered fast and credibly.
      </p>
      <img
        src={images.fearsInfographic}
        alt="The 3 Biggest Fears Killing Your Deals infographic"
        class="full-width-image"
        loading="lazy"
      />
    </div>
  </section>

  <!-- WHAT ENTERPRISE BUYERS REALLY WANT -->
  <section class="section desires">
    <div class="container">
      <h2>What Enterprise Buyers Really Want</h2>
      <p class="section-lead">
        Confidence. Speed. Evidence. Calm teams — not chaos.
      </p>

      <!-- Single hero image -->
      <div class="hero-image-container">
        <img
          src={images.winDeals}
          alt="Enterprise buyers closing deals faster with compliance"
          class="hero-desire-img"
          loading="eager"
        />
      </div>

      <!-- Three cards -->
      <div class="desire-grid">
        <div class="desire-card">
          <h3>Win Deals Faster</h3>
          <p>Security, privacy & AI compliance should shorten sales cycles — not extend them. Turn blockers into your competitive advantage and accelerate pipeline velocity.</p>
        </div>

        <div class="desire-card">
          <h3>Move Through Procurement Quicker</h3>
          <p>Weeks, not months. Predictable timelines. Defensible evidence that lets procurement confidently approve — without delays or risk flags.</p>
        </div>

        <div class="desire-card">
          <h3>Instant Confidence</h3>
          <p>Deliver auditor-ready, customer-trusted answers in minutes — no last-minute scrambles, no credibility gaps. Reusable proof that builds trust at scale.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section compare-section">
    <div class="container">
      <div class="section-head center">
        <h2>Why Fast-Growing Teams Choose ComplianceReady™</h2>
        <p class="section-lead muted">
          Stop wasting time and budget on outdated methods. See how we deliver faster, cleaner results that accelerate revenue — not slow it down.
        </p>
      </div>

      <div class="comparison-table">
        <div class="compare-row header">
          <div class="compare-cell bad">Traditional Consultants & Tools</div>
          <div class="compare-cell good">ComplianceReady™</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell bad">6–18 month timelines</div>
          <div class="compare-cell good">Weeks, not months</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell bad">Heavy engineering disruption</div>
          <div class="compare-cell good">Zero disruption – inside your environment</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell bad">High six-figure costs</div>
          <div class="compare-cell good">Fraction of the cost</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell bad">Generic templates that don’t fit</div>
          <div class="compare-cell good">Targeted, minimal remediation</div>
        </div>
        <div class="compare-row">
          <div class="compare-cell bad">New tools forced on teams</div>
          <div class="compare-cell good">No new tools or licenses required</div>
        </div>
      </div>

      <div class="cta-center">
        <p class="muted small">Trusted by SaaS and tech teams that need compliance to accelerate growth — not slow it down.</p>
        <a href={ctaUrl} class="btn btn-primary large">Get Compliant & Win Deals Faster</a>
      </div>
    </div>
  </section>

  <!-- 4 PHASES -->
  <section class="section phases">
    <div class="container">
      <h2>Our Proven 4-Phase ComplianceReady™ System</h2>
      <p class="section-lead">
        Structured, fast, and completely inside your existing environment — no new tools, no extra licenses, no disruption.
      </p>

      <div class="phases-breakdown grid-4">
        <div class="phase-step">
          <div class="phase-icon">🔍</div>
          <h3>Risk Assessment & Scope Definition</h3>
          <p>We map exactly what’s in scope, identify real risks that matter, and define a clear, prioritized baseline — all using your current Microsoft 365 / existing stack.</p>
        </div>

        <div class="phase-step">
          <div class="phase-icon">🛡️</div>
          <h3>Risk Remediation & System Implementation</h3>
          <p>Targeted, minimal remediation — we build controls, policies, workflows, and automated evidence capture directly inside your environment.</p>
        </div>

        <div class="phase-step">
          <div class="phase-icon">✅</div>
          <h3>Internal Audit & Readiness Validation</h3>
          <p>Independent review to confirm: If an auditor walked in tomorrow, would we pass? We validate evidence traceability and produce a clean audit pack.</p>
        </div>

        <div class="phase-step">
          <div class="phase-icon">🏆</div>
          <h3>Certification Support</h3>
          <p>Full support through external certification — assessor Q&A, final evidence packaging, and a calm, surprise-free audit experience.</p>
        </div>
      </div>

      <img
        src={images.fourPhases}
        alt="ComplianceReady 4-Phase System overview diagram"
        class="full-width-image phases-image"
        loading="lazy"
      />
    </div>
  </section>

<!-- FAQ - Common Questions Strip (Improved) -->
<section class="section faq-section" style="background:#f8fafc; padding:6rem 0;">
  <div class="container">
    <h2>Common Questions About ComplianceReady™</h2>
    <p class="section-lead muted" style="text-align:center; max-width:720px; margin:1rem auto 3rem;">
      We get these questions every day from fast-growing SaaS and tech teams. Here are the answers that matter most.
    </p>

    <div class="faq-grid">
      <!-- FAQ 1: Disruption -->
      <div class="faq-card">
        <div class="faq-icon">🛠️</div>
        <h3>Will this disrupt my engineering team?</h3>
        <p>No. We work entirely inside your existing Microsoft 365 environment. No new tools, no forced change management, no endless meetings — your team stays focused on product delivery.</p>
      </div>

      <!-- FAQ 2: Time -->
      <div class="faq-card">
        <div class="faq-icon">⚡</div>
        <h3>How long does it actually take?</h3>
        <p>Most teams are audit-ready in 8–12 weeks (depending on scope). You'll see meaningful progress in the first 4 weeks — far faster than the 6–18 months typical with consultants.</p>
      </div>

      <!-- FAQ 3: Cost -->
      <div class="faq-card">
        <div class="faq-icon">💰</div>
        <h3>What does it cost?</h3>
        <p>A fraction of traditional consulting or GRC tool subscriptions — often 60–80% less. Fixed pricing with no scope creep or hidden fees. We align cost directly to business value.</p>
      </div>

      <!-- FAQ 4: Frameworks -->
      <div class="faq-card">
        <div class="faq-icon">🔗</div>
        <h3>Which frameworks do you cover?</h3>
        <p>ISO 27001, ISO 27701 (Privacy), ISO 42001 (AI Governance), SOC 2, Essential Eight, DISP/ISM/IRAP, NIST CSF — plus efficient mappings between them. One set of controls, multiple certifications.</p>
      </div>
    </div>

    <!-- Mini CTA -->
    <div style="text-align:center; margin-top:3.5rem;">
      <p class="muted" style="margin-bottom:1.2rem;">Still have questions? We're here to help.</p>
      <a href={ctaUrl} class="btn btn-primary">Book a Free Call</a>
    </div>
  </div>
</section>

  <!-- SOCIAL PROOF CAROUSEL - Fixed & Working -->
<section class="section trust-section">
  <div class="container">
    <h2>Trusted by Teams Like Yours</h2>
    <p class="section-lead muted">Real results from real organisations who've turned compliance into a growth driver.</p>

    <div class="t-carousel" id="testimonialCarousel">
      <div class="t-viewport">
        <div class="t-track" id="testimonialTrack">
          <!-- Slide 1 -->
          <div class="t-slide">
            <blockquote>
              "We needed ISO 27001 for government contracts. Compliance365 got us certified in 10 weeks with minimal disruption — using our existing Microsoft stack. No consultants, no new tools. Game-changer."
            </blockquote>
            <div class="testimonial-author">
              <strong>Head of Security</strong> — State Government Department
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="t-slide">
            <blockquote>
              "Implementing ISO 42001 for AI governance was daunting. Compliance365 made it straightforward, fast, and fully integrated with our existing processes. Audit-ready in under 3 months — highly recommend."
            </blockquote>
            <div class="testimonial-author">
              <strong>CTO</strong> — SaaS Medical Platform (Healthcare Tech)
            </div>
          </div>

          <!-- Slide 3 -->
          <div class="t-slide">
            <blockquote>
              "SOC 2 was a sales blocker for us. Compliance365 delivered Type 2 readiness in weeks, not months — at a fraction of the usual cost. Reusable evidence has already closed multiple enterprise deals."
            </blockquote>
            <div class="testimonial-author">
              <strong>VP Engineering</strong> — Fast-Growing Technology Company
            </div>
          </div>
        </div>
      </div>

      <div class="t-controls">
        <button class="t-btn" id="tPrev" aria-label="Previous slide">‹</button>
        <div class="t-dots" id="tDots"></div>
        <button class="t-btn" id="tNext" aria-label="Next slide">›</button>
      </div>
    </div>
  </div>
</section>

<!-- TRUSTED BY BAR -->
<section class="section trusted-by" style="background:#f8fafc; padding:4rem 0; text-align:center;">
  <div class="container">
    <p class="muted" style="margin-bottom:1.5rem; font-size:1.1rem;">
      Trusted by teams in Government, Healthcare SaaS, and Technology
    </p>
    <div class="trusted-logos" style="display:flex; gap:3rem; justify-content:center; flex-wrap:wrap; opacity:0.9;">
      <span style="font-size:2rem; font-weight:900; color:var(--muted);">Government</span>
      <span style="font-size:2rem; font-weight:900; color:var(--muted);">Healthcare SaaS</span>
      <span style="font-size:2rem; font-weight:900; color:var(--muted);">Technology</span>
      <!-- Add real logos here when ready -->
    </div>
  </div>
</section>

 <!-- FINAL CTA - Updated & More Compelling -->
<section class="section final-cta" style="background:var(--primary); color:white; text-align:center; padding:8rem 0;">
  <div class="container">
    <h2>Ready to Turn Compliance Into a Revenue Accelerator?</h2>
    <p class="lead" style="font-size:1.6rem; max-width:760px; margin:1.5rem auto;">
      Book a free 30-minute call — we'll show you how to get audit-ready fast, close more deals, and avoid months of delays.
    </p>

    <div class="final-buttons" style="display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap; margin-top:2.5rem;">
      <!-- Primary button – bigger, more prominent -->
      <a href={ctaUrl} class="btn btn-primary large" style="background:white; color:var(--primary); font-size:1.3rem; padding:1.2rem 3rem;">
        Book Free Call Now
      </a>
      <a href={`${base}checklist/`} class="btn btn-outline large" style="color:white; border-color:white; font-size:1.2rem; padding:1.1rem 2.6rem;">
        Get Your Free Readiness Score
      </a>
    </div>

    <!-- Optional: subtle urgency/trust line -->
    <p style="margin-top:1.5rem; font-size:1.1rem; opacity:0.9;">
      Limited spots available — most teams see results in under 4 weeks.
    </p>
  </div>
</section>

<script>
  const track = document.getElementById('testimonialTrack');
  const slides = track.children;
  const prevBtn = document.getElementById('tPrev');
  const nextBtn = document.getElementById('tNext');
  const dotsContainer = document.getElementById('tDots');
  let currentIndex = 0;

  // Create dots
  for (let i = 0; i < slides.length; i++) {
    const dot = document.createElement('button');
    dot.classList.add('t-dot');
    if (i === 0) dot.classList.add('active');
    dot.addEventListener('click', () => goToSlide(i));
    dotsContainer.appendChild(dot);
  }

  const dots = dotsContainer.children;

  function goToSlide(index) {
    currentIndex = index;
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    updateDots();
  }

  function updateDots() {
    Array.from(dots).forEach((dot, i) => {
      dot.classList.toggle('active', i === currentIndex);
    });
  }

  prevBtn.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + slides.length) % slides.length;
    goToSlide(currentIndex);
  });

  nextBtn.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % slides.length;
    goToSlide(currentIndex);
  });

  // Optional auto-play
  let autoPlay = setInterval(() => {
    currentIndex = (currentIndex + 1) % slides.length;
    goToSlide(currentIndex);
  }, 6000);

  // Pause on hover
  document.getElementById('testimonialCarousel').addEventListener('mouseenter', () => clearInterval(autoPlay));
  document.getElementById('testimonialCarousel').addEventListener('mouseleave', () => {
    autoPlay = setInterval(() => {
      currentIndex = (currentIndex + 1) % slides.length;
      goToSlide(currentIndex);
    }, 6000);
  });
</script>

  <Footer />
</Base>
