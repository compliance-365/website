    /* first render, bars animate on first view */
    var first = 'ISO 27001';
    fill(first, DATA[first]);
    new IntersectionObserver(function (es, ob) {
      if (es[0].isIntersecting) { animateBars(DATA[first]); ob.disconnect(); }
    }, { threshold: 0.3 }).observe(body);
  })();

  /* ── Platform tax calculator ── */
  (function () {
    var range = document.getElementById('empRange');
    if (!range) return;
