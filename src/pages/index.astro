        pair = 'Pairs well with <b>ISO 27001</b> — most contractors add it for broader procurement.';
        url = BASE + 'services/disp-ism-irap/';
      } else if (c.indexOf('US') > -1 || c.indexOf('global') > -1) {
        name = 'SOC 2 — Type I & II';
        why = 'US and global enterprise buyers ask for SOC 2 before signing SaaS contracts. We map the Trust Services Criteria to your existing M365 controls and deliver reusable evidence your sales team can attach to every deal.';
        pair = 'Pairs well with <b>ISO 27001</b> — ~70% shared controls, often delivered simultaneously.';
        url = BASE + 'services/soc2/';
      } else if (s.indexOf('Healthcare') > -1 || d.indexOf('personal data') > -1 || c.indexOf('Healthcare') > -1) {
        name = 'ISO 27001 + ISO 27701';
        why = 'Health procurement and privacy regulators want both security and privacy management. Delivered together — DPIA workflows, ROPAs and data-rights handling inside Microsoft 365 — the privacy extension adds weeks, not months.';
        pair = '~85% of ISO 27701 control work is shared with <b>ISO 27001</b>.';
        url = BASE + 'services/iso27701/';
