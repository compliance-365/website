---
// src/pages/about/index.astro
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min'; // or `${base}contact`
---

<Base title="About Compliance365"
      description="We help Australian organisations simplify cyber, privacy and AI governance with practical frameworks and Microsoft 365 automation.">
  <Header />

  <!-- Intro -->
  <section class="container section">
    <h1>About Compliance365</h1>
    <p class="muted" style="max-width:760px">
      We help organisations cut through the complexity of compliance. Certifications and uplift projects
      shouldn’t feel like a burden—they should be <strong>clear, practical</strong> and <strong>aligned
      to business outcomes</strong>. We embed security, privacy and AI governance into your
      Microsoft&nbsp;365 stack so evidence lives where your teams already work.
    </p>
  </section>

  <!-- Our Story -->
  <section class="container section">
    <div class="grid-2" style="align-items:center;gap:32px">
      <div>
        <h2>Our Story</h2>
        <p>
          Founded in Brisbane, <strong>Compliance365</strong> is built on a simple idea:
          most organisations already have what they need to meet compliance goals—what’s missing is the
          <strong>right strategy and automation</strong> to connect people, process and platform.
        </p>
        <p>
          We help teams achieve certification and assurance across
          ISO&nbsp;27001, ISO&nbsp;27701, ISO&nbsp;42001, SOC&nbsp;2 and the Essential&nbsp;Eight by
          <strong>automating evidence inside Microsoft&nbsp;365</strong> and aligning control design to
          real operating constraints.
        </p>
        <p>
          The result is a pragmatic, auditable and scalable program that reduces manual effort and
          delivers measurable value—without another platform to manage.
        </p>
      </div>
      <div>
        <img
          src={`${base}assets/about-team.jpg`}
          alt="Compliance365 — team and technology"
          style="width:100%;border-radius:18px;box-shadow:0 8px 30px rgba(0,0,0,.08)"
          loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="container section">
    <h2>What we do</h2>
    <div class="grid-3" style="margin-top:16px">
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Shield -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z" stroke="currentColor" stroke-width="1.6"/></svg>
        </div>
        <h3>Cybersecurity</h3>
        <p class="muted">ISO&nbsp;27001, Essential Eight, SOC&nbsp;2 and DISP—control design, implementation and audit readiness.</p>
      </div>
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Lock -->
          <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 1 1 8 0v3" stroke="currentColor" stroke-width="1.6"/></svg>
        </div>
        <h3>Privacy</h3>
        <p class="muted">ISO&nbsp;27701, GDPR and AU Privacy Act—PIMS, ROPA, DPIAs and subject-rights workflows.</p>
      </div>
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- AI chip -->
          <svg viewBox="0 0 24 24" fill="none"><rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M19 5l-2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </div>
        <h3>AI Governance</h3>
        <p class="muted">ISO&nbsp;42001 and emerging AI regulation—model inventory, AI risk, oversight and monitoring evidence.</p>
      </div>
    </div>
  </section>

  <!-- PRIDE Values (same visual style as “What we do”) -->
  <section class="container section">
    <h2>Our Values — PRIDE</h2>
    <div class="grid-3" style="margin-top:16px">
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Heart/target -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s-7-4.35-7-10a7 7 0 0 1 14 0c0 5.65-7 10-7 10z" stroke="currentColor" stroke-width="1.6"/></svg>
        </div>
        <h3>P — Put the Customer First</h3>
        <p class="muted small">Outcomes over outputs. We tailor frameworks and automation to your environment—not the other way around.</p>
      </div>
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Handshake -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M8 12l2 2 4-4 2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M2 12h4l4 4h4l4-4h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </div>
        <h3>R — Reward Relationships</h3>
        <p class="muted small">We earn trust through transparency, collaboration and follow-through—project after project.</p>
      </div>
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Shield check -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z" stroke="currentColor" stroke-width="1.6"/><path d="M9.5 12.5l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>I — Inspire Trust</h3>
        <p class="muted small">Integrity and accuracy guide every deliverable—so auditors and stakeholders can rely on the evidence.</p>
      </div>
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Star -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l3 6 6 .9-4.5 4.3L18 21l-6-3.2L6 21l1.5-6.9L3 9.9 9 9l3-6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </div>
        <h3>D — Deliver with Excellence</h3>
        <p class="muted small">Clear standards, measurable outcomes and continuous improvement. We set the bar high and meet it.</p>
      </div>
      <div class="card feature">
        <div class="icon" aria-hidden="true">
          <!-- Magic wand / simplify -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M3 21l9-9M14 7l3-3M10 4l2-2M20 10l2-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="11" y="11" width="2" height="2" fill="currentColor"/></svg>
        </div>
        <h3>E — Empower Simplicity</h3>
        <p class="muted small">Compliance shouldn’t be complex. We streamline governance so teams can focus on innovation.</p>
      </div>
    </div>
  </section>

  <section class="container section">
  <h2>How we work</h2>
  <p class="muted">A proven, repeatable approach that keeps compliance simple, scalable, and sustainable.</p>
  <div class="grid-4" style="margin-top:16px">

    <div class="card feature">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-3.4-3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <h3>Assess</h3>
      <p class="muted small">We review your current state and risks, then define a clear roadmap with priorities, timelines, and owners.</p>
    </div>

    <div class="card feature">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M21 7a5 5 0 0 1-7 7L7 21l-3-3 7-7a5 5 0 0 1 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <h3>Implement</h3>
      <p class="muted small">We design and embed practical controls, policies, and workflows that integrate seamlessly with your Microsoft 365 environment.</p>
    </div>

    <div class="card feature">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><rect x="7" y="4" width="10" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 9h6M9 12h6M9 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <h3>Assure</h3>
      <p class="muted small">We prepare you for audit or alignment — collecting evidence, conducting internal checks, and liaising with external assessors if required.</p>
    </div>

    <div class="card feature">
      <div class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h12l-2-2M21 17H9l2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7 7a5 5 0 0 1 8-3M17 17a5 5 0 0 1-8 3" stroke="currentColor" stroke-width="1.6"/></svg>
      </div>
      <h3>Improve</h3>
      <p class="muted small">We help you stay ahead with metrics, reviews, and continuous improvements that keep compliance living — not static.</p>
    </div>

  </div>
</section>

  <!-- CTA -->
  <section class="container section">
    <div class="card" style="text-align:center;padding:40px;border-radius:22px">
      <h2 style="margin:0 0 8px">Ready to simplify compliance?</h2>
      <p class="muted" style="margin:0 0 12px">Book a roadmap call. We’ll map your fastest path and automate the evidence.</p>
      <a href={ctaUrl} class="btn btn-primary" style="margin-top:8px">Book a consultation</a>
    </div>
  </section>

  <Footer />
</Base>
