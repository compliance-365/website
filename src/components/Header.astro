<header class="site-header">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
    <a href="/" class="brand" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
      <img src="/assets/logo.svg" alt="Compliance365" width="28" height="28" />
      <strong>Compliance365</strong>
    </a>

    <!-- Mobile menu button -->
    <button class="nav-toggle" aria-expanded="false" aria-controls="primaryNav">
      <span class="sr-only">Toggle navigation</span>☰
    </button>

    <nav id="primaryNav" class="nav">
      <a href="/services">Services</a>
      <a href="/case-studies">Case Studies</a>
      <a href="/about">About</a>
      <a href="/resources">Resources</a>
      <a href="/insights">Insights</a>
      <a href="/testimonials">Testimonials</a>
      <a href={ctaUrl} class="btn btn-primary">{ctaLabel}</a>
    </nav>
  </div>
</header>

<style>
.site-header{ position:sticky; top:0; z-index:50; background:#fff; border-bottom:1px solid var(--border,#e9edf4); }
.nav{ display:flex; align-items:center; gap:10px; }
.nav-toggle{ display:none; border:1px solid var(--border,#e9edf4); background:#fff; border-radius:10px; padding:8px 10px; }
@media (max-width: 980px){
  .nav-toggle{ display:block; }
  .nav{
    position: absolute;
    top: 64px; left: 0; right: 0;
    display: grid; gap: 8px;
    background:#fff; border-bottom:1px solid #eef2f7;
    padding: 10px 20px;
    transform: translateY(-16px);
    opacity: 0; pointer-events: none;
    transition: opacity .2s ease;
  }
  .nav.open{ opacity: 1; pointer-events: auto; transform: none; }
  .nav .btn{ width: 100%; }
}
.sr-only{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;}
</style>

<script is:inline>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primaryNav');
  btn?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
