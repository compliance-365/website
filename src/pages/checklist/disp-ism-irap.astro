---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'DISP / ISM / IRAP (Defence Security)';

const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['Defence Industry','Government / Government-adjacent','Critical Infrastructure','Aerospace & Defence Manufacturing','Cyber Security Services','Professional Services (Defence contracts)','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–99','100–499','500–1 999','2 000+'] },
  { id: 'trigger',      label: 'What is driving this assessment?',     type: 'select', required: true,  options: ['New Defence contract or tender','DISP membership application','IRAP assessment preparation','ISM compliance uplift','Defence Industry Security Program renewal','Internal readiness review','Other'] },
  { id: 'classification',label: 'Highest data classification handled', type: 'select', required: false, options: ['Not yet confirmed','OFFICIAL','OFFICIAL: Sensitive','PROTECTED','SECRET or above'] },
  { id: 'timeline',     label: 'Target timeline',                      type: 'select', required: false, options: ['Not yet decided','Within 3 months','3–6 months','6–12 months','12+ months'] },
];

const QUESTIONS = [
  // Governance & DISP
  {
    id: 'disp-scope',
    group: 'gov',
    label: 'We have confirmed which DISP membership categories and levels we are targeting and have documented the rationale.',
    hint: 'DISP expectations vary significantly by category and level — being explicit avoids scope surprises later.',
    examples: [
      'Documented decision on DISP membership categories and target levels.',
      'Rationale aligned to Defence work types and data classifications handled.',
      'Executive approval of DISP scope and roadmap.'
    ]
  },
  {
    id: 'security-off',
    group: 'gov',
    label: 'A Security Officer or equivalent role is formally appointed and reports Defence-related risks to the executive or board.',
    hint: 'Defence expects clear, named accountability for protective security matters.',
    examples: [
      'Formal appointment letter or position description for the Security Officer role.',
      'Role description covering DISP, PSPF, ISM and IRAP responsibilities.',
      'Evidence of escalation and reporting to executive or board on security matters.'
    ]
  },
  {
    id: 'pspf',
    group: 'gov',
    label: 'Policies and procedures have been reviewed against the Protective Security Policy Framework (PSPF) and gaps are tracked with remediation actions.',
    hint: 'PSPF alignment underpins DISP membership and is a signal of organisational security maturity to Defence.',
    examples: [
      'PSPF gap assessment or control mapping document.',
      'Action register addressing identified gaps with owners and due dates.',
      'Periodic review schedule as PSPF requirements change.'
    ]
  },

  // People & Physical Security
  {
    id: 'clearance',
    group: 'pers',
    label: 'Staff who handle sensitive or Defence-related information are appropriately screened and hold the required security clearances.',
    hint: 'Personnel security must match the sensitivity of the information staff access — DISP auditors check this.',
    examples: [
      'Baseline pre-employment screening for all staff and contractors.',
      'Active security clearances held by staff requiring access to classified material.',
      'Clearance register maintained with revalidation dates tracked.'
    ]
  },
  {
    id: 'onboarding-offboarding',
    group: 'pers',
    label: 'A clear process manages the onboarding, movement and offboarding of staff and contractors — including access revocation and clearance updates.',
    hint: 'Personnel changes are a key risk area for Defence engagements — leavers with residual access are a common finding.',
    examples: [
      'Documented joiner/mover/leaver (JML) process with Defence-specific steps.',
      'Timely access removal and clearance suspension or transfer on exit.',
      'Attestation records showing offboarding checks were completed.'
    ]
  },
  {
    id: 'training',
    group: 'pers',
    label: 'Staff receive regular security awareness training that covers DISP obligations, classification handling and Defence-specific requirements.',
    hint: 'Training must be relevant to Defence obligations — generic cyber awareness alone is insufficient.',
    examples: [
      'Annual security awareness training with DISP and classification-specific content.',
      'Targeted training for staff who handle PROTECTED or above material.',
      'Training completion records retained and available for audit.'
    ]
  },
  {
    id: 'facility',
    group: 'pers',
    label: 'Offices and facilities have been assessed for physical security — including zones, visitor controls, alarms and secure storage — aligned to DISP expectations.',
    hint: 'Physical security controls must match the sensitivity of work performed at each location.',
    examples: [
      'Physical security assessment completed and aligned to DISP and PSPF requirements.',
      'Defined security zones with appropriate access controls and visitor management.',
      'Secure storage for classified material (e.g. approved containers).'
    ]
  },

  // Cyber & ISM Controls
  {
    id: 'classification-ctrl',
    group: 'tech',
    label: 'The expected classification and handling level of Defence information our systems will store or process is confirmed and documented.',
    hint: 'Classification drives ISM control selection and IRAP assessment scope — confirming it early avoids costly rework.',
    examples: [
      'Confirmed classification level (e.g. OFFICIAL, OFFICIAL: Sensitive, PROTECTED).',
      'Handling rules documented and communicated to relevant staff.',
      'Classification requirements aligned to Defence contract or Deed of Standing Offer (DSO).'
    ]
  },
  {
    id: 'ism-baseline',
    group: 'tech',
    label: 'An ISM control baseline has been selected for our system and any justified deviations are documented with risk acceptance.',
    hint: 'ISM compliance is risk-based — but deviations must be explicit and approved, not just assumed.',
    examples: [
      'Selected ISM baseline documented and tailored to system classification.',
      'A register of deviations with risk rationale and acceptance by an appropriate authority.',
      'Baseline reviewed when the ISM is updated or system changes occur.'
    ]
  },
  {
    id: 'iat',
    group: 'tech',
    label: 'Standards for system hardening, patching, malware protection and configuration baselines are defined and applied consistently.',
    hint: 'Defence expects consistent, measurable cyber hygiene — inconsistent application is a common IRAP finding.',
    examples: [
      'System hardening standards aligned to ASD ISM and Essential Eight.',
      'Patch and malware protection policies with defined SLAs.',
      'Compliance evidence from tooling (e.g. Intune, Defender, vulnerability scanner) or internal audits.'
    ]
  },
  {
    id: 'logging',
    group: 'tech',
    label: 'Security logs are centrally collected, monitored and retained in line with ISM requirements and our incident response processes.',
    hint: 'Centralised logging supports both detection during operations and evidence during IRAP assessment.',
    examples: [
      'Central log collection in a SIEM or equivalent platform.',
      'Log retention periods aligned to ISM and contractual requirements.',
      'Evidence of monitoring cadence, alerting and response to events.'
    ]
  },
  {
    id: 'vuln-mgmt',
    group: 'tech',
    label: 'Regular vulnerability scanning and targeted penetration testing are performed — findings are prioritised and high-risk issues are remediated.',
    hint: 'Proactive vulnerability management is expected by IRAP assessors and demonstrates ongoing risk reduction.',
    examples: [
      'Scheduled vulnerability scans with defined frequency and scope.',
      'Penetration test reports where required by classification or contract.',
      'Remediation tracking register with closure evidence for high and critical findings.'
    ]
  },
  {
    id: 'incident',
    group: 'tech',
    label: 'An incident response process covers Defence notification requirements, evidence retention and post-incident reviews.',
    hint: 'Defence has specific notification obligations — generic IR plans often miss these.',
    examples: [
      'Incident response plan referencing ACSC and Defence notification pathways and timeframes.',
      'Evidence retention procedures aligned to ISM requirements.',
      'Post-incident review records showing improvements actioned.'
    ]
  },

  // Risk Management & System Docs
  {
    id: 'system-desc',
    group: 'risk',
    label: 'A current system description and architecture diagrams exist showing components, data flows, dependencies and boundaries.',
    hint: 'IRAP assessors rely heavily on accurate, up-to-date system documentation — gaps here slow assessments significantly.',
    examples: [
      'System description document covering purpose, users and data handled.',
      'Architecture and data flow diagrams showing components and network boundaries.',
      'Dependencies and shared responsibility boundaries for cloud or third-party services.'
    ]
  },
  {
    id: 'ssp',
    group: 'risk',
    label: 'A System Security Plan (SSP) documents how ISM controls are implemented and who is responsible for each control.',
    hint: 'The SSP is the core artefact for both ISM compliance and IRAP assessment — it must be current.',
    examples: [
      'Current SSP aligned to the selected ISM control baseline.',
      'Named ownership for each control implementation.',
      'Shared responsibility statements for cloud or managed service components.'
    ]
  },
  {
    id: 'srmp',
    group: 'risk',
    label: 'A Security Risk Management Plan (SRMP) identifies system threats and risks with agreed treatments and residual risk acceptance.',
    hint: 'Risk decisions must be explicit and documented — verbal risk acceptance is not sufficient for Defence.',
    examples: [
      'SRMP covering identified threats, risks and likelihood/impact ratings.',
      'Risk treatment plans with owners and due dates.',
      'Residual risk acceptance documented by an appropriate authority and reviewed regularly.'
    ]
  },
  {
    id: 'backup-dr',
    group: 'risk',
    label: 'Backup, business continuity and disaster recovery arrangements are tested regularly and appropriate for our system classification.',
    hint: 'Resilience requirements increase with classification — untested backups are a common finding.',
    examples: [
      'Defined RTO and RPO aligned to classification and contract requirements.',
      'Backup and DR test results documented with evidence.',
      'Issues identified in testing actioned and tracked to closure.'
    ]
  },
  {
    id: 'ato',
    group: 'risk',
    label: 'The authorisation pathway is clear — we know who will grant the Authority to Operate (ATO) and how they will be kept informed of risk.',
    hint: 'Clear ATO pathways reduce IRAP friction and avoid late-stage delays.',
    examples: [
      'Identified Authorising Authority (AA) aligned to system classification.',
      'ATO briefing materials and ongoing reporting cadence agreed.',
      'Ongoing risk and change notification process documented.'
    ]
  },

  // IRAP Planning & Evidence
  {
    id: 'scoping',
    group: 'irap',
    label: 'An IRAP scope and assessment type have been agreed or are in progress — including systems, environments and assessment approach.',
    hint: 'Clear scoping prevents assessment delays, rework and cost overruns.',
    examples: [
      'Defined systems, environments and physical locations in scope.',
      'Agreed assessment type (gap analysis, full assessment or reassessment).',
      'Indicative assessment period and timeline agreed with assessor.'
    ]
  },
  {
    id: 'previous-irap',
    group: 'irap',
    label: 'If a previous IRAP was conducted, all recommendations and open findings are tracked and their current status is known.',
    hint: 'Outstanding findings from prior IRAPs must be addressed — assessors will review the previous report.',
    examples: [
      'Previous IRAP report retained and accessible.',
      'Status register showing which recommendations have been addressed.',
      'Evidence of remediation progress for outstanding or partially-addressed findings.'
    ]
  },
  {
    id: 'evidence',
    group: 'irap',
    label: 'A central evidence workspace exists for organising and sharing assessment material with the IRAP assessor.',
    hint: 'Well-organised evidence significantly accelerates IRAP assessments and reduces assessor time.',
    examples: [
      'Central SharePoint or equivalent evidence library mapped to ISM controls.',
      'Clear folder structure with version-controlled artefacts.',
      'Access controls configured so assessors can review without accessing production systems.'
    ]
  },
  {
    id: 'poam',
    group: 'irap',
    label: 'A Plan of Action and Milestones (POA&M) or equivalent register tracks all findings to verified closure.',
    hint: 'Defence expects transparent, accountable remediation tracking — informal lists are not sufficient.',
    examples: [
      'POA&M with finding descriptions, owners, due dates and current status.',
      'Regular status updates reviewed by the Security Officer.',
      'Closure evidence retained for each finding.'
    ]
  },

  // Contracts, Suppliers & Hosting
  {
    id: 'hosting',
    group: 'cont',
    label: 'Hosting locations are documented and assessed against Defence sovereign hosting requirements for the relevant classification.',
    hint: 'Data sovereignty is a critical Defence consideration — offshore hosting of PROTECTED data is generally not acceptable.',
    examples: [
      'Documented hosting locations (region, data centre) for all in-scope systems.',
      'Assessment against Defence and PSPF sovereign hosting requirements.',
      'Risk acceptance or compensating controls documented where constraints exist.'
    ]
  },
  {
    id: 'contracts',
    group: 'cont',
    label: 'Contracts and subcontracts include security, confidentiality, incident notification and relevant DISP obligations.',
    hint: 'Defence security obligations must flow down through the supply chain — gaps in contracts are a liability.',
    examples: [
      'Security and confidentiality clauses tailored to classification and DISP requirements.',
      'Incident notification timeframes aligned to Defence contractual obligations.',
      'DISP and ISM obligations explicitly included or referenced in subcontracts.'
    ]
  },
  {
    id: 'suppliers',
    group: 'cont',
    label: 'Key suppliers and subcontractors are identified, their ISM and IRAP responsibilities are defined, and assurance evidence is obtained.',
    hint: 'Third-party suppliers can introduce significant Defence risk — understanding shared responsibility is essential.',
    examples: [
      'Supplier inventory with criticality ratings and data access levels.',
      'Defined shared responsibility matrix covering ISM controls.',
      'Assurance evidence (e.g. IRAP letters, ISM certifications, SOC reports) held on file.'
    ]
  },
];

const GROUPS = [
  { key: 'gov',  title: 'Governance & DISP',             icon: 'government', blurb: 'DISP categories, Security Officer, and PSPF alignment.' },
  { key: 'pers', title: 'People & Physical Security',    icon: 'people', blurb: 'Clearances, onboarding/offboarding, training and facilities.' },
  { key: 'tech', title: 'Cyber & ISM Controls',          icon: 'lock', blurb: 'Classification, ISM baseline, hardening, logging and incidents.' },
  { key: 'risk', title: 'Risk & System Documentation',   icon: 'clipboard', blurb: 'System description, SSP, SRMP and ATO pathway.' },
  { key: 'irap', title: 'IRAP Planning & Evidence',      icon: 'search', blurb: 'Scope, previous findings, evidence workspace and POA&M.' },
  { key: 'cont', title: 'Contracts, Suppliers & Hosting',icon: 'factory', blurb: 'Sovereign hosting, security clauses and supplier assurance.' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="IRAP Assessment Checklist — Free DISP & ISM Defence Readiness Tool | Compliance365"
  description="Free IRAP readiness checklist for Australian defence contractors. Score your DISP membership requirements and ISM controls across 6 domains in 15 minutes — get a prioritised gap report instantly. Covers OFFICIAL and PROTECTED-level requirements."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'DISP / ISM / IRAP Checklist', url: 'https://www.compliance365.com.au/checklist/disp-ism-irap/' }
  ]}
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#A9812E;margin-bottom:1rem;">Free Readiness Assessment</p>
      <h1>DISP / ISM / IRAP Defence Security Readiness Checklist</h1>
      <p class="section-lead muted" style="max-width:760px;">
        Assess your organisation's readiness for DISP membership, ISM compliance and IRAP assessment. Answer 25 questions across governance, personnel, cyber controls and evidence management — get an instant score and a branded PDF roadmap.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#A9812E;color:white;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill" data-stage="2" style="flex:1;min-width:140px;background:#DDD8CF;color:#6B6860;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill" data-stage="3" style="flex:1;min-width:140px;background:#DDD8CF;color:#6B6860;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#FAF7F1;padding:2rem 0;border-top:1px solid #DDD8CF;border-bottom:1px solid #DDD8CF;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#A9812E;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-clock"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">~20 minutes</strong><p class="muted small" style="margin:2px 0 0;">25 questions across 6 domains covering DISP, ISM and IRAP readiness, plus a context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#16a34a;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-check-seal"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Mapped to DISP, ISM & PSPF</strong><p class="muted small" style="margin:2px 0 0;">Questions calibrated to the controls and evidence an IRAP assessor or DISP auditor will look for.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#A9812E;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-note"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, priority gaps and a recommended action plan — ready for the executive or Defence contract team.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:#6B6860;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#A9812E;color:white;font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">DISP / ISM / IRAP</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- STAGE 1 -->
      <div id="stage-1" class="stage">
        <div class="card" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your defence security roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>
          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0B0B0C;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>
          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #DDD8CF;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- STAGE 2 -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;">
          <div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #DDD8CF;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #DDD8CF;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="width:1.75rem;height:1.75rem;display:inline-flex;align-items:center;justify-content:center;color:#A9812E;flex-shrink:0;"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><use href={`#ic-${grp.icon}`}/></svg></span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0B0B0C;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:#A9812E;">0/{grpQs.length}</div>
                    </div>
                  </div>
                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #F5F0E8;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:rgba(169,129,46,0.06);color:#A9812E;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0B0B0C;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:#A9812E;font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:#A9812E;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #F5F0E8;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:#A9812E;line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#6B6860;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:#374151;font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#C8C3B8;"> - </span>
                    </div>
                    <div style="background:#F5F0E8;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#C8C3B8;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #F5F0E8;">
                <div style="font-size:0.75rem;color:#6B6860;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#F5F0E8;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#A9812E;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:#A9812E;border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- STAGE 3 -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://calendly.com/matt-nicholas-compliance365/30min" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />

  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';
      const STANDARD = 'DISP / ISM / IRAP (Defence Security)';
      const API_URL  = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';

      const GROUPS = [
        { key:'gov',  title:'Governance & DISP' },
        { key:'pers', title:'People & Physical Security' },
        { key:'tech', title:'Cyber & ISM Controls' },
        { key:'risk', title:'Risk & System Documentation' },
        { key:'irap', title:'IRAP Planning & Evidence' },
        { key:'cont', title:'Contracts, Suppliers & Hosting' },
      ];

      const QUESTIONS = [
        { id:'disp-scope',        group:'gov',  label:'DISP membership categories and target levels confirmed and documented with rationale' },
        { id:'security-off',      group:'gov',  label:'Security Officer formally appointed and reporting Defence-related risks to executive or board' },
        { id:'pspf',              group:'gov',  label:'Policies reviewed against PSPF with gaps tracked in an action register' },
        { id:'clearance',         group:'pers', label:'Staff handling sensitive information appropriately screened and hold required security clearances' },
        { id:'onboarding-offboarding', group:'pers', label:'JML process manages onboarding, movement and offboarding including access revocation and clearance updates' },
        { id:'training',          group:'pers', label:'Staff receive regular security awareness training covering DISP, classification handling and Defence obligations' },
        { id:'facility',          group:'pers', label:'Offices and facilities assessed for physical security aligned to DISP expectations' },
        { id:'classification-ctrl',group:'tech', label:'Classification and handling level for Defence information confirmed and documented' },
        { id:'ism-baseline',      group:'tech', label:'ISM control baseline selected with justified deviations documented and risk-accepted' },
        { id:'iat',               group:'tech', label:'Hardening, patching, malware protection and configuration baselines defined and applied consistently' },
        { id:'logging',           group:'tech', label:'Security logs centrally collected, monitored and retained aligned to ISM requirements' },
        { id:'vuln-mgmt',         group:'tech', label:'Vulnerability scanning and penetration testing performed with high-risk findings remediated' },
        { id:'incident',          group:'tech', label:'Incident response process covers Defence notification obligations, evidence retention and post-incident reviews' },
        { id:'system-desc',       group:'risk', label:'Current system description and architecture diagrams exist covering components, data flows and boundaries' },
        { id:'ssp',               group:'risk', label:'System Security Plan (SSP) documents ISM control implementation with named ownership' },
        { id:'srmp',              group:'risk', label:'Security Risk Management Plan (SRMP) identifies threats, risks and agreed treatments' },
        { id:'backup-dr',         group:'risk', label:'Backup, BC and DR arrangements tested regularly and appropriate for system classification' },
        { id:'ato',               group:'risk', label:'ATO pathway is clear — Authorising Authority identified and kept informed of risk' },
        { id:'scoping',           group:'irap', label:'IRAP scope and assessment type agreed including systems, environments and approach' },
        { id:'previous-irap',     group:'irap', label:'Previous IRAP recommendations and open findings tracked with current status known' },
        { id:'evidence',          group:'irap', label:'Central evidence workspace exists for organising and sharing material with IRAP assessor' },
        { id:'poam',              group:'irap', label:'POA&M or equivalent register tracks all findings to verified closure' },
        { id:'hosting',           group:'cont', label:'Hosting locations documented and assessed against Defence sovereign hosting requirements' },
        { id:'contracts',         group:'cont', label:'Contracts include security, confidentiality, incident notification and DISP obligations' },
        { id:'suppliers',         group:'cont', label:'Key suppliers identified with defined ISM responsibilities and assurance evidence obtained' },
      ];

      const TOTAL_Q = QUESTIONS.length;
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#A9812E' : (s < n ? '#16a34a' : '#DDD8CF');
            p.style.color = (s <= n) ? 'white' : '#6B6860';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('to-stage-2').addEventListener('click', function() {
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger','classification','timeline'];
          var reqIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];
          allIds.forEach(function(id) { var el = document.getElementById(id); if (el) env[id] = el.value ? el.value.trim() : ''; });
          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) { valid = false; el.style.borderColor = '#dc2626'; el.style.background = '#fef2f2'; }
            else { el.style.borderColor = '#C8C3B8'; el.style.background = 'white'; }
          });
          var errEl = document.getElementById('env-error');
          if (!valid) { errEl.style.display = 'block'; errEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white'; o.style.color = '#0B0B0C'; o.style.borderColor = '#C8C3B8';
            });
            btn.classList.add('active');
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'white'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'white'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the DISP/ISM/IRAP defence security readiness checklist. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') window.c365OpenChat(msg);
          });
        });

        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white'; o.style.color = '#0B0B0C'; o.style.borderColor = '#C8C3B8';
          });
          update();
        });

        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true; btn.textContent = 'Generating...';
          try { generatePDF(); await submitToApi(); setStage(3); }
          catch (err) { console.error(err); alert('Something went wrong — your PDF should still have downloaded.'); }
          finally { btn.disabled = false; btn.textContent = 'Generate PDF report'; }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => { if (state[id] !== null) { answered++; sum += state[id]; } });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { label: 'Not started', desc: 'Answer questions to score', color: '#6B6860' };
        if (score >= 86) return { label: 'IRAP-Ready', desc: 'Strong posture — focus on evidence packaging and assessor briefing', color: '#16a34a' };
        if (score >= 61) return { label: 'Nearly Ready', desc: 'Close remaining gaps and complete evidence packaging', color: '#A9812E' };
        if (score >= 31) return { label: 'Partially Ready', desc: 'Many controls in place — structured remediation needed', color: '#d97706' };
        return { label: 'High Risk', desc: 'Significant gaps — structured remediation required before IRAP', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#C8C3B8';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the DISP/ISM/IRAP defence security readiness checklist on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('Highest classification handled: ' + (env['classification'] || 'Not specified'));
        lines.push('Target timeline: ' + (env['timeline'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Domain scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) { lines.push('  [' + (state[q.id] === 1 ? 'PARTIAL' : 'NO') + '] ' + q.label); });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest DISP/ISM/IRAP gaps, what to prioritise, and what a realistic path to IRAP assessment looks like for my organisation?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);
        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#F5F0E8';
            el.style.color = a === total ? '#166534' : '#3A3632';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) { bar.style.width = '0%'; bar.style.background = '#C8C3B8'; pctEl.textContent = ' - '; pctEl.style.color = '#C8C3B8'; }
            else { bar.style.width = pct + '%'; bar.style.background = barColor(pct); pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct); }
          }
        });

        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone; btn.style.cursor = allDone ? 'pointer' : 'not-allowed'; btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone ? 'Click to generate and email your report' : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) { aiBtn.disabled = !allDone; aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed'; aiBtn.style.opacity = allDone ? '1' : '0.5'; }
      }

      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const lines = [];
        lines.push('=== DISP/ISM/IRAP READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Classification: ${env['classification'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        GROUPS.forEach(g => { const s = computeSection(g.key); lines.push(`  ${g.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`); });
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          lines.push(`[${v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED'}] ${q.label}`);
        });
        try {
          await fetch(API_URL, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: env['contact-name'] || env['org-name'] || 'Anonymous',
              email: env['contact-email'] || 'noreply@compliance365.com.au',
              subject: `DISP/ISM/IRAP Checklist - ${env['org-name'] || 'Anonymous'} - ${score}%`,
              message: lines.join('\n'),
            }),
          });
        } catch (err) { console.warn('API submission failed:', err); }
      }

      function generatePDF() {
        var jsPDFLib = window.jspdf || {};
        var jsPDF = jsPDFLib.jsPDF;
        if (!jsPDF) { alert('PDF library not loaded — please wait and try again.'); return; }
        var doc = new jsPDF('p','mm','a4');
        var W=210, LM=18, RM=16, CW=W-LM-RM, y=0;
        var PRIMARY=[30,64,175], GREEN=[5,150,105], AMBER=[180,110,0], RED=[200,30,30];
        var WHITE=[255,255,255], LIGHT=[248,250,252], MUTED=[100,116,139], DARK=[17,24,39];
        var comp=compute(), sc=comp.score, ansCount=comp.answered, band=getBand(sc,ansCount);
        var orgName=env['org-name']||'Your Organisation';
        var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
        var scoreCol=sc>=75?GREEN:sc>=50?AMBER:RED;
        var scoreBand=sc>=86?'IRAP-Ready':sc>=61?'Nearly Ready':sc>=31?'Partially Ready':'High Risk';
        doc.setFillColor(...PRIMARY); doc.rect(0,0,W,42,'F');
        doc.setFillColor(6,182,212); doc.rect(0,40,W,2,'F');
        var logoEl=document.getElementById('pdfLogo');
        doc.setTextColor(...WHITE); doc.setFont('helvetica','bold'); doc.setFontSize(18);
        if (logoEl&&logoEl.complete&&logoEl.naturalWidth>0) { doc.addImage(logoEl,'PNG',LM,8,20,20,undefined,'FAST'); doc.text('Compliance365',LM+24,18); }
        else { doc.text('Compliance365',LM,18); }
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text('DISP / ISM / IRAP Defence Security Readiness Report', LM+(logoEl&&logoEl.complete?24:0), 26);
        doc.setFontSize(9); doc.text(orgName+'  |  '+today, LM+(logoEl&&logoEl.complete?24:0), 34);
        y=56;
        doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,28,4,4,'F');
        doc.setFillColor(...scoreCol); doc.roundedRect(LM,y,6,28,2,2,'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(28); doc.setTextColor(...scoreCol);
        doc.text(sc+'%',LM+16,y+18);
        doc.setFontSize(12); doc.setTextColor(...DARK); doc.text(scoreBand,LM+44,y+12);
        doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(...MUTED);
        doc.text(band.desc,LM+44,y+19,{maxWidth:CW-50});
        doc.text(ansCount+'/'+TOTAL_Q+' questions answered',LM+44,y+25);
        y+=36;
        doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text('Domain Breakdown',LM,y); y+=6;
        GROUPS.forEach(function(grp) {
          var s=computeSection(grp.key), p=s.pct===null?0:s.pct, col=p>=75?GREEN:p>=50?AMBER:RED;
          doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,12,2,2,'F');
          doc.setFillColor(...col); doc.roundedRect(LM,y,4,12,1,1,'F');
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...DARK);
          doc.text(grp.title,LM+8,y+7.5);
          var barX=LM+CW-60, barW=50;
          doc.setFillColor(226,232,240); doc.roundedRect(barX,y+4,barW,4,1,1,'F');
          if (p>0) { doc.setFillColor(...col); doc.roundedRect(barX,y+4,barW*(p/100),4,1,1,'F'); }
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...col);
          doc.text(s.pct===null?'-':p+'%',barX+barW+4,y+7.5);
          y+=15;
        });
        y+=4;
        var gaps=QUESTIONS.filter(function(q){ return state[q.id]===0||state[q.id]===1; });
        if (gaps.length) {
          doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
          doc.text('Priority Gaps',LM,y); y+=6;
          gaps.forEach(function(q) {
            if (y>270) { doc.addPage(); y=16; }
            var v=state[q.id], col=v===0?RED:AMBER, lbl=v===0?'NO':'PARTIAL';
            doc.setFillColor(...(v===0?[255,225,225]:[255,241,194]));
            doc.roundedRect(LM,y,CW,10,2,2,'F');
            doc.setFillColor(...col); doc.roundedRect(LM,y,3,10,1,1,'F');
            var lines=doc.splitTextToSize(q.label,CW-40);
            doc.setFont('helvetica','normal'); doc.setFontSize(8.5); doc.setTextColor(...DARK);
            doc.text(lines,LM+7,y+6.5);
            doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.setTextColor(...col);
            doc.text(lbl,W-RM-14,y+6.5);
            y+=13;
          });
        }
        doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(...MUTED);
        doc.text('Generated by Compliance365  |  compliance365.com.au  |  DISP/ISM/IRAP Defence Security Readiness Report',LM,290);
        doc.save('disp_ism_irap_readiness_'+(orgName.replace(/[^a-z0-9]/gi,'-')||'report')+'.pdf');
      }
    })();
  </script>
</Base>
