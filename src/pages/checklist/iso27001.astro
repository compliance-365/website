---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27001 (Information Security)';

// One source of truth for questions (page markup)
const QUESTIONS = [
  // Governance & ISMS
  { id:'isms-scope',  label:'ISMS scope defined and approved (locations, systems, services, exclusions)?', group:'gov' },
  { id:'context',     label:'Business context, interested parties and security requirements documented?', group:'gov' },
  { id:'leadership',  label:'Top management roles, responsibilities and commitment for information security are defined and visible?', group:'gov' },
  { id:'policy',      label:'Information security policy and supporting policies approved, communicated and periodically reviewed?', group:'gov' },

  // Risk & Statement of Applicability
  { id:'risk-method', label:'Risk assessment methodology defined (criteria, likelihood/impact, appetite) and applied consistently?', group:'risk' },
  { id:'risk-reg',    label:'Information security risk register in place, with owners, treatments and review dates?', group:'risk' },
  { id:'controls',    label:'Annex A controls selected based on risk, legal/regulatory and contractual requirements?', group:'risk' },
  { id:'soa',         label:'Statement of Applicability (SoA) completed with justifications, control status and evidence locations?', group:'risk' },

  // Operations & Controls
  { id:'assets',      label:'Information assets, systems and services inventoried with assigned owners?', group:'ops' },
  { id:'access',      label:'Access control model defined (joiner/mover/leaver, least privilege, privileged access)?', group:'ops' },
  { id:'suppliers',   label:'Supplier/third-party security requirements defined and periodically reviewed?', group:'ops' },
  { id:'secure-dev',  label:'Secure change and development practices in place (change assessment, testing, approvals)?', group:'ops' },

  // Security Operations & Resilience
  { id:'logging',     label:'Security logging and monitoring in place for key systems, with alerting on suspicious activity?', group:'tech' },
  { id:'backup-dr',   label:'Backups, business continuity and disaster recovery plans tested and aligned to RTO/RPO targets?', group:'tech' },
  { id:'vuln-mgmt',   label:'Vulnerability management process in place (scanning, patching, remediation of high risks)?', group:'tech' },
  { id:'incident',    label:'Incident response plan defined, tested and improved after real incidents or exercises?', group:'tech' },

  // Monitoring, Audit & Improvement
  { id:'metrics',     label:'ISMS objectives and KPIs defined, measured and reported (e.g. incidents, audit findings, training)?', group:'imp' },
  { id:'iaudit',      label:'Internal ISMS audits performed to plan, with findings and corrective actions tracked to closure?', group:'imp' },
  { id:'mgmt-review', label:'Management reviews held covering risks, incidents, changes, audit results and improvement opportunities?', group:'imp' },
  { id:'improve',     label:'Continual improvement / corrective action log maintained for ISMS issues and opportunities?', group:'imp' }
];

const GROUPS = [
  { key:'gov',  title:'Governance & ISMS',              blurb:'Scope, context, leadership, policy and roles.' },
  { key:'risk', title:'Risk & Statement of Applicability', blurb:'Risk assessment, risk register, Annex A controls and SoA.' },
  { key:'ops',  title:'Operations & Controls',          blurb:'Assets, access, suppliers and secure change/development.' },
  { key:'tech', title:'Security Operations & Resilience', blurb:'Logging, backups/DR, vulnerability management and incidents.' },
  { key:'imp',  title:'Monitoring, Audit & Improvement',  blurb:'Metrics, internal audit, management review and improvements.' },
];
---

<Base
  title="ISO 27001 Free Information Security Readiness Checklist"
  description="Free ISO 27001 information security readiness checklist for CISOs, IT leaders and compliance owners. Assess ISMS maturity, see your readiness score and download a PDF roadmap to certification."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 27001 information security readiness checklist (free)</h1>
    <p class="muted" style="max-width:800px">
      Use this free ISO 27001 readiness checklist to quickly assess how mature your Information Security Management System (ISMS) is.
      Score governance, risk management, Annex A controls, security operations and continual improvement to see how ready you are
      for ISO 27001 certification or surveillance audit.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">
          Gauge ISO 27001 ISMS maturity and how ready your organisation is for internal review or external certification audit.
        </p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small"><strong>Yes / Partial / No</strong>. Progress and readiness update automatically across each domain.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown, top gaps and next-step guidance.</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill" aria-current="page">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 8px;">{q.label}</label>
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
(() => {
  'use strict';

  const STANDARD  = "ISO 27001 (Information Security)";
  const API_URL   = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  // Browser-side GROUPS
  const GROUPS = [
    { key:'gov',  title:'Governance & ISMS' },
    { key:'risk', title:'Risk & Statement of Applicability' },
    { key:'ops',  title:'Operations & Controls' },
    { key:'tech', title:'Security Operations & Resilience' },
    { key:'imp',  title:'Monitoring, Audit & Improvement' },
  ];

  // Browser-side QUESTIONS (with group keys) – must match server QUESTIONS
  const QUESTIONS = [
    { id:"isms-scope",  label:"ISMS scope defined and approved (locations, systems, services, exclusions)?", group:"gov" },
    { id:"context",     label:"Business context, interested parties and security requirements documented?", group:"gov" },
    { id:"leadership",  label:"Top management roles, responsibilities and commitment for information security are defined and visible?", group:"gov" },
    { id:"policy",      label:"Information security policy and supporting policies approved, communicated and periodically reviewed?", group:"gov" },

    { id:"risk-method", label:"Risk assessment methodology defined (criteria, likelihood/impact, appetite) and applied consistently?", group:"risk" },
    { id:"risk-reg",    label:"Information security risk register in place, with owners, treatments and review dates?", group:"risk" },
    { id:"controls",    label:"Annex A controls selected based on risk, legal/regulatory and contractual requirements?", group:"risk" },
    { id:"soa",         label:"Statement of Applicability (SoA) completed with justifications, control status and evidence locations?", group:"risk" },

    { id:"assets",      label:"Information assets, systems and services inventoried with assigned owners?", group:"ops" },
    { id:"access",      label:"Access control model defined (joiner/mover/leaver, least privilege, privileged access)?", group:"ops" },
    { id:"suppliers",   label:"Supplier/third-party security requirements defined and periodically reviewed?", group:"ops" },
    { id:"secure-dev",  label:"Secure change and development practices in place (change assessment, testing, approvals)?", group:"ops" },

    { id:"logging",     label:"Security logging and monitoring in place for key systems, with alerting on suspicious activity?", group:"tech" },
    { id:"backup-dr",   label:"Backups, business continuity and disaster recovery plans tested and aligned to RTO/RPO targets?", group:"tech" },
    { id:"vuln-mgmt",   label:"Vulnerability management process in place (scanning, patching, remediation of high risks)?", group:"tech" },
    { id:"incident",    label:"Incident response plan defined, tested and improved after real incidents or exercises?", group:"tech" },

    { id:"metrics",     label:"ISMS objectives and KPIs defined, measured and reported (e.g. incidents, audit findings, training)?", group:"imp" },
    { id:"iaudit",      label:"Internal ISMS audits performed to plan, with findings and corrective actions tracked to closure?", group:"imp" },
    { id:"mgmt-review", label:"Management reviews held covering risks, incidents, changes, audit results and improvement opportunities?", group:"imp" },
    { id:"improve",     label:"Continual improvement / corrective action log maintained for ISMS issues and opportunities?", group:"imp" }
  ];

  (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

  function setup(){
    const form       = document.getElementById('form');
    const bar        = document.getElementById('bar');
    const scoreNum   = document.getElementById('scoreNum');
    const scoreLabel = document.getElementById('scoreLabel');
    const scoreHint  = document.getElementById('scoreHint');
    const resetBtn   = document.getElementById('resetBtn');
    const pdfBtn     = document.getElementById('pdfBtn');

    const modal      = document.getElementById('leadModal');
    const leadForm   = document.getElementById('leadForm');
    const cancelLead = document.getElementById('cancelLead');
    const nameEl     = document.getElementById('name');
    const emailEl    = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    // Update group counters
    function refreshGroupCounters(){
      GROUPS.forEach(grp => {
        const total = QUESTIONS.filter(q=>q.group===grp.key).length;
        const ansd  = QUESTIONS.filter(q=>q.group===grp.key).map(q=>state[q.id]).filter(v=>v!==null).length;
        const el = document.getElementById('g-'+grp.key);
        if(el) el.textContent = `${ansd}/${total} answered`;
      });
    }
    refreshGroupCounters();

    // Click-to-answer
    form.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.opt'); if(!btn || !form.contains(btn)) return;
      const field = btn.closest('.field'); if(!field) return;
      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);
      state[id] = val;
      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');
      refreshGroupCounters();
      update();
    });

    // Reset
    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
      refreshGroupCounters();
      update();
    });

    // Open modal before PDF
    pdfBtn?.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if(modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

    // Submit → POST to API → ALWAYS generate PDF
    leadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name  = (nameEl?.value || '').trim();
      const email = (emailEl?.value || '').trim();

      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('Please enter your name and a valid email.');
        return;
      }

      const Q_MIN = QUESTIONS.map(q => ({ id: q.id, label: q.label, group: q.group }));
      const G_MIN = GROUPS.map(g => ({ key: g.key, title: g.title }));

      const payload = {
        name,
        email,
        subject: `Checklist lead: ${STANDARD}`,
        message: JSON.stringify({
          checklist: STANDARD,
          checklistId: 'iso27001',
          timestamp: new Date().toISOString(),
          ua: navigator.userAgent,
          ...compute(state),
          total: QUESTIONS.length,
          answers: state,
          questions: Q_MIN,
          groups: G_MIN
        })
      };

      try {
        if (!API_URL) throw new Error('API_URL missing');
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const txt = await res.text().catch(()=> '');
        if (!res.ok) {
          console.warn('[27001 lead] POST failed:', res.status, txt);
          alert('We could not notify our team automatically, but your PDF will still download.');
        }
      } catch (err) {
        console.warn('[27001 lead] POST error:', err);
        alert('We could not notify our team automatically, but your PDF will still download.');
      }

      // GA4 event
      try {
        const s = compute(state);
        if (window.gtag) {
          window.gtag('event', 'checklist_submit', {
            event_category: 'Checklist',
            event_label: STANDARD,
            checklist_standard: STANDARD,
            checklist_id: 'iso27001',
            answered: s.answered,
            score: s.score
          });
        }
      } catch (err) {
        console.warn('GA4 checklist_submit event failed', err);
      }

      closeModal();
      generatePDF(state, { name, email });
    });

    // active-chip style
    const s = document.createElement('style');
    s.textContent = `button.opt{cursor:pointer}
      button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
    document.head.appendChild(s);

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);
      bar.style.width = pct + '%';
      scoreNum.textContent = `${score}%`;

      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered>0 && score<40)      { label='Early stage';  hint='Lock ISMS scope, leadership and core security policies.'; }
      else if (score<70)               { label='In progress';  hint='Tighten risk register, SoA and key Annex A controls.'; }
      else if (score<90)               { label='Nearly ready'; hint='Finalise evidence, internal audit and management review.'; }
      else                             { label='Audit-ready';  hint='Maintain cadence on risks, metrics and continual improvement.'; }
      scoreLabel.textContent = label;
      scoreHint.textContent  = hint;
    }
  }

  function compute(state){
    const answered = Object.values(state).filter(v => v !== null).length;
    const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
    const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
    return { answered, score: isNaN(score) ? 0 : 0 + (isNaN(score) ? 0 : score) };
  }

  // ==== PDF (ISO 27001 flavour) ====
  function generatePDF(state, lead = {}) {
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ alert('PDF library not loaded.'); return; }

    const doc = new jsPDF('p','mm','a4');
    const W = 210, LM = 14, RM = 14; let y = 16;
    const now = new Date();
    const fmt = d => d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
    const hr  = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

    const vals      = Object.values(state);
    const answered  = vals.filter(v => v !== null).length;
    const scoreRaw  = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const score     = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
    const STATUS    = (answered===0)?'Not started' : (score<40)?'Early stage' : (score<70)?'In progress' : (score<90)?'Nearly ready' : 'Audit-ready';

    // Header band
    doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
    doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

    // Logo + title + subtitle
    try {
      const logoEl = document.getElementById('pdfLogo');
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);

      if (logoEl && logoEl.complete) {
        const targetW = 18;
        const ratio   = (logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
        const targetH = Math.min(18, targetW * ratio);
        doc.addImage(logoEl,'PNG',LM,6,targetW,targetH,undefined,'FAST');
        doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM + targetW + 4, 22);
      } else {
        doc.text('Compliance365 — Readiness Report', LM, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM, 22);
      }
    } catch (_) {
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text(`${STANDARD} quick-scan summary`, LM, 22);
    }

    // Date + Prepared for
    doc.setFontSize(10);
    doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
    if (lead?.name || lead?.email) {
      const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
      doc.text(prepared, W-RM, 22, { align:'right' });
    }

    // Summary + dial
    y = 38;
    doc.setTextColor(17,24,39); doc.setFont('helvetica','bold'); doc.setFontSize(13);
    doc.text('Your Readiness at a Glance', LM, y); y += 8;

    const dialX = LM + 26, dialY = y + 24;
    doc.setDrawColor(230,233,242); doc.setLineWidth(6);
    doc.circle(dialX, dialY, 20, 'S');
    doc.setDrawColor(79,70,229);
    const pct = Math.max(0,Math.min(score,100))/100;
    const segs = Math.max(1, Math.round(60*pct));
    for(let i=0;i<segs;i++){
      const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
      const a2 = a1 + 0.1;
      doc.line(
        dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
        dialX+20*Math.cos(a2), dialY+20*Math.sin(a2)
      );
    }
    doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
    doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
    doc.text('Status:',    LM+56, y+12);
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
    doc.text(STATUS, LM+74, y+12);

    // Tips (ISO 27001 flavoured)
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    doc.text('Next steps:', LM+56, y+20);
    const tips = (score<40)
      ? ['Confirm ISMS scope and context','Assign roles and approve core policies','Stand up basic risk register and SoA shell']
      : (score<70)
        ? ['Tighten risk assessments and Annex A coverage','Embed access, supplier and change controls','Strengthen logging and vulnerability management']
        : (score<90)
          ? ['Close open actions from audits/incidents','Complete management review with updated risks','Consolidate evidence in one place for audit']
          : ['Maintain metrics, reviews and continual improvement','Refresh risk assessment at least annually','Use audits and incidents to drive maturity'];
    tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, y+26 + i*5));

    y += 54;

    // Domain breakdown (built from GROUPS/QUESTIONS)
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Domain Breakdown', LM, y); y += 5;

    const DOMAINS = {};
    (Array.isArray(GROUPS)?GROUPS:[]).forEach(g => {
      DOMAINS[g.title] = (Array.isArray(QUESTIONS)?QUESTIONS:[])
        .filter(q => q.group === g.key)
        .map(q => q.id);
    });

    Object.entries(DOMAINS).forEach(([name, ids])=>{
      const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
      const max = ids.length * 2 || 1;
      const p   = Math.round((got/max)*100) || 0;

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      doc.text(name, LM, y+5);

      const barX = LM + 64, barW = W - LM - RM - 64;
      doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
      doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
      const fillW = Math.max(0, Math.min(barW*(p/100), barW));
      doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

      doc.setFont('helvetica','bold'); doc.setTextColor(70);
      doc.text(`${p}%`, barX + barW + 4, y+5);

      y += 11;
    });

    y = hr(y, 6);

    // Top Gaps & Risks – short labels by question
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Top Gaps & Risks', LM, y); y += 6;

    const GAP = {
      'isms-scope':'ISMS scope unclear or incomplete',
      'context':'Business context and interested parties not documented',
      'leadership':'Leadership roles/commitment not visible',
      'policy':'Information security policies not approved or reviewed',
      'risk-method':'Risk criteria/method not defined or followed',
      'risk-reg':'Risk register missing or out of date',
      'controls':'Annex A controls not selected based on risk',
      'soa':'SoA incomplete or not maintained',
      'assets':'Asset inventory incomplete or lacks owners',
      'access':'Access control and JML not standardised',
      'suppliers':'Supplier security expectations not defined or reviewed',
      'secure-dev':'Change/development not assessed for security',
      'logging':'Logging/monitoring not in place for key systems',
      'backup-dr':'Backups/DR not tested or misaligned with RTO/RPO',
      'vuln-mgmt':'Vulnerability management weak or ad hoc',
      'incident':'Incident response not defined or tested',
      'metrics':'ISMS KPIs/metrics not measured',
      'iaudit':'Internal audits not performed or followed up',
      'mgmt-review':'Management review not held or incomplete',
      'improve':'Continual improvement not tracked'
    };

    const highs = [], meds = [];
    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach(q=>{
      const v = state[q.id];
      if (v===0) highs.push(GAP[q.id] || q.label);
      else if (v===1) meds.push(GAP[q.id] || q.label);
    });

    const colW = (W - LM - RM - 6)/2;
    const drawList = (title, items, x, color) =>{
      if(items.length===0) return y;
      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(...color);
      doc.text(title, x, y);
      let yy = y + 4;
      doc.setFont('helvetica','normal'); doc.setTextColor(17,24,39); doc.setFontSize(10);
      items.forEach(t=>{
        const lines = doc.splitTextToSize(`- ${t}`, colW);
        doc.text(lines, x, yy);
        yy += lines.length*4.2 + 1.5;
      });
      return yy;
    };
    const yLeftEnd  = drawList('High (No): address immediately', highs, LM, [239,68,68]);
    const yRightEnd = drawList('Medium (Partial): tighten soon', meds, LM + colW + 6, [99,102,241]);
    y = Math.max(yLeftEnd, yRightEnd) + 4;

    y = hr(y, 4);

    // Detailed Responses
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Detailed Responses', LM, y); y += 5;

    const drawRow = (idx, text, val)=>{
      if(y>275){ doc.addPage(); y=16; }
      const wrapW = W - LM - RM - 40;
      const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
      const rowH  = 12 + Math.max(0, lines.length-1)*4.2;

      doc.setFillColor(245,247,255);
      doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(lines, LM+4, y+4);

      const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
      let fill=[229,231,235], txt=[107,114,128];
      if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
      else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
      else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      const pillW = Math.max(22, doc.getTextWidth(label) + 8);
      const chipX = W - RM - pillW - 4;
      const chipY = y - 1;
      doc.setDrawColor(222,226,236);
      doc.setFillColor(...fill);
      doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
      doc.setTextColor(...txt);
      doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

      y += rowH + 8;
    };

    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

    // CTA
    if(y>246){ doc.addPage(); y=16; }
    y += 4;
    const btnW = 178, btnH = 18, btnX = LM, btnY = y;
    doc.setFillColor(79,70,229);
    doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);
    doc.text('Need help closing gaps? Book a roadmap call', btnX + 6, btnY + 12);
    doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

    // Footer
    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
    doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

    doc.save('iso27001_readiness.pdf');
  }
})();
  </script>

