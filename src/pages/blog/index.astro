---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';

// Load all posts newest first
const posts = (await Astro.glob('../../content/blog/*.md'))
  .sort((a, b) =>
    new Date(b.frontmatter.date || 0).getTime() -
    new Date(a.frontmatter.date || 0).getTime()
  );

// Helpers
function coverUrl(img?: string) {
  if (!img) return null;
  if (/^https?:\/\//i.test(img)) return img;
  return `${base}${String(img).replace(/^\//, '')}`;
}

const slugify = (s: string) =>
  s.toLowerCase().trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

// Curated tag groups — plain-English topics, not framework codes, so readers
// who don't already know what "ISO 42001" means can still browse by subject.
// ISO 27001 + Essential Eight → Security · ISO 27701 → Privacy ·
// ISO 42001 + AI Governance → AI. SOC 2 and Risk are already plain enough.
const CURATED_TAGS: Record<string, string> = {
  'security':         'Security',
  'privacy':          'Privacy',
  'ai':               'AI',
  'soc-2':            'SOC 2',
  'risk-management':  'Risk',
};

// Build the curated filter list — only show tags that have at least 1 post
const curatedTagSlugs = Object.keys(CURATED_TAGS);

// Raw → curated slug mapper (consolidates duplicates and framework aliases)
function toCuratedSlug(raw: string): string {
  const s = slugify(raw);
  // Map aliases
  const aliases: Record<string, string> = {
    'iso-27001': 'security',
    'isms': 'security',
    'essential-eight': 'security',
    'iso-27701': 'privacy',
    'pims': 'privacy',
    'gdpr': 'privacy',
    'iso-42001': 'ai',
    'aims': 'ai',
    'ai-governance': 'ai',
    'artificial-intelligence': 'ai',
    'type-1': 'soc-2',
    'type-2': 'soc-2',
    'risk': 'risk-management',
    'compliance': '', // too generic — skip
    'saas': '',
    'governance': '',
    'microsoft-365': '',
    'australia': '',
    'revenue-impact': '',
    'enterprise-sales': '',
  };
  if (s in aliases) return aliases[s];
  if (s in CURATED_TAGS) return s;
  return '';
}

// Build post data with curated tag slugs
const postsWithMeta = posts.map(post => {
  const filename = post.file.split('/').pop() || '';
  const postSlug = filename.replace(/\.md$/i, '');
  /* astro.config sets trailingSlash: 'always', so the slash is not optional —
     without it every card here points at a URL the site does not serve. */
  const href = `${base}blog/${postSlug}/`;
  const img = coverUrl(post.frontmatter.image);
  const rawTags: string[] = post.frontmatter.tags || [];
  const curatedSlugs = [...new Set(rawTags.map(toCuratedSlug).filter(Boolean))];
  const displayTags = rawTags.slice(0, 3); // show up to 3 raw tags on card
  const date = post.frontmatter.date
    ? new Date(post.frontmatter.date).toLocaleDateString('en-AU', {
        day: '2-digit', month: 'long', year: 'numeric'
      })
    : '';
  return {
    href, img, postSlug, date,
    title: post.frontmatter.title || '',
    description: post.frontmatter.description || '',
    displayTags,
    curatedSlugs,
    dataTags: curatedSlugs.join(' '),
    dataTitle: (post.frontmatter.title || '').toLowerCase(),
    dataDesc: (post.frontmatter.description || '').toLowerCase(),
    dataRawTags: rawTags.join(' ').toLowerCase(),
  };
});

// Separate featured (newest) from rest
const [featured, ...restPosts] = postsWithMeta;

// Only include curated tags that have matching posts
const activeCuratedTags = curatedTagSlugs.filter(tag =>
  postsWithMeta.some(p => p.curatedSlugs.includes(tag))
);

// Group the "All articles" grid by primary topic so it's easier to browse —
// each post lands in the first curated tag it matches, in CURATED_TAGS order.
function primaryGroupOf(p: typeof restPosts[number]): string | null {
  for (const slug of curatedTagSlugs) {
    if (p.curatedSlugs.includes(slug)) return slug;
  }
  return null;
}
const groups = curatedTagSlugs
  .map(slug => ({
    slug,
    label: CURATED_TAGS[slug],
    posts: restPosts.filter(p => primaryGroupOf(p) === slug),
  }))
  .filter(g => g.posts.length > 0);
const ungrouped = restPosts.filter(p => primaryGroupOf(p) === null);

// JSON-LD
const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Compliance365 Insights',
  url: 'https://www.compliance365.com.au/blog/',
  description: 'Practical guidance on ISO 27001, Essential Eight, SOC 2, ISO 42001, and ISO 27701 for Australian organisations.',
  publisher: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
};
---

<Base
  title="Compliance Insights & Practitioner Guides | Compliance365"
  description="Practical, audit-ready guidance on ISO 27001, Essential Eight, SOC 2, ISO 42001, and ISO 27701 — with Microsoft 365 examples for Australian organisations."
  schema={[blogLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Blog', url: 'https://www.compliance365.com.au/blog/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <h1>Compliance insights for Australian organisations</h1>
      <p class="section-lead" style="max-width:720px;">
        Practical, audit-ready guidance on ISO 27001, Essential Eight, SOC 2, ISO 42001, and ISO 27701 — with Microsoft 365 examples and implementation patterns that pass auditor sampling.
      </p>
      <p style="max-width:720px;margin-top:1rem;">
        Written by practising consultants who run certification engagements for Australian healthcare, financial services, SaaS, and government-adjacent businesses. Every article covers implementation specifics — not framework summaries you could get from the standard itself.
      </p>

      <!-- Search -->
      <div style="margin-top:1.5rem;max-width:520px;">
        <label for="insights-search" class="visually-hidden">Search insights</label>
        <input
          id="insights-search"
          type="search"
          placeholder="Search — e.g. SOC 2 evidence, DPIA, Annex A…"
          style="width:100%;padding:12px 16px;border-radius:10px;border:1px solid rgba(216,186,120,.3);background:rgba(255,255,255,.04);color:#FAF7F1;font-size:0.95rem;outline:none;font-family:Manrope,system-ui,sans-serif;"
          autocomplete="off"
        />
      </div>

      <!-- Curated tag filter -->
      <div style="margin-top:1.25rem;display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;" id="tag-pills">
        <span style="font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;color:rgba(250,247,241,.62);">Filter:</span>
        {activeCuratedTags.map(tag => (
          <button
            type="button"
            class="pill filter-btn"
            data-tag={tag}
            aria-pressed="false"
            style="cursor:pointer;"
          >
            {CURATED_TAGS[tag]}
          </button>
        ))}
        <button
          type="button"
          class="pill filter-btn"
          data-clear="true"
          style="cursor:pointer;opacity:0.7;"
        >
          Clear
        </button>
        <span id="insights-count" style="font-size:0.85rem;margin-left:0.5rem;color:rgba(250,247,241,.5);" aria-live="polite"></span>
      </div>
    </div>
  </section>
  <style>
    /* Filter pills sit on the dark hero — override brand.css's light-mode .pill via ID specificity
       so the JS's inline style.background='' reset (on toggle-off) falls back to this, not the light default */
    #tag-pills .filter-btn { border: 1px solid rgba(216,186,120,.3); background: rgba(255,255,255,.04); color: #D8BA78; }
    #insights-search::placeholder { color: rgba(250,247,241,.4); }
  </style>

  <!-- FEATURED POST -->
  {featured && (
    <section class="section" id="featured-post" style="padding-top:0;">
      <div class="container">
        <p class="muted" style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1rem;">Latest</p>
        <a
          href={featured.href}
          class="card spot"
          style="text-decoration:none;color:inherit;display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:center;border-left:4px solid #A9812E;padding:2rem;"
          data-tags={featured.dataTags}
          data-title={featured.dataTitle}
          data-desc={featured.dataDesc}
          data-rawtags={featured.dataRawTags}
          data-href={featured.href}
          id="featured-card"
        >
          {featured.img && (
            <div style="border-radius:12px;overflow:hidden;aspect-ratio:16/9;background:#F5F0E8;">
              <img
                src={featured.img}
                alt={featured.title}
                loading="eager"
                style="width:100%;height:100%;object-fit:contain;"
              />
            </div>
          )}
          <div style={!featured.img ? 'grid-column:1/-1;' : ''}>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.75rem;">
              {featured.displayTags.map(t => (
                <span class="pill" style="font-size:0.7rem;padding:2px 8px;">{t}</span>
              ))}
            </div>
            <h2 style="margin:0 0 0.75rem;font-size:1.5rem;line-height:1.3;color:#0a1220;">
              {featured.title}
            </h2>
            <p class="muted" style="margin:0 0 1.25rem;line-height:1.6;">{featured.description}</p>
            <div style="display:flex;align-items:center;gap:1.5rem;">
              <span class="muted" style="font-size:0.85rem;">{featured.date}</span>
              <span style="color:var(--gold-ink);font-weight:600;font-size:0.9rem;">Read article →</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ALL POSTS GRID -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <p class="muted" style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1.5rem;">All articles</p>

      <div id="insights-grid">
        {groups.map(group => (
          <div class="cat-group" data-cat={group.slug}>
            <h3 class="cat-group__title">{group.label}</h3>
            <div class="cat-group__grid">
              {group.posts.map(post => (
                <article
                  class="card spot"
                  data-tags={post.dataTags}
                  data-title={post.dataTitle}
                  data-desc={post.dataDesc}
                  data-rawtags={post.dataRawTags}
                  data-href={post.href}
                  style="overflow:hidden;display:flex;flex-direction:column;padding:0;"
                >
                  {post.img && (
                    <a href={post.href} style="display:block;overflow:hidden;border-radius:10px 10px 0 0;background:#F5F0E8;">
                      <img
                        src={post.img}
                        alt={post.title}
                        loading="lazy"
                        style="width:100%;aspect-ratio:16/9;object-fit:contain;display:block;"
                      />
                    </a>
                  )}
                  <div style="padding:1.25rem 1.25rem 1rem;display:flex;flex-direction:column;flex:1;">
                    <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.6rem;">
                      {post.displayTags.map(t => (
                        <span class="pill" style="font-size:0.65rem;padding:2px 7px;">{t}</span>
                      ))}
                    </div>
                    <h3 style="margin:0 0 0.5rem;font-size:1rem;line-height:1.4;color:#0a1220;">
                      <a href={post.href} style="color:inherit;text-decoration:none;">{post.title}</a>
                    </h3>
                    <p class="muted" style="margin:0 0 1rem;font-size:0.875rem;line-height:1.55;flex:1;">
                      {post.description}
                    </p>
                    <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(10,18,32,0.07);padding-top:0.75rem;margin-top:auto;">
                      <span class="muted" style="font-size:0.8rem;">{post.date}</span>
                      <a href={post.href} style="color:var(--gold-ink);font-weight:600;font-size:0.8rem;text-decoration:none;">Read →</a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
        {ungrouped.length > 0 && (
          <div class="cat-group" data-cat="more">
            <h3 class="cat-group__title">More reading</h3>
            <div class="cat-group__grid">
              {ungrouped.map(post => (
                <article
                  class="card spot"
                  data-tags={post.dataTags}
                  data-title={post.dataTitle}
                  data-desc={post.dataDesc}
                  data-rawtags={post.dataRawTags}
                  data-href={post.href}
                  style="overflow:hidden;display:flex;flex-direction:column;padding:0;"
                >
                  {post.img && (
                    <a href={post.href} style="display:block;overflow:hidden;border-radius:10px 10px 0 0;background:#F5F0E8;">
                      <img
                        src={post.img}
                        alt={post.title}
                        loading="lazy"
                        style="width:100%;aspect-ratio:16/9;object-fit:contain;display:block;"
                      />
                    </a>
                  )}
                  <div style="padding:1.25rem 1.25rem 1rem;display:flex;flex-direction:column;flex:1;">
                    <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.6rem;">
                      {post.displayTags.map(t => (
                        <span class="pill" style="font-size:0.65rem;padding:2px 7px;">{t}</span>
                      ))}
                    </div>
                    <h3 style="margin:0 0 0.5rem;font-size:1rem;line-height:1.4;color:#0a1220;">
                      <a href={post.href} style="color:inherit;text-decoration:none;">{post.title}</a>
                    </h3>
                    <p class="muted" style="margin:0 0 1rem;font-size:0.875rem;line-height:1.55;flex:1;">
                      {post.description}
                    </p>
                    <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(10,18,32,0.07);padding-top:0.75rem;margin-top:auto;">
                      <span class="muted" style="font-size:0.8rem;">{post.date}</span>
                      <a href={post.href} style="color:var(--gold-ink);font-weight:600;font-size:0.8rem;text-decoration:none;">Read →</a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Empty state -->
      <div id="no-results" style="display:none;text-align:center;padding:4rem 0;">
        <p class="muted">No articles match that filter.</p>
        <button data-clear="true" class="filter-btn btn btn-outline" style="margin-top:1rem;cursor:pointer;">
          Clear filters
        </button>
      </div>
    </div>
  </section>
  <style>
    .cat-group { margin-bottom: 2.75rem; }
    .cat-group:last-child { margin-bottom: 0; }
    .cat-group__title {
      font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 1.15rem; color: #0B0B0C;
      margin: 0 0 1.1rem; padding-left: 14px; border-left: 3px solid #A9812E;
    }
    .cat-group__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.75rem; }
  </style>

  <!-- CTA STRIP -->
  <section style="background:#FAF7F1;padding:4rem 0;text-align:center;">
    <div class="container">
      <h2>Want tailored guidance for your organisation?</h2>
      <p class="muted" style="max-width:580px;margin:1rem auto 2rem;">
        These articles cover the general principles. A free 30-minute call will tell you what applies to your specific situation — and the fastest path forward.
      </p>
      <a href="https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled" class="btn btn-primary" target="_blank" rel="noopener">
        Book a free 30-min call
      </a>
    </div>
  </section>

  </main>

  <Footer />

  <script src={`${base}assets/fuse.min.js`} defer></script>

  <!-- Filtering logic — all state managed in vanilla JS -->
  <script is:inline>
    window.addEventListener('load', function () {
      const qs = new URLSearchParams(location.search);
      const grid = document.getElementById('insights-grid');
      const featuredCard = document.getElementById('featured-card');
      const featuredPost = document.getElementById('featured-post');
      const catGroups = Array.from(grid ? grid.querySelectorAll('.cat-group') : []);
      const allCards = [
        ...(featuredCard ? [featuredCard] : []),
        ...Array.from(grid ? grid.querySelectorAll('article') : [])
      ];
      const filterBtns = Array.from(document.querySelectorAll('.filter-btn[data-tag]'));
      const clearBtns = Array.from(document.querySelectorAll('.filter-btn[data-clear]'));
      const countEl = document.getElementById('insights-count');
      const emptyEl = document.getElementById('no-results');
      const searchInput = document.getElementById('insights-search');

      // Fuzzy search over title, description and raw tags — falls back to
      // plain substring matching if Fuse hasn't loaded yet.
      let fuse = null;
      if (typeof Fuse !== 'undefined') {
        const records = allCards.map((card, i) => ({
          i,
          title: card.getAttribute('data-title') || '',
          desc: card.getAttribute('data-desc') || '',
          tags: card.getAttribute('data-rawtags') || '',
        }));
        fuse = new Fuse(records, { keys: ['title', 'desc', 'tags'], threshold: 0.35 });
      }

      let activeTag = qs.get('tag') || '';
      let query = qs.get('q') || '';
      if (searchInput) searchInput.value = query;

      const setURL = () => {
        const url = new URL(location.href);
        activeTag ? url.searchParams.set('tag', activeTag) : url.searchParams.delete('tag');
        query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
        history.replaceState({}, '', url);
      };

      const applyFilter = () => {
        const q = query.toLowerCase().trim();
        let visible = 0;

        let matchedIdx = null;
        if (q) {
          if (fuse) {
            matchedIdx = new Set(fuse.search(q).map(r => r.item.i));
          } else {
            matchedIdx = new Set();
            allCards.forEach((card, i) => {
              const title = card.getAttribute('data-title') || '';
              const desc = card.getAttribute('data-desc') || '';
              if (title.includes(q) || desc.includes(q)) matchedIdx.add(i);
            });
          }
        }

        allCards.forEach((card, i) => {
          const tags = (card.getAttribute('data-tags') || '').split(/\s+/).filter(Boolean);
          const matchTag = !activeTag || tags.includes(activeTag);
          const matchQ = !matchedIdx || matchedIdx.has(i);
          const show = matchTag && matchQ;

          if (card === featuredCard) {
            // Hide/show the whole featured section
            if (featuredPost) featuredPost.style.display = show ? '' : 'none';
          } else {
            card.style.display = show ? '' : 'none';
          }
          if (show) visible++;
        });

        // Hide any topic group left with zero visible articles
        catGroups.forEach(group => {
          const hasVisible = Array.from(group.querySelectorAll('article'))
            .some(a => a.style.display !== 'none');
          group.style.display = hasVisible ? '' : 'none';
        });

        // Update button states
        filterBtns.forEach(b => {
          const isActive = b.getAttribute('data-tag') === activeTag;
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          b.style.background = isActive ? '#A9812E' : '';
          b.style.color = isActive ? 'white' : '';
        });

        if (countEl) countEl.textContent = visible > 0 ? `${visible} article${visible > 1 ? 's' : ''}` : '';
        if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';
      };

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-tag');
          activeTag = activeTag === tag ? '' : tag;
          setURL();
          applyFilter();
        });
      });

      clearBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          activeTag = '';
          query = '';
          if (searchInput) searchInput.value = '';
          setURL();
          applyFilter();
        });
      });

      if (searchInput) {
        let timer;
        searchInput.addEventListener('input', () => {
          clearTimeout(timer);
          timer = setTimeout(() => {
            query = searchInput.value || '';
            setURL();
            applyFilter();
          }, 200);
        });
      }

      applyFilter();
    });
  </script>

</Base>
