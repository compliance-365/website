---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
---

<Base
  title="AI Governance Readiness (ISO 42001) — Compliance365"
  description="Model inventory, AI risk, human oversight and monitoring—practical roadmap for business. Build your AI management system aligned to ISO 42001."
>
  <Header />

  <section class="container section">
    <div class="grid-2" style="align-items:start">
      <div>
        <h1>AI Governance Readiness (ISO 42001)</h1>
        <p class="muted" style="max-width:720px">
          The standard for managing artificial intelligence is here. ISO 42001 asks for a complete AI Management System (AIMS): policy, model inventory, risk evaluation, human oversight, monitoring and continuous improvement.
          We show how you can stand this up using tools you already own — no overhaul, just smart alignment.
        </p>

        <!-- What you’ll gain -->
        <div class="grid-3" style="margin-top:14px">
          <div class="card"><h3>Model inventory</h3><p class="muted">One central register of every AI/ML model: purpose, data sources, risk tier, deployment environment.</p></div>
          <div class="card"><h3>AI risk & evaluations</h3><p class="muted">Identify risks like bias, leakage or misuse. Apply evaluation checklists, red teams and track outcomes.</p></div>
          <div class="card"><h3>Human oversight & monitoring</h3><p class="muted">Define when human-in-the-loop applies. Capture approvals, incidents, performance metrics in one workflow.</p></div>
        </div>

        <!-- Evidence patterns -->
        <div class="card" style="margin-top:14px">
          <h3 style="margin:0 0 8px">Evidence patterns (Microsoft 365 ready)</h3>
          <ul class="muted" style="margin:0;padding-left:1.1rem">
            <li>SharePoint library per model: inventory records, risk evaluations, oversight approvals, incident logs.</li>
            <li>Power Automate snapshots: monthly copies of critical logs/configs, stored in date-folder structure for audit trace.</li>
            <li>Sentinel/Defender analytics queries saved as audit artefacts: monitoring of model drift, anomalous output patterns, usage deviations.</li>
          </ul>
        </div>

        <!-- Call to action -->
        <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href={`${base}book`}>See a sample AIMS in Microsoft 365</a>
          <a class="btn btn-ghost" href={`${base}resources`}>Back to resources</a>
        </div>
      </div>

      <aside class="card" style="position:sticky;top:84px">
        <h3 style="margin:0 0 6px">Quick wins</h3>
        <ol class="muted" style="margin:0;padding-left:1.1rem">
          <li>Centralise all AI/ML models in a register with purpose, owner and risk tier.</li>
          <li>Define an evaluation checklist for high-risk models: bias, security, compliance, explainability.</li>
          <li>Set up human oversight thresholds & incident workflow – eg: automatic review if model output changes > X% or user complaints > Y/month.</li>
        </ol>
      </aside>
    </div>
  </section>

  <!-- What is ISO 42001? -->
  <section class="container section bg-light">
    <h2>What is ISO 42001?</h2>
    <p class="muted" style="max-width:820px">
      ISO 42001 is the international standard for artificial intelligence management systems. It extends ISO 27001 principles into the AI sphere: governance, risk, monitoring and improvement. Organisations that adopt ISO 42001 are better placed to manage AI safely, build trust with customers and satisfy regulators.
    </p>
    <div class="grid-2" style="margin-top:14px">
      <div class="card">
        <h3>Why your business needs it</h3>
        <p class="muted small">AI and ML are no longer nice-to-have — they are embedded in services, automation and decision-making. Poor governance leads to privacy breaches, model misuse and regulatory fines.</p>
      </div>
      <div class="card">
        <h3>What it covers</h3>
        <p class="muted small">Policy framework, model catalogue, risk classification, data governance, human oversight, continuous monitoring and improvement.</p>
      </div>
    </div>
  </section>

  <!-- Key components of an AIMS -->
  <section class="container section">
    <h2>Key components of an AI Management System (AIMS)</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>1. Policy & governance</h3>
        <p class="muted small">Establish governance roles (AI committee, model owner), define strategy, align with business objectives.</p>
      </div>
      <div class="card">
        <h3>2. Model inventory & classification</h3>
        <p class="muted small">Maintain register of models: purpose, training data, deployment, risk tier (low/medium/high).</p>
      </div>
      <div class="card">
        <h3>3. Risk assessment & controls</h3>
        <p class="muted small">Evaluate each model’s risks (bias, security, compliance). Apply controls proportional to risk tier.</p>
      </div>
      <div class="card">
        <h3>4. Human oversight</h3>
        <p class="muted small">Define when humans must intervene, review model outcomes, approve deployments and log decisions.</p>
      </div>
      <div class="card">
        <h3>5. Monitoring & measurement</h3>
        <p class="muted small">Track performance, drift, anomalies...</p>
      </div>
      <div class="card">
        <h3>6. Continuous improvement</h3>
        <p class="muted small">Review metrics, update inventory, refine controls and conduct audits/assessments annually or on change.</p>
      </div>
    </div>
  </section>

<!-- Top AI Risks Businesses Should Manage -->
<section class="container section">
  <h2>Top AI Risks Every Organisation Should Manage</h2>
  <p class="muted" style="max-width:820px">
    Beyond technical concerns, AI introduces real business risks — from data leakage to ethical misuse.
    ISO 42001 helps you identify, assess and treat these risks before they impact trust or compliance.
  </p>

  <div class="grid-3" style="margin-top:14px">
    <div class="card">
      <h3>1. Data Leakage</h3>
      <p class="muted small">
        Employees may paste sensitive company data or source code into public AI tools like ChatGPT, 
        exposing intellectual property.  
        <em>Mitigation:</em> Train staff, use private AI instances, and apply data loss prevention (DLP).
      </p>
    </div>

    <div class="card">
      <h3>2. Model Bias & Fairness</h3>
      <p class="muted small">
        AI outputs can unintentionally discriminate or misrepresent.  
        <em>Mitigation:</em> Apply fairness evaluations, diverse datasets, and independent bias testing.
      </p>
    </div>

    <div class="card">
      <h3>3. Transparency & Explainability</h3>
      <p class="muted small">
        Decisions made by opaque models can damage reputation and breach regulation.  
        <em>Mitigation:</em> Document model logic, decisions, and assumptions for auditors and users.
      </p>
    </div>

    <div class="card">
      <h3>4. Unauthorized AI Use</h3>
      <p class="muted small">
        Shadow AI systems may appear in business units without approval.  
        <em>Mitigation:</em> Maintain a model inventory and require registration before deployment.
      </p>
    </div>

    <div class="card">
      <h3>5. Output Reliability & Hallucinations</h3>
      <p class="muted small">
        Generative models may produce false or misleading content.  
        <em>Mitigation:</em> Enforce human-in-the-loop validation for high-impact use cases.
      </p>
    </div>

    <div class="card">
      <h3>6. Regulatory & Privacy Breach</h3>
      <p class="muted small">
        AI processing of personal data may breach privacy laws (APPs, GDPR).  
        <em>Mitigation:</em> Conduct privacy impact assessments and use ISO 27701 alignment.
      </p>
    </div>

    <div class="card">
      <h3>7. Model Drift & Performance Degradation</h3>
      <p class="muted small">
        Models degrade as data and environments evolve.  
        <em>Mitigation:</em> Monitor accuracy and retrain on validated data regularly.
      </p>
    </div>

    <div class="card">
      <h3>8. Ethical & Reputational Harm</h3>
      <p class="muted small">
        Poorly governed AI decisions can cause public backlash and loss of trust.  
        <em>Mitigation:</em> Embed ethical principles and review boards in your AIMS governance model.
      </p>
    </div>
  </div>
</section>

  <!-- Checklist / next steps -->
  <section class="container section bg-light">
    <h2>Readiness checklist — start here</h2>
    <p class="muted" style="max-width:820px">
      Use this checklist as your first sprint. It aligns to ISO 42001 in practical steps you can track and measure.
    </p>
    <div class="card" style="margin-top:14px">
      <ul class="muted small" style="padding-left:1.1rem">
        <li>✅ Create model registry template and log all current models</li>
        <li>✅ Identify all internal/external stakeholders and assign owners</li>
        <li>✅ Draft AI governance policy and assign executive sponsor</li>
        <li>✅ Classify models as Low/Medium/High risk and prioritise high-risk for evaluation</li>
        <li>✅ Set monthly scorecard for model performance, drift, incidents and owner sign-off</li>
        <li>✅ Conduct a tabletop exercise for a model failure scenario (e.g., biased output, data leak)</li>
        <li>✅ Document human-in-the-loop thresholds and escalation process</li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Ready to build your AI governance framework?</h3>
        <p class="muted" style="margin:0">We help organisations design, implement and monitor an AI management system aligned to ISO 42001 and business goals.</p>
      </div>
      <a class="btn btn-primary" href={`${base}book`}>Start your roadmap</a>
    </div>
  </section>

  <Footer />
</Base>
