---
// CinematicBackground — dependency-free WebGL scene used behind dark sections.
// Layers: volumetric gold haze, a receding "governed plane" grid, rising
// evidence motes, and a slow audit-scan sweep. Falls back to a static CSS
// gradient when WebGL is unavailable, and renders a single still frame for
// prefers-reduced-motion users (or any page that opts into `static`, so the
// animated loop — and its ongoing GPU cost — is reserved for the homepage).
interface Props {
  static?: boolean;
}
const { static: isStatic = false } = Astro.props;
---
<div class="cinebg" aria-hidden="true">
  <div class="cinebg-fallback"></div>
  <canvas data-cinebg data-cinebg-static={isStatic ? '1' : undefined}></canvas>
</div>
{!isStatic && (
  /* WCAG 2.2.2 (Pause, Stop, Hide) wants a mechanism to stop motion that
     runs for more than five seconds, and this loop runs indefinitely.
     prefers-reduced-motion covers the people who have set it, but it is a
     preference, not a control, so it does not satisfy the criterion on its
     own. Deliberately a sibling of .cinebg rather than a child: that
     container is aria-hidden, and a focusable control inside aria-hidden
     is reachable by keyboard while invisible to assistive tech.

     Ships hidden and is revealed by the script only once the animated
     loop is actually running — so it never appears for a reduced-motion
     visitor, a static instance, or a browser that fell back to the CSS
     gradient because WebGL was unavailable. A control that does nothing
     is worse than no control. */
  <button
    type="button"
    class="cinebg-toggle"
    data-cinebg-toggle
    data-paused="false"
    hidden
    aria-label="Pause background animation"
    data-label-play="Play background animation"
    data-label-pause="Pause background animation"
  >
    <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
    </svg>
    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8 5v14l11-7z" />
    </svg>
  </button>
)}

<style>
  .cinebg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .cinebg-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 72% 112%, rgba(169, 129, 46, 0.18), transparent 62%),
      radial-gradient(90% 70% at 12% -12%, rgba(216, 186, 120, 0.06), transparent 55%),
      #0B0B0C;
  }
  .cinebg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s ease 0.15s;
  }
  .cinebg canvas.on { opacity: 1; }

  /* Sits inside the hero (which is position:relative), top-right, clear of
     both the sticky header above and the fixed chat widgets at the bottom
     of the viewport. 44px to meet the minimum tap target. */
  .cinebg-toggle {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(250, 247, 241, 0.25);
    background: rgba(11, 11, 12, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #FAF7F1;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .cinebg-toggle[hidden] { display: none; }
  .cinebg-toggle:hover,
  .cinebg-toggle:focus-visible {
    background: rgba(11, 11, 12, 0.8);
    border-color: rgba(216, 186, 120, 0.6);
  }
  .cinebg-toggle svg { width: 16px; height: 16px; }
  .cinebg-toggle .icon-play { display: none; }
  .cinebg-toggle[data-paused="true"] .icon-play { display: block; }
  .cinebg-toggle[data-paused="true"] .icon-pause { display: none; }
</style>

<script>
  const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';

  const FRAG = `
precision highp float;
uniform vec2 uRes;
uniform float uTime;
uniform vec2 uMouse;
uniform float uPulse;
uniform float uFade;

float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
float noise(vec2 p){
  vec2 i=floor(p), f=fract(p);
  vec2 u=f*f*(3.0-2.0*f);
  return mix(mix(hash(i),hash(i+vec2(1.,0.)),u.x),
             mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),u.x),u.y);
}
float fbm(vec2 p){
  float v=0.0, a=0.5;
  for(int i=0;i<__OCT__;i++){ v+=a*noise(p); p=p*2.03+vec2(17.0); a*=0.55; }
  return v;
}

void main(){
  vec2 frag=gl_FragCoord.xy;
  vec2 uv=(frag-0.5*uRes)/uRes.y;
  uv+=uMouse*0.045;
  float t=uTime;

  vec3 ink=vec3(0.043,0.043,0.049);
  vec3 gold=vec3(0.663,0.506,0.180);
  vec3 goldL=vec3(0.847,0.729,0.471);

  /* base — ink, faintly warmer toward the lower third */
  float warm=1.0-smoothstep(-0.6,0.9,uv.y);
  vec3 col=ink*(1.0+0.10*warm);

  /* volumetric gold haze — slow-drifting light, brightens on framework hover */
  float n1=fbm(vec2(uv.x*1.3-t*0.020, uv.y*2.0+t*0.012));
  float n2=fbm(vec2(uv.x*0.7+t*0.013, uv.y*1.1-t*0.009)+7.3);
  float band=1.0-smoothstep(0.03,0.62,abs(uv.y+0.24+(n1-0.5)*0.55));
  col+=gold*band*(n1*n1)*0.15*(1.0+0.8*uPulse);
  col+=gold*0.045*n2*(1.0-smoothstep(-0.2,1.1,uv.y));

  /* the governed plane — perspective grid receding to the horizon */
  float horizon=-0.14;
  float py=horizon-uv.y;
  if(py>0.001){
    float z=0.22/py;
    vec2 gp=vec2(uv.x*z*2.2, z+t*0.05);
    float lx=pow(0.5+0.5*cos(gp.x*6.28318),40.0);
    float lz=pow(0.5+0.5*cos(gp.y*6.28318),40.0);
    float fade=smoothstep(0.0,0.35,py)*exp(-z*0.32);
    col+=gold*(lx+lz)*fade*0.13*(1.0+1.1*uPulse);
  }

  /* a second, deeper plane — different horizon, scale and drift speed so it
     reads as further away rather than doubling the same grid */
  float horizon2=-0.05;
  float py2=horizon2-uv.y;
  if(py2>0.001){
    float z2=0.34/py2;
    vec2 gp2=vec2(uv.x*z2*1.5, z2+t*0.018);
    float lx2=pow(0.5+0.5*cos(gp2.x*3.76991),50.0);
    float lz2=pow(0.5+0.5*cos(gp2.y*3.76991),50.0);
    float fade2=smoothstep(0.0,0.4,py2)*exp(-z2*0.4);
    col+=gold*(lx2+lz2)*fade2*0.06*(1.0+0.6*uPulse);
  }

  /* audit scan — a thin gold line sweeping down every ~30s, eases out as the scene scrolls off */
  float sp=fract(t*0.033);
  float sy=0.62-sp*1.5;
  float scanEnv=smoothstep(0.0,0.12,sp)*(1.0-smoothstep(0.85,1.0,sp));
  float scanCore=exp(-abs(uv.y-sy)*110.0);
  float scanGlow=exp(-abs(uv.y-sy)*18.0);
  col+=goldL*scanCore*0.10*uFade*scanEnv;
  col+=goldL*scanGlow*0.045*uFade*scanEnv;

  /* rising evidence motes — two parallax layers, eases out as the scene scrolls off */
  for(int L=0;L<2;L++){
    float fl=float(L);
    float sc=5.0+fl*3.0;
    vec2 pv=uv*sc+vec2(fl*13.7,-t*(0.045+fl*0.03));
    vec2 id=floor(pv);
    vec2 f=fract(pv)-0.5;
    float rnd=hash(id);
    vec2 off=vec2(hash(id+4.1),hash(id+9.7))-0.5;
    float d=length(f-off*0.7);
    float tw=0.5+0.5*sin(t*(0.4+rnd*1.2)+rnd*6.28);
    float m=smoothstep(0.045+0.02*fl,0.0,d)*step(0.55,rnd);
    col+=goldL*m*tw*(0.10-fl*0.035)*uFade;
  }

  /* vignette */
  float vig=1.0-smoothstep(0.25,1.15,length(uv*vec2(0.9,1.2)));
  col*=mix(0.52,1.0,vig);

  /* film grain */
  col+=(hash(frag+fract(t)*vec2(13.1,7.7))-0.5)*0.02;

  gl_FragColor=vec4(col,1.0);
}`;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Shared, smoothed pointer state for all instances
  let px = 0, py = 0;
  window.addEventListener('pointermove', (e) => {
    px = e.clientX / window.innerWidth - 0.5;
    py = e.clientY / window.innerHeight - 0.5;
  }, { passive: true });

  function compile(gl, type, src) {
    const s = gl.createShader(type);
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) return null;
    return s;
  }

  function init(canvas) {
    const isStatic = !!canvas.dataset.cinebgStatic;
    // Interior pages render one still frame, so their GPU cost is a rounding
    // error — the budget that frees up gets reinvested in the page(s) that
    // still run the live loop: richer noise, sharper resolution.
    const hq = !isStatic;

    const gl = canvas.getContext('webgl', {
      alpha: false, antialias: false, depth: false, stencil: false,
      powerPreference: 'low-power'
    });
    if (!gl) return;

    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG.replace('__OCT__', hq ? '6' : '4'));
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uTime = gl.getUniformLocation(prog, 'uTime');
    const uMouse = gl.getUniformLocation(prog, 'uMouse');
    const uPulse = gl.getUniformLocation(prog, 'uPulse');
    const uFade = gl.getUniformLocation(prog, 'uFade');

    // Render at reduced resolution — the scene is soft light; grain hides it.
    // Narrower viewports (phones) get an extra cut: same GPU-bound cost per pixel,
    // weaker mobile GPUs, and a smaller canvas that hides the drop in fidelity.
    // The live (hq) instance gets a sharper cap since it's the only one running continuously.
    const narrow = window.innerWidth < 640;
    const scale = hq
      ? Math.min(window.devicePixelRatio || 1, 2) * (narrow ? 0.7 : 1.0)
      : Math.min(window.devicePixelRatio || 1, 1.5) * (narrow ? 0.55 : 0.75);
    function resize() {
      const w = Math.max(1, Math.round(canvas.clientWidth * scale));
      const h = Math.max(1, Math.round(canvas.clientHeight * scale));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    }
    resize();
    new ResizeObserver(resize).observe(canvas);

    let mx = 0, my = 0;
    const t0 = performance.now() - Math.random() * 40000;

    function render(t, pulse, fade) {
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, t);
      gl.uniform2f(uMouse, mx, -my);
      gl.uniform1f(uPulse, pulse);
      gl.uniform1f(uFade, fade);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    if (reduced || isStatic) {
      render(24.0, 0, 1);
      canvas.classList.add('on');
      return;
    }

    // Pulse the scene when a visitor hovers a framework on the hero's 3D ring —
    // dispatched by index.astro; harmless no-op if that script never loads.
    let pulse = 0, pulseTarget = 0;
    window.addEventListener('cinebg:pulse', (e) => {
      pulseTarget = e.detail && e.detail.active ? 1 : 0;
    });

    // Ease the scan-line/particle motion out as the scene scrolls past the viewport.
    function scrollFade() {
      const r = canvas.getBoundingClientRect();
      const vh = window.innerHeight;
      if (r.bottom <= 0 || r.top >= vh) return 0;
      const visible = Math.min(r.bottom, vh) - Math.max(r.top, 0);
      return Math.max(0, Math.min(1, visible / Math.min(r.height, vh)));
    }

    let visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(canvas);

    // Pausing stops scheduling frames altogether rather than rendering
    // nothing each frame, so the GPU genuinely goes idle. `origin` absorbs
    // the paused interval, so resuming continues the scene from where it
    // stopped instead of jumping forward by however long it was paused.
    let paused = false;
    let origin = t0;
    let pausedAt = 0;
    let frame = 0;

    function tick(now) {
      frame = requestAnimationFrame(tick);
      if (!visible || document.hidden) return;
      mx += (px - mx) * 0.04;
      my += (py - my) * 0.04;
      pulse += (pulseTarget - pulse) * 0.06;
      render((now - origin) / 1000, pulse, scrollFade());
    }
    frame = requestAnimationFrame(tick);
    canvas.classList.add('on');

    // The control lives beside .cinebg, as a child of the hero.
    const toggle = canvas.closest('.cinebg')
      ?.parentElement?.querySelector(':scope > [data-cinebg-toggle]');
    if (!toggle) return;

    function setPaused(next) {
      paused = next;
      toggle.dataset.paused = String(paused);
      toggle.setAttribute(
        'aria-label',
        paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause
      );
      if (paused) {
        pausedAt = performance.now();
        cancelAnimationFrame(frame);
      } else {
        origin += performance.now() - pausedAt;
        frame = requestAnimationFrame(tick);
      }
    }

    toggle.addEventListener('click', () => setPaused(!paused));
    // Only now that it controls a running loop is it worth showing.
    toggle.hidden = false;
  }

  document.querySelectorAll('canvas[data-cinebg]').forEach((c) => {
    if (!c.dataset.cinebgInit) {
      c.dataset.cinebgInit = '1';
      try { init(c); } catch (e) { /* fallback gradient stays visible */ }
    }
  });
</script>
