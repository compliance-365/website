---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// Your images (place in public/assets/)
const images = {
  winDeals: `${base}assets/win-deals-faster-illustration.png`,
  procurement: `${base}assets/procurement-no-friction.png`,
  confidence: `${base}assets/confidence-when-asked.png`,
  fourPhases: `${base}assets/4phases.png`,
  fearsInfographic: '/assets/3-fears-infographic.png',
  // Optional: controls diagram if you still want it later
  // controlsDiagram: `${base}assets/controls-mapping-diagram.png`,
};

// ... (keep your existing JSON-LD, announcement, fears, desires, compare, phases, services, servicePills data)
---

<Base
  title="Enterprise Compliance That Closes Deals Faster — Compliance365"
  description="ISO 27001, SOC 2, ISO 42001 AI Governance, Essential Eight — delivered in weeks, inside your environment, revenue-focused. Stop losing deals to compliance delays."
>
  <Header />

  <!-- Announcement -->
  <div class="announce">
    <div class="container">
      <span>Cyber • Privacy • AI Governance • SOC 2 • Essential Eight • Built for SaaS & Tech Teams • No New Tools Needed</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Enterprise Compliance<br>That Closes Deals Faster</h1>
        <p class="hero-sub">Guaranteed ISO 27001, SOC 2, AI Governance & Privacy — in weeks, inside your stack, at a fraction of the cost.</p>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn btn-primary">Book Free Strategy Call</a>
          <a href={`${base}checklist/`} class="btn btn-outline">Get Your Free Score</a>
        </div>

        <div class="trust-badges">
          <span>No New Tools</span>
          <span>No Engineering Disruption</span>
          <span>Revenue-First Approach</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 BIGGEST FEARS -->
<section class="section fears">
  <div class="container">
    <h2>The 3 Biggest Fears Killing Enterprise Deals</h2>
    <p class="section-lead">
      Strong product. Strong pipeline. Still losing revenue because compliance proof can't be delivered fast and credibly.
    </p>
    <img
  src={images.fearsInfographic}
  alt="The 3 Biggest Fears Killing Your Deals infographic"
  class="full-width-image"
  loading="lazy"
/>
  </div>
</section>

  <!-- WHAT CLIENTS REALLY WANT (using your 3 images) -->
  <section class="section desires">
    <div class="container">
      <h2>What Enterprise Buyers Really Want</h2>
      <p class="section-lead">Confidence. Consistency. Evidence. Calm teams — not chaos.</p>

      <div class="desire-grid">
        <div class="desire-card">
          <img src={images.winDeals} alt="Win deals faster illustration" loading="lazy" />
          <h3>Win Deals Faster</h3>
          <p>Security, privacy & AI compliance should accelerate revenue — not delay pipeline velocity by months.</p>
        </div>

        <div class="desire-card">
          <img src={images.procurement} alt="Procurement without friction illustration" loading="lazy" />
          <h3>Frictionless Procurement</h3>
          <p>Weeks, not months. Predictable timelines. Defensible evidence that lets procurement confidently say yes.</p>
        </div>

        <div class="desire-card">
          <img src={images.confidence} alt="Confidence when asked hard questions illustration" loading="lazy" />
          <h3>Instant Confidence</h3>
          <p>Clear, auditor-grade answers in minutes — no scrambling, no credibility gaps, no last-minute fire drills.</p>
        </div>
      </div>
    </div>
  </section>

<!-- COMPLIANCEREADY COMPARISON - Fixed & Professional -->
<section class="section compare-section">
  <div class="container">
    <div class="section-head center">
      <h2>Why Teams Choose ComplianceReady™</h2>
      <p class="section-lead muted">
        Stop wasting time and money on outdated approaches. See how ComplianceReady™ delivers faster, cleaner, revenue-enabling compliance.
      </p>
    </div>

    <!-- Responsive comparison table -->
    <div class="comparison-table">
      <div class="compare-header">
        <div class="compare-cell bad">Traditional Consultants & Tools</div>
        <div class="compare-cell good">ComplianceReady™</div>
      </div>

      <div class="compare-row">
        <div class="compare-cell bad">6–18 month timelines</div>
        <div class="compare-cell good">Weeks, not months</div>
      </div>

      <div class="compare-row">
        <div class="compare-cell bad">Heavy engineering disruption</div>
        <div class="compare-cell good">Zero disruption – inside your existing environment</div>
      </div>

      <div class="compare-row">
        <div class="compare-cell bad">High six-figure costs</div>
        <div class="compare-cell good">Fraction of the cost</div>
      </div>

      <div class="compare-row">
        <div class="compare-cell bad">Generic templates that don’t fit</div>
        <div class="compare-cell good">Targeted, minimal remediation</div>
      </div>

      <div class="compare-row">
        <div class="compare-cell bad">New tools forced on teams</div>
        <div class="compare-cell good">No new tools or licenses required</div>
      </div>
    </div>

    <!-- Trust line + strong CTA -->
    <div class="cta-center" style="text-align:center; margin-top:4rem;">
      <p class="muted small" style="margin-bottom:1.5rem;">
        Trusted by SaaS and tech teams that need compliance to accelerate — not slow down — growth.
      </p>
      <a href={ctaUrl} class="btn btn-primary large">
        Get Compliant & Win Deals Faster – Book Now
      </a>
    </div>
  </div>
</section>

<!-- 4 PHASES - Icons centered in the box -->
<section class="section phases">
  <div class="container">
    <h2>Our Proven 4-Phase ComplianceReady™ System</h2>
    <p class="section-lead">
      Structured, fast, and completely inside your existing environment — no new tools, no extra licenses, no disruption.
    </p>

    <!-- Breakdown with centered icons -->
    <div class="phases-breakdown grid-4">
      <div class="phase-step">
        <div class="phase-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4l3 3" />
          </svg>
        </div>
        <h3>Risk Assessment & Scope Definition</h3>
        <p>
          We map exactly what’s in scope, identify the real risks that matter to your business and auditors, and define a clear, prioritized baseline — all using your current Microsoft 365 / existing stack.
        </p>
      </div>

      <div class="phase-step">
        <div class="phase-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        </div>
        <h3>Risk Remediation & System Implementation</h3>
        <p>
          Targeted, minimal remediation — we build controls, policies, workflows, and automated evidence capture directly inside your environment. No over-engineering, no new vendors.
        </p>
      </div>

      <div class="phase-step">
        <div class="phase-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M8 10h8M8 14h8" />
          </svg>
        </div>
        <h3>Internal Audit & Readiness Validation</h3>
        <p>
          Independent internal review to confirm: If an auditor walked in tomorrow, would we pass? We validate evidence traceability, control effectiveness, and produce a clean, defensible audit pack.
        </p>
      </div>

      <div class="phase-step">
        <div class="phase-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        </div>
        <h3>Certification Support</h3>
        <p>
          Full support through external certification — assessor Q&A, final evidence packaging, and a calm, surprise-free audit experience. You get audit-ready compliance fast, with reusable proof for sales & procurement.
        </p>
      </div>
    </div>

    <!-- Diagram after breakdown -->
    <img
      src={images.fourPhases}
      alt="ComplianceReady 4-Phase System overview diagram"
      class="full-width-image phases-image"
      loading="lazy"
    />
  </div>
</section>

  <!-- FINAL CTA - Strong page closer -->
<section class="section final-cta" style="background:var(--primary); color:white; text-align:center; padding:8rem 0;">
  <div class="container">
    <h2>Ready to Stop Losing Deals to Compliance Delays?</h2>
    <p class="lead" style="font-size:1.6rem; max-width:760px; margin:1.5rem auto;">
      Book a free 30-minute call — we’ll map your fastest path to trusted, audit-ready compliance without disruption.
    </p>

    <div class="final-buttons" style="display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap; margin-top:2.5rem;">
      <a href={ctaUrl} class="btn btn-primary large" style="background:white; color:var(--primary); font-size:1.25rem; padding:1.2rem 2.8rem;">
        Book Free Call Now
      </a>
      <a href={`${base}checklist/`} class="btn btn-outline large" style="color:white; border-color:white; font-size:1.25rem; padding:1.2rem 2.8rem;">
        Get Your Free Readiness Score
      </a>
    </div>
  </div>
</section>

  <Footer />
</Base>

<style>
  :root {
    --primary: #1e40af;
    --primary-dark: #1e3a8a;
    --light: #f8fafc;
    --muted: #64748b;
  }

  .container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }

  .announce {
    background: var(--primary-dark);
    color: white;
    text-align: center;
    padding: 0.9rem 0;
    font-weight: 500;
  }

  .hero {
    padding: 8rem 0 10rem;
    background: linear-gradient(135deg, #f0f7ff 0%, white 100%);
    text-align: center;
  }
  .hero h1 { font-size: 4.2rem; line-height: 1.05; margin-bottom: 1rem; }
  .hero-sub { font-size: 1.8rem; color: var(--primary); margin-bottom: 2rem; }
  .hero-ctas { display: flex; gap: 1.5rem; justify-content: center; margin: 2.5rem 0; }
  .btn {
    padding: 1rem 2.2rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1.15rem;
  }
  .btn-primary { background: var(--primary); color: white; }
  .btn-outline { border: 2px solid var(--primary); color: var(--primary); }
  .trust-badges { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem; }
  .trust-badges span {
    background: white;
    padding: 0.6rem 1.4rem;
    border-radius: 2rem;
    border: 1px solid #e2e8f0;
    font-weight: 600;
  }

  .section { padding: 8rem 0; }
  .section-lead { font-size: 1.4rem; color: var(--muted); max-width: 800px; margin: 1.5rem auto 3rem; text-align: center; }

  .full-width-image {
    width: 100%;
    max-width: 1200px;
    border-radius: 1rem;
    box-shadow: 0 20px 60px -20px rgba(0,0,0,0.12);
    margin: 3rem auto 0;
    display: block;
  }

  .desire-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 3rem;
    margin-top: 4rem;
  }
  .desire-card {
    text-align: center;
  }
  .desire-card img {
    width: 100%;
    height: 420px;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.1);
    margin-bottom: 1.8rem;
  }
  .desire-card h3 { font-size: 1.8rem; margin-bottom: 1rem; }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 2.5rem;
    margin: 4rem 0;
  }
  .compare-column {
    padding: 2.5rem;
    border-radius: 1rem;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.08);
  }
  .compare-column.bad { background: #fef2f2; border: 1px solid #fecaca; }
  .compare-column.good { background: #f0fdf4; border: 1px solid #bbf7d0; }
  .compare-column h3 { margin-bottom: 1.5rem; }

  .cta-center { text-align: center; margin-top: 4rem; }

  .phases-image { max-height: 680px; }

  .final-cta {
    background: var(--primary);
    color: white;
    text-align: center;
    padding: 8rem 0;
  }
  .final-cta .lead { font-size: 1.6rem; max-width: 720px; margin: 1.5rem auto; }

  @media (max-width: 1024px) {
    .hero h1 { font-size: 3.4rem; }
    .desire-grid { grid-template-columns: 1fr; }
    .desire-card img { height: 360px; }
  }
</style>
