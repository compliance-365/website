---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
// Load all posts (newest first)
const posts = (await Astro.glob('../../content/blog/*.md'))
  .sort((a,b) => new Date(b.frontmatter.date || 0).getTime() - new Date(a.frontmatter.date || 0).getTime());

function coverUrl(img?: string) {
  if (!img) return null;
  if (/^https?:\/\//i.test(img)) return img;
  return `${base}${String(img).replace(/^\//,'')}`;
}
---
<Base title="Insights — Compliance365" description="Thought leadership on ISO, privacy and AI governance.">
  <Header />
 <!-- Breadcrumb for context -->
  <nav aria-label="Breadcrumb" class="container" style="margin-top:12px">
    <ol class="breadcrumb" style="list-style:none; display:flex; gap:8px; padding:0; margin:0; font-size:.9rem">
      <li><a href={`${base}`}>Home</a></li>
      <li aria-current="page" class="muted">Insights</li>
    </ol>
  </nav>

  <section class="container section" aria-labelledby="insights-title">
    <h1 id="insights-title">Insights</h1>

    <!-- ✨ SEO-friendly intro inside the same container -->
    <p class="muted" style="max-width:860px">
      Practical, audit-ready guidance on <strong>ISO&nbsp;27001</strong>, <strong>ISO&nbsp;27701</strong>, <strong>ISO&nbsp;42001</strong>,
      <strong>SOC&nbsp;2</strong>, and the <strong>ACSC Essential Eight</strong>—with real examples using
      Microsoft&nbsp;365 / SharePoint evidence, risk registers, Statements of Applicability, and AI governance patterns.
      Browse the latest posts below or filter by topic.
    </p>

    <!-- 🔎 On-page search + tag filters -->
    <div class="finder" style="display:grid; gap:12px; margin:18px 0 10px">
      <label for="q" class="small muted" style="font-weight:600">Search Insights</label>
      <input id="q" name="q" type="search" placeholder="Search titles & descriptions (e.g. “SoA”, “Essential Eight”, “privacy”)"
             aria-label="Search insights" class="input"
             style="border:1px solid rgba(10,18,32,.12); border-radius:10px; padding:10px 12px; max-width:560px" />

      <!-- Tags generated from content -->
      {
        (() => {
          const tagSet = new Set<string>();
          posts.forEach(p => (p.frontmatter?.tags || []).forEach((t: string) => tagSet.add(t)));
          const tags = Array.from(tagSet).sort((a,b) => a.localeCompare(b));
          return (
            <div class="tags" role="group" aria-label="Filter by tag" style="display:flex; flex-wrap:wrap; gap:8px">
              <button data-tag="__all__" class="pill" aria-pressed="true">All</button>
              {tags.map(t => <button data-tag={t} class="pill" aria-pressed="false">{t}</button>)}
            </div>
          );
        })()
      }
    </div>

    <!-- Results grid -->
    <div id="results" class="grid-3" style="margin-top:16px">
      {posts.map((post) => {
        const filename = post.file.split('/').pop() || '';
        const slug = filename.replace(/\.md$/i, '');
        const href = `${base}blog/${slug}`;
        const img  = coverUrl(post.frontmatter.image);
        const tags = (post.frontmatter.tags || []).join(' ').toLowerCase();
        const hay  = `${String(post.frontmatter.title||'')} ${String(post.frontmatter.description||'')}`.toLowerCase();

        return (
          <article class="card lift result"
                   data-tags={tags}
                   data-hay={hay}
                   style="overflow:hidden; display:flex; flex-direction:column;">
            {img && (
              <a href={href} style="display:block; border-radius:12px; overflow:hidden;">
                <img
                  src={img}
                  alt={post.frontmatter.title}
                  loading="lazy"
                  style="width:100%; aspect-ratio: 16/9; object-fit:cover; border:1px solid rgba(10,18,32,.06); border-radius:12px;"
                />
              </a>
            )}
            <div style="padding-top:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
              {post.frontmatter.tags && post.frontmatter.tags.slice(0,3).map((t) => (
                <span class="pill">{t}</span>
              ))}
            </div>
            <h3 style="margin:.6rem 0 .2rem">
              <a href={href} style="color:inherit; text-decoration:none">{post.frontmatter.title}</a>
            </h3>
            <p class="muted" style="margin:0 0 10px">{post.frontmatter.description}</p>
            <div style="margin-top:auto; display:flex; justify-content:space-between; align-items:center;">
              <span class="small muted">
                {post.frontmatter.date ? new Date(post.frontmatter.date).toLocaleDateString() : ''}
              </span>
              <a class="pill" href={href} aria-label={`Read post: ${post.frontmatter.title}`}>Read post →</a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- No results message -->
    <p id="no-results" class="muted" style="display:none; margin-top:16px">
      No insights matched your search/filter. Try a different keyword or clear tag filters.
    </p>

    <!-- Small FAQ helps users discover what’s inside “Insights” -->
    <details style="margin-top:28px">
      <summary><strong>What kinds of insights are here?</strong></summary>
      <div class="muted" style="max-width:860px">
        We publish templates, checklists, and walkthroughs for ISO 27001/27701/42001, SOC 2,
        ACSC Essential Eight uplift, SharePoint evidence capture, AI policy/governance, and
        audit-ready documentation (SoA, risk registers, DPIA/PIA, UIA).
      </div>
    </details>

    <!-- Client-side search & tag filter (tiny, fast) -->
    <script is:inline>
      const $q = document.getElementById('q');
      const $grid = document.getElementById('results');
      const $cards = Array.from($grid?.getElementsByClassName('result') || []);
      const $no = document.getElementById('no-results');
      const $tagBar = document.querySelector('.tags');
      let activeTag = '__all__';

      function applyFilter() {
        const q = ($q?.value || '').trim().toLowerCase();
        let visible = 0;
        for (const el of $cards) {
          const hay = el.getAttribute('data-hay') || '';
          const tags = el.getAttribute('data-tags') || '';
          const matchQ = !q || hay.includes(q);
          const matchTag = activeTag === '__all__' || tags.split(' ').includes(activeTag.toLowerCase());
          const show = matchQ && matchTag;
          el.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if ($no) $no.style.display = visible ? 'none' : '';
      }

      $q?.addEventListener('input', applyFilter);

      if ($tagBar) {
        $tagBar.addEventListener('click', (e) => {
          const btn = (e.target && e.target.closest('button'));
          if (!btn) return;
          [...$tagBar.querySelectorAll('button')].forEach(b => b.setAttribute('aria-pressed','false'));
          btn.setAttribute('aria-pressed','true');
          activeTag = btn.getAttribute('data-tag') || '__all__';
          applyFilter();
        });
      }

      // initial
      applyFilter();
    </script>

    <!-- JSON-LD for Blog list (helps discovery) -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "Insights — Compliance365",
        "url": "https://www.compliance365.com.au/insights",
        "blogPost": posts.slice(0, 24).map((p) => {
          const filename = p.file.split('/').pop() || "";
          const slug = filename.replace(/\.md$/i, "");
          const href = `${base}blog/${slug}`;
          return {
            "@type": "BlogPosting",
            "headline": p.frontmatter.title,
            "datePublished": p.frontmatter.date || undefined,
            "description": p.frontmatter.description || undefined,
            "url": href
          };
        })
      })}
    </script>
  </section>

  <Footer />
</Base>
