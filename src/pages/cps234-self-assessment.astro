---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import { DOMAINS, ANSWERS, QUESTIONS } from '../data/cps234-self-assessment.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

const pageTitle = 'CPS 234 Self-Assessment: 24 Questions | Compliance365';
const pageDesc = 'Score your position against all 24 APRA CPS 234 requirements in about 10 minutes. See your weakest domains and the gaps to close first. Free, nothing leaves your browser.';

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'CPS 234 Self-Assessment',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  description: pageDesc,
  url: 'https://www.compliance365.com.au/cps234-self-assessment/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' }
};
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={[appLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'APRA CPS 234', url: 'https://www.compliance365.com.au/services/cps234/' },
    { name: 'CPS 234 Self-Assessment', url: 'https://www.compliance365.com.au/cps234-self-assessment/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner" style="grid-template-columns:1fr;max-width:860px;">
      <div class="svc-hero-copy">
        <p class="eyebrow">Free tool · APRA CPS 234 · nothing leaves your browser</p>
        <h1>Where does your CPS 234 position <em>actually stand?</em></h1>
        <p class="section-lead">
          {QUESTIONS.length} questions, one for each requirement from paragraph 13 to paragraph 36, in the nine domains internal audit and APRA assessors use. Answer honestly and you get a score per domain and the gaps to close first.
        </p>
        <p>About 10 minutes. Your answers stay on this device so you can come back to them.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:#FAF7F1;">
    <div class="container sa-layout">
      <form class="sa-form" id="sa-form" aria-label="CPS 234 self-assessment">
        {DOMAINS.map((d, di) => (
          <fieldset class="sa-domain" id={`d-${d.id}`}>
            <legend><span class="sa-dn" aria-hidden="true">{di + 1}</span>{d.name}</legend>
            {d.questions.map((q) => (
              <div class="sa-q" role="radiogroup" aria-labelledby={`q${q.p}-t`}>
                <p class="sa-qt" id={`q${q.p}-t`}><span class="sa-p">¶{q.p}</span>{q.q}</p>
                <div class="sa-opts">
                  {ANSWERS.map((a) => (
                    <label class={`sa-opt sa-${a.value}`}>
                      <input type="radio" name={`p${q.p}`} value={a.value} />
                      <span>{a.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </fieldset>
        ))}
        <p class="sa-reset"><button type="button" id="sa-reset">Clear my answers</button></p>
      </form>

      <aside class="sa-result" aria-live="polite">
        <div class="sa-result-inner">
          <p class="sa-k">Your position</p>
          <div class="sa-ring">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="50" fill="none" stroke="#F0EAE0" stroke-width="12" />
              <circle id="sa-ring-fill" cx="60" cy="60" r="50" fill="none" stroke="#BE4A1E" stroke-width="12" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="314.16" transform="rotate(-90 60 60)" />
            </svg>
            <div class="sa-ring-n"><b id="sa-pct">–</b><span id="sa-band">Answer to see your score</span></div>
          </div>
          <p class="sa-progress"><span class="sa-band-m" id="sa-band-m"></span><span id="sa-answered">0</span> of {QUESTIONS.length} answered</p>
          <ul class="sa-bars">
            {DOMAINS.map((d) => (
              <li>
                <a href={`#d-${d.id}`}>{d.name}</a>
                <div class="sa-bar"><span data-domain={d.id}></span></div>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <div class="container" style="max-width:900px;">
      <div class="sa-gaps" id="sa-gaps" hidden>
        <h2>Gaps to close first</h2>
        <p class="muted">Answers of "No" and "Not sure" first, then "Partly", in the order of the standard.</p>
        <ol id="sa-gap-list"></ol>
        <div class="sa-next">
          <div>
            <h3>Want a second opinion on these?</h3>
            <p class="muted small">A 30-minute call. We walk the nine domains with you, separate what you can evidence from what rests on assertion, and tell you plainly whether your notification process would survive a real incident.</p>
          </div>
          <div class="sa-next-actions">
            <a class="btn-hdk-primary" href={ctaUrl} target="_blank" rel="noopener">Book a 30-min call</a>
            <a class="sa-link" href={`${base}services/cps234/`}>How we deliver CPS 234 →</a>
          </div>
        </div>
      </div>

      <p class="sa-disclaimer">
        A self-assessment, not an audit or legal advice. It reflects your own answers against our plain-language reading of APRA Prudential Standard CPS 234 Information Security, paragraphs 13 to 36. Work out your notification deadlines with the <a href={`${base}cps234-notification-calculator/`}>APRA notification clock calculator</a>.
      </p>
    </div>
  </section>

  </main>

  <Footer />

  <script>
    import { score } from '../data/cps234-self-assessment.js';
    const KEY = 'c365-cps234-sa';
    const form = document.getElementById('sa-form') as HTMLFormElement;
    const read = () => {
      const a: Record<string, string> = {};
      new FormData(form).forEach((v, k) => { a[k.slice(1)] = String(v); });
      return a;
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const LABEL: Record<string, string> = { no: 'No', unsure: 'Not sure', partly: 'Partly' };
    function render() {
      const answers = read();
      const r = score(answers);
      try { localStorage.setItem(KEY, JSON.stringify(answers)); } catch (e) { /* private mode */ }
      const any = r.answered > 0;
      (document.getElementById('sa-pct') as HTMLElement).textContent = any ? `${r.pct}%` : '–';
      (document.getElementById('sa-band') as HTMLElement).textContent = !any ? 'Answer to see your score' : r.complete ? r.band.label : `${r.band.label} so far`;
      (document.getElementById('sa-answered') as HTMLElement).textContent = String(r.answered);
      (document.getElementById('sa-band-m') as HTMLElement).textContent = !any ? '' : r.complete ? r.band.label : `${r.band.label} so far`;
      (document.getElementById('sa-ring-fill') as unknown as SVGCircleElement).style.strokeDashoffset = String(314.16 * (1 - (any ? r.pct : 0) / 100));
      r.domains.forEach((d) => {
        const el = document.querySelector(`.sa-bar span[data-domain="${d.id}"]`) as HTMLElement;
        el.style.width = d.answered ? `${d.pct}%` : '0';
        el.dataset.level = d.pct >= 85 ? 'strong' : d.pct >= 60 ? 'developing' : 'gaps';
      });
      const gapsEl = document.getElementById('sa-gaps') as HTMLElement;
      gapsEl.hidden = !any;
      (document.getElementById('sa-gap-list') as HTMLElement).innerHTML = r.gaps.length
        ? r.gaps.map((g) => `<li><span class="sa-gap-a sa-gap-${g.answer}">${LABEL[g.answer]}</span><div><p class="sa-gap-d">¶${g.p} · ${esc(g.domainName)}</p><p class="sa-gap-q">${esc(g.q)}</p>${g.callout ? `<p class="sa-gap-c">${esc(g.callout)}</p>` : ''}</div></li>`).join('')
        : '<li class="sa-gap-none">No gaps in what you have answered so far.</li>';
    }
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
      Object.entries(saved).forEach(([p, v]) => {
        const input = form.querySelector(`input[name="p${p}"][value="${v}"]`) as HTMLInputElement | null;
        if (input) input.checked = true;
      });
    } catch (e) { /* nothing saved */ }
    form.addEventListener('change', render);
    document.getElementById('sa-reset')?.addEventListener('click', () => {
      form.reset();
      try { localStorage.removeItem(KEY); } catch (e) { /* ignore */ }
      render();
    });
    render();
  </script>

  <style is:global>
    .sa-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 2rem; align-items: start; max-width: 1120px; }
    .sa-domain { border: 1px solid #E8E1D5; background: #fff; border-radius: 14px; padding: 1.25rem 1.4rem .5rem; margin: 0 0 1.25rem; }
    .sa-domain legend { display: flex; align-items: center; gap: .6rem; font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 600; font-size: 1.1rem; color: #0B0B0C; padding: 0 .4rem; }
    .sa-dn { width: 28px; height: 28px; border-radius: 8px; background: #FBEFE8; color: #A63A12; font-weight: 800; font-size: .85rem; display: inline-flex; align-items: center; justify-content: center; }
    .sa-q { padding: .9rem 0; border-top: 1px solid #F0EAE0; }
    .sa-q:first-of-type { border-top: none; }
    .sa-qt { margin: 0 0 .65rem; font-size: .95rem; line-height: 1.55; color: #2A2724; }
    .sa-p { display: inline-block; font-size: .72rem; font-weight: 800; color: #A63A12; background: #FBEFE8; border-radius: 6px; padding: .1rem .4rem; margin-right: .5rem; vertical-align: 1px; }
    .sa-opts { display: flex; flex-wrap: wrap; gap: .4rem; }
    .sa-opt { position: relative; cursor: pointer; }
    .sa-opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
    .sa-opt span { display: inline-block; padding: .45rem .95rem; border-radius: 999px; border: 1.5px solid #DDD8CF; font-size: .85rem; font-weight: 700; color: #4A4740; background: #fff; transition: all .12s; }
    .sa-opt:hover span { border-color: #BE4A1E; }
    .sa-opt input:focus-visible + span { outline: 3px solid #BE4A1E; outline-offset: 2px; }
    .sa-yes input:checked + span { background: #047857; border-color: #047857; color: #fff; }
    .sa-partly input:checked + span { background: #B45309; border-color: #B45309; color: #fff; }
    .sa-no input:checked + span, .sa-unsure input:checked + span { background: #A63A12; border-color: #A63A12; color: #fff; }
    .sa-reset button { background: none; border: none; padding: 0; color: #6B6860; text-decoration: underline; cursor: pointer; font-size: .85rem; }

    .sa-result { position: sticky; top: 90px; }
    .sa-result-inner { background: #0B0B0C; color: #FAF7F1; border-radius: 16px; padding: 1.5rem; }
    .sa-k { margin: 0 0 1rem; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: #F0A97F; }
    .sa-ring { position: relative; width: 150px; margin: 0 auto; }
    .sa-ring svg { width: 100%; height: auto; display: block; }
    .sa-ring svg circle:first-child { stroke: rgba(250,247,241,.1); }
    #sa-ring-fill { transition: stroke-dashoffset .4s ease; }
    .sa-ring-n { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 22px; }
    .sa-ring-n b { font-size: 2rem; font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
    .sa-ring-n span { font-size: .72rem; color: rgba(250,247,241,.72); line-height: 1.3; }
    .sa-band-m { display: none; }
    .sa-progress { text-align: center; font-size: .8rem; color: rgba(250,247,241,.68); margin: .75rem 0 1.25rem; }
    .sa-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
    .sa-bars a { font-size: .78rem; color: rgba(250,247,241,.85); text-decoration: none; }
    .sa-bars a:hover { color: #F0A97F; }
    .sa-bar { height: 7px; border-radius: 4px; background: rgba(250,247,241,.1); margin-top: .25rem; overflow: hidden; }
    .sa-bar span { display: block; height: 100%; width: 0; border-radius: 4px; background: #BE4A1E; transition: width .3s ease; }
    .sa-bar span[data-level="developing"] { background: #F59E0B; }
    .sa-bar span[data-level="strong"] { background: #10B981; }

    .sa-gaps { margin-top: 2.5rem; background: #fff; border: 1px solid #E8E1D5; border-radius: 16px; padding: 1.75rem; }
    .sa-gaps h2 { margin: 0 0 .25rem; }
    .sa-gaps ol { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: .75rem; }
    .sa-gaps li { display: flex; gap: .9rem; align-items: flex-start; padding: .9rem 1rem; border-radius: 12px; background: #FAF7F1; }
    .sa-gap-a { flex: none; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; padding: .25rem .55rem; border-radius: 6px; color: #fff; background: #A63A12; min-width: 66px; text-align: center; }
    .sa-gap-partly { background: #B45309; }
    .sa-gap-d { margin: 0; font-size: .72rem; font-weight: 800; color: #6B6860; text-transform: uppercase; letter-spacing: .06em; }
    .sa-gap-q { margin: .2rem 0 0; font-size: .92rem; color: #2A2724; line-height: 1.5; }
    .sa-gap-c { margin: .45rem 0 0; font-size: .85rem; color: #A63A12; line-height: 1.5; }
    .sa-gap-none { color: #047857; font-weight: 700; }
    .sa-next { margin-top: 1.75rem; display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: center; border-top: 1px solid #F0EAE0; padding-top: 1.5rem; }
    .sa-next h3 { margin: 0 0 .35rem; }
    .sa-next-actions { display: flex; flex-direction: column; align-items: center; gap: .6rem; }
    .sa-link { font-size: .85rem; font-weight: 700; color: var(--accent-ink, #A63A12); }
    .sa-disclaimer { font-size: .82rem; color: #6B6860; line-height: 1.6; margin-top: 2rem; }
    .sa-disclaimer a { color: var(--accent-ink, #A63A12); }
    @media (max-width: 960px) {
      .sa-layout { grid-template-columns: 1fr; }
      .sa-result { position: sticky; top: 64px; order: -1; z-index: 5; }
      .sa-result-inner { display: grid; grid-template-columns: 56px 1fr; gap: .25rem .9rem; align-items: center; padding: .6rem .9rem; border-radius: 12px; }
      .sa-k, .sa-bars { display: none; }
      .sa-ring { width: 56px; }
      .sa-ring-n { padding: 0; }
      .sa-ring-n b { font-size: .85rem; }
      .sa-ring-n span { display: none; }
      .sa-progress { text-align: left; margin: 0; }
      .sa-band-m { display: block; font-weight: 800; color: #FAF7F1; font-size: .9rem; }
      .sa-next { grid-template-columns: 1fr; }
      .sa-next-actions { align-items: flex-start; }
    }
  </style>
</Base>
