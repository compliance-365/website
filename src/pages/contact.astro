---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';
---

<Base title="Contact Compliance365 — Talk to a Specialist" description="Ask a question or request a call about ISO 27001, SOC 2, Essential Eight or ISO 42001. Brisbane-based, serving Australia. We reply within 1 business day.">
  <Header />

  <!-- Page header. The previous version wrapped everything in
       <Section title="Contact us">, which emits an <h2> immediately
       BEFORE the page's <h1> — a duplicate of the same idea and a
       heading-order problem at once. One heading now. -->
  <section class="section-tight" style="padding-bottom:0;">
    <div class="container" style="max-width:1060px;">
      <p class="ct-eyebrow">Contact</p>
      <h1 class="ct-h1">Talk to a compliance specialist</h1>
      <p class="ct-lead">
        Ask a question, request a scope, or just sanity-check whether a framework applies to you.
        No sales sequence — a senior practitioner reads it and replies.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container ct-grid" style="max-width:1060px;">

      <!-- ── Form ───────────────────────────────────────────── -->
      <div class="card spot ct-form-card">
        <h2 class="ct-h2">Send us a message</h2>
        <p class="ct-sub">
          Prefer email? Write to
          <a href="mailto:info@compliance365.com.au">info@compliance365.com.au</a> directly.
        </p>

        <form id="contactForm" novalidate>
          <div class="ct-row2">
            <div class="ct-field">
              <label for="inputName">Your name <span aria-hidden="true" class="ct-req">*</span></label>
              <input id="inputName" name="name" placeholder="Jane Smith" required autocomplete="name" />
            </div>
            <div class="ct-field">
              <label for="inputEmail">Work email <span aria-hidden="true" class="ct-req">*</span></label>
              <input id="inputEmail" name="email" type="email" placeholder="jane@company.com.au" required autocomplete="email" />
            </div>
          </div>

          <div class="ct-field" style="margin-top:14px;">
            <label for="inputSubject">Subject</label>
            <input id="inputSubject" name="subject" placeholder="e.g. ISO 27001 scope query" />
          </div>

          <div class="ct-field" style="margin-top:14px;">
            <label for="inputMessage">Message</label>
            <textarea id="inputMessage" name="message" placeholder="What are you trying to achieve, and by when?" rows="6"></textarea>
          </div>

          <p id="contactError" class="small ct-error"></p>

          <div class="ct-actions">
            <button id="contactSubmit" class="btn btn-primary" type="submit">Send message</button>
            <span class="ct-or">or</span>
            <button id="contactAI" type="button" class="ct-ai-btn">
              Get an instant answer from AI &rarr;
            </button>
          </div>
        </form>

        <p class="ct-fineprint">
          By submitting, you agree to our <a href={base + 'privacy/'}>Privacy Policy</a>.
        </p>
      </div>

      <!-- ── What happens next / other channels ─────────────────
           The page previously ended at the form, so the footer beneath
           it carried more structure and more trust signal than the page
           itself — on the page where people actually commit. -->
      <aside class="ct-side" aria-label="What happens next and other ways to reach us">

        <div class="ct-panel">
          <h2 class="ct-panel-h">What happens next</h2>
          <ol class="ct-steps">
            <li>
              <span class="ct-step-n">1</span>
              <div><b>We read it properly.</b> A senior practitioner, not a triage queue.</div>
            </li>
            <li>
              <span class="ct-step-n">2</span>
              <div><b>You get a reply within 1 business day</b> — a straight answer, or the two or three questions we need to give one.</div>
            </li>
            <li>
              <span class="ct-step-n">3</span>
              <div><b>Only then, a call — if it helps.</b> If we are not the right fit, we will say so.</div>
            </li>
          </ol>
        </div>

        <div class="ct-panel">
          <h2 class="ct-panel-h">Rather not wait?</h2>
          <p class="ct-panel-p">Pick a 15 or 30 minute slot and a Teams link is generated automatically.</p>
          <a class="ct-book" href={base + 'book/'}>Book a time instead &rarr;</a>
        </div>

        <div class="ct-panel">
          <h2 class="ct-panel-h">Direct</h2>
          <ul class="ct-direct">
            <li>
              <span class="ct-k">Phone</span>
              <a href="tel:+61468752243">+61 468 752243</a>
            </li>
            <li>
              <span class="ct-k">Email</span>
              <a href="mailto:info@compliance365.com.au">info@compliance365.com.au</a>
            </li>
            <li>
              <span class="ct-k">Hours</span>
              <span class="ct-v">Mon–Fri, 8:00am–5:00pm AEST</span>
            </li>
            <li>
              <span class="ct-k">Based in</span>
              <span class="ct-v">Brisbane — serving organisations Australia-wide</span>
            </li>
          </ul>
          <p class="ct-note">Fixed-price. Audit-ready in 8–14 weeks. No third-party GRC platform required.</p>
        </div>

      </aside>
    </div>
  </section>

  <script define:vars={{ API_URL }}>
    const form = document.getElementById('contactForm');
    const btn = document.getElementById('contactSubmit');
    const errEl = document.getElementById('contactError');

    // Create success message element
    const successEl = document.createElement('p');
    successEl.className = 'small';
    // Was #059669, which measures 3.52:1 on white — under AA on the one
    // message confirming the form actually worked. #046A4E gives 6.61:1.
    successEl.style.cssText = 'color:#046A4E;display:none;margin:.6rem 0 0';
    form.appendChild(successEl);

    function validEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    }

    document.getElementById('contactAI').addEventListener('click', () => {
      const subject = (document.getElementById('inputSubject').value || '').trim();
      const message = (document.getElementById('inputMessage').value || '').trim();
      const text = [subject, message].filter(Boolean).join(' — ') || 'I have a question about your compliance services.';
      if (typeof window.c365OpenChat === 'function') {
        window.c365OpenChat(text);
      } else {
        alert('AI chat is loading — please try again in a moment.');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      errEl.style.display = 'none';
      successEl.style.display = 'none';

      const name = (document.getElementById('inputName').value || '').trim();
      const email = (document.getElementById('inputEmail').value || '').trim();
      const subject = (document.getElementById('inputSubject').value || '').trim();
      const message = (document.getElementById('inputMessage').value || '').trim();

      // Validation
      if (name.length < 2) {
        errEl.textContent = 'Please enter your full name.';
        errEl.style.display = 'block';
        return;
      }
      if (!validEmail(email)) {
        errEl.textContent = 'Please enter a valid email.';
        errEl.style.display = 'block';
        return;
      }

      btn.disabled = true;

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, subject, message })
        });

        if (!res.ok) {
          const errorText = await res.text().catch(() => '');
          throw new Error(`Request failed: ${res.status} ${errorText}`);
        }

        // Success
        form.reset();
        successEl.textContent = 'Your message has been sent successfully. We\'ll reply within 1 business day.';
        successEl.style.display = 'block';

        // Optional analytics
        try {
          if (typeof clarity === 'function') clarity('event', 'contact_form_submitted');
          if (typeof gtag === 'function') gtag('event', 'contact_form_submit', { page_location: window.location.href });
        } catch (_) {}

      } catch (err) {
        console.error('Contact form error:', err);
        errEl.innerHTML = 'Could not send right now — please email us directly at <a href="mailto:info@compliance365.com.au" style="color:#b91c1c;font-weight:700;">info@compliance365.com.au</a> and we\'ll reply within 1 business day.';
        errEl.style.display = 'block';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
  <Footer />
</Base>

<style>
  /* Every colour here is measured against the ground it sits on:
     #3A3632 11.2:1, #57534B 7.2:1 and #6B6860 5.2:1 on cream;
     #8B6820 4.8:1 on cream and 5.1:1 on white. */
  .ct-eyebrow {
    font-family: Manrope, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #8B6820;
    margin: 0 0 14px;
  }
  /* No max-width: at 20ch this broke as "Talk to a / compliance
     specialist". The container already caps the measure, and
     BaseLayout sets text-wrap:balance globally. */
  .ct-h1 { margin: 0 0 14px; }
  .ct-lead {
    color: #57534B;
    font-size: 1.02rem;
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 860px) {
    /* Form first on a phone — the sidebar is supporting context, not a
       gate to get past before reaching the thing you came to do. */
    .ct-grid { grid-template-columns: 1fr; }
  }

  .ct-form-card { padding: 30px 28px; border-radius: 14px; }
  .ct-h2 { margin: 0 0 6px; font-size: 1.3rem; }
  .ct-sub { color: #57534B; font-size: .92rem; margin: 0 0 22px; }
  /* Inline links inherit a{color:#A9812E}, only 3.35:1 on white. */
  .ct-sub a, .ct-fineprint a { color: #7A5A18; font-weight: 600; }

  .ct-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .ct-row2 { grid-template-columns: 1fr; } }

  .ct-field { display: flex; flex-direction: column; gap: 6px; }
  .ct-field label {
    font-size: .85rem;
    font-weight: 600;
    color: #3A3632;
  }
  .ct-req { color: #A02622; }        /* 5.9:1 on white */
  .ct-field input,
  .ct-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #C8C3B8;
    border-radius: 8px;
    font: inherit;
    font-size: .95rem;
    color: #0B0B0C;
    background: #fff;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .ct-field textarea { resize: vertical; min-height: 130px; font-family: inherit; }
  .ct-field input::placeholder,
  .ct-field textarea::placeholder { color: #857F74; }   /* 4.6:1 on white */
  .ct-field input:focus,
  .ct-field textarea:focus {
    border-color: #A9812E;
    box-shadow: 0 0 0 3px rgba(169,129,46,.14);
  }

  .ct-error { color: #A02622; display: none; margin: .6rem 0 0; }

  .ct-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .ct-or { color: #6B6860; font-size: .85rem; }
  .ct-ai-btn {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 8px;
    border: 1.5px solid #A9812E;
    background: #fff;
    color: #7A5A18;                  /* 5.9:1 on white */
    font: 600 .9rem/1 Manrope, system-ui, sans-serif;
    cursor: pointer;
    transition: background .15s;
  }
  .ct-ai-btn:hover { background: #FAF7F1; }
  .ct-fineprint { color: #6B6860; font-size: .82rem; margin: 14px 0 0; }

  /* ── Sidebar ── */
  .ct-side { display: flex; flex-direction: column; gap: 14px; }
  .ct-panel {
    background: #fff;
    border: 1px solid #DDD8CF;
    border-radius: 14px;
    padding: 22px 22px 20px;
  }
  .ct-panel-h {
    font-size: .72rem;
    font-family: Manrope, system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #6B6860;
    margin: 0 0 14px;
  }
  .ct-panel-p { color: #57534B; font-size: .9rem; line-height: 1.6; margin: 0 0 14px; }

  .ct-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ct-steps li { display: flex; gap: 12px; align-items: flex-start; }
  .ct-steps div { font-size: .9rem; line-height: 1.6; color: #57534B; }
  .ct-steps b { color: #0B0B0C; font-weight: 600; }
  .ct-step-n {
    flex-shrink: 0;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: #A9812E;
    color: #0B0B0C;                  /* 5.5:1 on the gold */
    font: 800 12px/24px Manrope, system-ui, sans-serif;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .ct-book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    width: 100%;
    padding: 0 18px;
    border-radius: 8px;
    background: #0B0B0C;
    color: #FAF7F1;
    border: 1px solid #A9812E;
    font: 700 .88rem/1 Manrope, system-ui, sans-serif;
    text-decoration: none;
  }
  .ct-book:hover { background: #1B1B1D; color: #FAF7F1; }

  .ct-direct { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ct-direct li { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 10px; align-items: baseline; }
  .ct-k {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: #6B6860;
  }
  .ct-v { font-size: .9rem; color: #3A3632; line-height: 1.5; }
  .ct-direct a { font-size: .9rem; color: #7A5A18; font-weight: 600; word-break: break-word; }
  /* These are list targets, not links inline in a sentence, so the
     target-size criterion applies to them. */
  @media (pointer: coarse) {
    .ct-direct a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  .ct-note {
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid #EDE8DF;
    font-size: .82rem;
    line-height: 1.6;
    color: #6B6860;
  }
</style>
