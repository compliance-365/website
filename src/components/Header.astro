---
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book/';
const ctaLabel = 'Book a call';

const { pathname } = Astro.url;
function isActive(path: string) {
  if (path === base) return pathname === base || pathname === '/';
  return pathname.startsWith(path);
}
---

<!-- Thin accent stripe at very top -->
<div class="accent-stripe" aria-hidden="true"></div>

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand -->
    <a href={base} class="brand" aria-label="Compliance365 home">
      <img
        src={base + 'assets/logo.svg'}
        alt="Compliance365"
        width="38"
        height="38"
        loading="eager"
        decoding="async"
        class="brand-logo"
      />
      <span class="brand-name">Compliance<span class="brand-365">365</span></span>
    </a>

    <!-- Mobile toggle -->
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primaryNav"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <!-- Primary nav -->
    <nav id="primaryNav" class="nav" aria-label="Primary">
      <a class={`nav-link${isActive(base) && pathname === base ? ' active' : ''}`} href={base}>Home</a>

      <!-- Services dropdown -->
      <div class="nav-dd">
        <button
          class={`nav-link nav-dd-btn${isActive(base + 'services') ? ' active' : ''}`}
          type="button"
          aria-expanded="false"
          aria-controls="servicesMenu"
        >
          Services <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div id="servicesMenu" class="nav-dd-menu" role="menu" aria-label="Services">
          <a role="menuitem" href={base + 'services/iso27001/'}>
            <span class="dd-icon">🔒</span> ISO 27001 — Security
          </a>
          <a role="menuitem" href={base + 'services/iso27701/'}>
            <span class="dd-icon">🛡️</span> ISO 27701 — Privacy
          </a>
          <a role="menuitem" href={base + 'services/iso42001/'}>
            <span class="dd-icon">🤖</span> ISO 42001 — AI Governance
          </a>
          <a role="menuitem" href={base + 'services/essential-eight/'}>
            <span class="dd-icon">🇦🇺</span> Essential Eight
          </a>
          <a role="menuitem" href={base + 'services/soc2/'}>
            <span class="dd-icon">✅</span> SOC 2
          </a>
          <a role="menuitem" href={base + 'services/disp-ism-irap/'}>
            <span class="dd-icon">🏛️</span> DISP / ISM / IRAP
          </a>
          <a role="menuitem" href={base + 'services/nist-csf/'}>
            <span class="dd-icon">📋</span> NIST CSF
          </a>
          <hr class="dd-divider" />
          <a role="menuitem" href={base + 'how-we-work/'} class="dd-secondary">How we work →</a>
        </div>
      </div>

      <!-- Free Resources dropdown -->
      <div class="nav-dd">
        <button
          class={`nav-link nav-dd-btn${isActive(base + 'checklist') || isActive(base + 'resources') || isActive(base + 'blog') ? ' active' : ''}`}
          type="button"
          aria-expanded="false"
          aria-controls="freeResourcesMenu"
        >
          Free Resources <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div id="freeResourcesMenu" class="nav-dd-menu" role="menu" aria-label="Free Resources">
          <a role="menuitem" href={base + 'free-roadmap/'} style="background:linear-gradient(135deg,#eff6ff,#f0f9ff);border:1px solid rgba(30,64,175,.15);border-radius:8px;margin-bottom:4px;">
            <span class="dd-icon">🎁</span> Free starter pack
          </a>
          <a role="menuitem" href={base + 'posture-scan/'} style="background:linear-gradient(135deg,#f0fdf4,#ecfdf5);border:1px solid rgba(16,185,129,.18);border-radius:8px;margin-bottom:4px;">
            <span class="dd-icon">⚡</span> Free posture scan
          </a>
          <a role="menuitem" href={base + 'checklist/'}>
            <span class="dd-icon">📝</span> Free checklists
          </a>
          <a role="menuitem" href={base + 'resources/'}>
            <span class="dd-icon">📚</span> Guides &amp; resources
          </a>
          <a role="menuitem" href={base + 'blog/'}>
            <span class="dd-icon">💡</span> Insights
          </a>
        </div>
      </div>

      <a class={`nav-link${isActive(base + 'case-studies') ? ' active' : ''}`} href={base + 'case-studies/'}>Results</a>
      <a class={`nav-link${isActive(base + 'about') ? ' active' : ''}`} href={base + 'about/'}>About</a>
      <a class={`nav-link${isActive(base + 'contact') ? ' active' : ''}`} href={base + 'contact/'}>Contact</a>

      <!-- CTA -->
      <a href={ctaUrl} class="btn-cta" aria-label="Book a call">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2v3M17 2v3M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
        </svg>
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  /* ── Accent stripe ── */
  .accent-stripe {
    height: 3px;
    background: linear-gradient(90deg, #1e40af 0%, #3b82f6 40%, #6366f1 70%, #8b5cf6 100%);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
  }

  /* ── Header shell ── */
  .site-header {
    position: sticky;
    top: 3px; /* sit below the accent stripe */
    z-index: 50;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: saturate(200%) blur(22px);
    -webkit-backdrop-filter: saturate(200%) blur(22px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.7);
    box-shadow: 0 1px 0 0 rgba(255,255,255,0.6) inset, 0 4px 20px -4px rgba(30, 64, 175, 0.06);
    transition: box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    box-shadow: 0 1px 0 0 rgba(255,255,255,0.6) inset, 0 8px 32px -8px rgba(30, 64, 175, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }

  /* ── Brand ── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-logo {
    display: block;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .brand:hover .brand-logo {
    transform: scale(1.06);
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1e293b;
    letter-spacing: -0.01em;
  }

  .brand-365 {
    color: #2563eb;
    margin-left: 1px;
  }

  /* ── Nav ── */
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border-radius: 10px;
    color: #334155;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    opacity: 0.9;
    transition: background 0.15s, color 0.15s, opacity 0.15s;
    position: relative;
  }

  .nav-link:hover {
    background: rgba(30, 64, 175, 0.06);
    color: #1e40af;
    opacity: 1;
  }

  .nav-link.active {
    color: #1e40af;
    opacity: 1;
    background: rgba(30, 64, 175, 0.08);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #1e40af, #6366f1);
  }

  /* ── Dropdown ── */
  .nav-dd { position: relative; }

  .nav-dd-btn {
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .chev {
    font-size: 11px;
    opacity: 0.6;
    transition: transform 0.2s;
  }

  .nav-dd.open .chev {
    transform: rotate(180deg);
  }

  .nav-dd-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 240px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 16px;
    padding: 6px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.5) inset,
      0 20px 48px rgba(10, 18, 64, 0.12),
      0 4px 12px rgba(10, 18, 64, 0.06);
    display: none;
    z-index: 100;
  }

  .nav-dd-menu a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border-radius: 10px;
    text-decoration: none;
    color: #334155;
    font-weight: 600;
    font-size: 0.88rem;
    transition: background 0.12s, color 0.12s;
  }

  .nav-dd-menu a:hover {
    background: rgba(30, 64, 175, 0.07);
    color: #1e40af;
  }

  .dd-icon {
    font-size: 14px;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }

  .dd-divider {
    margin: 5px 6px;
    border: none;
    border-top: 1px solid rgba(226, 232, 240, 0.8);
  }

  .dd-secondary {
    opacity: 0.7;
    font-size: 0.83rem !important;
  }

  .nav-dd.open .nav-dd-menu { display: block; }

  /* ── CTA button ── */
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.88rem;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(135deg, #1e40af 0%, #4f46e5 100%);
    box-shadow:
      0 0 0 1px rgba(99, 102, 241, 0.3),
      0 8px 24px -8px rgba(30, 64, 175, 0.5),
      0 1px 0 rgba(255,255,255,0.15) inset;
    transition: all 0.2s ease;
    margin-left: 6px;
    position: relative;
    overflow: hidden;
  }

  .btn-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
    border-radius: inherit;
  }

  .btn-cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(99, 102, 241, 0.4),
      0 12px 28px -8px rgba(30, 64, 175, 0.6),
      0 1px 0 rgba(255,255,255,0.15) inset;
    filter: brightness(1.06);
  }

  .btn-cta:active { transform: translateY(0); }

  .btn-cta svg {
    width: 15px;
    height: 15px;
    stroke: rgba(255,255,255,0.9);
    fill: none;
    stroke-width: 1.8;
    flex-shrink: 0;
  }

  /* ── Mobile toggle ── */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(226, 232, 240, 0.8);
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    cursor: pointer;
    color: #334155;
    transition: background 0.15s, border-color 0.15s;
  }

  .nav-toggle:hover {
    background: rgba(30, 64, 175, 0.05);
    border-color: rgba(30, 64, 175, 0.2);
  }

  @media (max-width: 1020px) {
    .nav-toggle { display: inline-flex; }
    .nav {
      position: absolute;
      top: 67px;
      left: 0;
      right: 0;
      display: grid;
      gap: 2px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
      box-shadow: 0 16px 40px -8px rgba(10, 18, 64, 0.12);
      padding: 10px 14px;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
      z-index: 60;
    }
    .nav.open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .nav-link { width: 100%; justify-content: space-between; }
    .nav-dd { width: 100%; }
    .nav-dd-menu {
      position: static;
      display: none;
      box-shadow: none;
      border-radius: 10px;
      border: 1px solid rgba(226, 232, 240, 0.6);
      margin-top: 4px;
      backdrop-filter: none;
      background: rgba(248, 250, 252, 0.9);
    }
    .nav-dd.open .nav-dd-menu { display: block; }
    .btn-cta {
      width: 100%;
      justify-content: center;
      margin-top: 4px;
      margin-left: 0;
    }
    .nav-link.active::after { display: none; }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>

<script is:inline>
  (function () {
    const nav = document.getElementById('primaryNav');
    const toggle = document.querySelector('.nav-toggle');
    const dds = document.querySelectorAll('.nav-dd');
    const header = document.querySelector('.site-header');

    // Scroll shadow
    if (header) {
      const onScroll = () => {
        header.classList.toggle('scrolled', window.scrollY > 10);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    function closeAll() {
      dds.forEach(dd => {
        dd.classList.remove('open');
        const btn = dd.querySelector('.nav-dd-btn');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }

    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!open) closeAll();
      });
    }

    dds.forEach(dd => {
      const btn = dd.querySelector('.nav-dd-btn');
      if (!btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = dd.classList.contains('open');
        closeAll();
        if (!isOpen) {
          dd.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (![...dds].some(dd => dd.contains(e.target))) closeAll();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();
</script>
