---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// Load all markdown case studies
const entries = await Astro.glob('../../../content/case-studies/*.md');

// Sort by title (optional)
entries.sort((a,b)=> (a.frontmatter?.title || '').localeCompare(b.frontmatter?.title || ''));

// Build hrefs that match /case-studies/[slug].astro
const cases = entries.map((entry) => {
  const parts = entry.file.split('/');
  const filename = parts[parts.length - 1]; // e.g. "health-saas.md"
  const slug = filename.replace(/\.md$/, ''); // "health-saas"
  return {
    href: `${base}case-studies/${slug}`,
    title: entry.frontmatter?.title ?? 'Case Study',
    summary: entry.frontmatter?.summary ?? 'Real outcome story',
  };
});
---

<Base
  title="Case Studies — Real Compliance Wins | Compliance365"
  description="See how Australian SaaS, healthcare, finance and government-adjacent teams achieved faster certification, automated evidence and stronger trust — without new tools."
>
  <Header />

  <!-- Hero-style intro -->
  <section class="hero-wrap">
    <div class="container">
      <div class="section-head center">
        <h1>Real Results from Australian Organisations</h1>
        <p class="section-lead muted">
          Faster certifications, automated evidence, and lasting compliance maturity — without new tools or disruption.
        </p>
        <p class="muted small" style="margin-top:1rem;opacity:0.9;">
          Trusted by SaaS, healthcare, finance and government-adjacent teams.
        </p>
      </div>
    </div>
  </section>

  <!-- Case studies grid -->
  <section class="section">
    <div class="container">
      <div class="grid-3">
        {cases.map((c) => (
          <a href={c.href} class="card feature" style="text-decoration:none;color:inherit;">
            <h3>{c.title}</h3>
            <p class="muted" style="margin:0.75rem 0 1.25rem;">{c.summary}</p>
            <div class="pill-row">
              <span class="pill brand">Read Case Study →</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Optional empty state if no cases -->
      {cases.length === 0 && (
        <div class="center" style="padding:4rem 0;color:var(--muted);">
          <p>No case studies available yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Base>

