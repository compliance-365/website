---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// Build JSON-LD
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.seo?.description ?? entry.data.summary,
  datePublished: entry.data.date.toISOString().split('T')[0],
  author: {
    '@type': 'Organization',
    name: 'Compliance365',
    url: 'https://www.compliance365.com.au',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Compliance365',
    url: 'https://www.compliance365.com.au',
  },
  about: entry.data.tags.map(t => ({ '@type': 'Thing', name: t })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.compliance365.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Case Studies', item: 'https://www.compliance365.com.au/case-studies' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://www.compliance365.com.au/case-studies/${entry.slug}` },
  ],
};
---

<Base
  title={`${entry.data.title} | Compliance365`}
  description={entry.data.seo?.description ?? entry.data.summary}
  schema={[articleLd, breadcrumbLd]}
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">

      <!-- Breadcrumb -->
      <nav style="margin-bottom:1.5rem;">
        <a href={`${base}case-studies`} style="color:#64748b;font-size:0.875rem;text-decoration:none;">
          ← All case studies
        </a>
      </nav>

      <!-- Sector + timeline pills -->
      <div class="pill-row" style="margin-bottom:1.25rem;">
        <span class="pill brand">{entry.data.sector}</span>
        <span class="pill">{entry.data.timeline}</span>
        {entry.data.tags.map(tag => (
          <span class="pill">{tag}</span>
        ))}
      </div>

      <h1 style="max-width:860px;">{entry.data.title}</h1>
      <p class="section-lead muted" style="max-width:760px;">{entry.data.summary}</p>
    </div>
  </section>

  <!-- OUTCOME METRICS STRIP -->
  <section style="background:#1e40af;color:white;padding:3rem 0;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem;">
        {entry.data.outcomes.map(outcome => (
          <div style="text-align:center;">
            <p style="margin:0;font-size:1rem;font-weight:600;color:rgba(255,255,255,0.95);line-height:1.4;">
              {outcome}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES DELIVERED -->
  <section style="background:#f8fafc;padding:2rem 0;">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
        <span style="font-size:0.8rem;font-weight:700;color:#64748b;letter-spacing:0.5px;text-transform:uppercase;margin-right:0.5rem;">
          Services delivered:
        </span>
        {entry.data.services.map(service => (
          <span class="pill" style="font-size:0.75rem;">{service}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section class="section">
    <div class="container">
      <div style="max-width:860px;margin:0 auto;" class="case-study-body">
        <Content />
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section" style="background:#f8fafc;">
    <div class="container center">
      <h2>Related services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Explore the frameworks delivered in this engagement.
      </p>
      <div class="pill-row" style="justify-content:center;flex-wrap:wrap;">
        {entry.data.tags
          .filter(t => ['ISO 27001','SOC 2','Essential Eight','ISO 27701','ISO 42001','DISP','IRAP'].includes(t))
          .map(tag => {
            const slugMap = {
              'ISO 27001': 'iso27001',
              'SOC 2': 'soc2',
              'Essential Eight': 'essential-eight',
              'ISO 27701': 'iso27701',
              'ISO 42001': 'iso42001',
            };
            const serviceSlug = slugMap[tag];
            return serviceSlug
              ? <a class="pill" href={`${base}services/${serviceSlug}`}>{tag}</a>
              : <span class="pill">{tag}</span>;
          })
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:6rem 0;">
    <div class="container">
      <h2>Ready for a similar outcome?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:640px;margin:1.5rem auto;">
        A free 30-minute call will tell you what a realistic timeline and cost looks like for your situation.
        No sales pitch — if the timing isn't right, we'll tell you.
      </p>
      <div style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;">
        <a href={ctaUrl} class="btn btn-primary large"
           style="background:white;color:#1e40af;font-size:1.1rem;padding:1rem 2.5rem;">
          Book a free 30-min call
        </a>
        <a href={`${base}case-studies`} class="btn btn-outline large"
           style="color:white;border-color:white;font-size:1.1rem;padding:1rem 2.5rem;">
          View all case studies
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style is:global>
  /* Prose styles for the rendered markdown content */
  .case-study-body h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy, #1e3a8a);
    margin: 3rem 0 1rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }

  .case-study-body h2:first-child {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  .case-study-body h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin: 2rem 0 0.75rem;
  }

  .case-study-body p {
    color: #475569;
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .case-study-body ul,
  .case-study-body ol {
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
    color: #475569;
  }

  .case-study-body li {
    line-height: 1.75;
    margin-bottom: 0.4rem;
  }

  .case-study-body strong {
    color: #0f172a;
    font-weight: 700;
  }

  /* At a Glance table */
  .case-study-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem;
    font-size: 0.9rem;
  }

  .case-study-body table td {
    padding: 0.75rem 1rem;
    border: 1px solid #e2e8f0;
    vertical-align: top;
    line-height: 1.6;
    color: #475569;
  }

  .case-study-body table td:first-child {
    font-weight: 700;
    color: #0f172a;
    white-space: nowrap;
    background: #f8fafc;
    width: 220px;
  }

  .case-study-body hr {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 2.5rem 0;
  }

  /* Final CTA link inside markdown */
  .case-study-body a {
    color: #1e40af;
    font-weight: 600;
    text-decoration: none;
  }

  .case-study-body a:hover {
    text-decoration: underline;
  }

  /* Blockquotes if used */
  .case-study-body blockquote {
    border-left: 4px solid #1e40af;
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background: #eff6ff;
    border-radius: 0 8px 8px 0;
    color: #1e3a8a;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .case-study-body table td:first-child {
      width: auto;
      white-space: normal;
    }
  }
</style>
