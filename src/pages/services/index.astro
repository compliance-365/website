---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Base from '../../layouts/BaseLayout.astro';

const services = [
  {
    title: 'ISO 27001 (Security)',
    summary: 'Certify your ISMS in 8–12 weeks — gap analysis, risk, SoA, and audit readiness with automation in Microsoft 365.',
    url: '/services/iso27001',
    tags: ['Gap analysis', 'SoA']
  },
  {
    title: 'ISO 27701 (Privacy)',
    summary: 'Extend your ISMS with privacy workflows: DPIAs, ROPAs, data rights, and training aligned to ISO 27701.',
    url: '/services/iso27701',
    tags: ['DPIA', 'ROPA']
  },
  {
    title: 'ISO 42001 (AI Governance)',
    summary: 'Operationalise AI governance: model inventory, AI risk, oversight, and monitoring inside Microsoft 365.',
    url: '/services/iso42001',
    tags: ['AI risk', 'Oversight']
  },
  {
    title: 'SOC 2 Readiness (Type I/II)',
    summary: 'Trust Services Criteria mapped to your stack. Type 1 & Type 2 readiness with automated evidence.',
    url: '/services/soc2',
    tags: ['Type 1', 'Type 2']
  },
  {
    title: 'Essential Eight Uplift',
    summary: 'Practical uplift across patching, macros, application control, MFA, and backups — leveraging your Microsoft E5 stack.',
    url: '/services/essential-eight',
    tags: ['MFA', 'App control']
  },
  {
    title: 'DISP, ISM & IRAP',
    summary: 'Defence uplift, ISM alignment, and IRAP readiness. Evidence automated within Microsoft 365.',
    url: '/services/disp-ism-irap',
    tags: ['DISP', 'ISM', 'IRAP']
  },
];
---

<Base
  title="Compliance365 — ISO 27001, ISO 27701, ISO 42001, DISP, NIST SOC 2 & Essential Eight done faster"
  description="Achieve ISO 27001, ISO 27701, ISO 42001, DISP, NIST, SOC 2 and Essential Eight in weeks, not months — without buying new tools or licenses. Automation in Microsoft + audit-ready evidence."
>
  <Header />

  <section class="container section">
    <h1>Services</h1>
    <p class="muted">
      Pick the outcome you need — ISO, SOC 2, Essential Eight or government frameworks.  
      We map the shortest route and automate evidence in Microsoft 365 and SharePoint.
    </p>

    <div class="grid-3" style="margin-top:20px">
      {services.map((s) => (
        <a class="card" href={s.url}>
          <h3>{s.title}</h3>
          <p class="muted">{s.summary}</p>
          <div class="tag-row">
            {s.tags.map((t) => (
              <span class="pill">{t}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <Footer />
</Base>

<style>
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
</style>
