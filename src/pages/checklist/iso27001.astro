---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27001 (Information Security)';

// One source of truth for questions (page markup)
const QUESTIONS = [
  // Governance & ISMS
  {
    id: 'isms-scope',
    label: 'ISMS scope defined and approved (locations, systems, services, exclusions)?',
    group: 'gov',
    hint: 'Be clear on what is in-scope for security governance and audit, and what is explicitly out-of-scope (with reasons).',
    examples: [
      'A one-page scope statement listing sites, cloud environments, core systems, and customer-facing services in scope.',
      'A diagram showing boundaries (e.g., “Production AWS + corporate M365 in scope; personal devices out of scope”).',
      'Documented exclusions with justification and compensating controls (if needed).'
    ]
  },
  {
    id: 'context',
    label: 'Business context, interested parties and security requirements documented?',
    group: 'gov',
    hint: 'Show you understand who you must protect, what matters to the business, and the key obligations you must meet.',
    examples: [
      'Interested parties list (customers, regulators, insurers, partners) and their security expectations.',
      'Register of legal/regulatory/contractual requirements (e.g., privacy, health, SOC 2 clauses, customer security addendums).',
      'Security objectives aligned to business risks (e.g., protecting patient data, maintaining uptime, passing customer audits).'
    ]
  },
  {
    id: 'leadership',
    label: 'Top management roles, responsibilities and commitment for information security are defined and visible?',
    group: 'gov',
    hint: 'Auditors want proof leadership owns security outcomes, not just IT. Make accountability obvious.',
    examples: [
      'ISMS governance chart: Sponsor, ISMS owner, risk owners, control owners.',
      'Leadership-approved policy statement and meeting minutes showing security is reviewed.',
      'Evidence of resourcing decisions (budget, roles, priorities) tied to security risks.'
    ]
  },
  {
    id: 'policy',
    label: 'Information security policy and supporting policies approved, communicated and periodically reviewed?',
    group: 'gov',
    hint: 'Policies should be current, approved, accessible, and actually used by staff—supported by procedures where needed.',
    examples: [
      'InfoSec policy with version control, approval date, and next review date.',
      'Supporting policies: access control, incident response, change management, supplier security, acceptable use.',
      'Proof of communication (intranet link, staff acknowledgement, onboarding/training content).'
    ]
  },

  // Risk & Statement of Applicability
  {
    id: 'risk-method',
    label: 'Risk assessment methodology defined (criteria, likelihood/impact, appetite) and applied consistently?',
    group: 'risk',
    hint: 'Define how you score risk and how decisions are made, so risk ratings are repeatable and defensible.',
    examples: [
      'Risk matrix with likelihood/impact definitions and scoring guidance.',
      'Documented risk acceptance thresholds and who can approve exceptions.',
      'Example of two different teams assessing risks using the same method and producing comparable outcomes.'
    ]
  },
  {
    id: 'risk-reg',
    label: 'Information security risk register in place, with owners, treatments and review dates?',
    group: 'risk',
    hint: 'Your risk register should show ownership, action, and momentum—not just a list of problems.',
    examples: [
      'Risk register entries with: description, assets affected, owner, treatment plan, due date, status.',
      'Regular review cadence (monthly/quarterly) with updates and decisions recorded.',
      'Linked evidence: tickets, remediation plans, change records, or accepted risk sign-offs.'
    ]
  },
  {
    id: 'controls',
    label: 'Annex A controls selected based on risk, legal/regulatory and contractual requirements?',
    group: 'risk',
    hint: 'Control selection should be traceable: risks and obligations drive what you implement.',
    examples: [
      'Mapping from key risks to specific Annex A controls.',
      'List of customer/contract requirements mapped to controls (e.g., logging, MFA, encryption, supplier controls).',
      'Evidence of review when scope or services change (new system, new region, new vendor).'
    ]
  },
  {
    id: 'soa',
    label: 'Statement of Applicability (SoA) completed with justifications, control status and evidence locations?',
    group: 'risk',
    hint: 'The SoA is your audit “index”: it explains what applies, why, how it’s implemented, and where evidence lives.',
    examples: [
      'SoA with each control marked applicable/not applicable and a clear justification.',
      'Implementation status (Implemented/Partial/Planned) and named control owner.',
      'Direct links to evidence locations (SharePoint folder, ticket, report, configuration screenshot).'
    ]
  },

  // Operations & Controls
  {
    id: 'assets',
    label: 'Information assets, systems and services inventoried with assigned owners?',
    group: 'ops',
    hint: 'You should know what you have, who owns it, and what needs protection—especially customer-facing and sensitive assets.',
    examples: [
      'Asset inventory covering applications, infrastructure, data stores, endpoints, and key SaaS tools.',
      'Data classification or “crown jewels” list (critical systems/data) with owners.',
      'Lifecycle controls: onboarding new assets, retirement, and periodic review.'
    ]
  },
  {
    id: 'access',
    label: 'Access control model defined (joiner/mover/leaver, least privilege, privileged access)?',
    group: 'ops',
    hint: 'Access should be granted based on role, removed quickly when no longer needed, and privileged access tightly controlled.',
    examples: [
      'Documented joiner/mover/leaver process with timelines and approvals.',
      'Role-based access groups and periodic access reviews for sensitive systems.',
      'Privileged access controls (admin accounts separated, MFA, just-in-time access, logging).'
    ]
  },
  {
    id: 'suppliers',
    label: 'Supplier/third-party security requirements defined and periodically reviewed?',
    group: 'ops',
    hint: 'Prove you assess and manage third-party risk through due diligence, contracts, and ongoing oversight.',
    examples: [
      'Vendor risk assessment process (tiering by criticality and data access).',
      'Contract clauses: security obligations, breach notification, audit rights, sub-processor controls.',
      'Annual review of critical suppliers (SOC reports, ISO certs, questionnaires, performance and incident history).'
    ]
  },
  {
    id: 'secure-dev',
    label: 'Secure change and development practices in place (change assessment, testing, approvals)?',
    group: 'ops',
    hint: 'Changes should be controlled so you don’t introduce security or availability issues into production.',
    examples: [
      'Change management workflow: risk assessment, approvals, test evidence, rollback plan.',
      'Secure SDLC practices (code review, security testing, dependency scanning) appropriate to your environment.',
      'Records of production changes with outcomes and post-implementation review for major changes.'
    ]
  },

  // Security Operations & Resilience
  {
    id: 'logging',
    label: 'Security logging and monitoring in place for key systems, with alerting on suspicious activity?',
    group: 'tech',
    hint: 'Logs should help you detect and investigate events quickly—especially for identity, endpoints, cloud, and critical apps.',
    examples: [
      'Centralised logging for identity (SSO), endpoints, cloud audit logs, and key applications.',
      'Alert rules for suspicious activity (impossible travel, admin role changes, excessive failed logins).',
      'Documented log retention and access controls; evidence of alert review and triage.'
    ]
  },
  {
    id: 'backup-dr',
    label: 'Backups, business continuity and disaster recovery plans tested and aligned to RTO/RPO targets?',
    group: 'tech',
    hint: 'Backups and recovery are only “real” when tested. RTO/RPO should match business expectations and contracts.',
    examples: [
      'Defined RTO (restore time) and RPO (restore point) per critical system.',
      'Backup schedule, coverage (what is backed up), and monitoring/alerts for failures.',
      'Evidence of restore tests and DR/BCP exercises with outcomes and improvements.'
    ]
  },
  {
    id: 'vuln-mgmt',
    label: 'Vulnerability management process in place (scanning, patching, remediation of high risks)?',
    group: 'tech',
    hint: 'Show a repeatable process for finding vulnerabilities, prioritising them, fixing them, and proving closure.',
    examples: [
      'Regular scanning (infrastructure + apps) with documented frequency and scope.',
      'Patch SLAs (e.g., critical within X days) and exception process for delayed remediation.',
      'Remediation tracking (tickets) and evidence that high/critical issues are resolved or risk-accepted.'
    ]
  },
  {
    id: 'incident',
    label: 'Incident response plan defined, tested and improved after real incidents or exercises?',
    group: 'tech',
    hint: 'Your plan should be practical, tested, and integrated with comms, legal/privacy, and customer obligations.',
    examples: [
      'Incident response runbook with roles, severity levels, escalation paths, and contact list.',
      'Tabletop exercise outcomes and lessons learned action plan.',
      'Post-incident review template showing improvements made after incidents or near-misses.'
    ]
  },

  // Monitoring, Audit & Improvement
  {
    id: 'metrics',
    label: 'ISMS objectives and KPIs defined, measured and reported (e.g. incidents, audit findings, training)?',
    group: 'imp',
    hint: 'Choose a small set of meaningful metrics that demonstrate control effectiveness and risk reduction over time.',
    examples: [
      'Monthly security dashboard: incidents by severity, patch SLA compliance, phishing training completion, audit actions overdue.',
      'Targets and thresholds (e.g., “Critical vulnerabilities fixed within 14 days”).',
      'Trend reporting to leadership with decisions/actions taken.'
    ]
  },
  {
    id: 'iaudit',
    label: 'Internal ISMS audits performed to plan, with findings and corrective actions tracked to closure?',
    group: 'imp',
    hint: 'Internal audits verify the ISMS is working and give you time to fix issues before external audits.',
    examples: [
      'Annual internal audit plan covering ISO clauses and key Annex A areas.',
      'Audit reports with findings, root cause, corrective actions, owners, and due dates.',
      'Evidence that corrective actions are verified closed (not just marked “done”).'
    ]
  },
  {
    id: 'mgmt-review',
    label: 'Management reviews held covering risks, incidents, changes, audit results and improvement opportunities?',
    group: 'imp',
    hint: 'Management review is where leaders steer the ISMS—confirming priorities, resourcing, and decisions.',
    examples: [
      'Management review agenda/minutes covering required inputs (risks, audit results, incidents, metrics).',
      'Recorded decisions: resourcing, policy changes, risk acceptance, major improvements.',
      'Action register from management review with owners and follow-up.'
    ]
  },
  {
    id: 'improve',
    label: 'Continual improvement / corrective action log maintained for ISMS issues and opportunities?',
    group: 'imp',
    hint: 'Track improvements in one place so nothing gets lost and you can demonstrate ongoing maturity.',
    examples: [
      'Corrective action register linking to incidents, audits, vulnerabilities, or customer findings.',
      'Root cause analysis notes and prevention actions (not just short-term fixes).',
      'Evidence of recurring review and closure verification (before/after state).'
    ]
  }
];

const GROUPS = [
  { key:'gov',  title:'Governance & ISMS',                 blurb:'Scope, context, leadership, policy and roles.' },
  { key:'risk', title:'Risk & Statement of Applicability', blurb:'Risk assessment, risk register, Annex A controls and SoA.' },
  { key:'ops',  title:'Operations & Controls',             blurb:'Assets, access, suppliers and secure change/development.' },
  { key:'tech', title:'Security Operations & Resilience',  blurb:'Logging, backups/DR, vulnerability management and incidents.' },
  { key:'imp',  title:'Monitoring, Audit & Improvement',   blurb:'Metrics, internal audit, management review and improvements.' },
];
---

<Base
  title="ISO 27001 Free Information Security Readiness Checklist"
  description="Free ISO 27001 information security readiness checklist for CISOs, IT leaders and compliance owners. Assess ISMS maturity, see your readiness score and download a PDF roadmap to certification."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 27001 information security readiness checklist (free)</h1>
    <p class="muted" style="max-width:800px">
      Use this free ISO 27001 readiness checklist to quickly assess how mature your Information Security Management System (ISMS) is.
      Score governance, risk management, Annex A controls, security operations and continual improvement to see how ready you are
      for ISO 27001 certification or surveillance audit.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">
          Gauge ISO 27001 ISMS maturity and how ready your organisation is for internal review or external certification audit.
        </p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small"><strong>Yes / Partial / No</strong>. Progress and readiness update automatically across each domain.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown, top gaps, Trust Score bands and next-step guidance.</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill" aria-current="page">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 6px;">
  {q.label}
</label>

{q.hint && (
  <div class="muted small" style="margin:0 0 8px;">
    {q.hint}
  </div>
)}

{q.examples?.length && (
  <details style="margin:0 0 10px;">
    <summary class="small" style="cursor:pointer;font-weight:700;color:#4F46E5;">
      Show examples
    </summary>
    <ul class="small" style="margin:8px 0 0;padding-left:18px;">
      {q.examples.map(ex => (<li>{ex}</li>))}
    </ul>
  </details>
)}
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download ISMS PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
(() => {
  'use strict';

  const STANDARD  = "ISO 27001 (Information Security)";
  const API_URL   = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  // Browser-side GROUPS
  const GROUPS = [
    { key:'gov',  title:'Governance & ISMS' },
    { key:'risk', title:'Risk & Statement of Applicability' },
    { key:'ops',  title:'Operations & Controls' },
    { key:'tech', title:'Security Operations & Resilience' },
    { key:'imp',  title:'Monitoring, Audit & Improvement' },
  ];

  // Browser-side QUESTIONS (with group keys) – must match server QUESTIONS
  const QUESTIONS = [
    { id:"isms-scope",  label:"ISMS scope defined and approved (locations, systems, services, exclusions)?", group:"gov" },
    { id:"context",     label:"Business context, interested parties and security requirements documented?", group:"gov" },
    { id:"leadership",  label:"Top management roles, responsibilities and commitment for information security are defined and visible?", group:"gov" },
    { id:"policy",      label:"Information security policy and supporting policies approved, communicated and periodically reviewed?", group:"gov" },

    { id:"risk-method", label:"Risk assessment methodology defined (criteria, likelihood/impact, appetite) and applied consistently?", group:"risk" },
    { id:"risk-reg",    label:"Information security risk register in place, with owners, treatments and review dates?", group:"risk" },
    { id:"controls",    label:"Annex A controls selected based on risk, legal/regulatory and contractual requirements?", group:"risk" },
    { id:"soa",         label:"Statement of Applicability (SoA) completed with justifications, control status and evidence locations?", group:"risk" },

    { id:"assets",      label:"Information assets, systems and services inventoried with assigned owners?", group:"ops" },
    { id:"access",      label:"Access control model defined (joiner/mover/leaver, least privilege, privileged access)?", group:"ops" },
    { id:"suppliers",   label:"Supplier/third-party security requirements defined and periodically reviewed?", group:"ops" },
    { id:"secure-dev",  label:"Secure change and development practices in place (change assessment, testing, approvals)?", group:"ops" },

    { id:"logging",     label:"Security logging and monitoring in place for key systems, with alerting on suspicious activity?", group:"tech" },
    { id:"backup-dr",   label:"Backups, business continuity and disaster recovery plans tested and aligned to RTO/RPO targets?", group:"tech" },
    { id:"vuln-mgmt",   label:"Vulnerability management process in place (scanning, patching, remediation of high risks)?", group:"tech" },
    { id:"incident",    label:"Incident response plan defined, tested and improved after real incidents or exercises?", group:"tech" },

    { id:"metrics",     label:"ISMS objectives and KPIs defined, measured and reported (e.g. incidents, audit findings, training)?", group:"imp" },
    { id:"iaudit",      label:"Internal ISMS audits performed to plan, with findings and corrective actions tracked to closure?", group:"imp" },
    { id:"mgmt-review", label:"Management reviews held covering risks, incidents, changes, audit results and improvement opportunities?", group:"imp" },
    { id:"improve",     label:"Continual improvement / corrective action log maintained for ISMS issues and opportunities?", group:"imp" }
  ];

  (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

  function setup(){
    const form       = document.getElementById('form');
    const bar        = document.getElementById('bar');
    const scoreNum   = document.getElementById('scoreNum');
    const scoreLabel = document.getElementById('scoreLabel');
    const scoreHint  = document.getElementById('scoreHint');
    const resetBtn   = document.getElementById('resetBtn');
    const pdfBtn     = document.getElementById('pdfBtn');

    const modal      = document.getElementById('leadModal');
    const leadForm   = document.getElementById('leadForm');
    const cancelLead = document.getElementById('cancelLead');
    const nameEl     = document.getElementById('name');
    const emailEl    = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    // Update group counters
    function refreshGroupCounters(){
      GROUPS.forEach(grp => {
        const total = QUESTIONS.filter(q=>q.group===grp.key).length;
        const ansd  = QUESTIONS.filter(q=>q.group===grp.key).map(q=>state[q.id]).filter(v=>v!==null).length;
        const el = document.getElementById('g-'+grp.key);
        if(el) el.textContent = `${ansd}/${total} answered`;
      });
    }
    refreshGroupCounters();

    // Click-to-answer
    form.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.opt'); if(!btn || !form.contains(btn)) return;
      const field = btn.closest('.field'); if(!field) return;
      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);
      state[id] = val;
      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');
      refreshGroupCounters();
      update();
    });

    // Reset
    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
      refreshGroupCounters();
      update();
    });

    // Open modal before PDF
    pdfBtn?.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if(modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

    // Submit → POST to API → ALWAYS generate PDF
    leadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name  = (nameEl?.value || '').trim();
      const email = (emailEl?.value || '').trim();

      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('Please enter your name and a valid email.');
        return;
      }

      const Q_MIN = QUESTIONS.map(q => ({ id: q.id, label: q.label, group: q.group }));
      const G_MIN = GROUPS.map(g => ({ key: g.key, title: g.title }));

      const payload = {
        name,
        email,
        subject: `Checklist lead: ${STANDARD}`,
        message: JSON.stringify({
          checklist: STANDARD,
          checklistId: 'iso27001',
          timestamp: new Date().toISOString(),
          ua: navigator.userAgent,
          ...compute(state),
          total: QUESTIONS.length,
          answers: state,
          questions: Q_MIN,
          groups: G_MIN
        })
      };

      try {
        if (!API_URL) throw new Error('API_URL missing');
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const txt = await res.text().catch(()=> '');
        if (!res.ok) {
          console.warn('[27001 lead] POST failed:', res.status, txt);
          alert('We could not notify our team automatically, but your PDF will still download.');
        }
      } catch (err) {
        console.warn('[27001 lead] POST error:', err);
        alert('We could not notify our team automatically, but your PDF will still download.');
      }

      // GA4 event
      try {
        const s = compute(state);
        if (window.gtag) {
          window.gtag('event', 'checklist_submit', {
            event_category: 'Checklist',
            event_label: STANDARD,
            checklist_standard: STANDARD,
            checklist_id: 'iso27001',
            answered: s.answered,
            score: s.score
          });
        }
      } catch (err) {
        console.warn('GA4 checklist_submit event failed', err);
      }

      closeModal();
      generatePDF(state, { name, email });
    });

    // active-chip style
    const s = document.createElement('style');
    s.textContent = `button.opt{cursor:pointer}
      button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
    document.head.appendChild(s);

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);
      bar.style.width = pct + '%';
      scoreNum.textContent = `${score}%`;

      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered === 0) {
        label = 'Not started';
        hint  = 'Answer the questions to see your readiness.';
      } else if (score <= 30) {
        label = 'High Risk (0–30)';
        hint  = 'Focus on scope, ownership, policies, and a basic risk register/SoA foundation.';
      } else if (score <= 60) {
        label = 'Partially Ready (31–60)';
        hint  = 'Prioritise the few missing items that auditors will test first.';
      } else if (score <= 85) {
        label = 'Nearly Audit-Ready (61–85)';
        hint  = 'Close minor gaps and focus on evidence packaging and review cadence.';
      } else {
        label = 'Certification-Ready (86–100)';
        hint  = 'Focus on validation, evidence consistency, and audit preparation.';
      }

      scoreLabel.textContent = label;
      scoreHint.textContent  = hint;
    }
  }

  function compute(state){
    const answered = Object.values(state).filter(v => v !== null).length;
    const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
    const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
    return { answered, score: isNaN(score) ? 0 : score };
  }

  function getBand(score, answered){
    if (!answered) return { key:'na', title:'Not started', desc:'Complete the checklist to generate your Trust Score.' };
    if (score <= 30) return { key:'hr',  title:'0–30 — High Risk',             desc:'Missing foundational controls. Structured remediation required.' };
    if (score <= 60) return { key:'pr',  title:'31–60 — Partially Ready',      desc:'Many core elements in place. Focus and prioritisation needed.' };
    if (score <= 85) return { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close minor gaps and focus on evidence packaging for audit.' };
    return              { key:'cr',  title:'86–100 — Certification-Ready',     desc:'Controls largely in place. Focus on validation and audit packaging.' };
  }

  function drawTrustBands(doc, x, y, w, score, answered){
    const pad = 6;
    const rowH = 18;
    const gap = 6;

    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('What Your Trust Score Really Means', x, y);
    y += 6;

    doc.setFont('helvetica','normal');
    doc.setFontSize(10);
    doc.setTextColor(80);
    doc.text('Your ISO 27001 Trust Score shows how close you already are to certification.', x, y);
    y += 8;

    if (!answered) {
      doc.setFillColor(243,244,246);
      doc.setDrawColor(229,231,235);
      doc.roundedRect(x, y, w, rowH, 3, 3, 'FD');

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text('Not started', x + pad, y + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(80);
      doc.text('Answer the questions to generate your Trust Score and PDF roadmap.', x + pad, y + 14);

      return y + rowH + 2;
    }

    const rows = [
      { key:'hr',  title:'0–30 — High Risk',              desc:'Missing foundational controls. Structured remediation required.' },
      { key:'pr',  title:'31–60 — Partially Ready',       desc:'Many core elements in place. Focus and prioritisation needed.' },
      { key:'nar', title:'61–85 — Nearly Audit-Ready',    desc:'Close minor gaps and focus on evidence packaging for audit.' },
      { key:'cr',  title:'86–100 — Certification-Ready',  desc:'Controls largely in place. Focus on validation and audit packaging.' },
    ];

    const fills = {
      hr:  [254,226,226],
      pr:  [224,231,255],
      nar: [254,249,195],
      cr:  [209,250,229],
    };

    const band = getBand(score, answered);

    rows.forEach((r, i) => {
      const yy = y + i * (rowH + gap);

      const fc = fills[r.key];
      doc.setFillColor(fc[0], fc[1], fc[2]);
      doc.setDrawColor(229,231,235);
      doc.setLineWidth(0.2);
      doc.roundedRect(x, yy, w, rowH, 4, 4, 'FD');

      if (r.key === band.key) {
        doc.setDrawColor(79,70,229);
        doc.setLineWidth(0.8);
        doc.roundedRect(x, yy, w, rowH, 4, 4, 'S');

        doc.setFillColor(79,70,229);
        doc.roundedRect(x + 2, yy + 2, 3, rowH - 4, 2, 2, 'F');
      }

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text(r.title, x + pad + 4, yy + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(55);
      const lines = doc.splitTextToSize(r.desc, w - (pad * 2) - 8);
      doc.text(lines, x + pad + 4, yy + 14);
    });

    // score chip
    const chip = `Your score: ${score}%`;
    doc.setFont('helvetica','bold'); doc.setFontSize(10);
    const chipW = Math.max(28, doc.getTextWidth(chip) + 10);
    const chipH = 8;
    const chipX = x + w - chipW;
    const chipY = y - 10;

    doc.setFillColor(17,24,39);
    doc.setTextColor(255,255,255);
    doc.roundedRect(chipX, chipY, chipW, chipH, 3, 3, 'F');
    doc.text(chip, chipX + chipW / 2, chipY + 5.6, { align:'center' });

    return y + rows.length * (rowH + gap) - gap + 2;
  }

  // ==== PDF (ISO 27001 flavour) ====
  function generatePDF(state, lead = {}) {
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ alert('PDF library not loaded.'); return; }

    const doc = new jsPDF('p','mm','a4');
    const W = 210, LM = 14, RM = 14; let y = 16;
    const now = new Date();
    const fmt = d => d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
    const hr  = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

    const vals      = Object.values(state);
    const answered  = vals.filter(v => v !== null).length;
    const scoreRaw  = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const score     = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
    const band      = getBand(score, answered);
    const STATUS    = answered === 0 ? 'Not started' : band.title;

    // Header band
    doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
    doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

    // Logo + title + subtitle
    try {
      const logoEl = document.getElementById('pdfLogo');
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);

      if (logoEl && logoEl.complete) {
        const targetW = 18;
        const ratio   = (logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
        const targetH = Math.min(18, targetW * ratio);
        doc.addImage(logoEl,'PNG',LM,6,targetW,targetH,undefined,'FAST');
        doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM + targetW + 4, 22);
      } else {
        doc.text('Compliance365 — Readiness Report', LM, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM, 22);
      }
    } catch (_) {
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text(`${STANDARD} quick-scan summary`, LM, 22);
    }

    // Date + Prepared for
    doc.setFontSize(10);
    doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
    if (lead?.name || lead?.email) {
      const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
      doc.text(prepared, W-RM, 22, { align:'right' });
    }

    // Summary + dial
    y = 38;
    doc.setTextColor(17,24,39); doc.setFont('helvetica','bold'); doc.setFontSize(13);
    doc.text('Your Readiness at a Glance', LM, y); y += 8;

    const dialX = LM + 26, dialY = y + 24;
    doc.setDrawColor(230,233,242); doc.setLineWidth(6);
    doc.circle(dialX, dialY, 20, 'S');
    doc.setDrawColor(79,70,229);
    const pct = Math.max(0,Math.min(score,100))/100;
    const segs = Math.max(1, Math.round(60*pct));
    for(let i=0;i<segs;i++){
      const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
      const a2 = a1 + 0.1;
      doc.line(
        dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
        dialX+20*Math.cos(a2), dialY+20*Math.sin(a2)
      );
    }
    doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
    doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
    doc.text('Status:',    LM+56, y+12);
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
    doc.text(STATUS, LM+56 + 18, y+12);

    // Band meaning + Next steps
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    doc.text('What this means:', LM+56, y+20);
    const meaningLines = doc.splitTextToSize(band.desc || 'Complete the checklist to generate your Trust Score.', 210 - 14 - 14 - (56));
    doc.text(meaningLines, LM+56, y+26);

    // Next steps (aligned to bands)
    const tips = (!answered)
      ? ['Complete the checklist to generate your Trust Score and PDF roadmap.']
      : (score <= 30)
        ? ['Confirm ISMS scope, ownership and core policies', 'Create/refresh risk register and SoA', 'Prioritise a small set of controls to implement first']
        : (score <= 60)
          ? ['Close key gaps that auditors test early', 'Tighten supplier, access and change controls', 'Improve evidence consistency (who/what/when)']
          : (score <= 85)
            ? ['Close minor gaps from “Partial/No” items', 'Prepare an evidence pack (SoA, logs, records)', 'Schedule internal audit + management review cadence']
            : ['Validate evidence is current and traceable', 'Run a light internal audit check', 'Prepare the audit pack and plan certification'];

    let tipsY = y + 26 + (meaningLines.length * 5) + 4;
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39); doc.setFontSize(10);
    doc.text('Next steps:', LM+56, tipsY);
    tipsY += 6;
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, tipsY + i*5));

    y += 64;

    // Domain breakdown
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Domain Breakdown', LM, y); y += 5;

    const DOMAINS = {};
    (Array.isArray(GROUPS)?GROUPS:[]).forEach(g => {
      DOMAINS[g.title] = (Array.isArray(QUESTIONS)?QUESTIONS:[])
        .filter(q => q.group === g.key)
        .map(q => q.id);
    });

    Object.entries(DOMAINS).forEach(([name, ids])=>{
      const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
      const max = ids.length * 2 || 1;
      const p   = Math.round((got/max)*100) || 0;

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      doc.text(name, LM, y+5);

      const barX = LM + 64, barW = W - LM - RM - 64;
      doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
      doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
      const fillW = Math.max(0, Math.min(barW*(p/100), barW));
      doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

      doc.setFont('helvetica','bold'); doc.setTextColor(70);
      doc.text(`${p}%`, barX + barW + 4, y+5);

      y += 11;
    });

    y = hr(y, 6);

  // Trust Score Bands panel in-PDF
if (y > 180) { doc.addPage(); y = 16; }
y = drawTrustBands(doc, LM, y, (W - LM - RM), score, answered) + 6;

// Always start Top Gaps on a new page
doc.addPage();
y = 16;

// Optional divider
y = hr(y, 6);

// Top Gaps & Risks
doc.setFont('helvetica','bold');
doc.setFontSize(12);
doc.setTextColor(17,24,39);
doc.text('Top Gaps & Risks', LM, y);
y += 6;

    const GAP = {
  'isms-scope':
    'Risk: An incomplete ISMS scope may result in systems or services being excluded from security controls and audit coverage.',

  'context':
    'Risk: Poorly defined business context and interested parties may lead to misaligned security objectives and unmet obligations.',

  'leadership':
    'Risk: Lack of visible leadership ownership may weaken accountability and ISMS effectiveness.',

  'policy':
    'Risk: Unapproved or outdated security policies may result in inconsistent control implementation.',

  'risk-method':
    'Risk: Undefined or inconsistent risk criteria may result in inappropriate risk treatment decisions.',

  'risk-reg':
    'Risk: An incomplete or outdated risk register may allow material security risks to remain unmanaged.',

  'controls':
    'Risk: Annex A controls not selected based on risk may result in gaps in mandatory security coverage.',

  'soa':
    'Risk: An incomplete Statement of Applicability may undermine audit defensibility and traceability.',

  'assets':
    'Risk: An incomplete asset inventory may lead to unmanaged or unprotected information assets.',

  'access':
    'Risk: Weak access and JML processes may result in unauthorised access to systems and data.',

  'suppliers':
    'Risk: Undefined supplier security requirements may expose the organisation to third-party security incidents.',

  'secure-dev':
    'Risk: Unassessed changes or development activities may introduce security vulnerabilities into production.',

  'logging':
    'Risk: Insufficient logging and monitoring may delay detection of security incidents.',

  'backup-dr':
    'Risk: Untested backups and recovery plans may result in extended outages or data loss.',

  'vuln-mgmt':
    'Risk: Weak vulnerability management may allow known security flaws to be exploited.',

  'incident':
    'Risk: An untested incident response process may increase impact and recovery time during a breach.',

  'metrics':
    'Risk: Lack of ISMS metrics may prevent management from detecting control weaknesses.',

  'iaudit':
    'Risk: Failure to conduct internal audits may allow nonconformities to persist undetected.',

  'mgmt-review':
    'Risk: Incomplete management reviews may result in ineffective ISMS governance.',

  'improve':
    'Risk: Failure to track continual improvement may stall ISMS maturity over time.'
};

    const highs = [], meds = [];
    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach(q=>{
      const v = state[q.id];
      if (v===0) highs.push(GAP[q.id] || q.label);
      else if (v===1) meds.push(GAP[q.id] || q.label);
    });

    const colW = (W - LM - RM - 6)/2;
 const drawList = (title, items, x, titleColor, accentColor) => {
  if (!items.length) return y;

  // Title
  doc.setFont('helvetica','bold');
  doc.setFontSize(11);
  doc.setTextColor(...titleColor);
  doc.text(title, x, y);

  // Body
  let yy = y + 5;
  doc.setFont('helvetica','normal');
  doc.setFontSize(10);
  doc.setTextColor(17,24,39);

  const startY = yy;

  items.forEach((t) => {
    const lines = doc.splitTextToSize(`• ${t}`, colW);
    doc.text(lines, x, yy);
    yy += (lines.length * 4.6) + 1.5;
  });

  // Left accent bar sized to actual rendered height
  doc.setDrawColor(...accentColor);
  doc.setLineWidth(3);
  doc.line(x - 3, y - 2, x - 3, yy - 2);

  return yy;
};

// IMPORTANT: pass BOTH titleColor and accentColor
const yLeftEnd = drawList(
  'High (No): address first',
  highs,
  LM,
  [239,68,68],
  [239,68,68]
);

const yRightEnd = drawList(
  'Medium (Partial): tighten next',
  meds,
  LM + colW + 6,
  [99,102,241],
  [99,102,241]
);

y = Math.max(yLeftEnd, yRightEnd) + 4;
y = hr(y, 4);

    // Detailed Responses
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Detailed Responses', LM, y); y += 5;

    const drawRow = (idx, text, val)=>{
      if(y>275){ doc.addPage(); y=16; }
      const wrapW = W - LM - RM - 40;
      const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
      const rowH  = 12 + Math.max(0, lines.length-1)*4.2;

      doc.setFillColor(245,247,255);
      doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(lines, LM+4, y+4);

      const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
      let fill=[229,231,235], txt=[107,114,128];
      if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
      else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
      else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      const pillW = Math.max(22, doc.getTextWidth(label) + 8);
      const chipX = W - RM - pillW - 4;
      const chipY = y - 1;
      doc.setDrawColor(222,226,236);
      doc.setFillColor(...fill);
      doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
      doc.setTextColor(...txt);
      doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

      y += rowH + 8;
    };

    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

    // CTA (band-aware label)
    if(y>246){ doc.addPage(); y=16; }
    y += 4;
    const btnW = 178, btnH = 18, btnX = LM, btnY = y;
    doc.setFillColor(79,70,229);
    doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);

    const ctaText =
      (!answered) ? 'Book a roadmap call' :
      (score <= 30) ? 'Book a scope + remediation roadmap call' :
      (score <= 60) ? 'Book a prioritised remediation roadmap call' :
      (score <= 85) ? 'Book an evidence + audit prep roadmap call' :
                      'Book certification support (audit readiness)';

    doc.text(ctaText, btnX + 6, btnY + 12);
    doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

    // Footer
    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
    doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

    doc.save('iso27001_readiness.pdf');
  }
})();
  </script>

  <style>
  :root {
    --primary: #1e40af;
    --primary-dark: #1e3a8a;
    --primary-light: #3b82f6;
    --accent: #06b6d4;
    --light: #f8fafc;
    --muted: #64748b;
    --surface: #ffffff;
    --border: #e2e8f0;
    --shadow-sm: 0 4px 16px rgba(0,0,0,0.06);
    --shadow: 0 12px 40px rgba(30,64,175,0.12);
    --radius: 16px;
    --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    background: var(--light);
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    color: #111827;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--primary-dark);
    margin: 3rem 0 1rem;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .muted { color: var(--muted); line-height: 1.6; }

  /* Info cards at top */
  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 3.5rem;
  }

  .info-cards .card {
    background: white;
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    transition: var(--transition);
  }

  .info-cards .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }

  /* Pill navigation (checklist selector) */
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 2rem 0 1.5rem;
    padding: 0.75rem;
    background: rgba(30,64,175,0.04);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
  }

  .pill {
    background: white;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.65rem 1.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary);
    transition: var(--transition);
    cursor: pointer;
  }

  .pill:hover, .pill[aria-current="page"] {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(30,64,175,0.2);
  }

  /* Progress bar – premium gradient + subtle glow */
  .progress {
    height: 12px;
    background: rgba(30,64,175,0.1);
    border-radius: 999px;
    overflow: hidden;
    margin: 1.5rem 0 2.5rem;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.06);
  }

  #bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 16px rgba(30,64,175,0.4);
  }

  /* Group headers – glassmorphic look */
  .group {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(12px);
    border-radius: var(--radius);
    padding: 1.75rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(30,64,175,0.1);
    box-shadow: var(--shadow-sm);
  }

  .group h3 {
    margin: 0 0 0.5rem;
    color: var(--primary-dark);
  }

  /* Question fields – floating label style */
  .field {
    position: relative;
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem;
    transition: var(--transition);
  }

  .field:hover, .field:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(30,64,175,0.08);
  }

  .field label {
    position: absolute;
    top: -0.75rem;
    left: 1rem;
    background: white;
    padding: 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    pointer-events: none;
  }

  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .opt {
    flex: 1 1 auto;
    min-width: 90px;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    font-weight: 700;
    cursor: pointer;
    background: white;
    border: 2px solid var(--border);
    transition: var(--transition);
    text-align: center;
  }

  .opt.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    box-shadow: 0 6px 20px rgba(30,64,175,0.25);
    transform: translateY(-2px);
  }

  /* Score card – prominent & rewarding */
  #scoreNum {
    font-size: 4rem;
    font-weight: 900;
    color: var(--primary);
    line-height: 1;
  }

  #scoreLabel {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-dark);
  }

  /* Actions bar */
  .actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
  }

  .btn-primary {
