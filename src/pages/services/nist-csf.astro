---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book';
const ctaLabel = 'Book a call';

// FAQ (JSON-LD)
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is NIST CSF 2.0?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NIST CSF 2.0 is a risk-based cybersecurity framework with six core functions (Govern, Identify, Protect, Detect, Respond, Recover) to plan and measure cyber outcomes."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a NIST CSF engagement take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Current Profile: 2–4 weeks. Target Profile & Roadmap: 4–6 weeks. Ongoing measurement: quarterly cadence."
      }
    },
    {
      "@type": "Question",
      "name": "Can you do this with Microsoft 365 only?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We operationalise NIST CSF using Microsoft 365: Defender, Purview, Entra ID, SharePoint, Power Automate and Power BI for evidence and reporting."
      }
    }
  ]
};
---

<Base
  title="NIST CSF 2.0 (Govern, Identify, Protect, Detect, Respond, Recover) — Australia | Compliance365"
  description="NIST CSF 2.0 profiles, roadmap and measurable KPIs — delivered inside Microsoft 365 with audit-ready evidence in SharePoint."
  schema={[
    {
      "@type":"Service",
      "@id":"https://www.compliance365.com.au/services/nist-csf#service",
      "serviceType":"NIST CSF 2.0 Consulting",
      "name":"NIST CSF 2.0 Implementation (Australia)",
      "url":"https://www.compliance365.com.au/services/nist-csf",
      "areaServed":{"@type":"Country","name":"Australia"},
      "provider":{"@type":"Organization","name":"Compliance365","url":"https://www.compliance365.com.au"},
      "offers":{"@type":"Offer","availability":"https://schema.org/InStock"}
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Services","item":"https://www.compliance365.com.au/services"},
        {"@type":"ListItem","position":3,"name":"NIST CSF","item":"https://www.compliance365.com.au/services/nist-csf"}
      ]
    }
  ]}
/>
  <Header />

  <Fragment slot="faq">
    <script type="application/ld+json">
      {JSON.stringify(faqLd)}
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="container section">
    <div class="grid-2" style="align-items:center">
      <div>
        <h1>NIST CSF 2.0</h1>
        <p class="muted">
          Build a <strong>Current Profile → Target Profile</strong> with a prioritised, measurable roadmap —
          and <strong>evidence captured in Microsoft 365 &amp; SharePoint</strong>.
        </p>

        <!-- Pill Row -->
<div class="pill-row scrollable">
  <span class="pill">Current profile</span>
  <span class="pill">Target profile</span>
  <span class="pill">Roadmap</span>
  <span class="pill">Metrics</span>
  <span class="pill">Board reporting</span>
</div>

<!-- Button Row -->
<div class="btn-row">
  <a class="btn btn-primary" href={ctaUrl}>Book a call</a>
  <a class="btn btn-ghost" href={`${base}case-studies`}>See cyber outcomes</a>
</div>

        <p class="small muted" style="margin-top:10px">
          <strong>Trusted by Australian enterprises</strong> — APRA-regulated, critical infrastructure, SaaS.
        </p>
      </div>

      <div class="card" style="padding:0;overflow:hidden;border-radius:22px">
        <img
          src={(import.meta.env.BASE_URL)+'assets/illus-nist-csf.svg'}
          alt="NIST CSF 2.0 evidence and reporting in Microsoft 365"
          style="width:100%;height:auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- WHAT’S INCLUDED -->
  <section class="container section">
    <h2>What’s included</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card"><h3>Profiles</h3><p class="muted">Function/Category/Subcategory review with risk mapping and IG1–IG3 guidance.</p></div>
      <div class="card"><h3>Roadmap</h3><p class="muted">12-month plan: quarterly milestones, owners, budget lens, and dependencies.</p></div>
      <div class="card"><h3>Measurement</h3><p class="muted">Board-level KPIs/KRIs and a posture scorecard (Power BI / Looker Studio).</p></div>
      <div class="card"><h3>Cross-walks</h3><p class="muted">Mappings to ISO 27001 Annex A, Essential Eight, SOC 2 — reduce audit fatigue.</p></div>
      <div class="card"><h3>Runbooks</h3><p class="muted">Repeatable playbooks for tests, incident drills and evidence capture.</p></div>
      <div class="card"><h3>Evidence Hub</h3><p class="muted">SharePoint structure with retention/metadata for every control.</p></div>
    </div>
  </section>

  <!-- MICROSOFT 365 IMPLEMENTATION -->
  <section class="container section">
    <h2>Delivered with Microsoft 365</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card small">
        <h3>Govern &amp; Identify</h3>
        <p class="muted small"><strong>Purview, Entra ID, SharePoint</strong> — data map scans, access reviews, risk register & ownership tracking.</p>
      </div>
      <div class="card small">
        <h3>Protect &amp; Detect</h3>
        <p class="muted small"><strong>Defender, M365 Security, Sentinel</strong> — DLP, vulnerability views, alerts, workbook exports.</p>
      </div>
      <div class="card small">
        <h3>Respond &amp; Recover</h3>
        <p class="muted small"><strong>Teams, Power Automate, OneDrive</strong> — IR runbooks, notifications, PIRs and evidence filing.</p>
      </div>
    </div>
    <p class="muted" style="margin-top:10px">
      Every artefact is filed in your <em>Evidence Hub</em> (SharePoint) with Framework, Control, Owner and Period metadata.
    </p>
  </section>

  <!-- OUTCOMES -->
  <section class="container section">
    <h2>Outcomes</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card"><h3>Faster posture lift</h3><p class="muted">Quarterly wins visible to execs and the board.</p></div>
      <div class="card"><h3>Reduced duplication</h3><p class="muted">One set of evidence cross-mapped to common frameworks.</p></div>
      <div class="card"><h3>No new platform</h3><p class="muted">Everything delivered natively in Microsoft 365.</p></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Ready to operationalise NIST CSF?</h3>
        <p class="muted" style="margin:0">Profiles → Roadmap → Metrics — with SharePoint evidence.</p>
      </div>
      <a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
    </div>
  </section>

  <!-- RELATED -->
  <section class="container section">
    <div class="card" style="display:flex;gap:12px;flex-wrap:wrap">
      <strong style="margin-right:8px">Related services:</strong>
      <a class="pill" href="/services/iso27001">ISO 27001</a>
      <a class="pill" href="/services/iso27701">ISO 27701</a>
      <a class="pill" href="/services/iso42001">ISO 42001</a>
      <a class="pill" href="/services/soc2">SOC 2</a>
      <a class="pill" href="/services/essential-eight">Essential Eight</a>
      <a class="pill" href="/services/disp-ism-irap">DISP / ISM / IRAP</a>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .pill-row {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: nowrap;
    margin: 1rem 0;
  }

  .pill-row.scrollable {
    overflow-x: auto;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
  }

  .pill-row.scrollable::-webkit-scrollbar {
    height: 6px;
  }

  .pill {
    background: linear-gradient(90deg, #4F46E5, #3B82F6);
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
  }

  .btn-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }
</style>
