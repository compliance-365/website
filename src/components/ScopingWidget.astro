---
/**
 * ScopingWidget.astro
 * ===================
 * Drop into src/components/ScopingWidget.astro
 *
 * Usage in any .astro file:
 *   import ScopingWidget from '../components/ScopingWidget.astro';
 *   <ScopingWidget />
 *
 * Optional props:
 *   <ScopingWidget calendlyUrl="https://..." />
 *
 * To tune pricing, edit the BASE_COST and PLATFORM_ANNUAL objects
 * in the <script is:inline> block at the bottom of this file.
 * Comments mark the tunable section clearly.
 */

interface Props {
  calendlyUrl?: string;
}

const {
  calendlyUrl = 'https://calendly.com/matt-nicholas-compliance365/30min',
} = Astro.props;
---

<div class="c365-scoper" aria-label="Compliance framework scoping tool" data-calendly={calendlyUrl}>
  <div class="c365-scoper__card">

    <div class="c365-scoper__eyebrow">
      <span class="c365-scoper__badge">365</span>
      <span class="c365-scoper__eyebrow-text">Free scoping tool</span>
    </div>

    <h3 class="c365-scoper__title">Get a realistic scope in 30 seconds</h3>
    <p class="c365-scoper__subtitle">Three questions. Instant estimate including the third-party platform licence costs you'll avoid. No sign-up.</p>

    <div id="c365-form">

      <div class="c365-scoper__group">
        <label class="c365-scoper__label">Which framework do you need?</label>
        <div class="c365-scoper__grid c365-scoper__grid--6">
          <button class="c365-opt" data-group="framework" data-value="iso27001" type="button">ISO 27001</button>
          <button class="c365-opt" data-group="framework" data-value="soc2" type="button">SOC 2</button>
          <button class="c365-opt" data-group="framework" data-value="essential8" type="button">Essential Eight</button>
          <button class="c365-opt" data-group="framework" data-value="iso42001" type="button">ISO 42001 (AI)</button>
          <button class="c365-opt" data-group="framework" data-value="multi" type="button">Two or more</button>
          <button class="c365-opt" data-group="framework" data-value="unsure" type="button">Not sure yet</button>
        </div>
      </div>

      <div class="c365-scoper__group">
        <label class="c365-scoper__label">Company size</label>
        <div class="c365-scoper__grid c365-scoper__grid--4">
          <button class="c365-opt" data-group="size" data-value="small" type="button">Under 50</button>
          <button class="c365-opt" data-group="size" data-value="mid" type="button">50&ndash;200</button>
          <button class="c365-opt" data-group="size" data-value="large" type="button">200&ndash;500</button>
          <button class="c365-opt" data-group="size" data-value="enterprise" type="button">500+</button>
        </div>
      </div>

      <div class="c365-scoper__group">
        <label class="c365-scoper__label">Timeline pressure</label>
        <div class="c365-scoper__grid c365-scoper__grid--4">
          <button class="c365-opt" data-group="timing" data-value="exploring" type="button">Just exploring</button>
          <button class="c365-opt" data-group="timing" data-value="planning" type="button">Planning for 2026</button>
          <button class="c365-opt" data-group="timing" data-value="tender" type="button">In a live tender</button>
          <button class="c365-opt" data-group="timing" data-value="urgent" type="button">Already overdue</button>
        </div>
      </div>

      <div id="c365-cta-row" class="c365-scoper__cta-row" aria-disabled="true">
        <button id="c365-calc-btn" type="button" class="c365-btn c365-btn--primary">Show my estimate &rarr;</button>
        <span id="c365-hint" class="c365-scoper__hint">Pick one from each row to unlock</span>
      </div>
    </div>

    <div id="c365-result" class="c365-scoper__result" hidden>
      <div class="c365-scoper__eyebrow">
        <span class="c365-scoper__badge">365</span>
        <span class="c365-scoper__eyebrow-text">Indicative scope</span>
      </div>
      <h3 id="c365-result-title" class="c365-scoper__result-title"></h3>

      <div class="c365-scoper__metrics">
        <div class="c365-metric">
          <div class="c365-metric__label">Time to audit-ready</div>
          <div id="c365-r-weeks" class="c365-metric__value">&mdash;</div>
        </div>
        <div class="c365-metric">
          <div class="c365-metric__label">Compliance365 fee</div>
          <div id="c365-r-cost" class="c365-metric__value">&mdash;</div>
        </div>
      </div>

      <div class="c365-tco">
        <div class="c365-tco__heading">3-year total cost of ownership</div>
        <div class="c365-tco__grid">
          <div>
            <div class="c365-tco__sublabel">Typical: consultant + third-party platform</div>
            <div id="c365-r-tco-them" class="c365-tco__value c365-tco__value--strike">&mdash;</div>
          </div>
          <div>
            <div class="c365-tco__sublabel">Compliance365: no third-party platform</div>
            <div id="c365-r-tco-us" class="c365-tco__value">&mdash;</div>
          </div>
        </div>
        <div id="c365-r-tco-saving" class="c365-tco__saving"></div>
      </div>

      <div class="c365-milestone">
        <strong>Week 1&ndash;2:</strong> <span>Scoping engagement. End of week 2 you have a precise gap analysis and prioritised remediation roadmap &mdash; fixed-price, no obligation to continue.</span>
      </div>

      <div id="c365-r-note" class="c365-scoper__note"></div>

      <div class="c365-scoper__actions">
        <button id="c365-book-btn" type="button" class="c365-btn c365-btn--primary">Book a 30-min call &rarr;</button>
        <button id="c365-reset-btn" type="button" class="c365-btn c365-btn--ghost">Try different inputs</button>
      </div>

      <p class="c365-scoper__disclaimer">Estimate based on typical engagement patterns. Precise scope confirmed on call after reviewing your environment.</p>
    </div>

  </div>
</div>

<style is:global>
  .c365-scoper {
    font-family: inherit;
    color: #0B0B0C;
    max-width: 100%;
    box-sizing: border-box;
  }
  .c365-scoper *, .c365-scoper *::before, .c365-scoper *::after { box-sizing: border-box; }
  .c365-scoper__card {
    background: #ffffff;
    border: 1px solid #DDD8CF;
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }
  @media (max-width: 540px) { .c365-scoper__card { padding: 20px; } }

  .c365-scoper__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }
  .c365-scoper__badge {
    width: 28px; height: 28px;
    border-radius: 6px;
    background: #8B6820;
    color: #ffffff;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 600;
  }
  .c365-scoper__eyebrow-text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #6B6860;
    text-transform: uppercase;
  }
  .c365-scoper__title {
    font-size: 22px;
    font-weight: 700;
    margin: 8px 0 6px;
    color: #8B6820;
    line-height: 1.25;
  }
  .c365-scoper__subtitle {
    font-size: 14px;
    color: #3A3632;
    margin: 0 0 24px;
    line-height: 1.6;
  }
  .c365-scoper__group { margin-bottom: 20px; }
  .c365-scoper__group:last-of-type { margin-bottom: 24px; }
  .c365-scoper__label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #0B0B0C;
  }
  .c365-scoper__grid {
    display: grid;
    gap: 8px;
  }
  .c365-scoper__grid--6 { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
  .c365-scoper__grid--4 { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }

  .c365-opt {
    background: #ffffff;
    border: 1px solid #DDD8CF;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 400;
    font-family: inherit;
    color: #0B0B0C;
    cursor: pointer;
    transition: all 0.12s ease;
    text-align: center;
    line-height: 1.4;
  }
  .c365-opt:hover { border-color: #A9812E; }
  .c365-opt:focus-visible { outline: 2px solid #A9812E; outline-offset: 2px; }
  .c365-opt.is-active {
    background: #A9812E;
    color: #ffffff;
    border-color: #A9812E;
    font-weight: 600;
  }

  .c365-scoper__cta-row {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .c365-scoper__cta-row.is-ready {
    opacity: 1;
    pointer-events: auto;
  }
  .c365-scoper__hint {
    font-size: 13px;
    color: #6B6860;
  }
  .c365-btn {
    border: none;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.12s ease;
    line-height: 1.2;
  }
  .c365-btn--primary {
    background: #A9812E;
    color: #ffffff;
  }
  .c365-btn--primary:hover { background: #8B6820; }
  .c365-btn--ghost {
    background: transparent;
    color: #A9812E;
    border: 1px solid #A9812E;
  }
  .c365-btn--ghost:hover { background: rgba(169,129,46,0.06); }
  .c365-btn:focus-visible { outline: 2px solid #A9812E; outline-offset: 2px; }

  .c365-scoper__result {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #DDD8CF;
  }
  .c365-scoper__result-title {
    font-size: 18px;
    font-weight: 700;
    margin: 8px 0 14px;
    color: #8B6820;
    line-height: 1.3;
  }
  .c365-scoper__metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }
  .c365-metric {
    background: #FAF7F1;
    border-radius: 8px;
    padding: 14px;
  }
  .c365-metric__label {
    font-size: 12px;
    color: #6B6860;
    margin-bottom: 4px;
  }
  .c365-metric__value {
    font-size: 22px;
    font-weight: 700;
    color: #0B0B0C;
    line-height: 1.2;
  }

  .c365-tco {
    background: #ecfdf5;
    border: 1px solid #6ee7b7;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
  }
  .c365-tco__heading {
    font-size: 12px;
    font-weight: 700;
    color: #065f46;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .c365-tco__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .c365-tco__sublabel {
    font-size: 12px;
    color: #047857;
    margin-bottom: 2px;
  }
  .c365-tco__value {
    font-size: 16px;
    font-weight: 700;
    color: #065f46;
    line-height: 1.2;
  }
  .c365-tco__value--strike {
    text-decoration: line-through;
    text-decoration-color: #6ee7b7;
  }
  .c365-tco__saving {
    font-size: 13px;
    color: #065f46;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #6ee7b7;
    line-height: 1.5;
  }
  .c365-tco__saving strong { font-weight: 700; }

  .c365-milestone {
    background: #FAF7F1;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 16px;
    font-size: 13px;
    line-height: 1.6;
  }
  .c365-milestone strong { font-weight: 600; color: #0B0B0C; }
  .c365-milestone span { color: #3A3632; }

  .c365-scoper__note {
    font-size: 13px;
    color: #3A3632;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .c365-scoper__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .c365-scoper__disclaimer {
    font-size: 11px;
    color: #6B6860;
    margin: 14px 0 0;
    line-height: 1.5;
  }

  @media (max-width: 460px) {
    .c365-scoper__metrics, .c365-tco__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
(function() {
  /* ============================================================
     EDIT THESE TO TUNE PRICING — all values in AUD thousands
     ============================================================ */
  var BASE_WEEKS = {
    iso27001:   [10, 14],
    soc2:       [8, 12],
    essential8: [10, 14],
    iso42001:   [8, 12],
    multi:      [12, 16],
    unsure:     [10, 14]
  };

  var BASE_COST = {
    iso27001:   { small: [25, 45], mid: [40, 70],  large: [60, 95],  enterprise: [85, 130] },
    soc2:       { small: [22, 40], mid: [35, 60],  large: [55, 85],  enterprise: [75, 115] },
    essential8: { small: [22, 40], mid: [38, 65],  large: [55, 90],  enterprise: [80, 120] },
    iso42001:   { small: [18, 32], mid: [28, 50],  large: [45, 75],  enterprise: [65, 100] },
    multi:      { small: [40, 70], mid: [60, 100], large: [90, 140], enterprise: [120, 180] },
    unsure:     { small: [25, 50], mid: [40, 75],  large: [60, 100], enterprise: [85, 140] }
  };

  /* Avoided third-party GRC platform licence cost per year (Vanta/Drata/Secureframe range) */
  var PLATFORM_ANNUAL = {
    small:      [15, 22],
    mid:        [22, 32],
    large:      [32, 45],
    enterprise: [45, 60]
  };
  /* ============================================================
     End of tunable section
     ============================================================ */

  var FRAMEWORK_LABEL = {
    iso27001:   'ISO 27001',
    soc2:       'SOC 2 Type II',
    essential8: 'Essential Eight (ML2)',
    iso42001:   'ISO 42001 (AI Governance)',
    multi:      'Multi-framework programme',
    unsure:     'Scoping conversation'
  };

  var SIZE_LABEL = {
    small:      'under 50 staff',
    mid:        '50\u2013200 staff',
    large:      '200\u2013500 staff',
    enterprise: '500+ staff'
  };

  var state = { framework: null, size: null, timing: null };
  var rootEl = document.querySelector('.c365-scoper');
  var calendlyUrl = (rootEl && rootEl.dataset.calendly) || '';

  function $(id) { return document.getElementById(id); }

  function setActive(group, value) {
    var buttons = document.querySelectorAll('.c365-opt[data-group="' + group + '"]');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].classList.toggle('is-active', buttons[i].dataset.value === value);
    }
  }

  function checkReady() {
    var ready = state.framework && state.size && state.timing;
    var cta = $('c365-cta-row');
    cta.classList.toggle('is-ready', !!ready);
    cta.setAttribute('aria-disabled', ready ? 'false' : 'true');
    $('c365-hint').style.display = ready ? 'none' : 'inline';
  }

  var allOpts = document.querySelectorAll('.c365-opt');
  for (var i = 0; i < allOpts.length; i++) {
    allOpts[i].addEventListener('click', function(e) {
      var btn = e.currentTarget;
      var group = btn.dataset.group;
      var value = btn.dataset.value;
      state[group] = value;
      setActive(group, value);
      checkReady();
    });
  }

  $('c365-calc-btn').addEventListener('click', function() {
    if (!state.framework || !state.size || !state.timing) return;

    var fw = state.framework;
    var sz = state.size;
    var tm = state.timing;

    var weeks = BASE_WEEKS[fw].slice();
    if (sz === 'large') { weeks[0] += 2; weeks[1] += 2; }
    if (sz === 'enterprise') { weeks[0] += 4; weeks[1] += 6; }
    if (tm === 'urgent') { weeks[1] = Math.max(weeks[0], weeks[1] - 2); }

    var cost = BASE_COST[fw][sz];
    var costMid = Math.round((cost[0] + cost[1]) / 2);

    var platform = PLATFORM_ANNUAL[sz];
    var platformMid = Math.round((platform[0] + platform[1]) / 2);
    var threeYearPlatform = platformMid * 3;
    var tcoThem = costMid + threeYearPlatform;
    var tcoUs = costMid;

    $('c365-result-title').textContent = FRAMEWORK_LABEL[fw] + ' \u2014 ' + SIZE_LABEL[sz];
    $('c365-r-weeks').textContent = weeks[0] + '\u2013' + weeks[1] + ' wks';
    $('c365-r-cost').textContent = '$' + cost[0] + 'k\u2013$' + cost[1] + 'k';
    $('c365-r-tco-them').textContent = '$' + tcoThem + 'k';
    $('c365-r-tco-us').textContent = '$' + tcoUs + 'k';
    $('c365-r-tco-saving').innerHTML = '<strong>~$' + threeYearPlatform + 'k saved</strong> over 3 years by avoiding third-party GRC platform licences (Vanta, Drata, Secureframe etc. typically $' + platform[0] + '\u2013$' + platform[1] + 'k/year at this scale).';

    var note = '';
    if (fw === 'unsure') {
      note = '\u201CNot sure which framework you need\u201D is the most common starting point. The 30-min call decides it based on who\u2019s asking \u2014 customers, procurement, your insurer, or government.';
    } else if (tm === 'urgent') {
      note = 'You\u2019re behind a deadline \u2014 we can compress. Same fixed-price guarantee even on fast-track engagements.';
    } else if (tm === 'tender') {
      note = 'Live tender \u2014 we prioritise the evidence procurement teams actually ask for first, so you have something defensible to submit within weeks.';
    } else if (tm === 'planning') {
      note = 'Good runway. We typically start with the 2-week scoping engagement to lock the precise path, then execute.';
    } else {
      note = 'A 30-min call gets you a precise scope at no cost or obligation.';
    }
    $('c365-r-note').textContent = note;

    $('c365-form').style.display = 'none';
    var result = $('c365-result');
    result.hidden = false;
    if (result.scrollIntoView) result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    if (typeof gtag === 'function') {
      gtag('event', 'scoping_tool_completed', { framework: fw, company_size: sz, timing: tm });
    }
  });

  $('c365-book-btn').addEventListener('click', function() {
    if (typeof gtag === 'function') gtag('event', 'cta_book_call_click', { link_url: calendlyUrl, link_text: 'scoping tool result', page_location: window.location.href });
    if (calendlyUrl) {
      window.open(calendlyUrl, '_blank', 'noopener,noreferrer');
    }
  });

  $('c365-reset-btn').addEventListener('click', function() {
    state.framework = null; state.size = null; state.timing = null;
    var active = document.querySelectorAll('.c365-opt.is-active');
    for (var i = 0; i < active.length; i++) active[i].classList.remove('is-active');
    $('c365-result').hidden = true;
    $('c365-form').style.display = 'block';
    checkReady();
  });
})();
</script>
