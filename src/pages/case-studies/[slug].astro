---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/case-studies.css';

const base = import.meta.env.BASE_URL || '/';
const site = Astro.site?.toString() || 'https://www.compliance365.com.au';

// Helper: absolute URL for images in JSON-LD
function abs(u) {
  if (!u) return undefined;
  return /^https?:\/\//i.test(u) ? u : new URL(u.replace(/^\/+/, ''), site).toString();
}

/**
 * Supported front-matter in content/case-studies/*.md:
 * - logo: "/images/logos/client.png"
 * - hero: { image: "/images/case-studies/hero.jpg", alt: "Network map" }
 * - sector: "Government"
 * - services: ["ISO 27001", "SOC 2"]
 * - tags: ["IS18","Essential Eight"]
 * - metrics: ["<strong>82%</strong> readiness", "Report in 4 weeks"]
 * - testimonial: { quote, name, title, avatar }
 * - seo: { image, description, keywords }
 * - date, updated
 * - ctaLabel, ctaUrl
 */
export async function getStaticPaths() {
  const entries = await Astro.glob('../../../content/case-studies/*.md');
  return entries.map((entry) => {
    const slug = entry.file.split('/').pop().replace(/\.md$/, '');
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
if (!entry) throw new Error('Case study entry not found');

const fm        = entry.frontmatter ?? {};
const title     = fm.title ?? 'Case Study';
const summary   = fm.summary ?? fm.description ?? '';
const hero      = fm.hero ?? null;
const logo      = fm.logo ?? null;
const sector    = fm.sector ?? null;
const services  = Array.isArray(fm.services) ? fm.services : [];
const tags      = Array.isArray(fm.tags) ? fm.tags : [];
const metrics   = Array.isArray(fm.metrics) ? fm.metrics : [];
const testimonial = fm.testimonial ?? null;
const seo       = fm.seo ?? {};
const canonical = `${site}/case-studies/${Astro.params.slug}/`;

// Normalised image for JSON-LD
const heroImg   = abs(hero?.image) || abs(seo?.image);

// Build JSON-LD without spreads (keeps esbuild happy)
const caseStudySchema = {
  "@type": "CaseStudy",
  "@id": `${canonical}#casestudy`,
  "headline": title,
  "name": title,
  "url": canonical,
  "isPartOf": { "@id": `${site}#website` },
  "publisher": {
    "@type": "Organization",
    "name": "Compliance365",
    "url": site,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('assets/logo.png', site).toString()
    }
  }
};
if (summary) caseStudySchema.description = summary;
if (heroImg) caseStudySchema.image = heroImg;
if (fm.date) caseStudySchema.datePublished = new Date(fm.date).toISOString();
if (fm.updated) caseStudySchema.dateModified = new Date(fm.updated).toISOString();

const breadcrumbsSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumbs`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",         "item": site + "/" },
    { "@type": "ListItem", "position": 2, "name": "Case Studies", "item": `${site}/case-studies/` },
    { "@type": "ListItem", "position": 3, "name": title,          "item": canonical }
  ]
};

const pageSchema = [caseStudySchema, breadcrumbsSchema];

// CTA defaults
const ctaLabel = fm.ctaLabel ?? 'Book a call';
const ctaUrl   = fm.ctaUrl   ?? `${base}book`;
---

<Base
  title={`${title} — Case Study`}
  description={summary}
  schema={pageSchema}
>
  <Header />

  <section class="cs-wrap">
    <a href="/case-studies/" class="back-link">← Back to Case Studies</a>

    <!-- Hero Section -->
    <div class="cs-hero">
      <div class="brand">
        {logo && <img src={logo} alt="Client logo" loading="lazy" />}
        <div>
          <h1>{title}</h1>
          {summary && <p class="lead">{summary}</p>}
        </div>
      </div>

      <!-- Meta info -->
      <div class="cs-meta">
        {sector && <span class="cs-pill">Sector: {sector}</span>}
        {services.length > 0 && <span class="cs-pill">Services: {services.join(', ')}</span>}
        {tags.length > 0 && <span class="cs-pill">Tags: {tags.join(', ')}</span>}
      </div>

      <!-- Hero Image -->
      {hero?.image && (
        <div class="cs-hero-img">
          <img src={hero.image} alt={hero.alt || 'Case study'} loading="lazy" />
        </div>
      )}

      <!-- KPI Metrics -->
      {metrics.length > 0 && (
        <div class="cs-metrics">
          {metrics.map((m) => (
            <div class="cs-card">
              <div class="cs-kpi" set:html={m}></div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Case Study Body -->
    <article class="prose">
      {entry ? <entry.Content /> : <p>Coming soon.</p>}
    </article>

    <!-- Optional Testimonial -->
    {testimonial && (
      <div class="cs-quote">
        <p>“{testimonial.quote}”</p>
        <div class="who">
          {testimonial.avatar && <img src={testimonial.avatar} alt="" loading="lazy" />}
          <span>{testimonial.name}{testimonial.title ? ` — ${testimonial.title}` : ''}</span>
        </div>
      </div>
    )}

    <!-- CTA -->
    <section class="cs-cta">
      <div>
        <h3 style="margin:0 0 6px">Need a similar outcome?</h3>
        <p style="margin:0;opacity:.85">
          We help government, health, and technology organisations achieve certification faster
          with automated evidence and expert delivery.
        </p>
      </div>
      <a href={ctaUrl} class="btn btn-primary">{ctaLabel}</a>
    </section>
  </section>

  <Footer />
</Base>
