---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

const images = {
  controlsDiagram: '/assets/controls-mapping-diagram.png',
  winDealsFaster: '/assets/win-deals-faster-illustration.png',
  procurementFriction: '/assets/procurement-no-friction.png',
  confidenceShield: '/assets/confidence-when-asked.png',
  heroBackground: '/assets/hero-background-gradient.jpg', // optional
  heartTrustBokeh: '/assets/heart-trust-bokeh.jpg',       // new subtle trust background
};
---

<Base
  title="Guaranteed Compliance for Security, Privacy & AI — Delivered Fast | Compliance365"
  description="Stop losing deals to compliance delays. ISO 27001, SOC 2, HIPAA, Essential Eight — in weeks, inside your environment, at a fraction of the cost."
>
  <Header />

  <!-- Announcement -->
  <div class="announce">
    <div class="container">
      <div class="announce-inner">
        <span class="announce-dot"></span>
        <span class="announce-text">✔ ISO 27001 • ISO 27701 • ISO 42001 • SOC 2 • Essential Eight • SaaS & Tech Experts • Using Your Existing Systems</span>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-content">
        <h1>Guaranteed Compliance for<br>Security, Privacy & AI</h1>
        <p class="hero-sub">Delivered in Weeks. Inside Your Environment. At a Fraction of the Cost.</p>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn btn-primary">Book Free Compliance Call</a>
          <a href={`${base}checklist/`} class="btn btn-outline">Get Free ComplianceReady™ Score</a>
        </div>

        <div class="hero-kickers">
          <span>No New Tools</span>
          <span>No Disruption</span>
          <span>Revenue-First Approach</span>
        </div>
      </div>

      <div class="hero-visual">
        <img 
          src={images.controlsDiagram} 
          alt="Central ISO 27001 controls mapping to SOC 2, HIPAA, Essential Eight" 
          width="620" 
          height="460"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- PROBLEM / FEARS -->
  <section class="section fears">
    <div class="container narrow center">
      <h2>The 3 Biggest Fears Killing Your Deals Right Now</h2>
      <p class="lead">Strong pipeline. Great product. Still losing revenue because compliance proof can't be delivered fast enough.</p>
    </div>

    <div class="container">
      <div class="fear-grid">
        <div class="fear-card red">
          <h3>Losing big deals at the final hurdle</h3>
          <p>Procurement kills the deal when assurance isn't proven quickly and credibly — even when your product is clearly better.</p>
        </div>
        <div class="fear-card orange">
          <h3>Being labelled “high risk”</h3>
          <p>Risk & procurement teams default to "no" the moment evidence looks missing, inconsistent, or hard to defend.</p>
        </div>
        <div class="fear-card blue">
          <h3>Scrambling when proof is requested</h3>
          <p>Teams dig through spreadsheets, emails, and tribal knowledge — wasting time and looking unprepared.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT CLIENTS REALLY WANT (with heart bg) -->
  <section class="section desires" style={`background: linear-gradient(rgba(255,255,255,0.92), rgba(255,255,255,0.88)), url(${images.heartTrustBokeh}) center/cover no-repeat;`}>
    <div class="container center">
      <h2>What Your Enterprise Clients Really Want</h2>
      <p class="subtitle">Buyers want confidence. Procurement wants consistency. Auditors want evidence. Your team wants calm — not chaos.</p>

      <div class="desire-grid">
        <div class="desire-card">
          <img src={images.winDealsFaster} alt="Closing deals faster illustration" loading="lazy" />
          <h3>Win deals faster</h3>
          <p>Security, privacy & AI compliance should accelerate revenue — not add months to the sales cycle.</p>
        </div>
        <div class="desire-card">
          <img src={images.procurementFriction} alt="Frictionless procurement process" loading="lazy" />
          <h3>Move through procurement without friction</h3>
          <p>Weeks, not months. Predictable timelines. Calm teams focused on delivery.</p>
        </div>
        <div class="desire-card">
          <img src={images.confidenceShield} alt="Confidence shield illustration" loading="lazy" />
          <h3>Confidence when customers ask hard questions</h3>
          <p>Clear, defensible, evidence-backed answers — ready in minutes, not fire drills.</p>
        </div>
      </div>

      <div class="cta-band center" style="margin-top: 3rem;">
        <a href={ctaUrl} class="btn btn-primary large">Turn Compliance Into Revenue — Book Now</a>
      </div>
    </div>
  </section>

  <!-- COMPLIANCEREADY HIGHLIGHT -->
  <section class="section compliance-ready" id="system">
    <div class="container">
      <div class="section-head center">
        <h2>ComplianceReady™ — Built for Revenue, Not Red Tape</h2>
        <p class="tagline">Stop treating compliance like a massive project. Start treating it like a competitive advantage.</p>
      </div>

      <div class="comparison">
        <div class="compare-column bad">
          <h3>Traditional Way</h3>
          <ul>
            <li>6–18 month timelines</li>
            <li>Engineering disruption</li>
            <li>Expensive consultants</li>
            <li>Generic templates</li>
            <li>New tools forced on teams</li>
          </ul>
        </div>
        <div class="compare-column good">
          <h3>ComplianceReady™</h3>
          <ul>
            <li>Weeks, not months</li>
            <li>Inside your existing environment</li>
            <li>No unnecessary new tools</li>
            <li>Minimal, targeted fixes</li>
            <li>Real auditor expectations</li>
          </ul>
        </div>
      </div>

      <div class="outcomes-grid">
        <div>Faster deal velocity</div>
        <div>Lower total cost</div>
        <div>Reduced procurement risk</div>
        <div>Protected engineering bandwidth</div>
        <div>Scales with growth</div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final-cta">
    <div class="container narrow center">
      <h2>Ready to Stop Losing Revenue to Compliance Friction?</h2>
      <p class="lead">Get compliant fast, prove trust instantly, and close enterprise deals with confidence.</p>

      <div class="final-buttons">
        <a href={ctaUrl} class="btn btn-primary large">Book Free Compliance Call</a>
        <a href={`${base}checklist/`} class="btn btn-outline large">Free ComplianceReady™ Score</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* ... (keep your existing styles, add/adjust these) */

  .desires {
    padding: 7rem 0;
  }
  .subtitle {
    font-size: 1.3rem;
    color: var(--muted);
    max-width: 720px;
    margin: 1rem auto 3rem;
  }
  .fear-grid, .desire-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }
  .fear-card, .desire-card {
    padding: 2rem;
    border-radius: 16px;
    background: white;
    box-shadow: 0 10px 30px -12px rgba(0,0,0,0.08);
    border-left: 5px solid transparent;
  }
  .fear-card.red { border-left-color: #ef4444; }
  .fear-card.orange { border-left-color: #f97316; }
  .fear-card.blue { border-left-color: #3b82f6; }
  .desire-card img {
    width: 100%;
    max-height: 180px;
    object-fit: contain;
    margin-bottom: 1.4rem;
    border-radius: 12px;
  }

  .cta-band {
    padding: 2.5rem;
    background: linear-gradient(135deg, #4154f1 0%, #6366f1 100%);
    color: white;
    border-radius: 20px;
  }
  .btn.large { padding: 1.2rem 2.8rem; font-size: 1.2rem; }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-visual { margin-bottom: 2rem; }
    .comparison { grid-template-columns: 1fr; }
  }
</style>
