<script is:inline>
(function () {
  var rail = document.querySelector('.tour-rail');
  if (!rail) return;
  var tabs = rail.querySelectorAll('.tour-tab');
  var panels = document.querySelectorAll('.tour-panel');
  function select(key) {
    tabs.forEach(function (t) {
      var on = t.dataset.tourTab === key;
      t.classList.toggle('on', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach(function (p) {
      p.classList.toggle('on', p.dataset.tourPanel === key);
    });
  }
  tabs.forEach(function (t) {
    t.addEventListener('click', function () { select(t.dataset.tourTab); });
  });
})();
</script>

