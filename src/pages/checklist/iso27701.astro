---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27701';
const QUESTIONS = [
  { id:'pims-owner',   label:'PIMS owner appointed with roles across legal, security and product?' },
  { id:'pims-objs',    label:'Privacy objectives/metrics defined and reviewed regularly?' },

  { id:'ropa',         label:'Data inventory / ROPA maintained (purposes, lawful bases, recipients, locations)?' },
  { id:'retention',    label:'Retention rules defined and implemented; deletion workflows exercised?' },

  { id:'dsar-proc',    label:'Documented DSAR workflow (access, rectification, deletion, portability, objection)?' },
  { id:'dsar-sla',     label:'Identity verification and SLA tracking for rights requests in place?' },

  { id:'dpia-thresh',  label:'DPIA threshold & template defined; reviews before go-live for high-risk processing?' },
  { id:'dpia-actions', label:'DPIA outcomes have mitigations; residual risk accepted by management where needed?' },

  { id:'processors',   label:'Processor due diligence performed; contracts include privacy clauses & sub-processing?' },
  { id:'vendor-reg',   label:'Vendor register with periodic reviews, change tracking and exit plans?' },

  { id:'sec-map',      label:'ISO 27001/Annex A controls mapped to protect personal data (MFA, logging, encryption)?' },

  { id:'breach-proc',  label:'Privacy incident workflow includes 72-hour assessment & notification decision log?' },

  { id:'notice',       label:'Privacy notices accurate (purposes, bases, rights, transfers, contact) and up to date?' },
  { id:'training',     label:'Role-based privacy training tracked with completion records?' },

  { id:'monitor',      label:'PIMS performance reviewed (metrics, audits, improvements) at least quarterly?' }
];
---
<Base title="ISO 27701 Readiness Checklist" description="Answer quick questions, get an instant score and a downloadable PDF.">
  <Header />

  <section class="container section">
    <h1>{STANDARD} Readiness Checklist</h1>

    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill" aria-current="page">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:14px;">
        {QUESTIONS.map((q, i) => (
          <div class="field" data-id={q.id} style="padding:10px 12px;border:1px solid rgba(10,18,32,.08);border-radius:12px">
            <label style="display:block;font-weight:800;margin:0 0 8px;">{i + 1}. {q.label}</label>
            <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="opt pill" data-v="2" type="button">Yes</button>
              <button class="opt pill" data-v="1" type="button">Partial</button>
              <button class="opt pill" data-v="0" type="button">No</button>
            </div>
          </div>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
  const STANDARD  = "ISO 27701 (Privacy)";
  const QUESTIONS = [
    { id:'pims-scope', label:'PIMS scope, roles & objectives defined and approved?' },
    { id:'ropa', label:'Records of processing (ROPA) complete and owned?' },
    { id:'dpia', label:'DPIA / PIA process in place and used for higher-risk processing?' },
    { id:'rights', label:'Data subject rights process (access, rectification, deletion, etc.) working?' },
    { id:'third-parties', label:'Third-party processing due diligence and clauses in place?' },
    { id:'controls', label:'Privacy controls implemented and mapped to ISO 27701 annexes?' },
    { id:'awareness', label:'Role-based privacy training and ongoing awareness run?' },
    { id:'evidence', label:'SharePoint evidence for privacy logs, approvals, and decisions captured?' }
  ];

  (function init(){(document.readyState==='loading')?document.addEventListener('DOMContentLoaded',setup):setup();})();
  function setup(){
    const form=document.getElementById('form'), bar=document.getElementById('bar');
    const scoreNum=document.getElementById('scoreNum'), scoreLabel=document.getElementById('scoreLabel'), scoreHint=document.getElementById('scoreHint');
    const resetBtn=document.getElementById('resetBtn'), pdfBtn=document.getElementById('pdfBtn');
    const state=Object.fromEntries(QUESTIONS.map(q=>[q.id,null]));

    form.addEventListener('click', (e)=>{
      const btn=e.target.closest('button.opt'); if(!btn) return;
      const field=btn.closest('.field'); const id=field.dataset.id; const val=Number(btn.dataset.v);
      state[id]=val; field.querySelectorAll('button.opt').forEach(o=>o.classList.remove('active')); btn.classList.add('active');
      update();
    });

    resetBtn.addEventListener('click', ()=>{
      Object.keys(state).forEach(k=>state[k]=null);
      document.querySelectorAll('button.opt.active').forEach(o=>o.classList.remove('active'));
      update();
    });

    pdfBtn.addEventListener('click', ()=>{
      const {answered}=compute(); if(answered<QUESTIONS.length){ alert('Please answer all questions first.'); return; }
      generatePDF(state);
    });

    function compute(){
      const answered=Object.values(state).filter(v=>v!==null).length;
      const scoreRaw=Object.values(state).reduce((a,v)=>a+(v??0),0);
      const score=Math.round((scoreRaw/(Object.keys(state).length*2))*100);
      return {answered, score:isNaN(score)?0:score};
    }
    function update(){
      const {answered,score}=compute(); const pct=Math.round((answered/Object.keys(state).length)*100);
      bar.style.width=pct+'%'; scoreNum.textContent=`${score}%`;
      let label='Not started', hint='Answer the questions to see your readiness.';
      if(answered>0 && score<40){label='Early stage'; hint='Start with scope, ROPA and DPIA flow.';}
      else if(score<70){label='In progress'; hint='Tighten third-party clauses & rights handling.';}
      else if(score<90){label='Nearly ready'; hint='Evidence and training cadence next.';}
      else {label='Audit-ready'; hint='You look ready for external review.';}
      scoreLabel.textContent=label; scoreHint.textContent=hint;
    }
    function generatePDF(state){
      const { jsPDF } = window.jspdf || {}; if(!jsPDF){ alert('PDF library not loaded.'); return; }
      const doc=new jsPDF(); let y=20;
      doc.setFillColor(79,70,229); doc.rect(0,0,210,20,'F'); doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(14); doc.text("Compliance365 Readiness Checklist",14,14);
      doc.setTextColor(0,0,0); doc.setFont('helvetica','bold'); doc.setFontSize(16); y+=20;
      doc.text(`${STANDARD} — Readiness Summary`,14,y); y+=10;
      const {score,answered}=compute(); doc.setFont('helvetica','normal'); doc.setFontSize(12);
      doc.text(`Score: ${score}% • Answered ${answered}/${QUESTIONS.length}`,14,y); y+=10;
      doc.setDrawColor(200,200,200); doc.line(14,y,196,y); y+=10;
      QUESTIONS.forEach((q,i)=>{ const v=state[q.id]; const label=v===2?'Yes':v===1?'Partial':v===0?'No':'—';
        if(y>270){ doc.addPage(); y=20; } doc.setFontSize(11); doc.text(`${i+1}. ${q.label}`,14,y);
        doc.setFont('helvetica','bold'); doc.text(label,180,y,{align:'right'}); doc.setFont('helvetica','normal'); y+=8; });
      doc.setFontSize(10); doc.setTextColor(100); y=285; doc.text("Generated with Compliance365 — www.compliance365.com.au",14,y);
      doc.save('iso27701_readiness.pdf');
    }
    const s=document.createElement('style'); s.textContent=`button.opt{cursor:pointer}button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
    document.head.appendChild(s); update();
  }
  </script>
</Base>
