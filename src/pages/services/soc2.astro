---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import ScopingWidget from '../../components/ScopingWidget.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SOC 2 Type I & Type II Readiness',
  serviceType: 'SOC 2 Readiness',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: [
    { '@type': 'Country', name: 'Australia' },
    { '@type': 'City', name: 'Brisbane' },
    { '@type': 'City', name: 'Melbourne' },
    { '@type': 'City', name: 'Sydney' },
    { '@type': 'City', name: 'Canberra' },
    { '@type': 'City', name: 'Perth' },
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'United Kingdom' },
  ],
  url: 'https://www.compliance365.com.au/services/soc2',
  description:
    'SOC 2 Type I and Type II readiness for SaaS and technology companies, delivered remotely inside Microsoft 365 and AWS or Azure environments. Fixed-price, audit-ready in 8–12 weeks. Honest about Type II observation timelines.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does SOC 2 actually take, end to end?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Honest answer: Type I readiness takes 8–12 weeks and you receive a report shortly after. Type II requires a continuous observation period (typically 3–6 months minimum) where evidence is captured before the auditor begins. So "Type II in 12 weeks" gets you to the start of observation — the actual report comes 3–6 months later, plus 4–6 weeks for the audit itself. Most consultants gloss over this. We don\'t.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does SOC 2 readiness cost in Australia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Our fixed-price SOC 2 readiness engagements range from $22k for under-50-staff scope to $115k for 500+ staff enterprise scope. This includes readiness, Type I report support, and the evidence capture infrastructure needed for Type II observation. The CPA audit firm fees are separate (typically $20k–$60k for Type II depending on scope) and paid directly to your auditor.'
      }
    },
    {
      '@type': 'Question',
      name: 'Should we start with Type I or go straight to Type II?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It depends on what your enterprise prospect actually wants. If procurement says "SOC 2 report" without specifying, they almost always mean Type II — Type I is rarely sufficient for enterprise procurement. But Type I gets you something to show in 8–12 weeks while Type II evidence accumulates. The common pattern is: Type I in week 12, then a 6-month observation, then Type II report in month 8. We help you decide based on your specific deal pipeline.'
      }
    },
    {
      '@type': 'Question',
      name: 'Which Trust Services Criteria do we need?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Security is mandatory for every SOC 2 report. The other four (Availability, Confidentiality, Processing Integrity, Privacy) are added based on what your customers actually require. Most B2B SaaS clients start with Security + Confidentiality. Healthcare or fintech clients often add Availability. Privacy is added when EU customers or HIPAA-adjacent processing is in scope. We scope this with you based on the deals you\'re trying to win — over-scoping just adds cost.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can SOC 2 share infrastructure with ISO 27001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — and this is one of the most efficient engagement shapes. SOC 2 Security TSC and ISO 27001 share roughly 75% of underlying controls. Organisations targeting both can deliver them together for 30–40% less than running sequential programmes. The output is a single set of controls and evidence with two reports: a SOC 2 Type II for US-facing enterprise sales and an ISO 27001 certificate for European and Australian government procurement.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need Vanta or Drata for SOC 2?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We deliver SOC 2 readiness entirely inside your existing Microsoft 365 and cloud (AWS or Azure) environments, on Checkpoint — our own console, included in the engagement. Evidence lives in SharePoint with retention workflows. Controls are enforced via Conditional Access, Intune, Defender, and your cloud provider\'s native security tools. Over a typical 3-year cycle (Type I + two Type II reports) this saves $45k–$180k in avoided platform licence costs versus a third-party GRC platform approach.'
      }
    }
    ,
    {
      '@type': 'Question',
      name: 'What is a PBC list in a SOC 2 audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'PBC stands for Provided by Client — the list of documents, screenshots, exports, and records your auditor requests as evidence. For SOC 2 Type II this typically runs 40–120 items. Because evidence is built and indexed before the audit begins, most PBC items are retrievable in minutes. We prepare your team for exactly what the auditor will ask before they ask it.'
      }
    },
    {
      '@type': 'Question',
      name: 'What happens with SOC 2 in year 2 and beyond?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SOC 2 Type II reports are typically renewed annually. Year 2 continues the observation period with the same controls and evidence cadence over a new 12-month window. Because evidence collection is automated and continuous, year 2 audit prep is materially less effort than year 1. Existing clients receive preferential rates on ongoing evidence maintenance and audit support.'
      }
    }
  ]
};
---

<Base
  title="SOC 2 Type I & II Readiness | Compliance365"
  description="SOC 2 Type I and Type II readiness for SaaS companies, delivered remotely inside Microsoft 365. Fixed-price, audit-ready in 8–12 weeks. Australia, US and UK."
  ogImage="https://www.compliance365.com.au/og/og-soc2.png"
  schema={[serviceLd, faqLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Services', url: 'https://www.compliance365.com.au/services/' },
    { name: 'SOC 2', url: 'https://www.compliance365.com.au/services/soc2/' }
  ]}
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">SOC 2 · Delivered Remotely · Australia · US · UK</p>
        <h1>SOC 2 readiness — honest about timelines, ruthless about evidence.</h1>
        <p class="section-lead">
          If your enterprise deals are stuck behind "we need SOC 2 first," we deliver readiness in 8–12 weeks — inside your existing Microsoft 365 and cloud environment, on Checkpoint, our own console included in the engagement. No Vanta, no Drata, no annual third-party platform licence. And no pretending Type II takes 12 weeks when it doesn't.
        </p>

        <ul class="trust-signals">
          <li>8–12 weeks to readiness</li>
          <li>Type I &amp; Type II</li>
          <li>M365 + cloud native</li>
          <li>$0 third-party platform fees</li>
        </ul>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
          <a href={`${base}checklist/soc2/`} class="btn-hdk-ghost">Free readiness assessment</a>
        </div>
      </div>

      <div class="svc-hero-image">
        <img
          src={`${base}assets/soc2-readiness.svg`}
          alt="Sample SOC 2 Type II readiness plan showing observation window timeline and continuous evidence capture"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- THE TYPE I VS TYPE II HONESTY SECTION -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">The Type II observation period — what most consultants won't tell you.</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto 3rem;">
        SOC 2 has a structural reality that's frequently misrepresented in sales pitches. Understanding it upfront saves you from a confused conversation with procurement six weeks into the engagement.
      </p>

      <div class="grid-2" style="max-width:960px;margin:0 auto;gap:2rem;align-items:stretch;">
        <div class="card spot" style="border:1px solid #DDD8CF;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">SOC 2 Type I</p>
          <h3 style="margin:0 0 1.25rem;">Design assurance</h3>
          <p class="muted small">
            A point-in-time report that says your controls are <em>designed</em> properly. The auditor reviews your control set and confirms it would work if operated.
          </p>
          <ul class="muted small" style="padding-left:1.2rem;line-height:1.9;margin:1rem 0 0;">
            <li>Faster — readiness in 8–12 weeks</li>
            <li>Useful for early enterprise sales conversations</li>
            <li>Rarely sufficient on its own for procurement gates</li>
            <li>Audit fees typically $10k–$30k</li>
          </ul>
          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #DDD8CF;">
            <p style="margin:0;font-size:0.85rem;color:#6B6860;">Report available:</p>
            <p style="margin:0.25rem 0 0;font-size:1.1rem;font-weight:700;color:#0B0B0C;">~Week 14</p>
          </div>
        </div>

        <div class="card spot" style="border:2px solid #A9812E;background:#f0f9ff;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#A9812E;text-transform:uppercase;margin:0 0 0.5rem;">SOC 2 Type II</p>
          <h3 style="margin:0 0 1.25rem;color:#8B6820;">Operating effectiveness</h3>
          <p class="muted small">
            A report that says your controls <em>actually worked</em> across a continuous observation window. This is what enterprise procurement actually wants when they say "SOC 2".
          </p>
          <ul class="muted small" style="padding-left:1.2rem;line-height:1.9;margin:1rem 0 0;">
            <li>Requires 3–12 month observation period after readiness</li>
            <li>Evidence captured continuously during that window</li>
            <li>The standard for enterprise procurement gates</li>
            <li>Audit fees typically $20k–$60k</li>
          </ul>
          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #bae6fd;">
            <p style="margin:0;font-size:0.85rem;color:#A9812E;">Report available:</p>
            <p style="margin:0.25rem 0 0;font-size:1.1rem;font-weight:700;color:#8B6820;">~Month 8</p>
          </div>
        </div>
      </div>

      <p class="muted center" style="margin-top:2.5rem;font-size:0.9rem;max-width:720px;margin-left:auto;margin-right:auto;">
        Most clients pursue both: Type I at week 14 for early sales conversations, then Type II at month 8 once observation completes. We build the readiness infrastructure once — same controls, same evidence pipeline, two reports.
      </p>
    </div>
  </section>

  <!-- TRUST SERVICES CRITERIA -->
  <section class="section">
    <div class="container">
      <h2 class="center">Which Trust Services Criteria do you actually need?</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        SOC 2 has five Trust Services Criteria. Security is mandatory; the other four are added based on what your customers require. Over-scoping is a common and expensive mistake.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot" style="border:2px solid #A9812E;">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#A9812E;text-transform:uppercase;margin:0 0 0.5rem;">Mandatory</p>
          <h3>Security (Common Criteria)</h3>
          <p class="muted small">
            Access controls, change management, vulnerability management, incident response, system monitoring. Every SOC 2 report includes this. About 50 individual control points across nine common criteria areas.
          </p>
        </div>
        <div class="card feature spot">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">Common add</p>
          <h3>Availability</h3>
          <p class="muted small">
            Uptime SLAs, capacity monitoring, disaster recovery, backup testing. Add this if your customers have uptime requirements in their contracts — typical for fintech, healthcare, and infrastructure SaaS.
          </p>
        </div>
        <div class="card feature spot">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">Common add</p>
          <h3>Confidentiality</h3>
          <p class="muted small">
            Information classification, encryption, secure data sharing, retention and disposal. Add this if you handle commercially sensitive data — most B2B SaaS does. Often paired with Security as the default starting scope.
          </p>
        </div>
        <div class="card feature spot">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">Conditional</p>
          <h3>Processing Integrity</h3>
          <p class="muted small">
            Input validation, processing accuracy, completeness, error handling. Add this if your service performs financial calculations, transaction processing, or any computation where accuracy is the product itself.
          </p>
        </div>
        <div class="card feature spot">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">Conditional</p>
          <h3>Privacy</h3>
          <p class="muted small">
            Personal information notice, consent, retention, data subject rights. Add this if you process significant personal data — but consider ISO 27701 alongside, which is often a better framework for the privacy-specific work.
          </p>
        </div>
        <div class="card feature spot" style="background:#FAF7F1;border:1px dashed #C8C3B8;">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#6B6860;text-transform:uppercase;margin:0 0 0.5rem;">Most common scope</p>
          <h3>Security + Confidentiality</h3>
          <p class="muted small">
            About 70% of our SOC 2 clients start with this combination. Sufficient for most enterprise procurement gates without over-scoping. Easy to add additional TSCs in subsequent annual audits if customer needs evolve.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">What's included in the engagement</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Every SOC 2 readiness engagement covers these six areas. We build the infrastructure once — it serves both Type I and Type II without duplication.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3>Scoping &amp; system description</h3>
          <p class="muted small">
            We define the system boundary, identify Trust Services Criteria in scope, and draft the system description the auditor will review. Getting this right upfront saves expensive scope discussions during the audit itself.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Control framework &amp; mapping</h3>
          <p class="muted small">
            Every applicable common criteria and TSC point mapped to a specific control in your environment. Where controls don't exist yet, we design them. Where they exist informally, we formalise and document them.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Policy suite</h3>
          <p class="muted small">
            Information security, access control, change management, incident response, vendor management, business continuity. Written specifically for your environment, approved through your governance, mapped to the controls they support.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Evidence capture pipeline</h3>
          <p class="muted small">
            The crucial Type II infrastructure. Automated evidence flowing from M365 audit logs, your cloud provider's logs, your CI/CD pipeline, your ticketing system — into a SharePoint evidence library mapped control-by-control. Built once, runs continuously.
          </p>
        </div>
        <div class="card feature spot">
          <h3>PBC (Provided by Client) preparation</h3>
          <p class="muted small">
            Your auditor will send a list of evidence requests — the PBC list. We pre-populate it, structure responses, and coach your team for walkthroughs. Auditors notice when a client is prepared, and it shortens the audit timeline materially.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Auditor support throughout</h3>
          <p class="muted small">
            We work with your chosen CPA firm — coordinating timing, responding to sample requests, addressing observations as they arise, drafting management responses to any findings. You're not navigating the auditor relationship alone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- EVIDENCE PIPELINE MOCKUP -->
  <section class="section">
    <div class="container">
      <h2 class="center">What the evidence pipeline looks like</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        The Type II observation period requires continuous, automated evidence capture. Here's what that looks like inside your Microsoft 365 and cloud environment — every control mapped, every piece of evidence timestamped and indexed.
      </p>
      <div style="margin-top:2rem;">
        <p style="font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:#A9812E;margin:0 0 .75rem;">SOC 2 Evidence Library — Live Collection</p>
        <img
          src={`${base}assets/mockup-evidence-pipeline.svg`}
          alt="SOC 2 evidence library in SharePoint showing automated evidence collection from Microsoft Entra, Intune, Defender and Azure DevOps mapped to Trust Services Criteria"
          style="width:100%;border-radius:10px;border:1px solid #DDD8CF;box-shadow:0 4px 16px rgba(0,0,0,0.06);"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- AUDITOR SELECTION -->
  <section class="section">
    <div class="container">
      <h2 class="center">Choosing your auditor</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto 3rem;">
        SOC 2 reports are issued by AICPA-licensed CPA firms, not certification bodies. This is different from ISO certifications and often confuses Australian SaaS companies. Three things to know.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3>You choose the auditor, not us</h3>
          <p class="muted small">
            We don't take referral fees and we don't have a preferred auditor relationship that compromises our independence. We help you evaluate options (Australian firms with US audit licences, US firms with Australian presence, smaller specialised SOC 2 auditors) based on your situation and budget.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Audit fees vary 3–4x</h3>
          <p class="muted small">
            Big 4 firms charge premium rates ($60k–$200k for Type II). Mid-tier firms often charge $40k–$80k. Specialised SOC 2-focused firms can be $20k–$50k for Type II. All produce the same report. The right choice depends on which name your enterprise customer wants to see on the report.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Audit timing affects observation window</h3>
          <p class="muted small">
            Auditors book 3–6 months in advance. Booking the auditor *before* completing readiness is a common rookie mistake — it forces you to be ready by their date rather than yours. We coordinate timing so your readiness completes before observation starts, and observation completes before audit fieldwork.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- UNITED STATES CONTEXT -->
  <section class="section">
    <div class="container">
      <h2 class="center">SOC 2 for US-facing companies — what's different</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        SOC 2 is a US-origin standard, so a US buyer's expectations shape more of the engagement than the standard itself does. A few things that specifically matter if your customers or investors are American.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3>US state privacy law alignment</h3>
          <p class="muted small">
            The Privacy Trust Services Criterion maps directly to CCPA/CPRA and the growing patchwork of US state privacy laws. Companies handling data from California, Colorado, Virginia or other regulated states add Privacy to their SOC 2 scope to get one evidence set covering both, instead of a separate privacy programme.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Type II is the real gatekeeper</h3>
          <p class="muted small">
            US mid-market and enterprise procurement teams increasingly ask for SOC 2 Type II specifically, not Type I — a security questionnaire that used to take a few weeks to clear now often stalls entirely without it. We scope the observation window around your actual sales pipeline, not a generic template.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Delivered remotely, no US office required</h3>
          <p class="muted small">
            SOC 2 evidence lives in your Microsoft 365 tenant and cloud environment, not in a physical office — remote delivery works the same for a San Francisco SaaS company as it does locally. Fixed price, coordinated across time zones for calls and evidence reviews.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Healthcare &amp; fintech overlap</h3>
          <p class="muted small">
            For healthcare SaaS handling PHI or fintech companies under state financial regulations, SOC 2's Confidentiality and Availability criteria provide the evidence structure regulators and enterprise customers expect alongside HIPAA safeguards — one evidence set, not two parallel programmes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">Who this is for</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        SOC 2 is the right framework for Australian organisations in one of these situations. We're based in Brisbane and work with SaaS and technology companies across Queensland, New South Wales, Victoria, and nationally.
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card spot">
          <h3>Enterprise deals stuck behind procurement</h3>
          <p class="muted small">
            You have one or more enterprise prospects who've explicitly asked for SOC 2 in tenders, security questionnaires, or contract clauses. The deal is otherwise ready to close. This is the most common SOC 2 trigger we see.
          </p>
        </div>
        <div class="card spot">
          <h3>You sell SaaS into the US market</h3>
          <p class="muted small">
            SOC 2 is the dominant security framework for US enterprise procurement. Even Australian SaaS companies selling into the US face SOC 2 questionnaires before ISO 27001 ones. If US revenue is a significant slice of your pipeline, SOC 2 is non-negotiable.
          </p>
        </div>
        <div class="card spot">
          <h3>You're a series B+ SaaS company</h3>
          <p class="muted small">
            VC-backed SaaS companies typically hit SOC 2 readiness pressure around series B. Customers get larger, deal sizes grow, procurement gates tighten. Implementing SOC 2 here is cheaper than waiting until series C when you're answering 50 customer security questionnaires a year.
          </p>
        </div>
        <div class="card spot">
          <h3>You already have ISO 27001</h3>
          <p class="muted small">
            About 75% of SOC 2 controls overlap with ISO 27001. If you're already certified, adding SOC 2 is significantly cheaper than starting from scratch. Most engagements deliver SOC 2 in 6–8 weeks for ISO 27001-certified clients.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">Common questions</h2>
      <p class="muted center" style="max-width:680px;margin:1.5rem auto;">
        Answered plainly. If you have a question not covered here, the fastest way to get a real answer is a 30-min call.
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card spot">
          <h3>How long does it actually take?</h3>
          <p class="muted small">
            Type I: 8–12 weeks to readiness, ~2 weeks of audit, report at week 14. Type II: 8–12 weeks to readiness, then 3–6 months observation, then 4–6 weeks audit, report around month 8. We're upfront about this because most consultants aren't.
          </p>
        </div>
        <div class="card spot">
          <h3>What does readiness cost?</h3>
          <p class="muted small">
            Fixed-price, $22k–$115k depending on company size. Includes Type I support and the evidence infrastructure for Type II. Audit firm fees ($10k–$30k for Type I, $20k–$60k for Type II) are separate and paid directly to your auditor.
          </p>
        </div>
        <div class="card spot">
          <h3>Type I or Type II first?</h3>
          <p class="muted small">
            Type I gets you something to show in ~14 weeks but rarely satisfies procurement on its own. Type II is what enterprise customers actually want. Most clients do both: Type I early for sales conversations, Type II at month 8 for the real deal.
          </p>
        </div>
        <div class="card spot">
          <h3>Which TSCs do we need?</h3>
          <p class="muted small">
            Security is mandatory. Confidentiality is added by ~70% of clients. Availability, Processing Integrity, and Privacy are added based on customer-specific requirements. Over-scoping is the most common expensive mistake — we scope to what your deals actually need.
          </p>
        </div>
        <div class="card spot">
          <h3>Do we need Vanta or Drata?</h3>
          <p class="muted small">
            No. We build entirely inside your existing M365 and cloud environments, on Checkpoint — included in the engagement. Over a 3-year cycle this saves $45k–$180k in avoided platform licence costs versus the third-party GRC platform approach.
          </p>
        </div>
        <div class="card spot">
          <h3>Can we combine SOC 2 with ISO 27001?</h3>
          <p class="muted small">
            Yes — about 75% of controls overlap. Combined engagements typically deliver both for 30–40% less than sequential programmes. The output is a single control set with two reports: SOC 2 Type II for US-facing sales, ISO 27001 for AU/EU government and enterprise.
          </p>
        </div>
        <div class="card spot">
          <h3>What is a PBC list?</h3>
          <p class="muted small">
            PBC stands for "Provided by Client" — it's the list of documents, screenshots, exports, and records your auditor requests as evidence during the audit. For a typical SOC 2 Type II audit, this runs to 40–120 items. Because we build your evidence infrastructure before the audit begins, most PBC items are already indexed and retrievable in minutes rather than days. We prepare your team for exactly what the auditor will ask for before they ask.
          </p>
        </div>
        <div class="card spot">
          <h3>What happens in year 2 and beyond?</h3>
          <p class="muted small">
            SOC 2 Type II reports are typically renewed annually. Year 2 is a continuation of the observation period — the same controls, the same evidence cadence, a new 12-month window. Because evidence collection is automated and continuous, the year 2 audit is materially less effort than year 1. Existing clients get preferential rates on ongoing evidence maintenance and audit support — we'd rather earn the next three years than bill you for a fresh programme every cycle.
          </p>
        </div>
      </div>
    </div>
