---
// /cost-estimator/ — the per-framework cost estimators in one place, so
// the estimator can be found from the menu and the pricing page and not
// only near the top of each service page. Figures: src/data/cost-estimator.js.
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import CostEstimator from '../components/CostEstimator.astro';
import { FRAMEWORKS } from '../data/cost-estimator.js';
import { CONSULTING_DAY_RATE, fmtAud } from '../data/pricing.js';
import DigestSignup from '../components/DigestSignup.astro';

const base = import.meta.env.BASE_URL || '/';
const ids = Object.keys(FRAMEWORKS);
const title = 'Compliance Cost Estimator: ISO 27001, SOC 2, Essential Eight | Compliance365';
const description = `Estimate year-one and three-year cost for ISO 27001, SOC 2, Essential Eight, ISO 42001, ISO 27701 or NIST CSF: fixed-price consulting, Checkpoint plus consulting days at ${fmtAud(CONSULTING_DAY_RATE)} a day, or Checkpoint on its own. AUD.`;
const app = {
  '@type': 'WebApplication',
  name: 'Compliance cost estimator',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  description,
  url: 'https://www.compliance365.com.au/cost-estimator/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
};
---
<Base
  title={title}
  description={description}
  schema={[app]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Cost estimator', url: 'https://www.compliance365.com.au/cost-estimator/' },
  ]}
>
  <Header />
  <main id="main-content" tabindex="-1">
    <section class="svc-hero">
      <CinematicBackground static />
      <div class="svc-hero-inner" style="grid-template-columns:1fr;max-width:820px;">
        <div class="svc-hero-copy">
          <p class="eyebrow">Free tool · no sign-up</p>
          <h1>What will your certification cost?</h1>
          <p class="section-lead">
            Pick a framework, your size and how you want to do it: a fixed-price engagement with us, Checkpoint plus consulting days at {fmtAud(CONSULTING_DAY_RATE)} a day, or Checkpoint on its own. You get year one and three years, audit fees included.
          </p>
        </div>
      </div>
    </section>

    <section class="section cep-pick" aria-label="Framework">
      <div class="container" style="max-width:900px;">
        <p class="cep-h">Framework</p>
        <div class="cep-tabs">
          {ids.map((id, i) => (
            <a class="cep-tab" href={`#ce-${id}`} data-ce-tab={id} aria-current={i === 0 ? 'true' : undefined}>{FRAMEWORKS[id].name}</a>
          ))}
        </div>
      </div>
    </section>

    {ids.map((id) => (
      <div class="cep-panel" data-ce-panel={id}>
        <CostEstimator fw={id} heading={`What ${FRAMEWORKS[id].name} will cost you`} />
        <p class="cep-more container"><a href={base + FRAMEWORKS[id].page}>{FRAMEWORKS[id].name} consulting: what is included</a> · <a href={base + 'pricing/'}>Checkpoint pricing</a></p>
      </div>
    ))}
    <section class="container" style="padding-bottom:0;">
      <DigestSignup source="cost-estimator" />
    </section>
  </main>
  <Footer />
</Base>

<script>
  /* One framework at a time. Without JavaScript every estimator shows,
     one after another, and the tabs are plain links to each. */
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-ce-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-ce-panel]')];
  const show = (id: string) => {
    if (!panels.some((p) => p.dataset.cePanel === id)) id = panels[0].dataset.cePanel!;
    panels.forEach((p) => { p.hidden = p.dataset.cePanel !== id; });
    tabs.forEach((t) => { if (t.dataset.ceTab === id) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current'); });
  };
  tabs.forEach((t) => t.addEventListener('click', (e) => {
    e.preventDefault();
    show(t.dataset.ceTab!);
    history.replaceState(null, '', t.getAttribute('href'));
  }));
  show(location.hash.replace('#ce-', ''));
</script>

<style>
  .cep-pick { padding: 2rem 0 0; background: #FAF7F1; }
  .cep-h { font-weight: 700; font-size: .9rem; margin: 0 0 .5rem; }
  .cep-tabs { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cep-tab { padding: .55rem 1rem; border-radius: 999px; border: 1px solid #DDD8CF; background: #fff; color: #1C1A17; text-decoration: none; font-weight: 600; font-size: .92rem; }
  .cep-tab[aria-current='true'] { border-color: #BE4A1E; box-shadow: inset 0 0 0 1px #BE4A1E; color: #A63A12; }
  .cep-tab:focus-visible { outline: 3px solid #BE4A1E; outline-offset: 2px; }
  .cep-panel :global(.ce) { border-top: 0; }
  .cep-more { max-width: 900px; font-size: .9rem; padding: 1rem 22px 3rem; margin: 0 auto; }
  .cep-more a { color: #A63A12; font-weight: 600; }
</style>
