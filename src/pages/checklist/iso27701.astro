---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27701 (Privacy)';

const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–100','100–500','500–1,000','Over 1,000'] },
  { id: 'env-licensing',label: 'Microsoft licensing tier',             type: 'select', required: false, options: ['Microsoft 365 E5','Microsoft 365 E3','Microsoft 365 Business Premium','Microsoft 365 Business Standard','No Microsoft 365','Not sure'] },
  { id: 'trigger',      label: 'What is prompting you to look at ISO 27701 now?', type: 'select', required: true, options: ['Enterprise customer requiring certification','Government tender or procurement gate','Privacy Act compliance requirement','Investor or board requirement','Recent privacy incident or near-miss','Internal initiative — no external pressure yet','Other / multiple drivers'] },
  { id: 'timeline',     label: 'When do you need to be audit-ready?', type: 'select', required: false, options: ['Within 3 months','3–6 months','6–12 months','12+ months','No fixed deadline'] },
];

const QUESTIONS = [
  { id:'pims-scope',  group:'gov',  label:'PIMS scope is defined — covering systems, products, regions and teams that handle personal information, with clear in/out boundaries', hint:'A clear scope statement is the first thing an auditor checks. Vague or missing scope is the most common Stage 1 finding.', examples:['A short scope statement listing systems, products, regions and teams handling personal data','A clear list of in-scope tools (e.g. CRM, support platform) and out-of-scope items (e.g. retired systems)','Identification of key PII types such as customer, employee or patient data'] },
  { id:'roles-dpo',   group:'gov',  label:'Privacy ownership is assigned — a named privacy lead or DPO with documented responsibilities, escalation paths and decision authority', hint:'Auditors want evidence that privacy is owned at a named level — not just delegated generically to IT or legal.', examples:['A named privacy owner or lead with documented responsibilities','Clear escalation paths for incidents, complaints and high-risk decisions','Defined approval roles for privacy assessments and responses'] },
  { id:'policies',    group:'gov',  label:'Privacy policies and procedures are current, approved, communicated and actively followed — not just published and forgotten', hint:'Policies must be version-controlled, dated and demonstrably acknowledged. A policy no one follows is a finding.', examples:['A current privacy notice published on your website or portal','Internal procedures for handling privacy requests and incidents','Documented retention, deletion and acceptable use rules'] },
  { id:'objectives',  group:'gov',  label:'Privacy objectives and KPIs are defined, tracked and reviewed by leadership — such as SRR response times and training completion rates', hint:'Leadership can see whether privacy is improving or declining — not just whether incidents happened.', examples:['Targets for responding to privacy requests within a set timeframe','Regular reporting on incidents, complaints or near-misses','Tracking privacy training completion rates across the organisation'] },

  { id:'ropa',        group:'map',  label:'A Record of Processing Activities (ROPA) is maintained — covering purpose, data types, systems, vendors, lawful basis and retention for each processing activity', hint:'The ROPA is your single source of truth for data processing. Auditors will sample it against your actual systems.', examples:['A register covering support, billing, marketing, product usage and HR processing','Each entry lists purpose, data types, systems, vendors and retention period','The register is reviewed when new systems or vendors are introduced'] },
  { id:'pii-flows',   group:'map',  label:'Personal data flows are mapped — you can explain where PII is collected, stored, shared and with whom, including overseas transfers', hint:'You need to understand how data moves across systems and vendors before you can control it.', examples:['A simple diagram showing data flow from collection to storage to deletion','A list of third parties receiving personal data and their locations','Identification of offshore hosting, access or transfers'] },
  { id:'dpias',       group:'map',  label:'A DPIA (privacy risk assessment) methodology is defined and applied before high-impact changes, new processing or vendor onboarding', hint:'DPIAs for high-risk processing are mandatory under ISO 27701. Not running them is a common major nonconformity.', examples:['Privacy assessments completed for new features, products or data uses','Reviews conducted when onboarding new vendors with access to personal data','Documented risks and agreed mitigations with owner sign-off'] },

  { id:'controls',    group:'ctrl', label:'Privacy-by-design controls are implemented — data minimisation, defined retention periods, role-based access and automated deletion', hint:'Controls must actually be configured in your systems, not just stated in policy. Auditors will sample system configuration.', examples:['Defined retention periods for customer and employee data, enforced in systems','Role-based access restricting sensitive information to authorised staff only','Automated deletion or anonymisation when data is no longer needed'] },
  { id:'consent',     group:'ctrl', label:'Where consent is required, it is captured, auditable and can be shown when it was given, changed or withdrawn', hint:'Consent decisions must be traceable and defensible — a checkbox with no timestamp is not sufficient.', examples:['Records showing when and how consent was captured (with timestamp and mechanism)','Preference management or opt-out capability connected to your systems','Audit logs of consent changes visible to the privacy team'] },
  { id:'rights',      group:'ctrl', label:'Individual rights requests (access, erasure, correction, portability) are handled through a defined workflow within a committed timeframe', hint:'SRR handling is one of the most sampled controls in a PIMS audit. You need a ticket trail and response records.', examples:['A workflow or ticket system for privacy requests with SLA tracking','Identity verification steps before releasing or deleting personal data','Closed records showing responses were sent on time with evidence'] },
  { id:'training',    group:'ctrl', label:'Privacy training is role-based, assigned to all relevant staff and completion is tracked with records available for audit', hint:'Training awareness is mandatory evidence. Auditors will ask to see completion reports and curriculum scope.', examples:['Mandatory privacy training for all new starters within the first 30 days','Additional or tailored training for high-risk roles (e.g. support, sales, data teams)','Completion reports reviewed by management at least annually'] },

  { id:'processors',  group:'tp',   label:'Third-party processors are assessed before onboarding, contracts include privacy obligations (DPAs), and ongoing reviews are documented', hint:'Supply chain privacy risk is heavily scrutinised. A vendor with access to PII and no DPA is a significant finding.', examples:['Vendor risk assessments completed before onboarding any processor with PII access','Privacy clauses and DPAs included in all relevant supplier contracts','Annual review of critical processors including SOC reports, certificates or questionnaires'] },
  { id:'xfer',        group:'tp',   label:'Cross-border data transfers are identified, assessed for risk, documented, and safeguards (SCCs, TIAs) are in place where required', hint:'Offshore access or hosting without transfer assessment is a common audit gap — especially for cloud-hosted platforms.', examples:['Identification of all systems with offshore access or hosting (including SaaS vendors)','Documented assessment of overseas transfer risks and applicable safeguards','Controls and contractual clauses in place to monitor and manage transfers'] },

  { id:'evidence',    group:'ev',   label:'Privacy evidence is centralised, version-controlled and retrieval-ready — auditors should never need to chase documents', hint:'Evidence is the PIMS backbone. Centralised, structured evidence reduces audit stress significantly.', examples:['Central storage of policies, registers and assessments with version history enabled','Clear ownership for maintaining each document type','Retention policies applied to privacy evidence in M365 or equivalent'] },
  { id:'metrics',     group:'ev',   label:'Privacy metrics are reported to leadership on a regular cadence — request volumes, incidents, training rates and trend analysis', hint:'Metrics support informed decision-making and demonstrate active governance. Auditors will ask to see reporting history.', examples:['Regular reporting on SRR volumes, incidents, DPIAs completed and complaints received','Trend analysis identifying recurring issues or problem areas','Metrics reviewed and actioned by leadership at least quarterly'] },
  { id:'iaudit',      group:'ev',   label:'Internal privacy audits are performed against a plan — covering PIMS controls — with findings tracked to verified closure', hint:'Internal audit is mandatory under ISO 27701. Findings must be owned, dated and verified closed.', examples:['Annual internal audit plan covering ISO 27701 controls and a rotating sample of processing activities','Audit reports with findings, root cause, corrective actions, owners and due dates','Evidence that corrective actions are verified closed — not just marked done'] },
  { id:'mgmt-review', group:'ev',   label:'Management reviews are held at planned intervals — covering PIMS performance, risks, incidents, KPIs and improvement decisions', hint:'Management review minutes are mandatory evidence and one of the first documents auditors request.', examples:['Management review agenda and minutes covering all required ISO 27701 inputs','Recorded decisions on resourcing, policy changes, risk acceptance and improvement priorities','Action register with owners, due dates and closure tracking'] },
];

const GROUPS = [
  { key:'gov',  title:'Leadership & Governance',        blurb:'Scope, ownership, policies and measurable targets.', icon:'people' },
  { key:'map',  title:'Data Mapping & Risk Assessment', blurb:'Your ROPA, data flows, and DPIA methodology.', icon:'map' },
  { key:'ctrl', title:'Everyday Privacy Controls',      blurb:'Minimisation, retention, consent, SRRs and training.', icon:'lock' },
  { key:'tp',   title:'Vendors & Overseas Data',        blurb:'Processor due diligence, DPAs and transfer safeguards.', icon:'globe' },
  { key:'ev',   title:'Evidence & Monitoring',          blurb:'Evidence management, metrics, internal audit and review.', icon:'chart' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="ISO 27701 Checklist — Free Privacy Readiness Assessment (2026) | Compliance365"
  description="Free ISO 27701 checklist for Australian organisations. Score your Privacy Information Management System across governance, data mapping, controls and audit — download a prioritised PDF roadmap."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'ISO 27701 Readiness', url: 'https://www.compliance365.com.au/checklist/iso27701/' }
  ]}
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Free Readiness Assessment</p>
      <h1>ISO 27701 Privacy Readiness Checklist</h1>
      <p class="section-lead" style="max-width:760px;">
        Score your Privacy Information Management System (PIMS) against ISO 27701 in 15 minutes. Tell us about your environment, answer 17 focused questions, and download a PDF roadmap with your top privacy gaps and recommended next steps.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#A9812E;color:white;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill" data-stage="2" style="flex:1;min-width:140px;background:#DDD8CF;color:#6B6860;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill" data-stage="3" style="flex:1;min-width:140px;background:#DDD8CF;color:#6B6860;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#FAF7F1;padding:2rem 0;border-top:1px solid #DDD8CF;border-bottom:1px solid #DDD8CF;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#A9812E;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-clock"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">~15 minutes</strong><p class="muted small" style="margin:2px 0 0;">17 focused questions across 5 PIMS domains, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#16a34a;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-check-seal"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Mapped to ISO 27701:2019</strong><p class="muted small" style="margin:2px 0 0;">Calibrated to the PIMS controls — the same criteria privacy certification auditors sample.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#A9812E;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-note"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top privacy gaps, and a prioritised action plan. Emailed copy + instant download.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container" style="max-width:1140px;">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:#6B6860;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#A9812E;color:white;font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">DISP / ISM / IRAP</a>
      </div>
    </div>
  </div>

  <!-- MAIN -->
  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- ----- STAGE 1: Environment ----- -->
      <div id="stage-1" class="stage">
        <div class="card spot" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0B0B0C;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>

          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>

          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #DDD8CF;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 2: Questions ----- -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;" id="stage-2-grid">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #DDD8CF;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #DDD8CF;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="width:1.75rem;height:1.75rem;display:inline-flex;align-items:center;justify-content:center;color:#A9812E;flex-shrink:0;"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><use href={`#ic-${grp.icon}`}/></svg></span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0B0B0C;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:#A9812E;">0/{grpQs.length}</div>
                    </div>
                  </div>

                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #F5F0E8;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:rgba(169,129,46,0.06);color:#A9812E;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0B0B0C;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:#A9812E;font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:#A9812E;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card spot" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #F5F0E8;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:#A9812E;line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#6B6860;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:#374151;font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#C8C3B8;"> - </span>
                    </div>
                    <div style="background:#F5F0E8;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#C8C3B8;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #F5F0E8;">
                <div style="font-size:0.75rem;color:#6B6860;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#F5F0E8;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#A9812E;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:#A9812E;border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 3: Confirmation ----- -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card spot" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://calendly.com/matt-nicholas-compliance365/30min" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = "ISO 27701 (Privacy)";
      const API_URL  = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

      const GROUPS = [
        { key:'gov',  title:'Leadership & Governance' },
        { key:'map',  title:'Data Mapping & Risk Assessment' },
        { key:'ctrl', title:'Everyday Privacy Controls' },
        { key:'tp',   title:'Vendors & Overseas Data' },
        { key:'ev',   title:'Evidence & Monitoring' },
      ];

      const QUESTIONS = [
        { id:'pims-scope',  group:'gov',  label:'PIMS scope defined — systems, products, regions, teams and in/out boundaries' },
        { id:'roles-dpo',   group:'gov',  label:'Privacy ownership assigned — named lead or DPO with documented responsibilities' },
        { id:'policies',    group:'gov',  label:'Privacy policies and procedures current, approved, communicated and followed' },
        { id:'objectives',  group:'gov',  label:'Privacy objectives and KPIs defined, tracked and reviewed by leadership' },
        { id:'ropa',        group:'map',  label:'ROPA maintained — purpose, data types, systems, vendors, lawful basis and retention' },
        { id:'pii-flows',   group:'map',  label:'Personal data flows mapped — collection, storage, sharing and overseas transfers' },
        { id:'dpias',       group:'map',  label:'DPIA methodology defined and applied for high-impact changes and new processing' },
        { id:'controls',    group:'ctrl', label:'Privacy-by-design controls implemented — minimisation, retention, access control, deletion' },
        { id:'consent',     group:'ctrl', label:'Consent captured, auditable and linked to withdrawal/change records' },
        { id:'rights',      group:'ctrl', label:'Individual rights requests handled through a defined workflow within committed timeframes' },
        { id:'training',    group:'ctrl', label:'Role-based privacy training assigned and completion tracked with audit-ready records' },
        { id:'processors',  group:'tp',   label:'Third-party processors assessed, DPAs in place and ongoing reviews documented' },
        { id:'xfer',        group:'tp',   label:'Cross-border transfers identified, assessed for risk and safeguards documented' },
        { id:'evidence',    group:'ev',   label:'Privacy evidence centralised, version-controlled and retrieval-ready' },
        { id:'metrics',     group:'ev',   label:'Privacy metrics reported to leadership on a regular cadence' },
        { id:'iaudit',      group:'ev',   label:'Internal PIMS audits performed with findings tracked to verified closure' },
        { id:'mgmt-review', group:'ev',   label:'Management reviews held covering PIMS performance, risks, incidents and improvements' },
      ];

      const TOTAL_Q = QUESTIONS.length;
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#A9812E' : (s < n ? '#16a34a' : '#DDD8CF');
            p.style.color = (s <= n) ? 'white' : '#6B6860';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('to-stage-2').addEventListener('click', function() {
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','env-licensing','trigger','timeline'];
          var reqIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];
          allIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) env[id] = el.value ? el.value.trim() : '';
          });
          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) {
              valid = false;
              el.style.borderColor = '#dc2626';
              el.style.background  = '#fef2f2';
            } else {
              el.style.borderColor = '#C8C3B8';
              el.style.background  = 'white';
            }
          });
          var errEl = document.getElementById('env-error');
          if (!valid) {
            errEl.style.display = 'block';
            errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white';
              o.style.color = '#0B0B0C';
              o.style.borderColor = '#C8C3B8';
            });
            btn.classList.add('active');
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'white'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'white'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the ISO 27701 privacy readiness checklist. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') {
              window.c365OpenChat(msg);
            }
          });
        });

        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white';
            o.style.color = '#0B0B0C';
            o.style.borderColor = '#C8C3B8';
          });
          update();
        });

        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true;
          btn.textContent = 'Generating...';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
          } catch (err) {
            console.error(err);
            alert('Something went wrong — your PDF should still have downloaded.');
          } finally {
            btn.disabled = false;
            btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => {
          if (state[id] !== null) { answered++; sum += state[id]; }
        });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { key: 'na', label: 'Not started', desc: 'Answer questions to score', color: '#6B6860' };
        if (score >= 86) return { key: 'cr', label: 'Certification-Ready', desc: 'Strong posture — focus on evidence packaging and audit preparation', color: '#16a34a' };
        if (score >= 61) return { key: 'nar', label: 'Nearly Audit-Ready', desc: 'Close minor gaps and tighten evidence packaging', color: '#A9812E' };
        if (score >= 31) return { key: 'pr', label: 'Partially Ready', desc: 'Many core elements in place — focus and prioritisation needed', color: '#d97706' };
        return { key: 'hr', label: 'High Risk', desc: 'Missing foundational privacy controls — structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#C8C3B8';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the ISO 27701 privacy readiness checklist on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('Target timeline: ' + (env['timeline'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Domain scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) {
            var v = state[q.id] === 1 ? 'PARTIAL' : 'NO';
            lines.push('  [' + v + '] ' + q.label);
          });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest privacy gaps, what I should prioritise, and what a realistic path to ISO 27701 certification looks like?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);

        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#F5F0E8';
            el.style.color = a === total ? '#166534' : '#3A3632';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) {
              bar.style.width = '0%'; bar.style.background = '#C8C3B8';
              pctEl.textContent = ' - '; pctEl.style.color = '#C8C3B8';
            } else {
              bar.style.width = pct + '%'; bar.style.background = barColor(pct);
              pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct);
            }
          }
        });

        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone;
        btn.style.cursor = allDone ? 'pointer' : 'not-allowed';
        btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone
          ? 'Click to generate and email your report'
          : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) {
          aiBtn.disabled = !allDone;
          aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed';
          aiBtn.style.opacity = allDone ? '1' : '0.5';
        }
      }

      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const sectionScores = GROUPS.map(g => ({ title: g.title, ...computeSection(g.key) }));
        const lines = [];
        lines.push('=== ISO 27701 READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Microsoft licensing: ${env['env-licensing'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        sectionScores.forEach(s => lines.push(`  ${s.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`));
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          const label = v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED';
          lines.push(`[${label}] ${q.label}`);
        });
        const payload = {
          name: env['contact-name'] || env['org-name'] || 'Anonymous',
          email: env['contact-email'] || 'noreply@compliance365.com.au',
          subject: `ISO 27701 Checklist - ${env['org-name'] || 'Anonymous'} - ${score}%`,
          message: lines.join('\n'),
        };
        try {
          await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.warn('API submission failed:', err);
        }
      }

      function generatePDF() {
        var jsPDFLib = window.jspdf || {};
        var jsPDF = jsPDFLib.jsPDF;
        if (!jsPDF) { alert('PDF library not loaded - please wait a moment and try again.'); return; }

        var doc = new jsPDF('p','mm','a4');
        var W=210, LM=18, RM=16, CW=210-18-16;
        var y=0;

        var PRIMARY=[30,64,175], GREEN=[5,150,105], AMBER=[180,110,0], RED=[200,30,30];
        var WHITE=[255,255,255], LIGHT=[248,250,252], MUTED=[100,116,139], DARK=[17,24,39];

        var comp=compute(), sc=comp.score, ansCount=comp.answered, band=getBand(sc,ansCount);
        var orgName=env['org-name']||'Your Organisation';
        var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
        var scoreCol=sc>=75?GREEN:sc>=50?AMBER:RED;
        var scoreBand=sc>=86?'Certification-Ready':sc>=61?'Nearly Audit-Ready':sc>=31?'Partially Ready':'High Risk';

        // Cover header
        doc.setFillColor(...PRIMARY); doc.rect(0,0,W,42,'F');
        doc.setFillColor(6,182,212); doc.rect(0,40,W,2,'F');

        var logoEl=document.getElementById('pdfLogo');
        doc.setTextColor(...WHITE);
        doc.setFont('helvetica','bold'); doc.setFontSize(18);
        if (logoEl && logoEl.complete && logoEl.naturalWidth > 0) {
          doc.addImage(logoEl,'PNG',LM,8,20,20,undefined,'FAST');
          doc.text('Compliance365', LM+24, 18);
        } else {
          doc.text('Compliance365', LM, 18);
        }
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text('ISO 27701 Privacy Readiness Report', LM+(logoEl&&logoEl.complete?24:0), 26);
        doc.setFontSize(9);
        doc.text(orgName + '  |  ' + today, LM+(logoEl&&logoEl.complete?24:0), 34);

        y=56;
        // Score summary
        doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,28,4,4,'F');
        doc.setFillColor(...scoreCol); doc.roundedRect(LM,y,6,28,2,2,'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(28); doc.setTextColor(...scoreCol);
        doc.text(sc+'%', LM+16, y+18);
        doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text(scoreBand, LM+44, y+12);
        doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(...MUTED);
        doc.text(band.desc, LM+44, y+19, { maxWidth: CW-50 });
        doc.text(ansCount+'/'+TOTAL_Q+' questions answered', LM+44, y+25);
        y+=36;

        // Domain breakdown
        doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text('Domain Breakdown', LM, y); y+=6;

        GROUPS.forEach(function(grp) {
          var s=computeSection(grp.key);
          var p=s.pct===null?0:s.pct;
          var col=p>=75?GREEN:p>=50?AMBER:RED;
          doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,12,2,2,'F');
          doc.setFillColor(...col); doc.roundedRect(LM,y,4,12,1,1,'F');
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...DARK);
          doc.text(grp.title, LM+8, y+7.5);
          var barX=LM+CW-60, barW=50;
          doc.setFillColor(226,232,240); doc.roundedRect(barX,y+4,barW,4,1,1,'F');
          if (p>0) { doc.setFillColor(...col); doc.roundedRect(barX,y+4,barW*(p/100),4,1,1,'F'); }
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...col);
          doc.text(s.pct===null?'-':p+'%', barX+barW+4, y+7.5);
          y+=15;
        });

        y+=4;
        // Top gaps
        var gaps=QUESTIONS.filter(function(q){ return state[q.id]===0||state[q.id]===1; });
        if (gaps.length) {
          doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
          doc.text('Priority Gaps', LM, y); y+=6;
          gaps.forEach(function(q) {
            if (y>270) { doc.addPage(); y=16; }
            var v=state[q.id];
            var col=v===0?RED:AMBER;
            var lbl=v===0?'NO':'PARTIAL';
            doc.setFillColor(...(v===0?[255,225,225]:[255,241,194]));
            doc.roundedRect(LM,y,CW,10,2,2,'F');
            doc.setFillColor(...col); doc.roundedRect(LM,y,3,10,1,1,'F');
            var lines=doc.splitTextToSize(q.label, CW-40);
            doc.setFont('helvetica','normal'); doc.setFontSize(8.5); doc.setTextColor(...DARK);
            doc.text(lines, LM+7, y+6.5);
            doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.setTextColor(...col);
            doc.text(lbl, W-RM-14, y+6.5);
            y+=13;
          });
        }

        // Footer
        doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(...MUTED);
        doc.text('Generated by Compliance365  |  compliance365.com.au  |  ISO 27701 Privacy Readiness Report', LM, 290);

        doc.save('iso27701_readiness_' + (orgName.replace(/[^a-z0-9]/gi,'-')||'report') + '.pdf');
      }
    })();
  </script>
</Base>
