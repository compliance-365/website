---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/case-studies.css';

const base = import.meta.env.BASE_URL || '/';

/**
 * Optional front-matter supported by this page:
 * - logo: "/images/logos/client.png"
 * - hero: { image: "/images/case-studies/hero.jpg", alt: "Network map" }
 * - sector: "Government"
 * - services: ["ISO 27001", "SOC 2"]
 * - tags: ["IS18","Essential Eight"]
 * - metrics: ["<strong>82%</strong> readiness", "Report in 4 weeks"]
 * - testimonial: { quote, name, title, avatar }
 * - seo: { image, keywords }
 * - ctaLabel: "Book a discovery call"
 * - ctaUrl: "/book"  // or full https:// URL
 */
export async function getStaticPaths() {
  const entries = await Astro.glob('../../../content/case-studies/*.md');
  if (!entries.length) return [];
  return entries.map((entry) => {
    const parts = entry.file.split('/');
    const slug  = parts[parts.length - 1].replace(/\.md$/, '');
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const fm        = entry?.frontmatter ?? {};
const title     = fm.title ?? 'Case Study';
const summary   = fm.summary ?? '';
const hero      = fm.hero ?? null;
const logo      = fm.logo ?? null;
const sector    = fm.sector ?? null;
const services  = fm.services ?? [];
const tags      = fm.tags ?? [];
const metrics   = fm.metrics ?? [];
const testimonial = fm.testimonial ?? null;
const seo       = fm.seo ?? {};
const canonical = new URL(Astro.url).toString();

// ✅ Single source of truth for CTA (with fallback to BASE_URL + /book)
const defaultCtaUrl = `${base}book`;
const ctaLabel = fm.ctaLabel ?? 'Book a call';
const ctaUrl   = fm.ctaUrl ?? defaultCtaUrl;

// SEO JSON-LD
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary || (seo?.description ?? ''),
  image: seo?.image
    ? (seo.image.startsWith('http') ? seo.image : new URL(seo.image, Astro.site).toString())
    : undefined,
  author: { '@type': 'Organization', name: 'Compliance365' },
  publisher: { '@type': 'Organization', name: 'Compliance365' },
  datePublished: fm.date || undefined,
  keywords: Array.isArray(seo?.keywords) ? seo.keywords.join(', ') : undefined,
  mainEntityOfPage: canonical
};
---

<Base title={`${title} — Case Study`} description={summary || (seo?.description ?? '')}>
  <Header />

  <section class="cs-wrap">
    <a href="/case-studies" class="back-link">← Back to Case Studies</a>

    <!-- Hero Section -->
    <div class="cs-hero">
      <div class="brand">
        {logo && <img src={logo} alt="Client logo" loading="lazy" />}
        <div>
          <h1>{title}</h1>
          {summary && <p class="lead">{summary}</p>}
        </div>
      </div>

      <!-- Meta info -->
      <div class="cs-meta">
        {sector && <span class="cs-pill">Sector: {sector}</span>}
        {services?.length > 0 && <span class="cs-pill">Services: {services.join(', ')}</span>}
        {tags?.length > 0 && <span class="cs-pill">Tags: {tags.join(', ')}</span>}
      </div>

      <!-- Hero Image -->
      {hero?.image && (
        <div class="cs-hero-img">
          <img
            src={hero.image}
            alt={hero.alt || 'Case study'}
            loading="lazy"
          />
        </div>
      )}

      <!-- KPI Metrics -->
      {metrics?.length > 0 && (
        <div class="cs-metrics">
          {metrics.map((m) => (
            <div class="cs-card">
              <div class="cs-kpi" set:html={m}></div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Case Study Body -->
    <article class="prose">
      {entry ? <entry.Content /> : <p>Coming soon.</p>}
    </article>

    <!-- Optional Testimonial -->
    {testimonial && (
      <div class="cs-quote">
        <p>“{testimonial.quote}”</p>
        <div class="who">
          {testimonial.avatar && <img src={testimonial.avatar} alt="" loading="lazy" />}
          <span>{testimonial.name}{testimonial.title ? ` — ${testimonial.title}` : ''}</span>
        </div>
      </div>
    )}

    <!-- CTA -->
<section class="cs-cta">
  <div>
    <h3 style="margin:0 0 6px">Need a similar outcome?</h3>
    <p style="margin:0;opacity:.85">
      We help government, health, and technology organisations achieve certification faster
      with automated evidence and expert delivery.
    </p>
  </div>
  <a href={ctaUrl} class="btn-primary">{ctaLabel}</a>
</section>
</section>

  <Footer />

  <!-- JSON-LD for SEO -->
  <script type="application/ld+json">{JSON.stringify(ld)}</script>
</Base>
