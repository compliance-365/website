---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

const pageTitle = 'What a Good ROPA Looks Like (and Common Mistakes)';
const pageDesc =
  'A practical guide to building a useful Record of Processing Activities (ROPA): what it is, why it matters, fields that work, common mistakes, and how to keep it current with Microsoft 365.';
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={[
    {
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDesc,
      "datePublished": "2026-05-17",
      "dateModified": "2026-05-20",
      "about": [
        {"@type": "Thing", "name": "ROPA"},
        {"@type": "Thing", "name": "Record of Processing Activities"},
        {"@type": "Thing", "name": "ISO 27701"},
        {"@type": "Thing", "name": "Privacy compliance"}
      ],
      "isPartOf": {"@id": "https://www.compliance365.com.au#website"}
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Resources","item":"https://www.compliance365.com.au/resources"},
        {"@type":"ListItem","position":3,"name":"What a Good ROPA Looks Like","item":"https://www.compliance365.com.au/resources/what-a-good-ropa-looks-like"}
      ]
    }
  ]}
/>
  <Header />

  <!-- HERO -->
  <section class="container section">
    <div class="grid-2" style="align-items:start">
      <div>
        <h1>What a Good ROPA Looks Like</h1>
        <p class="muted" style="max-width:820px">
          A <strong>Record of Processing Activities (ROPA)</strong> should be a <strong>living inventory</strong> of how your
          organisation uses personal data — not a one-off spreadsheet. Done well, it becomes the single source of truth
          for privacy impact, supplier risk and retention decisions, and makes audits far simpler.
        </p>

        <ul class="trust-signals">
          <li>Processing inventory</li>
          <li>Lawful basis & purpose</li>
          <li>Data lifecycle</li>
          <li>DPIA triggers</li>
          <li>Evidence & reviews</li>
        </ul>

        <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href={`${base}book/`}>See our SharePoint ROPA pattern</a>
          <a class="btn btn-ghost" href={`${base}resources/`}>Back to resources</a>
        </div>
      </div>

      <!-- QUICK FACTS -->
      <aside class="card" style="position:sticky;top:84px">
        <h3 style="margin:0 0 6px">ROPA at a glance</h3>
        <ul class="muted small" style="margin:0;padding-left:1.1rem">
          <li><strong>What:</strong> Inventory of who/what/why/how personal data is processed</li>
          <li><strong>Why:</strong> Legal accountability, risk visibility, audit readiness</li>
          <li><strong>Standards:</strong> ISO 27701, GDPR (and good practice under APPs)</li>
          <li><strong>Format:</strong> SharePoint list / table with versioning & owners</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- 1) WHAT IT IS -->
  <section class="container section">
    <h2>What is a ROPA?</h2>
    <p class="muted" style="max-width:880px">
      Your ROPA documents each processing activity: the <strong>purpose</strong>, <strong>lawful basis</strong> (where required),
      <strong>data subjects</strong>, <strong>categories of personal data</strong>, <strong>systems & vendors</strong>,
      <strong>transfers</strong>, <strong>retention</strong> and <strong>security measures</strong>. It underpins privacy decisions,
      enables DPIA triage, and provides auditors with evidence that you know where personal data lives and why.
    </p>

    <div class="grid-3" style="margin-top:14px">
      <div class="card feature center">
        <h3>Single source of truth</h3>
        <p class="muted small">Connects departments, systems and vendors into one view of processing.</p>
      </div>
      <div class="card feature center">
        <h3>Drives risk decisions</h3>
        <p class="muted small">Flags high-risk processing for DPIAs and stronger controls.</p>
      </div>
      <div class="card feature center">
        <h3>Speeds audits</h3>
        <p class="muted small">Provides clear evidence paths and owners for each entry.</p>
      </div>
    </div>
  </section>

  <!-- 2) WHY IT MATTERS -->
  <section class="container section">
    <h2>Why a good ROPA matters</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>Business accountability</h3>
        <p class="muted small">Demonstrates control of personal data flows for customers, partners and regulators.</p>
      </div>
      <div class="card">
        <h3>Operational clarity</h3>
        <p class="muted small">Helps teams understand purpose, retention and deletion responsibilities.</p>
      </div>
      <div class="card">
        <h3>Compliance leverage</h3>
        <p class="muted small">Feeds ISO 27701 controls, GDPR accountability, and supports APP compliance.</p>
      </div>
    </div>
  </section>

  <!-- 3) FIELDS THAT WORK -->
  <section class="container section">
    <h2>ROPA fields that work</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card"><h3>Processing name & owner</h3><p class="muted small">Clear title and accountable person or team.</p></div>
      <div class="card"><h3>Purpose & lawful basis</h3><p class="muted small">Business reason; lawful basis where applicable.</p></div>
      <div class="card"><h3>Data subjects & data types</h3><p class="muted small">e.g., customers, staff; contact, health or usage data.</p></div>
      <div class="card"><h3>Systems & vendors</h3><p class="muted small">Applications, data stores, SaaS, and sub-processors.</p></div>
      <div class="card"><h3>Locations & transfers</h3><p class="muted small">Countries/regions, cross-border safeguards.</p></div>
      <div class="card"><h3>Retention & deletion</h3><p class="muted small">How long data is kept and how it's safely removed.</p></div>
      <div class="card"><h3>Security measures</h3><p class="muted small">Encryption, access controls, monitoring and logging.</p></div>
      <div class="card"><h3>DPIA flag & risk tier</h3><p class="muted small">Trigger criteria and outcome for assessments.</p></div>
      <div class="card"><h3>Review cadence</h3><p class="muted small">Quarterly/annual; last reviewed & next due.</p></div>
    </div>
  </section>

  <!-- 4) COMMON MISTAKES -->
  <section class="container section">
    <h2>Common mistakes (and how to avoid them)</h2>
    <div class="card">
      <ul class="muted small" style="margin:0;padding-left:1.1rem">
        <li><strong>Copy-paste content:</strong> Describing the vendor's product, not <em>your</em> processing. → Write how <em>you</em> collect, store, share and delete data.</li>
        <li><strong>No owners or reviews:</strong> Entries go stale. → Set owners and review cadence; track in SharePoint.</li>
        <li><strong>Vague retention:</strong> “Kept as needed.” → Use real timeframes or event-based rules and link to policy.</li>
        <li><strong>Hidden in files:</strong> Word/Excel on desktops. → Centralise in a SharePoint list with versioning.</li>
      </ul>
    </div>
  </section>

  <!-- 5) MAKE IT MAINTAINABLE -->
  <section class="container section">
    <h2>Make it maintainable with Microsoft 365</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>SharePoint list</h3>
        <p class="muted small">Required fields, choice columns and validation; version history by default.</p>
      </div>
      <div class="card">
        <h3>Power Automate</h3>
        <p class="muted small">Monthly nudges to owners; snapshot exports to dated folders for audit.</p>
      </div>
      <div class="card">
        <h3>Teams notifications</h3>
        <p class="muted small">Reminders for upcoming reviews or DPIA triggers.</p>
      </div>
    </div>
  </section>

  <!-- 6) PRACTICAL EXAMPLES -->
  <section class="container section">
    <h2>Practical examples</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>HR onboarding</h3>
        <p class="muted small">Purpose: employment. Systems: HRIS, payroll. Retention: 7 years post-termination. Risk: medium; no DPIA.</p>
      </div>
      <div class="card">
        <h3>Marketing emails</h3>
        <p class="muted small">Purpose: direct marketing. Basis: consent. Vendor: ESP. Retention: 24 months of inactivity. Risk: low; unsubscribe path enforced.</p>
      </div>
      <div class="card">
        <h3>Patient support</h3>
        <p class="muted small">Purpose: service delivery. Data: contact + health notes. Retention: per health record regs. Risk: high; DPIA completed.</p>
      </div>
    </div>
  </section>

  <!-- 7) FAQ -->
  <section class="container section">
    <h2>ROPA FAQs</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>Who owns the ROPA?</h3>
        <p class="muted small">Privacy/compliance leads it; each entry has a business owner responsible for accuracy.</p>
      </div>
      <div class="card">
        <h3>How often should we review?</h3>
        <p class="muted small">At least annually — plus when new systems/vendors are added or processing changes.</p>
      </div>
      <div class="card">
        <h3>Can we link to other registers?</h3>
        <p class="muted small">Yes — vendor risk, data breach, and retention schedules should cross-reference the ROPA.</p>
      </div>
    </div>
  </section>

  <!-- Related services -->
<section class="container section-tight">
  <p style="margin:0 0 0.75rem;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#6B6860;">Related services</p>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;">
    <a href={`${base}services/iso27701/`} class="card" style="flex:1;min-width:180px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
      <strong style="display:block;color:#8B6820;margin-bottom:3px;">ISO 27701</strong>
      <span class="muted small">Privacy Information Management</span>
    </a>
    <a href={`${base}services/iso27001/`} class="card" style="flex:1;min-width:180px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
      <strong style="display:block;color:#8B6820;margin-bottom:3px;">ISO 27001</strong>
      <span class="muted small">Information Security Management</span>
    </a>
    <a href={`${base}checklist/iso27701/`} class="card" style="flex:1;min-width:180px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
      <strong style="display:block;color:#8B6820;margin-bottom:3px;">ISO 27701 Checklist</strong>
      <span class="muted small">Free readiness assessment</span>
    </a>
  </div>
</section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Ready to modernise your ROPA?</h3>
        <p class="muted" style="margin:0">We'll stand up a SharePoint ROPA with owners, reminders and audit-ready exports.</p>
      </div>
      <a class="btn btn-primary" href={`${base}book/`}>Book a walkthrough</a>
    </div>
  </section>

  <Footer />
</Base>
