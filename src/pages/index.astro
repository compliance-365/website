---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// URLs used in the hero
const ctaUrl       = 'https://calendly.com/matt-nicholas-compliance365/30min';
const resourcesUrl = base + 'resources';

// SEO helpers for JSON-LD
const org = {
  '@type': 'Organization',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  logo: 'https://www.compliance365.com.au/assets/og-default.png',
  sameAs: ['https://www.linkedin.com/company/compliance-365/']
};

const siteLd = {
  '@type': 'WebSite',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.compliance365.com.au/search?q={query}',
    'query-input': 'required name=query'
  }
};

const servicesLd = [
  { name: 'ISO 27001 Certification Support',       url: 'https://www.compliance365.com.au/services/iso27001' },
  { name: 'ISO 27701 Privacy (PIMS)',              url: 'https://www.compliance365.com.au/services/iso27701' },
  { name: 'ISO 42001 AI Governance (AIMS)',        url: 'https://www.compliance365.com.au/services/iso42001' },
  { name: 'SOC 2 Readiness',                       url: 'https://www.compliance365.com.au/services/soc2' },
  { name: 'Essential Eight Uplift',                url: 'https://www.compliance365.com.au/services/essential-eight' },
  { name: 'DISP / ISM / IRAP',                     url: 'https://www.compliance365.com.au/services/disp-ism-irap' }
].map(s => ({
  '@type': 'Service',
  serviceType: s.name,
  provider: { '@type': 'Organization', name: 'Compliance365' },
  url: s.url
}));

const ld = {
  '@context': 'https://schema.org',
  '@graph': [org, siteLd, ...servicesLd]
};
---

<Base
  title="Cyber, Privacy & AI Compliance — Australia | Compliance365"
  description="Practical cyber, privacy and AI governance for Australian organisations. ISO 27001, ISO 27701, ISO 42001, SOC 2 and Essential Eight — with audit-ready evidence and clear, repeatable processes."
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': 'https://www.compliance365.com.au/#home',
      'name': 'Compliance365 — Cyber, Privacy & AI Governance',
      'url': 'https://www.compliance365.com.au/',
      'description':
        'Certification and readiness for ISO 27001, ISO 27701, ISO 42001, SOC 2 and Essential Eight in Australia — without adding new platforms or complex tooling.'
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://www.compliance365.com.au/' }
      ]
    },
    ld
  ]}
/>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container hero hero-grid">

      <!-- Left: copy + form -->
      <div class="hero-left">
        <h1 class="hero-title">Audit-ready cyber, privacy &amp; AI compliance for Australian organisations.</h1>

        <p class="hero-lede">
          We help you move from scattered spreadsheets and ad-hoc audits to a clear, repeatable compliance rhythm. 
          No extra platforms. No unnecessary licenses. Just practical, evidence-backed governance that stands up to scrutiny.
        </p>

        <ul class="hero-benefits6">
          <li><span class="hb-ico"></span>Reduce audit stress and last-minute fire drills</li>
          <li><span class="hb-ico"></span>Turn policies, risks &amp; controls into live evidence</li>
          <li><span class="hb-ico"></span>Support for ISO 27001, 27701, 42001, SOC 2 &amp; Essential Eight</li>
          <li><span class="hb-ico"></span>Clear ownership, cadence and reporting</li>
          <li><span class="hb-ico"></span>Designed for lean teams with limited time</li>
          <li><span class="hb-ico"></span>Guidance from a hands-on practitioner, not a tool vendor</li>
        </ul>

        <style>
          .hb-ico {
            display:inline-flex;
            align-items:center;
            justify-content:center;
            width:16px;
            height:16px;
            border-radius:50%;
            background:#4154f1;
            color:#fff;
            font-size:12px;
            margin-right:8px;
          }
          .hb-ico::before {
            content:"✓";
            font-weight:700;
          }
        </style>

        <!-- Who this is for -->
        <div class="card" style="margin-top:14px; border-radius:16px; padding:10px 14px;">
          <p class="small muted" style="margin:0 0 4px;">Built for:</p>
          <div class="pill-row" style="margin-top:2px;">
            <span class="pill">CISOs &amp; Heads of Security</span>
            <span class="pill">Privacy &amp; Risk Leaders</span>
            <span class="pill">Founders &amp; COOs of growing SaaS and services businesses</span>
          </div>
        </div>

        <p id="hero-status" class="hero-trust" style="min-height:1.2em; margin-top:10px;">
          Trusted by security-minded organisations across Australia.
        </p>

        <!-- Simple email form -->
        <form id="hero-form" class="hero-form" aria-label="Get started">
          <input
            id="hero-email"
            type="email"
            name="email"
            placeholder="Enter your work email"
            required
          />
          <button class="btn btn-primary" type="submit" id="hero-submit">
            Get started
          </button>
          <input type="hidden" name="source" value="hero-email" />
        </form>

        <p class="small muted" style="margin-top:6px;">
          Prefer to talk? <a href={ctaUrl} target="_blank" rel="noopener">Book a 30-minute intro call</a>.
        </p>
      </div>

      <!-- Right: visual -->
      <div class="hero-right">
        <img
          class="hero-image"
          src="/assets/hero-illustration.svg"
          width="480"
          height="300"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          alt="Audit-ready compliance view"
        />
      </div>
    </div>

    <!-- Inline script for Lambda submission -->
    <script is:inline>
      const API_URL = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

      const form   = document.getElementById("hero-form");
      const email  = document.getElementById("hero-email");
      const submit = document.getElementById("hero-submit");
      const status = document.getElementById("hero-status");

      function validEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        status.textContent = "";
        submit.disabled = true;

        try {
          const payload = {
            name: "Website visitor",
            email: email.value.trim(),
            subject: "Website enquiry (hero form)",
            message: "Lead from homepage hero form",
            source: "hero-email",
            page: location.pathname
          };

          const res  = await fetch(API_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          const text = await res.text().catch(() => "");

          if (!res.ok) {
            console.error("Hero submit failed", { status: res.status, text });
            status.textContent = `Sorry, something went wrong (HTTP ${res.status}).`;
            status.style.color = "crimson";
            return;
          }

          form.reset();
          status.textContent = "Thanks — we’ll be in touch shortly.";
          status.style.color = "var(--primary)";
        } catch (err) {
          console.error("Hero form error:", err);
          status.textContent = "Sorry, something went wrong. Please try again.";
          status.style.color = "crimson";
        } finally {
          submit.disabled = false;
        }
      });
    </script>
  </section>

