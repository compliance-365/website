---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27001 (Information Security)';

// -- Environment capture (Stage 1) -------------------------
const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–100','100–500','500–1,000','Over 1,000'] },
  { id: 'env-licensing',label: 'Microsoft licensing tier',             type: 'select', required: false, options: ['Microsoft 365 E5','Microsoft 365 E3','Microsoft 365 Business Premium','Microsoft 365 Business Standard','No Microsoft 365','Not sure'] },
  { id: 'trigger',      label: 'What is prompting you to look at ISO 27001 now?', type: 'select', required: true, options: ['Enterprise customer requiring certification','Government tender or procurement gate','Cyber insurance renewal','Investor or board requirement','Recent security incident or near-miss','Internal initiative — no external pressure yet','Other / multiple drivers'] },
  { id: 'timeline',     label: 'When do you need to be audit-ready?', type: 'select', required: false, options: ['Within 3 months','3–6 months','6–12 months','12+ months','No fixed deadline'] },
];

// -- Questions — 15 sharpened, 4 sections -------------------
const QUESTIONS = [
  // Governance
  { id:'isms-scope',  group:'gov',      label:'ISMS scope is defined and approved — covering locations, systems, services, and explicit exclusions', hint:'A clear scope statement is the first thing an auditor checks. Vague or missing scope is the most common Stage 1 finding.', examples:['One-page scope statement listing sites, cloud environments, core systems, and customer-facing services in scope','Diagram showing boundaries — e.g. "Production AWS + corporate M365 in scope; personal devices and lab environments out"','Documented exclusions with justification and any compensating controls'] },
  { id:'leadership',  group:'gov',      label:'Top management has assigned roles, committed resources, and is visibly engaged in security governance', hint:'Auditors want evidence that security is owned at executive level — not just delegated to IT.', examples:['ISMS governance chart showing sponsor, ISMS owner, risk owners, and control owners','Leadership-approved policy statement and management review minutes showing security on the agenda','Resourcing decisions (budget, roles, priorities) tied to documented security risks'] },
  { id:'policy',      group:'gov',      label:'Information security policy and supporting policies are current, approved, communicated, and reviewed periodically', hint:'Policies must be version-controlled, dated, and demonstrably acknowledged by staff.', examples:['InfoSec policy with version control, approval date, and next review date documented','Supporting policies covering access control, incident response, change management, supplier security, and acceptable use','Evidence of communication — intranet links, staff acknowledgements, onboarding training records'] },
  { id:'risk-method', group:'gov',      label:'Risk assessment methodology is defined and applied consistently — with criteria, scoring, and risk appetite documented', hint:'Repeatability matters more than complexity. The same method should produce comparable results regardless of who runs the assessment.', examples:['Risk matrix with likelihood and impact definitions, plus scoring guidance for each level','Documented risk acceptance thresholds — who can approve risks at what level','Worked example showing two assessors producing comparable ratings using the methodology'] },
  // Controls & SoA
  { id:'risk-register', group:'controls', label:'A live risk register is maintained — with named owners, treatment plans, due dates, and review cadence', hint:'Auditors look for a register that is actively maintained — not a spreadsheet last updated at certification.', examples:['Risk register entries showing description, affected assets, owner, treatment plan, due date, and current status','Monthly or quarterly review cadence with updates and decisions documented','Linked evidence — tickets, remediation plans, change records, or signed risk acceptance forms'] },
  { id:'soa',         group:'controls', label:'Statement of Applicability is complete — included/excluded controls, justifications, status, owner, and evidence pointers', hint:'The SoA is the audit index. A weak SoA undermines an otherwise strong ISMS.', examples:['Each Annex A control marked applicable / not applicable with documented justification','Implementation status (Implemented / In Progress / Excluded) and named control owner','Direct link to evidence location — SharePoint folder path, configuration export, or system report'] },
  { id:'assets',      group:'controls', label:'Information assets and systems are inventoried, classified, and have assigned owners', hint:'You need to know what you have and what matters most before you can prioritise protection.', examples:['Asset inventory covering applications, infrastructure, data stores, endpoints, and key SaaS tools','Data classification or "crown jewels" register identifying critical systems and sensitive data','Lifecycle process — onboarding, periodic review, and retirement documented'] },
  { id:'access',      group:'controls', label:'Access control is governed — joiner/mover/leaver process, role-based access, MFA, and privileged access controls', hint:'Access reviews and privileged access governance are among the most heavily sampled controls in ISO 27001 audits.', examples:['Documented joiner/mover/leaver process with timelines, approvals, and audit trail','Role-based access groups with periodic access reviews — quarterly for sensitive systems','Privileged access separated, with MFA, just-in-time elevation (e.g. Entra PIM), and centralised logging'] },
  { id:'suppliers',   group:'controls', label:'Third-party and supplier security is governed — risk tiering, contract clauses, and ongoing review', hint:'Supply chain risk is increasingly scrutinised — especially after SolarWinds, Log4j, and MOVEit.', examples:['Vendor risk assessment process tiering suppliers by criticality and data access','Contract clauses covering security obligations, breach notification, audit rights, and sub-processor controls','Annual review of critical suppliers — SOC reports, ISO certificates, questionnaires, incident history'] },
  // Operations & resilience
  { id:'logging',  group:'ops',   label:'Centralised security logging and alerting is in place for identity, endpoints, cloud, and critical applications', hint:'Logs must support both detection and investigation. Without log retention and review evidence, controls fail audit testing.', examples:['Centralised logging covering Entra/SSO, endpoints, cloud audit logs, and key applications','Alert rules for high-risk patterns — impossible travel, admin role changes, excessive failed logins','Documented log retention period and access controls; evidence of alert review and triage'] },
  { id:'vulns',    group:'ops',   label:'A repeatable vulnerability management process is in place — scanning, patching, prioritisation, and verified closure', hint:'Auditors want to see SLAs being met or exceptions being managed — not just that scanning happens.', examples:['Regular vulnerability scanning across infrastructure and applications, with documented frequency and scope','Patch SLAs (e.g. critical within 14 days) with a documented exception process','Remediation tracking — tickets and evidence that high/critical vulnerabilities are resolved or formally accepted'] },
  { id:'incident', group:'ops',   label:'Incident response plan is documented, tested, and improved after exercises or real incidents', hint:'Plans that have never been tested often fail when needed. A tabletop exercise outcome is strong evidence.', examples:['Incident response runbook covering roles, severity levels, escalation paths, and contact list','Tabletop exercise outcomes with lessons learned and an action plan','Post-incident review records showing improvements made after incidents or near-misses'] },
  { id:'backups',  group:'ops',   label:'Backups are configured, monitored, and restore-tested — with RTO and RPO targets aligned to business needs', hint:'Untested backups are not evidence — auditors will sample restore test records.', examples:['Defined RTO and RPO per critical system','Backup schedule, scope, and monitoring/alerts for failed jobs','Documented restore tests and DR/BCP exercises with outcomes and improvements'] },
  // Audit & improvement
  { id:'internal-audit',    group:'audit', label:'Internal ISMS audits are performed against a plan — with findings tracked to verified closure', hint:'Internal audit is mandatory under ISO 27001. The audit must cover all clauses and a sample of Annex A controls.', examples:['Annual internal audit plan covering ISO 27001:2022 clauses 4–10 and a rotating sample of Annex A controls','Audit reports with findings, root cause, corrective actions, owners, and due dates','Evidence that corrective actions are verified closed — not just marked "done"'] },
  { id:'management-review', group:'audit', label:'Management reviews are held at planned intervals — covering risks, incidents, KPIs, audit results, and improvements', hint:'Management review minutes are mandatory evidence and one of the first documents auditors request.', examples:['Management review agenda and minutes covering all required ISO 27001 inputs','Recorded decisions on resourcing, policy changes, risk acceptance, and improvement priorities','Action register with owners, due dates, and closure tracking'] },
];

const GROUPS = [
  { key:'gov',      title:'Governance & ISMS Foundation',  blurb:'Scope, leadership, policy, and risk methodology.', icon:'clipboard' },
  { key:'controls', title:'Annex A Controls & SoA',         blurb:'Controls, SoA, assets, access, and supplier risk.', icon:'lock' },
  { key:'ops',      title:'Security Operations & Resilience', blurb:'Logging, vulnerabilities, incidents, backups.', icon:'shield' },
  { key:'audit',    title:'Audit, Measurement & Improvement', blurb:'Internal audit and management review.', icon:'chart' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="Free ISO 27001 Readiness Checklist | Compliance365"
  description="Interactive ISO 27001:2022 readiness assessment. Score your ISMS across governance, risk, controls and audit, then download a PDF roadmap."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'ISO 27001 Readiness', url: 'https://www.compliance365.com.au/checklist/iso27001/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Free Readiness Assessment</p>
      <h1>ISO 27001 Readiness Checklist</h1>
      <p class="section-lead" style="max-width:760px;">
        Score your Information Security Management System against ISO 27001:2022 in 15 minutes. Tell us about your environment, answer 15 sharpened questions, and download a branded PDF roadmap with your top gaps and recommended next steps.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#A9812E;color:var(--on-gold);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill band-light" data-stage="2" style="flex:1;min-width:140px;background:#DDD8CF;color:var(--text-subtle);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill band-light" data-stage="3" style="flex:1;min-width:140px;background:#DDD8CF;color:var(--text-subtle);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#FAF7F1;padding:2rem 0;border-top:1px solid #DDD8CF;border-bottom:1px solid #DDD8CF;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--gold-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-clock"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">~15 minutes</strong><p class="muted small" style="margin:2px 0 0;">15 sharpened questions across 4 ISMS domains, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--ok-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-check-seal"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Mapped to ISO 27001:2022</strong><p class="muted small" style="margin:2px 0 0;">Calibrated to clauses 4-10 and Annex A controls — the same criteria certification auditors sample.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--gold-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-note"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top gaps, and a prioritised 90-day action plan. Emailed copy + instant download.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container" style="max-width:1140px;">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:#6B6860;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#A9812E;color:var(--on-gold);font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">DISP / ISM / IRAP</a>
      </div>
    </div>
  </div>

  <!-- MAIN -->
  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- ----- STAGE 1: Environment ----- -->
      <div id="stage-1" class="stage">
        <div class="card spot" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0B0B0C;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>

          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>

          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #DDD8CF;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 2: Questions ----- -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;" id="stage-2-grid">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #DDD8CF;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #DDD8CF;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="width:1.75rem;height:1.75rem;display:inline-flex;align-items:center;justify-content:center;color:var(--gold-ink);flex-shrink:0;"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><use href={`#ic-${grp.icon}`}/></svg></span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0B0B0C;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:var(--gold-ink);">0/{grpQs.length}</div>
                    </div>
                  </div>

                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #F5F0E8;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:rgba(169,129,46,0.06);color:var(--gold-ink);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0B0B0C;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:var(--gold-ink);font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:var(--gold-ink);border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card spot" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #F5F0E8;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:var(--gold-ink);line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#6B6860;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:var(--text-subtle);font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#C8C3B8;"> - </span>
                    </div>
                    <div style="background:#F5F0E8;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#C8C3B8;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #F5F0E8;">
                <div style="font-size:0.75rem;color:#6B6860;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#F5F0E8;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#A9812E;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:var(--gold-ink);border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 3: Confirmation ----- -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card spot" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team  -  we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  </main>

  <Footer />

  <!-- jsPDF -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = "ISO 27001 (Information Security)";
      const API_URL  = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

      // Mirror server data on the client
      const GROUPS = [
        { key:'gov',      title:'Governance & ISMS Foundation' },
        { key:'controls', title:'Annex A Controls & SoA' },
        { key:'ops',      title:'Security Operations & Resilience' },
        { key:'audit',    title:'Audit, Measurement & Improvement' },
      ];

      const QUESTIONS = [
        { id:'isms-scope',        group:'gov',      label:'ISMS scope is defined and approved — covering locations, systems, services, and explicit exclusions' },
        { id:'leadership',        group:'gov',      label:'Top management has assigned roles, committed resources, and is visibly engaged in security governance' },
        { id:'policy',            group:'gov',      label:'Information security policy and supporting policies are current, approved, communicated, and reviewed periodically' },
        { id:'risk-method',       group:'gov',      label:'Risk assessment methodology is defined and applied consistently — with criteria, scoring, and risk appetite documented' },
        { id:'risk-register',     group:'controls', label:'A live risk register is maintained — with named owners, treatment plans, due dates, and review cadence' },
        { id:'soa',               group:'controls', label:'Statement of Applicability is complete — included/excluded controls, justifications, status, owner, and evidence pointers' },
        { id:'assets',            group:'controls', label:'Information assets and systems are inventoried, classified, and have assigned owners' },
        { id:'access',            group:'controls', label:'Access control is governed — joiner/mover/leaver, role-based access, MFA, and privileged access controls' },
        { id:'suppliers',         group:'controls', label:'Third-party and supplier security is governed — risk tiering, contract clauses, and ongoing review' },
        { id:'logging',           group:'ops',      label:'Centralised security logging and alerting is in place for identity, endpoints, cloud, and critical applications' },
        { id:'vulns',             group:'ops',      label:'A repeatable vulnerability management process is in place — scanning, patching, prioritisation, and verified closure' },
        { id:'incident',          group:'ops',      label:'Incident response plan is documented, tested, and improved after exercises or real incidents' },
        { id:'backups',           group:'ops',      label:'Backups are configured, monitored, and restore-tested — with RTO and RPO targets aligned to business needs' },
        { id:'internal-audit',    group:'audit',    label:'Internal ISMS audits are performed against a plan — with findings tracked to verified closure' },
        { id:'management-review', group:'audit',    label:'Management reviews are held at planned intervals — covering risks, incidents, KPIs, audit results, and improvements' },
      ];

      const TOTAL_Q = QUESTIONS.length;

      // State
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        // Stage transitions
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#A9812E' : (s < n ? '#16a34a' : '#DDD8CF');
            p.style.color = (s <= n) ? 'var(--on-gold)' : 'var(--text-subtle)';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Stage 1 to 2
        document.getElementById('to-stage-2').addEventListener('click', function() {
          // Read all fields by ID - simple and reliable
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','env-licensing','trigger','timeline'];
          var reqIds  = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];

          allIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) env[id] = el.value ? el.value.trim() : '';
          });

          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) {
              valid = false;
              el.style.borderColor = '#dc2626';
              el.style.background  = '#fef2f2';
            } else {
              el.style.borderColor = '#C8C3B8';
              el.style.background  = 'white';
            }
          });

          var errEl = document.getElementById('env-error');
          if (!valid) {
            errEl.style.display = 'block';
            errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        // Click-to-answer
        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white';
              o.style.color = '#0B0B0C';
              o.style.borderColor = '#C8C3B8';
            });
            btn.classList.add('active');
            // Colour by value
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'var(--on-gold)'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'var(--on-gold)'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        // Ask AI about a specific question (Level 1)
        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the ISO 27001 readiness checklist. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') {
              window.c365OpenChat(msg);
            }
          });
        });

        // Discuss full results with AI (Level 2 + 3)
        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        // Reset
        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white';
            o.style.color = '#0B0B0C';
            o.style.borderColor = '#C8C3B8';
          });
          update();
        });

        // PDF generation
        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true;
          btn.textContent = 'Generating...';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
            if (typeof gtag === 'function') gtag('event', 'checklist_completed', { framework: 'ISO 27001' });
          } catch (err) {
            console.error(err);
            alert('Something went wrong  -  your PDF should still have downloaded.');
          } finally {
            btn.disabled = false;
            btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => {
          if (state[id] !== null) { answered++; sum += state[id]; }
        });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { key: 'na', label: 'Not started', desc: 'Answer questions to score', color: '#6B6860' };
        if (score >= 86) return { key: 'cr', label: 'Certification-Ready', desc: 'Strong posture  -  focus on validation and audit packaging', color: '#16a34a' };
        if (score >= 61) return { key: 'nar', label: 'Nearly Audit-Ready', desc: 'Close minor gaps and focus on evidence packaging', color: '#A9812E' };
        if (score >= 31) return { key: 'pr', label: 'Partially Ready', desc: 'Many core elements in place  -  focus and prioritisation needed', color: '#d97706' };
        return { key: 'hr', label: 'High Risk', desc: 'Missing foundational controls  -  structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#C8C3B8';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the ISO 27001 readiness checklist on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('Target timeline: ' + (env['timeline'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Domain scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) {
            var v = state[q.id] === 1 ? 'PARTIAL' : 'NO';
            lines.push('  [' + v + '] ' + q.label);
          });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest gaps, what I should prioritise, and what a realistic path to ISO 27001 certification looks like for my organisation?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);

        // Overall
        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        // Per-section
        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#F5F0E8';
            el.style.color = a === total ? '#166534' : '#3A3632';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) {
              bar.style.width = '0%'; bar.style.background = '#C8C3B8';
              pctEl.textContent = ' - '; pctEl.style.color = '#C8C3B8';
            } else {
              bar.style.width = pct + '%'; bar.style.background = barColor(pct);
              pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct);
            }
          }
        });

        // Enable PDF + AI discuss
        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone;
        btn.style.cursor = allDone ? 'pointer' : 'not-allowed';
        btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone
          ? 'Click to generate and email your report'
          : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) {
          aiBtn.disabled = !allDone;
          aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed';
          aiBtn.style.opacity = allDone ? '1' : '0.5';
        }
      }

      // Submit to AWS Lambda
      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const sectionScores = GROUPS.map(g => ({ title: g.title, ...computeSection(g.key) }));

        const lines = [];
        lines.push('=== ISO 27001 READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Microsoft licensing: ${env['env-licensing'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Audit-ready timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        sectionScores.forEach(s => lines.push(`  ${s.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`));
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          const label = v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED';
          lines.push(`[${label}] ${q.label}`);
        });

        const payload = {
          name: env['contact-name'] || env['org-name'] || 'Anonymous',
          email: env['contact-email'] || 'noreply@compliance365.com.au',
          subject: `ISO 27001 Checklist  -  ${env['org-name'] || 'Anonymous'}  -  ${score}%`,
          message: lines.join('\n'),
        };

        try {
          await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.warn('API submission failed:', err);
        }
      }

// ===========================================================
// PDF Generation — revised enterprise design (drop-in)
// Replace the existing generatePDF() in your <script is:inline>
// with this function. Uses the same `state`, `env`, `compute`
// data model and the same #pdfLogo element — no other changes
// to the page are required.
// ===========================================================
function generatePDF() {
  var jsPDFLib = window.jspdf || {};
  var jsPDF = jsPDFLib.jsPDF;
  if (!jsPDF) { alert('PDF library not loaded - please wait a moment and try again.'); return; }
  try {
  var doc = new jsPDF('p','mm','a4');
  var W=210, H=297, LM=18, RM=18, CW=W-LM-RM;
  var y=0;

  // ---- Restrained enterprise palette ----
  var NAVY      = [15, 23, 42];
  var PRIMARY   = [30, 64, 175];
  var ACCENT    = [6, 182, 212];
  var LIGHT     = [248,250,252];
  var BORDER    = [226,232,240];
  var MUTED     = [100,116,139];
  var SLATE     = [71, 85, 105];
  var WHITE     = [255,255,255];
  var DARK_TXT  = [17, 24, 39];
  var GREEN     = [5, 150, 105];
  var GREEN_LT  = [236,253,245];
  var AMBER     = [217, 119, 6];
  var AMBER_LT  = [255,251,235];
  var RED       = [220, 38, 38];
  var RED_LT    = [254,242,242];

  var comp=compute(), sc=comp.score, ansCount=comp.answered;
  var orgName=env['org-name']||'Your Organisation';
  var sector=env['org-sector']||'', orgSize=env['org-size']||'';
  var licensing=env['env-licensing']||'', trigger=env['trigger']||'';
  var timeline=env['timeline']||'', cName=env['contact-name']||'';
  var cEmail=env['contact-email']||'';
  var safeOrg=orgName.replace(/[^a-z0-9]/gi,'-');
  var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
  var rptId='C365-'+new Date().getFullYear()+'-'+Math.random().toString(36).substr(2,5).toUpperCase();
  var scoreCol   = sc>=75?GREEN:sc>=50?AMBER:RED;
  var scoreBand  = sc>=86?'Certification-Ready':sc>=61?'Nearly Audit-Ready':sc>=31?'Partially Ready':'High Risk';
  var bandDesc   = sc>=86?'Focus on evidence currency and surveillance audit preparation.':sc>=61?'Close identified gaps and tighten evidence packaging.':sc>=31?'An 8\u201312 week focused programme would close priority gaps.':'A 12\u201316 week programme is recommended before pursuing certification.';

  var logoEl=document.getElementById('pdfLogo');
  var hasLogo=logoEl&&logoEl.complete&&logoEl.naturalWidth>0;

  var GPDF=[
    {key:'gov',      title:'Governance & ISMS Foundation',      blurb:'Scope, leadership, policy and risk methodology'},
    {key:'controls', title:'Annex A Controls & SoA',             blurb:'Controls, SoA, assets, access and supplier risk'},
    {key:'ops',      title:'Security Operations & Resilience',   blurb:'Logging, vulnerabilities, incidents and backups'},
    {key:'audit',    title:'Audit, Measurement & Improvement',   blurb:'Internal audit and management review'},
  ];
  var QPDF=[
    {id:'isms-scope',        group:'gov',      label:'ISMS scope defined and approved',                               hint:'A clear scope statement is the first thing an auditor checks. Vague or missing scope is the most common Stage 1 finding.'},
    {id:'leadership',        group:'gov',      label:'Top management visibly engaged in security governance',          hint:'Auditors want evidence security is owned at executive level, not just delegated to IT.'},
    {id:'policy',            group:'gov',      label:'Information security policies current, approved and communicated',hint:'Policies must be version-controlled, dated and demonstrably acknowledged by staff.'},
    {id:'risk-method',       group:'gov',      label:'Risk assessment methodology defined and applied consistently',   hint:'Repeatability matters. The same method should produce comparable results regardless of who runs it.'},
    {id:'risk-register',     group:'controls', label:'Live risk register with owners, treatments and review cadence',  hint:'Auditors look for a register actively maintained, not a spreadsheet last updated at certification.'},
    {id:'soa',               group:'controls', label:'Statement of Applicability complete with evidence pointers',     hint:'The SoA is the audit index. A weak SoA undermines an otherwise strong ISMS.'},
    {id:'assets',            group:'controls', label:'Information assets inventoried, classified and owned',           hint:'You need to know what you have and what matters most before you can prioritise protection.'},
    {id:'access',            group:'controls', label:'Access control governed \u2014 JML, RBAC, MFA and privileged access', hint:'Access reviews and privileged access governance are among the most heavily sampled controls.'},
    {id:'suppliers',         group:'controls', label:'Supplier security governed with risk tiering and reviews',       hint:'Supply chain risk is increasingly scrutinised after SolarWinds, Log4j and MOVEit.'},
    {id:'logging',           group:'ops',      label:'Centralised security logging and alerting in place',             hint:'Logs must support both detection and investigation. Without retention evidence, controls fail testing.'},
    {id:'vulns',             group:'ops',      label:'Repeatable vulnerability management process in place',           hint:'Auditors want to see SLAs being met or exceptions managed, not just that scanning happens.'},
    {id:'incident',          group:'ops',      label:'Incident response plan documented and tested',                   hint:'Plans that have never been tested often fail when needed. A tabletop exercise outcome is strong evidence.'},
    {id:'backups',           group:'ops',      label:'Backups configured, monitored and restore-tested',               hint:'Untested backups are not evidence. Auditors will sample restore test records.'},
    {id:'internal-audit',    group:'audit',    label:'Internal ISMS audits performed against a plan',                  hint:'Internal audit is mandatory. Must cover all clauses and a sample of Annex A controls.'},
    {id:'management-review', group:'audit',    label:'Management reviews held at planned intervals',                   hint:'Management review minutes are mandatory evidence and one of the first documents auditors request.'},
  ];

  function computeSecPDF(key){
    var qs=QPDF.filter(function(q){return q.group===key;});
    var answered=0, sum=0;
    qs.forEach(function(q){if(state[q.id]!==null){answered++;sum+=state[q.id];}});
    var pct=answered===0?null:Math.round((sum/(qs.length*2))*100);
    return {answered:answered,total:qs.length,pct:pct};
  }

  function fc(c){doc.setFillColor(c[0],c[1],c[2]);}
  function tc(c){doc.setTextColor(c[0],c[1],c[2]);}
  function dc(c){doc.setDrawColor(c[0],c[1],c[2]);}
  function bf(s){doc.setFont('helvetica','bold');doc.setFontSize(s);}
  function nf(s){doc.setFont('helvetica','normal');doc.setFontSize(s);}
  function rr(x,y,w,h,r,sty){if(w>0&&h>0)doc.roundedRect(x,y,w,h,Math.min(r,w/2,h/2),Math.min(r,w/2,h/2),sty);}
  function kicker(txt,x,ky,col){bf(7);tc(col||MUTED);doc.text(txt.toUpperCase(),x,ky,{charSpace:0.6});}

  function card(x,cy,w,h,r){
    fc(WHITE); rr(x,cy,w,h,r||2,'F');
    dc(BORDER); doc.setLineWidth(0.3); rr(x,cy,w,h,r||2,'S');
  }

  function badge(txt,bg,fg,bx,by,bw,bh){
    bh=bh||6; bw=Math.max(bw,doc.getTextWidth(txt)*0.7+10);
