---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Essential Eight Maturity Uplift — Australia',
  serviceType: 'Essential Eight Maturity Uplift',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/essential-eight',
  description:
    'Essential Eight assessments and ML2 maturity uplift for Australian mid-market and government-adjacent organisations. Fixed-price, 12–16 weeks, delivered inside your existing Microsoft 365 environment. Senior-led, evidence-backed.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does Essential Eight ML2 uplift actually take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For most Australian mid-market organisations on Microsoft 365 E5, the path from current state to evidenced ML2 is 12–16 weeks. This is much shorter than the 6-month timelines many consultancies quote because most of the technical control surface is already deliverable through M365 native tooling. The 12–16 weeks covers configuration uplift, ring-based rollout, drift detection, and evidence pack assembly — not 6 months of platform configuration.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does Essential Eight ML2 uplift cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Our fixed-price Essential Eight ML2 uplift engagements range from $22k for under-50-staff scope to $120k for 500+ staff enterprise scope. A standalone Essential Eight assessment (2–3 weeks, ASD-mapped maturity report with prioritised roadmap) is fixed-price from $8k–$18k. Combined Essential Eight + ISO 27001 engagements typically reduce total cost by 30–40% versus running them separately.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need new tools for Essential Eight ML2?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For organisations on Microsoft 365 E5, approximately 80–85% of the ML2 technical control surface is achievable using native capabilities — Intune for application control and patching, Defender for Endpoint P2 for vulnerability management, Entra ID P2 with PIM for privileged access, and Defender Vulnerability Management for OS patching. The main external requirement is third-party Microsoft 365 backup tooling, which is required for the Regular Backups control and not included in E5. For organisations on M365 E3, additional licensing or tooling may be needed depending on scope.'
      }
    },
    {
      '@type': 'Question',
      name: 'What maturity level should we target?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ML2 is the ASD-recommended baseline for most Australian organisations and is increasingly the level required by cyber insurers, government procurement panels, and large enterprise customers in supply chain due diligence. ML3 is appropriate for high-risk environments, Commonwealth entities, and defence-adjacent organisations facing nation-state-level threats. ML1 is rarely a target — it represents minimal mitigation and is generally not sufficient for procurement or insurance purposes. Most mid-market clients target ML2 as the first structured programme objective.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is the Essential Eight mandatory for Australian businesses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For non-corporate Commonwealth entities, the Essential Eight is mandatory under the Protective Security Policy Framework (PSPF). For private sector organisations it is not legislatively mandated, but it is increasingly required by cyber insurers as a condition of coverage or premium reduction, referenced in SOCI Act obligations for critical infrastructure operators, and expected by enterprise and government customers in procurement questionnaires and supply chain due diligence.'
      }
    },
    {
      '@type': 'Question',
      name: 'Will the evidence stand up to an external assessor or insurance audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every milestone evidence pack is assembled against ASD\'s published ML2 evidence requirements with a criteria-mapping index. Each pack passes a four-point internal QA review — completeness, defensibility, currency, and coherence — before sign-off. The evidence is designed to survive IRAP reviews, cyber insurance audits, customer due diligence questionnaires, and board-level scrutiny. We don\'t claim a control is complete until the evidence would pass an independent assessor.'
      }
    }
    ,
    {
      '@type': 'Question',
      name: 'What is the difference between Essential Eight ML1, ML2, and ML3?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ML1 means controls are partially implemented — generally insufficient for insurance or procurement. ML2 is the ASD-recommended baseline: controls are implemented, tested, and evidenced against specific criteria. ML3 adds stricter requirements for MFA, privileged access, and application control — appropriate for high-risk environments, Commonwealth entities, and defence-adjacent organisations. Most mid-market clients target ML2 as the structured first objective.'
      }
    }
  ]
};
---

<Base
  title="Essential Eight ML2 Uplift Australia — Faster Than You Think | Compliance365"
  description="Essential Eight assessments and ML2 maturity uplift for Australian organisations. Fixed-price, 12–16 weeks, delivered inside your existing Microsoft 365 environment. Senior-led, evidence-backed. Most M365 E5 clients are closer to ML2 than they realise."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <p class="eyebrow">Essential Eight · Australia</p>
          <h1>Essential Eight ML2 — you're closer than you think.</h1>
          <p class="section-lead muted">
            Most Australian mid-market organisations on Microsoft 365 E5 are already at ML1 across most controls — and within 12–16 weeks of evidenced ML2. We assess where you actually sit, design the shortest path to ML2, and capture audit-ready evidence at every milestone.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">12–16 weeks to ML2</span>
            <span class="pill">ML2 = Maturity Level 2 (ASD baseline)</span>
            <span class="pill">Fixed-price</span>
            <span class="pill">M365 native</span>
            <span class="pill">ASD-mapped evidence</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">Book a 30-min call</a>
            <a href="#controls" class="btn btn-outline">See all 8 controls</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/essential-eight-maturity.svg`}
            alt="Sample Essential Eight maturity dashboard showing current state and gaps across all 8 ASD controls"
            style="display:block;width:100%;max-width:520px;height:auto;margin:0 auto;"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- THE "CLOSER THAN YOU THINK" ARGUMENT -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">The Essential Eight timeline myth — and the reality.</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto 3rem;">
        Most consultancies will tell you Essential Eight ML2 is a 6-month programme. For organisations on Microsoft 365 E5, that's usually wrong. Here's why.
      </p>

      <div class="grid-2" style="max-width:960px;margin:0 auto;gap:2rem;align-items:stretch;">
        <div class="card" style="border:1px solid #e2e8f0;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#64748b;text-transform:uppercase;margin:0 0 0.5rem;">Standard pitch</p>
          <h3 style="margin:0 0 1.25rem;">"6-month ML2 programme"</h3>
          <ul class="muted" style="padding-left:1.2rem;line-height:2;margin:0;">
            <li>Treats every control as starting from zero</li>
            <li>Bundles in platform selection and procurement</li>
            <li>Assumes greenfield deployment of security tools</li>
            <li>Generic methodology applied to any environment</li>
            <li>Junior consultants doing the implementation work</li>
          </ul>
          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #e2e8f0;">
            <p style="margin:0;font-size:0.85rem;color:#64748b;">Typical timeline:</p>
            <p style="margin:0.25rem 0 0;font-size:1.5rem;font-weight:800;color:#0f172a;">6+ months</p>
          </div>
        </div>

        <div class="card" style="border:2px solid #1e40af;background:#f0f9ff;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#1e40af;text-transform:uppercase;margin:0 0 0.5rem;">M365-native reality</p>
          <h3 style="margin:0 0 1.25rem;color:#1e3a8a;">12–16 week ML2 uplift</h3>
          <ul class="muted" style="padding-left:1.2rem;line-height:2;margin:0;">
            <li>Honest assessment of where you already are</li>
            <li>80–85% of ML2 already deliverable through E5 native tooling</li>
            <li>Configuration uplift, not greenfield deployment</li>
            <li>Ring-based rollout protects operations</li>
            <li>Senior practitioner doing the implementation directly</li>
          </ul>
          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #bae6fd;">
            <p style="margin:0;font-size:0.85rem;color:#1e40af;">Typical timeline:</p>
            <p style="margin:0.25rem 0 0;font-size:1.5rem;font-weight:800;color:#1e3a8a;">12–16 weeks</p>
          </div>
        </div>
      </div>

      <p class="muted center" style="margin-top:2rem;font-size:0.9rem;max-width:720px;margin-left:auto;margin-right:auto;">
        The exception: organisations on M365 E3, with substantial legacy estate, or with very low current maturity (ML0 across most controls) may genuinely need longer. We assess honestly before scoping.
      </p>
    </div>
  </section>

  <!-- WHY ESSENTIAL EIGHT MATTERS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why Essential Eight matters right now</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Three Australian pressures converging in 2026 — and a framework that addresses all three.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature">
          <h3>Cyber insurance is hardening</h3>
          <p class="muted small">
            Australian cyber insurers are tightening requirements rapidly. Essential Eight ML2 evidence is now a common condition of coverage or premium reduction for mid-market policies. Self-attestation isn't sufficient — insurers want assessor-grade evidence packs that hold up under post-incident scrutiny.
          </p>
        </div>
        <div class="card feature">
          <h3>Government procurement gates</h3>
          <p class="muted small">
            Federal, state, and government-adjacent procurement panels increasingly require Essential Eight maturity as a prerequisite — not just for direct contracts, but for supply chain due diligence. SOCI Act obligations for critical infrastructure operators reference Essential Eight explicitly.
          </p>
        </div>
        <div class="card feature">
          <h3>Enterprise customer due diligence</h3>
          <p class="muted small">
            Large enterprise customers running supply chain risk programmes are asking suppliers for documented Essential Eight maturity. Without evidence, you're either disqualified or stuck in remediation conversations that delay contracts by months.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE EIGHT CONTROLS -->
  <section class="section" style="background:#f8fafc;" id="controls">
    <div class="container">
      <h2 class="center">The eight controls — and what they actually require</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Each control addresses a specific adversary technique. Together they form a layered defence that dramatically reduces the likelihood of successful compromise. We deliver all eight to ML2 — configured to ASD intent, evidenced against ASD criteria.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature">
          <h3>1. Application Control</h3>
          <p class="muted small">
            Prevents unapproved or malicious executables from running. Deployed via WDAC or AppLocker through Intune with ring-based rollout and a documented exception governance process for line-of-business applications.
          </p>
        </div>
        <div class="card feature">
          <h3>2. Patch Applications</h3>
          <p class="muted small">
            Internet-facing and end-user applications patched within ASD timeframes. Managed through Defender Vulnerability Management and Intune with fortnightly scanning cadence and asset lifecycle oversight.
          </p>
        </div>
        <div class="card feature">
          <h3>3. Configure Office Macros</h3>
          <p class="muted small">
            Blocks or restricts Office macros to prevent the most common malware delivery vector. Enforced via Intune ADMX profiles with Defender ASR rules blocking macro-driven child processes and centralised telemetry.
          </p>
        </div>
        <div class="card feature">
          <h3>4. User Application Hardening</h3>
          <p class="muted small">
            Reduces the attack surface of browsers, Office, and PDF software through configuration hardening aligned to ACSC and vendor guidance. Deployed via Intune with compliance reporting and drift monitoring.
          </p>
        </div>
        <div class="card feature">
          <h3>5. Restrict Administrative Privileges</h3>
          <p class="muted small">
            Privileged accounts limited via Entra PIM with just-in-time elevation, approval workflows, and Windows LAPS for local admin rotation. All privileged events logged centrally with annual revalidation.
          </p>
        </div>
        <div class="card feature">
          <h3>6. Patch Operating Systems</h3>
          <p class="muted small">
            OS vulnerabilities remediated within ASD timeframes using Windows Update for Business and Defender Vulnerability Management. Includes legacy endpoint lifecycle for devices outside standard patch cadence.
          </p>
        </div>
        <div class="card feature">
          <h3>7. Multi-Factor Authentication</h3>
          <p class="muted small">
            MFA enforced for all users accessing internet-facing services and important data. Phishing-resistant methods (FIDO2, Windows Hello) for privileged accounts. Conditional Access policies managed via Entra ID P2.
          </p>
        </div>
        <div class="card feature">
          <h3>8. Regular Backups</h3>
          <p class="muted small">
            Business-critical data, software, and configuration restorable following an incident. Includes M365 backup tooling selection (third-party, required for ML2), immutable retention, restore testing, and a documented, tabletop-tested DRP.
          </p>
        </div>
        <div class="card feature" style="background:#fef3c7;border:1px solid #fde68a;">
          <h3>The honest gap</h3>
          <p class="muted small">
            One control consistently requires external tooling for ML2: Regular Backups. Microsoft 365 backup is not included in E5 — third-party tools (Veeam, AvePoint, HYCU, Keepit) are required. We help you select, configure, and evidence the right one without unnecessary spend.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section">
    <div class="container">
      <h2 class="center">Who this is for</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Essential Eight is the right framework for Australian organisations in one of these situations:
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card">
          <h3>Your cyber insurance renewal is approaching</h3>
          <p class="muted small">
            Insurers are asking for Essential Eight ML2 evidence as a condition of coverage or premium reduction. Self-attestation isn't sufficient anymore. We deliver assessor-grade evidence packs that hold up under insurer due diligence.
          </p>
        </div>
        <div class="card">
          <h3>You're on a government supply chain</h3>
          <p class="muted small">
            Federal, state, or defence-adjacent procurement requires Essential Eight maturity from suppliers. SOCI Act obligations reference it explicitly for critical infrastructure operators. Without it, you're disqualified at the questionnaire stage.
          </p>
        </div>
        <div class="card">
          <h3>You're an enterprise supplier facing TPRM</h3>
          <p class="muted small">
            Large enterprise customers running third-party risk management programmes are asking suppliers for documented Essential Eight maturity. ISO 27001 is increasingly expected as well, but Essential Eight is often the specific evidence procurement teams need to tick the box.
          </p>
        </div>
        <div class="card">
          <h3>You want ISO 27001 + Essential Eight together</h3>
          <p class="muted small">
            Essential Eight and ISO 27001 controls overlap substantially. Combined engagements typically reduce total cost by 30–40% versus running them sequentially. Common for organisations that need both an Australian cyber baseline and an international security certification.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE OPTIONS -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Two engagement shapes</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Both built on the same methodology — scoped to where you are and what you need.
      </p>

      <div class="grid-2" style="margin-top:3rem;max-width:960px;margin-left:auto;margin-right:auto;">
        <div class="card">
          <h3>Essential Eight Assessment</h3>
          <p class="muted small" style="margin-bottom:1rem;">
            Structured current-state assessment against ASD ML1, ML2, and ML3 criteria — with prioritised remediation roadmap. Delivered in 2–3 weeks. Fixed-price from $8k–$18k depending on scope.
          </p>
          <ul class="muted small" style="padding-left:1.2rem;margin-bottom:1.5rem;line-height:1.9;">
            <li>Tenant configuration review across all 8 controls</li>
            <li>Maturity rating mapped to ASD criteria (not self-attested)</li>
            <li>Prioritised remediation roadmap with effort estimates</li>
            <li>Evidence gap analysis — what you have vs what you need</li>
            <li>Board-ready summary report</li>
          </ul>
          <a href={ctaUrl} class="btn btn-outline">Book a call to scope</a>
        </div>
        <div class="card" style="border:2px solid #1e40af;">
          <div style="display:inline-block;background:#1e40af;color:white;font-size:0.7rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:3px 10px;border-radius:12px;margin-bottom:1rem;">Most popular</div>
          <h3>ML2 Uplift Programme</h3>
          <p class="muted small" style="margin-bottom:1rem;">
            End-to-end delivery from current state to evidenced ML2 across all eight controls. Fixed-price from $22k–$120k depending on scope. 12–16 weeks for most M365 E5 organisations.
          </p>
          <ul class="muted small" style="padding-left:1.2rem;margin-bottom:1.5rem;line-height:1.9;">
            <li>All eight controls implemented to ML2</li>
            <li>Milestone-gated payments tied to evidenced outcomes</li>
            <li>Audit-ready evidence pack per milestone</li>
            <li>Documented &amp; tabletop-tested DRP</li>
            <li>BAU runbooks &amp; drift detection dashboards</li>
            <li>30/60/90-day post-engagement watch-list</li>
          </ul>
          <a href={ctaUrl} class="btn btn-primary">Book a call to scope</a>
        </div>
      </div>

      <p class="muted center" style="margin-top:2rem;font-size:0.9rem;">
        Already at ML2 and looking to sustain or reach ML3?
        <a href={ctaUrl} style="color:#1e40af;font-weight:600;">Talk to us about ongoing assurance retainers.</a>
      </p>
    </div>
  </section>

  <!-- HOW WE DELIVER -->
  <section class="section">
    <div class="container">
      <h2 class="center">How we deliver ML2 uplift</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Every control follows the same four-phase delivery — overlapping across milestones to maintain momentum, but no control claimed complete until evidence is assessor-ready.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1–3</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Assess</p>
          <p class="muted small">Tenant configuration review, asset inventory, current maturity rated against ASD criteria. Prioritised remediation roadmap with effort estimates.</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 4–6</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Design</p>
          <p class="muted small">Each control designed to ASD intent. Pilot rings defined, exception workflows built, rollback plans documented. Steering committee sign-off before production changes.</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 7–12</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Implement</p>
          <p class="muted small">Controls deployed in audit mode first, monitored, exceptions triaged, then expanded in tranches before full enforcement. No big-bang changes that break operations.</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 13–16</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Evidence</p>
          <p class="muted small">Evidence captured at the point of change, never reconstructed later. Each milestone pack indexed against ASD criteria, QA reviewed, signed off before milestone payment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Common questions</h2>
      <p class="muted center" style="max-width:680px;margin:1.5rem auto;">
        Answered plainly. If you have a question not covered here, the fastest way to get a real answer is a 30-min call.
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card">
          <h3>How long does ML2 actually take?</h3>
          <p class="muted small">
            12–16 weeks for most Australian mid-market organisations on M365 E5. Shorter for focused engagements. Longer for E3 environments, substantial legacy estate, or very low current maturity. We assess honestly before scoping.
          </p>
        </div>
        <div class="card">
          <h3>What does it cost?</h3>
          <p class="muted small">
            Assessment: $8k–$18k fixed-price (2–3 weeks). ML2 uplift: $22k–$120k fixed-price depending on company size and scope. Combined with ISO 27001: 30–40% cheaper than running them separately.
          </p>
        </div>
        <div class="card">
          <h3>Do we need new tools?</h3>
          <p class="muted small">
            For M365 E5: 80–85% of ML2 is achievable with native tooling. The main external requirement is third-party M365 backup tooling (Veeam, AvePoint, HYCU, Keepit) which is required for the Regular Backups control. For E3, additional licensing or tooling may be needed.
          </p>
        </div>
        <div class="card">
          <h3>What maturity level should we target?</h3>
          <p class="muted small">
            ML2 for most mid-market organisations — the level cyber insurers and procurement panels expect. ML3 for high-risk, government, or defence-adjacent environments. ML1 is rarely sufficient for procurement or insurance purposes.
          </p>
        </div>
        <div class="card">
          <h3>Is it mandatory?</h3>
          <p class="muted small">
            Mandatory for non-corporate Commonwealth entities under the PSPF. For private sector: not legislatively mandated, but increasingly required by insurers, referenced in SOCI Act obligations, and expected by enterprise/government customers in due diligence.
          </p>
        </div>
        <div class="card">
          <h3>Will the evidence stand up to an auditor?</h3>
          <p class="muted small">
            Yes. Every evidence pack is assembled against ASD's published ML2 requirements with a criteria-mapping index. QA reviewed for completeness and defensibility. Designed to survive IRAP reviews, cyber insurance audits, and customer due diligence.
          </p>
        </div>
        <div class="card">
          <h3>What's the difference between ML1, ML2, and ML3?</h3>
          <p class="muted small">
            ML1 (Maturity Level 1) means controls are partially implemented with limited alignment to ASD intent — generally insufficient for cyber insurance or government procurement. ML2 is the ASD-recommended baseline: controls are implemented, tested, and evidenced against specific criteria. ML3 is ML2 with stronger requirements around multi-factor authentication, privileged access, and application control — appropriate for high-risk environments, Commonwealth entities, and defence-adjacent organisations. Most mid-market clients target ML2 as the structured first objective.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section">
    <div class="container center">
      <h2>Related frameworks</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Essential Eight pairs naturally with ISO 27001 for international procurement coverage, or with DISP/IRAP for defence-adjacent work.
      </p>

      <div class="pill-row" style="justify-content:center;flex-wrap:wrap;">
        <a class="pill" href={`${base}services/iso27001`}>ISO 27001 (Information Security)</a>
        <a class="pill" href={`${base}services/disp-ism-irap`}>DISP / IRAP (Defence)</a>
        <a class="pill" href={`${base}services/soc2`}>SOC 2 Type II</a>
        <a class="pill" href={`${base}services/iso27701`}>ISO 27701 (Privacy)</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Not sure where your Essential Eight maturity actually sits?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:680px;margin:1.5rem auto;">
        A free 30-minute call will give you a clear picture of your current maturity position, the most important gaps to close first, and what a realistic uplift programme looks like. If you're closer to ML2 than your last assessment suggested, we'll tell you.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
