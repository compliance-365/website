---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 27701 Privacy Information Management System — Australia',
  serviceType: 'ISO 27701 PIMS Implementation',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso27701',
  description:
    'ISO 27701 Privacy Information Management System implementation for Australian organisations. Extends ISO 27001 with privacy controls in 6–10 weeks. DPIAs, ROPAs, rights handling, third-party privacy management — delivered inside Microsoft 365.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is ISO 27701 and how does it relate to ISO 27001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 27701 is the international standard for Privacy Information Management Systems (PIMS). It extends ISO 27001 with privacy-specific controls covering personal data processing, data subject rights, DPIAs, ROPAs, third-party privacy management, and Controller/Processor responsibilities. ISO 27701 cannot be implemented standalone — it requires an underlying ISO 27001 ISMS, which is why most engagements deliver them together or extend an existing ISO 27001 certification.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does ISO 27701 implementation take in Australia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For organisations already holding ISO 27001 certification, adding ISO 27701 typically takes 6–10 weeks because the underlying management system structure carries over. For organisations starting from scratch, delivering ISO 27001 and ISO 27701 together usually takes 14–18 weeks — significantly less than implementing them sequentially.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does ISO 27701 cost as an extension to ISO 27001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For organisations already ISO 27001 certified, our ISO 27701 extension engagements range from $15k for under-50-staff scope to $60k for 500+ staff enterprise scope. Combined ISO 27001 + ISO 27701 engagements (for organisations starting from scratch) typically range $40k–$160k depending on scope. Combined delivery is 30–40% cheaper than running both programmes sequentially due to shared controls, evidence, and audit infrastructure.'
      }
    },
    {
      '@type': 'Question',
      name: 'Does ISO 27701 satisfy the Australian Privacy Act?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 27701 maps directly to the Australian Privacy Principles (APPs) and provides a structured framework for demonstrating compliance with the Privacy Act 1988 (as amended). It also covers requirements from the Privacy Act reform package rolling out through 2026 — including enhanced privacy impact assessment obligations, increased penalties for serious or repeated breaches, and the new statutory tort for serious invasions of privacy. ISO 27701 alone is not a substitute for legal advice on specific Privacy Act compliance, but it is the most credible evidence framework Australian regulators recognise.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need a separate privacy tool or OneTrust?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We implement your Privacy Information Management System inside your existing Microsoft 365 environment — SharePoint for ROPAs and DPIAs, Power Automate for rights request workflows, Purview for data classification and DLP, Teams for privacy training. Privacy-specific platforms like OneTrust have a place at enterprise scale, but mid-market organisations rarely need them. M365-native is faster to implement, cheaper to maintain, and avoids ongoing platform licence costs.'
      }
    },
    {
      '@type': 'Question',
      name: 'Are we a Controller, a Processor, or both?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most organisations are both — Controller for their own employees, customers, and marketing data; Processor for customer data they host or services they deliver. ISO 27701 explicitly handles this dual-role situation. As part of the engagement, we map every personal data flow in your ROPA and identify the role you play for each — so you apply the correct obligations without overreach or gaps.'
      }
    }
    ,
    {
      '@type': 'Question',
      name: 'Will ISO 27701 prepare us for an OAIC investigation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. ISO 27701 produces the documentation the OAIC looks for in a privacy investigation: a ROPA showing every personal data flow, DPIAs for high-risk processing, a data rights procedure, and evidence of active privacy management. It is not a legal shield, but it is the strongest evidence posture you can have before a regulator asks questions.'
      }
    },
    {
      '@type': 'Question',
      name: 'What if a DPIA identifies a risk we cannot fix?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A DPIA that finds no risks was probably not done properly. When a DPIA identifies a risk that cannot be fully mitigated, the response is documented residual risk acceptance — sign-off from appropriate leadership with a rationale. This is exactly what regulators and auditors expect. The goal is not zero risk; it is demonstrable, documented risk management.'
      }
    }
  ]
};
---

<Base
  title="ISO 27701 Privacy (PIMS) Australia — Built on ISO 27001 | Compliance365"
  description="ISO 27701 Privacy Information Management System for Australian organisations. Extends ISO 27001 in 6–10 weeks with DPIAs, ROPAs, rights handling, and third-party privacy controls. Delivered inside Microsoft 365."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <p class="eyebrow">ISO 27701 · Privacy · Australia</p>
          <h1>Add ISO 27701 privacy on top of your ISMS — in weeks, not months.</h1>
          <p class="section-lead muted">
            ISO 27701 extends ISO 27001 with privacy-specific controls. Same management system, same evidence pipeline, same audit cycle — with DPIAs (privacy impact assessments), ROPAs (records of processing activities), rights handling, and third-party privacy management layered on top. For organisations already ISO 27001 certified, we deliver it in 6–10 weeks.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">6–10 weeks</span>
            <span class="pill">Built on ISO 27001</span>
            <span class="pill">~40% less work</span>
            <span class="pill">Privacy Act aligned</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">Book a 30-min call</a>
            <a href={`${base}checklist/iso27701`} class="btn btn-outline">Free readiness assessment</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/iso27701-pims.svg`}
            alt="Integrated ISO 27001 + ISO 27701 management system showing shared risk register, policy framework, evidence pack, and audit infrastructure"
            style="display:block;width:100%;max-width:520px;height:auto;margin:0 auto;"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- THE PRIVACY ACT REFORM CONTEXT — urgency without being preachy -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">The Privacy Act reform changes the maths.</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto 3rem;">
        Privacy used to be a "nice to have" alongside security. The Privacy Act amendments rolling out through 2026 change that. Three specific shifts your board should understand.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature">
          <h3>Penalties up to $50m per breach</h3>
          <p class="muted small">
            The maximum penalty for serious or repeated privacy breaches is now the greater of $50m, three times the benefit derived, or 30% of adjusted turnover. The OAIC has clearly signalled it intends to use these powers. "We didn't know" is no longer a defence.
          </p>
        </div>
        <div class="card feature">
          <h3>Statutory tort for serious invasions</h3>
          <p class="muted small">
            A new statutory cause of action allows individuals to sue directly for serious invasions of privacy — without proving financial loss. This shifts privacy from a regulatory exposure to a civil litigation exposure, and the ones bringing the claims are plaintiff law firms, not regulators.
          </p>
        </div>
        <div class="card feature">
          <h3>Mandatory PIAs for high-risk processing</h3>
          <p class="muted small">
            Privacy Impact Assessments are becoming mandatory for high-risk processing activities — AI-enabled decision making, biometric processing, large-scale data analytics. Without a structured PIA process you're either non-compliant or relying on ad-hoc judgement that won't survive scrutiny.
          </p>
        </div>
      </div>

      <p class="muted center" style="margin-top:3rem;font-size:0.9rem;max-width:720px;margin-left:auto;margin-right:auto;">
        ISO 27701 is the most efficient framework for responding to all three pressures at once — and the only one that integrates cleanly with the security work you've already done.
      </p>
    </div>
  </section>

  <!-- THE SHARED INFRASTRUCTURE ARGUMENT -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why we build ISO 27701 on top of ISO 27001 — not as a separate project.</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto 3rem;">
        Most consultants treat privacy as a separate engagement from security. That doubles the work, doubles the audit overhead, and creates two parallel management systems your team has to maintain. ISO 27701 was designed to avoid this — we build the way the standard intends.
      </p>

      <div class="grid-2" style="max-width:960px;margin:0 auto;gap:2rem;align-items:stretch;">
        <div class="card" style="border:1px solid #e2e8f0;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#64748b;text-transform:uppercase;margin:0 0 0.5rem;">Common path</p>
          <h3 style="margin:0 0 1.25rem;">Privacy as a separate project</h3>
          <ul class="muted" style="padding-left:1.2rem;line-height:2;margin:0;">
            <li>Separate privacy risk register</li>
            <li>Separate privacy policy framework</li>
            <li>Separate evidence pack and audit cycle</li>
            <li>Two management systems to maintain</li>
            <li>Often a different consulting firm</li>
            <li>12–16 weeks even with ISO 27001 in place</li>
          </ul>
          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #e2e8f0;">
            <p style="margin:0;font-size:0.85rem;color:#64748b;">Result:</p>
            <p style="margin:0.25rem 0 0;font-size:1.1rem;font-weight:700;color:#0f172a;">Privacy bolt-on</p>
          </div>
        </div>

        <div class="card" style="border:2px solid #1e40af;background:#f0f9ff;">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#1e40af;text-transform:uppercase;margin:0 0 0.5rem;">Our approach</p>
          <h3 style="margin:0 0 1.25rem;color:#1e3a8a;">Integrated management system</h3>
          <ul class="muted" style="padding-left:1.2rem;line-height:2;margin:0;">
            <li>One risk register, security + privacy risks together</li>
            <li>Policies extended with privacy clauses</li>
            <li>One evidence pack, mapped to both standards</li>
            <li>One audit cycle, two certifications</li>
            <li>Same senior practitioner throughout</li>
            <li>6–10 weeks to add PIMS to existing ISMS</li>
          </ul>
          <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #bae6fd;">
            <p style="margin:0;font-size:0.85rem;color:#1e40af;">Result:</p>
            <p style="margin:0.25rem 0 0;font-size:1.1rem;font-weight:700;color:#1e3a8a;">~40% less total work</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">What's included in the engagement</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Every ISO 27701 engagement covers these six areas, mapped to your existing ISO 27001 management system where one exists.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature">
          <h3>ROPA &amp; data lifecycle</h3>
          <p class="muted small">
            A complete Record of Processing Activities — every personal data flow mapped with purpose, legal basis, retention, recipients, and Controller/Processor role. Built in SharePoint with automated retention and deletion workflows. The artefact procurement actually asks for.
          </p>
        </div>
        <div class="card feature">
          <h3>DPIA framework</h3>
          <p class="muted small">
            Privacy Impact Assessment methodology: screening triggers, full DPIA templates, routing and approval workflows, residual risk sign-off. Embedded in your daily processes — not a Word template no one fills out.
          </p>
        </div>
        <div class="card feature">
          <h3>Data subject rights handling</h3>
          <p class="muted small">
            Workflows for access, correction, erasure, restriction, objection, and portability requests. Tracked end-to-end with SLA monitoring. Evidence pack ready for OAIC enquiries or customer audits.
          </p>
        </div>
        <div class="card feature">
          <h3>Third-party privacy management</h3>
          <p class="muted small">
            Due diligence framework for new vendors, Data Processing Agreements (DPAs), sub-processor approval workflows, ongoing third-party monitoring, and breach notification clauses. Where most privacy programmes fall apart — and where ours holds together.
          </p>
        </div>
        <div class="card feature">
          <h3>Privacy training &amp; awareness</h3>
          <p class="muted small">
            Role-based privacy training delivered via Viva Learning or your existing platform. Onboarding modules, annual refreshers, evidenced completion. Auditors expect to see this — most organisations don't have it.
          </p>
        </div>
        <div class="card feature">
          <h3>Audit-ready evidence pack</h3>
          <p class="muted small">
            Every ISO 27701 control mapped to its evidence artefact in SharePoint. Privacy-specific dashboards in Power BI. Generated on demand for OAIC enquiries, customer privacy questionnaires, and external audits. Same infrastructure as your ISO 27001 evidence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTROLLER VS PROCESSOR — kept from original but tightened -->
  <section class="section">
    <div class="container">
      <h2 class="center">Controller, Processor, or both?</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        ISO 27701 separates privacy responsibilities into two roles. Most organisations are both — Controller for their own data, Processor for data they handle on customers' behalf. The obligations are different, and most consultancies get this confused.
      </p>

      <div class="grid-2" style="gap:2rem;margin-top:2.5rem;max-width:960px;margin-left:auto;margin-right:auto;">
        <div class="card">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#1e40af;text-transform:uppercase;margin:0 0 0.5rem;">Role 1</p>
          <h3 style="margin:0 0 1rem;">Controller</h3>
          <p class="muted small">
            You decide <em>why</em> and <em>how</em> personal data is collected and used. Examples: your own employee records, customer accounts, marketing databases, supplier contacts.
          </p>
          <p class="muted small" style="margin-top:1rem;font-weight:700;color:#0f172a;">Your obligations:</p>
          <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0;line-height:1.8;">
            <li>Transparency (privacy notices, consent management)</li>
            <li>Lawful basis for processing</li>
            <li>Honouring data subject rights requests</li>
            <li>Conducting DPIAs for high-risk processing</li>
            <li>Overseeing third-party Processors acting for you</li>
          </ul>
        </div>

        <div class="card">
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:1px;color:#1e40af;text-transform:uppercase;margin:0 0 0.5rem;">Role 2</p>
          <h3 style="margin:0 0 1rem;">Processor</h3>
          <p class="muted small">
            You handle personal data on behalf of a Controller. Examples: SaaS hosting customer data, payroll services, managed services delivering to a client.
          </p>
          <p class="muted small" style="margin-top:1rem;font-weight:700;color:#0f172a;">Your obligations:</p>
          <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0;line-height:1.8;">
            <li>Process only as documented and instructed</li>
            <li>Maintain confidentiality and security</li>
            <li>Get Controller approval before using sub-processors</li>
            <li>Assist Controllers with rights requests and breach notifications</li>
            <li>Maintain records of processing activities</li>
          </ul>
        </div>
      </div>

      <p class="muted center" style="margin-top:2rem;max-width:820px;margin-left:auto;margin-right:auto;font-size:0.9rem;">
        Part of the engagement is mapping every personal data flow in your ROPA and assigning the correct role. This is the foundation everything else builds on — most privacy programmes fail because this mapping was done sloppily or not at all.
      </p>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Who this is for</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        ISO 27701 is the right framework for Australian organisations in one of these situations:
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card">
          <h3>You're already ISO 27001 certified</h3>
          <p class="muted small">
            You have an ISMS, you have audit discipline, you have a senior practitioner relationship. Adding ISO 27701 on top is significantly cheaper and faster than starting from scratch — and consolidates your management system rather than fragmenting it.
          </p>
        </div>
        <div class="card">
          <h3>You handle large volumes of personal data</h3>
          <p class="muted small">
            Healthcare SaaS, fintech, edtech, HR-tech, marketing platforms. Your customers want evidence that personal data is governed properly. ISO 27701 is the credible structured answer that satisfies enterprise and government procurement.
          </p>
        </div>
        <div class="card">
          <h3>You're exposed to the Privacy Act reforms</h3>
          <p class="muted small">
            The penalty increases, statutory tort, and mandatory PIA obligations rolling out through 2026 raise the cost of inadequate privacy governance. ISO 27701 is the most defensible framework for showing you took it seriously before something went wrong.
          </p>
        </div>
        <div class="card">
          <h3>You sell into GDPR jurisdictions</h3>
          <p class="muted small">
            ISO 27701 maps closely to GDPR requirements. For Australian organisations supplying European customers, ISO 27701 is the most efficient way to demonstrate GDPR alignment without separate parallel certification.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section">
    <div class="container">
      <h2 class="center">A typical 8-week extension</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        For organisations already holding ISO 27001 certification. Combined ISO 27001 + ISO 27701 from scratch typically takes 14–18 weeks.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1–2</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Privacy scope</p>
          <p class="muted small">Personal data audit across the organisation. Initial ROPA mapping. Controller/Processor analysis. Gap assessment against ISO 27701 clauses.</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 3–5</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Build</p>
          <p class="muted small">Full ROPA, DPIA framework, rights handling workflows, third-party privacy management, training rollout. Extend ISO 27001 policies with privacy clauses.</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 6–7</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Evidence &amp; audit</p>
          <p class="muted small">Evidence pack mapped to both ISO 27001 and ISO 27701 controls. Internal privacy audit. Dress rehearsal for external audit.</p>
        </div>
        <div class="card feature center">
          <h3>Week 8+</h3>
          <p class="muted small" style="font-weight:600;color:#1e40af;">Certify</p>
          <p class="muted small">External certification audit. Single audit cycle covering both standards. Certificate issued on successful completion.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Common questions</h2>
      <p class="muted center" style="max-width:680px;margin:1.5rem auto;">
        Answered plainly. If you have a question not covered here, the fastest way to get a real answer is a 30-min call.
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card">
          <h3>Can we do ISO 27701 without ISO 27001?</h3>
          <p class="muted small">
            No — ISO 27701 is an extension of ISO 27001 and requires an underlying ISMS. If you don't have ISO 27001, we deliver both together (14–18 weeks) which is still significantly cheaper than sequential delivery.
          </p>
        </div>
        <div class="card">
          <h3>How long does it take?</h3>
          <p class="muted small">
            6–10 weeks to add ISO 27701 to an existing ISO 27001 certification. 14–18 weeks for combined delivery from scratch.
          </p>
        </div>
        <div class="card">
          <h3>What does it cost?</h3>
          <p class="muted small">
            Fixed-price, $15k–$60k as an extension to existing ISO 27001 (depending on company size). $40k–$160k for combined ISO 27001 + ISO 27701 from scratch. Certification body fees are separate.
          </p>
        </div>
        <div class="card">
          <h3>Does this satisfy the Australian Privacy Act?</h3>
          <p class="muted small">
            ISO 27701 maps directly to the Australian Privacy Principles and provides a structured framework for demonstrating Privacy Act compliance — including the reforms rolling out through 2026. It's not a substitute for legal advice on specific cases, but it's the most credible evidence framework regulators recognise.
          </p>
        </div>
        <div class="card">
          <h3>Do we need OneTrust or a privacy platform?</h3>
          <p class="muted small">
            No. We build inside your existing M365 environment — SharePoint, Power Automate, Purview, Teams. Privacy platforms have a place at enterprise scale, but mid-market organisations rarely need them. M365-native is faster, cheaper, and avoids ongoing licence costs.
          </p>
        </div>
        <div class="card">
          <h3>Are we a Controller, Processor, or both?</h3>
          <p class="muted small">
            Most organisations are both. We map every personal data flow in your ROPA and assign the correct role — so you apply the right obligations without overreach or gaps. Getting this right is foundational; getting it wrong creates compliance debt that surfaces in audits.
          </p>
        </div>
        <div class="card">
          <h3>Will this prepare us for an OAIC investigation?</h3>
          <p class="muted small">
            Yes. ISO 27701 implementation produces the documentation the OAIC looks for in a privacy investigation — a ROPA showing every personal data flow, DPIAs for high-risk processing, a data rights handling procedure, and evidence that privacy obligations are being managed actively. It's not a legal shield, but it is the strongest evidence posture you can have before a regulator asks questions.
          </p>
        </div>
        <div class="card">
          <h3>What if a DPIA identifies a risk we can't fix?</h3>
          <p class="muted small">
            A DPIA that finds no risks was probably not done properly. When a DPIA identifies a risk that can't be fully mitigated, the response is documented residual risk acceptance — sign-off from appropriate leadership with a rationale. This is exactly what regulators and auditors expect. The goal is not zero risk; it is demonstrable, documented risk management.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section">
    <div class="container center">
      <h2>Related frameworks</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        ISO 27701 builds on ISO 27001 and integrates with ISO 42001. Most clients deliver these as a single combined management system.
      </p>

      <div class="pill-row" style="justify-content:center;flex-wrap:wrap;">
        <a class="pill" href={`${base}services/iso27001`}>ISO 27001 (Information Security)</a>
        <a class="pill" href={`${base}services/iso42001`}>ISO 42001 (AI Governance)</a>
        <a class="pill" href={`${base}services/soc2`}>SOC 2 Type II</a>
        <a class="pill" href={`${base}services/essential-eight`}>Essential Eight</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Ready to extend your ISMS into a PIMS?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:680px;margin:1.5rem auto;">
        A free 30-minute call will scope your situation — what you have, what you need, what it would cost. If you'd be better off delivering ISO 27001 and ISO 27701 together, we'll tell you. No sales pitch.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.1rem;padding:1rem 2.5rem;">
          Book a free 30-min call
        </a>
