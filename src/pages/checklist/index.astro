---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import { CHECKLISTS } from '../../data/checklists.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const count = CHECKLISTS.length;
const countWord = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'][count] || String(count);

/* The page is laid out so the choice comes first: every checklist is listed
   in the hero, and the "which one is right for me?" help sits with the
   checklist cards rather than in a separate section further down. The
   situation chips are plain links to the matching card (#ck-<slug>), which
   :target highlights, so they need no script. */

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free Compliance Readiness Checklists',
  url: 'https://www.compliance365.com.au/checklist/',
  description: 'Free interactive readiness checklists for ISO 27001, ISO 27701, ISO 42001, SOC 2, Essential Eight, DISP/ISM/IRAP and IS18. Score your readiness in about 15 minutes and get a prioritised PDF roadmap.',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
};

const faqs = [
  {
    q: 'Are these checklists really free?',
    a: 'Yes. There is no payment, no account and no sales call. At the end we ask for your name, organisation and email so we can give you the PDF report.',
  },
  {
    q: 'What happens to my answers?',
    a: `When you request your report, your answers, score and details are sent to our team so we can follow up if you would like help. We don't sell or share them. Follow-up emails about your results are opt-in. See our <a href="${base}privacy/">privacy policy</a>.`,
  },
  {
    q: 'How accurate is the score?',
    a: "It is an honest indicator based on your answers, calibrated against the framework's published criteria. It is not a substitute for a formal gap assessment, but it shows where you stand and which gaps matter most.",
  },
  {
    q: 'What if our score is low?',
    a: 'A low score is a starting point, not a problem. Most organisations score 40–60% on their first run. The report lists the highest-impact gaps first, so it becomes a plan rather than an overwhelming list.',
  },
  {
    q: 'Can several people answer together?',
    a: 'Yes. Many teams go through it together, with the security lead, IT lead and a senior stakeholder. It often surfaces different views on what is actually in place.',
  },
  {
    q: 'Can we share the PDF internally?',
    a: 'Yes. The report is designed to be shared with leadership, the board or a security committee, and many organisations use it to get budget approved for the work.',
  },
];
---

<Base
  title="Free Compliance Readiness Checklists | Compliance365"
  description="Free readiness checklists for ISO 27001, ISO 42001, SOC 2, Essential Eight, IS18 and DISP/IRAP. Score your readiness in about 15 minutes and get a prioritised PDF roadmap."
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO: the choice comes first -->
  <section class="svc-hero ck-hero">
    <CinematicBackground static />
    <div class="ck-hero-grid">
      <div class="svc-hero-copy">
        <p class="eyebrow">Free readiness checklists</p>
        <h1>Score your compliance readiness in 15 minutes</h1>
        <p class="section-lead">
          {countWord} free checklists, each scored against the framework's published criteria. Pick one, answer Yes, Partial or No, and get your score with a prioritised PDF roadmap.
        </p>
        <ul class="ck-facts">
          <li>Free, no account or call needed</li>
          <li>Just your email for the report</li>
          <li>Takes 10–16 minutes</li>
        </ul>
        <p class="ck-help"><a href="#choose">Not sure which one? Start from your situation ↓</a></p>
      </div>

      <div class="ck-picker band-light" aria-labelledby="ck-picker-title">
        <p class="ck-picker-title" id="ck-picker-title">Choose a checklist</p>
        <ul>
          {CHECKLISTS.map((c) => (
            <li>
              <a href={`${base}checklist/${c.slug}/`} class="ck-row">
                <span class="ck-row-main">
                  <span class="ck-row-name">{c.title}{c.popular && <span class="ck-tag">Popular</span>}</span>
                  <span class="ck-row-sub">{c.subtitle}</span>
                </span>
                <span class="ck-row-meta">{c.questions} questions · {c.time}</span>
                <span class="ck-row-go" aria-hidden="true">Start →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: three steps, honest about the email -->
  <section class="ck-steps-band band-light" aria-label="How it works">
    <div class="container">
      <ol class="ck-steps">
        <li><span class="ck-step-n">1</span><span><strong>Answer the questions</strong> Yes, Partial or No, one section at a time.</span></li>
        <li><span class="ck-step-n">2</span><span><strong>Add your email</strong> so we can give you the report. No account needed.</span></li>
        <li><span class="ck-step-n">3</span><span><strong>Get your score and PDF</strong> with your top gaps and what to do first.</span></li>
      </ol>
    </div>
  </section>

  <!-- WHICH ONE: situations and checklists together -->
  <section class="section ck-choose" id="choose">
    <div class="container">
      <h2 class="center">Which checklist is right for you?</h2>
      <p class="muted center ck-lead">Pick the situation closest to yours, or read the cards below.</p>

      <nav class="ck-chips" aria-label="Choose by situation">
        {CHECKLISTS.map((c) => (
          <a href={`#ck-${c.slug}`} class="ck-chip">{c.chip}</a>
        ))}
      </nav>

      <div class="ck-cards">
        {CHECKLISTS.map((c) => (
          <article class="ck-card band-light" id={`ck-${c.slug}`}>
            <div class="ck-card-top">
              <div>
                <p class="ck-card-sub" set:html={c.subtitle} />
                <h3>{c.title}</h3>
              </div>
              <span class="ck-card-meta"><span>{c.questions} questions</span> <span>{c.time}</span></span>
            </div>
            <p class="ck-card-why"><strong>Choose this if:</strong> {c.chooseIf}</p>
            <p class="ck-card-desc" set:html={c.desc} />
            <a href={`${base}checklist/${c.slug}/`} class="ck-card-btn">Start the {c.title} checklist →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT YOUR REPORT LOOKS LIKE -->
  <section class="section ck-report" style="background:#FAF7F1;">
    <div class="container ck-report-grid">
      <div class="ck-sample band-light" aria-hidden="true">
        <div class="ck-sample-head">
          <span class="ck-sample-logo">365</span>
          <span>
            <span class="ck-sample-kicker">Sample report</span>
            <span class="ck-sample-name">ISO 27001 Readiness Assessment</span>
          </span>
        </div>
        <div class="ck-sample-score">
          <span class="ck-sample-kicker">Overall readiness score</span>
          <span class="ck-sample-pct">68%</span>
          <span class="ck-sample-band">Foundation — needs structured uplift</span>
        </div>
        <div class="ck-sample-bars">
          <div><span>ISMS Scope &amp; Context</span><b style="color:#046A4E;">85%</b></div>
          <i><em style="width:85%;background:#046A4E;"></em></i>
          <div><span>Risk Management</span><b style="color:#A63A12;">62%</b></div>
          <i><em style="width:62%;background:#A63A12;"></em></i>
          <div><span>Annex A Controls</span><b style="color:#9B1C2E;">45%</b></div>
          <i><em style="width:45%;background:#9B1C2E;"></em></i>
        </div>
        <p class="ck-sample-more">Plus every area, your top gaps and prioritised next steps</p>
      </div>

      <div>
        <h2>What your report looks like</h2>
        <p class="muted">A branded PDF you can share with your team, board or auditor.</p>
        <ul class="ck-ticks">
          <li><strong>Overall score and readiness band</strong>, with how many controls are in place, partly in place and missing.</li>
          <li><strong>A score for every area</strong> of the framework, with your strongest and weakest called out.</li>
          <li><strong>Every gap, in priority order</strong>, with why it matters and what an auditor will expect to see.</li>
          <li><strong>Practical next steps</strong> and the option of a free call to talk your results through.</li>
        </ul>
        <p class="ck-method">Built from each standard's published criteria: ASD's evidence requirements for Essential Eight, ISO 27001:2022 Annex A, the AICPA Trust Services Criteria for SOC 2 and the ISO 42001:2023 clauses.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container ck-faq">
      <h2 class="center">Common questions</h2>
      {faqs.map((f) => (
        <details class="ck-faq-item band-light">
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Need help interpreting your results?</h2>
      <p>
        After running a checklist, a free 30-minute call will help you make sense of the score, prioritise the gaps that matter most, and understand what a realistic uplift programme would look like for your environment.
      </p>
      <div class="final-buttons">
        <a href="#main-content" class="btn-hdk-primary">Choose a checklist</a>
        <a href={ctaUrl} class="btn-hdk-ghost" target="_blank" rel="noopener">Book a free call</a>
      </div>
    </div>
  </section>

  </main>

  <Footer />

  <style>
    /* Hero */
    .ck-hero { padding: 6rem 0 4.5rem; }
    .ck-hero-grid {
      position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 470px);
      gap: clamp(28px, 4vw, 56px); align-items: center; max-width: 1120px; margin: 0 auto; padding: 0 22px;
    }
    .ck-facts { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; margin: 1.25rem 0 0; padding: 0; }
    .ck-facts li { display: flex; align-items: center; gap: .5rem; margin: 0; color: #FAF7F1; font-size: .9rem; font-weight: 600; }
    .ck-facts li::before { content: '\2713'; display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; background: #BE4A1E; color: var(--on-accent); font-size: 10px; font-weight: 900; }
    .svc-hero-copy .ck-help { margin-top: 1.5rem; }
    .ck-help a { color: #F0A97F; font-weight: 700; text-decoration: none; border-bottom: 1px solid rgba(240,169,127,.4); }
    .ck-help a:hover { border-bottom-color: #F0A97F; }

    .ck-picker { background: #fff; border-radius: 14px; box-shadow: 0 18px 50px rgba(0,0,0,.35); padding: .5rem 0; }
    .ck-picker-title { margin: 0; padding: .85rem 1.25rem .6rem; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.4px; color: #6B6860; }
    .ck-picker ul { list-style: none; margin: 0; padding: 0; }
    .ck-picker li { margin: 0; border-top: 1px solid #F0EBE2; }
    .ck-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: .75rem; padding: .8rem 1.25rem; text-decoration: none; color: #0B0B0C; transition: background .15s; }
    .ck-row:hover, .ck-row:focus-visible { background: #FAF3EC; }
    .ck-row-main { display: flex; flex-direction: column; min-width: 0; }
    .ck-row-name { font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: .5rem; }
    .ck-row-sub { font-size: .78rem; color: #6B6860; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ck-row-meta { font-size: .75rem; color: #6B6860; white-space: nowrap; }
    .ck-row-go { font-size: .85rem; font-weight: 800; color: #A63A12; white-space: nowrap; }
    .ck-tag { font-size: .6rem; font-weight: 800; text-transform: uppercase; letter-spacing: .8px; background: #BE4A1E; color: var(--on-accent); padding: 2px 7px; border-radius: 10px; }

    /* Steps */
    .ck-steps-band { background: #FAF7F1; border-bottom: 1px solid #DDD8CF; padding: 1.75rem 0; }
    .ck-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
    .ck-steps li { display: flex; gap: .85rem; align-items: flex-start; margin: 0; color: #57534B; font-size: .92rem; line-height: 1.5; }
    .ck-steps strong { display: block; color: #0B0B0C; font-size: 1rem; }
    .ck-step-n { flex: none; width: 32px; height: 32px; border-radius: 50%; background: #BE4A1E; color: var(--on-accent); font-weight: 800; display: inline-flex; align-items: center; justify-content: center; }

    /* Which one */
    .ck-lead { max-width: 640px; margin: 1rem auto 0; }
    .ck-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin: 2rem auto 2.5rem; max-width: 900px; }
    .ck-chip { padding: .55rem 1rem; border-radius: 999px; border: 1.5px solid #DDD8CF; background: #fff; color: #3A3632; font-size: .88rem; font-weight: 700; text-decoration: none; transition: border-color .15s, background .15s; }
    .ck-chip:hover, .ck-chip:focus-visible { border-color: #BE4A1E; background: #FAF3EC; }
    .ck-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    .ck-card { background: #fff; border: 1px solid #DDD8CF; border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; scroll-margin-top: 100px; transition: border-color .2s, box-shadow .2s; }
    .ck-card:target { border-color: #BE4A1E; box-shadow: 0 0 0 3px rgba(190,74,30,.25); }
    .ck-card-top { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
    .ck-card-sub { margin: 0 0 .25rem; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #6B6860; }
    .ck-card h3 { margin: 0; font-size: 1.3rem; color: #0B0B0C; }
    .ck-card-meta { font-size: .78rem; color: #6B6860; text-align: right; white-space: nowrap; line-height: 1.5; }
    .ck-card-meta span { display: block; }
    .ck-card-why { margin: 1rem 0 .5rem; color: #0B0B0C; font-size: .93rem; line-height: 1.55; }
    .ck-card-desc { margin: 0 0 1.25rem; color: #57534B; font-size: .88rem; line-height: 1.6; flex: 1; }
    .ck-card-btn { align-self: flex-start; background: #BE4A1E; color: var(--on-accent); border-radius: 10px; padding: .75rem 1.15rem; font-weight: 700; font-size: .92rem; text-decoration: none; }
    .ck-card-btn:hover { background: #A63A12; }

    /* Report */
    .ck-report-grid { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
    .ck-report h2 { margin-top: 0; }
    .ck-sample { background: #fff; border: 1px solid #DDD8CF; border-radius: 12px; box-shadow: 0 8px 32px rgba(15,23,42,.1); padding: 1.5rem; }
    .ck-sample-head { display: flex; align-items: center; gap: .75rem; padding-bottom: .75rem; border-bottom: 1px solid #F5F0E8; }
    .ck-sample-head > span:last-child { display: flex; flex-direction: column; }
    .ck-sample-logo { width: 36px; height: 36px; background: #BE4A1E; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: var(--on-accent); font-weight: 800; font-size: .85rem; }
    .ck-sample-kicker { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #6B6860; }
    .ck-sample-name { font-weight: 700; color: #0B0B0C; font-size: .95rem; }
    .ck-sample-score { display: flex; flex-direction: column; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid #F5F0E8; }
    .ck-sample-pct { font-size: 3rem; font-weight: 800; color: #A63A12; line-height: 1.1; }
    .ck-sample-band { font-size: .85rem; color: #6B6860; }
    .ck-sample-bars { display: flex; flex-direction: column; gap: .35rem; padding-top: 1rem; font-size: .8rem; }
    .ck-sample-bars div { display: flex; justify-content: space-between; color: #57534B; margin-top: .3rem; }
    .ck-sample-bars i { display: block; height: 6px; background: #F5F0E8; border-radius: 3px; overflow: hidden; }
    .ck-sample-bars em { display: block; height: 100%; }
    .ck-sample-more { margin: 1rem 0 0; font-size: .72rem; color: #6B6860; text-align: center; }
    .ck-ticks { list-style: none; padding: 0; margin: 1.25rem 0; display: grid; gap: .8rem; }
    .ck-ticks li { position: relative; padding-left: 1.75rem; margin: 0; line-height: 1.55; color: var(--text-subtle); }
    .ck-ticks li::before { content: '\2713'; position: absolute; left: 0; top: .1rem; color: #046A4E; font-weight: 900; }
    .ck-ticks strong { color: var(--text); }
    .ck-method { font-size: .82rem; color: var(--text-muted); border-left: 3px solid #BE4A1E; padding-left: .9rem; margin: 1.5rem 0 0; }

    /* FAQ */
    .ck-faq { max-width: 820px; }
    .ck-faq h2 { margin-bottom: 2rem; }
    .ck-faq-item { background: #fff; border: 1px solid #DDD8CF; border-radius: 12px; margin-bottom: .75rem; }
    .ck-faq-item summary { cursor: pointer; padding: 1.1rem 1.35rem; font-weight: 700; color: #0B0B0C; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
    .ck-faq-item summary::-webkit-details-marker { display: none; }
    .ck-faq-item summary::after { content: '+'; color: #A63A12; font-size: 1.3rem; line-height: 1; }
    .ck-faq-item[open] summary::after { content: '\2212'; }
    .ck-faq-item p { margin: 0; padding: 0 1.35rem 1.2rem; color: #57534B; line-height: 1.65; }
    .ck-faq-item p :global(a) { color: #A63A12; }

    @media (max-width: 900px) {
      .ck-hero { padding: 5rem 0 3rem; }
      .ck-hero-grid { grid-template-columns: minmax(0, 1fr); }
      .ck-cards { grid-template-columns: minmax(0, 1fr); }
      .ck-report-grid { grid-template-columns: minmax(0, 1fr); }
      .ck-sample { max-width: 420px; width: 100%; margin: 0 auto; }
    }
    @media (max-width: 640px) {
      .ck-steps { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
      .ck-row { grid-template-columns: minmax(0, 1fr) auto; padding: .8rem 1rem; }
      .ck-row-meta { display: none; }
      .ck-chips { justify-content: flex-start; }
      .ck-card-top { flex-direction: column; gap: .4rem; }
      .ck-card-meta { text-align: left; }
      .ck-card-meta span { display: inline; }
      .ck-card-meta span + span::before { content: '· '; }
      .ck-card-btn { align-self: stretch; text-align: center; }
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />
</Base>
