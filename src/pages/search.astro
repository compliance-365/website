---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
---

<BaseLayout
  title="Search | Compliance365"
  description="Search ISO 27001, SOC 2, Essential Eight, AI governance, and privacy compliance content by Compliance365."
  robots="noindex,follow">

  <Header />

  <main id="main-content" tabindex="-1">

  <section class="container section" style="max-width:760px;">
    <h1>Search Compliance365</h1>
    <p class="muted" style="margin-bottom:1.5rem;">
      Find guidance on ISO 27001, SOC 2, Essential Eight, AI governance, and more.
    </p>
    <input
      id="searchInput"
      type="search"
      placeholder="Search — e.g. ISO 27001, SOC 2, DPIA…"
      aria-label="Search Compliance365"
      style="width:100%;padding:12px 16px;border-radius:10px;border:1px solid rgba(10,18,32,0.15);font-size:0.95rem;margin-bottom:1.5rem;"
    />
    <div id="results"></div>
  </section>

  </main>

  <Footer />

  <script src="/assets/fuse.min.js" defer></script>

  <script is:inline>
    const pages = [
      { title: 'ISO 27001 — Information Security Management', url: '/services/iso27001/', description: 'Implement ISO 27001 with automation and SharePoint integration.' },
      { title: 'ISO 27701 — Privacy Information Management', url: '/services/iso27701/', description: 'Extend ISO 27001 with privacy workflows and GDPR alignment.' },
      { title: 'ISO 42001 — AI Management Systems', url: '/services/iso42001/', description: 'Manage AI transparency, bias, and accountability using ISO 42001.' },
      { title: 'SOC 2 — Trust Service Criteria', url: '/services/soc2/', description: 'Achieve faster SOC 2 readiness with audit automation in Microsoft 365.' },
      { title: 'Essential Eight Uplift', url: '/services/essential-eight/', description: 'Implement the Essential Eight controls for patching, MFA, backups, and app control.' },
      { title: 'NIST Cybersecurity Framework', url: '/services/nist-csf/', description: 'Align with NIST CSF — Identify, Protect, Detect, Respond, Recover — mapped to ISO 27001 and Essential Eight.' },
      { title: 'DISP, ISM & IRAP', url: '/services/disp-ism-irap/', description: 'Defence uplift, ISM alignment, and IRAP readiness with Microsoft automation.' },
      { title: 'About Compliance365', url: '/about/', description: 'Senior-led, fixed-price cyber, privacy, and AI governance consulting based in Brisbane.' },
      { title: 'How We Work — The ComplianceReady System', url: '/how-we-work/', description: '4-phase methodology delivering ISO 27001, SOC 2, Essential Eight and ISO 42001 in typically 8–14 weeks.' },
      { title: 'Free Readiness Checklists', url: '/checklist/', description: 'Interactive readiness checklists for ISO 27001, SOC 2, Essential Eight, ISO 42001, ISO 27701, and IRAP.' },
      { title: 'Resources & Guides', url: '/resources/', description: 'Deep-dive guides on AI governance, SOA, ROPA, cost analysis, and compliance automation.' },
      { title: 'Compliance Insights Blog', url: '/blog/', description: 'Practical, audit-ready guidance on ISO 27001, Essential Eight, SOC 2, ISO 42001, and ISO 27701.' },
      { title: 'Case Studies', url: '/case-studies/', description: 'Real-world compliance outcomes for SaaS, healthcare, government, and defence organisations.' },
      { title: 'Book a Call', url: '/book/', description: 'Book a free 30-minute scoping call with a senior compliance practitioner.' },
      { title: 'Contact Compliance365', url: '/contact/', description: 'Get in touch via email, Microsoft Teams, WhatsApp, or the contact form.' },
    ];

    window.addEventListener('load', function () {
      if (typeof Fuse === 'undefined') return;
      const fuse = new Fuse(pages, { keys: ['title', 'description'], threshold: 0.3 });
      const input = document.getElementById('searchInput');
      const resultsDiv = document.getElementById('results');

      input.addEventListener('input', function (e) {
        const query = e.target.value.trim();
        const results = query ? fuse.search(query) : [];
        resultsDiv.innerHTML = results.length
          ? results.map(function (r) {
              return '<a href="' + r.item.url + '" class="card" style="display:block;text-decoration:none;margin-bottom:1rem;">'
                + '<h2 style="margin:0 0 .25rem;font-size:1rem;color:#A9812E;">' + r.item.title + '</h2>'
                + '<p class="muted small" style="margin:0;">' + r.item.description + '</p>'
                + '</a>';
            }).join('')
          : (query ? '<p class="muted">No results found.</p>' : '');
      });
    });
  </script>

</BaseLayout>
