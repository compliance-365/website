---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import EssentialsAlert from '../../components/EssentialsAlert.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const e8mm = 'https://www.cyber.gov.au/business-government/asds-cyber-security-frameworks/essential-eight/essential-eight-maturity-model';

// ASD's own mapping, from the Essentials for enterprise IT Assessment
// Workbook (October 2026): for each strategy, the Essentials actions and
// domains its ISM controls are mapped to, and how many ISM controls that is.
// Action wording is ASD's (the chapter, CC BY 4.0). The Maturity Level Two
// summaries, evidence and Microsoft 365 notes are ours.
const DOMAINS = {"gov": "Governance and culture", "vis": "Visibility and response", "bnd": "Boundary services", "idn": "Identity services", "crt": "Critical processes and services", "prv": "Privileged environments", "bus": "Business systems", "usr": "User devices"};
const strategies = [
  { name: "Patch applications", ism: 11,
    asd: [{"id": "IT.DET-05.1", "t": "Review detection coverage periodically to identify gaps arising from new assets, services or architectural changes.", "p": "DET-05", "d": ["vis"]}, {"id": "IT.IDE-01.1", "t": "Use an approved asset inventory mechanism that supports automated discovery to detect new and changed physical and non-physical assets.", "p": "IDE-01", "d": ["vis"]}, {"id": "IT.PRO-06.1", "t": "Identify known software and configuration weaknesses of assets through continuous and repeatable assessment activities, including vulnerability scanning activities.", "p": "PRO-06", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.PRO-06.2", "t": "Apply security patches or updates within defined risk-based timeframes or automatically where operational impact is low.", "p": "PRO-06", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.PRO-06.3", "t": "Remediate or mitigate vulnerabilities exceeding defined risk thresholds within defined timeframes based on exploitation, exposure, criticality, impact and compensating controls, and verify treatment effectiveness.", "p": "PRO-06", "d": ["bnd", "crt", "bus", "usr"]}],
    ml2: 'Internet-facing services patched within two weeks, or 48 hours if an exploit exists; office suites, browsers, email clients, PDF and security software within two weeks; other applications within one month; vulnerability scanning on a schedule; unsupported applications removed.',
    evidence: 'Time to patch per asset group against the target, and how many assets are outside it.',
    m365: 'Defender Vulnerability Management exposure and remediation reports.' },
  { name: "Patch operating systems", ism: 16,
    asd: [{"id": "IT.DET-05.1", "t": "Review detection coverage periodically to identify gaps arising from new assets, services or architectural changes.", "p": "DET-05", "d": ["vis"]}, {"id": "IT.GOV-14.1", "t": "Establish and maintain a process for identifying, assessing and treating cyber security risks associated with legacy systems and unsupported technologies through compensating controls, enhanced monitoring and assurance until the systems can be removed or replaced.", "p": "GOV-14", "d": ["gov"]}, {"id": "IT.IDE-01.1", "t": "Use an approved asset inventory mechanism that supports automated discovery to detect new and changed physical and non-physical assets.", "p": "IDE-01", "d": ["vis"]}, {"id": "IT.PRO-06.1", "t": "Identify known software and configuration weaknesses of assets through continuous and repeatable assessment activities, including vulnerability scanning activities.", "p": "PRO-06", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.PRO-06.2", "t": "Apply security patches or updates within defined risk-based timeframes or automatically where operational impact is low.", "p": "PRO-06", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.PRO-06.3", "t": "Remediate or mitigate vulnerabilities exceeding defined risk thresholds within defined timeframes based on exploitation, exposure, criticality, impact and compensating controls, and verify treatment effectiveness.", "p": "PRO-06", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}],
    ml2: 'Internet-facing servers and network devices patched within two weeks, or 48 hours if an exploit exists; workstations and other servers within one month; unsupported operating systems replaced.',
    evidence: 'Time to patch for operating systems, plus the count of unsupported versions.',
    m365: 'Intune update rings and feature update reports; Defender device inventory.' },
  { name: "Multi-factor authentication", ism: 23,
    asd: [{"id": "IT.DET-01.1", "t": "Protect event logs from unauthorised access, modification or deletion, including by encrypting them during transit and at rest and securing the systems and accounts used to store, manage and analyse them.", "p": "DET-01", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.DET-01.2", "t": "Forward high-value, security-relevant event logs and configuration changes from infrastructure, operating systems and applications to a central log storage capability.", "p": "DET-01", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.DET-01.3", "t": "Establish a centralised event log storage capability that protects logs from unauthorised access or modification.", "p": "DET-01", "d": ["vis"]}, {"id": "IT.DET-02.2", "t": "Ensure detection logic identifies unauthorised changes, anomalous authentication activity and suspicious software execution.", "p": "DET-02", "d": ["vis"]}, {"id": "IT.DET-03.1", "t": "Triage alerts and events in a timely manner to determine whether cyber security incident thresholds have been met.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-03.2", "t": "Use indicators from across identities, applications, data and infrastructure activity rather than isolated signals when identifying cyber security incidents.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-04.1", "t": "Continuously monitor and analyse software execution behaviour on systems to detect where legitimate tools and utilities are being used for malicious purposes.", "p": "DET-04", "d": ["bnd", "idn", "crt", "prv"]}, {"id": "IT.PRO-13.2", "t": "Store authentication keys, secrets and tokens in approved secure repositories with access controls, including MFA.", "p": "PRO-13", "d": ["bnd", "crt", "bus"]}, {"id": "IT.PRO-13.4", "t": "Use phishing-resistant MFA for users authenticating to systems, including from untrusted, external or high-risk locations.", "p": "PRO-13", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.RES-03.1", "t": "Use documented, tested and approved cyber security incident response procedures when responding to cyber security incidents.", "p": "RES-03", "d": ["vis"]}, {"id": "IT.RES-05.1", "t": "Integrate external coordination obligations into cyber security incident response activities where required.", "p": "RES-05", "d": ["vis"]}],
    ml2: 'MFA for users of online services and for privileged users, with stronger requirements on the methods accepted (see the maturity model for the exact wording).',
    evidence: 'Share of sign-ins covered, accounts excluded and why, failed and blocked attempts.',
    m365: 'Entra Conditional Access, authentication methods and sign-in logs.' },
  { name: "Restrict administrative privileges", ism: 23,
    asd: [{"id": "IT.DET-01.1", "t": "Protect event logs from unauthorised access, modification or deletion, including by encrypting them during transit and at rest and securing the systems and accounts used to store, manage and analyse them.", "p": "DET-01", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.DET-01.2", "t": "Forward high-value, security-relevant event logs and configuration changes from infrastructure, operating systems and applications to a central log storage capability.", "p": "DET-01", "d": ["bnd", "idn", "crt", "prv"]}, {"id": "IT.DET-01.3", "t": "Establish a centralised event log storage capability that protects logs from unauthorised access or modification.", "p": "DET-01", "d": ["vis"]}, {"id": "IT.DET-02.2", "t": "Ensure detection logic identifies unauthorised changes, anomalous authentication activity and suspicious software execution.", "p": "DET-02", "d": ["vis"]}, {"id": "IT.DET-03.1", "t": "Triage alerts and events in a timely manner to determine whether cyber security incident thresholds have been met.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-03.2", "t": "Use indicators from across identities, applications, data and infrastructure activity rather than isolated signals when identifying cyber security incidents.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-04.1", "t": "Continuously monitor and analyse software execution behaviour on systems to detect where legitimate tools and utilities are being used for malicious purposes.", "p": "DET-04", "d": ["bnd", "idn", "crt", "prv"]}, {"id": "IT.PRO-01.1", "t": "Design systems securely to provide visibility, enforce authorised access, protect data, minimise required and default privileges, limit exposed services and remove unnecessary functionality.", "p": "PRO-01", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.PRO-05.1", "t": "Ensure administrative activities can only be performed from dedicated and hardened environments that are isolated from unprivileged user workloads.", "p": "PRO-05", "d": ["bnd", "idn", "crt", "prv"]}, {"id": "IT.PRO-05.2", "t": "Enforce explicit session establishment controls before privileged actions are permitted, including the use of time-bound privilege grants.", "p": "PRO-05", "d": ["prv"]}, {"id": "IT.PRO-05.3", "t": "Record all administrative or management actions that modify systems, configurations or controls including the details of the user, timestamp and target.", "p": "PRO-05", "d": ["idn", "prv"]}, {"id": "IT.PRO-07.2", "t": "Restrict administrative and management tooling to approved software sets and executed from only authorised, known locations.", "p": "PRO-07", "d": ["prv"]}, {"id": "IT.PRO-12.1", "t": "Periodically review and update access privileges in alignment with current roles, duties and business requirements.", "p": "PRO-12", "d": ["idn", "prv"]}, {"id": "IT.PRO-12.2", "t": "Grant only authorised administrative roles permissions to create, modify or delete accounts and roles, and access privileged functions or applications.", "p": "PRO-12", "d": ["prv"]}, {"id": "IT.PRO-12.3", "t": "Provision user, administrative and non-person accounts with only the minimum access and privileges required to perform defined operational functions.", "p": "PRO-12", "d": ["idn", "prv"]}, {"id": "IT.PRO-13.1", "t": "Identify and disable or remove default and unused accounts regularly, permitting exceptions only where the account is documented, justified, hardened and monitored.", "p": "PRO-13", "d": ["idn", "prv"]}, {"id": "IT.PRO-13.6", "t": "Ensure that user, machine, system and service account credentials are unique per system or account, particularly in high-privilege contexts.", "p": "PRO-13", "d": ["idn", "prv"]}, {"id": "IT.PRO-18.2", "t": "Limit lateral movement between, and within, network segments to explicitly approved pathways and services, based on business requirements and trust levels.", "p": "PRO-18", "d": ["prv"]}, {"id": "IT.RES-03.1", "t": "Use documented, tested and approved cyber security incident response procedures when responding to cyber security incidents.", "p": "RES-03", "d": ["vis"]}, {"id": "IT.RES-05.1", "t": "Integrate external coordination obligations into cyber security incident response activities where required.", "p": "RES-05", "d": ["vis"]}],
    ml2: 'Access validated when requested and revalidated; privileged accounts cannot use web or email; privileged access removed after inactivity; separate privileged environments; unique local administrator passwords; privileged events logged.',
    evidence: 'Count of standing admin accounts, stale accounts removed, logged elevations.',
    m365: 'Entra Privileged Identity Management, access reviews, Windows LAPS, Defender for Identity.' },
  { name: "Application control", ism: 18,
    asd: [{"id": "IT.DET-01.1", "t": "Protect event logs from unauthorised access, modification or deletion, including by encrypting them during transit and at rest and securing the systems and accounts used to store, manage and analyse them.", "p": "DET-01", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.DET-01.2", "t": "Forward high-value, security-relevant event logs and configuration changes from infrastructure, operating systems and applications to a central log storage capability.", "p": "DET-01", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.DET-01.3", "t": "Establish a centralised event log storage capability that protects logs from unauthorised access or modification.", "p": "DET-01", "d": ["vis"]}, {"id": "IT.DET-02.2", "t": "Ensure detection logic identifies unauthorised changes, anomalous authentication activity and suspicious software execution.", "p": "DET-02", "d": ["vis"]}, {"id": "IT.DET-03.1", "t": "Triage alerts and events in a timely manner to determine whether cyber security incident thresholds have been met.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-03.2", "t": "Use indicators from across identities, applications, data and infrastructure activity rather than isolated signals when identifying cyber security incidents.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-04.1", "t": "Continuously monitor and analyse software execution behaviour on systems to detect where legitimate tools and utilities are being used for malicious purposes.", "p": "DET-04", "d": ["bnd", "idn", "crt", "prv"]}, {"id": "IT.PRO-04.3", "t": "Detect and respond to configuration drift using scheduled technical assessments and, where supported, automated monitoring, based on system criticality and change rate.", "p": "PRO-04", "d": ["usr"]}, {"id": "IT.PRO-07.1", "t": "Permit only supported, verified and organisation-authorised software to execute on systems, with exceptions minimised, formally risk accepted, time-bound, monitored and regularly reviewed.", "p": "PRO-07", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.PRO-07.2", "t": "Restrict administrative and management tooling to approved software sets and executed from only authorised, known locations.", "p": "PRO-07", "d": ["bnd", "crt", "bus", "usr"]}, {"id": "IT.RES-03.1", "t": "Use documented, tested and approved cyber security incident response procedures when responding to cyber security incidents.", "p": "RES-03", "d": ["vis"]}, {"id": "IT.RES-05.1", "t": "Integrate external coordination obligations into cyber security incident response activities where required.", "p": "RES-05", "d": ["vis"]}],
    ml2: 'On workstations and internet-facing servers; Microsoft\'s recommended block rules; rulesets validated at least annually; allowed and blocked events logged.',
    evidence: 'Blocked execution events reviewed; date the ruleset was last validated.',
    m365: 'App Control for Business (WDAC) through Intune; Defender advanced hunting.' },
  { name: "Restrict Microsoft Office macros", ism: 10,
    asd: [{"id": "IT.PRO-04.1", "t": "Define approved configuration baselines, informed by vendor and industry hardening guidance, that disable or remove unnecessary services, insecure settings, and unsupported or weak communication protocols.", "p": "PRO-04", "d": ["usr"]}, {"id": "IT.PRO-04.2", "t": "Deploy approved configuration baselines on systems, including infrastructure, operating systems and applications.", "p": "PRO-04", "d": ["usr"]}, {"id": "IT.PRO-07.1", "t": "Permit only supported, verified and organisation-authorised software to execute on systems, with exceptions minimised, formally risk accepted, time-bound, monitored and regularly reviewed.", "p": "PRO-07", "d": ["usr"]}],
    ml2: 'Macros blocked unless needed and blocked from the internet; macros scanned; Win32 API calls from macros blocked; users cannot change settings; macro events logged.',
    evidence: 'Users with macros enabled and why; blocked macro events.',
    m365: 'Intune Office policies; attack surface reduction rules.' },
  { name: "User application hardening", ism: 26,
    asd: [{"id": "IT.DET-01.1", "t": "Protect event logs from unauthorised access, modification or deletion, including by encrypting them during transit and at rest and securing the systems and accounts used to store, manage and analyse them.", "p": "DET-01", "d": ["bnd", "idn", "crt", "prv", "bus", "usr"]}, {"id": "IT.DET-01.2", "t": "Forward high-value, security-relevant event logs and configuration changes from infrastructure, operating systems and applications to a central log storage capability.", "p": "DET-01", "d": ["usr"]}, {"id": "IT.DET-01.3", "t": "Establish a centralised event log storage capability that protects logs from unauthorised access or modification.", "p": "DET-01", "d": ["vis"]}, {"id": "IT.DET-02.2", "t": "Ensure detection logic identifies unauthorised changes, anomalous authentication activity and suspicious software execution.", "p": "DET-02", "d": ["vis"]}, {"id": "IT.DET-03.1", "t": "Triage alerts and events in a timely manner to determine whether cyber security incident thresholds have been met.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-03.2", "t": "Use indicators from across identities, applications, data and infrastructure activity rather than isolated signals when identifying cyber security incidents.", "p": "DET-03", "d": ["vis"]}, {"id": "IT.DET-04.1", "t": "Continuously monitor and analyse software execution behaviour on systems to detect where legitimate tools and utilities are being used for malicious purposes.", "p": "DET-04", "d": ["bnd", "idn", "crt", "prv"]}, {"id": "IT.PRO-04.1", "t": "Define approved configuration baselines, informed by vendor and industry hardening guidance, that disable or remove unnecessary services, insecure settings, and unsupported or weak communication protocols.", "p": "PRO-04", "d": ["usr"]}, {"id": "IT.PRO-04.2", "t": "Deploy approved configuration baselines on systems, including infrastructure, operating systems and applications.", "p": "PRO-04", "d": ["usr"]}, {"id": "IT.RES-03.1", "t": "Use documented, tested and approved cyber security incident response procedures when responding to cyber security incidents.", "p": "RES-03", "d": ["vis"]}, {"id": "IT.RES-05.1", "t": "Integrate external coordination obligations into cyber security incident response activities where required.", "p": "RES-05", "d": ["vis"]}],
    ml2: 'Browsers do not run web ads or Java from the internet; Office and PDF software blocked from creating child processes or injecting code; vendor hardening guidance applied; users cannot change settings.',
    evidence: 'Hardening baseline compliance per device; attack surface reduction rule hits.',
    m365: 'Intune security baselines; attack surface reduction rules in Defender.' },
  { name: "Regular backups", ism: 9,
    asd: [{"id": "IT.PRO-10.1", "t": "Back up important data, applications and settings on a defined schedule to secure, resilient storage protected by encryption and immutable, offline, logically isolated or equivalent controls.", "p": "PRO-10", "d": ["bnd", "idn", "crt", "prv", "bus"]}, {"id": "IT.PRO-10.2", "t": "Isolate backup repositories from general user environments and production workloads, ensuring they are separated from primary systems to prevent unauthorised access, modification or deletion.", "p": "PRO-10", "d": ["crt", "prv", "bus"]}, {"id": "IT.PRO-10.3", "t": "Conduct regular testing of backup and restoration procedures to ensure that backups are reliable and capable of meeting defined recovery time objectives and recovery point objectives.", "p": "PRO-10", "d": ["bnd", "idn", "crt", "prv", "bus"]}],
    ml2: 'Backups made and kept according to business criticality, synchronised to a common point and stored securely; restoration tested; accounts other than backup administrators cannot reach or change other accounts\' backups.',
    evidence: 'Last restore test date and result; immutability or access restrictions shown.',
    m365: 'Microsoft 365 Backup or Azure Backup reports; restore test records.' },
];
// Actions with no Essential Eight control mapped to them in any domain, per
// the same workbook: what an Essential Eight programme will not already hold.
const newWork = [{"p": "GOV-01", "name": "Executive cyber security accountability", "actions": [{"id": "IT.GOV-01.1", "t": "Formally define and establish executive and board-level accountabilities for cyber security, including setting, monitoring and adjusting organisational risk appetite, and review these accountabilities at a defined cadence."}]}, {"p": "GOV-08", "name": "Executive artificial intelligence accountability", "actions": [{"id": "IT.GOV-08.1", "t": "Establish and maintain executive accountability for the use, governance and risk management of artificial intelligence within the organisation."}]}, {"p": "GOV-04", "name": "Cyber security resourcing", "actions": [{"id": "IT.GOV-04.1", "t": "Assign sufficient cyber security personnel and resources with the required skills to operate, monitor, maintain and manage the lifecycle of security controls and define cyber security responsibilities within role descriptions."}, {"id": "IT.GOV-04.2", "t": "Periodically review cyber security resourcing against cyber threat trends, cyber security incident outcomes and organisational changes."}]}, {"p": "GOV-03", "name": "Security risk management assurance", "actions": [{"id": "IT.GOV-03.1", "t": "Establish and maintain a risk management methodology and plan that is used to assess and treat cyber security risks."}]}, {"p": "GOV-11", "name": "Supplier cyber security assurance", "actions": [{"id": "IT.GOV-11.1", "t": "Select and engage suppliers of software, hardware and services on the basis of a cyber supply chain risk assessment proportionate to the risk the supplier introduces, and retain appropriate assurance evidence to support the decision."}, {"id": "IT.GOV-11.2", "t": "Maintain current assurance that suppliers continue to meet their cyber security commitments, and act when that assurance lapses or the supplier’s risk changes."}]}, {"p": "PRO-14", "name": "Cyber security awareness training", "actions": [{"id": "IT.PRO-14.2", "t": "Update and provide cyber security awareness training on a regular basis to reflect current threats and operational considerations."}, {"id": "IT.PRO-14.1", "t": "Ensure all personnel receive cyber security awareness training, that is tailored to how they will interact with systems, applications and data in their assigned roles, before being granted access to organisational systems and data."}]}, {"p": "IDE-04", "name": "Security risk identification", "actions": [{"id": "IT.IDE-04.1", "t": "Identify relevant weaknesses, malicious actor techniques and cyber threat behaviours when undertaking risk assessments and review these inputs on a continuous basis."}]}, {"p": "PRO-13", "name": "Identity, credential and access management", "actions": [{"id": "IT.PRO-13.3", "t": "Identify unsecured keys, secrets and credentials by regularly scanning codebases, configuration files, file shares and user collaboration platforms."}, {"id": "IT.PRO-13.5", "t": "Disable legacy authentication protocols or, where this is not feasible, restrict and monitor their use, apply compensating controls and establish a time-bound decommissioning plan."}]}, {"p": "RES-04", "name": "Cyber security incident insights", "actions": [{"id": "IT.RES-04.1", "t": "Perform post-cyber security incident reviews to identify the security gaps that enabled each stage of the cyber security incident."}, {"id": "IT.RES-04.2", "t": "Evaluate the monitoring coverage and cyber security incident response procedures following cyber security incidents."}]}, {"p": "IDE-01", "name": "Asset identification", "actions": [{"id": "IT.IDE-01.2", "t": "Maintain current records of assets including infrastructure, operating systems, applications, identities, credentials and data."}]}, {"p": "PRO-01", "name": "Secure system lifecycle", "actions": [{"id": "IT.PRO-01.2", "t": "Secure build and deployment processes to enforce controls consistently across systems."}]}, {"p": "PRO-16", "name": "Cyber supply chain security", "actions": [{"id": "IT.PRO-16.1", "t": "Assess the integrity and authenticity of software, components and updates before use, and verify provenance where suitable supplier evidence is available."}, {"id": "IT.PRO-16.2", "t": "Use vendor advisories and threat intelligence to maintain awareness of supplier, product and component exposure to compromise, and act within timeframes proportionate to the risk."}]}, {"p": "PRO-18", "name": "Network segmentation and segregation", "actions": [{"id": "IT.PRO-18.1", "t": "Isolate systems within network zones based on business criticality and trust level, and restrict and monitor inbound and outbound access to explicitly approved pathways and services."}]}, {"p": "PRO-09", "name": "Content filtering", "actions": [{"id": "IT.PRO-09.1", "t": "Inspect outbound content flows to detect unauthorised transfer of sensitive or high-value data."}, {"id": "IT.PRO-09.2", "t": "Block outbound network connections to known malicious or untrusted destinations."}, {"id": "IT.PRO-09.3", "t": "Inspect inbound content from external or untrusted sources to prevent delivery of malicious or unsafe content."}]}, {"p": "DET-02", "name": "Cyber security event detection", "actions": [{"id": "IT.DET-02.1", "t": "Ensure event logs are normalised, time-synchronised and enriched to support correlation across systems and environments."}]}];
const unmappedCount = newWork.reduce((n, p) => n + p.actions.length, 0);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Essential Eight to ASD Essentials: How Each Strategy Maps",
  "author": { "@type": "Organization", "name": "Compliance365", "url": "https://www.compliance365.com.au" },
  "publisher": { "@type": "Organization", "name": "Compliance365", "url": "https://www.compliance365.com.au" },
  "datePublished": "2026-10-15",
  "dateModified": "2026-10-26",
  "url": "https://www.compliance365.com.au/resources/essential-eight-to-essentials-mapping/"
};
---
<Base
  title="Essential Eight to ASD Essentials Mapping | Compliance365"
  description="ASD's own mapping of each Essential Eight strategy to the ASD Essentials for enterprise IT actions and domains, the 23 actions it does not cover, and the Microsoft 365 evidence."
  schema={[articleSchema]}
>
<Header />
<main id="main-content" tabindex="-1">

<section class="svc-hero">
  <CinematicBackground static />
  <div class="container svc-hero-copy" style="position:relative;z-index:1;">
    <p class="eyebrow">Essential Eight · ASD Essentials · Updated 26 October 2026</p>
    <h1 style="max-width:900px;">Essential Eight to ASD Essentials: how each strategy maps</h1>
    <p class="section-lead" style="max-width:760px;">
      ASD published the Essentials on 15 October 2026. Its Assessment Workbook for enterprise IT maps the Essential Eight's ISM controls to the new actions and domains. This page sets out that mapping strategy by strategy, the {unmappedCount} actions no Essential Eight control covers, and the evidence that shows each one working.
    </p>
    <div class="hero-ctas">
      <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
      <a href={`${base}resources/asd-essentials-framework/`} class="btn-hdk-ghost">Read the transition guide</a>
    </div>
  </div>
</section>

<section class="section" style="padding-bottom:1rem;">
  <div class="container" style="max-width:900px;">
    <div class="card" style="border-left:4px solid #f59e0b;background:#fffbeb;">
      <p style="font-weight:700;color:#92400e;margin:0 0 .4rem;">How to read this page</p>
      <ul class="muted small" style="margin:0;padding-left:1.2rem;display:grid;gap:.35rem;">
        <li><strong>From ASD:</strong> the actions, principles and domains each strategy maps to, the number of ISM controls behind it, and the action wording, all from ASD Essentials for enterprise IT and its Assessment Workbook.</li>
        <li><strong>Ours:</strong> the Maturity Level Two summaries, the evidence that shows a control working, and where it sits in Microsoft 365.</li>
        <li><strong>How it is rated:</strong> each action is rated in each domain as not assessed, not effective, partially effective or fully effective, and a principle takes its weakest action’s rating. Essential Eight maturity levels do not carry across as ratings.</li>
        <li><strong>Unchanged:</strong> where a contract, insurer or the PSPF names the Essential Eight, the Essential Eight is still what you are assessed against.</li>
      </ul>
    </div>
  </div>
</section>

<section class="section" id="at-a-glance">
  <div class="container" style="max-width:1000px;">
    <h2>At a glance</h2>
    <p class="muted" style="max-width:760px;">All eight strategies map into the enterprise IT chapter. Most also reach the visibility and response domain, because the Essential Eight's logging requirements map to ASD's detection and response actions.</p>
    <div class="map-scroll">
      <table class="map-table">
        <thead><tr><th>Essential Eight strategy</th><th>ISM controls mapped</th><th>Principles it maps to</th></tr></thead>
        <tbody>
          {strategies.map((s) => (
            <tr><td><a href={`#${s.name.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{s.name}</a></td><td>{s.ism}</td><td>{[...new Set(s.asd.map((a) => a.p))].join(', ')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:#FAF7F1;" id="by-strategy">
  <div class="container" style="max-width:1000px;">
    <h2>Strategy by strategy</h2>
    <p class="muted" style="max-width:760px;">The biggest change is the evidence. The Essentials rates how effective each action is in each domain, so the evidence has to show a control working, not just configured. The Maturity Level Two summaries are ours, from the <a href={e8mm} rel="noopener" target="_blank">Essential Eight Maturity Model (November 2023)</a>; check the exact wording there.</p>
    <div class="map-cards">
      {strategies.map((s) => (
        <article class="card map-card" id={s.name.toLowerCase().replace(/[^a-z]+/g, '-')}>
          <h3>{s.name}</h3>
          <p class="map-area">{s.ism} ISM controls, mapped to {s.asd.length} actions</p>
          <dl>
            <dt>Where ASD maps it</dt>
            <dd><ul class="map-acts">{s.asd.map((a) => (<li><b>{a.id}</b> {a.t} <span class="map-doms">{a.d.map((d) => DOMAINS[d]).join(', ')}</span></li>))}</ul></dd>
            <dt>Maturity Level Two today</dt><dd>{s.ml2}</dd>
            <dt>Evidence that it works</dt><dd>{s.evidence}</dd>
            <dt>Where it sits in Microsoft 365</dt><dd>{s.m365}</dd>
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section" id="gaps">
  <div class="container" style="max-width:1000px;">
    <h2>What the Essential Eight does not cover</h2>
    <p class="muted" style="max-width:760px;">In ASD’s workbook, no Essential Eight control maps to these {unmappedCount} of the chapter’s 58 actions, in any domain. An Essential Eight evidence pack will hold nothing for them, so they are new work: governance, suppliers, risk, training, incident learning, network segmentation, content filtering and the build pipeline.</p>
    <div class="map-scroll">
      <table class="map-table">
        <thead><tr><th>Principle</th><th>Actions with no Essential Eight mapping</th></tr></thead>
        <tbody>
          {newWork.map((p) => (<tr><td><b>{p.p}</b> {p.name}</td><td><ul class="map-acts">{p.actions.map((a) => (<li><b>{a.id}</b> {a.t}</li>))}</ul></td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="background:#FAF7F1;" id="convert">
  <div class="container" style="max-width:900px;">
    <h2>Converting a Maturity Level Two evidence pack</h2>
    <p class="muted">Re-map first, and rebuild only where a gap shows. Keep the Essential Eight pack alongside, because contracts and the PSPF still name it.</p>
    <ol class="muted" style="padding-left:1.4rem;display:grid;gap:.6rem;">
      <li><strong>Pick the chapters.</strong> Enterprise IT for almost everyone; add cloud or OT where those workloads are in scope.</li>
      <li><strong>List the domains.</strong> Take the chapter's eight domains and list which of your assets sit in each, including test and staging systems that can reach production.</li>
      <li><strong>Re-file the evidence.</strong> Use the mapping above to move each piece of Essential Eight evidence under the actions and domains it supports. One piece can support several.</li>
      <li><strong>Show it working.</strong> For each action, add a measure over time (patch age, MFA coverage, blocked executions, last restore test) rather than a single screenshot.</li>
      <li><strong>Rate each action in each domain.</strong> Not effective, partially effective or fully effective, using ASD’s indicators of good practice, with the evidence behind it.</li>
      <li><strong>Log the gaps.</strong> The actions above that the pack does not cover, and any action rated below fully effective, become work with an owner and a date.</li>
    </ol>
    <p class="muted" style="margin-top:1.25rem;">Checkpoint already collects most of the Microsoft 365 evidence above through its posture checks, so it can be regrouped by action and domain rather than gathered again. <a href={`${base}checkpoint-console/asd-essentials-software/`}>See Checkpoint for ASD Essentials</a>.</p>
  </div>
</section>

