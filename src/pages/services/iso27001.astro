---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 27001 Certification Support (Australia)',
  serviceType: 'ISO 27001 Certification',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso27001',
  description:
    'ISO 27001 certification support for Australian organisations. Gap assessment, policies, information security management system, risk, Statement of Applicability, internal audit and audit readiness — with audit-ready evidence in Microsoft 365 & SharePoint.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does ISO 27001 certification take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most small and medium Australian businesses complete ISO 27001 in 8–12 weeks with a focused scope and automated evidence in Microsoft 365.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need to buy a new platform?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We build your ISMS using your existing Microsoft 365 tools — SharePoint, Entra ID, Defender — so evidence lives where your team already works.'
      }
    },
    {
      '@type': 'Question',
      name: 'What’s included in your ISO 27001 support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Gap assessment, policy suite, risk register, Statement of Applicability, control implementation, internal audit, and full preparation for your external certification audit.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can you support us during the audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We prepare evidence packs, support assessor Q&A, coach your team for interviews, and can join calls if needed — so the audit is calm and predictable.'
      }
    }
  ]
};
---

<Base
  title="ISO 27001 Certification in Australia — Fast, Practical, Trusted | Compliance365"
  description="Get ISO 27001 certified in 8–12 weeks. Practical ISMS, risk, policies, and audit-ready evidence automated in Microsoft 365 — no new tools, no disruption."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO – Impactful & business-focused -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1>ISO 27001 Certification — Made Simple & Fast</h1>
          <p class="section-lead muted">
            Stop losing deals because of security questions. Get ISO 27001 certified in 8–12 weeks — with real evidence, no new tools, and minimal disruption.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">8–12 weeks</span>
            <span class="pill">No new tools</span>
            <span class="pill">Automated evidence</span>
            <span class="pill">Audit-ready</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">{ctaLabel}</a>
            <a href={`${base}checklist/iso27001`} class="btn btn-outline">Free Readiness Score</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/illus-iso27001.svg`}
            alt="ISO 27001 certification with automated evidence in Microsoft 365"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS TO YOU -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why ISO 27001 Matters to Your Business</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        In today’s market, customers, partners and procurement teams expect proof of strong security. ISO 27001 gives you that proof — quickly and credibly.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Win More Deals</h3>
          <p class="muted small">
            Show enterprise buyers you’re secure — often a must-have for contracts in government, healthcare and large tech.
          </p>
        </div>
        <div class="card feature center">
          <h3>Reduce Risk & Stress</h3>
          <p class="muted small">
            Spot and fix security gaps before they become incidents, downtime or headlines.
          </p>
        </div>
        <div class="card feature center">
          <h3>Simplify Future Compliance</h3>
          <p class="muted small">
            One strong framework covers overlapping needs — privacy, cloud, AI, vendor assessments — without starting over.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUTCOMES YOU GET -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Outcomes You Can Count On</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Certified Faster</h3>
          <p class="muted small">
            Most Australian SMBs reach certification in <strong>8–12 weeks</strong> with focused scope and automated evidence.
          </p>
        </div>
        <div class="card feature center">
          <h3>Auditor-Ready Evidence</h3>
          <p class="muted small">
            Everything traceable in SharePoint with version history — easy to prove what changed and when.
          </p>
        </div>
        <div class="card feature center">
          <h3>Proven in Real Businesses</h3>
          <p class="muted small">
            Experience across healthcare, finance and technology — first-time certification and surveillance audits passed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK (timeline) -->
  <section class="section">
    <div class="container">
      <h2 class="center">Typical ISO 27001 Timeline</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Focused, efficient, and built around your team — not the other way around.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1–2</h3>
          <p class="muted small">Scope + gap assessment + simple project plan</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 3–6</h3>
          <p class="muted small">Policies, risk register, SoA, controls & automation</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 7–8</h3>
          <p class="muted small">Internal audit + quick fixes</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 9–12</h3>
          <p class="muted small">Final prep + external certification audit</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section">
    <div class="container">
      <h2 class="center">What You Get with ISO 27001 Support</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Gap Assessment & Roadmap</h3>
          <p class="muted small">
            Clear picture of where you are today vs. ISO 27001 requirements — with a practical week-by-week plan.
          </p>
        </div>
        <div class="card feature center">
          <h3>Policy Suite & ISMS Framework</h3>
          <p class="muted small">
            Complete, plain-English policies and management system built around your real business.
          </p>
        </div>
        <div class="card feature center">
          <h3>Risk Register & Statement of Applicability</h3>
          <p class="muted small">
            Centralized risk view with owners/treatments + SoA showing which controls apply and why.
          </p>
        </div>
        <div class="card feature center">
          <h3>Implementation Support</h3>
          <p class="muted small">
            Hands-on setup of Microsoft 365 security controls with simple, automated evidence capture.
          </p>
        </div>
        <div class="card feature center">
          <h3>Internal Audit & Readiness</h3>
          <p class="muted small">
            Full internal audit, gap fixes, and team coaching so your certification audit is calm and predictable.
          </p>
        </div>
        <div class="card feature center">
          <h3>Ongoing Metrics & Improvement</h3>
          <p class="muted small">
            Simple dashboards and KPIs that show your ISMS is working — and keep you audit-ready year-round.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON CHALLENGES WE SOLVE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Common Challenges We Solve</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        We’ve helped Australian teams overcome the same concerns — limited time, unclear scope, and pressure from sales or customers.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>“We don’t have time”</h3>
          <p class="muted small">
            Short, focused workshops + reuse of what you already have + automated evidence = your team stays productive.
          </p>
        </div>
        <div class="card feature center">
          <h3>“Auditors need proof”</h3>
          <p class="muted small">
            Live screenshots, logs and exports stored in SharePoint — answer “show me” questions in seconds.
          </p>
        </div>
        <div class="card feature center">
          <h3>“We’re worried about scope”</h3>
          <p class="muted small">
            We right-size your ISMS — certify what matters most now, expand later as maturity grows.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">ISO 27001 FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>How long does it take?</h3>
          <p class="muted">
            Most Australian small/medium businesses complete ISO 27001 in <strong>8–12 weeks</strong> with clear scope and automation.
          </p>
        </div>
        <div class="card">
          <h3>Do we need a new platform?</h3>
          <p class="muted">
            <strong>No.</strong> Everything lives in your existing Microsoft 365 tools — evidence stays where your team already works.
          </p>
        </div>
        <div class="card">
          <h3>Can you support the audit?</h3>
          <p class="muted">
            Yes — we prepare evidence packs, support assessor Q&A, coach your team, and can join calls if you want us there.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section" style="background:#f8fafc;">
    <div class="container center">
      <h2>Related Services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Build on ISO 27001 with privacy, AI governance or other frameworks — all inside the same environment.
      </p>

      <div class="pill-row" style="justify-content:center;">
        <a class="pill" href="/services/iso27701">ISO 27701 (Privacy)</a>
        <a class="pill" href="/services/iso42001">ISO 42001 (AI)</a>
        <a class="pill" href="/services/soc2">SOC 2</a>
        <a class="pill" href="/services/essential-eight">Essential Eight</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:var(--primary);color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Ready to Get ISO 27001 Certified — Fast?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        Book a free 30-minute call — we’ll map your shortest path to certification without disruption.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:var(--primary);font-size:1.25rem;padding:1.2rem 2.8rem;">
          Book Free Call Now
        </a>
        <a href={`${base}checklist/iso27001`} class="btn btn-outline large" style="color:white;border-color:white;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Free ISO 27001 Readiness Score
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
        Most teams achieve certification in under 12 weeks.
      </p>
    </div>
  </section>

  <Footer />
</Base>
