<Base
  title="Essential 8 Explained — Full 2026 Guide | Compliance365"
  description="The Essential 8 (Essential Eight) explained — maturity levels ML1/ML2/ML3, all eight controls, who needs it, and how to reach ML2. Updated 2026."
  robots="index,follow"
  schema={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- BREADCRUMB -->
  <nav aria-label="Breadcrumb" style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container">
      <ol style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:0.25rem 0.5rem;font-size:0.85rem;color:#6B6860;">
