---
import org from '../../content/globals/footer.json';

const base: string = import.meta.env.BASE_URL || '/';
const company   = org?.companyName || 'Compliance365';
const tagline   = org?.tagline || 'Cyber, AI & Privacy Compliance';
const abn       = org?.abn || '';
const email     = org?.email || 'info@compliance365.com.au';
const phone     = org?.phone || '';
const address   = org?.address || '';
const privacy   = org?.privacyUrl ? org.privacyUrl : base + 'privacy';
const terms     = org?.termsUrl ? org.termsUrl : base + 'terms';
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <img src={(import.meta.env.BASE_URL) + 'assets/logo-mark.svg'} alt="Compliance365 logo" width="32" height="32" />
      <div>
        <strong>{company}</strong>
        <p class="muted">{tagline}</p>
        {abn ? <p class="small muted">ABN {abn}</p> : null}
        <div class="socials">
          <a href="https://www.linkedin.com/company/compliance365-au/" target="_blank" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-links">
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href={base + 'services/iso27001'}>ISO 27001</a></li>
          <li><a href={base + 'services/iso27701'}>ISO 27701 (Privacy)</a></li>
          <li><a href={base + 'services/iso42001'}>ISO 42001 (AI)</a></li>
          <li><a href={base + 'services/essential-eight'}>Essential Eight</a></li>
          <li><a href={base + 'services/soc2'}>SOC 2 Readiness</a></li>
          <li><a href={base + 'services/nist-csf'}>NIST CSF</a></li>
          <li><a href={base + 'services/disp-ism-irap'}>DISP, ISM & IRAP</a></li>
        </ul>
      </div>

      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href={base + 'checklists'}>Checklists hub</a></li>
          <li><a href={base + 'insights'}>Insights</a></li>
          <li><a href={base + 'case-studies'}>Case studies</a></li>
          <li><a href={base + 'about'}>About</a></li>
          <li><a href={base + 'contact'}>Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-contact">
      <h4>Stay in the loop</h4>
      <p class="muted small">Monthly practical tips on ISO 27001, 27701 & 42001.</p>
      <form class="subscribe-form">
        <input type="email" placeholder="Work email" required />
        <button class="btn btn-primary" type="submit">Subscribe</button>
      </form>
      <p class="muted small">
        <a href={"mailto:" + email}>{email}</a> · {phone}<br/>
        {address}
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {company}. All rights reserved.</p>
    <div class="footer-links-inline">
      <a href={privacy}>Privacy Policy</a>
      <span>·</span>
      <a href={terms}>Terms & Conditions</a>
    </div>
  </div>
</footer>
