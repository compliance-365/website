---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
---

<Base
  title="Free Readiness Checklists — ISO 27001, SOC 2, AI Governance & More | Compliance365"
  description="Instant readiness scores, next steps & downloadable PDF reports for ISO 27001, ISO 27701, ISO 42001, SOC 2, Essential Eight, DISP/ISM/IRAP and NIST CSF."
>
  <Header />

  <!-- Hero / Intro -->
  <section class="section hero-checklist">
    <div class="container center">
      <h1>Free Compliance Readiness Checklists</h1>
      <p class="lead muted" style="max-width:760px; margin:1.5rem auto;">
        Answer a few quick questions and get an instant readiness score, tailored next steps, and a downloadable PDF report — for ISO, SOC 2, AI Governance, Essential Eight, and government assurance frameworks.
      </p>
      <p class="small muted" style="margin-top:1rem;">
        No sign-up required • Instant results • Works with your existing environment
      </p>
    </div>
  </section>

  <!-- Checklist Grid -->
  <section class="section checklist-grid">
    <div class="container">
      <div class="grid-3">
        <!-- ISO 27001 -->
        <a href={`${base}checklist/iso27001`} class="checklist-card" aria-label="Start ISO 27001 readiness checklist">
          <div class="card-icon">🔒</div>
          <h3>ISO 27001 (Security)</h3>
          <p>ISMS scope, risk assessment, controls, SoA, and audit readiness.</p>
          <span class="btn-start">Start Now →</span>
        </a>

        <!-- ISO 27701 -->
        <a href={`${base}checklist/iso27701`} class="checklist-card" aria-label="Start ISO 27701 readiness checklist">
          <div class="card-icon">🛡️</div>
          <h3>ISO 27701 (Privacy)</h3>
          <p>PIMS, DPIA, ROPA, data subject rights, and privacy lifecycle.</p>
          <span class="btn-start">Start Now →</span>
        </a>

        <!-- ISO 42001 -->
        <a href={`${base}checklist/iso42001`} class="checklist-card" aria-label="Start ISO 42001 readiness checklist">
          <div class="card-icon">🤖</div>
          <h3>ISO 42001 (AI Governance)</h3>
          <p>AIMS, model inventory, AI risk assessment, oversight, and monitoring.</p>
          <span class="btn-start">Start Now →</span>
        </a>

        <!-- SOC 2 -->
        <a href={`${base}checklist/soc2`} class="checklist-card" aria-label="Start SOC 2 readiness checklist">
          <div class="card-icon">✅</div>
          <h3>SOC 2 (Trust Services)</h3>
          <p>Security, availability, confidentiality, processing integrity, and privacy.</p>
          <span class="btn-start">Start Now →</span>
        </a>

        <!-- Essential Eight -->
        <a href={`${base}checklist/essential-eight`} class="checklist-card" aria-label="Start Essential Eight readiness checklist">
          <div class="card-icon">🛡️</div>
          <h3>Essential Eight (ACSC)</h3>
          <p>Maturity levels, mitigation strategies, and Microsoft 365 examples.</p>
          <span class="btn-start">Start Now →</span>
        </a>

        <!-- DISP / ISM / IRAP -->
        <a href={`${base}checklist/disp-ism-irap`} class="checklist-card" aria-label="Start DISP-ISM-IRAP readiness checklist">
          <div class="card-icon">🇦🇺</div>
          <h3>DISP / ISM / IRAP (Gov Assurance)</h3>
          <p>Defence and government assurance frameworks for secure environments.</p>
          <span class="btn-start">Start Now →</span>
        </a>
      </div>

      <!-- Bottom CTA -->
      <div class="bottom-cta" style="text-align:center; margin-top:4rem;">
        <p class="muted" style="margin-bottom:1.5rem;">
          Not sure which one to start with? Book a quick call — we’ll guide you.
        </p>
        <a href={ctaUrl} class="btn btn-primary">Book a Free Call</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* === Checklist Page Styles ================================= */
  .hero-checklist {
    padding: 6rem 0 4rem;
    background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 100%);
    text-align: center;
  }

  .hero-checklist h1 {
    font-size: clamp(2.8rem, 5vw, 3.8rem);
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Grid of cards */
  .checklist-grid .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .checklist-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem 1.8rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.28s, box-shadow 0.28s;
    text-align: center;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checklist-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: 0.8rem;
    color: var(--primary);
  }

  .checklist-card h3 {
    font-size: 1.45rem;
    margin: 0;
  }

  .checklist-card p {
    color: var(--muted);
    margin: 0.5rem 0 1rem;
    font-size: 1.05rem;
  }

  .btn-start {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    background: var(--primary);
    color: white;
    border-radius: 0.75rem;
    font-weight: 600;
    transition: background 0.25s;
  }

  .btn-start:hover {
    background: var(--primary-600);
  }

  /* Bottom CTA */
  .bottom-cta .btn-primary {
    padding: 1rem 2.5rem;
    font-size: 1.2rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .grid-3 { grid-template-columns: 1fr; }
  }
</style>
