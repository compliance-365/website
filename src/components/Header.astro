---
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = '/book';
const ctaLabel = 'Book a call';
---

<header class="site-header">
  <div class="container header-inner">
    <a href={base} class="brand" aria-label="Compliance365 home">
      <img src={base + 'assets/logo.svg'} alt="Compliance365 — Cyber, Privacy & AI Compliance" width="28" height="28" />
      <strong>Compliance365</strong>
    </a>

    <!-- Mobile menu button -->
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primaryNav">
      <span class="sr-only">Toggle navigation</span>☰
    </button>

    <nav id="primaryNav" class="nav" aria-label="Primary">
      <a href={base}>Home</a>
      <a href={base + 'services'}>Services</a>
      <a href={base + 'case-studies'}>Case Studies</a>
      <a href={base + 'about'}>About</a>
      <a href={base + 'resources'}>Resources</a>
      <a href={base + 'blog'}>Insights</a>
      <a href={base + '#outcomes'}>Testimonials</a>

      <!-- Prominent CTA -->
      <a href={ctaUrl} class="btn-cta" aria-label="Contact Us">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2v3M17 2v3M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
        </svg>
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; background: #fff;
    border-bottom: 1px solid var(--border, #e9edf4);
    backdrop-filter: saturate(180%) blur(10px);
  }
  .header-inner { display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:64px; }
  .brand { display:inline-flex; align-items:center; gap:10px; color:inherit; text-decoration:none; }
  .nav { display:flex; align-items:center; gap:12px; }

  /* Upgraded CTA */
  .btn-cta{
    display:inline-flex; align-items:center; gap:10px;
    padding: 12px 16px; border-radius: 14px; font-weight: 900;
    color:#fff; border:0; text-decoration:none; white-space:nowrap;
    background: linear-gradient(135deg, var(--primary) 0%, var(--brand-a) 50%, var(--brand-b) 100%);
    box-shadow: 0 10px 26px -12px rgba(79,70,229,.45);
    position: relative; isolation: isolate;
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }
  .btn-cta:hover{ transform: translateY(-1px); filter: saturate(1.06) brightness(.98); box-shadow: 0 16px 34px -14px rgba(79,70,229,.55); }
  .btn-cta svg{ width:18px; height:18px; stroke:#fff; fill:none; stroke-width:1.8; }

  /* Soft pulse ring */
  .btn-cta::after{
    content:""; position:absolute; inset:-6px; border-radius:18px;
    background: radial-gradient(120px 40px at 30% 10%, rgba(109,40,217,.20), transparent 60%),
                radial-gradient(140px 60px at 80% 70%, rgba(6,182,212,.18), transparent 60%);
    filter: blur(12px); opacity:.0; z-index:-1; transition: opacity .25s ease;
  }
  .btn-cta:hover::after{ opacity:.9; }

  .nav-toggle{
    display:none; border:1px solid var(--border, #e9edf4);
    background:#fff; border-radius:10px; padding:8px 10px; cursor:pointer;
  }
  @media (max-width: 980px){
    .nav-toggle{ display:inline-flex; }
    .nav{
      position:absolute; top:64px; left:0; right:0; display:grid; gap:8px;
      background:#fff; border-bottom:1px solid #eef2f7; padding:10px 20px;
      transform: translateY(-16px); opacity:0; pointer-events:none;
      transition: opacity .2s ease, transform .2s ease;
    }
    .nav.open{ opacity:1; pointer-events:auto; transform:none; }
    .btn-cta{ width:100%; justify-content:center; }
  }

  .sr-only{
    position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden;
    clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }
</style>

<script is:inline>
  (function () {
    const btn = document.querySelector('.nav-toggle');
    const nav = document.getElementById('primaryNav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
