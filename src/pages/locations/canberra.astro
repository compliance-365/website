---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

const pageTitle = 'ISO 27001, IRAP & Compliance Consultant Canberra | Compliance365';
const pageDesc = 'ISO 27001, Essential Eight, IRAP and DISP for Canberra businesses and Commonwealth contractors. Fixed-price, audit-ready in 10–14 weeks.';

const serviceLd = {
  '@type': 'ProfessionalService',
  name: 'Compliance365 — Canberra Compliance Consulting',
  url: 'https://www.compliance365.com.au/locations/canberra/',
  description: pageDesc,
  telephone: '+61468752243',
  email: 'info@compliance365.com.au',
  areaServed: [
    { '@type': 'City', name: 'Canberra' },
    { '@type': 'AdministrativeArea', name: 'Australian Capital Territory' }
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Compliance Services — Canberra',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 27001 Certification Support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'IRAP Assessment Readiness' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'DISP Membership Support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Essential Eight ML2 / ML3 Uplift' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISM Alignment' } },
    ]
  }
};

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do you deliver IRAP and ISO 27001 consulting in Canberra?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Compliance365 delivers ISO 27001, IRAP assessment readiness, DISP membership support, Essential Eight uplift, and ISM alignment for Canberra businesses and Commonwealth contractors. All engagements are delivered remotely with on-site options.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is the difference between IRAP and ISO 27001 for Canberra businesses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'IRAP (Infosec Registered Assessors Program) is the Australian Government\'s security assessment framework aligned to the ISM (Information Security Manual). It is required for systems processing government data classified at PROTECTED or above. ISO 27001 is an international standard for information security management systems, required by enterprise procurement and international customers. Many Canberra businesses need both — IRAP for government contracts and ISO 27001 for commercial enterprise customers. The two share significant control overlap and can be delivered simultaneously.'
      }
    },
    {
      '@type': 'Question',
      name: 'Does Essential Eight ML2 satisfy Commonwealth Government security requirements?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Essential Eight ML2 is the baseline security maturity level required for most Commonwealth Government systems and ICT suppliers under the Protective Security Policy Framework (PSPF) and ASD guidance. For systems handling PROTECTED information, Essential Eight ML2 is typically the minimum — some systems require ML3. IRAP assessment confirms alignment to the ISM. We deliver Essential Eight uplift and IRAP readiness as a combined engagement for Canberra contractors.'
      }
    }
  ]
};
---

<Base title={pageTitle} description={pageDesc} schema={[serviceLd, faqLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Locations', url: 'https://www.compliance365.com.au/locations/' },
    { name: 'Canberra', url: 'https://www.compliance365.com.au/locations/canberra/' }
  ]}
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Canberra · ACT · Commonwealth Government & Defence</p>
      <h1 style="max-width:860px;">ISO 27001, IRAP & Essential Eight consulting for Canberra businesses.</h1>
      <p class="section-lead" style="max-width:720px;">
        Canberra's compliance requirements are distinct. Federal government procurement, Defence contracts, and PSPF obligations mean ISO 27001 alone often isn't enough — and IRAP without ISO 27001 leaves commercial procurement gaps. We deliver both, together.
      </p>
      <ul class="trust-signals">
        <li>IRAP readiness</li>
        <li>DISP membership support</li>
        <li>Essential Eight ML2 / ML3</li>
        <li>ISO 27001 fixed-price</li>
      </ul>
      <div class="hero-ctas" style="margin-top:2rem;">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free scoping call</a>
        <a href={`${base}checklist/iso27001/`} class="btn-hdk-ghost">Free readiness assessment</a>
      </div>
    </div>
  </section>

  <!-- CANBERRA CONTEXT -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">The Canberra compliance landscape</h2>
      <p class="muted center" style="max-width:720px;margin:1.5rem auto;">
        More than any other Australian city, Canberra's compliance requirements are shaped by government frameworks. Most Canberra technology businesses need to navigate at least two overlapping systems.
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card spot">
          <h3>Commonwealth Government procurement</h3>
          <p class="muted small">Commonwealth agencies procure technology under the Digital Sourcing Framework and PSPF. Suppliers are expected to demonstrate Essential Eight ML2 as a baseline, with IRAP assessments required for systems handling PROTECTED information. ISO 27001 is increasingly asked for alongside these frameworks as assurance for security management over and above point-in-time technical controls.</p>
        </div>
        <div class="card spot">
          <h3>Defence industry & DISP</h3>
          <p class="muted small">Canberra's defence contractor community — from large primes to specialist SMEs — must hold DISP membership and maintain ISM-aligned security programmes. Essential Eight ML2 is the standard technical baseline. For contractors handling foreign military sales or classified information, ML3 and IRAP assessment are required. We deliver DISP readiness, ISM alignment, and Essential Eight uplift as a combined programme.</p>
        </div>
        <div class="card spot">
          <h3>APS agencies & GovTech suppliers</h3>
          <p class="muted small">APS agencies and the GovTech sector in Canberra face the same PSPF and Essential Eight requirements as other Commonwealth entities. Technology suppliers to APS agencies — particularly those delivering SaaS, cloud platforms, or managed services — must demonstrate security maturity that matches the agency's risk appetite. ISO 27001 plus Essential Eight is the standard combination.</p>
        </div>
        <div class="card spot">
          <h3>Whole-of-government SaaS</h3>
          <p class="muted small">Canberra SaaS companies building for whole-of-government markets face a distinctive requirement set: Essential Eight for ASD alignment, ISO 27001 for enterprise commercial customers, and potentially IRAP for systems accessing government data classified above OFFICIAL. Getting all three from a single control set is achievable — and significantly cheaper than three sequential programmes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FRAMEWORK EXPLAINER -->
  <section class="section">
    <div class="container">
      <h2 class="center">IRAP, Essential Eight, and ISO 27001 — how they fit together</h2>
      <p class="muted center" style="max-width:720px;margin:1.5rem auto;">
        Canberra businesses often need to navigate all three. They're not duplicates — they serve different purposes and different audiences.
      </p>

      <div style="max-width:860px;margin:2.5rem auto 0;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:.875rem;">
          <thead>
            <tr style="background:#A9812E;color:white;">
              <th style="padding:12px 16px;text-align:left;">Framework</th>
              <th style="padding:12px 16px;text-align:left;">Purpose</th>
              <th style="padding:12px 16px;text-align:left;">Who asks for it</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Essential Eight ML2', 'ASD technical security controls — patching, MFA, backups, application control, and four others. Demonstrates baseline cyber hygiene.', 'Commonwealth agencies, PSPF-obligated entities, defence primes'],
              ['IRAP Assessment', 'Independent assessment of a specific system against the ISM. Required for systems processing PROTECTED or above information.', 'Commonwealth agencies where data is PROTECTED or above'],
              ['DISP Membership', 'Defence Industry Security Program — demonstrates capability to protect Australian Government information in defence contracts.', 'Defence primes, Defence contractors, CASG procurements'],
              ['ISO 27001', 'International standard for information security management systems. Produces an internationally recognised certificate from an accredited body.', 'Enterprise customers (AU & international), cyber insurers, boards, commercial procurement'],
            ].map(([fw, purpose, who], i) => (
              <tr style={`background:${i % 2 === 0 ? 'white' : '#FAF7F1'};border-bottom:1px solid #DDD8CF;`}>
                <td style="padding:12px 16px;font-weight:700;color:#0B0B0C;white-space:nowrap;">{fw}</td>
                <td style="padding:12px 16px;color:#6B6860;">{purpose}</td>
                <td style="padding:12px 16px;color:#6B6860;">{who}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="muted" style="max-width:860px;margin:1.5rem auto 0;font-size:.875rem;">
        Most Canberra technology businesses need Essential Eight + ISO 27001 as a baseline, with IRAP and DISP added where Defence or PROTECTED-system work is in scope. We deliver combined programmes that use a single control set and evidence base for all applicable frameworks — significantly reducing cost and effort versus running them separately.
      </p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">Services for Canberra businesses</h2>
      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3><a href={`${base}services/disp-ism-irap/`} style="color:inherit;text-decoration:none;">DISP / ISM / IRAP</a></h3>
          <p class="muted small">Defence Industry Security Program membership, ISM alignment, and IRAP assessment readiness. The most Canberra-specific service we deliver. We prepare your system documentation, security plan, and IRAP evidence pack for independent assessor review.</p>
          <a href={`${base}services/disp-ism-irap/`} style="color:#A9812E;font-weight:700;font-size:.875rem;">Learn more →</a>
        </div>
        <div class="card feature spot">
          <h3><a href={`${base}services/essential-eight/`} style="color:inherit;text-decoration:none;">Essential Eight ML2 / ML3</a></h3>
          <p class="muted small">ASD Essential Eight maturity uplift. Commonwealth baseline is ML2. Defence and high-risk systems require ML3. Delivered using Intune, Defender, and Entra — tools already included in your Microsoft 365 licence.</p>
          <a href={`${base}services/essential-eight/`} style="color:#A9812E;font-weight:700;font-size:.875rem;">Learn more →</a>
        </div>
        <div class="card feature spot">
          <h3><a href={`${base}services/iso27001/`} style="color:inherit;text-decoration:none;">ISO 27001 Certification</a></h3>
          <p class="muted small">Full ISMS build and Stage 1/Stage 2 audit support for Canberra technology businesses. Satisfies commercial enterprise procurement requirements that IRAP and Essential Eight don't cover. Often combined with Essential Eight in a single engagement.</p>
          <a href={`${base}services/iso27001/`} style="color:#A9812E;font-weight:700;font-size:.875rem;">Learn more →</a>
        </div>
        <div class="card feature spot">
          <h3><a href={`${base}services/iso42001/`} style="color:inherit;text-decoration:none;">ISO 42001 AI Governance</a></h3>
          <p class="muted small">AI Management System for Canberra businesses building GovTech AI products. The Australian Government's AI Safety Standard and emerging APS AI policy expectations align closely with ISO 42001's requirements.</p>
          <a href={`${base}services/iso42001/`} style="color:#A9812E;font-weight:700;font-size:.875rem;">Learn more →</a>
        </div>
        <div class="card feature spot">
          <h3><a href={`${base}services/iso27701/`} style="color:inherit;text-decoration:none;">ISO 27701 Privacy</a></h3>
          <p class="muted small">Privacy Information Management System aligned to the Privacy Act 1988 and Australian Privacy Principles. Relevant for Canberra businesses handling APS employee data, citizen data, or sensitive government information.</p>
          <a href={`${base}services/iso27701/`} style="color:#A9812E;font-weight:700;font-size:.875rem;">Learn more →</a>
        </div>
        <div class="card feature spot">
          <h3><a href={`${base}services/nist-csf/`} style="color:inherit;text-decoration:none;">NIST CSF 2.0</a></h3>
          <p class="muted small">NIST CSF implementation for Canberra businesses with US Government customers, Five Eyes partners, or US parent companies requiring NIST-aligned security programmes alongside Australian frameworks.</p>
          <a href={`${base}services/nist-csf/`} style="color:#A9812E;font-weight:700;font-size:.875rem;">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">Common questions from Canberra clients</h2>
      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card spot">
          <h3>Do I need IRAP if I already have ISO 27001?</h3>
          <p class="muted small">Yes, if your system processes information classified at PROTECTED or above. ISO 27001 satisfies commercial enterprise procurement. IRAP is required specifically for government classified systems. The two are complementary — ISO 27001 covers the management system, IRAP assesses the specific system against the ISM.</p>
        </div>
        <div class="card spot">
          <h3>What Essential Eight level do Commonwealth suppliers need?</h3>
          <p class="muted small">ML2 is the baseline for most Commonwealth systems under current PSPF guidance. ML3 is required for systems with higher risk classifications. We assess your specific obligation and deliver uplift to the required level — not a level higher than necessary.</p>
        </div>
        <div class="card spot">
          <h3>Can ISO 27001 and Essential Eight be delivered together?</h3>
          <p class="muted small">Yes — and this is one of our most common Canberra engagements. The control overlap is substantial: most Essential Eight controls map directly to ISO 27001 Annex A controls. A combined engagement delivers both from a single control set and evidence base, saving 30–40% versus sequential programmes.</p>
        </div>
        <div class="card spot">
          <h3>How long does IRAP assessment readiness take?</h3>
          <p class="muted small">IRAP readiness (preparing system security documentation, SSSP, and evidence for an independent IRAP assessor) typically takes 6–10 weeks depending on system complexity and current documentation maturity. The IRAP assessment itself is conducted by an independent assessor — we prepare you for it, not conduct it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OTHER LOCATIONS -->
  <section class="container section-tight">
    <p style="margin:0 0 0.75rem;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#6B6860;">We also work with clients in</p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;">
      <a href={`${base}locations/brisbane/`} class="card spot" style="flex:1;min-width:140px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
        <strong style="display:block;color:#8B6820;margin-bottom:3px;">Brisbane</strong>
        <span class="muted small">Our HQ — Queensland</span>
      </a>
      <a href={`${base}locations/sydney/`} class="card spot" style="flex:1;min-width:140px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
        <strong style="display:block;color:#8B6820;margin-bottom:3px;">Sydney</strong>
        <span class="muted small">Enterprise & fintech</span>
      </a>
      <a href={`${base}locations/melbourne/`} class="card spot" style="flex:1;min-width:140px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
        <strong style="display:block;color:#8B6820;margin-bottom:3px;">Melbourne</strong>
        <span class="muted small">Healthcare & financial services</span>
      </a>
      <a href={`${base}locations/perth/`} class="card spot" style="flex:1;min-width:140px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
        <strong style="display:block;color:#8B6820;margin-bottom:3px;">Perth</strong>
        <span class="muted small">Mining, defence & WA Government</span>
      </a>
      <a href={`${base}locations/adelaide/`} class="card spot" style="flex:1;min-width:140px;padding:1rem 1.25rem;text-decoration:none;color:inherit;border-left:3px solid #A9812E;">
        <strong style="display:block;color:#8B6820;margin-bottom:3px;">Adelaide</strong>
        <span class="muted small">AUKUS defence & space sector</span>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Ready to scope your Canberra engagement?</h2>
      <p>
        A free 30-minute call covers which frameworks apply to your situation, what the fastest path looks like, and a fixed-price estimate. IRAP, Essential Eight, ISO 27001, or all three — we'll tell you what's actually required.
      </p>
      <div class="final-buttons">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free 30-min call</a>
        <a href={`${base}checklist/iso27001/`} class="btn-hdk-ghost">Take the free checklist</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
