---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// URLs used in the hero
const ctaUrl       = 'https://calendly.com/matt-nicholas-compliance365/30min';
const resourcesUrl = base + 'resources';

// SEO helpers for JSON-LD
const org = {
  '@type': 'Organization',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  logo: 'https://www.compliance365.com.au/assets/og-default.png',
  sameAs: ['https://www.linkedin.com/company/compliance-365/']
};

const siteLd = {
  '@type': 'WebSite',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.compliance365.com.au/search?q={query}',
    'query-input': 'required name=query'
  }
};

const servicesLd = [
  { name: 'ISO 27001 Certification Support',       url: 'https://www.compliance365.com.au/services/iso27001' },
  { name: 'ISO 27701 Privacy (PIMS)',              url: 'https://www.compliance365.com.au/services/iso27701' },
  { name: 'ISO 42001 AI Governance (AIMS)',        url: 'https://www.compliance365.com.au/services/iso42001' },
  { name: 'SOC 2 Readiness',                       url: 'https://www.compliance365.com.au/services/soc2' },
  { name: 'Essential Eight Uplift',                url: 'https://www.compliance365.com.au/services/essential-eight' },
  { name: 'DISP / ISM / IRAP',                     url: 'https://www.compliance365.com.au/services/disp-ism-irap' }
].map(s => ({ '@type':'Service', serviceType:s.name, provider:{ '@type':'Organization', name:'Compliance365' }, url:s.url }));

const ld = {
  '@context': 'https://schema.org',
  '@graph': [org, siteLd, ...servicesLd]
};
---

<Base
  title="ISO 27001, ISO 27701, ISO 42001, SOC 2 & Essential Eight — Australia | Compliance365"
  description="ISO 27001, ISO 27701, ISO 42001 (AI), SOC 2 and Essential Eight consulting in Australia. Faster certification and audit-ready evidence captured in Microsoft 365 & SharePoint."
  schema={[
    {
      "@type":"CollectionPage",
      "@id":"https://www.compliance365.com.au/#home",
      "name":"Compliance365 — Cyber, Privacy & AI Governance",
      "url":"https://www.compliance365.com.au/",
      "description":"Certification and readiness for ISO 27001, ISO 27701, ISO 42001, SOC 2 and Essential Eight in Australia."
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"}
      ]
    }
  ]}
/>
  <Header />

  <!-- HERO -->
<section class="hero-wrap">
  <div class="container hero">
    <!-- Left: copy + CTAs -->
    <div>
      <h1 class="hero-title">Turn compliance into confidence.</h1>
      <p class="hero-lede muted">
        Achieve <strong>ISO 27001</strong>, <strong>ISO 27701</strong>, <strong>ISO 42001</strong>,
        <strong>SOC 2</strong> and <strong>Essential Eight</strong> in weeks, not months — with
        audit-ready evidence captured where you already work.
      </p>

      <div class="hero-ctas">
        <a class="btn btn-primary" href={ctaUrl} aria-label="Book a roadmap call with Compliance365">Book a roadmap call</a>
        <a class="btn btn-ghost" href={resourcesUrl}>Get the checklists</a>
      </div>

      <!-- Credibility strip -->
      <div class="chips">
        <span class="chip chip-check">Certified in weeks, not months</span>
        <span class="chip chip-check">Audit-ready evidence</span>
        <span class="chip chip-check">Smarter, automated compliance</span>
      </div>

      <!-- Social proof (pulled closer via smaller margins) -->
      <p class="muted small small-muted">Trusted by security-minded businesses across Australia and New Zealand.</p>
    </div>

    <!-- Right: product mock (SVG) -->
    <div class="hero-visual">
      <div class="mock-wrap">
        <!-- keep your existing SVG exactly as is -->
        <svg class="mock-frame" width="680" height="420" viewBox="0 0 680 420" role="img" aria-label="Compliance workflow inside Microsoft 365">
          <!-- … your existing <defs> + content … -->
        </svg>
      </div>
    </div>
  </div>
</section>

  <!-- IMPACT STRIP -->
  <section class="container section-tight">
    <div class="card" style="display:flex;gap:22px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:18px">
      <div style="display:flex;gap:24px;flex-wrap:wrap">
        <div>
          <strong style="font-size:1.5rem;display:block">8–12 weeks</strong>
          <span class="muted small">typical time to readiness</span>
        </div>
        <div>
          <strong style="font-size:1.5rem;display:block">30–50%</strong>
          <span class="muted small">less audit effort via automation</span>
        </div>
        <div>
          <strong style="font-size:1.5rem;display:block">100%</strong>
          <span class="muted small">audit-ready evidence in M365</span>
        </div>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <span class="pill">No new platform</span>
        <span class="pill">SharePoint evidence</span>
        <span class="pill">Auditor-friendly</span>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="container section">
    <h2>What we deliver</h2>
    <p class="muted" style="margin-top:-4px">
      Pick the outcome you need — we’ll map the shortest route and automate the evidence.
    </p>

    <div class="grid-3" style="margin-top:14px">
      <!-- ISO 27001 -->
      <a class="card lift feature" href={`${base}services/iso27001`} aria-label="ISO 27001 Certification Support">
