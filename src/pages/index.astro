---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

const images = {
  controlsDiagram: '/assets/controls-mapping-diagram.png',
  // Placeholder paths — replace with your actual professional images
  winDealsImg: '/assets/win-deals-professional.jpg',            // handshake + revenue graph + shield
  procurementImg: '/assets/procurement-green-checkpoint.jpg',  // smooth gate/car with green light
  confidenceImg: '/assets/confidence-call-shield.jpg',         // executive on call + evidence floats
};
---

<Base
  title="Close Enterprise Deals Faster — Guaranteed Compliance in Weeks | Compliance365"
  description="Stop compliance from killing deals. ISO 27001, SOC 2, HIPAA, Essential Eight, AI Governance — delivered fast, inside your environment, at a fraction of the cost."
>
  <Header />

  <!-- Announcement Bar -->
  <div class="announce">
    <div class="container">
      <div class="announce-inner">
        <span class="announce-dot"></span>
        <span class="announce-text">
          ✔ ISO 27001 • ISO 27701 • ISO 42001 • SOC 2 • Essential Eight • SaaS & Tech Experts • Your Existing Systems
        </span>
      </div>
    </div>
  </div>

  <!-- HERO - Revenue First -->
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-content">
        <h1>Close Enterprise Deals Faster</h1>
        <h2 class="hero-sub">Guaranteed Compliance in Weeks</h2>
        <p class="hero-tagline">
          Security, Privacy & AI compliance — delivered inside your environment.<br>
          No new tools. No disruption. Fraction of the cost.
        </p>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn btn-primary large">Stop Losing Deals — Book Free Call</a>
          <a href={`${base}checklist/`} class="btn btn-outline">Get Free ComplianceReady™ Score</a>
        </div>

        <div class="hero-kickers">
          <span>No New Tools</span>
          <span>No Disruption</span>
          <span>Revenue-First Compliance</span>
        </div>
      </div>

      <!-- Optional: add a hero image placeholder here later -->
      <!-- <div class="hero-visual">
        <img src="/assets/hero-handshake-growth.jpg" alt="Enterprise deal closing faster" loading="eager" />
      </div> -->
    </div>
  </section>

  <!-- Controls Mapping Diagram (moved here - first thing after CTAs) -->
  <section class="section diagram-section">
    <div class="container narrow center">
      <h3>One Set of Controls — Multiple Frameworks Covered</h3>
      <p class="muted">ISO 27001 as the foundation maps efficiently to SOC 2, HIPAA, Essential Eight and more.</p>
      <img 
        src={images.controlsDiagram} 
        alt="ISO 27001 central controls mapping to SOC 2, HIPAA, Essential Eight" 
        class="diagram-img"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 3 BIGGEST FEARS -->
  <section class="section fears">
    <div class="container narrow center">
      <h2>The 3 Biggest Fears Killing Your Deals Right Now</h2>
      <p class="lead">Strong pipeline. Superior product. Still losing revenue because compliance proof can't be delivered fast and credibly.</p>
    </div>

    <div class="container">
      <div class="fear-grid">
        <div class="fear-card red">
          <h3>Losing big deals at the final hurdle</h3>
          <p>Procurement kills the deal when assurance isn't proven quickly — even when your solution is clearly better.</p>
        </div>
        <div class="fear-card orange">
          <h3>Being labelled “high risk”</h3>
          <p>Risk teams default to “no” the moment evidence looks incomplete, inconsistent or hard to defend.</p>
        </div>
        <div class="fear-card blue">
          <h3>Scrambling when proof is requested</h3>
          <p>Teams dig through spreadsheets, emails and heads — wasting time and appearing unprepared.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT CLIENTS REALLY WANT - Bigger images + more detail -->
  <section class="section desires">
    <div class="container center">
      <h2>What Your Enterprise Clients Really Want</h2>
      <p class="subtitle">
        Buyers want confidence. Procurement wants consistency. Auditors want evidence.<br>Your team wants calm — not chaos.
      </p>

      <div class="desire-grid">
        <div class="desire-card">
          <img src={images.winDealsImg} alt="Modern handshake with upward revenue graph and security shield" loading="lazy" class="big-desire-img" />
          <h3>Win deals faster</h3>
          <p>Security, privacy & AI compliance should accelerate revenue — not add unpredictable months to your sales cycle. Turn a potential blocker into your competitive edge with fast, credible proof that wins trust instantly.</p>
        </div>

        <div class="desire-card">
          <img src={images.procurementImg} alt="Smooth green-lit procurement checkpoint with fast progress" loading="lazy" class="big-desire-img" />
          <h3>Move through procurement without friction</h3>
          <p>Weeks, not months. Predictable timelines. Consistent, defensible answers that let procurement teams say “yes” with confidence — while your engineering team stays focused on building, not firefighting.</p>
        </div>

        <div class="desire-card">
          <img src={images.confidenceImg} alt="Confident executive on call with floating evidence & green checkmarks" loading="lazy" class="big-desire-img" />
          <h3>Confidence when customers ask hard questions</h3>
          <p>Answer any security, privacy or AI question in minutes — with court-ready, auditor-approved evidence. No more last-minute scrambles, tribal knowledge or credibility gaps.</p>
        </div>
      </div>

      <div class="cta-band center" style="margin-top: 4rem;">
        <a href={ctaUrl} class="btn btn-primary large">Turn Compliance Into Revenue — Book Your Call</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final-cta">
    <div class="container narrow center">
      <h2>Ready to Stop Losing Revenue to Compliance Delays?</h2>
      <p class="lead">Get compliant fast, prove trust instantly, and close more enterprise deals with confidence.</p>

      <div class="final-buttons">
        <a href={ctaUrl} class="btn btn-primary large">Book Free Compliance Call</a>
        <a href={`${base}checklist/`} class="btn btn-outline large">Free ComplianceReady™ Score</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* Hero - bigger, punchier */
  .hero {
    padding: 6rem 0 7rem;
    background: linear-gradient(135deg, #f8faff 0%, #ffffff 100%);
  }
  .hero h1 { font-size: clamp(3.2rem, 7vw, 5rem); line-height: 1.05; margin-bottom: 0.4rem; }
  .hero-sub { font-size: 2.2rem; color: var(--primary, #4154f1); margin: 0 0 1.5rem; }
  .hero-tagline { font-size: 1.35rem; color: #475569; margin-bottom: 2.2rem; line-height: 1.45; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 1.2rem; justify-content: center; margin-bottom: 2rem; }
  .btn.large { padding: 1.3rem 2.8rem; font-size: 1.25rem; }
  .hero-kickers { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .hero-kickers span {
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: white;
    border: 1px solid #e2e8f0;
    font-weight: 700;
    font-size: 1rem;
  }

  /* Diagram section */
  .diagram-section { padding: 4rem 0; background: #f8fafc; }
  .diagram-img { max-width: 100%; height: auto; border-radius: 16px; box-shadow: 0 20px 60px -20px rgba(0,0,0,0.15); }

  /* Fears */
  .fear-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }
  .fear-card {
    padding: 2rem;
    border-radius: 16px;
    background: white;
    box-shadow: 0 10px 30px -12px rgba(0,0,0,0.08);
    border-left: 6px solid;
  }
  .fear-card.red { border-left-color: #ef4444; }
  .fear-card.orange { border-left-color: #f97316; }
  .fear-card.blue { border-left-color: #3b82f6; }

  /* Desires - BIGGER images */
  .desires { padding: 7rem 0; }
  .subtitle { font-size: 1.4rem; color: #475569; max-width: 800px; margin: 1rem auto 4rem; line-height: 1.5; }
  .desire-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 3rem;
  }
  .desire-card {
    text-align: center;
    padding: 0 1rem;
  }
  .big-desire-img {
    width: 100%;
    height: 380px;           /* Much bigger */
    object-fit: contain;
    border-radius: 16px;
    box-shadow: 0 12px 40px -12px rgba(0,0,0,0.12);
    margin-bottom: 1.8rem;
    background: #f8fafc;
  }
  .desire-card p { font-size: 1.1rem; line-height: 1.55; color: #475569; }

  /* CTA band */
  .cta-band {
    padding: 3rem;
    background: linear-gradient(135deg, #4154f1 0%, #6366f1 100%);
    color: white;
    border-radius: 24px;
  }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .desire-grid { gap: 4rem; }
    .big-desire-img { height: 320px; }
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 2.8rem; }
    .hero-sub { font-size: 1.8rem; }
  }
</style>
