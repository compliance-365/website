    </symbol>

    <symbol id="ic-refresh" viewBox="0 0 16 16" ${S}>
      <path d="M13 8A5 5 0 1 1 11.5 4.2"/>
      <path d="M11.5 1.8v2.4h2.4"/>
    </symbol>

    <symbol id="ic-wrench" viewBox="0 0 16 16" ${S}>
      <circle cx="4" cy="12" r="1.6"/>
      <circle cx="12" cy="4" r="1.6"/>
      <path d="M5.1 10.9 10.9 5.1"/>
    </symbol>

    <symbol id="ic-monitor" viewBox="0 0 16 16" ${S}>
      <rect x="2" y="3" width="12" height="8" rx="1"/>
      <path d="M6 14h4M8 11v3"/>
    </symbol>

    <symbol id="ic-save" viewBox="0 0 16 16" ${S}>
      <path d="M3.5 2h7l2 2v8.5a1 1 0 0 1-1 1H3.5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Z"/>
      <rect x="5.5" y="2" width="4" height="2.5"/>
      <rect x="4.5" y="8.5" width="7" height="4"/>
    </symbol>

    <symbol id="ic-factory" viewBox="0 0 16 16" ${S}>
      <path d="M2 14V7l3 2V7l3 2V6l4 2.5V14Z"/>
      <path d="M12 6V3.5"/>
      <path d="M1.5 14h12.5"/>
    </symbol>

    <symbol id="ic-search" viewBox="0 0 16 16" ${S}>
      <circle cx="6.75" cy="6.75" r="4"/>
      <path d="M9.8 9.8 13.5 13.5"/>
    </symbol>

    <symbol id="ic-home" viewBox="0 0 16 16" ${S}>
      <path d="M2 7.5 8 2.5l6 5"/>
      <path d="M3.5 7v7h9V7"/>
      <path d="M6.75 10h2.5v4h-2.5Z"/>
    </symbol>

    <symbol id="ic-cross" viewBox="0 0 16 16" ${S}>
      <path d="M4 4 12 12M12 4 4 12"/>
    </symbol>

    <symbol id="ic-gear" viewBox="0 0 16 16" ${S}>
      <circle cx="8" cy="8" r="2"/>
      <path d="M11 8h2.5M2.5 8H5M10.12 10.12l1.77 1.77M4.11 4.11l1.77 1.77M8 11v2.5M8 2.5V5M10.12 5.88l1.77-1.77M4.11 11.89l1.77-1.77"/>
    </symbol>

    <symbol id="ic-pulse" viewBox="0 0 16 16" ${S}>
      <path d="M1.5 8H5l1.5-4 2 8 1.5-4H14.5"/>
    </symbol>

    <symbol id="ic-target" viewBox="0 0 16 16" ${S}>
      <circle cx="8" cy="8" r="6"/>
      <circle cx="8" cy="8" r="3.4"/>
      <circle cx="8" cy="8" r="0.9" fill="currentColor" stroke="none"/>
    </symbol>

    <symbol id="ic-clock" viewBox="0 0 16 16" ${S}>
      <circle cx="8" cy="8" r="6.25"/>
      <path d="M8 4.5V8l2.25 1.75"/>
    </symbol>

  `} />
</svg>
