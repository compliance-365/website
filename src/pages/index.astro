            <path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z"/>
            <path d="M12 9v4m-2 0h4"/>
          </svg>
        </div>
        <h3>ISO 27001 (Security)</h3>
        <p class="muted">ISMS in 8–12 weeks. Gap analysis, policies, risk, SoA & audit.</p>
        <div class="pill-row"><span class="pill brand">Gap analysis</span><span class="pill">SoA</span></div>
      </a>

      <!-- ISO 42001 -->
      <a class="card lift feature" href={`${base}services/iso42001`} aria-label="ISO 42001 AI Governance">
        <div class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4"/>
