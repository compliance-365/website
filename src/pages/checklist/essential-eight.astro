---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ASD Essential Eight';

const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–99','100–499','500–1 999','2 000+'] },
  { id: 'trigger',      label: 'What is driving this assessment?',     type: 'select', required: true,  options: ['ASD/ACSC requirement','Government contract requirement','IRAP assessment preparation','Internal security uplift','Board or executive mandate','Incident-driven review','Other'] },
  { id: 'maturity',     label: 'Current estimated maturity level',     type: 'select', required: false, options: ['Not started','Maturity Level 0','Maturity Level 1','Maturity Level 2','Maturity Level 3'] },
  { id: 'target',       label: 'Target maturity level',               type: 'select', required: false, options: ['Not yet decided','Maturity Level 1','Maturity Level 2','Maturity Level 3'] },
];

const QUESTIONS = [
  // Application Control
  {
    id: 'ac-scope',
    group: 'appctl',
    label: 'Application allow-listing is enforced on workstations and servers for executables, DLLs, scripts and installers.',
    hint: 'Only approved applications and code should run — this prevents malware and unauthorised software execution.',
    examples: [
      'Microsoft Defender Application Control (WDAC) or AppLocker policies enforcing allow-listing.',
      'Coverage includes executables, DLLs, scripts (PowerShell, JS, VBS) and installers (MSI).',
      'Policies applied to both workstations and servers where feasible.'
    ]
  },
  {
    id: 'ac-source',
    group: 'appctl',
    label: 'Trusted publisher and signed code policies are defined with a formal change approval workflow for new applications.',
    hint: 'New software should be approved through a controlled, auditable process rather than broad exceptions.',
    examples: [
      'Rules allowing signed code from approved publishers only.',
      'Formal change or exception approval process for adding new applications.',
      'Testing and promotion workflow from audit mode to enforced mode.'
    ]
  },
  {
    id: 'ac-logs',
    group: 'appctl',
    label: 'Application control block and log events are centralised in a SIEM or equivalent and reviewed on a defined cadence.',
    hint: 'Blocked executions should be logged, reviewed and used to tune allow-lists — not ignored.',
    examples: [
      'Centralised collection of AppLocker or WDAC events in Sentinel or equivalent SIEM.',
      'Documented review cadence (e.g. weekly during rollout, monthly ongoing).',
      'Evidence of tuning actions taken based on blocked event logs.'
    ]
  },

  // Patch Applications
  {
    id: 'pa-internet',
    group: 'patchapps',
    label: 'Internet-facing applications — browsers, PDF readers, email clients — are patched within defined SLAs.',
    hint: 'High-risk applications must be patched quickly to reduce exposure to known exploits.',
    examples: [
      'Defined patch SLAs aligned to ACSC guidance (e.g. critical within 48 hours).',
      'Automated patching via Intune, Defender or equivalent tools.',
      'Compliance reports showing patch status for browsers, PDF readers and email clients.'
    ]
  },
  {
    id: 'pa-inv',
    group: 'patchapps',
    label: 'An application inventory with risk classification and assigned owners is maintained and kept current.',
    hint: 'You must know what applications exist and which ones present the highest risk before you can patch them consistently.',
    examples: [
      'Application inventory including version, owner and business criticality.',
      'Risk classification highlighting internet-facing or privileged applications.',
      'Defined process for onboarding new and retiring old applications.'
    ]
  },
  {
    id: 'pa-evidence',
    group: 'patchapps',
    label: 'Patch compliance reports are automatically captured and stored monthly as audit-ready evidence.',
    hint: 'Patch compliance evidence must be repeatable, consistent and easy to produce for auditors.',
    examples: [
      'Monthly exported patch compliance reports stored in SharePoint.',
      'Dashboards from Intune or Defender showing patch status by device group.',
      'Retention aligned to audit and regulatory requirements.'
    ]
  },

  // Configure MS Office Macros
  {
    id: 'ma-block',
    group: 'macros',
    label: 'Macros from the Internet are blocked by default, with only signed macros or trusted locations permitted.',
    hint: 'Macros are a common attack vector — blocking Internet-sourced macros by default is a baseline control.',
    examples: [
      'Office policy blocking macros from files downloaded from the Internet.',
      'Only digitally signed macros or files from trusted locations allowed.',
      'Configuration aligned to ACSC macro hardening guidance.'
    ]
  },
  {
    id: 'ma-config',
    group: 'macros',
    label: 'Macro controls are deployed and tested consistently across all managed devices via Group Policy or Intune.',
    hint: 'Controls that are not consistently deployed provide no protection for unmanaged or unpatched devices.',
    examples: [
      'Intune or GPO policies enforcing macro settings across all device groups.',
      'Deployment evidence showing all applicable devices are covered.',
      'Testing results confirming expected macro blocking behaviour.'
    ]
  },
  {
    id: 'ma-except',
    group: 'macros',
    label: 'A formal exception process exists for business-critical macros — exceptions are time-bound, approved and logged.',
    hint: 'Exceptions to macro controls should be rare, formally approved and periodically reviewed.',
    examples: [
      'A documented exception request and approval workflow.',
      'Time-bound exceptions with defined expiry and automatic review.',
      'Logs of active macro exceptions reviewed at least quarterly.'
    ]
  },

  // User Application Hardening
  {
    id: 'uh-features',
    group: 'hardening',
    label: 'Risky browser features — including legacy plugins, ad injectors and web trackers — are disabled or restricted.',
    hint: 'Reducing the browser attack surface limits options for drive-by and watering-hole attacks.',
    examples: [
      'Policies disabling Flash, legacy ActiveX and Java browser plugins.',
      'Ad and tracker restrictions or enhanced browser security mode enabled.',
      'Configuration aligned to ACSC browser hardening guidance.'
    ]
  },
  {
    id: 'uh-downloads',
    group: 'hardening',
    label: 'Standard users are prevented from downloading and running executable files from the web.',
    hint: 'Blocking executable downloads for standard users removes a common malware delivery path.',
    examples: [
      'Browser or OS controls blocking executable file downloads for standard user accounts.',
      'Microsoft SmartScreen or equivalent enforcement active.',
      'Exceptions limited to approved use cases with documented approval.'
    ]
  },
  {
    id: 'uh-verify',
    group: 'hardening',
    label: 'Periodic verification checks confirm hardening controls remain in place — evidence is stored with policy references.',
    hint: 'Hardening controls can drift — periodic verification ensures they remain effective.',
    examples: [
      'Screenshots or exported reports showing active hardening settings.',
      'Verification checks performed quarterly or after major changes.',
      'Evidence stored alongside linked policy references for audit readiness.'
    ]
  },

  // Restrict Admin Privileges
  {
    id: 'ad-jit',
    group: 'admin',
    label: 'Privileged access uses just-in-time (JIT) or just-enough-access (JEA) patterns — standing admin rights are minimised.',
    hint: 'Limiting standing administrative access reduces the blast radius of credential compromise.',
    examples: [
      'Azure AD Privileged Identity Management (PIM) or equivalent for just-in-time admin access.',
      'Permanent admin rights removed from standard accounts where feasible.',
      'Approval workflows and logging for all privileged access activations.'
    ]
  },
  {
    id: 'ad-review',
    group: 'admin',
    label: 'Privileged group memberships are reviewed and recertified at least quarterly.',
    hint: 'Regular access reviews ensure only authorised users retain administrative access over time.',
    examples: [
      'Quarterly access review records for all privileged or admin groups.',
      'Evidence of removals or adjustments following each review.',
      'Sign-off by system or risk owners documented.'
    ]
  },
  {
    id: 'ad-seg',
    group: 'admin',
    label: 'Admin accounts are segmented from standard user activity — no email or browsing — with dedicated admin workstations where practical.',
    hint: 'Separating admin from day-to-day activity reduces risk of credential theft through phishing or malware.',
    examples: [
      'Dedicated admin accounts with email and web browsing disabled or not configured.',
      'Privileged Access Workstations (PAWs) or hardened admin devices in use.',
      'Policy prohibiting admin account use for standard day-to-day activities.'
    ]
  },

  // Patch Operating Systems
  {
    id: 'po-sla',
    group: 'patchos',
    label: 'OS patch SLAs are defined and met — exceptions are tracked and formally approved.',
    hint: 'Operating systems must be patched within defined timeframes to reduce exploit risk from known vulnerabilities.',
    examples: [
      'Documented OS patch SLAs aligned to ACSC guidance (e.g. critical within 48 hours).',
      'Patch compliance reports showing SLA adherence by device group.',
      'Tracked and formally approved exceptions with risk acceptance.'
    ]
  },
  {
    id: 'po-rings',
    group: 'patchos',
    label: 'OS updates are deployed via staged rings or pilot groups with rollback procedures defined and exercised.',
    hint: 'Controlled rollout reduces operational risk from faulty patches affecting the entire fleet simultaneously.',
    examples: [
      'Defined pilot, broad and critical update rings for OS patch deployment.',
      'Rollback procedures documented and tested for failed or problematic updates.',
      'Evidence of updates tested in pilot groups before broad deployment.'
    ]
  },
  {
    id: 'po-report',
    group: 'patchos',
    label: 'OS patch compliance dashboards and exportable evidence are captured regularly and stored for audit.',
    hint: 'Audit-ready OS patching evidence should be easy to produce on demand.',
    examples: [
      'Dashboards showing OS patch compliance by device group and operating system.',
      'Exported compliance reports stored monthly in SharePoint.',
      'Retention aligned to audit requirements.'
    ]
  },

  // Multi-Factor Authentication
  {
    id: 'mfa-scope',
    group: 'mfa',
    label: 'MFA is enforced for remote access, privileged roles and all sensitive applications.',
    hint: 'MFA is mandatory for high-risk access paths — the ACSC considers this non-negotiable.',
    examples: [
      'MFA enforced for VPN, remote desktop, cloud admin roles and sensitive business apps.',
      'Conditional Access or equivalent policies covering all in-scope applications.',
      'Remaining exceptions documented, risk-accepted and tracked for remediation.'
    ]
  },
  {
    id: 'mfa-method',
    group: 'mfa',
    label: 'Phishing-resistant MFA methods — FIDO2, passkeys or number matching — are preferred over SMS.',
    hint: 'Stronger MFA methods significantly reduce the risk of credential phishing and MFA fatigue attacks.',
    examples: [
      'FIDO2 security keys or device-bound passkeys deployed for privileged roles.',
      'Number matching or app-based push enabled for Microsoft Authenticator.',
      'SMS-based MFA restricted or being phased out.'
    ]
  },
  {
    id: 'mfa-gaps',
    group: 'mfa',
    label: 'Break-glass or emergency access controls are documented, tested and monitored for use.',
    hint: 'Emergency access must exist for resilience but be tightly controlled and alerted on.',
    examples: [
      'Documented break-glass accounts with strong, securely stored passwords.',
      'Regular testing of break-glass access to verify it remains functional.',
      'Alerts and monitoring configured on any break-glass account usage.'
    ]
  },

  // Regular Backups
  {
    id: 'bk-scope',
    group: 'backups',
    label: 'Critical systems and SaaS services — including Microsoft 365 — are in backup scope with defined RTO and RPO.',
    hint: 'Backups must cover critical services comprehensively to support timely recovery.',
    examples: [
      'A documented list of critical systems and SaaS services included in backup scope.',
      'Defined and approved RTO and RPO for each critical service.',
      'Alignment with a current business impact analysis.'
    ]
  },
  {
    id: 'bk-immut',
    group: 'backups',
    label: 'Backups include immutable or tamper-evident copies — air-gapped or object-locked — with separation of duties.',
    hint: 'Immutable backups protect against ransomware and insider threats modifying or deleting backup data.',
    examples: [
      'Immutable or object-locked backup copies configured in cloud or tape storage.',
      'Separation of duties between backup administrators and system administrators.',
      'Evidence of immutability configuration and access controls.'
    ]
  },
  {
    id: 'bk-restore',
    group: 'backups',
    label: 'Restoration tests are performed periodically with documented evidence — findings are actioned.',
    hint: 'Backups that have never been tested cannot be relied upon for actual recovery.',
    examples: [
      'Scheduled restore tests for all critical systems at least annually.',
      'Test results documented with timestamps, screenshots or logs.',
      'Issues identified in testing tracked and remediated before the next test.'
    ]
  },
];

const GROUPS = [
  { key: 'appctl',    title: 'Application Control',        icon: 'shield', blurb: 'Allow-lists for approved executables, libraries, scripts and installers.' },
  { key: 'patchapps', title: 'Patch Applications',         icon: 'refresh', blurb: 'Timely patching of internet-facing and high-risk applications.' },
  { key: 'macros',    title: 'Configure Office Macros',    icon: 'note', blurb: 'Block or tightly control macros from the Internet.' },
  { key: 'hardening', title: 'User App Hardening',         icon: 'wrench', blurb: 'Disable risky browser features and block executable downloads.' },
  { key: 'admin',     title: 'Restrict Admin Privileges',  icon: 'people', blurb: 'Least privilege, JIT access and segmented admin accounts.' },
  { key: 'patchos',   title: 'Patch Operating Systems',    icon: 'monitor', blurb: 'Meet SLAs for OS patches with centralised visibility.' },
  { key: 'mfa',       title: 'Multi-Factor Authentication',icon: 'lock', blurb: 'MFA for remote, privileged and sensitive access.' },
  { key: 'backups',   title: 'Regular Backups',            icon: 'save', blurb: 'Tested, immutable backups with defined RTO and RPO.' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="ASD Essential Eight Free Readiness Checklist | Compliance365"
  description="Free ASD Essential Eight readiness checklist. Score your maturity across all eight mitigation strategies and download a prioritised PDF roadmap."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'Essential Eight Checklist', url: 'https://www.compliance365.com.au/checklist/essential-eight/' }
  ]}
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Free Readiness Assessment</p>
      <h1>ASD Essential Eight Readiness Checklist</h1>
      <p class="section-lead" style="max-width:760px;">
        Gauge your cyber security maturity across all eight ASD mitigation strategies. Answer 24 questions, get an instant domain-by-domain score and download a branded PDF you can share with executives, boards or auditors.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#A9812E;color:white;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill" data-stage="2" style="flex:1;min-width:140px;background:#DDD8CF;color:#6B6860;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill" data-stage="3" style="flex:1;min-width:140px;background:#DDD8CF;color:#6B6860;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#FAF7F1;padding:2rem 0;border-top:1px solid #DDD8CF;border-bottom:1px solid #DDD8CF;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#A9812E;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-clock"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">~20 minutes</strong><p class="muted small" style="margin:2px 0 0;">24 questions across all eight Essential Eight strategies, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#16a34a;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-check-seal"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Mapped to ACSC guidance</strong><p class="muted small" style="margin:2px 0 0;">Questions calibrated to the evidence criteria the ACSC and auditors assess for each strategy.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:#A9812E;"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-note"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Branded PDF report</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top gaps and a prioritised action plan — ready to share with leadership or auditors.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:#6B6860;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#A9812E;color:white;font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">DISP / ISM / IRAP</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- STAGE 1 -->
      <div id="stage-1" class="stage">
        <div class="card spot" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your Essential Eight roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>
          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0B0B0C;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>
          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>
          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #DDD8CF;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- STAGE 2 -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #DDD8CF;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #DDD8CF;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="width:1.75rem;height:1.75rem;display:inline-flex;align-items:center;justify-content:center;color:#A9812E;flex-shrink:0;"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><use href={`#ic-${grp.icon}`}/></svg></span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0B0B0C;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:#A9812E;">0/{grpQs.length}</div>
                    </div>
                  </div>
                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #F5F0E8;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:rgba(169,129,46,0.06);color:#A9812E;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0B0B0C;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:#A9812E;font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:#A9812E;border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card spot" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #F5F0E8;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:#A9812E;line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#6B6860;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:#374151;font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#C8C3B8;"> - </span>
                    </div>
                    <div style="background:#F5F0E8;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#C8C3B8;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #F5F0E8;">
                <div style="font-size:0.75rem;color:#6B6860;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#F5F0E8;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#A9812E;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:#A9812E;border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- STAGE 3 -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card spot" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />

  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = 'ASD Essential Eight';
      const API_URL  = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';

      const GROUPS = [
        { key:'appctl',    title:'Application Control' },
        { key:'patchapps', title:'Patch Applications' },
        { key:'macros',    title:'Configure Office Macros' },
        { key:'hardening', title:'User App Hardening' },
        { key:'admin',     title:'Restrict Admin Privileges' },
        { key:'patchos',   title:'Patch Operating Systems' },
        { key:'mfa',       title:'Multi-Factor Authentication' },
        { key:'backups',   title:'Regular Backups' },
      ];

      const QUESTIONS = [
        { id:'ac-scope',    group:'appctl',    label:'Application allow-listing enforced on workstations and servers for executables, DLLs, scripts and installers' },
        { id:'ac-source',   group:'appctl',    label:'Trusted publisher and signed code policies defined with formal change approval workflow' },
        { id:'ac-logs',     group:'appctl',    label:'Application control block and log events centralised in SIEM and reviewed on defined cadence' },
        { id:'pa-internet', group:'patchapps', label:'Internet-facing applications patched within defined SLAs (browsers, PDF readers, email clients)' },
        { id:'pa-inv',      group:'patchapps', label:'Application inventory with risk classification and assigned owners maintained and kept current' },
        { id:'pa-evidence', group:'patchapps', label:'Patch compliance reports automatically captured and stored monthly as audit-ready evidence' },
        { id:'ma-block',    group:'macros',    label:'Macros from the Internet blocked by default — only signed macros or trusted locations permitted' },
        { id:'ma-config',   group:'macros',    label:'Macro controls deployed and tested consistently across all managed devices via GPO or Intune' },
        { id:'ma-except',   group:'macros',    label:'Formal exception process exists for business-critical macros — time-bound, approved and logged' },
        { id:'uh-features', group:'hardening', label:'Risky browser features — legacy plugins, ad injectors, web trackers — disabled or restricted' },
        { id:'uh-downloads',group:'hardening', label:'Standard users prevented from downloading and running executable files from the web' },
        { id:'uh-verify',   group:'hardening', label:'Periodic verification checks confirm hardening controls remain in place with evidence stored' },
        { id:'ad-jit',      group:'admin',     label:'Privileged access uses JIT or JEA patterns — standing admin rights minimised' },
        { id:'ad-review',   group:'admin',     label:'Privileged group memberships reviewed and recertified at least quarterly' },
        { id:'ad-seg',      group:'admin',     label:'Admin accounts segmented from standard user activity with dedicated admin workstations where practical' },
        { id:'po-sla',      group:'patchos',   label:'OS patch SLAs defined and met — exceptions tracked and formally approved' },
        { id:'po-rings',    group:'patchos',   label:'OS updates deployed via staged rings or pilot groups with rollback procedures defined' },
        { id:'po-report',   group:'patchos',   label:'OS patch compliance dashboards and exportable evidence captured regularly and stored for audit' },
        { id:'mfa-scope',   group:'mfa',       label:'MFA enforced for remote access, privileged roles and all sensitive applications' },
        { id:'mfa-method',  group:'mfa',       label:'Phishing-resistant MFA methods (FIDO2, passkeys, number matching) preferred over SMS' },
        { id:'mfa-gaps',    group:'mfa',       label:'Break-glass emergency access controls documented, tested and monitored for use' },
        { id:'bk-scope',    group:'backups',   label:'Critical systems and SaaS services in backup scope with defined RTO and RPO' },
        { id:'bk-immut',    group:'backups',   label:'Backups include immutable or tamper-evident copies with separation of duties' },
        { id:'bk-restore',  group:'backups',   label:'Restoration tests performed periodically with documented evidence — findings actioned' },
      ];

      const TOTAL_Q = QUESTIONS.length;
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#A9812E' : (s < n ? '#16a34a' : '#DDD8CF');
            p.style.color = (s <= n) ? 'white' : '#6B6860';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('to-stage-2').addEventListener('click', function() {
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger','maturity','target'];
          var reqIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];
          allIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) env[id] = el.value ? el.value.trim() : '';
          });
          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) {
              valid = false;
              el.style.borderColor = '#dc2626';
              el.style.background  = '#fef2f2';
            } else {
              el.style.borderColor = '#C8C3B8';
              el.style.background  = 'white';
            }
          });
          var errEl = document.getElementById('env-error');
          if (!valid) { errEl.style.display = 'block'; errEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white'; o.style.color = '#0B0B0C'; o.style.borderColor = '#C8C3B8';
            });
            btn.classList.add('active');
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'white'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'white'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the ASD Essential Eight readiness checklist. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') window.c365OpenChat(msg);
          });
        });

        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white'; o.style.color = '#0B0B0C'; o.style.borderColor = '#C8C3B8';
          });
          update();
        });

        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true; btn.textContent = 'Generating...';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
            if (typeof gtag === 'function') gtag('event', 'checklist_completed', { framework: 'Essential Eight' });
          } catch (err) {
            console.error(err);
            alert('Something went wrong — your PDF should still have downloaded.');
          } finally {
            btn.disabled = false; btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => { if (state[id] !== null) { answered++; sum += state[id]; } });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { label: 'Not started', desc: 'Answer questions to score', color: '#6B6860' };
        if (score >= 86) return { label: 'ML3-Ready', desc: 'Strong posture — focus on evidence packaging and formal assessment', color: '#16a34a' };
        if (score >= 61) return { label: 'Nearly ML2-Ready', desc: 'Close remaining gaps and tighten evidence packaging', color: '#A9812E' };
        if (score >= 31) return { label: 'Partially Ready', desc: 'Many controls in place — focus and prioritisation needed', color: '#d97706' };
        return { label: 'High Risk', desc: 'Missing foundational controls — structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#C8C3B8';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the ASD Essential Eight readiness checklist on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('Current maturity: ' + (env['maturity'] || 'Not specified'));
        lines.push('Target maturity: ' + (env['target'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Strategy scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) {
            lines.push('  [' + (state[q.id] === 1 ? 'PARTIAL' : 'NO') + '] ' + q.label);
          });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest Essential Eight gaps, what I should prioritise to reach my target maturity level, and what a realistic uplift roadmap looks like?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);
        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#F5F0E8';
            el.style.color = a === total ? '#166534' : '#3A3632';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) { bar.style.width = '0%'; bar.style.background = '#C8C3B8'; pctEl.textContent = ' - '; pctEl.style.color = '#C8C3B8'; }
            else { bar.style.width = pct + '%'; bar.style.background = barColor(pct); pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct); }
          }
        });

        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone; btn.style.cursor = allDone ? 'pointer' : 'not-allowed'; btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone ? 'Click to generate and email your report' : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) { aiBtn.disabled = !allDone; aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed'; aiBtn.style.opacity = allDone ? '1' : '0.5'; }
      }

      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const lines = [];
        lines.push('=== ESSENTIAL EIGHT READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Current maturity: ${env['maturity'] || ''}`);
        lines.push(`Target maturity: ${env['target'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        GROUPS.forEach(g => { const s = computeSection(g.key); lines.push(`  ${g.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`); });
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          lines.push(`[${v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED'}] ${q.label}`);
        });
        try {
          await fetch(API_URL, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: env['contact-name'] || env['org-name'] || 'Anonymous',
              email: env['contact-email'] || 'noreply@compliance365.com.au',
              subject: `Essential Eight Checklist - ${env['org-name'] || 'Anonymous'} - ${score}%`,
              message: lines.join('\n'),
            }),
          });
        } catch (err) { console.warn('API submission failed:', err); }
      }

      function generatePDF() {
        var jsPDFLib = window.jspdf || {};
        var jsPDF = jsPDFLib.jsPDF;
        if (!jsPDF) { alert('PDF library not loaded — please wait and try again.'); return; }
        var doc = new jsPDF('p','mm','a4');
        var W=210, LM=18, RM=16, CW=W-LM-RM, y=0;
        var PRIMARY=[30,64,175], GREEN=[5,150,105], AMBER=[180,110,0], RED=[200,30,30];
        var WHITE=[255,255,255], LIGHT=[248,250,252], MUTED=[100,116,139], DARK=[17,24,39];
        var comp=compute(), sc=comp.score, ansCount=comp.answered, band=getBand(sc,ansCount);
        var orgName=env['org-name']||'Your Organisation';
        var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
        var scoreCol=sc>=75?GREEN:sc>=50?AMBER:RED;
        var scoreBand=sc>=86?'ML3-Ready':sc>=61?'Nearly ML2-Ready':sc>=31?'Partially Ready':'High Risk';
        doc.setFillColor(...PRIMARY); doc.rect(0,0,W,42,'F');
        doc.setFillColor(6,182,212); doc.rect(0,40,W,2,'F');
        var logoEl=document.getElementById('pdfLogo');
        doc.setTextColor(...WHITE); doc.setFont('helvetica','bold'); doc.setFontSize(18);
        if (logoEl&&logoEl.complete&&logoEl.naturalWidth>0) { doc.addImage(logoEl,'PNG',LM,8,20,20,undefined,'FAST'); doc.text('Compliance365',LM+24,18); }
        else { doc.text('Compliance365',LM,18); }
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text('ASD Essential Eight Readiness Report', LM+(logoEl&&logoEl.complete?24:0), 26);
        doc.setFontSize(9); doc.text(orgName+'  |  '+today, LM+(logoEl&&logoEl.complete?24:0), 34);
        y=56;
        doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,28,4,4,'F');
        doc.setFillColor(...scoreCol); doc.roundedRect(LM,y,6,28,2,2,'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(28); doc.setTextColor(...scoreCol);
        doc.text(sc+'%',LM+16,y+18);
        doc.setFontSize(12); doc.setTextColor(...DARK); doc.text(scoreBand,LM+44,y+12);
        doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(...MUTED);
        doc.text(band.desc,LM+44,y+19,{maxWidth:CW-50});
        doc.text(ansCount+'/'+TOTAL_Q+' questions answered',LM+44,y+25);
        y+=36;
        doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text('Strategy Breakdown',LM,y); y+=6;
        GROUPS.forEach(function(grp) {
          var s=computeSection(grp.key), p=s.pct===null?0:s.pct, col=p>=75?GREEN:p>=50?AMBER:RED;
          doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,12,2,2,'F');
          doc.setFillColor(...col); doc.roundedRect(LM,y,4,12,1,1,'F');
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...DARK);
          doc.text(grp.title,LM+8,y+7.5);
          var barX=LM+CW-60, barW=50;
          doc.setFillColor(226,232,240); doc.roundedRect(barX,y+4,barW,4,1,1,'F');
          if (p>0) { doc.setFillColor(...col); doc.roundedRect(barX,y+4,barW*(p/100),4,1,1,'F'); }
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...col);
          doc.text(s.pct===null?'-':p+'%',barX+barW+4,y+7.5);
          y+=15;
        });
        y+=4;
        var gaps=QUESTIONS.filter(function(q){ return state[q.id]===0||state[q.id]===1; });
        if (gaps.length) {
          doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
          doc.text('Priority Gaps',LM,y); y+=6;
          gaps.forEach(function(q) {
            if (y>270) { doc.addPage(); y=16; }
            var v=state[q.id], col=v===0?RED:AMBER, lbl=v===0?'NO':'PARTIAL';
            doc.setFillColor(...(v===0?[255,225,225]:[255,241,194]));
            doc.roundedRect(LM,y,CW,10,2,2,'F');
            doc.setFillColor(...col); doc.roundedRect(LM,y,3,10,1,1,'F');
            var lines=doc.splitTextToSize(q.label,CW-40);
            doc.setFont('helvetica','normal'); doc.setFontSize(8.5); doc.setTextColor(...DARK);
            doc.text(lines,LM+7,y+6.5);
            doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.setTextColor(...col);
            doc.text(lbl,W-RM-14,y+6.5);
            y+=13;
          });
        }
        doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(...MUTED);
        doc.text('Generated by Compliance365  |  compliance365.com.au  |  ASD Essential Eight Readiness Report',LM,290);
        doc.save('essential_eight_readiness_'+(orgName.replace(/[^a-z0-9]/gi,'-')||'report')+'.pdf');
      }
    })();
  </script>
</Base>
