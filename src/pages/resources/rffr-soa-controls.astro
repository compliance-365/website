---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DigestSignup from '../../components/DigestSignup.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import rffr from '../../data/rffr-controls.json';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const c = rffr.counts;
const autoPct = Math.round((c.microsoftAutomated / c.ismTotal) * 100);
const assessablePct = Math.round((c.microsoftAssessable / c.ismTotal) * 100);

// Human labels for the Microsoft posture checks that drive automation.
const CHECK_LABELS = {
  'mfa-all': 'MFA — all users (Conditional Access)',
  'mfa-priv': 'MFA — privileged users',
  'admins': 'Privileged / admin account limits',
  'pim': 'Just-in-time privileged access (PIM)',
  'access-review': 'Access re-validation & reviews',
  'patch': 'Patching & vulnerability scanning',
  'macro': 'Microsoft Office macro hardening',
  'wdac': 'Application control (WDAC)',
  'device': 'Managed / compliant devices (Intune)',
  'labels': 'Protective markings & sensitivity labels',
  'encryption': 'Encryption (ASD-approved cryptography)',
  'logging': 'Centralised event logging',
  'alerts': 'Antivirus / malicious-code protection',
  'backup': 'Backups & restoration testing'
};
const checkRows = Object.entries(rffr.microsoftChecks)
  .map(([id, ids]) => ({ id, label: CHECK_LABELS[id] || id, count: ids.length, controls: ids }))
  .sort((a, b) => b.count - a.count);

// Guideline coverage, in the workbook's own order.
const guidelines = rffr.guidelines;

// Controls grouped by guideline for rendering.
const controlsByCat = {};
for (const ctrl of rffr.controls) {
  (controlsByCat[ctrl.cat] ||= []).push(ctrl);
}

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'The RFFR Statement of Applicability — every ISM control, and what Microsoft 365 assesses automatically',
  description: `The complete RFFR / ISM ${rffr.ismVersion} Statement of Applicability: all ${c.ismTotal} ISM controls plus ${c.deeds} program-deed obligations, with Essential Eight and Microsoft 365 automation coverage marked.`,
  author: { '@type': 'Organization', name: 'Compliance365' },
  publisher: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  url: 'https://www.compliance365.com.au/resources/rffr-soa-controls/'
};
---

<Base
  title={`RFFR SoA Library — ${c.ismTotal} ISM Controls | Compliance365`}
  description={`Browse the complete RFFR / ISM ${rffr.ismVersion} Statement of Applicability — all ${c.ismTotal} ISM controls, filterable, with Microsoft 365 automation marked.`}
  ogImage="https://www.compliance365.com.au/og/og-rffr.png"
  schema={[articleLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Resources', url: 'https://www.compliance365.com.au/resources/' },
    { name: 'RFFR SoA control library', url: 'https://www.compliance365.com.au/resources/rffr-soa-controls/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">Right Fit For Risk · ISM {rffr.ismVersion} · Statement of Applicability</p>
        <h1>Every control in the RFFR SoA — and what automates.</h1>
        <p class="section-lead">
          The RFFR Statement of Applicability is {c.total} controls: {c.deeds} program-deed obligations and all {c.ismTotal} Australian Government ISM controls that apply to Non-Classified and OFFICIAL: Sensitive information, across {c.guidelines} guidelines. This is the whole list — filter it, and see which controls our Checkpoint console assesses automatically from your Microsoft 365 tenant.
        </p>
        <div class="hero-ctas">
          <a href={`${base}services/rffr/`} class="btn-hdk-primary">How we deliver RFFR →</a>
          <a href={ctaUrl} class="btn-hdk-ghost">Book a 30-min call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SUMMARY STAT STRIP -->
  <section class="section" style="padding-top:2.5rem;padding-bottom:2.5rem;">
    <div class="container">
      <div class="rffr-stats">
        <div><span class="n">{c.ismTotal}</span><span class="l">ISM controls</span></div>
        <div><span class="n">{c.deeds}</span><span class="l">RFFR deed obligations</span></div>
        <div><span class="n">{c.rffrCore}</span><span class="l">RFFR Core Expectations</span></div>
        <div><span class="n">{c.e8Mapped}</span><span class="l">Essential Eight mapped</span></div>
        <div><span class="n">{c.microsoftAutomated}</span><span class="l">auto-assessed today</span></div>
        <div><span class="n">~{assessablePct}%</span><span class="l">Microsoft-assessable</span></div>
      </div>
    </div>
  </section>

  <!-- AUTOMATION MATRIX -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">What Microsoft 365 assesses for you</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto 2.5rem;">
        Each read-only Microsoft Graph posture check maps to specific ISM controls. When Checkpoint scans your tenant, the live signal proposes an implementation status a practitioner confirms — no manual evidence gathering for the technical baseline. These {c.microsoftAutomated} controls are assessed directly; adding the {c.e8Mapped} Essential Eight-mapped controls (delivered through the bundled E8 module) brings the Microsoft-assessable share of the SoA to about {assessablePct}%. The controls beyond that (governance, personnel, physical, documentation, procurement) stay practitioner-assessed by design; a manual result is never silently counted as a pass.
      </p>
      <div class="rffr-table-wrap">
        <table class="rffr-table">
          <thead><tr><th>Microsoft posture check</th><th style="text-align:right;">ISM controls assessed</th><th>Example control IDs</th></tr></thead>
          <tbody>
            {checkRows.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td style="text-align:right;font-weight:700;color:var(--gold-ink);">{r.count}</td>
                <td class="muted small">{r.controls.slice(0, 4).join(', ')}{r.controls.length > 4 ? ` +${r.controls.length - 4}` : ''}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr><td style="font-weight:700;">{checkRows.length} checks</td><td style="text-align:right;font-weight:800;color:#8B6820;">{c.microsoftAutomated}</td><td class="muted small">distinct ISM controls (~{autoPct}% of the SoA)</td></tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <!-- THE FULL CONTROL LIBRARY -->
  <section class="section">
    <div class="container">
      <h2 class="center">The full control library</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto 2rem;">
        All {c.total} controls, grouped by guideline. Filter by guideline, or show only the RFFR Core Expectations, Essential Eight-mapped, or Microsoft-automated controls.
      </p>

      <!-- FILTERS -->
      <div class="rffr-filters" id="rffrFilters">
        <input type="search" id="rffrSearch" placeholder="Search control text or ID…" aria-label="Search controls" />
        <div class="rffr-toggles">
          <button class="rffr-chip on" data-filter="all">All ({c.total})</button>
          <button class="rffr-chip" data-filter="core">RFFR Core ({c.rffrCore})</button>
          <button class="rffr-chip" data-filter="e8">Essential Eight ({c.e8Mapped})</button>
          <button class="rffr-chip" data-filter="auto">Microsoft-assessed ({c.microsoftAutomated})</button>
        </div>
        <select id="rffrGuideline" aria-label="Filter by guideline">
          <option value="all">All guidelines</option>
          <option value="deeds">RFFR Obligations ({c.deeds})</option>
          {guidelines.map((g) => (
            <option value={g.cat}>{g.name.replace('Guidelines for ', '')} ({g.count})</option>
          ))}
        </select>
      </div>
      <p class="rffr-count" id="rffrCount"></p>

      <!-- RFFR OBLIGATIONS FIRST -->
      <div class="rffr-group" data-cat="deeds">
        <h3 class="rffr-group-h">RFFR Obligations <span class="muted">· {c.deeds} program-deed controls</span></h3>
        <div class="rffr-controls">
          {rffr.deeds.map((d) => (
            <div class="rffr-ctrl" data-core="1" data-e8="0" data-auto="0" data-text={(d.id + ' ' + d.text).toLowerCase()}>
              <div class="rffr-ctrl-head">
                <span class="rffr-id">{d.id}</span>
                <span class="rffr-badges">
                  <span class="badge core">RFFR Core</span>
                </span>
              </div>
              <p class="rffr-ctrl-text">{d.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- ISM CONTROLS BY GUIDELINE -->
      {guidelines.map((g) => (
        <div class="rffr-group" data-cat={g.cat}>
          <h3 class="rffr-group-h">{g.name.replace('Guidelines for ', '').replace(/^./, (m) => m.toUpperCase())} <span class="muted">· {g.count} controls · {g.automated} Microsoft-assessed</span></h3>
          <div class="rffr-controls">
            {(controlsByCat[g.cat] || []).map((ctrl) => (
              <div
                class="rffr-ctrl"
                data-core={ctrl.rffrCore ? '1' : '0'}
                data-e8={ctrl.e8 ? '1' : '0'}
                data-auto={ctrl.microsoft ? '1' : '0'}
                data-text={(ctrl.id + ' ' + ctrl.text).toLowerCase()}
              >
                <div class="rffr-ctrl-head">
                  <span class="rffr-id">{ctrl.id}</span>
                  <span class="rffr-badges">
                    {ctrl.rffrCore && <span class="badge core">RFFR Core</span>}
                    {ctrl.e8 && <span class="badge e8">{ctrl.e8}</span>}
                    {ctrl.microsoft && <span class="badge auto" title={CHECK_LABELS[ctrl.microsoft] || ctrl.microsoft}>Microsoft-assessed</span>}
                    {ctrl.classification.map((cl) => <span class="badge cls">{cl}</span>)}
                  </span>
                </div>
                <p class="rffr-ctrl-text">{ctrl.text}</p>
                {ctrl.topic && <p class="rffr-topic muted small">{ctrl.section} › {ctrl.topic}</p>}
              </div>
            ))}
          </div>
        </div>
      ))}

      <p class="rffr-empty" id="rffrEmpty" style="display:none;">No controls match those filters.</p>
    </div>
  </section>

  <!-- DISCLAIMER + CTA -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container center" style="max-width:820px;">
      <p class="muted small" style="margin-bottom:2rem;">
        Control text is reproduced from the Australian Government Information Security Manual ({rffr.ismVersion}), published by the Australian Signals Directorate, and the DEWR RFFR Statement of Applicability template. This library is provided as a reference; always work from the department's current SoA template and the latest ISM. "Microsoft-assessed" indicates a control our Checkpoint console can propose a status for from a live Microsoft Graph signal — every proposed status is confirmed by a practitioner before it enters the SoA.
      </p>
      <h2>Turn this list into an accredited SoA</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        We load this entire SoA into your own Microsoft 365 tenant, assess the technical baseline automatically, and drive the gaps to closure on an ISO 27001 ISMS backbone.
      </p>
      <div class="final-buttons" style="justify-content:center;display:flex;gap:1rem;flex-wrap:wrap;">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free 30-min call</a>
        <a href={`${base}services/rffr/`} class="btn-hdk-ghost">See how we deliver RFFR</a>
      </div>
    </div>
  </section>

  <!-- Digest signup -->
  <section class="container" style="padding-bottom:0;">
    <DigestSignup source="resource-rffr-soa-controls" />
  </section>

  </main>

  <Footer />
</Base>

<script>
  (function () {
    const groups = Array.from(document.querySelectorAll('.rffr-group'));
    const ctrls = Array.from(document.querySelectorAll('.rffr-ctrl'));
    const search = document.getElementById('rffrSearch');
    const guidelineSel = document.getElementById('rffrGuideline');
    const chips = Array.from(document.querySelectorAll('.rffr-chip'));
    const countEl = document.getElementById('rffrCount');
    const emptyEl = document.getElementById('rffrEmpty');
    let flag = 'all';

    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      const cat = guidelineSel.value;
      let shown = 0;
      ctrls.forEach((el) => {
        const okFlag = flag === 'all'
          || (flag === 'core' && el.dataset.core === '1')
          || (flag === 'e8' && el.dataset.e8 === '1')
          || (flag === 'auto' && el.dataset.auto === '1');
        const okText = !q || el.dataset.text.indexOf(q) !== -1;
        const show = okFlag && okText;
        el.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      groups.forEach((g) => {
        const catMatch = cat === 'all' || g.dataset.cat === cat;
        const anyVisible = Array.from(g.querySelectorAll('.rffr-ctrl')).some((el) => el.style.display !== 'none');
        g.style.display = catMatch && anyVisible ? '' : 'none';
      });
      // when a specific guideline is chosen, re-hide controls in other groups already handled by group display
      countEl.textContent = shown + ' control' + (shown === 1 ? '' : 's') + ' shown';
      emptyEl.style.display = shown === 0 ? '' : 'none';
    }

    search.addEventListener('input', apply);
    guidelineSel.addEventListener('change', function () {
      // selecting a guideline also scrolls the list into view softly
      apply();
    });
    chips.forEach((chip) => chip.addEventListener('click', function () {
      chips.forEach((x) => x.classList.remove('on'));
      chip.classList.add('on');
      flag = chip.dataset.filter;
      apply();
    }));
    apply();
  })();
</script>

<style>
  .rffr-stats { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .rffr-stats > div { background: #fff; border: 1px solid #DDD8CF; border-radius: 12px; padding: 1.1rem 1.6rem; text-align: center; min-width: 150px; flex: 1 1 150px; max-width: 220px; }
  .rffr-stats .n { display: block; font-size: 1.9rem; font-weight: 800; color: #A9812E; line-height: 1.1; }
  .rffr-stats .l { display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6B6860; margin-top: 0.35rem; }

  .rffr-table-wrap { overflow-x: auto; max-width: 860px; margin: 0 auto; }
  .rffr-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; background: #fff; }
  .rffr-table th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6B6860; padding: 0.65rem 0.9rem; border-bottom: 2px solid #DDD8CF; }
  .rffr-table td { padding: 0.6rem 0.9rem; border-bottom: 1px solid #EEE9E0; vertical-align: top; }
  .rffr-table tfoot td { border-top: 2px solid #DDD8CF; border-bottom: none; }

  .rffr-filters { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: center; margin-bottom: 0.75rem; }
  #rffrSearch { flex: 1 1 260px; max-width: 360px; padding: 0.6rem 0.9rem; border: 1px solid #DDD8CF; border-radius: 8px; font-size: 0.9rem; }
  #rffrGuideline { padding: 0.6rem 0.9rem; border: 1px solid #DDD8CF; border-radius: 8px; font-size: 0.9rem; background: #fff; }
  .rffr-toggles { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .rffr-chip { padding: 0.45rem 0.85rem; border: 1px solid #DDD8CF; background: #fff; border-radius: 20px; font-size: 0.82rem; cursor: pointer; color: #4A473F; }
  .rffr-chip.on { background: #A9812E; border-color: #A9812E; color: #fff; font-weight: 600; }
  .rffr-count { text-align: center; font-size: 0.82rem; color: #6B6860; margin: 0 0 1.5rem; }

  .rffr-group-h { border-bottom: 2px solid #DDD8CF; padding-bottom: 0.5rem; margin: 2.5rem 0 1.25rem; font-size: 1.1rem; }
  .rffr-group-h .muted { font-weight: 400; font-size: 0.85rem; }
  .rffr-controls { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
  .rffr-ctrl { border: 1px solid #EEE9E0; border-radius: 10px; padding: 1rem 1.1rem; background: #fff; }
  .rffr-ctrl-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .rffr-id { font-weight: 700; font-size: 0.82rem; color: #8B6820; font-family: ui-monospace, monospace; }
  .rffr-badges { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .badge { font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; padding: 2px 7px; border-radius: 10px; }
  .badge.core { background: rgba(169,129,46,0.1); color: #8B6820; }
  .badge.e8 { background: #dcfce7; color: #166534; }
  .badge.auto { background: #dbeafe; color: #1e40af; }
  .badge.cls { background: #f1f5f9; color: #475569; }
  .rffr-ctrl-text { font-size: 0.86rem; line-height: 1.5; margin: 0; color: #2E2B26; }
  .rffr-topic { margin: 0.5rem 0 0; font-size: 0.72rem; }
  .rffr-empty { text-align: center; color: #6B6860; padding: 2rem; }

  @media (max-width: 640px) {
    .rffr-controls { grid-template-columns: 1fr; }
  }
</style>
