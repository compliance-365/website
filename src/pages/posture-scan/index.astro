function graphCaller(token) {
  return async(path)=>{
    const base=path.startsWith("/beta")?"https://graph.microsoft.com":"https://graph.microsoft.com/v1.0";
    try { const r=await fetch(base+path,{headers:{Authorization:"Bearer "+token}}); if(!r.ok)return{ok:false,status:r.status}; return{ok:true,data:await r.json()}; }
    catch(e) { return{ok:false,status:"network"}; }
  };
}

/* ── PDF print ── */
window.psPrint = () => {
  const now = new Date().toLocaleDateString("en-AU",{day:"numeric",month:"long",year:"numeric"});
  const fwScores = Object.entries(FRAMEWORKS).map(([k,f])=>{
    const s=scoreFor(k);
    const col=s>=90?"#10B981":s>=60?"#A9812E":s>=30?"#D97706":"#EF4444";
    return `<div class="pv-score-card"><div class="pv-score-pct" style="color:${col}">${s}%</div><div class="pv-score-fw">${f.label}</div></div>`;
  }).join("");

  const allGaps = Object.keys(FRAMEWORKS).flatMap(fw => {
    const rows = rowsFor(fw).filter(r => r.status==="fail"||r.status==="partial");
    return rows.map(r=>({ fw:FRAMEWORKS[fw].label, title:r.title, status:r.status, effort:r.effort, remediation:r.remediation, portal:r.portal }));
  });
  const seen=new Set(); const deduped=allGaps.filter(g=>{ if(seen.has(g.title))return false; seen.add(g.title); return true; });
  const gapRows = deduped.map(g=>{
    const sc2=g.status==="fail"?"pv-status-fail":"pv-status-partial";
    const el2={quick:"Quick win",moderate:"Moderate",project:"Project"}[g.effort]||"";
    return `<tr>
      <td><strong>${g.title}</strong><br><span style="font-size:8.5pt;color:#64748B">${g.fw}</span></td>
      <td><span class="pv-status ${sc2}">${ST[g.status]}</span></td>
      <td style="color:#64748B;font-size:9pt">${el2}</td>
      <td style="font-size:9pt;color:#3A3632">${g.remediation}</td>
    </tr>`;
  }).join("");

  $("ps-print-view").innerHTML = `
    <div class="pv-header">
      <div class="pv-brand">Compliance<span>365</span></div>
      <div class="pv-meta">Compliance Posture Report<br>${tenantOrg}<br>${now}</div>
    </div>
    <div class="pv-body">
      <div class="pv-section-title">Framework Scores${secureScore!==null?` · MS Secure Score ${secureScore}%`:""}</div>
      <div class="pv-scores">${fwScores}</div>
      <div class="pv-section-title">Gaps Requiring Action (${deduped.length})</div>
      <table class="pv-gap-table">
        <thead><tr><th>Control</th><th>Status</th><th>Effort</th><th>Recommended Action</th></tr></thead>
        <tbody>${gapRows||"<tr><td colspan=4 style='color:#15803D;font-style:italic'>No gaps identified.</td></tr>"}</tbody>
      </table>
    </div>
    <div class="pv-footer">
      <span>Generated by Compliance365 Posture Scan · compliance365.com.au/posture-scan/</span>
      <span>Read-only scan · No data stored</span>
    </div>`;
  window.print();
};

/* ── capture ── */
function showCapture() {
  const panel=$("ps-capture"); if(!panel)return;
  const scores=Object.entries(FRAMEWORKS).map(([k,f])=>`${f.label}: ${scoreFor(k)}%`).join(" | ");
  const allRows=Object.keys(FRAMEWORKS).flatMap(fw=>rowsFor(fw).filter(r=>r.status==="fail"||r.status==="partial").map(r=>`[${fw.toUpperCase()}] ${r.title}: ${ST[r.status]}`));
  const gaps=[...new Set(allRows)];
  $("ps-f-tenant").value  = tenantOrg;
  $("ps-f-scores").value  = scores;
  $("ps-f-gaps").value    = gaps.join("\n");
  $("ps-f-summary").value = `Secure Score: ${secureScore!==null?secureScore+"%":"n/a"} | Gaps: ${gaps.length}`;
  panel.classList.remove("ps-hidden");
  const form=$("ps-capture-form");
  if(form&&!form._bound){ form._bound=true; form.addEventListener("submit",async e=>{
    e.preventDefault();
    const errEl=$("ps-capture-error");
    const submitBtn=form.querySelector(".ps-capture-submit");
    if(errEl) errEl.style.display="none";
    const name=$("ps-f-name").value.trim();
    const email=$("ps-f-email").value.trim();
    if(submitBtn) submitBtn.disabled=true;
    try {
      const res=await fetch(LEAD_API_URL,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          name, email,
          subject:"Free posture scan — remediation plan request",
          message:`Tenant: ${$("ps-f-tenant").value}\nScores: ${$("ps-f-scores").value}\nSummary: ${$("ps-f-summary").value}\nGaps:\n${$("ps-f-gaps").value}`
        })
      });
      if(!res.ok) throw new Error("Request failed: "+res.status);
      form.style.display="none"; $("ps-capture-sent").classList.add("show");
    } catch(err){
      console.error("Posture scan lead capture error:", err);
      if(errEl){ errEl.textContent="Could not send right now. Please email info@compliance365.com.au or try again."; errEl.style.display="block"; }
    } finally {
      if(submitBtn) submitBtn.disabled=false;
    }
  }); }
}

window.psReset = () => {
  scored={}; secureScore=null; tenantOrg="Your tenant"; showQuickWins=true; isDemoMode=false;
  $("ps-demo-banner").classList.add("ps-hidden");
  const panel=$("ps-capture");
  if(panel){ panel.classList.remove("ps-hidden"); panel.style.display=""; const f=$("ps-capture-form"); if(f){f.style.display="";f.reset();} const s=$("ps-capture-sent"); if(s)s.classList.remove("show"); }
  show("ps-intro");
};
