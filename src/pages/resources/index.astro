---
// src/pages/resources/index.astro
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const FORMSPREE = 'https://formspree.io/f/mnngvoqe';

// helper to resolve images under public/ with BASE_URL, but allow absolute URLs
function resolveImg(src: string | undefined) {
  if (!src) return null;
  if (/^https?:\/\//i.test(src)) return src;            // external
  return base + String(src).replace(/^\/+/, '');         // public/ path
}

const CARDS = [
  {
    title: 'ISO 27001 Readiness Checklist',
    desc: '10-point scorecard for scope, risk, controls, SoA and internal audit.',
    img: resolveImg('/assets/blog-iso27001-v3.svg'),
    target: base + 'checklist/iso27001'
  },
  {
    title: 'ISO 27701 (Privacy) Checklist',
    desc: 'ROPA, DPIA, rights handling, data lifecycle, privacy controls.',
    img: resolveImg('/assets/blog-iso27701-v3.svg'),
    target: base + 'checklist/iso27701'
  },
  {
    title: 'ISO 42001 (AI) Checklist',
    desc: 'AIMS governance, model inventory, AI risk, human oversight and monitoring.',
    img: resolveImg('/assets/blog-iso42001-v3.svg'),
    target: base + 'checklist/iso42001'
  },
];
---

<Base title="Resources — Compliance365" description="Free checklists, guides and webinar replays for ISO 27001, ISO 27701 and ISO 42001.">
  <Header />

  <section class="container section">
    <h1>Resources</h1>
    <p class="muted" style="max-width:760px">
      Practical tools to help you move faster—no fluff. Checklists now; whitepapers and webinar replays coming soon.
    </p>

    <div class="grid-3" style="margin-top:16px">
      {CARDS.map((c) => (
        <article class="card lift" style="display:flex;flex-direction:column;gap:12px">
          <div class="cover">
            {c.img ? (
              <img
                src={c.img}
                alt={c.title}
                width="960" height="420"
                style="width:100%;aspect-ratio:16/7;object-fit:cover;border-radius:12px;border:1px solid rgba(10,18,32,.06)"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <div class="cover-fallback" style="display:none;align-items:center;justify-content:center;aspect-ratio:16/7;border:1px dashed rgba(10,18,32,.15);border-radius:12px;background:linear-gradient(135deg, rgba(79,70,229,.06), rgba(6,182,212,.06));">
              <span class="muted">Preview unavailable</span>
            </div>
          </div>

          <h3 style="margin:.4rem 0 0">{c.title}</h3>
          <p class="muted">{c.desc}</p>

          <div style="margin-top:auto;display:flex;gap:10px;flex-wrap:wrap">
            <button class="btn btn-primary dl" data-target={c.target} type="button">Start checklist</button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Footer />

  <!-- Lead modal (shared) -->
  <div id="leadModal" role="dialog" aria-modal="true" aria-labelledby="leadTitle"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); align-items:center; justify-content:center; z-index:2500;">
    <div style="background:#fff; padding:22px; border-radius:16px; width:min(94vw,460px); box-shadow:0 16px 40px rgba(0,0,0,.18); border:1px solid rgba(10,18,32,.08)">
      <h3 id="leadTitle" style="margin:0 0 6px">Before you continue</h3>
      <p class="muted small" style="margin-top:0">Tell us where to send the checklist and related resources.</p>

      <form id="leadForm" novalidate>
        <input type="hidden" name="form-name" value="Resources Modal" />
        <label class="small" for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required
               style="width:100%;margin:6px 0 10px;padding:12px;border:1px solid #d8dde8;border-radius:10px">

        <label class="small" for="email">Work email</label>
        <input id="email" name="email" type="email" autocomplete="email" required
               style="width:100%;margin:6px 0 2px;padding:12px;border:1px solid #d8dde8;border-radius:10px">

        <p id="leadError" class="small" style="color:#b91c1c;display:none;margin:.25rem 0 0"></p>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:14px">
          <button type="button" class="btn btn-ghost" id="leadCancel">Cancel</button>
          <button type="submit" class="btn btn-primary" id="leadSubmit">Continue</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    const FORMSPREE = {JSON.stringify(FORMSPREE)};
    let pendingTarget = null;

    const modal = document.getElementById('leadModal');
    const form  = document.getElementById('leadForm');
    const err   = document.getElementById('leadError');
    const cancel= document.getElementById('leadCancel');
    const submitBtn = document.getElementById('leadSubmit');

    document.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.dl');
      if(!btn) return;
      pendingTarget = btn.dataset.target;
      err.style.display = 'none';
      form.reset();
      modal.style.display = 'flex';
      setTimeout(()=> document.getElementById('name').focus(), 0);
    });

    const close = ()=> { modal.style.display = 'none'; pendingTarget = null; };
    cancel.addEventListener('click', close);
    modal.addEventListener('click', (e)=>{ if(e.target === modal) close(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') close(); });

    function validEmail(v){ return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v); }

    form.addEventListener('submit', async (e)=>{
      e.preventDefault();
      err.style.display = 'none';

      const name  = (document.getElementById('name').value || '').trim();
      const email = (document.getElementById('email').value || '').trim();

      if(!name || !validEmail(email)){
        err.textContent = 'Please enter your name and a valid email.';
        err.style.display = 'block';
        return;
      }
      if(!pendingTarget){ close(); return; }

      submitBtn.disabled = true;

      try{
        await fetch(FORMSPREE, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, source: 'resources', intent: 'checklist', target: pendingTarget })
        });
      } finally {
        close();
        window.location.href = pendingTarget;
        submitBtn.disabled = false;
      }
    });
  </script>
</Base>
