---
import '../styles/responsive.css';
import Clarity from "../components/Clarity.astro";
import AIChat from "../components/AIChat.astro";

const {
  title = 'Compliance365 — Cyber, Privacy & AI Governance',
  description = 'ISO 27001, ISO 42001, ISO 27701 & SOC 2 delivered faster with automation and SharePoint evidence.',
  ogImage = (Astro.site
    ? new URL('assets/og-default.png', Astro.site).toString()
    : (import.meta.env.BASE_URL) + 'assets/og-default.png'),
  schema = [],
  breadcrumbs = [] // <-- new breadcrumb array support
} = Astro.props ?? {};
const base = import.meta.env.BASE_URL || '/';
const canonical = Astro.url?.href || 'https://www.compliance365.com.au/';
const LOGO_512 = 'https://www.compliance365.com.au/assets/logo.svg';
const LOGO_192 = 'https://www.compliance365.com.au/assets/logo-192.png';

// Base organization + website schema
const ORG = {
  "@type": ["Organization", "ProfessionalService"],
  "@id": "https://www.compliance365.com.au/#org",
  "name": "Compliance365",
  "legalName": "Compliance365 Pty Ltd",
  "alternateName": ["Compliance 365", "Compliance365 Australia"],
  "description": "Australian compliance consultancy delivering ISO 27001, SOC 2, Essential Eight and ISO 42001 inside your existing Microsoft 365 environment. Fixed-price. Audit-ready in 8–14 weeks.",
  "url": "https://www.compliance365.com.au",
  "logo": {
    "@type": "ImageObject",
    "url": LOGO_512,
    "width": 512,
    "height": 512
  },
  "image": LOGO_512,
  "telephone": "+61468752243",
  "email": "info@compliance365.com.au",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Brisbane",
    "addressRegion": "QLD",
    "addressCountry": "AU"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "info@compliance365.com.au",
    "telephone": "+61468752243",
    "areaServed": "AU",
    "availableLanguage": "English"
  },
  "sameAs": [
    "https://www.linkedin.com/company/compliance-365/",
    "https://www.facebook.com/compliance365AU"
  ],
  "serviceArea": { "@type": "Country", "name": "Australia" },
  "areaServed": { "@type": "Country", "name": "Australia" },
  "knowsAbout": [
    "ISO 27001","ISO 27701","ISO 42001","SOC 2",
    "ACSC Essential Eight","NIST CSF","IRAP","ISM","DISP"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Compliance Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 27001 Certification Support" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 27701 Privacy Management" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 42001 AI Governance" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SOC 2 Certification" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Essential Eight Assessment" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "DISP / ISM / IRAP Advisory" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "NIST CSF Implementation" } }
    ]
  }
};
const WEBSITE = {
  "@type": "WebSite",
  "@id": "https://www.compliance365.com.au/#website",
  "url": "https://www.compliance365.com.au",
  "name": "Compliance365",
  "inLanguage": "en-AU",
  "publisher": { "@id": "https://www.compliance365.com.au/#org" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.compliance365.com.au/search/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
// Breadcrumb Schema if breadcrumbs provided
const BREADCRUMB_SCHEMA = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url
      }))
    }
  : null;
// Merge graph items
const pageGraph = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const fullGraph = [ORG, WEBSITE];
if (BREADCRUMB_SCHEMA) fullGraph.push(BREADCRUMB_SCHEMA);
if (pageGraph.length) fullGraph.push(...pageGraph);
// Add “about” + “mentions” for entity clarity
fullGraph.push({
  "@type": "WebPage",
  "@id": canonical + "#webpage",
  "url": canonical,
  "name": title,
  "about": [
    "Cybersecurity compliance", "Privacy management", "AI governance",
    "ISO 27001", "ISO 27701", "ISO 42001", "SOC 2", "Essential Eight"
  ],
  "mentions": [
    "Australian Privacy Act", "NIST CSF", "IRAP", "ISM", "DISP"
  ]
});
const ldJson = JSON.stringify({ "@context": "https://schema.org", "@graph": fullGraph });
---
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <!-- Google Site Verification for Search Console ✅ -->
    <meta name="google-site-verification" content="fVhBOuNty9-ozH-lL9FvtPHiQ25rDMA7PjZIPDdgmbk" />
    <!-- Meta -->
    <meta name="description" content={description} />
    {Astro.props.robots
      ? <meta name="robots" content={Astro.props.robots} />
      : <meta name="robots" content="index,follow" />
    }
    <meta name="theme-color" content="#1e40af" />
    <!-- Discovery -->
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="https://www.compliance365.com.au/sitemap-index.xml" />
    <link rel="ai" href="https://www.compliance365.com.au/ai.txt" />
    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Compliance365" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Icons -->
    <link rel="icon" href="/assets/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload LCP asset -->
    <link rel="preload" as="image" href="/assets/logo.svg" fetchpriority="high" />
    <!-- Third-party prefetch -->
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://assets.apollo.io" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <!-- Preload + non-blocking load -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap"
      />
    </noscript>
    <!-- CSS -->
    <link rel="stylesheet" href={(import.meta.env.BASE_URL) + 'assets/brand.css'} />
    <!-- ✅ Quick baseline -->
    <style>
      body{font-family:Nunito,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;margin:0}
      a{color:var(--primary,#1e40af)}
      .container{max-width:1120px;margin:0 auto;padding:0 22px}
    </style>

<!-- Apollo.io Website Tracker – lazy loaded on first interaction -->
    <script is:inline>
      (function () {
        function loadApollo() {
          if (window.__apolloLoaded) return;
          window.__apolloLoaded = true;
          var n = Math.random().toString(36).substring(7),
              o = document.createElement('script');
          o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n;
          o.async = true;
          o.defer = true;
          o.onload = function () {
            window.trackingFunctions.onLoad({ appId: '691c50dec659750019914631' });
          };
          document.head.appendChild(o);
        }
        window.addEventListener('load', loadApollo);
        ['click', 'scroll', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadApollo, { once: true });
        });
      })();
    </script>

    <!-- Google Analytics 4 (GA4) – lazy loaded -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const GA_ID = 'G-082VYX6D26';
        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
        window.addEventListener('load', loadGA);
        ['click','scroll','keydown'].forEach(evt => {
          window.addEventListener(evt, loadGA, { once: true });
        });
      }
    </script>

    <!-- Bing Clarity tracking – lazy loaded on first interaction -->
    <script is:inline>
      (function () {
        function loadClarity() {
          if (window.__clarityLoaded) return;
          window.__clarityLoaded = true;
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "mghgmkzj0r");
        }
        window.addEventListener('load', loadClarity);
        ['click', 'scroll', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadClarity, { once: true });
        });
      })();
    </script>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={ldJson}></script>
  </head>
  <body>
    <slot />

  <!-- Floating messaging launcher (mobile only) -->
<div class="fab-msg">
  <button
    type="button"
    class="fab-main"
    aria-expanded="false"
    aria-controls="msgMenu"
    aria-label="Open messaging options"
  >
    <span class="fab-main-icon">💬</span>
  </button>
  <div id="msgMenu" class="msg-menu" hidden>
    <!-- Microsoft Teams -->
    <a
      href="https://teams.microsoft.com/l/chat/0/0?users=info@compliance365.com.au"
      target="_blank"
      rel="noopener"
      class="msg-item"
    >
      <span class="msg-ico-emoji">👔</span>
      <span>
        <strong>Microsoft Teams</strong>
        <span class="msg-sub">Chat with Compliance365 in Teams</span>
      </span>
    </a>
    <!-- Signal -->
    <a
      href="https://signal.me/#p/+61468752243"
      target="_blank"
      rel="noopener"
      class="msg-item"
    >
      <img src="/assets/icons/icon-signal.svg" alt="Signal" class="msg-ico" />
      <span>
        <strong>Signal</strong>
        <span class="msg-sub">Private & encrypted</span>
      </span>
    </a>
    <!-- WhatsApp – restored -->
    <a
      href="https://wa.me/61468752243?text=Hi%20C365%2C%20I%E2%80%99d%20like%20help%20with%20ISO%2027001%2C%20SOC%202%20or%20AI%20governance."
      target="_blank"
      rel="noopener"
      class="msg-item"
    >
      <img src="/assets/icons/icon-whatsapp.svg" alt="WhatsApp" class="msg-ico" />
      <span>
        <span>WhatsApp</span>
        <span class="msg-sub">Fast message or voice note</span>
      </span>
    </a>
    <!-- SMS – restored -->
    <a
      href="sms:+61468752243?body=Hi%20C365%2C%20I%E2%80%99d%20like%20help%20with%20compliance."
      class="msg-item"
    >
      <span class="msg-ico-emoji">📱</span>
      <span>
        <span>SMS</span>
        <span class="msg-sub">Text message</span>
      </span>
    </a>
    <!-- Email -->
    <a
      href="mailto:info@compliance365.com.au"
      class="msg-item"
    >
      <span class="msg-ico-emoji">✉️</span>
      <span>
        <span>Email</span>
        <span class="msg-sub">Share more detail</span>
      </span>
    </a>
  </div>
</div>

<!-- Call Now – restored -->
<a
  href="tel:+61468752243"
  class="fab-call"
  aria-label="Call Compliance365"
>
  📞
</a>

<!-- Desktop-only Microsoft Teams chat – restored -->
<a
  href="https://teams.microsoft.com/l/chat/0/0?users=info@compliance365.com.au&message=Hi%20Compliance365%2C%20I%E2%80%99d%20like%20help%20with%20ISO%2027001%2C%20SOC%202%20or%20AI%20governance."
  class="fab-teams"
  aria-label="Chat with Compliance365 on Microsoft Teams"
  target="_blank"
  rel="noopener"
>
  <img
    src="/assets/icons/icon-teams.svg"
    alt="Microsoft Teams"
    style="width:26px;height:26px;"
  />
</a>

    <!-- Optional FAQ JSON-LD slot -->
    <slot name="faq" />

    <!-- AI Chat Widget -->
    <AIChat />

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll animations
    const scrollElements = document.querySelectorAll('.animate-on-scroll');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    scrollElements.forEach(el => observer.observe(el));

    // Image load fade-in
    document.querySelectorAll('img').forEach(img => {
      img.addEventListener('load', () => img.classList.add('loaded'));
    });
  });
</script>

  </body>
</html>
