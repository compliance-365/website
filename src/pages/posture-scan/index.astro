/* ── gauge ── */
function gauge(pct) {
  const r=56, cx=72, cy=72, circ=2*Math.PI*r, off=circ*(1-pct/100);
  const col = pct>=90?"#10B981":pct>=60?"#A9812E":pct>=30?"#D97706":"#EF4444";
  return `<svg width="144" height="144" viewBox="0 0 144 144">
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#F1F5F9" stroke-width="11"/>
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${col}" stroke-width="11"
      stroke-linecap="round" stroke-dasharray="${circ.toFixed(2)}" stroke-dashoffset="${off.toFixed(2)}"
      transform="rotate(-90 ${cx} ${cy})" style="transition:stroke-dashoffset 1.2s ease"/>
  </svg>`;
}

/* ── render ── */
function render() {
  const sc   = scoreFor(activeTab);
  const allRows = sortRows(rowsFor(activeTab));
  const gaps       = allRows.filter(r => r.status !== "pass").length;
  const autoCount  = allRows.filter(r => r.method === "automated").length;
  const attestCount= allRows.length - autoCount;
  const passCount  = allRows.filter(r => r.status === "pass").length;
  const label = sc>=90?"Strong posture":sc>=60?"Approaching target":sc>=30?"Early maturity":"Significant gaps";

  $("ps-summarycard").innerHTML = `
    <div class="ps-gauge-wrap">${gauge(sc)}<div class="ps-gauge-label"><div class="ps-gauge-pct">${sc}%</div><div class="ps-gauge-word">readiness</div></div></div>
    <div class="ps-summary-body">
      <div class="ps-summary-org">${tenantOrg}</div>
      <div class="ps-summary-title">${label}</div>
      <div class="ps-summary-meta">${gaps} of ${allRows.length} controls need attention${secureScore!==null?` &nbsp;·&nbsp; MS Secure Score ${secureScore}%`:""}</div>
      <div class="ps-stat-pills">
        <span class="ps-stat-pill" style="background:#F0FDF4;color:#15803D"><span class="ps-stat-dot" style="background:#10B981"></span>${passCount} met</span>
        <span class="ps-stat-pill" style="background:rgba(169,129,46,0.08);color:#A9812E"><span class="ps-stat-dot" style="background:#A9812E"></span>${autoCount} automated</span>
        <span class="ps-stat-pill" style="background:#F5F3FF;color:#7C3AED"><span class="ps-stat-dot" style="background:#8B5CF6"></span>${attestCount} attested</span>
        ${prevScores ? `<span class="ps-stat-pill" style="background:#F1F5F9;color:#64748B"><span class="ps-stat-dot" style="background:#94A3B8"></span>Re-scan</span>` : ""}
      </div>
    </div>`;

  /* tabs */
  const tabsEl = $("ps-tabs"); tabsEl.innerHTML = "";
  Object.entries(FRAMEWORKS).forEach(([k, f]) => {
    const s  = scoreFor(k);
    const pr = prevScores?.[k];
    const delta = pr != null ? s - pr : null;
    const btn = document.createElement("button");
    btn.className = "ps-tab" + (k===activeTab?" active":"");
    if (k===activeTab) btn.style.background = f.color;
    let deltaHtml = "";
    if (delta !== null) {
      const cls = delta>0?"ps-trend-up":delta<0?"ps-trend-down":"ps-trend-same";
      deltaHtml = `<span class="ps-trend-badge ${cls}">${delta>0?"+":""}${delta}%</span>`;
    }
    btn.innerHTML = `<span class="ps-tab-dot" style="background:${k===activeTab?"rgba(255,255,255,.6)":f.dot}"></span><span>${f.label}</span><span class="ps-tab-score">${s}%</span>${deltaHtml}`;
    btn.onclick = () => { activeTab=k; render(); };
    tabsEl.appendChild(btn);
  });

  $("ps-controlslabel").textContent = FRAMEWORKS[activeTab].label+" Controls";
  $("ps-ctahead").textContent = `You're ${sc}% of the way there. Let's close the rest.`;

  /* quick wins filter */
  const gapRows = allRows.filter(r => r.status !== "pass");
  const quickWinRows = [...gapRows].sort((a,b) =>
    (EFFORT_ORDER[a.effort]??1)-(EFFORT_ORDER[b.effort]??1) || (b.weight||1)-(a.weight||1)
  ).slice(0, 5);
  const displayRows = showQuickWins ? quickWinRows : allRows;
  const totalGaps = gapRows.length;

  /* quick wins banner */
  const banner = $("ps-quickwins-banner");
  const toggle = $("ps-quickwins-toggle");
  if (showQuickWins) {
    banner.style.display = "";
    toggle.textContent = `Show all ${allRows.length} controls`;
    $("ps-controlscount").textContent = `Showing ${displayRows.length} of ${totalGaps} gaps`;
  } else {
    banner.style.display = "none";
    $("ps-controlscount").textContent = `${allRows.length} controls · ${autoCount} automated · ${attestCount} attested`;
  }

  /* control rows */
  const list = $("ps-rowlist"); list.innerHTML = "";
  displayRows.forEach(row => {
    const prevStatus = (() => {
      try { const p = JSON.parse(sessionStorage.getItem("ps_prev_statuses")||"{}"); return p[row.id]; } catch { return null; }
    })();
    const trendBadge = prevStatus && prevStatus !== row.status
      ? (row.status==="pass" && prevStatus!=="pass" ? `<span class="ps-trend-badge ps-trend-up">↑ Fixed</span>`
        : row.status!=="pass" && prevStatus==="pass" ? `<span class="ps-trend-badge ps-trend-down">↓ Regressed</span>`
        : `<span class="ps-trend-badge ps-trend-same">Changed</span>`)
      : "";
    const statusClass = {pass:"ps-badge-pass",partial:"ps-badge-partial",fail:"ps-badge-fail",attest:"ps-badge-attest"}[row.status]||"ps-badge-attest";
    const effortClass = {quick:"ps-effort-quick",moderate:"ps-effort-moderate",project:"ps-effort-project"}[row.effort]||"ps-effort-moderate";
    const effortLabel = {quick:"Quick win",moderate:"Moderate",project:"Project"}[row.effort]||"";
    const mlTag = row.frameworks.e8 && row.ml ? `<span class="ps-ml-badge">${getML(row.id,row.status)||row.ml}</span>` : "";
    const isGap = row.status === "fail" || row.status === "partial";
    const serviceCtaHtml = isGap && row.service
      ? `<a href="${row.service}" target="_blank" rel="noopener" class="ps-detail-service-cta">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          See how we remediate this
        </a>`
      : "";
    const div = document.createElement("div");
    div.className = "ps-control-row";
    div.innerHTML = `
      <button class="ps-row-head">
        <div class="ps-status-bar" style="background:${SC[row.status]||"#94A3B8"}"></div>
        <div class="ps-row-text">
          <div class="ps-row-title">${row.title}</div>
          <div class="ps-row-meta">
            <span class="ps-row-clause">${row.clause}</span>
            ${mlTag}
            ${effortLabel ? `<span class="ps-effort-badge ${effortClass}">${effortLabel}</span>` : ""}
            ${trendBadge}
          </div>
        </div>
        <span class="ps-method-badge ${row.method==="automated"?"ps-method-auto":"ps-method-attest"}">${row.method==="automated"?"Automated":"Attested"}</span>
        <span class="ps-status-badge ${statusClass}">${ST[row.status]||"Attest"}</span>
        <span class="ps-chevron">›</span>
      </button>
      <div class="ps-row-detail">
        <div class="ps-detail-text">${row.detail||""}</div>
        <div class="ps-detail-fix"><strong>Remediation:</strong> ${row.remediation}</div>
        ${row.portal ? `<div class="ps-detail-portal">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 8 12 12 14 14"/></svg>
          <code>${row.portal}</code>
        </div>` : ""}
        ${serviceCtaHtml}
      </div>`;
    const head=div.querySelector(".ps-row-head"), det=div.querySelector(".ps-row-detail"), chev=div.querySelector(".ps-chevron");
    head.onclick = () => { const open=det.classList.toggle("open"); chev.classList.toggle("open",open); };
    list.appendChild(div);
  });
}

/* ── run ── */
window.psRun = async () => {
  prevScores = loadPrev();
  showQuickWins = true;
  show("ps-loading"); $("ps-progressbar").style.width="5%";
  try {
    const app = new window.msal.PublicClientApplication({
      auth:{ clientId:CONFIG.CLIENT_ID, authority:`https://login.microsoftonline.com/${CONFIG.TENANT_ID}`,
             redirectUri:window.location.origin+window.location.pathname }
    });
    await app.initialize();
    $("ps-loadmsg").textContent="Waiting for sign-in…"; $("ps-loadsub").textContent="Complete authentication in the popup window";
    let res;
    try { res=await app.loginPopup({scopes:SCOPES}); } catch(e) { res=await app.loginPopup({scopes:SCOPES,prompt:"select_account"}); }
    $("ps-progressbar").style.width="15%";
    const tok=(await app.acquireTokenSilent({scopes:SCOPES,account:res.account})).accessToken;
    $("ps-loadmsg").textContent="Reading tenant signals…"; $("ps-loadsub").textContent="Querying Microsoft Graph endpoints"; $("ps-progressbar").style.width="20%";
    const g=graphCaller(tok);
    try { const o=await g("/organization"); if(o.ok&&o.data.value?.[0]) tenantOrg=o.data.value[0].displayName||tenantOrg; } catch{}
    try { const ss=await g("/security/secureScores?$top=1"); if(ss.ok&&ss.data.value?.[0]){const s=ss.data.value[0];secureScore=Math.round((s.currentScore/s.maxScore)*100);} } catch{}
    const auto=CONTROLS.filter(c=>c.method==="automated");
    for(let i=0;i<auto.length;i++){
      const c=auto[i];
      $("ps-loadmsg").textContent=`Evaluating: ${c.title}`; $("ps-loadsub").textContent=`${i+1} of ${auto.length} automated controls`;
      $("ps-progressbar").style.width=`${20+Math.round(((i+1)/auto.length)*75)}%`;
      try { scored[c.id]=await EVALUATORS[c.evaluator](g); } catch(e) { scored[c.id]={status:"fail",detail:"Evaluator error: "+e.message,degraded:true}; }
    }
    CONTROLS.filter(c=>c.method==="attested").forEach(c=>{ scored[c.id]={status:"attest",detail:"Manual evidence required — not readable from Graph."}; });
    $("ps-progressbar").style.width="100%";
    saveCurrent();
    const statuses=Object.fromEntries(CONTROLS.map(c=>[c.id,(scored[c.id]||{}).status]));
    sessionStorage.setItem("ps_prev_statuses",JSON.stringify(statuses));
    await new Promise(r=>setTimeout(r,300));
    render(); show("ps-results"); showCapture();
  } catch(err) {
    show("ps-intro");
    const msg = (err.message||err||"").toString();
    const isAdminConsent = msg.includes("AADSTS65001") || msg.includes("admin_consent_required") || msg.toLowerCase().includes("admin") && msg.toLowerCase().includes("consent") || msg.includes("interaction_required");
    const isPopupBlocked = !isAdminConsent && (msg.toLowerCase().includes("popup") || msg.toLowerCase().includes("blocked") || msg.includes("popup_window_error") || msg.includes("user_cancelled"));
    const w = $("ps-cfgwarn");
    if (isAdminConsent) {
      w.classList.add("ps-hidden");
      // Build and set the admin consent URL
      const consentUrl = "https://login.microsoftonline.com/organizations/adminconsent?client_id=" + CONFIG.CLIENT_ID + "&redirect_uri=" + encodeURIComponent(window.location.origin + window.location.pathname);
      var consentBtn = $("ps-consent-btn");
      consentBtn.href = consentUrl;
      var copyBtn = $("ps-copy-consent");
      copyBtn.addEventListener("click", function() {
        navigator.clipboard.writeText(consentUrl).then(function() {
          copyBtn.textContent = "Copied!";
          copyBtn.style.background = "#166534";
          copyBtn.style.color = "#fff";
          copyBtn.style.borderColor = "#166534";
          setTimeout(function(){ copyBtn.textContent="Copy consent link"; copyBtn.style.background=""; copyBtn.style.color="#A9812E"; copyBtn.style.borderColor=""; }, 2500);
        });
      });
      $("ps-admin-consent").classList.remove("ps-hidden");
    } else {
      w.textContent = isPopupBlocked ? "The sign-in popup was blocked or closed. See the tip below to allow popups and try again." : "Sign-in failed: " + msg;
      w.classList.remove("ps-hidden");
      $("ps-popup-tip").classList.remove("ps-hidden");
    }
  }
};

