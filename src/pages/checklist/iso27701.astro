---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27701 (Privacy)';

// One source of truth for questions (mirrors 27001 structure/UX)
const QUESTIONS = [
  // Leadership & ownership
  {
    id: 'pims-scope',
    group: 'gov',
    label: 'We have clearly defined what personal data we manage and where our privacy program applies.',
    hint: 'This defines what is in scope and out of scope for privacy management.',
    examples: [
      'A short scope statement listing systems, products, regions and teams handling personal data.',
      'A clear list of in-scope tools (e.g. CRM, support) and out-of-scope items (e.g. retired systems).',
      'Identification of key data types such as customer, employee or patient data.'
    ]
  },
  {
    id: 'roles-dpo',
    group: 'gov',
    label: 'Privacy ownership is assigned and responsibilities are documented (who decides, who does, who approves).',
    hint: 'This ensures accountability and clear decision-making.',
    examples: [
      'A named privacy owner or lead with documented responsibilities.',
      'Clear escalation paths for incidents, complaints and high-risk decisions.',
      'Defined approval roles for privacy assessments and responses.'
    ]
  },
  {
    id: 'policies',
    group: 'gov',
    label: 'We have up-to-date privacy policies and procedures that people follow in practice.',
    hint: 'Policies exist, are current, and are actually used.',
    examples: [
      'A current privacy notice published on your website or portal.',
      'Internal procedures for handling privacy requests and incidents.',
      'Documented retention, deletion and acceptable use rules.'
    ]
  },
  {
    id: 'objectives',
    group: 'gov',
    label: 'We track a small set of privacy targets so leaders can see progress.',
    hint: 'Leadership can see whether privacy is improving or declining.',
    examples: [
      'Targets for responding to privacy requests within a set timeframe.',
      'Regular reporting on incidents, complaints or near misses.',
      'Tracking privacy training completion rates.'
    ]
  },

  // Know your data
  {
    id: 'ropa',
    group: 'map',
    label: 'We maintain a current register of how and why we process personal data.',
    hint: 'This is your single source of truth for data processing.',
    examples: [
      'A register covering support, billing, marketing, product usage and HR.',
      'Each entry lists purpose, data types, systems, vendors and retention.',
      'The register is reviewed when new systems or vendors are introduced.'
    ]
  },
  {
    id: 'pii-flows',
    group: 'map',
    label: 'We can explain where personal data is collected, stored and shared.',
    hint: 'You understand how data moves across systems and vendors.',
    examples: [
      'A simple diagram showing data flow from collection to storage.',
      'A list of third parties receiving personal data.',
      'Identification of offshore hosting or access.'
    ]
  },
  {
    id: 'dpiA',
    group: 'map',
    label: 'We assess privacy risk before high-impact changes go live.',
    hint: 'Privacy risk is considered before launching or changing systems.',
    examples: [
      'Privacy assessments completed for new features or data uses.',
      'Reviews conducted when onboarding new vendors.',
      'Documented risks and agreed mitigations.'
    ]
  },

  // Everyday privacy controls
  {
    id: 'controls',
    group: 'ctrl',
    label: 'We only collect what we need, keep it only as long as needed, and restrict access appropriately.',
    hint: 'Privacy-by-design controls are in place.',
    examples: [
      'Defined retention periods for customer and employee data.',
      'Role-based access to sensitive information.',
      'Automated deletion or anonymisation when data is no longer needed.'
    ]
  },
  {
    id: 'consent',
    group: 'ctrl',
    label: 'Where consent is needed, we can prove it and show when it changed or was withdrawn.',
    hint: 'Consent decisions are traceable and auditable.',
    examples: [
      'Records showing when and how consent was captured.',
      'Preference management or opt-out capability.',
      'Audit logs of consent changes.'
    ]
  },
  {
    id: 'rights',
    group: 'ctrl',
    label: 'We can handle privacy requests from individuals within a defined timeframe.',
    hint: 'Requests are tracked, completed and evidenced.',
    examples: [
      'A workflow or ticket system for privacy requests.',
      'Identity checks before releasing personal data.',
      'Records showing responses were sent on time.'
    ]
  },
  {
    id: 'training',
    group: 'ctrl',
    label: 'Privacy training is assigned by role and we can show who completed it.',
    hint: 'People understand their privacy responsibilities.',
    examples: [
      'Mandatory privacy training for new starters.',
      'Additional training for high-risk roles.',
      'Completion reports reviewed by management.'
    ]
  },

  // Vendors & overseas data
  {
    id: 'processors',
    group: 'tp',
    label: 'We assess privacy risk in vendors and contracts define privacy expectations.',
    hint: 'Third-party privacy risks are understood and managed.',
    examples: [
      'Vendor risk assessments completed before onboarding.',
      'Privacy clauses included in supplier contracts.',
      'Ongoing review of vendors handling personal data.'
    ]
  },
  {
    id: 'xfer',
    group: 'tp',
    label: 'If personal data goes overseas, we assess and document transfer risks and safeguards.',
    hint: 'Cross-border data handling is understood and controlled.',
    examples: [
      'Identification of systems with offshore access or hosting.',
      'Documented assessment of overseas transfer risks.',
      'Controls to monitor and manage transfers.'
    ]
  },

  // Evidence & monitoring
  {
    id: 'evidence',
    group: 'ev',
    label: 'Privacy evidence is stored in one place with versioning so audits are easy.',
    hint: 'Evidence is centralised and audit-ready.',
    examples: [
      'Central storage of policies, registers and assessments.',
      'Version history enabled for key documents.',
      'Clear ownership for maintaining records.'
    ]
  },
  {
    id: 'metrics',
    group: 'ev',
    label: 'We report privacy activity so trends and repeat issues are visible.',
    hint: 'Metrics support informed decision-making.',
    examples: [
      'Regular reporting on requests, incidents and complaints.',
      'Trend analysis identifying recurring issues.',
      'Metrics reviewed by leadership.'
    ]
  },
  {
    id: 'iaudit',
    group: 'ev',
    label: 'We check privacy controls internally and track fixes through to completion.',
    hint: 'Issues are found early and resolved.',
    examples: [
      'Periodic internal privacy reviews.',
      'Findings with owners and due dates.',
      'Evidence that issues were fixed and verified.'
    ]
  },
  {
    id: 'review',
    group: 'ev',
    label: 'Leaders review privacy performance and decide priorities and improvements.',
    hint: 'Privacy is actively governed at leadership level.',
    examples: [
      'Management meetings covering privacy risks and metrics.',
      'Recorded decisions on funding or improvements.',
      'Follow-up actions tracked to completion.'
    ]
  }
];

const GROUPS = [
  { key:'gov', title:'Leadership & Ownership',      blurb:'Scope, ownership, policies and measurable targets.' },
  { key:'map', title:'Know Your Data',              blurb:'Your data register, where data flows, and how changes are assessed.' },
  { key:'ctrl',title:'Everyday Privacy Controls',   blurb:'Minimisation, access control, consent, requests and training.' },
  { key:'tp',  title:'Vendors & Overseas Data',     blurb:'Vendor checks, contracts, and overseas transfer safeguards.' },
  { key:'ev',  title:'Evidence & Monitoring',       blurb:'Evidence storage, reporting, internal checks and leadership review.' },
];

const ACRONYMS = [
  { key:'PIMS', name:'Privacy Information Management System', desc:'Your privacy governance, processes and evidence (how you manage personal information end-to-end).' },
  { key:'PII',  name:'Personal information (identifiable data)', desc:'Data that identifies a person, directly or indirectly (e.g., name, email, patient ID).' },
  { key:'DPO',  name:'Data Protection Officer (or privacy lead equivalent)', desc:'The person accountable for privacy oversight and advice (may be “Privacy Lead” in AU contexts).' },
  { key:'PO',   name:'Privacy Officer', desc:'The person/team running privacy operations day-to-day.' },
  { key:'ROPA', name:'Record of Processing Activities (processing register)', desc:'A register of what personal data you process, why, where it flows, who you share it with, and retention.' },
  { key:'DPIA', name:'Data Protection Impact Assessment (high-risk privacy assessment)', desc:'Used for high-risk processing or major changes to identify risks and safeguards.' },
  { key:'SRR',  name:'Subject Rights Request (privacy request)', desc:'Requests from individuals to access, correct, delete, export or object to data use.' },
  { key:'KPI',  name:'Key Performance Indicator', desc:'A measurable target, e.g., “respond to privacy requests within X days”.' },
  { key:'SLA',  name:'Service Level Agreement', desc:'A committed timeframe for completion/response (internal or customer-facing).' },
  { key:'DD',   name:'Due diligence', desc:'A structured vendor check before onboarding or renewal (data, controls, contracts, risk).' },
  { key:'DPA',  name:'Data Processing Agreement', desc:'Vendor contract terms governing personal data handling and security/privacy obligations.' },
  { key:'SCC',  name:'Standard Contractual Clauses', desc:'Standard terms often used to support international transfers in certain jurisdictions.' },
  { key:'TIA',  name:'Transfer Impact Assessment', desc:'Assessment of overseas transfer risks and safeguards.' },
  { key:'M365', name:'Microsoft 365', desc:'Where evidence may be stored (e.g., SharePoint) with retention/versioning.' },
];
---

<Base
  title="ISO 27701 Free Privacy Readiness Checklist"
  description="Free ISO 27701 privacy readiness checklist for privacy officers, CISOs and compliance leaders. Assess PIMS maturity, see your readiness score and download a PDF roadmap to certification."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 27701 privacy readiness checklist (free)</h1>
    <p class="muted" style="max-width:800px">
      Use this free ISO 27701 readiness checklist to quickly assess how mature your Privacy Information Management System (PIMS) is.
      Score governance, data mapping, DPIAs, privacy controls, third-party processors and monitoring to see how ready you are for ISO 27701 certification.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">
          Gauge ISO 27701 PIMS maturity and how ready your privacy operations are for internal or external audit.
        </p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small"><strong>Yes / Partial / No</strong>. Progress and readiness update automatically.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown and next-step guidance.</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill" aria-current="page">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 6px;">
  {q.label}
</label>

{q.hint && (
  <div class="muted small" style="margin:0 0 8px;">
    {q.hint}
  </div>
)}

{q.examples?.length && (
  <details style="margin:0 0 10px;">
    <summary
      class="small"
      style="cursor:pointer;font-weight:700;color:#4F46E5;"
    >
      Show examples
    </summary>
    <ul class="small" style="margin:8px 0 0;padding-left:18px;">
      {q.examples.map(example => (
        <li>{example}</li>
      ))}
    </ul>
  </details>
)}
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>

<div class="card" style="margin-top:14px">
  <h3 style="margin:0 0 8px">Acronym guide (plain English)</h3>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:10px;">
    {ACRONYMS.map((a) => (
      <div style="border:1px solid rgba(10,18,32,.08); border-radius:12px; padding:10px; background:#fff;">
        <div style="font-weight:900">{a.key} — {a.name}</div>
        <div class="muted small" style="margin-top:4px">{a.desc}</div>
      </div>
    ))}
  </div>
</div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
(() => {
  'use strict';

  const STANDARD  = "ISO 27701 (Privacy)";
  const API_URL   = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  const GROUPS = [
    { key:'gov',  title:'Governance & PIMS' },
    { key:'map',  title:'Data Mapping & DPIA' },
    { key:'ctrl', title:'Controls & Rights' },
    { key:'tp',   title:'Third Parties & Transfers' },
    { key:'ev',   title:'Evidence & Monitoring' },
  ];

  const QUESTIONS = [
    { id:"pims-scope", label:"PIMS scope defined (PII types, purposes, jurisdictions, boundaries)?", group:"gov" },
    { id:"roles-dpo",  label:"Privacy roles assigned (DPO/PO, owners) and responsibilities documented?", group:"gov" },
    { id:"policies",   label:"Privacy policy set approved (notices, consent, retention, incident, SRR)?", group:"gov" },
    { id:"objectives", label:"Privacy objectives/KPIs defined and reviewed (e.g., SRR SLAs, training)?", group:"gov" },

    { id:"ropa",       label:"Record of Processing Activities (ROPA) maintained with lawful bases?", group:"map" },
    { id:"pii-flows",  label:"PII data flows mapped (collection, systems, processors, transfers)?", group:"map" },
    { id:"dpiA",       label:"DPIA methodology in place; DPIAs run for high-risk processing?", group:"map" },

    { id:"controls",   label:"Privacy controls implemented (minimisation, retention, access restriction)?", group:"ctrl" },
    { id:"consent",    label:"Consent/withdrawal and preference management is captured and auditable?", group:"ctrl" },
    { id:"rights",     label:"Subject rights requests (access, erase, rectify, portability, object) handled with SLA?", group:"ctrl" },
    { id:"training",   label:"Role-based privacy training tracked with completion records?", group:"ctrl" },

    { id:"processors", label:"Processor DD completed; DPAs/SCCs in place; sub-processor changes tracked?", group:"tp" },
    { id:"xfer",       label:"Cross-border transfer assessments done (SCCs/TIAs/LOCs) and monitored?", group:"tp" },

    { id:"evidence",   label:"Evidence stored in M365 (SharePoint/Purview/Entra/Intune) with retention/versioning?", group:"ev" },
    { id:"metrics",    label:"Privacy metrics reported (SRR volumes, breaches, DPIA counts, training)?", group:"ev" },
    { id:"iaudit",     label:"Internal privacy audits completed; findings & CAPAs tracked to closure?", group:"ev" },
    { id:"review",     label:"Management review covers PIMS performance, risks, complaints, improvements?", group:"ev" }
  ];

  (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

  function setup(){
    const form       = document.getElementById('form');
    const bar        = document.getElementById('bar');
    const scoreNum   = document.getElementById('scoreNum');
    const scoreLabel = document.getElementById('scoreLabel');
    const scoreHint  = document.getElementById('scoreHint');
    const resetBtn   = document.getElementById('resetBtn');
    const pdfBtn     = document.getElementById('pdfBtn');

    const modal      = document.getElementById('leadModal');
    const leadForm   = document.getElementById('leadForm');
    const cancelLead = document.getElementById('cancelLead');
    const nameEl     = document.getElementById('name');
    const emailEl    = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    function refreshGroupCounters(){
      GROUPS.forEach(grp => {
        const total = QUESTIONS.filter(q=>q.group===grp.key).length;
        const ansd  = QUESTIONS.filter(q=>q.group===grp.key).map(q=>state[q.id]).filter(v=>v!==null).length;
        const el = document.getElementById('g-'+grp.key);
        if(el) el.textContent = `${ansd}/${total} answered`;
      });
    }
    refreshGroupCounters();

    form?.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.opt'); if(!btn || !form.contains(btn)) return;
      const field = btn.closest('.field'); if(!field) return;
      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);
      state[id] = val;
      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');
      refreshGroupCounters();
      update();
    });

    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form?.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
      refreshGroupCounters();
      update();
    });

    pdfBtn?.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if(modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

    leadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name  = (nameEl?.value || '').trim();
      const email = (emailEl?.value || '').trim();

      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('Please enter your name and a valid email.');
        return;
      }

      const Q_MIN = QUESTIONS.map(q => ({ id: q.id, label: q.label, group: q.group }));
      const G_MIN = GROUPS.map(g => ({ key: g.key, title: g.title }));

      const payload = {
        name,
        email,
        subject: `Checklist lead: ${STANDARD}`,
        message: JSON.stringify({
          checklist: STANDARD,
          checklistId: 'iso27701',
          timestamp: new Date().toISOString(),
          ua: navigator.userAgent,
          ...compute(state),
          total: QUESTIONS.length,
          answers: state,
          questions: Q_MIN,
          groups: G_MIN
        })
      };

      try {
        if (!API_URL) throw new Error('API_URL missing');
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const txt = await res.text().catch(()=> '');
        if (!res.ok) {
          console.warn('[27701 lead] POST failed:', res.status, txt);
          alert('We could not notify our team automatically, but your PDF will still download.');
        }
      } catch (err) {
        console.warn('[27701 lead] POST error:', err);
        alert('We could not notify our team automatically, but your PDF will still download.');
      }

      try {
        const s = compute(state);
        if (window.gtag) {
          window.gtag('event', 'checklist_submit', {
            event_category: 'Checklist',
            event_label: STANDARD,
            checklist_standard: STANDARD,
            checklist_id: 'iso27701',
            answered: s.answered,
            score: s.score
          });
        }
      } catch (err) {
        console.warn('GA4 checklist_submit event failed', err);
      }

      closeModal();
      generatePDF(state, { name, email });
    });

    const s = document.createElement('style');
    s.textContent = `button.opt{cursor:pointer}
      button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
    document.head.appendChild(s);

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);
      if (bar) bar.style.width = pct + '%';
      if (scoreNum) scoreNum.textContent = `${score}%`;

      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered === 0) {
        label = 'Not started';
        hint  = 'Answer the questions to see your readiness.';
      } else if (score <= 30) {
        label = 'High Risk (0–30)';
        hint  = 'Focus on PIMS scope, ownership, core privacy policies, and a defensible ROPA/DPIA baseline.';
      } else if (score <= 60) {
        label = 'Partially Ready (31–60)';
        hint  = 'Prioritise missing fundamentals (SRR process, processors/DPAs, transfer assessments, evidence).';
      } else if (score <= 85) {
        label = 'Nearly Audit-Ready (61–85)';
        hint  = 'Close minor gaps and focus on evidence packaging, review cadence, and internal audit readiness.';
      } else {
        label = 'Certification-Ready (86–100)';
        hint  = 'Focus on validation, evidence consistency and audit preparation.';
      }

      if (scoreLabel) scoreLabel.textContent = label;
      if (scoreHint)  scoreHint.textContent  = hint;
    }
  }

  function compute(state){
    const answered = Object.values(state).filter(v => v !== null).length;
    const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
    const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
    return { answered, score: isNaN(score) ? 0 : score };
  }

  function getBand(score, answered){
    if (!answered) return { key:'na', title:'Not started', desc:'Complete the checklist to generate your Trust Score.' };
    if (score <= 30) return { key:'hr',  title:'0–30 — High Risk',             desc:'Missing privacy foundations. Structured remediation required.' };
    if (score <= 60) return { key:'pr',  title:'31–60 — Partially Ready',      desc:'Core elements exist. Prioritisation and closure of key gaps needed.' };
    if (score <= 85) return { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close minor gaps and package evidence for audit.' };
    return              { key:'cr',      title:'86–100 — Certification-Ready', desc:'Controls largely in place. Focus on validation and audit packaging.' };
  }

  function drawTrustBands(doc, x, y, w, score, answered){
    const pad = 6;
    const rowH = 18;
    const gap = 6;

    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('What Your Trust Score Really Means', x, y);
    y += 6;

    doc.setFont('helvetica','normal');
    doc.setFontSize(10);
    doc.setTextColor(80);
    doc.text('Your ISO 27701 Trust Score shows how close you already are to certification.', x, y);
    y += 8;

    if (!answered) {
      doc.setFillColor(243,244,246);
      doc.setDrawColor(229,231,235);
      doc.roundedRect(x, y, w, rowH, 3, 3, 'FD');

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text('Not started', x + pad, y + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(80);
      doc.text('Answer the questions to generate your Trust Score and PDF roadmap.', x + pad, y + 14);

      return y + rowH + 2;
    }

    const rows = [
      { key:'hr',  title:'0–30 — High Risk',              desc:'Missing privacy foundations. Structured remediation required.' },
      { key:'pr',  title:'31–60 — Partially Ready',       desc:'Core elements exist. Prioritisation and closure of key gaps needed.' },
      { key:'nar', title:'61–85 — Nearly Audit-Ready',    desc:'Close minor gaps and package evidence for audit.' },
      { key:'cr',  title:'86–100 — Certification-Ready',  desc:'Controls largely in place. Focus on validation and audit packaging.' },
    ];

    const fills = {
      hr:  [254,226,226],
      pr:  [224,231,255],
      nar: [254,249,195],
      cr:  [209,250,229],
    };

    const band = getBand(score, answered);

    rows.forEach((r, i) => {
      const yy = y + i * (rowH + gap);

      const fc = fills[r.key];
      doc.setFillColor(fc[0], fc[1], fc[2]);
      doc.setDrawColor(229,231,235);
      doc.setLineWidth(0.2);
      doc.roundedRect(x, yy, w, rowH, 4, 4, 'FD');

      if (r.key === band.key) {
        doc.setDrawColor(79,70,229);
        doc.setLineWidth(0.8);
        doc.roundedRect(x, yy, w, rowH, 4, 4, 'S');

        doc.setFillColor(79,70,229);
        doc.roundedRect(x + 2, yy + 2, 3, rowH - 4, 2, 2, 'F');
      }

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text(r.title, x + pad + 4, yy + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(55);
      const lines = doc.splitTextToSize(r.desc, w - (pad * 2) - 8);
      doc.text(lines, x + pad + 4, yy + 14);
    });

    const chip = `Your score: ${score}%`;
    doc.setFont('helvetica','bold'); doc.setFontSize(10);
    const chipW = Math.max(28, doc.getTextWidth(chip) + 10);
    const chipH = 8;
    const chipX = x + w - chipW;
    const chipY = y - 10;

    doc.setFillColor(17,24,39);
    doc.setTextColor(255,255,255);
    doc.roundedRect(chipX, chipY, chipW, chipH, 3, 3, 'F');
    doc.text(chip, chipX + chipW / 2, chipY + 5.6, { align:'center' });

    return y + rows.length * (rowH + gap) - gap + 2;
  }

  function generatePDF(state, lead = {}) {
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ alert('PDF library not loaded.'); return; }

    const doc = new jsPDF('p','mm','a4');
    const W = 210, LM = 14, RM = 14; let y = 16;
    const now = new Date();
    const fmt = d => d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
    const hr  = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

    const vals      = Object.values(state);
    const answered  = vals.filter(v => v !== null).length;
    const scoreRaw  = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const score     = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
    const band      = getBand(score, answered);
    const STATUS    = answered === 0 ? 'Not started' : band.title;

    doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
    doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

    try {
      const logoEl = document.getElementById('pdfLogo');
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);

      if (logoEl && logoEl.complete) {
        const targetW = 18;
        const ratio   = (logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
        const targetH = Math.min(18, targetW * ratio);
        doc.addImage(logoEl,'PNG',LM,6,targetW,targetH,undefined,'FAST');
        doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM + targetW + 4, 22);
      } else {
        doc.text('Compliance365 — Readiness Report', LM, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM, 22);
      }
    } catch (_) {
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text(`${STANDARD} quick-scan summary`, LM, 22);
    }

    doc.setFontSize(10);
    doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
    if (lead?.name || lead?.email) {
      const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
      doc.text(prepared, W-RM, 22, { align:'right' });
    }

    y = 38;
    doc.setTextColor(17,24,39); doc.setFont('helvetica','bold'); doc.setFontSize(13);
    doc.text('Your Readiness at a Glance', LM, y); y += 8;

    const dialX = LM + 26, dialY = y + 24;
    doc.setDrawColor(230,233,242); doc.setLineWidth(6);
    doc.circle(dialX, dialY, 20, 'S');
    doc.setDrawColor(79,70,229);
    const pct = Math.max(0,Math.min(score,100))/100;
    const segs = Math.max(1, Math.round(60*pct));
    for(let i=0;i<segs;i++){
      const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
      const a2 = a1 + 0.1;
      doc.line(
        dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
        dialX+20*Math.cos(a2), dialY+20*Math.sin(a2)
      );
    }
    doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
    doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
    doc.text('Status:',    LM+56, y+12);
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
    doc.text(STATUS, LM+56 + 18, y+12);

    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    doc.text('What this means:', LM+56, y+20);
    const meaningLines = doc.splitTextToSize(band.desc || 'Complete the checklist to generate your Trust Score.', 210 - 14 - 14 - (56));
    doc.text(meaningLines, LM+56, y+26);

    const tips = (!answered)
      ? ['Complete the checklist to generate your Trust Score and PDF roadmap.']
      : (score <= 30)
        ? ['Confirm PIMS scope, ownership and core policies', 'Stand up ROPA + DPIA triggers and workflow', 'Prioritise SRR, retention and evidence capture first']
        : (score <= 60)
          ? ['Close key gaps auditors test early (ROPA/DPIAs, SRR, processors)', 'Tighten transfer assessments (SCCs/TIAs)', 'Improve evidence consistency (who/what/when)']
          : (score <= 85)
            ? ['Close minor gaps from “Partial/No” items', 'Prepare evidence pack (ROPA, DPIAs, SRR logs, DPAs)', 'Schedule internal audit + management review cadence']
            : ['Validate evidence is current and traceable', 'Run a light internal audit check', 'Prepare the audit pack and plan certification'];

    let tipsY = y + 26 + (meaningLines.length * 5) + 4;
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39); doc.setFontSize(10);
    doc.text('Next steps:', LM+56, tipsY);
    tipsY += 6;
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, tipsY + i*5));

    y += 64;

    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Domain Breakdown', LM, y); y += 5;

    const DOMAINS = {};
    (Array.isArray(GROUPS)?GROUPS:[]).forEach(g => {
      DOMAINS[g.title] = (Array.isArray(QUESTIONS)?QUESTIONS:[])
        .filter(q => q.group === g.key)
        .map(q => q.id);
    });

    Object.entries(DOMAINS).forEach(([name, ids])=>{
      const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
      const max = ids.length * 2 || 1;
      const p   = Math.round((got/max)*100) || 0;

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      doc.text(name, LM, y+5);

      const barX = LM + 64, barW = W - LM - RM - 64;
      doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
      doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
      const fillW = Math.max(0, Math.min(barW*(p/100), barW));
      doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

      doc.setFont('helvetica','bold'); doc.setTextColor(70);
      doc.text(`${p}%`, barX + barW + 4, y+5);

      y += 11;
    });

    y = hr(y, 6);

    if (y > 180) { doc.addPage(); y = 16; }
    y = drawTrustBands(doc, LM, y, (W - LM - RM), score, answered) + 6;

    /* ================================
       UPDATED: Top Gaps & Risks block
       (ISO27001-equivalent structure)
       ================================ */

    // Always start Top Gaps on a new page
    doc.addPage();
    y = 16;

    // Optional divider
    y = hr(y, 6);

    // Top Gaps & Risks
    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('Top Gaps & Risks', LM, y);
    y += 6;

    const GAP = {
      'pims-scope':
        'Risk: An unclear PIMS scope may result in uncontrolled PII processing, missed obligations, and audit nonconformance.',

      'roles-dpo':
        'Risk: Unclear privacy ownership/DPO responsibilities may weaken accountability, decision-making and operational oversight.',

      'policies':
        'Risk: Missing or outdated privacy policies and procedures may lead to inconsistent handling of PII and privacy requests.',

      'objectives':
        'Risk: Without measurable privacy objectives/KPIs, management visibility and continual improvement of the PIMS is reduced.',

      'ropa':
        'Risk: An incomplete ROPA may undermine lawful basis traceability, transparency, and defensible compliance posture.',

      'pii-flows':
        'Risk: Unmapped PII data flows increase the likelihood of unknown transfers, shadow processing, and uncontrolled disclosure.',

      'dpiA':
        'Risk: Not running DPIAs for high-risk processing can increase harm to individuals and raise regulatory and contractual exposure.',

      'controls':
        'Risk: Weak privacy-by-design controls can cause over-collection, excessive retention, and access drift across systems.',

      'consent':
        'Risk: Non-auditable consent/withdrawal evidence can lead to unlawful processing and customer complaints or disputes.',

      'rights':
        'Risk: Weak subject rights request (SRR) workflows may result in missed SLAs, escalation, and regulatory enforcement action.',

      'training':
        'Risk: Incomplete role-based privacy training increases human error and weakens audit evidence of awareness and competence.',

      'processors':
        'Risk: Weak processor due diligence and contracts (DPAs/SCCs) increase third-party privacy incidents and contractual noncompliance.',

      'xfer':
        'Risk: Missing cross-border transfer assessments (SCCs/TIAs/LOCs) increase the risk of unlawful transfers and enforcement.',

      'evidence':
        'Risk: Evidence not centralised and version-controlled reduces audit readiness and traceability of privacy controls and decisions.',

      'metrics':
        'Risk: Missing privacy metrics reduces management’s ability to detect trends, hotspots, and resource requirements.',

      'iaudit':
        'Risk: Not performing internal privacy audits can allow nonconformities and control gaps to persist until external audit.',

      'review':
        'Risk: Incomplete management reviews can weaken governance and delay corrective action and continual improvement.'
    };

    const highs = [], meds = [];
    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach(q=>{
      const v = state[q.id];
      if (v===0) highs.push(GAP[q.id] || q.label);
      else if (v===1) meds.push(GAP[q.id] || q.label);
    });

    const colW = (W - LM - RM - 6)/2;

    const drawList = (title, items, x, titleColor, accentColor) => {
      if (!items.length) return y;

      // Title
      doc.setFont('helvetica','bold');
      doc.setFontSize(11);
      doc.setTextColor(...titleColor);
      doc.text(title, x, y);

      // Body
      let yy = y + 5;
      doc.setFont('helvetica','normal');
      doc.setFontSize(10);
      doc.setTextColor(17,24,39);

      items.forEach((t) => {
        const lines = doc.splitTextToSize(`• ${t}`, colW);
        doc.text(lines, x, yy);
        yy += (lines.length * 4.6) + 1.5;
      });

      // Left accent bar sized to actual rendered height
      doc.setDrawColor(...accentColor);
      doc.setLineWidth(3);
      doc.line(x - 3, y - 2, x - 3, yy - 2);

      return yy;
    };

    // IMPORTANT: pass BOTH titleColor and accentColor
    const yLeftEnd = drawList(
      'High (No): address first',
      highs,
      LM,
      [239,68,68],
      [239,68,68]
    );

    const yRightEnd = drawList(
      'Medium (Partial): tighten next',
      meds,
      LM + colW + 6,
      [99,102,241],
      [99,102,241]
    );

    y = Math.max(yLeftEnd, yRightEnd) + 4;
    y = hr(y, 4);

    // Detailed Responses
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Detailed Responses', LM, y); y += 5;

    const drawRow = (idx, text, val)=>{
      if(y>275){ doc.addPage(); y=16; }
      const wrapW = W - LM - RM - 40;
      const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
      const rowH  = 12 + Math.max(0, lines.length-1)*4.2;

      doc.setFillColor(245,247,255);
      doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(lines, LM+4, y+4);

      const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
      let fill=[229,231,235], txt=[107,114,128];
      if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
      else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
      else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      const pillW = Math.max(22, doc.getTextWidth(label) + 8);
      const chipX = W - RM - pillW - 4;
      const chipY = y - 1;
      doc.setDrawColor(222,226,236);
      doc.setFillColor(...fill);
      doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
      doc.setTextColor(...txt);
      doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

      y += rowH + 8;
    };

    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

    // CTA (band-aware label)
    if(y>246){ doc.addPage(); y=16; }
    y += 4;
    const btnW = 178, btnH = 18, btnX = LM, btnY = y;
    doc.setFillColor(79,70,229);
    doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);

    const ctaText =
      (!answered) ? 'Book a roadmap call' :
      (score <= 30) ? 'Book a scope + remediation roadmap call' :
      (score <= 60) ? 'Book a prioritised remediation roadmap call' :
      (score <= 85) ? 'Book an evidence + audit prep roadmap call' :
                      'Book certification support (audit readiness)';

    doc.text(ctaText, btnX + 6, btnY + 12);
    doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
    doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

    doc.save('iso27701_readiness.pdf');
  }
})();
</script>

  <!-- Lead capture modal (same markup as 27001) -->
  <div id="leadModal"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); align-items:center; justify-content:center; z-index:2000;">
    <div style="background:#fff; padding:24px; border-radius:14px; max-width:400px; width:100%; box-shadow:0 12px 30px rgba(0,0,0,.2);">
      <h3 style="margin-top:0">Before you download</h3>
      <p class="muted small">
        Enter your details to receive this ISO 27701 readiness report and occasional privacy, security and AI governance updates:
      </p>
      <form id="leadForm">
        <input type="text" id="name" placeholder="Your name" style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px">
        <input type="email" id="email" placeholder="Your email" style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px">

        <p class="muted tiny" style="margin-top:6px">
          By submitting, you agree to receive relevant updates from Compliance365. You can unsubscribe at any time.
        </p>

        <div style="display:flex; gap:10px; margin-top:12px; justify-content:flex-end;">
          <button type="button" class="btn btn-ghost" id="cancelLead">Cancel</button>
          <button type="submit" class="btn btn-primary">Email my PDF report</button>
        </div>
      </form>
    </div>
  </div>
