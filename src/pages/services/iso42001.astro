---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 42001 (AIMS) Implementation & AI Governance Consulting',
  serviceType: 'ISO 42001 AI Governance',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso42001',
  description:
    'Stand up an AI Management System (AIMS): model inventory, AI risk & impact assessments, human oversight, monitoring and audit trail — with evidence automated in Microsoft 365 & SharePoint.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is ISO 42001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 42001 is the global standard for responsible AI governance. It defines an AI Management System (AIMS) that covers model inventory, risk assessment, human oversight, monitoring and continuous improvement.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need new AI-specific tools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We build your AIMS using your existing Microsoft 365 environment — evidence and controls live where your team already works.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does ISO 42001 take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most teams achieve readiness in 8–14 weeks with focused scope and automation. We prioritize high-risk AI use cases first.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can you help with customer or procurement questions about AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — we prepare clear, reusable evidence packs and answers for AI risk, oversight and monitoring, so you can confidently respond to buyers, partners and regulators.'
      }
    }
  ]
};
---

<Base
  title="ISO 42001 (AI Governance) – Responsible AI Done Right & Fast | Compliance365"
  description="Build ISO 42001 AI governance fast: model inventory, risk assessment, human oversight and monitoring — automated evidence in Microsoft 365, no new tools."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO – Business-first, impactful intro -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1>ISO 42001 AI Governance – Trustworthy & Fast</h1>
          <p class="section-lead muted">
            Show customers, partners and regulators that your AI is responsible — without new tools, long delays or overwhelming your team.
          </p>
          <p class="muted">
            ISO 42001 proves you manage AI risks, maintain oversight, and monitor outcomes. We deliver it in weeks — inside your existing Microsoft 365 environment — so you can focus on innovation, not compliance headaches.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">8–14 weeks</span>
            <span class="pill">No new tools</span>
            <span class="pill">Automated evidence</span>
            <span class="pill">Customer-ready</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">{ctaLabel}</a>
            <a href={`${base}checklist/iso42001`} class="btn btn-outline">Free AI Governance Readiness Score</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/illus-iso27001.svg`}
            alt="ISO 42001 AI governance evidence automated in Microsoft 365"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHY ISO 42001 MATTERS TO YOUR BUSINESS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why ISO 42001 Matters to Your Business</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Customers, investors, regulators and procurement teams increasingly demand proof that your AI is safe, ethical and accountable. ISO 42001 is the global standard that delivers that proof — helping you build trust and win business faster.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Win More Deals</h3>
          <p class="muted small">
            Show enterprise buyers you govern AI responsibly — often a deal-breaker in government, healthcare and large tech contracts.
          </p>
        </div>
        <div class="card feature center">
          <h3>Reduce AI Risk</h3>
          <p class="muted small">
            Identify and manage AI-specific risks (bias, drift, misuse) before they become incidents, fines or reputational damage.
          </p>
        </div>
        <div class="card feature center">
          <h3>Stay Future-Ready</h3>
          <p class="muted small">
            One framework covers emerging AI regulations (EU AI Act, Australian proposals) — so you’re prepared, not playing catch-up.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON AI GOVERNANCE FEARS WE SOLVE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Common AI Governance Fears We Solve</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        We help teams overcome the same concerns — unclear responsibilities, customer pressure, audit delays, and fear of AI going wrong.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>“We don’t know how to govern AI”</h3>
          <p class="muted small">
            We create a clear AI inventory, risk assessment and oversight model — tailored to your use cases, not generic theory.
          </p>
        </div>
        <div class="card feature center">
          <h3>“Customers keep asking about AI risk”</h3>
          <p class="muted small">
            Ready-to-share model inventory, risk assessments and monitoring logs — so you answer confidently in minutes.
          </p>
        </div>
        <div class="card feature center">
          <h3>“We’re worried about delays”</h3>
          <p class="muted small">
            Automated workflows and evidence mean procurement and sales gates open faster — no months of back-and-forth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section">
    <div class="container">
      <h2 class="center">What You Get with ISO 42001 Support</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>AI Governance Policy & Roles</h3>
          <p class="muted small">
            Clear policy, responsibilities, oversight cadence and training — built around your organisation.
          </p>
        </div>
        <div class="card feature center">
          <h3>Model Inventory</h3>
          <p class="muted small">
            Register of all AI systems — purposes, datasets, versions, risk tiers — live in SharePoint.
          </p>
        </div>
        <div class="card feature center">
          <h3>AI Risk & Impact Assessments</h3>
          <p class="muted small">
            Structured risk and impact analysis with safeguards — linked to DPIAs when needed.
          </p>
        </div>
        <div class="card feature center">
          <h3>Human Oversight & Escalation</h3>
          <p class="muted small">
            Decision thresholds, escalation paths and dispute handling — practical and auditable.
          </p>
        </div>
        <div class="card feature center">
          <h3>Monitoring & Incident Logs</h3>
          <p class="muted small">
            Quality, drift, bias, security and incident tracking — automated evidence trail.
          </p>
        </div>
        <div class="card feature center">
          <h3>Audit-Ready Evidence Pack</h3>
          <p class="muted small">
            Live logs, reports and exports — mapped directly to ISO 42001 controls.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Typical ISO 42001 Timeline</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Fast, focused, and built around your real AI use cases — not theory.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1–2</h3>
          <p class="muted small">Gap assessment + AI inventory & roadmap</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 3–6</h3>
          <p class="muted small">Policy, risk/impact assessments, oversight setup</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 7–9</h3>
          <p class="muted small">Monitoring, internal review & fixes</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 10–14</h3>
          <p class="muted small">Final prep + external audit support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">ISO 42001 FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>How long does it take?</h3>
          <p class="muted">
            Most teams achieve ISO 42001 readiness in <strong>8–14 weeks</strong> — faster when we automate evidence and prioritize high-risk AI.
          </p>
        </div>
        <div class="card">
          <h3>Do we need new AI-specific tools?</h3>
          <p class="muted">
            <strong>No.</strong> We use your existing Microsoft 365 environment — evidence and controls live where your team already works.
          </p>
        </div>
        <div class="card">
          <h3>Can you help with customer or procurement questions about AI?</h3>
          <p class="muted">
            Yes — we prepare clear, reusable evidence and answers for AI risk, oversight and monitoring, so you confidently respond to buyers and regulators.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section" style="background:#f8fafc;">
    <div class="container center">
      <h2>Related Services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Build on ISO 42001 with security, privacy or other frameworks — all inside the same environment.
      </p>

      <div class="pill-row" style="justify-content:center;">
        <a class="pill" href="/services/iso27001">ISO 27001 (Security)</a>
        <a class="pill" href="/services/iso27701">ISO 27701 (Privacy)</a>
        <a class="pill" href="/services/soc2">SOC 2</a>
        <a class="pill" href="/services/essential-eight">Essential Eight</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA – Matching Home page blue -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Ready to Govern AI Responsibly — Fast?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        Book a free 30-minute call — we’ll show you how to stand up ISO 42001, automate evidence, and build customer trust without slowing innovation.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Book Free Call Now
        </a>
        <a href={`${base}checklist/iso42001`} class="btn btn-outline large" style="color:white;border-color:white;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Free AI Governance Readiness Score
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
        Most teams achieve AI governance readiness in under 14 weeks.
      </p>
    </div>
  </section>

  <Footer />
</Base>
