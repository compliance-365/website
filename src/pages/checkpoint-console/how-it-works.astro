---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const demoUrl = `${base}checkpoint/?demo=1`;

// ── The six-stage journey ───────────────────────────────────────────
// This is the actual mechanical sequence a Checkpoint engagement runs
// through — every claim here maps to something real in the console
// (see public/checkpoint/). "actor" is the driver of that stage:
//   you        — a person clicks/decides
//   auto       — Checkpoint does it with no further input
//   together   — you + Checkpoint (and, at the end, your auditor)
// "chain" is the data path that stage traces, rendered as a labelled
// actor flow beneath each deep-dive.
const stages = [
  {
    key: 'signin', num: '01', name: 'Sign in', icon: 'lock', actor: 'you', time: '~2 min',
    tagline: 'Your Microsoft account. Read-only, and you can see exactly what it asks for.',
    body: "You sign in with your own Microsoft 365 account — no new password to invent, no account on our side to create. The first consent screen requests read-only Graph scopes only, each one listed in plain English with the reason it's needed. Write access to your SharePoint is a separate consent, requested later, the first time it's actually used.",
    you: ['Sign in with your Microsoft account', 'Read the plain-English consent list', 'Approve read-only access'],
    auto: ['Requests least-privilege scopes only', 'Opens no popup — a full-page redirect, tokens in session memory', 'Asks for write access later, separately, never up front'],
    output: 'A read-only session — nothing written anywhere yet',
    chain: [
      { label: 'You', ic: 'people', on: true },
      { label: 'Microsoft Entra', ic: 'lock', on: true },
      { label: 'Checkpoint (your browser)', ic: 'compass', on: true },
    ],
  },
  {
    key: 'deploy', num: '02', name: 'Deploy', icon: 'home', actor: 'auto', time: '~15 min, once',
    tagline: 'Your registers provision as SharePoint lists — in your tenant, not ours.',
    body: "A 15-minute wizard checks what Checkpoint can read in your tenant, lets you choose which SharePoint site your records live in, and provisions every register — risks, actions, controls, evidence, audit log — as native SharePoint lists you already own. There is no database on our side to copy anything into, because there is no our side. The lists inherit your permissions, retention and versioning from the moment they exist.",
    you: ['Pick which purchased frameworks to start with', 'Choose the SharePoint site (your root site by default)', "Approve write access when it's first requested"],
    auto: ['Provisions every register as a SharePoint list in your tenant', 'Seeds each framework\'s full control set', 'Idempotent — safe to re-run, never double-creates'],
    output: 'Your compliance registers, live as SharePoint lists you own',
    chain: [
      { label: 'Checkpoint', ic: 'compass', on: true },
      { label: 'Microsoft Graph', ic: 'globe', on: true },
      { label: 'Your SharePoint', ic: 'home', on: true, home: true },
    ],
  },
  {
    key: 'scan', num: '03', name: 'Scan', icon: 'pulse', actor: 'auto', time: '~60 sec',
    tagline: "Your live security posture — measured, not guessed from a spreadsheet.",
    body: 'Checkpoint reads your live tenant signals through Microsoft Graph — MFA coverage, Conditional Access, PIM usage, guest accounts, device compliance, risky OAuth grants, Secure Score — and turns them into pass / review / fail / manual results against your frameworks. Every check is honest about its limits: something Graph can\'t see licence-gates to a clean "manual", never a fabricated pass.',
    you: ['Click "Run scan" (or let the schedule do it)', 'Nothing else — it reads, it never changes anything'],
    auto: ['Reads Entra, Intune and Defender signals read-only', 'Scores every applicable control across your frameworks', 'Exports the raw evidence behind each check, SHA-256-hashed'],
    output: 'A scored posture snapshot + timestamped, hashed evidence filed automatically',
    chain: [
      { label: 'Checkpoint', ic: 'compass', on: true },
      { label: 'Microsoft Graph', ic: 'globe', on: true },
      { label: 'Entra · Intune · Defender', ic: 'shield', on: true },
      { label: 'Your SharePoint (evidence)', ic: 'home', on: true, home: true },
    ],
  },
  {
    key: 'report', num: '04', name: 'Report', icon: 'chart', actor: 'auto', time: '1 click',
    tagline: 'Readiness, gaps and evidence — one board-ready pack, built from live data.',
    body: 'One click turns everything you\'ve been working in into a paginated, classification-marked report — a readiness fingerprint, posture trend, control status by theme, a residual-risk heatmap and an evidence-coverage gauge. Five report types share one engine, so an Executive Summary and an Audit Readiness Report never disagree with each other. Sparse data degrades honestly to an "insufficient history" note, never a broken chart.',
    you: ['Choose a report type', 'Click "Export PDF"'],
    auto: ['Assembles cover, dashboard, sections, methodology and sign-off', 'Pulls every figure live from your own registers', 'Auto-increments the version and logs it to the audit trail'],
    output: 'A board-ready, print-perfect PDF — and a shareable Trust Center page',
    chain: [
      { label: 'Your SharePoint', ic: 'home', on: true, home: true },
      { label: 'Checkpoint report engine', ic: 'chart', on: true },
      { label: 'Board-ready PDF', ic: 'clipboard', on: true },
    ],
  },
  {
    key: 'remediate', num: '05', name: 'Remediate', icon: 'wrench', actor: 'together', time: 'Ongoing',
    tagline: 'Work the gaps — and the evidence collects itself as you go.',
    body: "Each gap becomes an action with an owner and a due date. Checkpoint's AI drafts policy language, risk treatment notes and evidence descriptions — grounded in your own registers, never invented, and never able to take an action itself. As controls move to implemented and scans re-run, the readiness rings fill in and a projected certification date is drawn from your real velocity — not a promise made on a kickoff call.",
    you: ['Assign owners and work the top gaps', 'Accept, edit or discard AI-drafted language', 'Attach evidence (or let a scan capture it)'],
    auto: ['Drafts policies and treatments, grounded in your data', 'Re-scans on a schedule and flags drift', 'Recomputes the projected audit-ready date as work lands'],
    output: 'A closing gap list, a rising readiness score, a projected certification date',
    chain: [
      { label: 'You + AI', ic: 'ai-chip', on: true },
      { label: 'Checkpoint', ic: 'compass', on: true },
      { label: 'Your registers', ic: 'home', on: true, home: true },
    ],
  },
  {
    key: 'certify', num: '06', name: 'Certify', icon: 'check-seal', actor: 'together', time: 'Audit day',
    tagline: 'Present live, hand the auditor a pack — and keep the rhythm after.',
    body: "When it's time to prove it, Checkpoint switches to a full-screen, auto-cycling board deck built from the same live data — no screenshots, no stale slides. Your auditor gets a time-boxed Auditor Pack they can open without a licence. And certification isn't a finish line: the compliance calendar, internal-audit programme and scheduled re-scans keep the governance cadence running, so the week before a surveillance audit looks like every other week.",
    you: ['Present live to the board or auditor', 'Share the time-boxed Auditor Pack', 'Keep working the calendar between audits'],
    auto: ['Builds the live board deck from current data', 'Generates a licence-free, expiring Auditor Pack', 'Runs the ongoing cadence — reviews, re-scans, drift alerts'],
    output: 'A certification you can defend — and a rhythm that keeps it',
    chain: [
      { label: 'Your SharePoint', ic: 'home', on: true, home: true },
      { label: 'Auditor Pack', ic: 'clipboard', on: true },
      { label: 'Your auditor', ic: 'check-seal', on: true },
    ],
  },
];

const actorLabel = { you: 'You drive', auto: 'Automatic', together: 'Together' };

// ── Tenant-boundary data-flow diagram ───────────────────────────────
// The single most important claim, drawn: data flows between your
// browser and YOUR tenant only. Nothing crosses to Compliance365 —
// there is no backend, so there is nothing to cross to.
function buildBoundarySvg() {
  return `<svg viewBox="0 0 720 300" class="hiw-boundary-svg" role="img" aria-label="Data flows between your browser and your own Microsoft 365 tenant only; nothing is sent to Compliance365, which has no backend or database.">
    <defs>
      <marker id="hiwArrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0.5 0.5 L8 4.5 L0.5 8.5" fill="none" stroke="#8fbf9a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker>
      <marker id="hiwArrowR" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0.5 0.5 L8 4.5 L0.5 8.5" fill="none" stroke="#8fbf9a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker>
    </defs>

    <!-- Your tenant boundary -->
    <rect x="286" y="26" width="410" height="248" rx="14" fill="rgba(143,191,154,.05)" stroke="#8fbf9a" stroke-width="1.5" stroke-dasharray="2 6"/>
    <text x="491" y="52" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="11" letter-spacing="2" fill="#8fbf9a">YOUR MICROSOFT 365 TENANT</text>

    <!-- Browser node -->
    <rect x="70" y="116" width="150" height="68" rx="10" fill="#141416" stroke="rgba(216,186,120,.5)" stroke-width="1.5"/>
    <text x="145" y="146" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="13" font-weight="700" fill="#FAF7F1">Checkpoint</text>
    <text x="145" y="164" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="10" fill="rgba(250,247,241,.6)">in your browser</text>

    <!-- SharePoint node -->
    <rect x="330" y="84" width="150" height="60" rx="10" fill="#0B0B0C" stroke="rgba(143,191,154,.55)" stroke-width="1.5"/>
    <text x="405" y="112" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="12.5" font-weight="700" fill="#FAF7F1">Your SharePoint</text>
    <text x="405" y="129" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="9.5" fill="rgba(250,247,241,.55)">every register &amp; evidence file</text>

    <!-- Graph node -->
    <rect x="330" y="156" width="150" height="60" rx="10" fill="#0B0B0C" stroke="rgba(143,191,154,.55)" stroke-width="1.5"/>
    <text x="405" y="184" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="12.5" font-weight="700" fill="#FAF7F1">Microsoft Graph</text>
    <text x="405" y="201" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="9.5" fill="rgba(250,247,241,.55)">read-only posture signals</text>

    <!-- Signals node -->
    <rect x="536" y="120" width="140" height="60" rx="10" fill="#0B0B0C" stroke="rgba(255,255,255,.14)" stroke-width="1.2"/>
    <text x="606" y="146" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="11.5" font-weight="700" fill="rgba(250,247,241,.85)">Entra · Intune</text>
    <text x="606" y="163" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="11.5" font-weight="700" fill="rgba(250,247,241,.85)">Defender</text>

    <!-- Flows: browser <-> your tenant only -->
    <line x1="222" y1="140" x2="326" y2="116" stroke="#8fbf9a" stroke-width="1.6" marker-end="url(#hiwArrow)" class="hiw-flow-line"/>
    <line x1="222" y1="160" x2="326" y2="184" stroke="#8fbf9a" stroke-width="1.6" marker-end="url(#hiwArrowR)" class="hiw-flow-line"/>
    <line x1="484" y1="150" x2="532" y2="150" stroke="#8fbf9a" stroke-width="1.6" marker-end="url(#hiwArrow)" class="hiw-flow-line"/>

    <!-- Compliance365 — outside, unreachable -->
    <rect x="24" y="230" width="196" height="52" rx="10" fill="none" stroke="rgba(250,247,241,.16)" stroke-width="1.2" stroke-dasharray="3 5"/>
    <text x="122" y="252" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="11" font-weight="700" fill="rgba(250,247,241,.45)">Compliance365</text>
    <text x="122" y="269" text-anchor="middle" font-family="Manrope,system-ui,sans-serif" font-size="9" fill="rgba(250,247,241,.35)">no backend · no database</text>
    <!-- The line that does NOT exist -->
    <line x1="145" y1="184" x2="122" y2="226" stroke="#c96a5f" stroke-width="1.4" stroke-dasharray="4 4" opacity=".7"/>
    <g transform="translate(133.5,205)">
      <circle r="9" fill="#0B0B0C" stroke="#c96a5f" stroke-width="1.3"/>
      <path d="M-3.4 -3.4 L3.4 3.4 M3.4 -3.4 L-3.4 3.4" stroke="#c96a5f" stroke-width="1.4" stroke-linecap="round"/>
    </g>
  </svg>`;
}

// ── "What to expect" timeline ───────────────────────────────────────
const timeline = [
  { when: 'Day 0 · 30 minutes', head: 'Signed in, deployed, scanned, first report in hand', body: 'Sign-in, the setup wizard, your first live posture scan and a board-ready readiness report — all inside the first half hour, with your registers already provisioned in your own tenant.' },
  { when: 'Weeks 1–4', head: 'Work the gaps, with AI doing the drafting', body: 'The top gaps become owned actions. AI drafts the policy language and treatment notes; you review and save. Evidence files itself with every scan. The readiness rings visibly fill.' },
  { when: 'Ongoing', head: 'The cadence runs itself', body: 'Scheduled re-scans flag drift before an auditor would. The compliance calendar, internal-audit programme and management review keep ISO 27001 clauses 9.2 / 9.3 satisfied continuously.' },
  { when: 'Audit day', head: 'Present live, hand over a pack', body: 'Full-screen board mode from live data — no screenshots. Your auditor opens a time-boxed Auditor Pack without needing a licence. Nothing is assembled in a panic the night before.' },
  { when: 'Certified — and after', head: 'A certification you can defend, and keep', body: 'The projected date was computed from your real velocity all along. After certification, the same rhythm keeps every surveillance audit looking like an ordinary week.' },
];

const boundarySvg = buildBoundarySvg();
---
<Base
  title="How Checkpoint Works — The End-to-End Journey | Compliance365"
  description="See exactly how Checkpoint runs, stage by stage: sign in, deploy, scan, report, remediate, certify. An animated flow of the whole machine — what you do, what runs automatically, and why your data never leaves your own Microsoft 365 tenant."
>

<Header />

<!-- HERO -->
<section class="svc-hero">
  <CinematicBackground static />
  <div class="svc-hero-copy" style="position:relative;z-index:1;max-width:880px;margin:0 auto;padding:0 22px;">
    <p class="eyebrow">How it works</p>
    <h1>From first sign-in to certified — the whole machine, in the open.</h1>
    <p class="section-lead">
      No black box, no "trust us". Here is the exact sequence a Checkpoint engagement runs through — <strong>sign in, deploy, scan, report, remediate, certify</strong> — what you do, what runs on its own, and where every byte of your data lives at each step (spoiler: your tenant, the whole time).
    </p>
    <div class="hero-ctas">
      <a href={demoUrl} target="_blank" rel="noopener" class="btn-hdk-primary">Try the live demo — no sign-up</a>
      <a href="#journey" class="btn-hdk-ghost">Follow the flow ↓</a>
    </div>
    <p style="margin-top:1rem;font-size:0.9rem;color:rgba(250,247,241,.55);">Everything below maps to something real in the console — nothing here is a mock-up of a feature that doesn't ship.</p>
  </div>
</section>

<!-- THE PIPELINE — the flow diagram -->
<section class="section" id="journey" style="background:#0B0B0C;">
  <div class="container">
    <div class="gold-rule-26"></div>
    <p class="hiw-eyebrow">The end-to-end journey</p>
    <h2 style="color:#FAF7F1;max-width:26ch;">Six stages. Follow the flow — then open any one of them.</h2>
    <p class="hiw-lead">
      This is the flow, not a metaphor for it. Each node is a real stage; the pill under it says who's driving. Tap a stage to jump to exactly what happens inside it.
    </p>

    <div class="hiw-pipe" role="list" aria-label="The six-stage Checkpoint journey">
      {stages.map((s, i) => (
        <>
          <a class={`hiw-pipe-node hiw-actor-${s.actor}`} href={`#stage-${s.key}`} role="listitem" aria-label={`${s.name} — ${actorLabel[s.actor]}`}>
            <span class="hiw-pipe-num">{s.num}</span>
            <span class="hiw-pipe-ic"><svg viewBox="0 0 16 16" aria-hidden="true"><use href={`#ic-${s.icon}`}/></svg></span>
            <span class="hiw-pipe-name">{s.name}</span>
            <span class="hiw-pipe-actor">{actorLabel[s.actor]}</span>
            <span class="hiw-pipe-time">{s.time}</span>
          </a>
          {i < stages.length - 1 && <span class="hiw-pipe-conn" aria-hidden="true"><i></i></span>}
        </>
      ))}
    </div>

    <div class="hiw-legend" aria-hidden="true">
      <span class="hiw-legend-item"><i class="hiw-dot-you"></i> You drive</span>
      <span class="hiw-legend-item"><i class="hiw-dot-auto"></i> Automatic</span>
      <span class="hiw-legend-item"><i class="hiw-dot-together"></i> Together</span>
    </div>
  </div>
</section>

<!-- STAGE DEEP-DIVES -->
<section class="section" style="background:#FAF7F1;padding-top:3.5rem;">
  <div class="container">
    <p class="hiw-eyebrow" style="color:#A9812E;text-align:center;">Inside each stage</p>
    <h2 class="center" style="max-width:24ch;margin:0 auto 3rem;">What actually happens, and who does it</h2>

    <div class="hiw-stages">
      {stages.map((s) => (
        <article class="hiw-stage" id={`stage-${s.key}`}>
          <div class="hiw-stage-spine" aria-hidden="true">
            <span class={`hiw-stage-badge hiw-actor-${s.actor}`}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><use href={`#ic-${s.icon}`}/></svg>
            </span>
          </div>
          <div class="hiw-stage-body">
            <div class="hiw-stage-head">
              <span class="hiw-stage-num">{s.num}</span>
              <h3>{s.name}</h3>
              <span class={`hiw-stage-tag hiw-actor-${s.actor}`}>{actorLabel[s.actor]}</span>
              <span class="hiw-stage-clock">{s.time}</span>
            </div>
            <p class="hiw-stage-tagline">{s.tagline}</p>
            <p class="hiw-stage-text">{s.body}</p>

            <div class="hiw-split">
              <div class="hiw-split-col hiw-split-you">
                <p class="hiw-split-label"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-people"/></svg> You do</p>
                <ul>{s.you.map((x) => <li>{x}</li>)}</ul>
              </div>
              <div class="hiw-split-col hiw-split-auto">
                <p class="hiw-split-label"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-bolt"/></svg> Checkpoint does</p>
                <ul>{s.auto.map((x) => <li>{x}</li>)}</ul>
              </div>
            </div>

            <div class="hiw-chain" aria-label={`Data flow for ${s.name}`}>
              {s.chain.map((c, ci) => (
                <>
                  <span class={`hiw-chain-node${c.home ? ' hiw-chain-home' : ''}`}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><use href={`#ic-${c.ic}`}/></svg>
                    {c.label}
                  </span>
                  {ci < s.chain.length - 1 && <span class="hiw-chain-arrow" aria-hidden="true">→</span>}
                </>
              ))}
            </div>

            <p class="hiw-output"><span>Output</span> {s.output}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- TENANT BOUNDARY -->
<section class="section" style="background:#141416;">
  <div class="container">
    <div class="hiw-boundary-grid">
      <div>
        <div class="gold-rule-26"></div>
        <p class="hiw-eyebrow">Where your data goes</p>
        <h2 style="color:#FAF7F1;max-width:16ch;">Nowhere. That's the whole point.</h2>
        <p class="hiw-lead" style="margin-left:0;">
          Trace any stage on the diagram and the data only ever moves between your browser and <strong style="color:#FAF7F1;">your own Microsoft 365 tenant</strong>. Posture signals are read live through Graph; every register and evidence file is a SharePoint list you own.
        </p>
        <p class="hiw-lead" style="margin-left:0;">
          Nothing is sent to Compliance365 — not because we promise not to look, but because there is <strong style="color:#FAF7F1;">no backend and no database</strong> on our side for it to go to. Off-board us and your data doesn't get walled off; it was always yours.
        </p>
        <p style="margin-top:1.5rem;">
          <a href={`${base}security/`} style="color:#D8BA78;font-weight:700;font-size:11px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid rgba(216,186,120,.4);padding-bottom:4px;font-family:Manrope,system-ui,sans-serif;">The full security &amp; architecture page →</a>
        </p>
      </div>
      <div class="hiw-boundary-figure">
        <Fragment set:html={boundarySvg} />
        <p class="hiw-fig-cap">Every arrow stays inside your tenant. The one line that would reach us doesn't exist.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT TO EXPECT TIMELINE -->
<section class="section" style="background:#FAF7F1;">
  <div class="container">
    <p class="hiw-eyebrow" style="color:#A9812E;text-align:center;">What to expect</p>
    <h2 class="center" style="max-width:22ch;margin:0 auto 3rem;">A realistic timeline, not a sales fantasy</h2>
    <div class="hiw-timeline">
      {timeline.map((t) => (
        <div class="hiw-tl-row">
          <div class="hiw-tl-when">{t.when}</div>
          <div class="hiw-tl-dot" aria-hidden="true"></div>
          <div class="hiw-tl-card">
            <h3>{t.head}</h3>
            <p>{t.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- THE POWER, QUANTIFIED -->
<section class="section" style="background:#0B0B0C;">
  <div class="container">
    <p class="hiw-eyebrow" style="text-align:center;">Why it lands</p>
    <h2 class="center" style="color:#FAF7F1;max-width:24ch;margin:0 auto 3rem;">The power isn't a feature list. It's what stops being your problem.</h2>
    <div class="hiw-power">
      <div class="hiw-power-card">
        <svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-home"/></svg>
        <h3>Your data never leaves</h3>
        <p>No third-party GRC SaaS holding your risk register hostage. Every record is a SharePoint list in your own tenant — governed, retained and backed up by you.</p>
      </div>
      <div class="hiw-power-card">
        <svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-bolt"/></svg>
        <h3>Evidence collects itself</h3>
        <p>Every scan hashes and files the raw Graph data behind each check, auto-linked to the controls it satisfies. When the auditor says "prove it", it's already filed and dated.</p>
      </div>
      <div class="hiw-power-card">
        <svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-target"/></svg>
        <h3>A date you can trust</h3>
        <p>The projected certification date is drawn from your real remediation velocity — recomputed as work lands, honest when there isn't enough history yet. No kickoff-call promises.</p>
      </div>
      <div class="hiw-power-card">
        <svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-refresh"/></svg>
        <h3>Certification becomes a rhythm</h3>
        <p>The cadence keeps running between audits — re-scans, reviews, drift alerts — so the week before a surveillance visit looks exactly like every other week.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section" style="background:#141416;">
  <div class="container center">
    <h2 style="color:#FAF7F1;">Don't take the diagram's word for it</h2>
    <p style="max-width:640px;margin:1.5rem auto;color:rgba(250,247,241,.68);font-size:15px;line-height:1.8;">
      Open the actual console with sample data — no sign-up, nothing installed — and walk the same flow yourself. Or book a 30-minute session and we'll run a read-only scan against your real tenant, so you leave with your actual gaps, not a pitch.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-top:2rem;">
      <a href={demoUrl} target="_blank" rel="noopener" class="btn-hdk-primary">Try the live demo</a>
      <a href={ctaUrl} class="btn-hdk-ghost">Book a walkthrough</a>
    </div>
