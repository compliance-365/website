<script>
  // Starter-pack sign-up: the same subscribe endpoint and thank-you page as
  // /free-roadmap/, tagged with this page as its source.
  (function () {
    const form = document.getElementById('home-pack-form') as HTMLFormElement | null;
    if (!form) return;
    const SUBSCRIBE_URL = 'https://uclqeiwzgi.execute-api.ap-southeast-2.amazonaws.com/NewDeploy/subscribe';
    const input = form.querySelector('input[name="email"]') as HTMLInputElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const note = document.getElementById('home-pack-note');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        input.setAttribute('aria-invalid', 'true');
        if (note) note.textContent = 'Please enter a valid work email.';
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const w = window as unknown as { c365LeadTouch?: () => unknown; gtag?: (...a: unknown[]) => void };
        const res = await fetch(SUBSCRIBE_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, org: '', framework: 'Not specified', source: 'home-starter-pack', page: location.pathname, touch: typeof w.c365LeadTouch === 'function' ? w.c365LeadTouch() : null }),
        });
        if (!res.ok) throw new Error('Non-200');
        if (typeof w.gtag === 'function') w.gtag('event', 'free_roadmap_signup', { framework: 'Not specified', page_location: location.href });
        location.href = '/thank-you/';
      } catch {
        btn.disabled = false; btn.textContent = 'Send it to me';
        if (note) note.innerHTML = 'Something went wrong. Please try again or email <a href="mailto:info@compliance365.com.au" style="color:#F0A97F">info@compliance365.com.au</a>.';
      }
    });
  })();
</script>

