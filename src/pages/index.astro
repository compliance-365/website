      const customers = (document.getElementById('quiz-customers') as HTMLSelectElement).value;
      const errEl     = document.getElementById('quiz-error');
      if (!sector || !trigger || !customers) {
        errEl.textContent = 'Please answer all three questions first.';
        errEl.style.display = 'block';
        return;
      }
      errEl.style.display = 'none';
      const prompt = `I'm trying to figure out which compliance framework is right for my organisation. Here's my situation:\n\n- Sector: ${sector}\n- What's driving this: ${trigger}\n- Primary customers: ${customers}\n\nWhich framework(s) should I prioritise — ISO 27001, SOC 2, Essential Eight, ISO 42001, ISO 27701, or DISP/IRAP? Please give me a clear recommendation and explain why, including any frameworks I should combine.`;
