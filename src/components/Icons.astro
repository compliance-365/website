      <path d="M5.7 10.3 10.3 5.7"/>
    </symbol>

    <symbol id="ic-envelope" viewBox="0 0 16 16" ${S}>
      <rect x="2" y="4" width="12" height="9" rx="1"/>
      <path d="M2.5 4.5 8 9l5.5-4.5"/>
    </symbol>

    <symbol id="ic-briefcase" viewBox="0 0 16 16" ${S}>
      <rect x="2" y="6" width="12" height="7" rx="1"/>
      <path d="M6 6V4.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1V6"/>
      <path d="M2 9.5h12"/>
    </symbol>

    <symbol id="ic-mobile" viewBox="0 0 16 16" ${S}>
      <rect x="5" y="1.5" width="6" height="13" rx="1.5"/>
      <path d="M7 12.3h2"/>
    </symbol>

    <symbol id="ic-chart" viewBox="0 0 16 16" ${S}>
      <path d="M2.5 2v11.5h11.5"/>
      <path d="M5 13.5V9M8 13.5V6M11 13.5V8"/>
    </symbol>

    <symbol id="ic-people" viewBox="0 0 16 16" ${S}>
