---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScopingWidget from '../components/ScopingWidget.astro';
import CinematicBackground from '../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const images = {
  fourPhases: `${base}assets/4phases.svg`,
};

const faqs = [
  {
    q: 'Will this disrupt my engineering or operations team?',
    a: 'No. Everything is built directly inside your existing environment — Microsoft 365, SharePoint, Intune, Defender. No new tools, no forced change management, no endless meetings. Your team stays focused on their actual work.',
  },
  {
    q: 'How long does it actually take?',
    a: 'Assessments deliver in 2–3 weeks. Full uplift and certification programmes typically run 8–14 weeks for SMB scope, and up to 6 months for mid-market programmes covering all controls. We give you a realistic timeline on the first call — not a number designed to win the pitch.',
  },
  {
    q: 'What does it cost?',
    a: 'All engagements are fixed-price with milestone-based payments — you only pay when outcomes are demonstrably delivered. Typical programmes run at 60–80% less than large consulting firms, with no annual GRC platform licence on top. We scope honestly so there are no surprises.',
  },
  {
    q: 'Can we get multiple certifications at once?',
    a: 'Yes — this is one of our core strengths. We map a single set of controls across ISO 27001, SOC 2, Essential Eight, and ISO 42001 simultaneously, so you avoid duplicated effort and cost.',
  },
];

// JSON-LD
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  logo: 'https://www.compliance365.com.au/assets/logo.svg',
  description: 'Cyber, privacy, and AI governance consulting for Australian mid-market and enterprise organisations. ISO 27001, SOC 2, Essential Eight, ISO 42001, DISP/IRAP — fixed-price, evidence-backed, Microsoft 365-native.',
  areaServed: [
    { '@type': 'Country', name: 'Australia' },
    { '@type': 'City', name: 'Brisbane' },
    { '@type': 'City', name: 'Melbourne' },
    { '@type': 'City', name: 'Sydney' },
    { '@type': 'City', name: 'Canberra' },
    { '@type': 'City', name: 'Perth' },
    { '@type': 'City', name: 'Adelaide' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Brisbane', addressRegion: 'QLD', addressCountry: 'AU' },
  contactPoint: { '@type': 'ContactPoint', telephone: '+61-468-752243', contactType: 'customer service' },
  sameAs: ['https://www.linkedin.com/company/compliance-365/']
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<Base
  title="ISO 27001, SOC 2 &amp; Essential Eight — Without the Platform Tax | Compliance365"
  description="Australian compliance consultancy delivering ISO 27001, SOC 2, Essential Eight and ISO 42001 inside your existing Microsoft 365 environment. Fixed-price, audit-ready in 8–14 weeks, no GRC platform licences."
>

<Header />

<!-- ANNOUNCEMENT BAR -->
<div class="announce">
  <strong>ISO 42001 AI Governance</strong> — now available alongside ISO 27001, Essential Eight &amp; SOC 2
  &nbsp;·&nbsp; <a href={`${base}services/iso42001/`}>Learn more →</a>
</div>

<!-- HERO (dark ink — full-height, cinematic) -->
<section class="hero-dk">
  <CinematicBackground />
  <div class="hero-dk-inner">

    <!-- LEFT: copy -->
    <div class="hero-dk-copy">
      <p class="hdk-eyebrow hdk-rise" style="--rise:1">Cyber · Privacy · AI Governance</p>
      <h1 class="hdk-h1">
        <span class="hl"><span class="hl-i" style="--hl:1">Certified in</span></span>
        <span class="hl"><span class="hl-i" style="--hl:2">weeks.</span></span>
        <span class="hl"><span class="hl-i" style="--hl:3"><em class="hdk-accent">Not quarters.</em></span></span>
      </h1>
      <p class="hdk-sub hdk-rise" style="--rise:2">
        ISO 27001, SOC 2, Essential Eight and ISO 42001 — delivered inside the Microsoft 365 you already own.
        Fixed price. No GRC platform licences. <strong>100% first-time pass rate.</strong>
      </p>
      <div class="hdk-ctas hdk-rise" style="--rise:3">
        <a href={ctaUrl} class="btn-hdk-primary">Scope my certification →</a>
        <a href="#estimate" class="btn-hdk-ghost">Get a 30-second estimate</a>
      </div>
      <!-- Proof ledger -->
      <div class="proof-ledger hdk-rise" style="--rise:4">
        <div class="pl-item"><b>100%</b><span>First-time pass</span></div>
        <div class="pl-item"><b>8–14</b><span>Weeks to audit-ready</span></div>
        <div class="pl-item"><b>60–80%</b><span>Below Big 4</span></div>
        <div class="pl-item"><b>$0</b><span>Platform licences</span></div>
      </div>
      <!-- Framework index — table of contents, wired to the explorer -->
      <div class="fw-index hdk-rise" style="--rise:5">
        <span class="fi-label">Frameworks</span>
        <a href="#frameworks" data-fw="ISO 27001">ISO 27001</a>
        <a href="#frameworks" data-fw="SOC 2">SOC 2</a>
        <a href="#frameworks" data-fw="Essential Eight">Essential 8</a>
        <a href="#frameworks" data-fw="ISO 42001">ISO 42001</a>
        <a href="#frameworks" data-fw="ISO 27701">ISO 27701</a>
        <a href="#frameworks" data-fw="DISP / IRAP">DISP / IRAP</a>
        <a href="#frameworks" data-fw="NIST CSF">NIST CSF</a>
      </div>
    </div>

    <!-- RIGHT: 3D ring stage -->
    <div class="ring-stage" id="ring-stage" data-base={base}>
      <div class="fw-chip" id="fwChip">
        <div class="fw-rule"></div>
        <b id="fwName"></b>
        <p id="fwDesc"></p>
        <a id="fwLink" href="#">Explore framework →</a>
      </div>
      <div class="ring-fallback">
        <svg viewBox="0 0 200 200" fill="none" style="width:min(62%,340px);height:auto;">
          <path d="M176.2,56 A88,88 0 1,0 176.2,144" stroke="#FAF7F1" stroke-width="10" stroke-linecap="round"/>
          <circle class="ring-pulse-dot" cx="188" cy="100" r="9" fill="#A9812E"/>
        </svg>
      </div>
      <div class="stage-hint" id="stageHint">Drag to rotate · Click a framework</div>
    </div>

  </div>

  <!-- Scroll cue -->
  <div class="hdk-cue" aria-hidden="true">
    <span>See how</span>
    <div class="hdk-cue-line"></div>
  </div>
</section>

<!-- SCOPING TOOL (dark, raised charcoal card) -->
<section class="section reveal-section" id="estimate" style="background:#0B0B0C;padding:4rem 0;">
  <div class="container">
    <div style="max-width:860px;margin:0 auto;background:#141416;border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:2.5rem 2rem;">
      <p style="font-family:Manrope,system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#A9812E;margin:0 0 1rem;">Free scoping tool</p>
      <h2 style="color:#FAF7F1;margin:0 0 0.5rem;">Get a realistic scope in 30 seconds.</h2>
      <p style="color:rgba(250,247,241,.62);margin:0 0 2rem;font-size:0.95rem;line-height:1.65;">Three questions. No email required. We'll tell you which framework fits, the typical timeline, and a ballpark cost range.</p>
      <ScopingWidget calendlyUrl={ctaUrl} />
    </div>
  </div>
</section>

<style>
  /* ─── Announcement ─────────────────── */
  .announce {
    background: #0B0B0C;
    border-bottom: 1px solid rgba(255,255,255,.14);
    text-align: center;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: .06em;
    color: rgba(250,247,241,.62);
    padding: 9px 16px;
    position: relative;
    z-index: 2;
  }
  .announce strong { color: #FAF7F1; font-weight: 700; }
  .announce a { color: #D8BA78; text-decoration: none; }
  .announce a:hover { text-decoration: underline; }

  /* ─── Hero dark ─────────────────────── */
  .hero-dk {
    background: #0B0B0C;
    color: #FAF7F1;
    position: relative;
    overflow: hidden;
  }
  .hero-dk-inner {
    display: grid;
    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    align-items: center;
    min-height: calc(100vh - 110px);
    padding: 24px clamp(20px, 4vw, 56px) 56px;
    max-width: 1420px;
    margin: 0 auto;
    gap: 16px;
    position: relative;
    z-index: 1;
  }

  /* Cinematic entrance — masked headline lines */
  .hl { display: block; overflow: hidden; }
  .hl-i { display: inline-block; }
  .hdk-rise { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hl-i {
      transform: translateY(112%);
      animation: hl-up 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--hl, 1) * 110ms);
    }
    @keyframes hl-up { to { transform: translateY(0); } }
    .hdk-rise {
      opacity: 0;
      transform: translateY(18px);
      animation: hdk-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(240ms + var(--rise, 1) * 120ms);
    }
    @keyframes hdk-rise { to { opacity: 1; transform: translateY(0); } }
  }

  /* Cinematic exit — the hero recedes as you scroll past it
     (CSS Scroll-Driven Animations; ignored by unsupporting browsers) */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-dk-inner,
      .hdk-cue {
        animation: hero-exit linear both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
    }
  }
  @keyframes hero-exit {
    to { opacity: 0.12; transform: translateY(-56px) scale(0.985); }
  }
  .hdk-eyebrow {
    font-family: Manrope, system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: #A9812E;
    font-weight: 700;
    margin-bottom: 22px;
  }
  .hdk-h1 {
    font-family: Fraunces, Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.06;
    letter-spacing: -.01em;
    color: #FAF7F1;
    margin: 0 0 0 0;
  }
  .hdk-accent {
    color: #D8BA78;
    font-style: italic;
  }
  .hdk-sub {
    margin-top: 26px;
    font-size: 16px;
    line-height: 1.75;
    color: rgba(250,247,241,.62);
    max-width: 56ch;
    font-weight: 400;
    font-family: Manrope, system-ui, sans-serif;
  }
  .hdk-sub strong { color: #FAF7F1; font-weight: 700; }
  .hdk-ctas {
    margin-top: 36px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn-hdk-primary {
    background: #A9812E;
    color: #0B0B0C;
    font-family: Manrope, system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .05em;
    padding: 15px 28px;
    border-radius: 3px;
    text-decoration: none;
    transition: background .2s, box-shadow .3s;
    text-transform: uppercase;
    border: 1px solid #A9812E;
    display: inline-block;
    position: relative;
    overflow: hidden;
  }
  .btn-hdk-primary::after {
    content: '';
    position: absolute;
    top: 0;
    left: -80%;
    width: 55%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent);
    transform: skewX(-20deg);
    pointer-events: none;
  }
  .btn-hdk-primary:hover {
    background: #D8BA78;
    border-color: #D8BA78;
    color: #0B0B0C;
    box-shadow: 0 8px 32px rgba(216,186,120,.35);
  }
  @media (prefers-reduced-motion: no-preference) {
    .btn-hdk-primary:hover::after { animation: btn-shine .8s ease; }
    @keyframes btn-shine { to { left: 130%; } }
  }
  .btn-hdk-ghost {
    border: 1px solid #A9812E;
    color: #D8BA78;
    font-family: Manrope, system-ui, sans-serif;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: .05em;
    padding: 15px 24px;
    border-radius: 3px;
    text-decoration: none;
    transition: background .2s, color .2s;
    text-transform: uppercase;
    display: inline-block;
  }
  .btn-hdk-ghost:hover { background: rgba(169,129,46,.12); }

  /* Proof ledger */
  .proof-ledger {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,.14);
    border-bottom: 1px solid rgba(255,255,255,.14);
  }
  .pl-item {
    flex: 1 1 auto;
    min-width: 120px;
    padding: 16px 20px 16px 0;
    margin-right: 20px;
    border-right: 1px solid rgba(255,255,255,.14);
  }
  .pl-item:last-child { border-right: none; margin-right: 0; }
  .pl-item b {
    display: block;
    font-family: Manrope, system-ui, sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: #D8BA78;
    letter-spacing: .01em;
  }
  .pl-item span {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(250,247,241,.55);
    font-weight: 500;
    font-family: Manrope, system-ui, sans-serif;
  }

  /* Framework index — hero table of contents */
  .fw-index {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 8px;
    font-family: Manrope, system-ui, sans-serif;
  }
  .fw-index .fi-label {
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #A9812E;
    font-weight: 700;
    margin-right: 16px;
  }
  .fw-index a {
    font-size: 11px;
    color: rgba(250,247,241,.62);
    text-decoration: none;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 2px 12px;
    border-right: 1px solid rgba(255,255,255,.14);
    transition: color .2s;
  }
  .fw-index a:last-of-type { border-right: none; }
  .fw-index a:hover { color: #D8BA78; }

  /* 3D ring stage */
  .ring-stage {
    position: relative;
    height: min(76vh, 700px);
    min-height: 420px;
    cursor: grab;
  }
  /* gold aura marrying the ring to the cinematic backdrop */
  .ring-stage::before {
    content: '';
    position: absolute;
    inset: -8%;
    background: radial-gradient(closest-side, rgba(169,129,46,.16), transparent 72%);
    filter: blur(28px);
    pointer-events: none;
  }
  .ring-stage.grabbing { cursor: grabbing; }
  .ring-stage canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    opacity: 0;
    transition: opacity 1.2s ease .2s;
    touch-action: pan-y;
  }
  .ring-stage.ready canvas { opacity: 1; }
  .ring-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ring-stage.ready .ring-fallback { display: none; }
  .ring-pulse-dot { animation: ring-pulse 4s ease-in-out infinite; }
  @keyframes ring-pulse { 0%,100%{opacity:1} 50%{opacity:.7} }
  /* framework chip */
  .fw-chip {
    position: absolute; top: 18px; left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background: rgba(20,20,22,.96); border: 1px solid rgba(255,255,255,.14);
    border-radius: 6px; padding: 16px 22px; min-width: 280px; max-width: 340px;
    opacity: 0; transition: opacity .4s, transform .4s;
    pointer-events: none; z-index: 10;
  }
  .fw-chip.show { opacity: 1; transform: translateX(-50%) translateY(0); pointer-events: auto; }
  .fw-rule { width: 26px; height: 1px; background: #A9812E; margin-bottom: 10px; }
  .fw-chip b { font-family: Fraunces,Georgia,serif; font-weight:500; font-size:17px; display:block; color:#FAF7F1; }
  .fw-chip p { font-size: 12px; color: rgba(250,247,241,.62); margin: 5px 0 0; line-height: 1.6; }
  .fw-chip a { display:inline-block; margin-top:9px; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#D8BA78; text-decoration:none; font-weight:700; }
  .fw-chip a:hover { text-decoration: underline; }
  /* hint label */
  .stage-hint {
    position: absolute; bottom: 6px; left: 0; right: 0;
    text-align: center; font-size: 10px; letter-spacing: .22em;
    text-transform: uppercase; color: rgba(250,247,241,.45);
    font-weight: 500; font-family: Manrope,system-ui,sans-serif;
    pointer-events: none; transition: opacity .5s;
  }
  .ring-stage.touched .stage-hint { opacity: 0; }

  /* Scroll cue */
  .hdk-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(250,247,241,.45);
    font-size: 10px;
    letter-spacing: .28em;
    text-transform: uppercase;
    padding-bottom: 40px;
    font-weight: 500;
    font-family: Manrope, system-ui, sans-serif;
  }
  .hdk-cue-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(#A9812E, transparent);
    animation: cue-pulse 2.6s ease-in-out infinite;
  }
  @keyframes cue-pulse { 0%,100%{opacity:.35} 50%{opacity:1} }

  /* Mobile hero */
  @media (max-width: 900px) {
    .hero-dk-inner {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 40px;
    }
    .ring-stage {
      order: -1;
      height: 280px;
      min-height: 280px;
      opacity: .9;
    }
  }

  /* ─── Service grid ─────────────────── */
  /* ── 4 + 3 centred grid (8-column base) ── */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.45rem;
    margin: 0 0 1.75rem;
  }
  /* Row 1: 4 cards, 2 cols each */
  .sg:nth-child(1) { grid-column: 1 / span 2; }
  .sg:nth-child(2) { grid-column: 3 / span 2; }
  .sg:nth-child(3) { grid-column: 5 / span 2; }
  .sg:nth-child(4) { grid-column: 7 / span 2; }
  /* Row 2: 3 cards centred (cols 2-7) */
  .sg:nth-child(5) { grid-column: 2 / span 2; }
  .sg:nth-child(6) { grid-column: 4 / span 2; }
  .sg:nth-child(7) { grid-column: 6 / span 2; }

  /* ── Card base ── */
  .sg {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(169,129,46,0.18);
    border-left: 3px solid #A9812E;
    border-radius: 8px;
    background: #ffffff;
    text-decoration: none;
    min-height: 72px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.055), 0 1px 2px rgba(0,0,0,0.04);
    position: relative;
    overflow: hidden;
    animation: sg-enter 0.4s ease both;
    animation-delay: var(--sg-delay, 0ms);
    transition:
      box-shadow 0.22s ease,
      border-color 0.18s ease;
  }

  @keyframes sg-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Shimmer overlay */
  .sg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(169,129,46,0.08) 0%, transparent 55%);
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  /* ── Hover: no lift, border warms ── */
  .sg:hover {
    border-color: rgba(216,186,120,.35);
    box-shadow: 0 8px 28px rgba(0,0,0,.12);
  }
  .sg:hover::after { opacity: 1; }

  /* ── Card text ── */
  .sg-name {
    font-size: 0.83rem;
    font-weight: 700;
    color: #0B0B0C;
    letter-spacing: 0.01em;
    line-height: 1.25;
    position: relative;
    z-index: 1;
  }
  .sg-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.4rem;
    position: relative;
    z-index: 1;
  }
  .sg-cat {
    font-size: 0.67rem;
    font-weight: 700;
    color: #A9812E;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .sg-arrow {
    font-size: 0.82rem;
    color: rgba(169,129,46,0.35);
    transition: color 0.15s;
    line-height: 1;
  }
  .sg:hover .sg-arrow {
    color: #A9812E;
  }

  /* ── Mobile: 2-col grid, override nth-child positions ── */
  @media (max-width: 680px) {
    .service-grid { grid-template-columns: repeat(2, 1fr); }
    .sg:nth-child(n) { grid-column: auto; }
  }
</style>

<!-- BRAND EXPLAINER -->
<section class="section" style="background:#0B0B0C;padding:3.5rem 0;">
  <div class="container">
    <p style="font-family:Manrope,system-ui;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#A9812E;text-align:center;margin:0 0 0.75rem;">How it works</p>
    <h2 class="center" style="color:#fff;">See how Compliance365 works in 90 seconds</h2>
    <p class="muted center" style="max-width:760px;margin:1rem auto 2rem;color:#6B6860;">
      A quick look at how we deliver ISO 27001, SOC 2, Essential Eight and ISO 42001 inside your existing Microsoft 365 environment — no new platform, no platform tax.
    </p>
    <div class="explainer-frame explainer-horizontal" style="max-width:1120px;margin:0 auto;aspect-ratio:16/9;border-radius:18px;overflow:hidden;box-shadow:0 40px 90px -40px rgba(0,0,0,.85);">
      <iframe
        src={`${base}brand-explainer.html`}
        title="Compliance365 brand explainer"
        loading="lazy"
        style="width:100%;height:100%;border:0;display:block;"
      ></iframe>
    </div>
    <div class="explainer-frame explainer-vertical" style="max-width:430px;margin:0 auto;aspect-ratio:9/16;border-radius:18px;overflow:hidden;box-shadow:0 40px 90px -40px rgba(0,0,0,.85);">
      <iframe
        src={`${base}brand-explainer-vertical.html`}
        title="Compliance365 brand explainer (vertical)"
        loading="lazy"
        style="width:100%;height:100%;border:0;display:block;"
      ></iframe>
    </div>
  </div>
</section>

