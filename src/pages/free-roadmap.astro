---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CinematicBackground from '../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const pageTitle = 'Free Australian Compliance Starter Pack — ISO 27001, Essential Eight & AI Governance';
const pageDesc  = 'Get instant access to our free compliance starter pack: interactive readiness checklists, practical guides, and a monthly digest built for Australian organisations.';
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={[{
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
      {"@type":"ListItem","position":2,"name":"Free Starter Pack","item":"https://www.compliance365.com.au/free-roadmap/"}
    ]
  }]}
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">Free resource — no credit card</p>
        <h1>Australian Compliance Starter Pack</h1>
        <p class="section-lead">
          Instant access to interactive readiness checklists, practitioner guides, and our monthly compliance digest — everything you need to understand where you stand and what to do next.
        </p>
        <ul class="trust-signals" style="max-width:480px;">
          <li>ISO 27001 readiness checklist + PDF</li>
          <li>Essential Eight ML1/ML2/ML3 assessment</li>
          <li>ISO 42001 AI governance checklist</li>
          <li>Monthly Australian compliance digest</li>
          <li>SoA, ROPA & AI governance guides</li>
          <li>Free — no spam, unsubscribe any time</li>
        </ul>
      </div>

      <!-- FORM CARD -->
      <div class="svc-hero-image" style="max-width:420px;">
      <div class="card" style="padding:2.5rem;">
        <h2 style="font-size:1.35rem;margin-bottom:.5rem;">Get instant access</h2>
        <p class="muted small" style="margin-bottom:1.5rem;">Takes 30 seconds. Unsubscribe any time.</p>

        <form id="starter-form" novalidate>

          <div style="display:flex;flex-direction:column;gap:1rem;">
            <div>
              <label style="display:block;font-size:.82rem;font-weight:700;color:#374151;margin-bottom:5px;">Work email *</label>
              <input
                type="email"
                name="email"
                placeholder="you@company.com.au"
                required
                style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:.9rem;font-family:inherit;box-sizing:border-box;outline:none;"
              />
            </div>

            <div>
              <label style="display:block;font-size:.82rem;font-weight:700;color:#374151;margin-bottom:5px;">Organisation name</label>
              <input
                type="text"
                name="organisation"
                placeholder="Acme Pty Ltd"
                style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:.9rem;font-family:inherit;box-sizing:border-box;outline:none;"
              />
            </div>

            <div>
              <label style="display:block;font-size:.82rem;font-weight:700;color:#374151;margin-bottom:8px;">Which framework interests you most?</label>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
                {[
                  'ISO 27001', 'Essential Eight',
                  'ISO 42001 (AI)', 'ISO 27701 (Privacy)',
                  'SOC 2', 'DISP / ISM',
                  'Not sure yet', 'Multiple',
                ].map(f => (
                  <label style="display:flex;align-items:center;gap:7px;font-size:.82rem;color:#374151;cursor:pointer;padding:6px 8px;border:1px solid #DDD8CF;border-radius:7px;transition:background .1s;" class="fw-opt">
                    <input type="radio" name="framework" value={f} style="accent-color:#A9812E;" />
                    {f}
                  </label>
                ))}
              </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-size:1rem;padding:12px;">
              Send me the starter pack →
            </button>
          </div>

          <p style="font-size:.72rem;color:#6B6860;margin:10px 0 0;text-align:center;">
            No spam. Your email stays with Compliance365 only.
          </p>
        </form>
        <div id="starter-error" style="display:none;font-size:.82rem;color:#991b1b;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;margin-top:8px;">
          Something went wrong — please try again or email <a href="mailto:info@compliance365.com.au" style="color:#991b1b;">info@compliance365.com.au</a>.
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="container section" style="padding-top:0;">
    <h2 style="margin-bottom:1.5rem;">What's included</h2>
    <div class="grid-3" style="gap:1.25rem;">
      <div class="card spot">
        <p style="margin:0 0 .75rem;color:#A9812E;"><svg viewBox="0 0 16 16" width="28" height="28" aria-hidden="true"><use href="#ic-clipboard"/></svg></p>
        <h3 style="margin:0 0 .5rem;">Interactive checklists</h3>
        <p class="muted small" style="margin:0;">Four framework assessments (ISO 27001, Essential Eight, ISO 42001, ISO 27701) — answer questions, see your score, download a prioritised PDF roadmap.</p>
      </div>
      <div class="card spot">
        <p style="margin:0 0 .75rem;color:#A9812E;"><svg viewBox="0 0 16 16" width="28" height="28" aria-hidden="true"><use href="#ic-books"/></svg></p>
        <h3 style="margin:0 0 .5rem;">Practitioner guides</h3>
        <p class="muted small" style="margin:0;">Deep-dive guides on SoA, ROPA, AI governance, and automating compliance in Microsoft 365 — written for what auditors actually look for.</p>
      </div>
      <div class="card spot">
        <p style="margin:0 0 .75rem;color:#A9812E;"><svg viewBox="0 0 16 16" width="28" height="28" aria-hidden="true"><use href="#ic-envelope"/></svg></p>
        <h3 style="margin:0 0 .5rem;">Monthly digest</h3>
        <p class="muted small" style="margin:0;">Practical updates on Australian compliance — Privacy Act changes, ASD Essential Eight updates, ISO revisions, and real implementation tips. Once a month.</p>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section style="background:#FAF7F1;padding:3rem 0;">
    <div class="container" style="max-width:760px;text-align:center;">
      <p class="muted small" style="margin:0 0 1.5rem;">Used by compliance teams across Australian FinTech, HealthTech, and Defence contractors</p>
      <div class="card spot" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px;text-align:left;">
        <div>
          <h3 style="margin:0 0 6px;">Ready to talk scope and timeline?</h3>
          <p class="muted small" style="margin:0;">A free 30-min call gives you a realistic picture — what it costs, how long it takes, and what to prioritise first.</p>
        </div>
        <a class="btn btn-primary" href={`${base}book/`} style="white-space:nowrap;">Book a free call</a>
      </div>
    </div>
  </section>

  <Footer />

  <script>
  (function () {
    const SUBSCRIBE_URL = 'https://uclqeiwzgi.execute-api.ap-southeast-2.amazonaws.com/NewDeploy/subscribe';

    const form = document.getElementById('starter-form');
    const errorEl = document.getElementById('starter-error');
    if (!form) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement | null;
      const orgInput = form.querySelector('input[name="organisation"]') as HTMLInputElement | null;
      const frameworkInput = form.querySelector('input[name="framework"]:checked') as HTMLInputElement | null;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      const email = emailInput?.value.trim() ?? '';
      const org = orgInput?.value.trim() ?? '';
      const framework = frameworkInput?.value ?? 'Not specified';

      if (!email || !email.includes('@')) {
        if (emailInput) emailInput.style.borderColor = '#ef4444';
        return;
      }

      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      if (errorEl) errorEl.style.display = 'none';

      try {
        const res = await fetch(SUBSCRIBE_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, org, framework, source: 'free-roadmap' }),
        });

        if (!res.ok) throw new Error('Non-200');

        if (typeof gtag === 'function') gtag('event', 'free_roadmap_signup', { framework, page_location: window.location.href });
        window.location.href = '/thank-you/';
      } catch (_) {
        if (btn) { btn.disabled = false; btn.textContent = 'Send me the starter pack →'; }
        if (errorEl) errorEl.style.display = 'block';
      }
    });
  })();
  </script>
</Base>
