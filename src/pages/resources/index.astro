          <span style="color:#A9812E;font-weight:600;font-size:0.85rem;">Read case study →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- DIGEST SIGNUP -->
  <section class="section" style="padding-bottom:0;">
    <div class="container" style="max-width:860px;">
      <DigestSignup
