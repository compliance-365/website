---
// Compliance365 AI Chat Widget
// Set CHAT_API to your deployed Lambda endpoint URL
const CHAT_API = "https://uclqeiwzgi.execute-api.ap-southeast-2.amazonaws.com/NewDeploy/chat";
---

<div id="c365-chat">
  <!-- Launcher button -->
  <button id="c365-launcher" aria-label="Ask Compliance365 AI" aria-expanded="false">
    <svg id="c365-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <svg id="c365-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span id="c365-label">Ask AI</span>
  </button>

  <!-- Chat panel -->
  <div id="c365-panel" role="dialog" aria-label="Compliance365 AI chat" hidden>
    <!-- Header -->
    <div class="c365-header">
      <div class="c365-header-info">
        <div class="c365-avatar">C</div>
        <div>
          <strong>Compliance365 AI</strong>
          <span class="c365-online">&#9679; Online</span>
        </div>
      </div>
      <button class="c365-close-btn" aria-label="Close chat">&times;</button>
    </div>

    <!-- Messages -->
    <div id="c365-messages" role="log" aria-live="polite">
      <div class="c365-msg-wrap c365-msg-wrap--bot">
        <div class="c365-msg-label">Compliance365 AI</div>
        <div class="c365-msg c365-msg--bot">
          <p>Hi! I&rsquo;m the Compliance365 AI. I can help you work out which security or privacy framework you need, explain what&rsquo;s involved, and answer questions about ISO 27001, SOC 2, Essential Eight, and more.</p>
          <p style="margin-top:0.5rem;">What can I help you with today?</p>
        </div>
      </div>
      <!-- Quick-start chips -->
      <div class="c365-chips" id="c365-chips">
        <button class="c365-chip" data-q="Which framework do I need?">Which framework do I need?</button>
        <button class="c365-chip" data-q="How long does ISO 27001 take?">How long does ISO 27001 take?</button>
        <button class="c365-chip" data-q="What does Essential Eight cover?">What does Essential Eight cover?</button>
        <button class="c365-chip" data-q="What&rsquo;s the difference between SOC 2 and ISO 27001?">SOC 2 vs ISO 27001?</button>
      </div>
      <!-- Typing indicator — must be inside messages so insertBefore works -->
      <div id="c365-typing" class="c365-msg c365-msg--bot c365-typing" hidden>
        <span></span><span></span><span></span>
      </div>
    </div>

    <!-- Persistent booking CTA -->
    <div class="c365-book-bar">
      <a href="https://calendly.com/matt-nicholas-compliance365/30min" target="_blank" rel="noopener" class="c365-book-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Book a free 30-min call
      </a>
    </div>

    <!-- Input -->
    <div class="c365-input-row">
      <input
        id="c365-input"
        type="text"
        placeholder="Ask a question…"
        autocomplete="off"
        maxlength="500"
        aria-label="Type your message"
      />
      <button id="c365-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>

    <div class="c365-footer">
      Powered by Claude AI &middot; <a href="/contact" target="_blank">Contact us directly</a>
    </div>
  </div>
</div>

<style>
  #c365-chat {
    position: fixed;
    bottom: 88px;
    left: 20px;
    z-index: 10000;
    font-family: Nunito, system-ui, -apple-system, sans-serif;
  }

  /* ---- Launcher ---- */
  #c365-launcher {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #1e40af;
    color: #fff;
    border: none;
    border-radius: 28px;
    padding: 10px 18px 10px 14px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(30,64,175,0.38);
    transition: background 0.18s, transform 0.15s, box-shadow 0.18s;
    white-space: nowrap;
  }
  #c365-launcher:hover {
    background: #1e3a8a;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(30,64,175,0.45);
  }
  #c365-icon-close { display: none; }
  #c365-chat.open #c365-icon-open  { display: none; }
  #c365-chat.open #c365-icon-close { display: block; }
  #c365-chat.open #c365-label { display: none; }

  /* ---- Panel ---- */
  #c365-panel {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 0;
    width: 340px;
    max-height: 520px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    animation: c365-slide-up 0.22s ease;
  }
  #c365-panel[hidden] { display: none !important; }

  @keyframes c365-slide-up {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ---- Header ---- */
  .c365-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
    padding: 12px 14px;
    color: #fff;
  }
  .c365-header-info { display: flex; align-items: center; gap: 10px; }
  .c365-avatar {
    width: 34px;
    height: 34px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1rem;
    border: 2px solid rgba(255,255,255,0.35);
  }
  .c365-header strong { display: block; font-size: 0.88rem; }
  .c365-online { font-size: 0.72rem; color: #6ee7b7; font-weight: 600; }
  .c365-close-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
    padding: 2px 4px;
    border-radius: 4px;
    transition: color 0.15s;
  }
  .c365-close-btn:hover { color: #fff; }

  /* ---- Messages ---- */
  #c365-messages {
    flex: 1;
    overflow-y: auto;
    padding: 14px 14px 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scroll-behavior: smooth;
  }
  /* Message wrappers with label */
  .c365-msg-wrap { display: flex; flex-direction: column; gap: 3px; }
  .c365-msg-wrap--bot  { align-items: flex-start; }
  .c365-msg-wrap--user { align-items: flex-end; }

  .c365-msg-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    padding: 0 4px;
  }

  .c365-msg { max-width: 88%; font-size: 0.85rem; line-height: 1.55; }
  .c365-msg p { margin: 0; }
  .c365-msg--bot {
    background: #f1f5f9;
    color: #1e293b;
    border-radius: 4px 14px 14px 14px;
    padding: 10px 12px;
    align-self: flex-start;
  }
  .c365-msg--user {
    background: #1e40af;
    color: #fff;
    border-radius: 14px 4px 14px 14px;
    padding: 10px 12px;
    align-self: flex-end;
    font-weight: 600;
  }
  /* CTA button inside bot message */
  .c365-cta {
    display: inline-block;
    margin-top: 8px;
    background: #1e40af;
    color: #fff !important;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s;
  }
  .c365-cta:hover { background: #1e3a8a; }

  /* ---- Quick chips ---- */
  .c365-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .c365-chip {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    border-radius: 20px;
    padding: 4px 11px;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    font-family: inherit;
  }
  .c365-chip:hover { background: #dbeafe; border-color: #93c5fd; }

  /* ---- Typing indicator ---- */
  .c365-typing {
    display: flex !important;
    gap: 4px;
    align-items: center;
    padding: 10px 14px;
    margin: 0 14px 4px;
  }
  .c365-typing span {
    width: 7px;
    height: 7px;
    background: #94a3b8;
    border-radius: 50%;
    animation: c365-bounce 1.2s infinite;
  }
  .c365-typing span:nth-child(2) { animation-delay: 0.2s; }
  .c365-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes c365-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
    40%           { transform: translateY(-5px); opacity: 1; }
  }

  /* ---- Booking pill ---- */
  .c365-book-bar {
    padding: 8px 12px 4px;
    background: #fff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: center;
  }
  .c365-book-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #0f766e;
    color: #fff !important;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 7px 16px;
    border-radius: 20px;
    transition: background 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .c365-book-pill:hover {
    background: #0d6460;
    transform: translateY(-1px);
  }

  /* ---- Input ---- */
  .c365-input-row {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-top: 1px solid #e2e8f0;
    background: #fff;
  }
  #c365-input {
    flex: 1;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }
  #c365-input:focus { border-color: #1e40af; }
  #c365-send {
    background: #1e40af;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    cursor: pointer;
    transition: background 0.15s;
    display: flex;
    align-items: center;
  }
  #c365-send:hover { background: #1e3a8a; }
  #c365-send:disabled { background: #94a3b8; cursor: not-allowed; }

  /* ---- Footer ---- */
  .c365-footer {
    text-align: center;
    font-size: 0.7rem;
    color: #94a3b8;
    padding: 5px 14px 8px;
    background: #fff;
    border-top: 1px solid #f1f5f9;
  }
  .c365-footer a { color: #1e40af; }

  /* ---- Mobile ---- */
  @media (max-width: 480px) {
    #c365-chat { left: 12px; bottom: 80px; }
    #c365-panel { width: calc(100vw - 24px); left: 0; }
  }
</style>

<script is:inline>
(function () {
  'use strict';

  var CHAT_API = 'https://uclqeiwzgi.execute-api.ap-southeast-2.amazonaws.com/NewDeploy/chat';
  var BOOK_URL = 'https://calendly.com/matt-nicholas-compliance365/30min';

  // Keywords that should prompt a booking CTA in the response
  var CTA_TRIGGERS = ['ready','start','help','programme','cost','price','timeline','weeks','certif','engage','scope'];

  var history = [];
  var isOpen  = false;
  var isBusy  = false;

  var widget   = document.getElementById('c365-chat');
  var launcher = document.getElementById('c365-launcher');
  var panel    = document.getElementById('c365-panel');
  var msgs     = document.getElementById('c365-messages');
  var typing   = document.getElementById('c365-typing');
  var input    = document.getElementById('c365-input');
  var sendBtn  = document.getElementById('c365-send');
  var chips    = document.getElementById('c365-chips');

  function toggle() {
    isOpen = !isOpen;
    if (isOpen) {
      widget.classList.add('open');
      panel.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      input.focus();
    } else {
      widget.classList.remove('open');
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
    }
  }

  launcher.addEventListener('click', toggle);
  panel.querySelector('.c365-close-btn').addEventListener('click', toggle);

  // Quick chips
  if (chips) {
    chips.addEventListener('click', function (e) {
      var chip = e.target.closest('.c365-chip');
      if (!chip) return;
      chips.remove();
      send(chip.dataset.q);
    });
  }

  // Send on Enter
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendFromInput(); }
  });
  sendBtn.addEventListener('click', sendFromInput);

  function sendFromInput() {
    var text = input.value.trim();
    if (!text || isBusy) return;
    input.value = '';
    // Remove chips if still visible
    var c = document.getElementById('c365-chips');
    if (c) c.remove();
    send(text);
  }

  function send(text) {
    if (isBusy) return;
    isBusy = true;
    sendBtn.disabled = true;

    appendMsg('user', text);
    history.push({ role: 'user', content: text });

    // Show typing (already inside msgs in the DOM)
    typing.hidden = false;
    msgs.appendChild(typing); // keep it at the bottom
    scrollBottom();

    fetch(CHAT_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, history: history.slice(0, -1) }),
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      typing.hidden = true;
      var reply = data.reply || data.error || 'Sorry, something went wrong. Please try again.';
      history.push({ role: 'assistant', content: reply });
      var showCta = CTA_TRIGGERS.some(function(kw){ return reply.toLowerCase().includes(kw); });
      appendMsg('bot', reply, showCta);
    })
    .catch(function () {
      typing.hidden = true;
      appendMsg('bot', 'Sorry, I couldn\'t connect. Please try again or <a href="/contact" class="c365-cta" style="display:inline;background:none;color:#1e40af;padding:0;">contact us directly</a>.');
    })
    .finally(function () {
      isBusy = false;
      sendBtn.disabled = false;
      input.focus();
      scrollBottom();
    });
  }

  function appendMsg(role, text, showCta) {
    var isBot = role !== 'user';

    // Wrapper
    var wrap = document.createElement('div');
    wrap.className = 'c365-msg-wrap c365-msg-wrap--' + (isBot ? 'bot' : 'user');

    // Sender label
    var label = document.createElement('div');
    label.className = 'c365-msg-label';
    label.textContent = isBot ? 'Compliance365 AI' : 'You';
    wrap.appendChild(label);

    // Bubble
    var div = document.createElement('div');
    div.className = 'c365-msg c365-msg--' + (isBot ? 'bot' : 'user');

    if (isBot) {
      var html = text
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
        .replace(/\n\n/g,'</p><p>').replace(/\n/g,'<br>');
      div.innerHTML = '<p>' + html + '</p>';
      if (showCta && history.length <= 10) {
        var a = document.createElement('a');
        a.href = BOOK_URL; a.target = '_blank'; a.rel = 'noopener';
        a.className = 'c365-cta';
        a.textContent = 'Book a free 30-min call →';
        div.appendChild(a);
      }
    } else {
      div.textContent = text;
    }

    wrap.appendChild(div);
    msgs.insertBefore(wrap, typing);
    scrollBottom();
  }

  function scrollBottom() {
    msgs.scrollTop = msgs.scrollHeight;
  }

  // Global opener: c365OpenChat(message) — used by checklists and other pages
  window.c365OpenChat = function(message) {
    if (!isOpen) toggle();
    if (message) {
      var c = document.getElementById('c365-chips');
      if (c) c.remove();
      setTimeout(function() { send(String(message)); }, 120);
    }
  };
})();
</script>
