---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScopingWidget from '../components/ScopingWidget.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import { readFileSync } from 'node:fs';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

// Client trust strip. Inlined (not <img>) so currentColor in the source
// SVGs picks up the CSS color set on .trust-logo-item — an <img> would
// load each file in its own document context and currentColor would
// resolve to black regardless of the page's colour scheme.
const clientLogos = [
  { name: 'Landcom', svg: readFileSync(new URL('../../public/assets/clients/landcom.svg', import.meta.url), 'utf8') },
  { name: 'Megaport', svg: readFileSync(new URL('../../public/assets/clients/megaport.svg', import.meta.url), 'utf8') },
];

// Framework rotator — real destinations, no href="#". Used both by the
// 3D ring's click handler and as the always-present noscript/no-3D
// fallback list, so the same four links exist whether or not the ring
// ever renders.
const heroFrameworks = [
  { name: 'ISO 27001', desc: 'Information security management — the baseline certification enterprise and government buyers require. Audit-ready in 8–12 weeks.', url: `${base}services/iso27001/` },
  { name: 'SOC 2', desc: 'Type I & II readiness for US and global enterprise deals, with reusable automated evidence. 6–10 weeks.', url: `${base}services/soc2/` },
  { name: 'Essential Eight', desc: "ASD's eight controls uplifted to ML2 — mandatory for Commonwealth entities and government supply chains. 6–10 weeks.", url: `${base}services/essential-eight/` },
  { name: 'ISO 42001', desc: 'AI governance — the certification enterprise AI buyers now demand. Early-mover specialisation. 8–12 weeks.', url: `${base}services/iso42001/` },
];

// Compact Control Constellation thumbnail — same deterministic radial
// layout as Checkpoint's own constellationLayout(), scaled down for a
// homepage teaser rather than the full guided-tour vignette.
function buildConstellationThumb() {
  const cx = 100, cy = 100, innerR = 24, outerR = 88, gap = 0.14;
  const sectors = [
    { statuses: ['pass', 'warn', 'pass', 'faint', 'pass'] },
    { statuses: ['pass', 'pass', 'warn', 'faint'] },
    { statuses: ['warn', 'pass', 'pass', 'faint', 'pass'] },
    { statuses: ['pass', 'faint', 'warn'] },
  ];
  const colors = { pass: '#8fbf9a', warn: '#D8BA78', faint: 'rgba(250,247,241,.28)' };
  const total = sectors.length;
  const span = (2 * Math.PI - gap * total) / total;
  const nodes = [];
  sectors.forEach((sec, si) => {
    const start = si * (span + gap) - Math.PI / 2;
    const n = sec.statuses.length;
    sec.statuses.forEach((status, i) => {
      const angle = start + ((i + 0.5) / n) * span;
      const radius = innerR + (outerR - innerR) * (0.25 + 0.65 * ((i % 3) / 2));
      nodes.push({ x: cx + radius * Math.cos(angle), y: cy + radius * Math.sin(angle), status });
    });
  });
  const edgeIdx = [[0, 6], [2, 10], [4, 14]];
  const edgesSvg = edgeIdx
    .filter(([a, b]) => nodes[a] && nodes[b])
    .map(([a, b]) => `<line x1="${nodes[a].x.toFixed(1)}" y1="${nodes[a].y.toFixed(1)}" x2="${nodes[b].x.toFixed(1)}" y2="${nodes[b].y.toFixed(1)}" stroke="#D8BA78" stroke-width="1" opacity=".16"/>`)
    .join('');
  const nodesSvg = nodes
    .map((n, idx) => `<circle cx="${n.x.toFixed(1)}" cy="${n.y.toFixed(1)}" r="${n.status === 'faint' ? 2.4 : 3.2}" fill="${colors[n.status]}"${idx === 1 ? ' class="home-cx-pulse"' : ''}/>`)
    .join('');
  return `<svg viewBox="0 0 200 200" aria-hidden="true" class="home-cx-svg">${edgesSvg}${nodesSvg}</svg>`;
}
const constellationThumb = buildConstellationThumb();

const faqs = [
  {
    q: 'Will this disrupt my engineering or operations team?',
    a: 'No. Everything is built directly inside your existing environment — Microsoft 365, SharePoint, Intune, Defender. No third-party platform to roll out, no forced change management, no endless meetings. Checkpoint, the console we deliver on, lives in your tenant from day one — your team logs in with the Microsoft account they already have. Your team stays focused on their actual work.',
  },
  {
    q: 'How long does it actually take?',
    a: 'Assessments deliver in 2–3 weeks. Full uplift and certification programmes typically run 8–14 weeks for SMB scope, and up to 6 months for mid-market programmes covering all controls. We give you a realistic timeline on the first call — not a number designed to win the pitch.',
  },
  {
    q: 'What does it cost?',
    a: 'All engagements are fixed-price with milestone-based payments — you only pay when outcomes are demonstrably delivered. Typical programmes run at 60–80% less than large consulting firms, with no annual third-party platform licence on top — Checkpoint, our own delivery console, is included in every consulting engagement at no extra cost, and it stays in your tenant even if you never engage us again. Prefer to run it yourself without consulting? Checkpoint is also available self-serve from $7,000/year per framework. We scope honestly so there are no surprises.',
  },
  {
    q: 'Can we get multiple certifications at once?',
    a: 'Yes — this is one of our core strengths. We map a single set of controls across ISO 27001, SOC 2, Essential Eight, and ISO 42001 simultaneously, so you avoid duplicated effort and cost.',
  },
];

// JSON-LD
// Organization/ProfessionalService/LocalBusiness data used to live here
// too (as a second, independently-maintained `orgLd` object) — dropped
// in favour of the one BaseLayout.astro already renders on every page
// (including this one), which has since grown a proper @id, the full
// offer catalog, knowsAbout, and now LocalBusiness + opening hours.
// Having two overlapping ProfessionalService entities on the same page
// with no shared @id had already drifted (this one's phone number was
// formatted "+61-468-752243" against BaseLayout's "+61468752243") —
// exactly the kind of duplicate-entity confusion Google's structured
// data guidelines warn against, and it would only have kept drifting
// from here. FAQPage below is page-specific content, not redundant with
// anything BaseLayout provides, so it stays.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<Base
  title="ISO 27001, SOC 2 &amp; Essential Eight Australia | Compliance365"
  description="Australian consultancy delivering ISO 27001, SOC 2, Essential Eight and ISO 42001 inside your existing Microsoft 365. Fixed-price, audit-ready in 8–14 weeks."
>

<Header />

<main id="main-content" tabindex="-1">

<!-- ANNOUNCEMENT BAR -->
<div class="announce">
  <strong>ISO 42001 AI Governance</strong> — now available alongside ISO 27001, Essential Eight &amp; SOC 2
  &nbsp;·&nbsp; <a href={`${base}services/iso42001/`}>Learn more →</a>
</div>

<!-- HERO (dark ink — full-height, cinematic) -->
<section class="hero-dk">
  <CinematicBackground />
  <div class="hero-dk-inner">

    <!-- LEFT: copy -->
    <div class="hero-dk-copy">
      <p class="hdk-eyebrow hdk-rise" style="--rise:1">Cyber · Privacy · AI Governance</p>
      <h1 class="hdk-h1">
        <span class="hl"><span class="hl-i" style="--hl:1">Certified in</span></span>
        <span class="hl"><span class="hl-i" style="--hl:2">weeks.</span></span>
        <span class="hl"><span class="hl-i" style="--hl:3"><em class="hdk-accent">Not quarters.</em></span></span>
      </h1>
      <p class="hdk-sub hdk-rise" style="--rise:2">
        ISO 27001, SOC 2, Essential Eight and ISO 42001 — delivered inside the Microsoft 365 you already own.
        Fixed price. No third-party platform holding your data. <strong>Every client we've taken to certification has passed on the first attempt.</strong>
      </p>
      <div class="hdk-ctas hdk-rise" style="--rise:3">
        <a href={ctaUrl} class="btn-hdk-primary">Scope my certification →</a>
        <a href="#estimate" class="btn-hdk-ghost">Get a 30-second estimate</a>
      </div>
      <!-- Proof ledger — the one KPI row on this page -->
      <div class="proof-ledger hdk-rise" style="--rise:4">
        <div class="pl-item"><b>100%</b><span>First-time pass</span></div>
        <div class="pl-item"><b>8–14</b><span>Weeks to audit-ready</span></div>
        <div class="pl-item"><b>60–80%</b><span>Below Big 4</span></div>
        <div class="pl-item"><b>$0</b><span>Third-party platform tax</span></div>
      </div>
      <!-- Framework index — real links, not anchors to a section that may not be on this page -->
      <div class="fw-index hdk-rise" style="--rise:5">
        <span class="fi-label">Frameworks</span>
        <a href={`${base}services/iso27001/`}>ISO 27001</a>
        <a href={`${base}services/soc2/`}>SOC 2</a>
        <a href={`${base}services/essential-eight/`}>Essential 8</a>
        <a href={`${base}services/iso42001/`}>ISO 42001</a>
        <a href={`${base}services/iso27701/`}>ISO 27701</a>
        <a href={`${base}services/disp-ism-irap/`}>DISP / IRAP</a>
        <a href={`${base}services/nist-csf/`}>NIST CSF</a>
        <a href={`${base}services/is18/`}>IS18</a>
        <a href={`${base}services/rffr/`}>RFFR</a>
      </div>
    </div>

    <!-- RIGHT: 3D ring stage -->
    <div class="ring-stage" id="ring-stage" data-base={base}>
      <div class="fw-chip" id="fwChip">
        <div class="fw-rule"></div>
        <b id="fwName"></b>
        <p id="fwDesc"></p>
        <a id="fwLink" href={heroFrameworks[0].url}>Explore framework →</a>
      </div>
      <div class="ring-fallback">
        <svg viewBox="0 0 200 200" fill="none" style="width:min(62%,340px);height:auto;">
          <path d="M176.2,56 A88,88 0 1,0 176.2,144" stroke="#FAF7F1" stroke-width="10" stroke-linecap="round"/>
          <circle class="ring-pulse-dot" cx="188" cy="100" r="9" fill="#A9812E"/>
        </svg>
      </div>
      <div class="stage-hint" id="stageHint">Drag to rotate · Click a framework</div>
      <!-- Static, crawlable fallback — shown whenever the 3D stage hasn't
           taken over (no JS, or Three.js failed to load). Real links,
           not decoration. -->
      <ul class="ring-static-fallback">
        {heroFrameworks.map(f => <li><a href={f.url}>{f.name} →</a></li>)}
      </ul>
      <noscript>
        <ul class="ring-static-fallback ring-noscript">
          {heroFrameworks.map(f => <li><a href={f.url}>{f.name} →</a></li>)}
        </ul>
      </noscript>
    </div>

  </div>

  <!-- Scroll cue -->
  <div class="hdk-cue" aria-hidden="true">
    <span>See how</span>
    <div class="hdk-cue-line"></div>
  </div>
</section>

<!-- FRAMEWORK MARQUEE -->
<div class="fw-marquee" aria-hidden="true">
  <div class="fw-marquee-track">
    <span class="fw-marquee-item">ISO 27001</span>
    <span class="fw-marquee-item">SOC 2</span>
    <span class="fw-marquee-item">Essential Eight</span>
    <span class="fw-marquee-item">ISO 42001 — AI Governance</span>
    <span class="fw-marquee-item">ISO 27701 — Privacy</span>
    <span class="fw-marquee-item">DISP / ISM / IRAP</span>
    <span class="fw-marquee-item">NIST CSF</span>
    <span class="fw-marquee-item">IS18 — QLD Government</span>
    <span class="fw-marquee-item">RFFR</span>
    <span class="fw-marquee-item">ISO 27001</span>
    <span class="fw-marquee-item">SOC 2</span>
    <span class="fw-marquee-item">Essential Eight</span>
    <span class="fw-marquee-item">ISO 42001 — AI Governance</span>
    <span class="fw-marquee-item">ISO 27701 — Privacy</span>
    <span class="fw-marquee-item">DISP / ISM / IRAP</span>
    <span class="fw-marquee-item">NIST CSF</span>
    <span class="fw-marquee-item">IS18 — QLD Government</span>
    <span class="fw-marquee-item">RFFR</span>
  </div>
</div>
<style>
  .fw-marquee{position:relative;overflow:hidden;padding:20px 0;background:#0B0B0C;border-bottom:1px solid rgba(255,255,255,.1);}
  .fw-marquee-track{display:flex;gap:48px;width:max-content;animation:fwMarquee 34s linear infinite;}
  .fw-marquee:hover .fw-marquee-track{animation-play-state:paused;}
  @keyframes fwMarquee{to{transform:translateX(-50%);}}
  .fw-marquee-item{white-space:nowrap;font-family:Manrope,system-ui;font-size:12.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(250,247,241,.55);display:flex;align-items:center;gap:12px;}
  .fw-marquee-item::before{content:"";width:5px;height:5px;border-radius:50%;background:#A9812E;flex-shrink:0;}
  @media (prefers-reduced-motion: reduce){.fw-marquee-track{animation:none;}}
</style>

<!-- TRUST STRIP -->
<section class="trust-strip" aria-label="Organisations we have worked with">
  <div class="container trust-strip-inner">
    <p class="trust-strip-label">Trusted by teams at</p>
    <div class="trust-strip-logos">
      {clientLogos.map(l => (
        <span class="trust-logo-item" aria-label={l.name} set:html={l.svg} />
      ))}
    </div>
  </div>
</section>
<style>
  .trust-strip{background:#0B0B0C;padding:8px 0 40px;}
  .trust-strip-inner{display:flex;align-items:center;justify-content:center;gap:clamp(20px,4vw,48px);flex-wrap:wrap;}
  .trust-strip-label{margin:0;font-family:Manrope,system-ui;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,247,241,.55);white-space:nowrap;}
  .trust-strip-logos{display:flex;align-items:center;gap:clamp(28px,4vw,56px);flex-wrap:wrap;}
  .trust-logo-item{color:rgba(250,247,241,.55);transition:color .2s;display:flex;align-items:center;}
  .trust-logo-item:hover{color:rgba(250,247,241,.9);}
  .trust-logo-item :global(svg){height:22px;width:auto;display:block;}
</style>

<!-- SCOPING TOOL (dark, raised charcoal card) -->
<section class="section reveal-section band-light" id="estimate" style="padding:4rem 0;">
  <div class="container">
    <div style="max-width:860px;margin:0 auto;background:var(--bd-card);border:1px solid var(--bd-card-bd);border-radius:8px;padding:2.5rem 2rem;">
      <!-- The ScopingWidget carries its own "Free scoping tool / Get a
           realistic scope in 30 seconds" eyebrow and h3. This wrapper used
           to repeat both verbatim — masked while the wrapper was a dark
           card holding a light widget, glaring once both share a light
           band. The h2 stays (removing it would skip the page straight
           from h1 to the widget's h3) but now frames the section instead
           of duplicating it. -->
      <p style="font-family:Manrope,system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--bd-eyebrow);margin:0 0 1rem;">Start here</p>
      <h2 style="margin:0 0 0.5rem;">Scope it yourself, before you talk to anyone.</h2>
      <p style="color:var(--bd-soft);margin:0 0 2rem;font-size:0.95rem;line-height:1.65;">Which framework fits, the typical timeline, and a ballpark cost range — without a sales call.</p>
      <ScopingWidget calendlyUrl={ctaUrl} />
    </div>
  </div>
</section>

<!-- POSTURE SCAN — LIVE DEMO -->
<section class="section reveal-section band-dark" id="scan">
  <div class="container">
    <div class="scan-wrap">
      <div>
        <div class="gold-rule-26"></div>
        <p class="scan-eyebrow">Free tool — live demo</p>
        <h2 style="color:#FAF7F1;">See your Microsoft 365 security posture in 60 seconds.</h2>
        <p style="color:rgba(250,247,241,.62);margin-top:18px;max-width:640px;font-size:15px;line-height:1.75;">Connect your M365 tenant and get an instant scored report across MFA, patch status, admin privileges, app controls and more. It runs in your tenant — <strong style="color:#FAF7F1;">no data leaves your environment.</strong> This is what it returns:</p>
        <div style="margin-top:30px;">
          <a href={`${base}posture-scan/`} class="btn-hdk-primary">Run my free posture scan →</a>
        </div>
      </div>
      <div class="scan-card skel" id="scanCard">
        <div class="scan-head"><span>Sample posture report</span><button class="scan-replay" id="scanReplay" type="button">Replay scan</button></div>
        <div class="gauge">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="gauge-track" cx="60" cy="60" r="52" fill="none" stroke-width="9"/>
            <circle class="gauge-fill" id="gaugeFill" cx="60" cy="60" r="52" fill="none" stroke-width="9" stroke-linecap="round" transform="rotate(-90 60 60)"/>
          </svg>
          <div>
            <div class="gauge-num"><span id="gaugeNum">0</span><small> /100</small></div>
            <div class="gauge-cap">Tenant posture score</div>
          </div>
        </div>
        <div id="scanRows">
          <div class="check-row"><span>Multi-factor authentication</span><span class="st st-pass">Pass</span></div>
          <div class="check-row"><span>Admin privileges</span><span class="st st-warn">Review</span></div>
          <div class="check-row"><span>Application hardening</span><span class="st st-fail">Fail</span></div>
          <div class="check-row"><span>Patch status</span><span class="st st-warn">Review</span></div>
          <div class="check-row"><span>Audit logging</span><span class="st st-pass">Pass</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CHECKPOINT TEASER -->
<section class="section reveal-section band-dark">
  <div class="container">
    <div class="ckpt-teaser">
      <div class="ckpt-teaser-visual" aria-hidden="true">
        <Fragment set:html={constellationThumb} />
      </div>
      <div class="ckpt-teaser-copy">
        <div class="gold-rule-26"></div>
        <p class="ckpt-teaser-eyebrow">Checkpoint</p>
        <h2 style="color:#FAF7F1;max-width:22ch;">The console behind every engagement — and yours to keep.</h2>
        <p style="color:rgba(250,247,241,.62);margin-top:16px;font-size:15px;line-height:1.75;max-width:52ch;">
          Every certification we run happens inside Checkpoint — posture scans, a live control constellation, a compliance fingerprint that updates as controls land, an in-tenant AI that drafts but never writes. It's provisioned in your Microsoft 365 tenant on day one, included at no extra cost in every consulting engagement — or run it yourself from $7,000/year. Stop working with us and it doesn't disappear — it's already yours.
        </p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;">
          <a href={`${base}checkpoint-console/`} class="btn-hdk-primary">Explore Checkpoint →</a>
          <a href={`${base}checkpoint-console/#demo`} class="btn-hdk-ghost">Try the live demo</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PLATFORM TAX CALCULATOR -->
<section class="section reveal-section band-light" id="calculator">
  <div class="container">
    <div class="gold-rule-26"></div>
    <p class="calc-eyebrow">The third-party platform tax, calculated</p>
    <h2 style="max-width:26ch;">What does the third-party GRC-platform route really cost you?</h2>
    <p style="color:var(--bd-soft);max-width:640px;margin:18px 0 0;font-size:15px;line-height:1.75;">Vanta, Drata and similar third-party platforms charge a per-seat annual licence on top of the consulting you still need — a fee that outlives the engagement and keeps renewing whether you need it or not. We deliver the same certification inside Microsoft 365, on Checkpoint, our own console — included, fixed-price, nothing to renew. Move the sliders.</p>

    <div class="calc skel" id="calcCard">
      <div class="calc-grid">
        <div>
          <div class="calc-label">Company size<b><span id="calcEmp">120</span> staff</b></div>
          <input type="range" id="empRange" min="10" max="500" step="10" value="120" aria-label="Company size in staff">
          <div class="calc-label">Time horizon</div>
          <div class="yrs" id="yrs">
            <span class="yr" data-y="1">1 year</span>
            <span class="yr sel" data-y="3">3 years</span>
            <span class="yr" data-y="5">5 years</span>
          </div>
          <p class="calc-note">Illustrative modelling from typical Australian engagement patterns and published platform pricing. Your precise scope — and a fixed quote — comes from a free 30-minute call.</p>
        </div>
        <div class="calc-bars">
          <div>
            <div class="cbar-cap"><span>Third-party platform + consultant route</span><b id="platCost">$0</b></div>
            <div class="cbar cbar-grey"><i id="platBar"></i></div>
          </div>
          <div>
            <div class="cbar-cap cbar-cap-gold"><span>Compliance365 — no third-party platform</span><b id="c365Cost">$0</b></div>
            <div class="cbar cbar-gold"><i id="c365Bar"></i></div>
          </div>
          <div class="savings"><span>You keep</span><b id="savings">$0</b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CASE STUDY — DOSSIER (one) -->
<section class="section reveal-section band-dark">
  <div class="container">
    <div class="dossier">
      <div class="dossier-head">
        <h3>B2B SaaS Platform — 120 employees, Melbourne</h3>
        <span>A recent engagement</span>
      </div>
      <div class="d-row"><div class="dk">Situation</div><div class="dv">Three enterprise deals stuck in procurement, all waiting for <strong>SOC 2 Type II</strong>. Sales needed certification in weeks, not months.</div></div>
      <div class="d-row"><div class="dk">Constraint</div><div class="dv">Mid-evaluation of a third-party GRC platform: $35k/yr licence + $60k consulting — <strong>$165k over three years</strong>.</div></div>
      <div class="d-row"><div class="dk">Delivery</div><div class="dv">Trust Services Criteria mapped directly to existing M365 controls. Evidence capture in SharePoint, automated Power BI reporting via Checkpoint — already living in their tenant. <strong>No third-party platform introduced.</strong></div></div>
      <div class="d-row"><div class="dk">Outcome</div><div class="dv"><strong>Type II readiness in 10 weeks</strong> at less than half the platform-led quote. Three deals closed within 60 days of certification.</div></div>
      <div class="d-quote">
        <div class="gold-rule-26"></div>
        <p>"SOC 2 was a direct sales blocker. Compliance365 delivered Type II readiness in weeks, at a fraction of the usual cost. The reusable evidence pack has since closed multiple six-figure deals."</p>
        <footer>VP Engineering — B2B SaaS Platform, Melbourne</footer>
      </div>
    </div>
    <p style="margin-top:2rem;">
      <a href={`${base}case-studies/`} style="color:#D8BA78;font-weight:700;font-size:11px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid rgba(216,186,120,.4);padding-bottom:4px;font-family:Manrope,system-ui,sans-serif;">See all case studies →</a>
    </p>
  </div>
</section>

<!-- HOW WE COMPARE -->
<section class="section reveal-section band-light">
  <div class="container">
    <p class="method-eyebrow">Honest comparison</p>
    <h2 style="max-width:26ch;">We compete with three things. Here's how we differ from each.</h2>
    <p style="color:var(--bd-soft);max-width:640px;margin:14px 0 0;font-size:15px;line-height:1.75;">Most buyers are evaluating us against Big 4 consulting, a third-party GRC platform, or another Australian boutique.</p>

    <!-- Quick-scan summary -->
    <div class="compare-table" style="margin-top:2.75rem;">
      <div class="ct-row ct-head">
        <div></div>
        <div>The traditional route</div>
        <div class="ct-us">Compliance365</div>
      </div>
      <div class="ct-row">
        <div>Timeline</div>
        <div class="ct-neg">6–18 months</div>
        <div class="ct-pos">8–14 weeks</div>
      </div>
      <div class="ct-row">
        <div>Cost</div>
        <div class="ct-neg">High six-figures, plus annual licences</div>
        <div class="ct-pos">Fixed price, 60–80% less</div>
      </div>
      <div class="ct-row">
