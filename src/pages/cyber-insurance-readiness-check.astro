---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import ScopingWidget from '../components/ScopingWidget.astro';
import { QUESTIONS, BANDS, MAX_SCORE } from '../data/cyber-insurance-readiness-rules.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

const pageTitle = 'Free Cyber Insurance Readiness Check | Compliance365';
const pageDesc = 'A free 9-question check covering what Australian cyber insurers ask at underwriting and renewal — MFA, EDR, backups, patching and incident response.';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Cyber Insurance Readiness Check',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  description: pageDesc,
  url: 'https://www.compliance365.com.au/cyber-insurance-readiness-check/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' }
};
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={[articleLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Cyber Insurance Readiness Check', url: 'https://www.compliance365.com.au/cyber-insurance-readiness-check/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner" style="grid-template-columns:1fr;max-width:820px;">
      <div class="svc-hero-copy">
        <p class="eyebrow">Free tool · no sign-up</p>
        <h1>Would your controls pass a cyber insurance underwriting review?</h1>
        <p class="section-lead">
          9 questions covering exactly what Australian cyber insurers ask about at underwriting and renewal in 2026 — MFA, endpoint protection, backups, patching, incident response and more. Get a readiness score and your top gaps, framed the way an underwriter sees them.
        </p>
      </div>
    </div>
  </section>

  <!-- WIZARD -->
  <section class="section" id="cir-app">
    <div class="container" style="max-width:720px;">

      <div class="cir-card">
        <div class="cir-progress" id="cir-progress"></div>

        <div id="cir-question-panel">
          <div class="cir-insurer-frame" id="cir-insurer-frame"></div>
          <div class="cir-question" id="cir-question"></div>
          <div class="cir-options" id="cir-options"></div>
          <button type="button" class="cir-back" id="cir-back" hidden>&larr; Back</button>
        </div>

        <div id="cir-result-panel" hidden></div>
      </div>

      <p class="cir-disclaimer">
        General guidance only. There's no single standard underwriting form — this reflects patterns consistent across multiple Australian broker and cyber-security advisory sources, not one insurer's actual questionnaire. Your specific policy's requirements are set by your insurer; confirm with your broker.
      </p>
    </div>
  </section>

  <!-- SCOPING WIDGET -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container" style="max-width:720px;">
      <ScopingWidget calendlyUrl={ctaUrl} />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Close these gaps before your next renewal</h2>
      <p>
        Essential Eight uplift covers most of what insurers ask about — MFA, patching, application control, backups — in one fixed-price engagement. Talk to us, or see how the service works.
      </p>
      <div class="final-buttons">
        <a href={ctaUrl} class="btn-hdk-primary">Talk to us</a>
        <a href={`${base}services/essential-eight/`} class="btn-hdk-ghost">See the Essential Eight service</a>
      </div>
    </div>
  </section>

  </main>

  <Footer />

  <style is:global>
    .cir-card { background: #ffffff; border: 1px solid #DDD8CF; border-radius: 16px; padding: 32px; }
    .cir-progress { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #A9812E; margin-bottom: 14px; }
    .cir-insurer-frame { font-size: 13px; color: #8B6820; background: rgba(169,129,46,0.08); border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; line-height: 1.55; }
    .cir-question { font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(1.15rem, 2.4vw, 1.4rem); color: #0B0B0C; line-height: 1.35; margin-bottom: 20px; }
    .cir-options { display: flex; flex-direction: column; gap: 10px; }
    .cir-opt {
      text-align: left; background: #ffffff; border: 1.5px solid #DDD8CF; border-radius: 10px;
      padding: 14px 18px; font-family: Manrope, system-ui, sans-serif; font-size: 14px; font-weight: 600;
      color: #0B0B0C; cursor: pointer; transition: all .12s ease; line-height: 1.5;
    }
    .cir-opt:hover { border-color: #A9812E; background: rgba(169,129,46,0.05); }
    .cir-opt:focus-visible { outline: 2px solid #A9812E; outline-offset: 2px; }
    .cir-back { margin-top: 20px; background: none; border: none; color: #6B6860; font-size: 13px; font-family: Manrope, system-ui, sans-serif; cursor: pointer; text-decoration: underline; padding: 0; }
    .cir-back:hover { color: #3A3632; }

    .cir-score-row { display: flex; align-items: center; gap: 24px; margin-bottom: 20px; flex-wrap: wrap; }
    .cir-score-num { font-size: 3rem; font-weight: 800; color: #0B0B0C; line-height: 1; }
    .cir-score-max { font-size: 1.1rem; color: #6B6860; font-weight: 600; }
    .cir-band-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 7px 16px; border-radius: 999px; }

    .cir-critical-banner {
      background: #FEF2F2; border: 1.5px solid #FCA5A5; color: #B91C1C; border-radius: 10px;
      padding: 14px 18px; margin-bottom: 20px; font-size: 13.5px; font-weight: 600; line-height: 1.6;
    }

    .cir-gap-list { display: flex; flex-direction: column; gap: 12px; margin: 20px 0; }
    .cir-gap {
      background: #FAF7F1; border-radius: 10px; padding: 16px 18px; border-left: 3px solid #A9812E;
    }
    .cir-gap-title { font-size: 13.5px; font-weight: 700; color: #0B0B0C; margin-bottom: 4px; }
    .cir-gap-you { font-size: 13px; color: #3A3632; margin-bottom: 6px; }
    .cir-gap-you strong { color: #8B6820; }
    .cir-gap-why { font-size: 12.5px; color: #6B6860; line-height: 1.55; }
    .cir-no-gaps { background: #F0FDF4; border-radius: 10px; padding: 16px 18px; font-size: 13.5px; color: #166534; font-weight: 600; }

    .cir-result-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 20px 0 8px; }
    .cir-btn-primary {
      background: #A9812E; color:var(--on-gold); font-family: Manrope, system-ui, sans-serif; font-weight: 700; font-size: 13.5px;
      padding: 12px 22px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
    }
    .cir-btn-primary:hover { background: #8B6820; }
    .cir-btn-ghost {
      border: 1.5px solid #A9812E; color: #A9812E; font-family: Manrope, system-ui, sans-serif; font-weight: 700; font-size: 13.5px;
      padding: 12px 22px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
    }
    .cir-btn-ghost:hover { background: rgba(169,129,46,0.06); }
    .cir-restart { margin-top: 12px; background: none; border: none; color: #6B6860; font-size: 13px; font-family: Manrope, system-ui, sans-serif; cursor: pointer; text-decoration: underline; padding: 0; }

    .cir-disclaimer { font-size: 12px; color: #6B6860; margin-top: 18px; line-height: 1.6; }

    @media (max-width: 640px) {
      .cir-card { padding: 20px; }
    }
  </style>

  <script define:vars={{ QUESTIONS, BANDS, MAX_SCORE, ctaUrl, essentialEightUrl: `${base}services/essential-eight/` }}>
    (function () {
      var answers = {}; // id -> value
      var history = [];

      var progressEl = document.getElementById('cir-progress');
      var frameEl = document.getElementById('cir-insurer-frame');
      var questionEl = document.getElementById('cir-question');
      var optionsEl = document.getElementById('cir-options');
      var backBtn = document.getElementById('cir-back');
      var questionPanel = document.getElementById('cir-question-panel');
      var resultPanel = document.getElementById('cir-result-panel');

      function stepIndex(id) {
        for (var i = 0; i < QUESTIONS.length; i++) if (QUESTIONS[i].id === id) return i;
        return -1;
      }

      function renderStep(q) {
        questionPanel.hidden = false;
        resultPanel.hidden = true;
        progressEl.textContent = 'Question ' + (history.length + 1) + ' of ' + QUESTIONS.length;
        frameEl.textContent = q.insurerFrames;
        questionEl.textContent = q.question;
        optionsEl.innerHTML = '';
        q.options.forEach(function (opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cir-opt';
          btn.textContent = opt.label;
          btn.addEventListener('click', function () {
            answers[q.id] = opt.value;
            history.push(q.id);
            var next = QUESTIONS[stepIndex(q.id) + 1];
            if (next) renderStep(next); else renderResult();
          });
          optionsEl.appendChild(btn);
        });
        backBtn.hidden = history.length === 0;
      }

      backBtn.addEventListener('click', function () {
        if (!history.length) return;
        var lastId = history.pop();
        delete answers[lastId];
        renderStep(QUESTIONS[stepIndex(lastId)]);
      });

      function selectedOption(q) {
        var val = answers[q.id];
        return q.options.find(function (o) { return o.value === val; });
      }

      function computeScore() {
        var total = 0;
        QUESTIONS.forEach(function (q) {
          var opt = selectedOption(q);
          total += q.weight * (opt ? opt.score : 0);
        });
        return Math.round(total);
      }

      function nonNegotiableFailed() {
        return QUESTIONS.some(function (q) {
          if (!q.nonNegotiable) return false;
          var opt = selectedOption(q);
          return opt && opt.score === 0;
        });
      }

      function criticalFlags() {
        return QUESTIONS.filter(function (q) {
          return q.criticalIf && answers[q.id] === q.criticalIf;
        });
      }

      function pickBand(score) {
        if (nonNegotiableFailed()) {
          return BANDS.find(function (b) { return b.id === 'high-risk'; });
        }
        for (var i = 0; i < BANDS.length; i++) {
          if (score >= BANDS[i].min) return BANDS[i];
        }
        return BANDS[BANDS.length - 1];
      }

      function renderResult() {
        questionPanel.hidden = true;
        resultPanel.hidden = false;
        progressEl.textContent = 'Your result';

        var score = computeScore();
        var band = pickBand(score);
        var criticals = criticalFlags();

        var html = '';
        html += '<div class="cir-score-row">';
        html += '<div><span class="cir-score-num">' + score + '</span><span class="cir-score-max">/' + MAX_SCORE + '</span></div>';
        html += '<span class="cir-band-badge" style="background:' + band.bg + ';color:' + band.color + ';">' + band.label + '</span>';
        html += '</div>';

        criticals.forEach(function (q) {
          html += '<div class="cir-critical-banner">&#9888; ' + q.insurerFrames + ' This alone is commonly enough to trigger a decline or heavy loading, regardless of your other answers.</div>';
        });

        var gaps = QUESTIONS
          .map(function (q) {
            var opt = selectedOption(q);
            var lost = q.weight * (1 - (opt ? opt.score : 0));
            return { q: q, opt: opt, lost: lost };
          })
          .filter(function (g) { return g.opt && g.opt.score < 1; })
          .sort(function (a, b) { return b.lost - a.lost; });

        if (gaps.length) {
          html += '<div class="cir-gap-list">';
          gaps.forEach(function (g) {
            html += '<div class="cir-gap">';
            html += '<div class="cir-gap-title">' + g.q.question + '</div>';
            html += '<div class="cir-gap-you">Where you stand: <strong>' + g.opt.label + '</strong></div>';
            html += '<div class="cir-gap-why">' + g.q.insurerFrames + '</div>';
            html += '</div>';
          });
          html += '</div>';
        } else {
          html += '<div class="cir-no-gaps">No gaps flagged — your answers cover every control insurers commonly ask about.</div>';
        }

        html += '<div class="cir-result-actions">';
        html += '<a href="' + ctaUrl + '" class="cir-btn-primary">Talk to us about closing these gaps &rarr;</a>';
        html += '<a href="' + essentialEightUrl + '" class="cir-btn-ghost">See the Essential Eight service</a>';
        html += '</div>';
        html += '<button type="button" class="cir-restart" id="cir-restart">&larr; Start over</button>';

        resultPanel.innerHTML = html;
        document.getElementById('cir-restart').addEventListener('click', function () {
          answers = {};
          history = [];
          renderStep(QUESTIONS[0]);
        });

        if (typeof gtag === 'function') {
          gtag('event', 'insurance_readiness_completed', { score: score, band: band.id });
        }
      }

      renderStep(QUESTIONS[0]);
    })();
  </script>
</Base>
