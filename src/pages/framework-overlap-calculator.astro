---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import ScopingWidget from '../components/ScopingWidget.astro';
import { FRAMEWORKS, CONTROL_DOMAINS } from '../data/framework-overlap-controls.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

const pageTitle = 'Framework Overlap Calculator — how much ISO 27001, SOC 2 & Essential Eight controls overlap | Compliance365';
const pageDesc = 'Pick two or more of ISO 27001, SOC 2, Essential Eight, ISO 42001, ISO 27701, DISP/IRAP, NIST CSF, IS18 and RFFR — see exactly how many controls overlap versus how many are unique to each, and what that overlap saves you.';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Framework Overlap Calculator',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  description: pageDesc,
  url: 'https://www.compliance365.com.au/framework-overlap-calculator/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' }
};

const DEFAULT_SELECTED = ['iso27001', 'soc2'];
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={[articleLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Framework Overlap Calculator', url: 'https://www.compliance365.com.au/framework-overlap-calculator/' }
  ]}
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner" style="grid-template-columns:1fr;max-width:820px;">
      <div class="svc-hero-copy">
        <p class="eyebrow">Free tool · no sign-up</p>
        <h1>How much of your next certification is work you've already done?</h1>
        <p class="section-lead">
          Pick two or more frameworks. We'll show which controls overlap, which are unique to each, and roughly how many duplicated controls you avoid by running them as one integrated programme instead of separate projects.
        </p>
      </div>
    </div>
  </section>

  <!-- PICKER + RESULTS -->
  <section class="section" id="foc-app">
    <div class="container" style="max-width:1000px;">

      <div class="foc-picker">
        <div class="foc-picker-label">Select the frameworks you're comparing (2 or more)</div>
        <div class="foc-chip-grid" id="foc-chips">
          {Object.entries(FRAMEWORKS).map(([slug, fw]) => (
            <button
              type="button"
              class={`foc-chip${DEFAULT_SELECTED.includes(slug) ? ' is-active' : ''}`}
              data-slug={slug}
              aria-pressed={DEFAULT_SELECTED.includes(slug) ? 'true' : 'false'}
            >
              {fw.label}
            </button>
          ))}
        </div>
        <div class="foc-hint" id="foc-hint">Select at least 2 frameworks to see the overlap.</div>
      </div>

      <div id="foc-results" class="foc-results">
        <div class="foc-takeaway" id="foc-takeaway"></div>

        <div class="foc-stats" id="foc-stats"></div>

        <div class="foc-grid-wrap">
          <table class="foc-table" id="foc-table">
            <thead id="foc-thead"></thead>
            <tbody id="foc-tbody"></tbody>
          </table>
        </div>

        <p class="foc-disclaimer">
          Indicative, control-domain-level estimate — not a clause-by-clause legal mapping. Real scope is confirmed during a scoping engagement.
          See how this works in detail in <a href={`${base}resources/inside-statement-of-applicability/`}>the Integrated SoA guide</a>.
        </p>
      </div>

    </div>
  </section>

  <!-- SCOPING WIDGET -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container" style="max-width:720px;">
      <ScopingWidget calendlyUrl={ctaUrl} />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Turn this overlap into one certification programme</h2>
      <p>
        Book a free 30-minute scoping call and we'll confirm the exact shared control set for your selection, mapped to your existing Microsoft 365 tenant — fixed price, no obligation to continue.
      </p>
      <div class="final-buttons">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free 30-min call</a>
        <a href={`${base}services/`} class="btn-hdk-ghost">See all frameworks we cover</a>
      </div>
    </div>
  </section>

  <Footer />

  <style is:global>
    .foc-picker {
      background: #ffffff; border: 1px solid #DDD8CF; border-radius: 16px;
      padding: 28px; margin-bottom: 32px;
    }
    .foc-picker-label { font-size: 13px; font-weight: 700; color: #0B0B0C; margin-bottom: 12px; }
    .foc-chip-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
    .foc-chip {
      font-family: Manrope, system-ui, sans-serif; background: #ffffff; border: 1px solid #DDD8CF;
      border-radius: 8px; padding: 11px 14px; font-size: 13.5px; font-weight: 600; color: #0B0B0C;
      cursor: pointer; transition: all .12s ease;
    }
    .foc-chip:hover { border-color: #A9812E; }
    .foc-chip:focus-visible { outline: 2px solid #A9812E; outline-offset: 2px; }
    .foc-chip.is-active { background: #A9812E; color: #fff; border-color: #A9812E; }
    .foc-hint { margin-top: 12px; font-size: 13px; color: #6B6860; }
    .foc-hint.is-ok { display: none; }

    .foc-results { display: none; }
    .foc-results.is-visible { display: block; }

    .foc-takeaway {
      font-family: Fraunces, Georgia, serif; font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 500;
      color: #0B0B0C; line-height: 1.4; margin-bottom: 28px; padding: 22px 26px;
      background: rgba(169,129,46,0.08); border-left: 4px solid #A9812E; border-radius: 0 12px 12px 0;
    }
    .foc-takeaway strong { color: #8B6820; }

    .foc-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .foc-stat {
      background: #ffffff; border: 1px solid #DDD8CF; border-radius: 12px; padding: 20px 22px;
    }
    .foc-stat-value { font-size: 2rem; font-weight: 800; color: #0B0B0C; line-height: 1; margin-bottom: 6px; }
    .foc-stat-value.accent { color: #A9812E; }
    .foc-stat-label { font-size: 12.5px; color: #6B6860; line-height: 1.4; }

    .foc-grid-wrap { overflow-x: auto; border: 1px solid #DDD8CF; border-radius: 12px; }
    .foc-table { width: 100%; border-collapse: collapse; font-size: 13.5px; background: #fff; }
    .foc-table th, .foc-table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid #EFEBE3; white-space: nowrap; }
    .foc-table th { background: #0B0B0C; color: #FAF7F1; font-weight: 600; position: sticky; top: 0; }
    .foc-table td:first-child, .foc-table th:first-child { white-space: normal; min-width: 240px; position: sticky; left: 0; background: #fff; }
    .foc-table th:first-child { background: #0B0B0C; }
    .foc-table tr.foc-row-shared td:first-child { background: rgba(169,129,46,0.07); }
    .foc-table tr.foc-row-shared { background: rgba(169,129,46,0.055); }
    .foc-table tr.foc-row-cat td { background: #FAF7F1; font-weight: 700; font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em; color: #8B6820; position: static; }
    .foc-table td.foc-cell { text-align: center; }
    .foc-dot-yes { color: #A9812E; font-weight: 800; }
    .foc-dot-no { color: #DDD8CF; }
    .foc-domain-title { font-weight: 600; color: #0B0B0C; }
    .foc-domain-cat { display: block; font-size: 11px; color: #6B6860; margin-top: 1px; }

    .foc-disclaimer { font-size: 12px; color: #6B6860; margin-top: 18px; line-height: 1.6; }
    .foc-disclaimer a { color: #A9812E; }

    @media (max-width: 640px) {
      .foc-picker { padding: 18px; }
      .foc-stats { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <script define:vars={{ FRAMEWORKS, CONTROL_DOMAINS, DEFAULT_SELECTED }}>
    (function () {
      var selected = new Set(DEFAULT_SELECTED);
      var slugs = Object.keys(FRAMEWORKS);

      var chipsEl = document.getElementById('foc-chips');
      var hintEl = document.getElementById('foc-hint');
      var resultsEl = document.getElementById('foc-results');
      var takeawayEl = document.getElementById('foc-takeaway');
      var statsEl = document.getElementById('foc-stats');
      var theadEl = document.getElementById('foc-thead');
      var tbodyEl = document.getElementById('foc-tbody');

      function fwCountStandalone(slug) {
        return CONTROL_DOMAINS.filter(function (d) { return d.frameworks[slug]; }).length;
      }

      function joinList(items) {
        if (items.length <= 1) return items.join('');
        if (items.length === 2) return items[0] + ' and ' + items[1];
        return items.slice(0, -1).join(', ') + ' and ' + items[items.length - 1];
      }

      function render() {
        var selArr = slugs.filter(function (s) { return selected.has(s); });
        var ok = selArr.length >= 2;

        hintEl.classList.toggle('is-ok', ok);
        resultsEl.classList.toggle('is-visible', ok);
        if (!ok) return;

        var applicable = CONTROL_DOMAINS.filter(function (d) {
          return selArr.some(function (f) { return d.frameworks[f]; });
        });
        var shared = applicable.filter(function (d) {
          return selArr.filter(function (f) { return d.frameworks[f]; }).length >= 2;
        });
        var separateTotal = selArr.reduce(function (sum, f) { return sum + fwCountStandalone(f); }, 0);
        var uniqueUnion = applicable.length;
        var savings = separateTotal - uniqueUnion;

        var labels = selArr.map(function (s) { return FRAMEWORKS[s].label; });
        takeawayEl.innerHTML = 'Pursuing ' + joinList(labels) + ' together needs <strong>' + uniqueUnion + ' unique controls</strong> instead of ' + separateTotal + ' done separately — saving you approximately <strong>' + savings + ' duplicated controls</strong> compared to running them as separate projects.';

        statsEl.innerHTML =
          '<div class="foc-stat"><div class="foc-stat-value">' + uniqueUnion + '</div><div class="foc-stat-label">Unique control domains needed, combined</div></div>' +
          '<div class="foc-stat"><div class="foc-stat-value">' + shared.length + '</div><div class="foc-stat-label">Shared across two or more of your selected frameworks</div></div>' +
          '<div class="foc-stat"><div class="foc-stat-value accent">~' + savings + '</div><div class="foc-stat-label">Duplicated controls avoided vs. separate projects</div></div>';

        // Header row
        var theadHtml = '<tr><th>Control domain</th>';
        selArr.forEach(function (f) { theadHtml += '<th style="text-align:center;">' + FRAMEWORKS[f].short + '</th>'; });
        theadHtml += '</tr>';
        theadEl.innerHTML = theadHtml;

        // Body rows, grouped by category in dataset order
        var seenCats = [];
        var rowsHtml = '';
        applicable.forEach(function (d) {
          if (seenCats.indexOf(d.category) === -1) {
            seenCats.push(d.category);
            rowsHtml += '<tr class="foc-row-cat"><td colspan="' + (selArr.length + 1) + '">' + d.category + '</td></tr>';
          }
          var matchCount = selArr.filter(function (f) { return d.frameworks[f]; }).length;
          var isShared = matchCount >= 2;
          rowsHtml += '<tr class="' + (isShared ? 'foc-row-shared' : '') + '">';
          rowsHtml += '<td><span class="foc-domain-title">' + d.title + '</span></td>';
          selArr.forEach(function (f) {
            var ref = d.frameworks[f];
            rowsHtml += '<td class="foc-cell"' + (ref ? ' title="' + FRAMEWORKS[f].label + ': ' + ref + '"' : '') + '>' + (ref ? '<span class="foc-dot-yes">&#10003;</span>' : '<span class="foc-dot-no">&mdash;</span>') + '</td>';
          });
          rowsHtml += '</tr>';
        });
        tbodyEl.innerHTML = rowsHtml;

        if (typeof gtag === 'function') {
          gtag('event', 'overlap_calculator_computed', { frameworks: selArr.join(','), savings: savings });
        }
      }

      chipsEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.foc-chip');
        if (!btn) return;
        var slug = btn.dataset.slug;
        if (selected.has(slug)) {
          selected.delete(slug);
          btn.classList.remove('is-active');
          btn.setAttribute('aria-pressed', 'false');
        } else {
          selected.add(slug);
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
        }
        render();
      });

      render();
    })();
  </script>
</Base>
