---
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book/';
const ctaLabel = 'Book a call';

// Active page detection
const { pathname } = Astro.url;
function isActive(path: string) {
  if (path === base) return pathname === base || pathname === '/';
  return pathname.startsWith(path);
}
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand -->
    <a href={base} class="brand" aria-label="Compliance365 home">
      <img
        src={base + 'assets/logo.svg'}
        alt="Compliance365 — Cyber, Privacy & AI Compliance"
        width="28"
        height="28"
        loading="eager"
        decoding="async"
      />
      <strong>Compliance365</strong>
    </a>

    <!-- Mobile toggle -->
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primaryNav"
    >
      <span class="sr-only">Toggle navigation</span>
      ☰
    </button>

    <!-- Primary nav -->
    <nav id="primaryNav" class="nav" aria-label="Primary">
      <a class={`nav-link${isActive(base) && pathname === base ? ' active' : ''}`} href={base}>Home</a>

      <!-- Services dropdown -->
      <div class="nav-dd">
        <button
          class={`nav-link nav-dd-btn${isActive(base + 'services') ? ' active' : ''}`}
          type="button"
          aria-expanded="false"
          aria-controls="servicesMenu"
        >
          Services <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div id="servicesMenu" class="nav-dd-menu" role="menu" aria-label="Services">
          <a role="menuitem" href={base + 'services/iso27001/'}>ISO 27001 - Security</a>
          <a role="menuitem" href={base + 'services/iso27701/'}>ISO 27701 — Privacy</a>
          <a role="menuitem" href={base + 'services/iso42001/'}>ISO 42001 — AI Governance</a>
          <a role="menuitem" href={base + 'services/essential-eight/'}>Essential Eight</a>
          <a role="menuitem" href={base + 'services/soc2/'}>SOC 2</a>
          <a role="menuitem" href={base + 'services/disp-ism-irap/'}>DISP / ISM / IRAP</a>
          <a role="menuitem" href={base + 'services/nist-csf/'}>NIST CSF</a>
          <hr style="margin:6px 0;border:none;border-top:1px solid #e9edf4;" />
          <a role="menuitem" href={base + 'how-we-work/'} style="opacity:0.8;font-size:0.88rem;">How we work →</a>
        </div>
      </div>

      <!-- Free Resources dropdown -->
      <div class="nav-dd">
        <button
          class={`nav-link nav-dd-btn${isActive(base + 'checklist') || isActive(base + 'resources') || isActive(base + 'blog') ? ' active' : ''}`}
          type="button"
          aria-expanded="false"
          aria-controls="freeResourcesMenu"
        >
          Free Resources <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div id="freeResourcesMenu" class="nav-dd-menu" role="menu" aria-label="Free Resources">
          <a role="menuitem" href={base + 'checklist/'}>Free checklists</a>
          <a role="menuitem" href={base + 'resources/'}>Guides &amp; resources</a>
          <a role="menuitem" href={base + 'blog/'}>Insights</a>
        </div>
      </div>

      <a class={`nav-link${isActive(base + 'case-studies') ? ' active' : ''}`} href={base + 'case-studies/'}>Results</a>
      <a class={`nav-link${isActive(base + 'about') ? ' active' : ''}`} href={base + 'about/'}>About</a>
      <a class={`nav-link${isActive(base + 'contact') ? ' active' : ''}`} href={base + 'contact/'}>Contact</a>

      <!-- CTA -->
      <a href={ctaUrl} class="btn-cta" aria-label="Book a call">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2v3M17 2v3M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
        </svg>
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--border, #e9edf4);
    backdrop-filter: saturate(180%) blur(10px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  /* NAV */
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    opacity: 0.85;
    transition: background 0.15s, opacity 0.15s;
  }

  .nav-link:hover {
    background: rgba(10, 18, 32, 0.04);
    opacity: 1;
  }

  .nav-link.active {
    color: var(--primary, #1e40af);
    opacity: 1;
    background: rgba(30, 64, 175, 0.07);
  }

  /* Dropdown */
  .nav-dd {
    position: relative;
  }

  .nav-dd-btn {
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .chev {
    font-size: 12px;
    opacity: 0.7;
  }

  .nav-dd-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 230px;
    background: #fff;
    border: 1px solid var(--border, #e9edf4);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 18px 46px rgba(10, 18, 32, 0.10);
    display: none;
    z-index: 100;
  }

  .nav-dd-menu a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    opacity: 0.9;
    font-size: 0.9rem;
  }

  .nav-dd-menu a:hover {
    background: rgba(10, 18, 32, 0.04);
    color: var(--primary, #1e40af);
    opacity: 1;
  }

  .nav-dd.open .nav-dd-menu {
    display: block;
  }

  /* CTA */
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 14px;
    font-weight: 900;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    background: var(--primary, #1e40af);
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light, #3b82f6) 100%);
    box-shadow: 0 10px 26px -12px rgba(30, 64, 175, 0.45);
    transition: all 0.2s ease;
    margin-left: 4px;
  }

  .btn-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px -12px rgba(30, 64, 175, 0.55);
    filter: brightness(1.05);
  }

  .btn-cta svg {
    width: 16px;
    height: 16px;
    stroke: #fff;
    fill: none;
    stroke-width: 1.8;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    border: 1px solid var(--border, #e9edf4);
    background: #fff;
    border-radius: 10px;
    padding: 8px 10px;
    cursor: pointer;
    font-size: 1.1rem;
  }

  @media (max-width: 1020px) {
    .nav-toggle { display: inline-flex; }
    .nav {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      display: grid;
      gap: 4px;
      background: #fff;
      border-bottom: 1px solid #eef2f7;
      padding: 12px 16px;
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
      z-index: 60;
    }
    .nav.open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .nav-link { width: 100%; justify-content: space-between; }
    .nav-dd { width: 100%; }
    .nav-dd-menu {
      position: static;
      display: none;
      box-shadow: none;
      border-radius: 10px;
      border: 1px solid #eef2f7;
      margin-top: 4px;
    }
    .nav-dd.open .nav-dd-menu { display: block; }
    .btn-cta {
      width: 100%;
      justify-content: center;
      margin-top: 4px;
      margin-left: 0;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script is:inline>
  (function () {
    const nav = document.getElementById('primaryNav');
    const toggle = document.querySelector('.nav-toggle');
    const dds = document.querySelectorAll('.nav-dd');

    function closeAll() {
      dds.forEach(dd => {
        dd.classList.remove('open');
        const btn = dd.querySelector('.nav-dd-btn');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }

    // Mobile nav open/close
    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!open) closeAll();
      });
    }

    // Dropdown toggles
    dds.forEach(dd => {
      const btn = dd.querySelector('.nav-dd-btn');
      if (!btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = dd.classList.contains('open');
        closeAll();
        if (!isOpen) {
          dd.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      if (![...dds].some(dd => dd.contains(e.target))) closeAll();
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();
</script>
