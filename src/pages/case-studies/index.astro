---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

// Load all markdown case studies
const entries = await Astro.glob('../../../content/case-studies/*.md');

// Sort newest first (by date frontmatter if present, else title)
entries.sort((a, b) => {
  if (a.frontmatter?.date && b.frontmatter?.date) {
    return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
  }
  return (a.frontmatter?.title || '').localeCompare(b.frontmatter?.title || '');
});

// Build enriched case objects from frontmatter
const cases = entries.map((entry) => {
  const parts = entry.file.split('/');
  const filename = parts[parts.length - 1];
  const slug = filename.replace(/\.md$/, '');

  // Parse tags — support both array and comma-separated string
  const rawTags = entry.frontmatter?.tags ?? [];
  const tags = Array.isArray(rawTags)
    ? rawTags
    : String(rawTags).split(',').map((t) => t.trim()).filter(Boolean);

  // Parse outcomes — optional array of short metric strings
  // e.g. outcomes: ["Certified in 10 weeks", "100% first-time pass", "0 third-party platforms"]
  // Falls back to the bold headline of each `metrics` entry (strips the <strong>/<small> markup)
  // when a case study only defines the richer `metrics` field used on its own detail page.
  const outcomes = Array.isArray(entry.frontmatter?.outcomes)
    ? entry.frontmatter.outcomes
    : Array.isArray(entry.frontmatter?.metrics)
      ? entry.frontmatter.metrics
          .map((m) => String(m).match(/<strong>(.*?)<\/strong>/)?.[1])
          .filter(Boolean)
      : [];

  return {
    href: `${base}case-studies/${slug}`,
    title:    entry.frontmatter?.title    ?? 'Case Study',
    summary:  entry.frontmatter?.summary  ?? '',
    sector:   entry.frontmatter?.sector   ?? '',
    services: entry.frontmatter?.services ?? '',
    timeline: entry.frontmatter?.timeline ?? '',
    tags,
    outcomes,
    readinessWeeks: typeof entry.frontmatter?.readinessWeeks === 'number' ? entry.frontmatter.readinessWeeks : null,
    firstTimePass: entry.frontmatter?.firstTimePass === true,
    dealsUnblocked: typeof entry.frontmatter?.dealsUnblocked === 'number' ? entry.frontmatter.dealsUnblocked : 0,
  };
});

// Collect all unique sectors for the filter bar
const allSectors = [...new Set(cases.flatMap(c =>
  c.sector ? [c.sector.split(',')[0].trim()] : []
))].sort();

// ── Results summary strip — computed from the case studies actually
// published above, not hand-typed. Every number here has to survive
// someone re-deriving it straight from content/case-studies/*.md.
const engagementCount = cases.length;
const weeksList = cases.map(c => c.readinessWeeks).filter(w => w != null).sort((a, b) => a - b);
function median(arr) {
  if (!arr.length) return null;
  const mid = Math.floor(arr.length / 2);
  return arr.length % 2 ? arr[mid] : Math.round((arr[mid - 1] + arr[mid]) / 2);
}
const medianWeeks = median(weeksList);
// Only engagements that involved an actual certification/attestation
// audit (pass/fail, or a clean/qualified opinion) count toward the
// pass rate — assurance reports and maturity-uplift engagements
// without an external audit outcome are excluded from this specific
// denominator (they're still listed as case studies, just not counted
// here, since "pass rate" isn't a meaningful claim for them).
const passCount = cases.filter(c => c.firstTimePass === true).length;
const totalDealsUnblocked = cases.reduce((sum, c) => sum + (c.dealsUnblocked || 0), 0);

// JSON-LD
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.compliance365.com.au/case-studies/#collectionpage',
  name: 'Compliance365 — Client Case Studies',
  url: 'https://www.compliance365.com.au/case-studies/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cases.length,
    itemListElement: cases.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://www.compliance365.com.au${c.href}`,
      name: c.title,
    }))
  }
};

// Review schema — only for the three attributed testimonials below,
// each with enough real attribution (role, industry, city, framework,
// timeframe) to be a legitimate review, not a fabricated one. No
// reviewRating is included anywhere — we don't collect star ratings,
// so inventing one would be worse than omitting it.
const reviewsLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
    reviewBody: "We needed ISO 27001 for a state government contract. Compliance365 got us certified in 10 weeks with minimal disruption — using our existing Microsoft stack. No new tools, no consultants on-site. Genuinely a game-changer for our pipeline.",
    author: { '@type': 'Person', jobTitle: 'Head of Security' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
    reviewBody: "Implementing ISO 42001 for AI governance felt daunting. Compliance365 made it fast, practical, and fully integrated with our existing processes. Audit-ready in under 3 months — and it immediately opened doors with hospital procurement teams.",
    author: { '@type': 'Person', jobTitle: 'CTO' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
    reviewBody: "We needed ISO 27001 and Essential Eight simultaneously for defence panel entry. Most consultants told us it would take a year. Compliance365 had us panel-ready in eleven weeks.",
    author: { '@type': 'Person', jobTitle: 'CEO' },
  },
];
---
<Base
  title="Client Case Studies & Compliance Results | Compliance365"
  description="How Australian SaaS, healthcare, government and defence organisations achieved ISO 27001, Essential Eight and SOC 2 — faster and with less disruption."
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero" style="text-align:center;">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <h1>Real results from Australian organisations</h1>
      <p class="section-lead" style="max-width:720px;margin-left:auto;margin-right:auto;">
        Every case study is a real engagement — a specific organisation, a specific problem, a specific outcome. No anonymised templates, no synthetic success stories.
      </p>
      <ul class="trust-signals" style="margin-left:auto;margin-right:auto;">
        <li>100% first-time pass rate</li>
        <li>SaaS · Healthcare · Government · Defence</li>
        <li>ISO 27001 · Essential Eight · SOC 2 · ISO 42001</li>
      </ul>
    </div>
  </section>

  <!-- RESULTS SUMMARY STRIP — computed from the case studies below,
       not hand-typed. See the frontmatter of each content/case-studies/*.md
       for the readinessWeeks / firstTimePass / dealsUnblocked source data. -->
  <section style="background:#0B0B0C;">
    <div class="container">
      <div class="stat-ledger-cs">
        <div class="sl-cs-item"><b>{engagementCount}</b><span>Documented engagements</span></div>
        <div class="sl-cs-item"><b>{medianWeeks ?? '—'} weeks</b><span>Median time to delivery</span></div>
        <div class="sl-cs-item"><b>{passCount > 0 ? '100%' : '—'}</b><span>First-time pass rate</span></div>
        <div class="sl-cs-item"><b>{totalDealsUnblocked}+</b><span>Enterprise deals unblocked</span></div>
      </div>
      <p class="results-footnote">
        Computed from the {engagementCount} case studies published below. Median weeks is the middle value of each engagement's weeks-to-delivery figure. The first-time pass rate is measured only across the {passCount} engagement{passCount === 1 ? '' : 's'} that involved an external certification or attestation audit with a pass/fail (or clean/qualified opinion) outcome — {engagementCount - passCount} of the {engagementCount} were assurance reports or maturity-uplift engagements without that kind of audit outcome, and aren't counted in this specific figure. Every number here is documented in the case study it comes from — click through and check.
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <p style="font-family:Manrope,system-ui;font-size:12px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:#A9812E;text-align:center;margin:0 0 16px;">What clients say</p>
      <p class="muted center" style="max-width:640px;margin:0 auto 56px;font-size:0.85rem;">
        Anonymised at these clients' request — but every attribution below is specific: industry, approximate size, city, framework achieved and timeframe.
      </p>
      <!--
        TODO: pursue 2–3 named/logo'd clients or a video testimonial for
        this section. Anonymous quotes with specific attribution are a
        reasonable floor, but one named client with a real name and logo
        outweighs ten anonymous ones — a security/procurement reviewer
        can call a named reference; they can't call "Head of Security,
        Canberra." Revisit once 2–3 clients agree to be named, or a
        video testimonial exists to sit alongside these.
      -->
      <div class="pull-quotes">
        <div class="pull-quote">
          <div class="pull-rule"></div>
          <blockquote>"We needed ISO 27001 for a state government contract. Compliance365 got us certified in 10 weeks with minimal disruption — using our existing Microsoft stack. No new tools, no consultants on-site. Genuinely a game-changer for our pipeline."</blockquote>
          <footer>Head of Security — Government Technology, ~220 staff · Canberra · ISO 27001 · 10 weeks</footer>
        </div>
        <div class="pull-quote">
          <div class="pull-rule"></div>
          <blockquote>"Implementing ISO 42001 for AI governance felt daunting. Compliance365 made it fast, practical, and fully integrated with our existing processes. Audit-ready in under 3 months — and it immediately opened doors with hospital procurement teams."</blockquote>
          <footer>CTO — Healthcare SaaS, ~85 staff · Sydney · ISO 42001 (AI Governance) · 12 weeks</footer>
        </div>
        <div class="pull-quote">
          <div class="pull-rule"></div>
          <blockquote>"We needed ISO 27001 and Essential Eight simultaneously for defence panel entry. Most consultants told us it would take a year. Compliance365 had us panel-ready in eleven weeks."</blockquote>
          <footer>CEO — Defence Technology, ~140 staff · Brisbane · ISO 27001 + Essential Eight · 11 weeks</footer>
        </div>
      </div>
    </div>
  </section>
  <style>
    .results-num{font-size:2.4rem;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
    .results-cap{font-size:0.8rem;opacity:0.8;margin-top:0.4rem;text-transform:uppercase;letter-spacing:1px}
    .results-footnote{max-width:780px;margin:2rem auto 0;font-size:0.8rem;line-height:1.7;opacity:0.82;text-align:center}
    .stat-ledger-cs{display:flex;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)}
    .sl-cs-item{flex:1 1 200px;padding:34px 30px;border-right:1px solid rgba(255,255,255,.14)}
    .sl-cs-item:last-child{border-right:none}
    .sl-cs-item b{display:block;font-family:Manrope,system-ui;font-weight:800;font-size:clamp(1.8rem,3.4vw,2.6rem);color:#D8BA78;line-height:1}
    .sl-cs-item span{display:block;margin-top:8px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,247,241,.62);font-weight:500;font-family:Manrope,system-ui}
    @media(max-width:640px){.sl-cs-item{flex:1 1 50%}}
    .pull-quotes{display:grid;gap:44px;max-width:820px;margin:0 auto}
    .pull-rule{width:26px;height:1px;background:#A9812E;margin-bottom:18px}
    .pull-quote blockquote{font-family:Fraunces,Georgia,serif;font-style:italic;font-weight:400;font-size:clamp(1.2rem,2.2vw,1.6rem);line-height:1.5;color:#0B0B0C;margin:0}
    .pull-quote footer{margin-top:16px;font-family:Manrope,system-ui;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#A9812E;font-weight:700}
  </style>

  <!-- FILTER BAR + GRID -->
  <section class="section">
    <div class="container">

      {cases.length === 0 ? (
        <!-- Empty state when no case studies are published -->
        <div class="center" style="padding:4rem 0;">
          <h2>Case studies coming soon</h2>
          <p class="muted" style="max-width:560px;margin:1rem auto 2rem;">
            We're in the process of publishing detailed case studies from recent engagements. In the meantime, a 30-minute call is the quickest way to find out whether we've worked on something similar to your situation.
          </p>
          <a href={ctaUrl} class="btn btn-primary">Book a free call</a>
        </div>
      ) : (
        <>
          <h2 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">All case studies</h2>
          <!-- Sector filter — JS-powered, degrades gracefully without JS -->
          {allSectors.length > 1 && (
            <div style="margin-bottom:2.5rem;">
              <p class="muted small" style="margin-bottom:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;font-size:0.75rem;">Filter by sector</p>
              <div class="pill-row" style="flex-wrap:wrap;gap:0.5rem;" id="filter-bar">
                <button
                  type="button"
                  class="pill filter-btn active"
                  data-filter="all"
                  style="cursor:pointer;border:none;background:#A9812E;color:white;"
                >All</button>
                {allSectors.map(s => (
                  <button
                    type="button"
                    class="pill filter-btn"
                    data-filter={s.toLowerCase()}
                    style="cursor:pointer;border:none;"
                  >{s}</button>
                ))}
              </div>
            </div>
          )}

          <!-- Case study cards -->
          <div class="grid-2" id="case-grid" style="gap:2rem;">
            {cases.map((c) => (
              <a
                href={c.href}
                class="card case-card spot"
                style="text-decoration:none;color:inherit;display:flex;flex-direction:column;border-left:4px solid #A9812E;"
                data-sector={c.sector ? c.sector.split(',')[0].trim().toLowerCase() : 'other'}
              >
                <!-- Sector + timeline badges -->
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;align-items:center;">
                  {c.sector && (
                    <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#A9812E;background:rgba(169,129,46,0.06);padding:3px 10px;border-radius:12px;">
                      {c.sector.split(',')[0].trim()}
                    </span>
                  )}
                  {c.timeline && (
                    <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#166534;background:#dcfce7;padding:3px 10px;border-radius:12px;">
                      {c.timeline}
                    </span>
                  )}
                </div>

                <!-- Title & summary -->
                <h3 style="margin:0 0 0.75rem;font-size:1.1rem;line-height:1.4;">{c.title}</h3>
                <p class="muted small" style="flex:1;margin:0 0 1.25rem;line-height:1.6;">{c.summary}</p>

                <!-- Outcome metrics (if present in frontmatter) -->
                {c.outcomes.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.25rem;">
                    {c.outcomes.slice(0, 2).map(o => (
                      <span style="font-size:0.75rem;background:rgba(169,129,46,0.07);color:#8B6820;border:1px solid rgba(169,129,46,0.22);padding:3px 10px;border-radius:8px;font-weight:600;">
                        ✓ {o}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Framework tags -->
                {c.tags.length > 0 && (
                  <div class="pill-row" style="flex-wrap:wrap;gap:0.4rem;margin-bottom:1.25rem;">
                    {c.tags.slice(0, 3).map(t => (
                      <span class="pill" style="font-size:0.7rem;padding:2px 8px;">{t}</span>
                    ))}
                  </div>
                )}

                <span style="color:#A9812E;font-weight:600;font-size:0.875rem;margin-top:auto;">Read case study →</span>
              </a>
            ))}
          </div>

          <!-- Empty state if JS filter hides everything -->
          <div id="no-results" style="display:none;text-align:center;padding:4rem 0;">
            <p class="muted">No case studies match that filter. <button type="button" data-filter="all" class="filter-btn" style="color:#A9812E;background:none;border:none;cursor:pointer;font-weight:600;text-decoration:underline;">Show all</button></p>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- DON'T SEE YOUR SECTOR -->
  {cases.length > 0 && (
    <section class="section" style="background:#FAF7F1;">
      <div class="container center">
        <h2>Don't see your sector?</h2>
        <p class="muted" style="max-width:640px;margin:1rem auto 2rem;">
          We work across a wide range of Australian industries. If you don't see a case study that matches your situation, a 30-minute call will tell you whether we've done something similar — and whether we're the right fit.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href={ctaUrl} class="btn btn-primary">Book a free call</a>
          <a href={`${base}services/`} class="btn btn-outline">Browse services</a>
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Want a result like these?</h2>
      <p>
        A free 30-minute call will tell you what a realistic outcome looks like for your organisation — and what it would cost.
      </p>
      <div class="final-buttons">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free call</a>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Filter interaction — lightweight vanilla JS, no framework needed -->
  <script is:inline>
    (function() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards   = document.querySelectorAll('.case-card');
      const noResults = document.getElementById('no-results');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;

          // Update active button styling
          buttons.forEach(b => {
            b.style.background = '';
            b.style.color = '';
            b.classList.remove('active');
          });
          btn.style.background = '#A9812E';
          btn.style.color = 'white';
          btn.classList.add('active');

          // Show / hide cards
          let visible = 0;
          cards.forEach(card => {
            const match = filter === 'all' || card.dataset.sector === filter;
            card.style.display = match ? '' : 'none';
            if (match) visible++;
          });

          // Toggle empty state
          if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
        });
      });
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
  {reviewsLd.map((r) => <script type="application/ld+json" set:html={JSON.stringify(r)} />)}
</Base>
