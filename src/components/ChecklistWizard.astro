---
/* Turns a checklist page's long list of questions into a guided flow:
   one section per screen, a progress bar, Back / Next buttons, and the score
   revealed only once the visitor has finished (a running score after one
   answer read "4% High Risk", which put people off).

   The checklist pages keep their own markup and scoring script. The wizard
   (public/assets/checklist-wizard.js) only shows and hides what is already
   there and hands "See my results" to the page's own #pdfBtn, so the details
   form, PDF, lead email and tracking are unchanged. Without JavaScript the
   page still works as the full list.

   The styles also fix the phone layout: the question column and the score
   panel sat side by side at any width, pushing the page off the right edge
   on phones. */
const base = import.meta.env.BASE_URL || '/';
---

<script is:inline src={`${base}assets/checklist-wizard.js`} defer></script>

<style is:global>
  /* One column at every width: the running score panel is hidden while
     answering, and this is what fixes the sideways scroll on phones. */
  .cl-grid { grid-template-columns: minmax(0, 1fr) !important; max-width: 820px; margin: 0 auto; }
  #stage-1 > .card, #stage-3 > .card { max-width: 820px; margin-left: auto; margin-right: auto; }
  #stage-2 { scroll-margin-top: 90px; }

  .cl-wizard #score-panel,
  .cl-wizard #resetBtn,
  .cl-wizard #back-to-stage-1 { display: none !important; }
  .cl-wizard .clw-hidden { display: none !important; }

  /* Progress header */
  .clw-head { background: #fff; border: 1px solid #DDD8CF; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; scroll-margin-top: 90px; }
  .clw-head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: .6rem; }
  .clw-step { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: var(--accent-ink); }
  .clw-count { font-size: .8rem; color: #6B6860; font-weight: 600; }
  .clw-bar { height: 8px; background: #F5F0E8; border-radius: 4px; overflow: hidden; }
  .clw-bar span { display: block; height: 100%; width: 0; background: #BE4A1E; border-radius: 4px; transition: width .3s ease; }
  .clw-dots { display: flex; gap: 6px; margin-top: .75rem; flex-wrap: wrap; }
  .clw-dot { width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid #C8C3B8; background: #fff; color: #6B6860; font-size: .72rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; font-family: inherit; }
  .clw-dot.done { background: #046A4E; border-color: #046A4E; color: #fff; }
  .clw-dot.current { border-color: #BE4A1E; background: #BE4A1E; color: #fff; }
  .clw-dot:disabled { cursor: default; opacity: .55; }

  /* Questions: bigger answer buttons, helpers as quiet links */
  .cl-wizard .checklist-section { margin-bottom: 0 !important; }
  /* Each section's own "Progress 0/3" box repeats the header above it. */
  .cl-wizard .checklist-section > div:first-child > div:last-child:not(:first-child) { display: none; }
  .cl-wizard .opts { flex: 1 1 100%; display: grid !important; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .cl-wizard .opt { padding: 12px 10px !important; font-size: .95rem !important; width: 100%; }
  .cl-wizard .ask-ai-btn { border: 0 !important; background: none !important; padding: 2px 0 !important; color: var(--accent-ink) !important; font-size: .8rem !important; text-decoration: underline; text-underline-offset: 3px; }

  /* Back / Next */
  .clw-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .clw-hint { flex: 1; text-align: right; font-size: .85rem; color: #6B6860; }
  .clw-back, .clw-next { font-family: inherit; font-weight: 700; font-size: .95rem; border-radius: 10px; padding: 13px 22px; cursor: pointer; }
  .clw-back { background: transparent; border: 1.5px solid #C8C3B8; color: #3A3632; }
  .clw-next { background: #BE4A1E; border: 1.5px solid #BE4A1E; color: var(--on-accent, #fff); }
  .clw-next:hover:not(:disabled) { background: #A63A12; border-color: #A63A12; }
  .clw-next:disabled { opacity: .45; cursor: not-allowed; }
  .clw-back[hidden] { display: inline-block !important; visibility: hidden; }

  /* Results, shown on the "report is ready" screen */
  .clw-results { text-align: left; margin: 0 auto 2rem; max-width: 640px; border: 1px solid #DDD8CF; border-radius: 12px; padding: 1.5rem; background: #fff; }
  .clw-results-score { text-align: center; padding-bottom: 1rem; border-bottom: 1px solid #F5F0E8; margin-bottom: 1rem; }
  .clw-results #aiDiscussBtn { margin-top: 1.25rem !important; }

  @media (max-width: 640px) {
    .clw-nav { flex-wrap: wrap; }
    .clw-hint { order: -1; flex-basis: 100%; text-align: left; }
    .clw-back, .clw-next { flex: 1; padding: 13px 12px; }
    .cl-wizard .checklist-section { padding: 1.25rem !important; }
    #stage-1 > .card, #stage-3 > .card { padding: 1.5rem !important; }
  }
</style>
