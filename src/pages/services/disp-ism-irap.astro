---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'DISP Uplift, ISM Alignment & IRAP Assessment Support – Australia',
  serviceType: 'Defence Security & IRAP Consulting',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/disp-ism-irap',
  description:
    'Practical DISP uplift, ISM alignment and IRAP assessment support — clear controls, audit-ready evidence, and fast procurement readiness for Defence and government-adjacent organisations.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who needs DISP, ISM or IRAP alignment?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Organisations working with Defence, Australian Government or handling sensitive/classified information often require DISP membership, ISM alignment and IRAP assessment readiness.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does DISP/ISM/IRAP readiness take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most teams achieve meaningful uplift and IRAP readiness in 10–16 weeks with focused scope and prioritized remediation.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need new security tools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We focus on practical uplift using your existing security controls and infrastructure before recommending anything new.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can you support us during IRAP assessments?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — we coordinate with assessors, prepare evidence packs, track findings, and support remediation so the process is calm and predictable.'
      }
    }
  ]
};
---

<Base
  title="DISP Uplift, ISM Alignment & IRAP Assessment Support – Australia | Compliance365"
  description="Practical Defence security uplift, ISM alignment and IRAP readiness — clear controls, audit-ready evidence, and fast procurement assurance."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO – Business-first, impactful intro -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1>DISP, ISM & IRAP – Defence-Ready Fast</h1>
          <p class="section-lead muted">
            Win Defence contracts and government opportunities sooner with practical DISP uplift, ISM alignment and IRAP assessment readiness — without disruption or unnecessary complexity.
          </p>
          <p class="muted">
            Defence and government customers expect strong, defensible security. We deliver it in weeks — with clear controls, audit-ready evidence, and fast procurement assurance — so you can focus on delivery, not delays.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">10–16 weeks</span>
            <span class="pill">No disruption</span>
            <span class="pill">Audit-ready</span>
            <span class="pill">Procurement-friendly</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">{ctaLabel}</a>
            <a href={`${base}checklist/disp-ism-irap`} class="btn btn-outline">Free DISP/ISM/IRAP Readiness Score</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/illus-disp-ism-irap.svg`}
            alt="DISP uplift, ISM alignment and IRAP readiness for Defence contracts"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

<section class="section" style="background:#f8fafc;">
  <div class="container">
    <h2 class="center">Why DISP, ISM & IRAP Matter Right Now</h2>
    <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
      Defence and government contracts are increasingly competitive. Procurement teams now routinely require evidence of ISM alignment, DISP membership, and IRAP readiness before shortlisting suppliers.
    </p>
    <div class="grid-3" style="margin-top:2.5rem;">
      <div class="card feature center">
        <h3>Win More Defence Work</h3>
        <p class="muted small">
          DISP membership and ISM alignment are often mandatory for tender eligibility. IRAP gives you the strongest assurance — helping you stand out and win.
        </p>
      </div>
      <div class="card feature center">
        <h3>Shorten Procurement Cycles</h3>
        <p class="muted small">
          Clear, defensible evidence means faster security reviews and fewer back-and-forth requests.
        </p>
      </div>
      <div class="card feature center">
        <h3>Protect Your Reputation</h3>
        <p class="muted small">
          Demonstrating ISM controls and IRAP readiness reduces breach risk and shows you take security seriously.
        </p>
      </div>
    </div>
  </div>
</section>

  <!-- WHY THIS MATTERS TO YOUR BUSINESS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why DISP, ISM & IRAP Matter to Your Business</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Defence and government contracts increasingly require proven security controls. DISP, ISM and IRAP demonstrate you meet those expectations — helping you win work, build trust, and reduce risk.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Win Defence & Government Contracts</h3>
          <p class="muted small">
            DISP membership and ISM alignment are often mandatory — we get you there fast so you can compete and win.
          </p>
        </div>
        <div class="card feature center">
          <h3>Reduce Security & Compliance Risk</h3>
          <p class="muted small">
            Practical controls aligned to ISM and IRAP expectations — protecting your organisation from breaches and regulatory findings.
          </p>
        </div>
        <div class="card feature center">
          <h3>Build Buyer & Partner Confidence</h3>
          <p class="muted small">
            Clear, defensible evidence reassures procurement teams and partners — opening doors and shortening sales cycles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON FEARS WE SOLVE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Common Defence Security Fears We Solve</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        We help teams overcome the same concerns — unclear requirements, long assessment timelines, high costs, and fear of failing IRAP or losing contracts.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>“We don’t know where to start”</h3>
          <p class="muted small">
            We assess your current state, map ISM controls, and give you a clear, prioritized roadmap — no guesswork.
          </p>
        </div>
        <div class="card feature center">
          <h3>“It will take too long”</h3>
          <p class="muted small">
            Focused uplift and evidence preparation mean most teams achieve IRAP readiness in 10–16 weeks.
          </p>
        </div>
        <div class="card feature center">
          <h3>“We’re worried about failing assessment”</h3>
          <p class="muted small">
            We prepare evidence packs, support assessor Q&A, and track remediation — so the process is calm and successful.
          </p>
        </div>
      </div>
    </div>
  </section>

 <!-- WHAT YOU GET – Polished & Icon-Enhanced -->
<section class="section">
  <div class="container">
    <h2 class="center">What You Get with DISP/ISM/IRAP Support</h2>
    <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
      Practical, audit-ready deliverables designed to help you win Defence & government work faster — with ongoing confidence.
    </p>

    <div class="grid-3" style="margin-top:3rem;">
      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 8v8" />
          </svg>
        </div>
        <h3>Gap Analysis & Roadmap</h3>
        <p class="muted small">
          Evidence-based assessment against DISP/ISM/IRAP requirements, prioritized remediation plan, and quick wins.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <path d="M12 6v12" />
          </svg>
        </div>
        <h3>Control Uplift & Hardening</h3>
        <p class="muted small">
          Practical implementation of ISM-aligned controls — identity, endpoint, data, logging, and governance.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M8 10h8M8 14h8" />
          </svg>
        </div>
        <h3>Audit-Ready Evidence Packs</h3>
        <p class="muted small">
          Repeatable test scripts, exports, and documentation — ready for IRAP assessors or DISP reviews.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M2 12h20" />
          </svg>
        </div>
        <h3>IRAP Assessment Support</h3>
        <p class="muted small">
          Coordination with assessors, sample request (PBC) responses, findings tracking, and remediation to closure.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h3>Defence-Grade Documentation</h3>
        <p class="muted small">
          System Security Plan (SSP) inputs, risk registers, control matrices, and assessor-ready artefacts — aligned to ISM and IRAP.
        </p>
      </div>

      <div class="card feature center">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h3>Ongoing Compliance Support</h3>
        <p class="muted small">
          Quarterly reviews, control monitoring, and evidence refresh — so you stay ready for DISP surveillance and future IRAP assessments.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section-tight" style="background:#f8fafc;">
  <div class="container center">
    <p class="muted" style="margin-bottom:1.5rem;">
      Trusted by Australian organisations in:
    </p>
    <div class="pill-row" style="justify-content:center;">
      <span class="pill">Defence Suppliers</span>
      <span class="pill">Government Contractors</span>
      <span class="pill">Critical Infrastructure</span>
      <span class="pill">Classified Information Handlers</span>
    </div>
  </div>
</section>

  <!-- TIMELINE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Typical DISP/ISM/IRAP Timeline</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Fast, focused, and built around your real risk profile — not theory.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1–3</h3>
          <p class="muted small">Gap analysis + roadmap</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 4–8</h3>
          <p class="muted small">Control uplift & evidence preparation</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 9–12</h3>
          <p class="muted small">Internal validation + IRAP readiness</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 13–16</h3>
          <p class="muted small">Assessment support & findings closure</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">DISP / ISM / IRAP FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>Who needs DISP, ISM or IRAP?</h3>
          <p class="muted">
            Organisations working with Defence, Australian Government or handling sensitive/classified information often require DISP membership, ISM alignment and IRAP readiness.
          </p>
        </div>
        <div class="card">
          <h3>How long does it take?</h3>
          <p class="muted">
            Most teams achieve meaningful uplift and IRAP readiness in <strong>10–16 weeks</strong> with focused scope and prioritization.
          </p>
        </div>
        <div class="card">
          <h3>Can you support us during IRAP assessments?</h3>
          <p class="muted">
            Yes — we coordinate with assessors, prepare evidence packs, track findings, and support remediation so the process is calm and successful.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section" style="background:#f8fafc;">
    <div class="container center">
      <h2>Related Services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Build on DISP/ISM/IRAP with security, privacy, AI governance or other frameworks — all aligned.
      </p>

      <div class="pill-row" style="justify-content:center;">
        <a class="pill" href="/services/iso27001">ISO 27001 (Security)</a>
        <a class="pill" href="/services/iso27701">ISO 27701 (Privacy)</a>
        <a class="pill" href="/services/iso42001">ISO 42001 (AI)</a>
        <a class="pill" href="/services/soc2">SOC 2</a>
        <a class="pill" href="/services/essential-eight">Essential Eight</a>
      </div>
    </div>
  </section>

<!-- FINAL CTA – Matching Home page blue -->
<section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
  <div class="container">
    <h2>Ready to Become Defence-Ready?</h2>
    <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
      Book a free 30-minute call — we’ll show you how to uplift DISP, align to ISM, prepare for IRAP, and win government contracts faster.
    </p>

    <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
      <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.25rem;padding:1.2rem 2.8rem;">
        Book Free Call Now
      </a>
      <a href={`${base}checklist/disp-ism-irap`} class="btn btn-outline large" style="color:white;border-color:white;font-size:1.25rem;padding:1.2rem 2.8rem;">
        Free DISP/ISM/IRAP Readiness Score
      </a>
    </div>

    <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
      Most teams achieve readiness in under 16 weeks.
    </p>
  </div>
</section>

  <Footer />
</Base>
