---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
---

<Base title="About Compliance365" description="The story, values and people behind Compliance365 — helping Australian organisations simplify cyber, privacy and AI compliance.">
  <Header />

  <section class="container section">
    <h1>About Compliance365</h1>
    <p class="muted" style="max-width:740px">
      Compliance365 exists to help organisations cut through the complexity of compliance.  
      We believe that achieving ISO certification, Essential Eight maturity, or AI governance readiness  
      shouldn’t feel like a burden — it should be clear, practical, and aligned to your business goals.
    </p>
  </section>

 <!-- OUR STORY -->
<section class="container section">
  <div class="grid-2" style="align-items:center; gap:32px;">
    <div>
      <h2>Our Story</h2>
      <p>
        Founded in Brisbane, <strong>Compliance365</strong> was built on a clear principle:
        most organisations already have the tools needed to meet compliance goals — 
        they just need the right strategy to connect people, processes, and platforms.
      </p>
      <p>
        We help businesses achieve certification and assurance across 
        <strong>Information Security, Privacy, and Artificial Intelligence</strong> 
        by embedding frameworks such as ISO&nbsp;27001, ISO&nbsp;27701, ISO&nbsp;42001, SOC&nbsp;2,
        and the Essential&nbsp;Eight directly into their existing Microsoft&nbsp;365 environment.
      </p>
      <p>
        Our approach is practical, auditable, and scalable — focused on enabling sustainable compliance,
        reducing manual effort, and delivering measurable business value.
      </p>
    </div>
    <div>
      <img src={(import.meta.env.BASE_URL)+'assets/about-team.jpg'} 
           alt="Compliance365 team and technology illustration" 
           style="width:100%;border-radius:18px;box-shadow:0 8px 30px rgba(0,0,0,.08);" />
    </div>
  </div>
</section>

      <!-- Add image -->
      <div>
        <img 
          src={`${base}assets/about-team.jpg`} 
          alt="Compliance365 team working with clients" 
          style="width:100%; border-radius:16px; box-shadow:0 8px 24px rgba(0,0,0,.12);" 
        />
      </div>
    </div>

    <!-- Credentials card below the story + image -->
    <div class="card" style="margin-top:32px;">
      <ul>
        <li>🚀 25+ years in IT & security</li>
        <li>🎓 CISSP, CISM, CISA, CEH certified</li>
        <li>🏥 Specialists in health, gov & SaaS sectors</li>
        <li>🔑 Microsoft 365 E5 / Entra / Defender experts</li>
      </ul>
    </div>
  </section>

  <!-- What we do -->
  <section class="container section">
    <h2>What we do</h2>
    <div class="grid-3" style="margin-top:16px">
      <div class="card feature">
        <div class="icon">🛡️</div>
        <h3>Cybersecurity</h3>
        <p class="muted">From ISO 27001 and Essential Eight to SOC 2 and DISP, we build and uplift secure foundations.</p>
      </div>
      <div class="card feature">
        <div class="icon">🔒</div>
        <h3>Privacy</h3>
        <p class="muted">Align to ISO 27701, GDPR, and the Australian Privacy Act with PIMS design, ROPA, and DPIAs.</p>
      </div>
      <div class="card feature">
        <div class="icon">🤖</div>
        <h3>AI Governance</h3>
        <p class="muted">Get ready for ISO 42001, the EU AI Act, and emerging frameworks with risk registers and AI policies.</p>
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
<section class="container section">
  <h2>Our Values — PRIDE</h2>
  <div class="grid-5" style="gap:20px;margin-top:14px;">
    <div class="card">
      <h3>P — Put the Customer First</h3>
      <p class="muted small">
        Every solution starts with understanding your objectives.
        We tailor frameworks and automation to fit your environment — not the other way around.
      </p>
    </div>
    <div class="card">
      <h3>R — Reward Relationships</h3>
      <p class="muted small">
        We believe trust is earned through transparency, collaboration, and long-term partnership.
      </p>
    </div>
    <div class="card">
      <h3>I — Inspire Trust</h3>
      <p class="muted small">
        Integrity, accuracy, and accountability guide every engagement —
        ensuring confidence in every audit, certification, and recommendation.
      </p>
    </div>
    <div class="card">
      <h3>D — Deliver with Excellence</h3>
      <p class="muted small">
        We set a high bar for quality, applying continuous improvement across every project
        to exceed compliance expectations and auditor benchmarks.
      </p>
    </div>
    <div class="card">
      <h3>E — Empower Simplicity</h3>
      <p class="muted small">
        Compliance shouldn’t be complex. We streamline governance
        so your teams can focus on innovation, not documentation.
      </p>
    </div>
  </div>
</section>

  <!-- Call to action -->
  <section class="container section">
    <div class="card" style="text-align:center;padding:40px;">
      <h2>Ready to simplify compliance?</h2>
      <p class="muted">Book a free consultation today and see how we can help you achieve compliance faster.</p>
      <a href="/contact" class="btn btn-primary" style="margin-top:12px;">Book a consultation</a>
    </div>
  </section>

  <Footer />
</Base>
