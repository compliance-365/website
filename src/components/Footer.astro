---
import org from '../../content/globals/footer.json';
const base: string = import.meta.env.BASE_URL || '/';
const company = org?.companyName || 'Compliance365';
const tagline = org?.tagline || 'Cyber, AI & Privacy Compliance';
const abn = org?.abn || '';
const email = org?.email || 'info@compliance365.com.au';
const phone = org?.phone || '';
const privacy = org?.privacyUrl || (base + 'privacy/');
const terms = org?.termsUrl || (base + 'terms/');
const ctaUrl = base + 'book/';
const ctaLabel = 'Book a free call';
---

<!-- Wave separator -->
<div class="footer-wave" aria-hidden="true">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#111110"/>
  </svg>
</div>

<footer class="footer">
  <!-- Subtle grid overlay -->
  <div class="footer-grid-bg" aria-hidden="true"></div>

  <div class="container footer-cols">

    <!-- Brand / socials -->
    <div class="f-col brand-col">
      <div class="brandline">
        <svg class="brand-logo" width="32" height="32" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M176.2,56 A88,88 0 1,0 176.2,144" stroke="#FAF7F1" stroke-width="18" stroke-linecap="round"/>
          <circle cx="188" cy="100" r="14" fill="#A9812E"/>
        </svg>
        <strong class="brand-name">Compliance<span class="brand-365">365</span></strong>
      </div>
      <p class="tagline">{tagline}</p>
      {abn && <p class="meta">ABN {abn}</p>}
      {phone && (
        <p class="meta">
          <a href={`tel:${phone.replace(/\s/g,'')}`} class="meta-link">{phone}</a>
        </p>
      )}
      <p class="meta">
        <a href={`mailto:${email}`} class="meta-link">{email}</a>
      </p>

      <!-- Social icons -->
      <div class="socials">
        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/company/compliance-365/"
           class="social-btn" aria-label="Compliance365 on LinkedIn" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="9" width="4" height="12" rx="1" fill="currentColor"/>
            <circle cx="5" cy="5" r="2" fill="currentColor"/>
            <path d="M12 9h2.6c3 0 5.4 2.4 5.4 5.4V21h-4v-6.1c0-1.3-1-2.3-2.3-2.3S11.4 13.6 11.4 15V21h-4V9h4v1.3c.6-.8 1.8-1.3 2.6-1.3Z" fill="currentColor"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a href="https://www.facebook.com/compliance365AU"
           class="social-btn" aria-label="Compliance365 on Facebook" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Services -->
    <nav class="f-col" aria-label="Services">
      <h4 class="col-heading">Services</h4>
      <ul class="link-list">
        <li><a href={base + 'services/iso27001/'}>ISO 27001</a></li>
        <li><a href={base + 'services/iso27701/'}>ISO 27701 (Privacy)</a></li>
        <li><a href={base + 'services/iso42001/'}>ISO 42001 (AI Governance)</a></li>
        <li><a href={base + 'services/essential-eight/'}>Essential Eight</a></li>
        <li><a href={base + 'services/soc2/'}>SOC 2</a></li>
        <li><a href={base + 'services/disp-ism-irap/'}>DISP / ISM / IRAP</a></li>
        <li><a href={base + 'services/nist-csf/'}>NIST CSF</a></li>
      </ul>
    </nav>

    <!-- Checkpoint -->
    <nav class="f-col" aria-label="Checkpoint">
      <h4 class="col-heading">Checkpoint</h4>
      <ul class="link-list">
        <li><a href={base + 'checkpoint-console/'}>Overview</a></li>
        <li><a href={`${base}checkpoint-console/#demo`}>Try the live demo</a></li>
        <li><a href={`${base}checkpoint-console/#ai`}>In-tenant AI</a></li>
        <li><a href={`${base}checkpoint-console/#tour`}>Guided tour</a></li>
      </ul>
    </nav>

    <!-- Resources & Company -->
    <nav class="f-col" aria-label="Resources and company">
      <h4 class="col-heading">Resources</h4>
      <ul class="link-list">
        <li><a href={base + 'checklist/'}>Free readiness checklists</a></li>
        <li><a href={base + 'resources/'}>Guides &amp; resources</a></li>
        <li><a href={base + 'blog/'}>Insights</a></li>
        <li><a href={base + 'case-studies/'}>Client results</a></li>
      </ul>
      <h4 class="col-heading" style="margin-top:1.5rem;">Company</h4>
      <ul class="link-list">
        <li><a href={base + 'about/'}>About us</a></li>
        <li><a href={base + 'how-we-work/'}>How we work</a></li>
        <li><a href={base + 'security/'}>Security &amp; architecture</a></li>
        <li><a href={base + 'contact/'}>Contact</a></li>
      </ul>
    </nav>

    <!-- Get started CTA -->
    <div class="f-col cta-col">
      <h4 class="col-heading">Get started</h4>
      <p class="cta-blurb">
        Fixed-price. Audit-ready in 8–14&nbsp;weeks. No third-party GRC platform required.
        Based in Brisbane — serving organisations across&nbsp;Australia.
      </p>
      <a href={ctaUrl} class="footer-cta-btn">{ctaLabel}</a>
      <p class="cta-sub">
        Or try a <a href={base + 'checklist/'} class="cta-sub-link">free readiness checklist</a> first.
      </p>

      <div class="legal-links">
        <a href={privacy}>Privacy Policy</a>
        <a href={terms}>Terms &amp; Conditions</a>
        <a href={base + 'cookies/'}>Cookie Preferences</a>
      </div>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="container footer-bottom">
    <div class="footer-bottom-inner">
      <p class="copyright">
        © {new Date().getFullYear()} {company}. All rights reserved.
      </p>
      <p class="acknowledgement">
        <span class="ack-label">We acknowledge Country.</span>
        Compliance365 acknowledges the Traditional Owners of Country throughout Australia
        and recognises their continuing connection to land, waters and community.
        We pay our respects to Elders past and present, and extend that respect to all
        Aboriginal and Torres Strait Islander peoples.
      </p>
    </div>
  </div>
</footer>

<style>
  /* ── Wave ── */
  .footer-wave {
    display: block;
    line-height: 0;
    margin-bottom: -2px;
    margin-top: 60px;
  }

  .footer-wave svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  /* ── Footer shell ── */
  .footer {
    background: #111110;
    color: #9A968F;
    padding: 3.5rem 0 0;
    position: relative;
    overflow: hidden;
  }

  /* Subtle warm dot grid */
  .footer-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(169, 129, 46, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }

  /* Warm glow blob — top-left */
  .footer::before {
    content: '';
    position: absolute;
    top: -80px;
    left: -100px;
    width: 500px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(169,129,46,0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Warm glow blob — bottom-right */
  .footer::after {
    content: '';
    position: absolute;
    bottom: 20px;
    right: -60px;
    width: 380px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(169,129,46,0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Columns ── */
  .footer-cols {
    display: grid;
    grid-template-columns: 1.3fr 0.85fr 0.85fr 0.85fr 1fr;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  /* ── Brand col ── */
  .brandline {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: .6rem;
  }

  .brand-logo {
    display: block;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 1rem;
    font-weight: 300;
    color: #FAF7F1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: Nunito, system-ui, sans-serif;
  }

  .brand-365 {
    color: #A9812E;
    font-weight: 800;
    margin-left: 1px;
    letter-spacing: 0.01em;
  }

  .tagline {
    font-size: .85rem;
    color: #7A756E;
    margin: 0 0 .5rem;
    line-height: 1.5;
  }

  .meta {
    font-size: .82rem;
    color: #7A756E;
    margin: .2rem 0 0;
  }

  .meta-link {
    color: #7A756E;
    text-decoration: none;
    transition: color 0.15s;
  }

  .meta-link:hover { color: #DDD8CF; }

  /* ── Socials ── */
  .socials {
    display: flex;
    gap: .5rem;
    margin-top: 1rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(169,129,46,0.2);
    color: #7A756E;
    transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
  }

  .social-btn:hover {
    background: rgba(169,129,46,0.15);
    border-color: rgba(169,129,46,0.45);
    color: #D8BA78;
    box-shadow: 0 0 12px rgba(169,129,46,0.15);
  }

  /* ── Nav columns ── */
  .col-heading {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .09em;
    color: #5A5650;
    margin: 0 0 .75rem;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-list li { margin: .32rem 0; }

  .link-list a {
    color: #9A968F;
    text-decoration: none;
    font-size: .88rem;
    font-weight: 500;
    transition: color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .link-list a::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #3A3630;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .link-list a:hover { color: #DDD8CF; }
  .link-list a:hover::before { background: #A9812E; }

  /* ── CTA col ── */
  .cta-blurb {
    font-size: .84rem;
    color: #7A756E;
    line-height: 1.6;
    margin: .2rem 0 1rem;
  }

  .footer-cta-btn {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: .88rem;
    font-weight: 700;
    color: #0B0B0C;
    text-decoration: none;
    background: #A9812E;
    border: 1px solid #A9812E;
    box-shadow: 0 4px 16px -4px rgba(169,129,46,0.4);
    transition: all 0.2s ease;
  }

  .footer-cta-btn:hover {
    transform: translateY(-1px);
    background: #C49A38;
    border-color: #C49A38;
    box-shadow: 0 8px 24px -4px rgba(169,129,46,0.5);
  }

  .cta-sub {
    font-size: .8rem;
    color: #5A5650;
    margin: .6rem 0 0;
  }

  .cta-sub-link {
    color: #9A968F;
    text-decoration: underline;
    text-decoration-color: rgba(169,129,46,0.3);
    transition: color 0.15s;
  }

  .cta-sub-link:hover { color: #D8BA78; }

  .legal-links {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .legal-links a {
    font-size: .78rem;
    color: #5A5650;
    text-decoration: none;
    transition: color 0.15s;
  }

  .legal-links a:hover { color: #9A968F; }

  /* ── Bottom bar ── */
  .footer-bottom {
    position: relative;
    z-index: 1;
    margin-top: 2.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 1.25rem 0 1.5rem;
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .6rem;
    text-align: center;
  }

  .copyright {
    font-size: .78rem;
    color: #5A5650;
    margin: 0;
  }

  .acknowledgement {
    font-size: .75rem;
    color: #4A4540;
    line-height: 1.7;
    max-width: 720px;
    margin: 0;
  }

  .ack-label {
    display: block;
    font-weight: 700;
    color: #5A5650;
    margin-bottom: 2px;
  }

  /* ── Responsive ── */
  @media (max-width: 1000px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 580px) {
    .footer-cols { grid-template-columns: 1fr; }
    .footer-wave { margin-top: 40px; }
  }
</style>
