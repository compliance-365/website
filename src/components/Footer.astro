---
import org from '../../content/globals/footer.json';
const base: string = import.meta.env.BASE_URL || '/';
const company = org?.companyName || 'Compliance365';
const tagline = org?.tagline || 'Cyber, AI & Privacy Compliance';
const abn = org?.abn || '';
const email = org?.email || 'info@compliance365.com.au';
const phone = org?.phone || '';
// We no longer surface the street address on the site
// const address = org?.address || '';
const privacy = org?.privacyUrl ? org.privacyUrl : base + 'privacy';
const terms = org?.termsUrl ? org.termsUrl : base + 'terms';
/* Hard default CTA so no props are required */
const ctaUrl = '/book';
const ctaLabel = 'Book a call';
---

<footer class="footer">
  <div class="container footer-grid">
    <!-- Brand / socials -->
    <div class="f-col">
      <div class="brandline">
        <img src={base + 'assets/logo.svg'} alt="Compliance365" width="28" height="28" />
        <strong>{company}</strong>
      </div>
      <p class="muted" style="margin:.35rem 0 0">{tagline}</p>
      {abn ? <p class="small muted" style="margin:.25rem 0 0">ABN {abn}</p> : null}
      <div class="socials" style="margin-top:.6rem">
        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/company/compliance-365/?viewAsMember=true"
           aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="9" width="4" height="12" rx="1" fill="currentColor"/>
            <circle cx="5" cy="5" r="2" fill="currentColor"/>
            <path d="M12 9h2.6c3 0 5.4 2.4 5.4 5.4V21h-4v-6.1c0-1.3-1-2.3-2.3-2.3S11.4 13.6 11.4 15V21h-4V9h4v1.3c.6-.8 1.8-1.3 2.6-1.3Z"
                  fill="currentColor"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a href="https://www.facebook.com/compliance365AU"
           aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M13 3h4V0h-4c-3.3 0-6 2.7-6 6v3H4v4h3v11h4V13h3.1l.9-4H11V6c0-1.1.9-2 2-2Z"
                  fill="currentColor"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Services -->
    <nav class="f-col">
      <h4>Services</h4>
      <ul class="list-reset">
        <li><a href={base + 'services/iso27001'}>ISO 27001</a></li>
        <li><a href={base + 'services/iso27701'}>ISO 27701 (Privacy)</a></li>
        <li><a href={base + 'services/iso42001'}>ISO 42001 (AI)</a></li>
        <li><a href={base + 'services/essential-eight'}>Essential Eight</a></li>
        <li><a href={base + 'services/soc2'}>SOC 2 Readiness</a></li>
        <li><a href={base + 'services/nist-csf'}>NIST CSF</a></li>
        <li><a href={base + 'services/disp-ism-irap'}>DISP / ISM / IRAP</a></li>
      </ul>
    </nav>

    <!-- Resources / free tools -->
    <nav class="f-col">
      <h4>Resources</h4>
      <ul class="list-reset">
        <li><a href={base + 'checklist/'}>Free Readiness Checklists</a></li>
        <li><a href={base + 'resources'}>Guides &amp; Resources</a></li>
        <li><a href={base + 'blog'}>Insights</a></li>
        <li><a href={base + 'case-studies'}>Case Studies</a></li>
      </ul>
    </nav>

    <!-- Contact / CTA -->
    <div class="f-col">
      <h4>Contact</h4>
      <p class="small" style="margin:.2rem 0 0">
        <a href={'mailto:' + email}>{email}</a>{phone ? ` · ${phone}` : ''}
      </p>
      <p class="small muted" style="margin:.25rem 0 0">
        Based in Meanjin (Brisbane) — supporting organisations across Australia.
      </p>
      <p class="small" style="margin:.6rem 0 0">
        <a href={privacy}>Privacy Policy</a> ·
        <a href={terms}>Terms &amp; Conditions</a> ·
        <a href="#" onclick="document.getElementById('cookie-banner')?.removeAttribute('hidden'); return false;">Cookie Preferences</a>
      </p>
      <p style="margin:.8rem 0 0">
        <a href={ctaUrl} class="btn btn-primary">{ctaLabel}</a>
      </p>
      <p class="small muted" style="margin:.35rem 0 0">
        Or start with a <a href={base + 'checklist/'}>free readiness checklist</a>.
      </p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="small muted">
      © {new Date().getFullYear()} {company}. All rights reserved.
    </p>
    <p class="small muted acknowledgement">
      <span class="ack-label">We acknowledge Country.</span>
      Compliance365 acknowledges the Traditional Owners of Country throughout Australia
      and recognises their continuing connection to land, waters and community.
      We pay our respects to Elders past and present, and extend that respect to all
      Aboriginal and Torres Strait Islander peoples.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, #fafbff 0%, #ffffff 100%);
    margin-top: 60px;
    padding: 28px 0 18px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 28px;
  }

  .brandline {
    display: flex;
    align-items: center;
    gap: .55rem;
  }

  .socials a {
    color: var(--primary);
    display: inline-flex;
  }

  .f-col h4 {
    margin: 0 0 .5rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .list-reset {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list-reset li {
    margin: .28rem 0;
  }

  .list-reset a {
    color: var(--fg);
    opacity: .9;
    text-decoration: none;
  }

  .list-reset a:hover {
    color: var(--primary);
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    margin-top: 18px;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .footer-bottom .acknowledgement {
    max-width: 780px;
    line-height: 1.5;
    margin: 0 auto;
  }

  .footer-bottom .ack-label {
    display: block;
    font-weight: 700;
    margin-bottom: 2px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      text-align: center;
      align-items: center;
    }
  }
</style>
