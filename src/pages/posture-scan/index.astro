/* ── scoring ── */
const W  = { pass:1, partial:0.5, fail:0, attest:0.5 };
const SC = { pass:"#10B981", partial:"#D97706", fail:"#EF4444", attest:"#8B5CF6" };
const ST = { pass:"Met", partial:"Partial", fail:"Gap", attest:"Attest" };
const EFFORT_ORDER = { quick:0, moderate:1, project:2 };
const STATUS_ORDER = { fail:0, partial:1, attest:2, pass:3 };

function rowsFor(fw) {
  return CONTROLS
    .filter(c => c.frameworks[fw])
    .map(c => ({ ...c, clause:c.frameworks[fw], ...(scored[c.id]||{}) }));
}
function scoreFor(fw) {
  const rows = rowsFor(fw);
  if (!rows.length) return 0;
  const totalWeight = rows.reduce((s, r) => s + (r.weight||1), 0);
  const earned = rows.reduce((s, r) => s + (W[r.status]??0) * (r.weight||1), 0);
  return Math.round(earned / totalWeight * 100);
}
function sortRows(rows) {
  return [...rows].sort((a, b) => {
    if (currentSort === "effort") return (EFFORT_ORDER[a.effort]??1) - (EFFORT_ORDER[b.effort]??1) || (STATUS_ORDER[a.status]??2) - (STATUS_ORDER[b.status]??2);
    if (currentSort === "weight") return (b.weight||1) - (a.weight||1) || (STATUS_ORDER[a.status]??2) - (STATUS_ORDER[b.status]??2);
    return (STATUS_ORDER[a.status]??2) - (STATUS_ORDER[b.status]??2);
  });
}
window.psSetSort = v => { currentSort = v; render(); };

window.psToggleQuickWins = () => {
  showQuickWins = !showQuickWins;
  render();
};

/* ── ML estimate for E8 ── */
