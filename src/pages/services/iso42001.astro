---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 42001 AI Governance Consulting — Australia',
  serviceType: 'ISO 42001 AI Management System Implementation',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso42001',
  description:
    'Compliance365 implements ISO 42001 AI Management Systems for Australian mid-market organisations — model inventory, AI risk assessments, human oversight, monitoring, and audit-ready evidence in Microsoft 365.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is ISO 42001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 42001 is the international standard for AI Management Systems (AIMS). Published in 2023, it provides a structured framework for governing artificial intelligence responsibly — covering AI policy, model inventory, risk and impact assessment, human oversight, monitoring, and continuous improvement. It is the primary global standard referenced in AI governance requirements from enterprise procurement teams, cyber insurers, and emerging AI regulation in Australia and internationally.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is ISO 42001 relevant to Australian organisations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The Australian Government\'s voluntary AI Safety Standard (2024) directly references responsible AI principles that ISO 42001 addresses. APRA, ASIC, and the OAIC have all issued guidance on AI risk and governance in regulated sectors. Enterprise and government procurement panels increasingly require evidence of AI governance. ISO 42001 is the most credible framework for demonstrating compliance with these expectations.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does ISO 42001 implementation take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most mid-market organisations achieve ISO 42001 readiness in 8-14 weeks with focused scope. Timeline depends on the number and complexity of AI systems in use, existing policy and risk framework maturity, and whether certification is required. We prioritise high-risk AI use cases first to deliver commercial value early in the engagement.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need new tools or software to implement ISO 42001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We implement your AI Management System inside your existing Microsoft 365 environment — SharePoint, Purview, Teams, and Power Platform. Evidence is automated, controls are auditable, and your team works in tools they already know. No AI-specific governance platform is required.'
      }
    },
    {
      '@type': 'Question',
      name: 'Does ISO 42001 cover the EU AI Act?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 42001 is closely aligned with the principles and requirements of the EU AI Act and provides a strong foundation for compliance. For Australian organisations supplying into European markets or working with EU-domiciled customers, an ISO 42001-aligned AIMS is the most efficient path to demonstrating EU AI Act readiness. Compliance365 maps your AIMS controls to both frameworks.'
      }
    },
    {
      '@type': 'Question',
      name: 'What AI systems does ISO 42001 apply to?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 42001 applies to any organisation that develops, provides, or uses AI systems. This includes organisations using third-party AI tools (such as Microsoft Copilot, OpenAI APIs, or vendor-supplied ML models), internally developed AI or automation, and AI embedded in products or services. The standard uses a risk-tiering approach so governance effort is proportionate to actual AI risk.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can ISO 42001 sit alongside ISO 27001 or ISO 27701?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — ISO 42001 is designed to integrate with ISO 27001 (information security) and ISO 27701 (privacy) using the same Annex SL high-level structure. Organisations already holding ISO 27001 certification have a significant head start. Compliance365 implements integrated management systems that share policy, risk, evidence, and audit infrastructure across all three standards.'
      }
    }
  ]
};
---

<Base
  title="ISO 42001 AI Governance Consulting — Australian Mid-Market | Compliance365"
  description="ISO 42001 AI Management System implementation for Australian organisations. Model inventory, AI risk assessments, human oversight, and audit-ready evidence in Microsoft 365. 8-14 weeks."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1>ISO 42001 AI Governance — Built for Australian Organisations</h1>
          <p class="section-lead muted">
            Prove your AI is governed responsibly to customers, insurers, and regulators — with a structured AI Management System delivered inside your existing Microsoft 365 environment.
          </p>
          <p class="muted">
            ISO 42001 is the global standard for responsible AI. We implement it in 8&ndash;14 weeks: model inventory, risk assessments, human oversight, monitoring, and audit-ready evidence — no new tools, no theory-heavy consulting, no unnecessary complexity.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">8&ndash;14 weeks</span>
            <span class="pill">Microsoft 365 native</span>
            <span class="pill">Audit-ready evidence</span>
            <span class="pill">AU regulatory aligned</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">{ctaLabel}</a>
            <a href={`${base}checklist/iso42001`} class="btn btn-outline">Free AI Governance Readiness Score</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/illus-iso27001.svg`}
            alt="ISO 42001 AI governance implemented in Microsoft 365"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHY ISO 42001 MATTERS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why ISO 42001 Matters Right Now</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Australian organisations using AI are under increasing pressure from multiple directions simultaneously. ISO 42001 is the most efficient way to respond to all of them with a single, structured programme.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Australian Regulatory Pressure</h3>
          <p class="muted small">
            The Australian Government's voluntary AI Safety Standard, APRA's model risk guidance, ASIC's AI expectations for financial services, and the OAIC's AI privacy guidance all point in the same direction. ISO 42001 maps directly to these frameworks and gives you a defensible evidence base when regulators ask questions.
          </p>
        </div>
        <div class="card feature center">
          <h3>Enterprise &amp; Government Procurement</h3>
          <p class="muted small">
            Large enterprise and government buyers are adding AI governance requirements to procurement questionnaires. Without a documented AI Management System, you risk failing vendor assessments, losing deals, or being excluded from tender processes entirely. ISO 42001 gives you audit-ready answers, not just policies.
          </p>
        </div>
        <div class="card feature center">
          <h3>EU AI Act Supply Chain Reach</h3>
          <p class="muted small">
            If you supply software, services, or AI models to EU-domiciled customers, the EU AI Act reaches you — regardless of where you are incorporated. ISO 42001 is the fastest path to demonstrating alignment with high-risk AI requirements and avoiding contractual exposure as EU customers begin enforcing supply chain obligations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS AN AIMS -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">What Is an AI Management System?</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        An AI Management System (AIMS) is the operational backbone of your AI governance programme. It is not a policy document — it is a live, auditable system of controls, records, and processes that demonstrates your AI is being governed responsibly on an ongoing basis.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Model Inventory &amp; Risk Tiering</h3>
          <p class="muted small">
            A complete register of every AI system in use — purposes, datasets, vendors, versions, and risk tier. Includes third-party AI tools (Microsoft Copilot, OpenAI, vendor ML models) and internally developed automation. Risk-tiered so governance effort is proportionate to actual AI risk.
          </p>
        </div>
        <div class="card feature center">
          <h3>AI Risk &amp; Impact Assessments</h3>
          <p class="muted small">
            Structured assessment of AI-specific risks — bias, drift, misuse, opacity, and third-party dependency — with documented safeguards and residual risk sign-off. Linked to DPIAs where AI processing involves personal information under the Australian Privacy Act.
          </p>
        </div>
        <div class="card feature center">
          <h3>Human Oversight &amp; Escalation</h3>
          <p class="muted small">
            Defined decision thresholds for when AI output requires human review, approval, or override. Escalation paths, dispute handling procedures, and accountability assignment — practical and auditable, not just theoretical.
          </p>
        </div>
        <div class="card feature center">
          <h3>Monitoring &amp; Performance Tracking</h3>
          <p class="muted small">
            Ongoing monitoring of model quality, drift, bias, and security incidents — with automated evidence capture. Periodic review cadence defined. Incident log maintained. Audit trail demonstrating continuous oversight rather than point-in-time compliance.
          </p>
        </div>
        <div class="card feature center">
          <h3>Policy, Roles &amp; Training</h3>
          <p class="muted small">
            AI governance policy covering acceptable use, prohibited applications, data quality obligations, and third-party AI oversight. Roles and responsibilities assigned. Training requirements defined — proportionate to role and AI exposure.
          </p>
        </div>
        <div class="card feature center">
          <h3>Audit-Ready Evidence</h3>
          <p class="muted small">
            Evidence automated inside Microsoft 365 — SharePoint registers, Purview audit trails, Power Automate workflows. Every control mapped to the ISO 42001 clause it satisfies. Evidence packs generated on demand for customer questionnaires, procurement reviews, and external audits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON CHALLENGES WE SOLVE -->
  <section class="section">
    <div class="container">
      <h2 class="center">Common Challenges We Solve</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Most Australian mid-market organisations are using AI — often more than they realise — without the governance infrastructure to manage it. These are the challenges we hear most.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>"We don't know what AI we're actually using"</h3>
          <p class="muted small">
            Shadow AI adoption is universal. Microsoft Copilot, ChatGPT, vendor-embedded ML, and internal automation tools accumulate faster than governance catches up. We start with a structured AI inventory that surfaces what you're using, what risks it carries, and what governance each system needs.
          </p>
        </div>
        <div class="card feature center">
          <h3>"Customers are asking us to prove our AI is safe"</h3>
          <p class="muted small">
            Procurement questionnaires, security due diligence, and customer contract addenda increasingly include AI governance requirements. We give you ready-to-share model inventory records, risk assessments, and monitoring evidence — so you respond in minutes, not weeks.
          </p>
        </div>
        <div class="card feature center">
          <h3>"We don't know if we're covered by the EU AI Act"</h3>
          <p class="muted small">
            If you supply software, services, or AI-enabled products into Europe — or work with EU-domiciled enterprise customers — the Act's obligations may apply to you regardless of where your business is incorporated. We assess your exposure and implement controls aligned to both ISO 42001 and EU AI Act high-risk requirements.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">How We Deliver ISO 42001</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        A structured four-phase delivery that builds your AIMS incrementally — commercial value from Week 1, full certification readiness by Week 14.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1&ndash;2</h3>
          <p class="muted small">
            <strong>Discovery &amp; inventory.</strong> Current-state AI audit, model inventory across all systems including third-party tools, risk tiering, gap assessment against ISO 42001 clauses, and delivery roadmap with prioritised workstreams.
          </p>
        </div>
        <div class="card feature center">
          <h3>Weeks 3&ndash;6</h3>
          <p class="muted small">
            <strong>Policy &amp; risk framework.</strong> AI governance policy, roles and responsibilities, risk and impact assessment methodology, human oversight model, and Privacy Act / DPIA integration for AI systems processing personal information.
          </p>
        </div>
        <div class="card feature center">
          <h3>Weeks 7&ndash;10</h3>
          <p class="muted small">
            <strong>Controls &amp; evidence automation.</strong> SharePoint AIMS infrastructure, monitoring workflows, incident logging, evidence automation in Microsoft 365, internal audit preparation, and management review pack.
          </p>
        </div>
        <div class="card feature center">
          <h3>Weeks 11&ndash;14</h3>
          <p class="muted small">
            <strong>Certification readiness.</strong> Internal audit and gap close, corrective action management, external audit support, customer-facing evidence pack generation, and operational handover with BAU runbooks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">ISO 42001 FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>What AI systems does this cover?</h3>
          <p class="muted">
            ISO 42001 applies to any organisation that develops, provides, or uses AI — including third-party tools like <strong>Microsoft Copilot, OpenAI APIs, and vendor ML models</strong>. The standard uses a risk-tiering approach so governance effort is proportionate to actual risk.
          </p>
        </div>
        <div class="card">
          <h3>Do we need to be seeking certification?</h3>
          <p class="muted">
            No. Many clients implement ISO 42001 for its governance and commercial value without pursuing formal certification. Others use the engagement to build toward certification with an accredited body. We scope the engagement to your objective and budget.
          </p>
        </div>
        <div class="card">
          <h3>How does this relate to ISO 27001?</h3>
          <p class="muted">
            ISO 42001 uses the same Annex SL structure as ISO 27001 — so if you're already certified, you have a significant head start. We implement integrated management systems that share policy, risk, evidence, and audit infrastructure across ISO 27001, ISO 27701, and ISO 42001.
          </p>
        </div>
        <div class="card">
          <h3>Is ISO 42001 relevant to the Australian regulatory context?</h3>
          <p class="muted">
            Yes. The Australian Government's voluntary AI Safety Standard (2024) maps closely to ISO 42001 principles. APRA, ASIC, and the OAIC have each issued AI-specific guidance. ISO 42001 provides a defensible, internationally recognised evidence base for demonstrating compliance with all of these.
          </p>
        </div>
        <div class="card">
          <h3>Do we need new tools?</h3>
          <p class="muted">
            <strong>No.</strong> We build your AIMS inside your existing Microsoft 365 environment — SharePoint, Purview, Teams, and Power Platform. Evidence is automated, controls are auditable, and your team works in tools they already know.
          </p>
        </div>
        <div class="card">
          <h3>How long does it take?</h3>
          <p class="muted">
            Most mid-market organisations achieve ISO 42001 readiness in <strong>8&ndash;14 weeks</strong>. Timeline depends on the number of AI systems in scope, existing policy maturity, and whether formal certification is the objective.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section" style="background:#f8fafc;">
    <div class="container center">
      <h2>Related Services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        ISO 42001 integrates directly with ISO 27001 and ISO 27701 — build a unified management system that shares policy, risk, and evidence infrastructure across all three frameworks.
      </p>

      <div class="pill-row" style="justify-content:center;">
        <a class="pill" href="/services/iso27001">ISO 27001 (Information Security)</a>
        <a class="pill" href="/services/iso27701">ISO 27701 (Privacy)</a>
        <a class="pill" href="/services/soc2">SOC 2</a>
        <a class="pill" href="/services/essential-eight">Essential Eight</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Ready to Govern AI Responsibly?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        A 30-minute call will tell you whether ISO 42001 is the right framework for your current AI exposure, what the fastest path to readiness looks like, and what it would cost. No obligation, no sales pitch.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Book a Free Call
        </a>
        <a href={`${base}checklist/iso42001`} class="btn btn-outline large" style="color:white;border-color:white;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Free AI Governance Readiness Score
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
        Most mid-market organisations achieve ISO 42001 readiness in 8&ndash;14 weeks.
      </p>
    </div>
  </section>

  <Footer />
</Base>
