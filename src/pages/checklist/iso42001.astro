---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 42001 (AI Governance)';

const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–99','100–499','500–1 999','2 000+'] },
  { id: 'trigger',      label: 'What is driving this assessment?',     type: 'select', required: true,  options: ['Customer or investor requirement','Regulatory or legal obligation','Internal governance initiative','Preparing for ISO 42001 certification','EU AI Act readiness','Board or executive mandate','Other'] },
  { id: 'timeline',     label: 'Target timeline for ISO 42001 certification', type: 'select', required: false, options: ['Not yet decided','Within 6 months','6–12 months','12–18 months','18+ months'] },
  { id: 'ai-use',       label: 'How does your organisation use AI?',   type: 'select', required: false, options: ['Vendor / embedded AI tools only','Internally developed models','Both vendor and internal AI','Generative AI (e.g. LLMs / chatbots)','AI in customer-facing products or decisions'] },
];

const QUESTIONS = [
  // AIMS Governance
  {
    id: 'aims-scope',
    group: 'gov',
    label: 'We have clearly defined which AI systems, use cases and business functions are in scope for our AI governance program.',
    hint: 'Scope defines what is covered by governance and what is explicitly out of scope.',
    examples: [
      'A documented scope statement listing AI use cases (e.g. clinical decision support, chatbots, analytics models).',
      'Systems and models in scope — vendor AI, internally developed models, GenAI tools.',
      'Geographic and regulatory boundaries (e.g. Australia-only deployment; GDPR-relevant use cases).'
    ]
  },
  {
    id: 'roles-oversight',
    group: 'gov',
    label: 'AI governance roles and accountability are defined — including who owns each AI system and how decisions are escalated.',
    hint: 'Clear accountability for AI decisions, oversight and escalation must be documented.',
    examples: [
      'Named AIMS owner, AI risk owner, and individual model or use-case owners.',
      'A defined governance or ethics review committee with terms of reference.',
      'RACI covering design, approval, monitoring, incident handling and retirement of AI systems.'
    ]
  },
  {
    id: 'policies',
    group: 'gov',
    label: 'We have an approved AI policy set covering acceptable use, risk tolerance, data sourcing, transparency and disclosure.',
    hint: 'Policies guide safe, ethical and compliant AI use across the organisation.',
    examples: [
      'AI Acceptable Use Policy covering staff and contractor use of AI tools.',
      'AI Risk Management or AI Governance Policy aligned to ISO 42001.',
      'Transparency and disclosure policy for customers or end users.'
    ]
  },
  {
    id: 'objectives',
    group: 'gov',
    label: 'We track AI performance objectives and KPIs — such as accuracy, safety incidents or bias indicators — and review them with leadership.',
    hint: 'Leadership should see whether AI is delivering value safely and within defined risk tolerance.',
    examples: [
      'Defined KPIs such as model accuracy, false positives, bias indicators or incident rates.',
      'Targets and thresholds approved by leadership.',
      'Periodic review of AI performance and risk metrics reported to the board or executive.'
    ]
  },

  // Risk & Impact Assessment
  {
    id: 'inventory',
    group: 'risk',
    label: 'We maintain an up-to-date inventory of all AI use cases and models — including purpose, owner, associated data and risk classification.',
    hint: 'A single source of truth for all AI systems enables consistent risk management.',
    examples: [
      'An AI inventory or register with each use case, business owner and technical owner.',
      'Associated datasets, model types and deployment environments documented.',
      'Initial risk classification (low / medium / high impact) assigned for each AI system.'
    ]
  },
  {
    id: 'risk-method',
    group: 'risk',
    label: 'We use a defined methodology to assess AI risks and impacts before deployment and when significant changes occur.',
    hint: 'A consistent method for AI Impact and Risk Assessment (AIRA) ensures material risks are identified and treated.',
    examples: [
      'A documented AIRA or AI Impact Assessment template applied to each AI use case.',
      'Assessment criteria covering safety, bias, legal, ethical and reputational risks.',
      'Completed AIRA records for each material AI use case, reviewed and approved.'
    ]
  },
  {
    id: 'data-ethics',
    group: 'risk',
    label: 'Training and input data is assessed for bias, representativeness, provenance and lawful basis before use.',
    hint: 'Data quality and ethics are foundational to responsible AI.',
    examples: [
      'Bias and representativeness assessments for training datasets.',
      'Documented data provenance and sourcing decisions.',
      'Confirmation of consent, licensing or lawful basis for training or input data.'
    ]
  },

  // Design, Controls & Oversight
  {
    id: 'design-controls',
    group: 'ctrl',
    label: 'Preventative controls are built into AI systems — such as output filters, PII minimisation and security hardening.',
    hint: 'Design-level controls reduce harm and misuse before problems occur.',
    examples: [
      'Prompt filtering, output moderation or content safety controls for generative AI.',
      'PII detection, masking or minimisation in prompts and model outputs.',
      'Security controls protecting models, APIs and inference endpoints.'
    ]
  },
  {
    id: 'human-loop',
    group: 'ctrl',
    label: 'Human oversight is defined for high-risk AI decisions — including review thresholds, escalation paths and the ability to override or disable AI.',
    hint: 'Humans must remain accountable for impactful AI outcomes.',
    examples: [
      'Defined thresholds requiring human review before an AI-driven action is taken.',
      'Clear escalation paths for unsafe, unexpected or disputed outputs.',
      'A documented ability to disable, pause or override AI systems when required.'
    ]
  },
  {
    id: 'eval',
    group: 'ctrl',
    label: 'AI systems are evaluated for fairness, robustness and potential misuse before release and after significant changes.',
    hint: 'Testing AI before and after release ensures it behaves as expected.',
    examples: [
      'Pre-deployment testing for accuracy, bias and robustness documented.',
      'Adversarial or red-teaming exercises for misuse and edge-case scenarios.',
      'Test results and go/no-go decisions recorded and retained.'
    ]
  },

  // Operations & Monitoring
  {
    id: 'monitor',
    group: 'ops',
    label: 'AI systems are monitored in production for quality degradation, drift, misuse and policy violations — with alerts and logs retained.',
    hint: 'Monitoring AI behaviour in production detects degradation and misuse early.',
    examples: [
      'Monitoring for model drift, performance drops or abnormal output patterns.',
      'Logging of prompts, outputs and key decisions (within applicable privacy limits).',
      'Alerts for misuse, abuse patterns or outputs that breach policy thresholds.'
    ]
  },
  {
    id: 'incident',
    group: 'ops',
    label: 'AI-related incidents — including bias harms, hallucinations and misuse — are formally managed with post-incident reviews and corrective actions.',
    hint: 'AI issues are treated as formal incidents with documented learning outcomes.',
    examples: [
      'AI incident categories included in the organisation\'s incident response plan.',
      'Documented handling of bias events, harmful outputs or hallucination incidents.',
      'Post-incident reviews with corrective actions tracked to closure.'
    ]
  },
  {
    id: 'records',
    group: 'ops',
    label: 'AI documentation is maintained — including dataset versions, model configurations, approval decisions and change history.',
    hint: 'Traceability for how AI systems were designed and operated is essential for audits.',
    examples: [
      'Version history of models, prompts, configurations and datasets.',
      'Decision logs for approvals, changes and risk acceptances.',
      'Records retained with defined periods aligned to regulatory and audit requirements.'
    ]
  },

  // Suppliers & Transparency
  {
    id: 'thirdparty',
    group: 'sup',
    label: 'Third-party AI providers are assessed for risk — including review of model cards, data handling and contractual controls.',
    hint: 'External AI providers introduce risk that must be managed through due diligence and contracts.',
    examples: [
      'Vendor due diligence covering security, privacy, bias and explainability.',
      'Review of model cards, SOC/ISO reports or published assurance statements.',
      'Contractual controls: usage limits, data handling, breach notification and liability.'
    ]
  },
  {
    id: 'transparency',
    group: 'sup',
    label: 'Users and stakeholders are informed when AI is used to make or support decisions, and can access a human review or opt out where applicable.',
    hint: 'Transparency builds trust and meets regulatory expectations in many jurisdictions.',
    examples: [
      'User-facing disclosures explaining AI purpose, data used and limitations.',
      'Clear contact points for human review, complaints or escalation.',
      'Documented opt-out or alternative pathways where AI decisions are material.'
    ]
  },

  // Evidence & Improvement
  {
    id: 'evidence',
    group: 'ev',
    label: 'AIMS evidence — policies, assessments, logs, test results — is centralised, version-controlled and retrievable for audit.',
    hint: 'Audit-ready evidence must be organised, retained and accessible.',
    examples: [
      'An AIMS evidence library in SharePoint or equivalent with version control.',
      'Monitoring logs and incident records retained in a governed system.',
      'Retention policies applied to AI governance records.'
    ]
  },
  {
    id: 'audits',
    group: 'ev',
    label: 'Internal AI governance audits or assurance reviews are performed, with findings tracked through to verified closure.',
    hint: 'Regular assurance confirms that AI governance controls are operating as intended.',
    examples: [
      'Internal AI governance or AIMS audits aligned to ISO 42001 requirements.',
      'Findings logged with corrective actions, owners and due dates.',
      'Evidence of verification that corrective actions were completed.'
    ]
  },
  {
    id: 'mgmt-review',
    group: 'ev',
    label: 'Leadership conducts regular reviews of AIMS performance — covering AI risks, incidents, KPIs and improvement opportunities.',
    hint: 'Management reviews ensure ongoing accountability and strategic direction for AI governance.',
    examples: [
      'Management review minutes covering AI risks, incidents and performance KPIs.',
      'Decisions on risk acceptance, resourcing and policy updates.',
      'Tracked actions arising from AIMS management reviews.'
    ]
  },
];

const GROUPS = [
  { key: 'gov',  title: 'AIMS Governance',               icon: 'ai-chip', blurb: 'Scope, roles, policy set and AI objectives.' },
  { key: 'risk', title: 'Risk & Impact Assessment',       icon: 'warning', blurb: 'AI inventory, impact assessment methodology and data ethics.' },
  { key: 'ctrl', title: 'Design, Controls & Oversight',   icon: 'lock', blurb: 'Preventative controls, human oversight and evaluation.' },
  { key: 'ops',  title: 'Operations & Monitoring',        icon: 'search', blurb: 'Runtime monitoring, incident handling and records.' },
  { key: 'sup',  title: 'Suppliers & Transparency',       icon: 'factory', blurb: 'Third-party AI due diligence and user transparency.' },
  { key: 'ev',   title: 'Evidence & Improvement',         icon: 'chart', blurb: 'Evidence management, audits and management reviews.' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="ISO 42001 Free AI Governance Readiness Checklist | Compliance365"
  description="Free ISO 42001 AI governance checklist for CIOs and CISOs. Assess AIMS maturity across governance, risk, controls and monitoring. Scored PDF roadmap."
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Checklists', url: 'https://www.compliance365.com.au/checklist/' },
    { name: 'ISO 42001 Checklist', url: 'https://www.compliance365.com.au/checklist/iso42001/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Free Readiness Assessment</p>
      <h1>ISO 42001 AI Governance Readiness Checklist</h1>
      <p class="section-lead" style="max-width:760px;">
        Score your AI Management System (AIMS) against ISO 42001 in 15 minutes. Tell us about your environment, answer 18 focused questions, and download a branded PDF roadmap with your top AI governance gaps and recommended next steps.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#A9812E;color:var(--on-gold);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill band-light" data-stage="2" style="flex:1;min-width:140px;background:#DDD8CF;color:var(--text-subtle);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill band-light" data-stage="3" style="flex:1;min-width:140px;background:#DDD8CF;color:var(--text-subtle);padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#FAF7F1;padding:2rem 0;border-top:1px solid #DDD8CF;border-bottom:1px solid #DDD8CF;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--gold-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-clock"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">~15 minutes</strong><p class="muted small" style="margin:2px 0 0;">18 focused questions across 6 AIMS domains, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--ok-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-check-seal"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Mapped to ISO 42001</strong><p class="muted small" style="margin:2px 0 0;">Calibrated to the AIMS requirements — the same criteria AI governance auditors assess.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="color:var(--gold-ink);"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><use href="#ic-note"/></svg></div>
          <div><strong style="color:#0B0B0C;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top AI governance gaps, and a prioritised action plan. Emailed copy + instant download.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Framework tabs -->
  <div style="background:#FAF7F1;border-bottom:1px solid #DDD8CF;padding:0.75rem 0;">
    <div class="container" style="max-width:1140px;">
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <span style="font-size:0.75rem;font-weight:700;color:#6B6860;text-transform:uppercase;letter-spacing:1px;margin-right:0.25rem;">Frameworks:</span>
        <a href={`${base}checklist/iso27001/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27001</a>
        <a href={`${base}checklist/iso27701/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">ISO 27701</a>
        <a href={`${base}checklist/iso42001/`} style="padding:5px 12px;border-radius:6px;background:#A9812E;color:var(--on-gold);font-size:0.8rem;font-weight:600;text-decoration:none;" aria-current="page">ISO 42001</a>
        <a href={`${base}checklist/essential-eight/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">Essential Eight</a>
        <a href={`${base}checklist/soc2/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">SOC 2</a>
        <a href={`${base}checklist/disp-ism-irap/`} style="padding:5px 12px;border-radius:6px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;">DISP / ISM / IRAP</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- ----- STAGE 1: Environment ----- -->
      <div id="stage-1" class="stage">
        <div class="card spot" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your AI governance roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0B0B0C;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #C8C3B8;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>

          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>

          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #DDD8CF;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 2: Questions ----- -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;" id="stage-2-grid">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #DDD8CF;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#F5F0E8;color:#3A3632;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #DDD8CF;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="width:1.75rem;height:1.75rem;display:inline-flex;align-items:center;justify-content:center;color:var(--gold-ink);flex-shrink:0;"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><use href={`#ic-${grp.icon}`}/></svg></span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0B0B0C;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:var(--gold-ink);">0/{grpQs.length}</div>
                    </div>
                  </div>

                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #F5F0E8;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:rgba(169,129,46,0.06);color:var(--gold-ink);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0B0B0C;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:var(--gold-ink);font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                            <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                              <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                              <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                              <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #C8C3B8;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                            </div>
                            <button type="button" class="ask-ai-btn" data-label={q.label} style="padding:7px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:var(--gold-ink);border-radius:8px;cursor:pointer;font-weight:600;font-size:0.78rem;white-space:nowrap;transition:background 0.15s;">Ask AI &#8594;</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card spot" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #F5F0E8;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#6B6860;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:var(--gold-ink);line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#6B6860;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:var(--text-subtle);font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#C8C3B8;"> - </span>
                    </div>
                    <div style="background:#F5F0E8;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#C8C3B8;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #F5F0E8;">
                <div style="font-size:0.75rem;color:#6B6860;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#F5F0E8;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#A9812E;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
              <button type="button" id="aiDiscussBtn" disabled style="width:100%;margin-top:0.75rem;padding:11px 14px;border:1.5px solid rgba(169,129,46,0.2);background:rgba(169,129,46,0.06);color:var(--gold-ink);border-radius:8px;cursor:not-allowed;font-weight:700;font-size:0.82rem;opacity:0.5;transition:background 0.15s,opacity 0.15s;">Discuss results with AI &#8594;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 3: Confirmation ----- -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card spot" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team — we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist/`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  </main>

  <Footer />

  <!-- jsPDF -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = "ISO 42001 (AI Governance)";
      const API_URL  = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

      const GROUPS = [
        { key:'gov',  title:'AIMS Governance' },
        { key:'risk', title:'Risk & Impact Assessment' },
        { key:'ctrl', title:'Design, Controls & Oversight' },
        { key:'ops',  title:'Operations & Monitoring' },
        { key:'sup',  title:'Suppliers & Transparency' },
        { key:'ev',   title:'Evidence & Improvement' },
      ];

      const QUESTIONS = [
        { id:'aims-scope',     group:'gov',  label:'AIMS scope defined — AI use cases, systems, models, jurisdictions and in/out boundaries' },
        { id:'roles-oversight',group:'gov',  label:'AI governance roles defined — owners, committees and RACI covering key decisions and escalation' },
        { id:'policies',       group:'gov',  label:'AI policy set approved — acceptable use, risk tolerance, data sourcing, transparency and disclosure' },
        { id:'objectives',     group:'gov',  label:'AI objectives and KPIs defined, tracked and reviewed by leadership' },
        { id:'inventory',      group:'risk', label:'AI use-case inventory maintained — purpose, risks, data types, owners and risk classification' },
        { id:'risk-method',    group:'risk', label:'AI Impact and Risk Assessment (AIRA) methodology defined and applied before deployment and changes' },
        { id:'data-ethics',    group:'risk', label:'Training and input data assessed for bias, representativeness, provenance and lawful basis' },
        { id:'design-controls',group:'ctrl', label:'Preventative design controls implemented — output filters, PII minimisation and security hardening' },
        { id:'human-loop',     group:'ctrl', label:'Human oversight defined — review thresholds, escalation paths and ability to override or disable AI' },
        { id:'eval',           group:'ctrl', label:'AI evaluated before release and after changes — fairness, robustness, red-teaming and go/no-go records' },
        { id:'monitor',        group:'ops',  label:'Runtime monitoring in place — quality, drift, misuse and policy violations with logs and alerts' },
        { id:'incident',       group:'ops',  label:'AI incidents formally managed — bias harms, hallucinations and misuse handled with post-incident reviews' },
        { id:'records',        group:'ops',  label:'AI documentation maintained — dataset versions, model configs, approval decisions and change history' },
        { id:'thirdparty',     group:'sup',  label:'Third-party AI providers assessed — model cards, data handling, SLAs and contractual controls' },
        { id:'transparency',   group:'sup',  label:'Users informed when AI is used and can access human review or opt out where applicable' },
        { id:'evidence',       group:'ev',   label:'AIMS evidence centralised, version-controlled and retrieval-ready for audit' },
        { id:'audits',         group:'ev',   label:'Internal AIMS audits performed with findings tracked to verified closure' },
        { id:'mgmt-review',    group:'ev',   label:'Management reviews held covering AIMS performance, AI risks, incidents and improvements' },
      ];

      const TOTAL_Q = QUESTIONS.length;
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#A9812E' : (s < n ? '#16a34a' : '#DDD8CF');
            p.style.color = (s <= n) ? 'var(--on-gold)' : 'var(--text-subtle)';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.getElementById('to-stage-2').addEventListener('click', function() {
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger','timeline','ai-use'];
          var reqIds = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];
          allIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) env[id] = el.value ? el.value.trim() : '';
          });
          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) {
              valid = false;
              el.style.borderColor = '#dc2626';
              el.style.background  = '#fef2f2';
            } else {
              el.style.borderColor = '#C8C3B8';
              el.style.background  = 'white';
            }
          });
          var errEl = document.getElementById('env-error');
          if (!valid) {
            errEl.style.display = 'block';
            errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white';
              o.style.color = '#0B0B0C';
              o.style.borderColor = '#C8C3B8';
            });
            btn.classList.add('active');
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'var(--on-gold)'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'var(--on-gold)'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        document.querySelectorAll('.ask-ai-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var label = btn.dataset.label || '';
            var fieldEl = btn.closest('.field');
            var id = fieldEl ? fieldEl.dataset.id : null;
            var currentVal = id ? state[id] : null;
            var statusNote = currentVal === 2 ? ' (you answered: Yes)' : currentVal === 1 ? ' (you answered: Partial)' : currentVal === 0 ? ' (you answered: No)' : '';
            var msg = 'I\'m working through the ISO 42001 AI governance readiness checklist. Can you explain what this control means and what good looks like in practice?\n\nControl: ' + label + statusNote;
            if (typeof window.c365OpenChat === 'function') {
              window.c365OpenChat(msg);
            }
          });
        });

        document.getElementById('aiDiscussBtn').addEventListener('click', function() {
          if (typeof window.c365OpenChat !== 'function') return;
          window.c365OpenChat(buildAIContext());
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white';
            o.style.color = '#0B0B0C';
            o.style.borderColor = '#C8C3B8';
          });
          update();
        });

        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true;
          btn.textContent = 'Generating...';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
            if (typeof gtag === 'function') gtag('event', 'checklist_completed', { framework: 'ISO 42001' });
          } catch (err) {
            console.error(err);
            alert('Something went wrong — your PDF should still have downloaded.');
          } finally {
            btn.disabled = false;
            btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => {
          if (state[id] !== null) { answered++; sum += state[id]; }
        });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { key: 'na', label: 'Not started', desc: 'Answer questions to score', color: '#6B6860' };
        if (score >= 86) return { key: 'cr', label: 'Certification-Ready', desc: 'Strong AI governance posture — focus on evidence packaging and audit preparation', color: '#16a34a' };
        if (score >= 61) return { key: 'nar', label: 'Nearly Audit-Ready', desc: 'Close minor gaps and tighten evidence packaging', color: '#A9812E' };
        if (score >= 31) return { key: 'pr', label: 'Partially Ready', desc: 'Many core elements in place — focus and prioritisation needed', color: '#d97706' };
        return { key: 'hr', label: 'High Risk', desc: 'Missing foundational AI governance controls — structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#C8C3B8';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function buildAIContext() {
        var comp = compute();
        var band = getBand(comp.score, comp.answered);
        var lines = [];
        lines.push('I\'ve just completed the ISO 42001 AI governance readiness checklist on the Compliance365 website. Here are my results:');
        lines.push('');
        lines.push('Organisation: ' + (env['org-name'] || 'Not specified'));
        lines.push('Sector: ' + (env['org-sector'] || 'Not specified'));
        lines.push('Size: ' + (env['org-size'] || 'Not specified'));
        lines.push('AI use: ' + (env['ai-use'] || 'Not specified'));
        lines.push('Trigger: ' + (env['trigger'] || 'Not specified'));
        lines.push('Target timeline: ' + (env['timeline'] || 'Not specified'));
        lines.push('');
        lines.push('Overall score: ' + comp.score + '% - ' + band.label);
        lines.push('');
        lines.push('Domain scores:');
        GROUPS.forEach(function(grp) {
          var s = computeSection(grp.key);
          lines.push('  ' + grp.title + ': ' + (s.pct === null ? 'N/A' : s.pct + '%'));
        });
        lines.push('');
        var gaps = QUESTIONS.filter(function(q) { return state[q.id] === 0 || state[q.id] === 1; });
        if (gaps.length) {
          lines.push('Controls needing attention (' + gaps.length + '):');
          gaps.forEach(function(q) {
            var v = state[q.id] === 1 ? 'PARTIAL' : 'NO';
            lines.push('  [' + v + '] ' + q.label);
          });
        } else {
          lines.push('All controls answered YES.');
        }
        lines.push('');
        lines.push('Based on these results, can you help me understand my biggest AI governance gaps, what I should prioritise, and what a realistic path to ISO 42001 certification looks like for my organisation?');
        return lines.join('\n');
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);

        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#F5F0E8';
            el.style.color = a === total ? '#166534' : '#3A3632';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) {
              bar.style.width = '0%'; bar.style.background = '#C8C3B8';
              pctEl.textContent = ' - '; pctEl.style.color = '#C8C3B8';
            } else {
              bar.style.width = pct + '%'; bar.style.background = barColor(pct);
              pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct);
            }
          }
        });

        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone;
        btn.style.cursor = allDone ? 'pointer' : 'not-allowed';
        btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone
          ? 'Click to generate and email your report'
          : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
        const aiBtn = document.getElementById('aiDiscussBtn');
        if (aiBtn) {
          aiBtn.disabled = !allDone;
          aiBtn.style.cursor = allDone ? 'pointer' : 'not-allowed';
          aiBtn.style.opacity = allDone ? '1' : '0.5';
        }
      }

      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const sectionScores = GROUPS.map(g => ({ title: g.title, ...computeSection(g.key) }));
        const lines = [];
        lines.push('=== ISO 42001 AI GOVERNANCE CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`AI use: ${env['ai-use'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        sectionScores.forEach(s => lines.push(`  ${s.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`));
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          const label = v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED';
          lines.push(`[${label}] ${q.label}`);
        });
        const payload = {
          name: env['contact-name'] || env['org-name'] || 'Anonymous',
          email: env['contact-email'] || 'noreply@compliance365.com.au',
          subject: `ISO 42001 Checklist - ${env['org-name'] || 'Anonymous'} - ${score}%`,
          message: lines.join('\n'),
        };
        try {
          await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.warn('API submission failed:', err);
        }
      }

      function generatePDF() {
        var jsPDFLib = window.jspdf || {};
        var jsPDF = jsPDFLib.jsPDF;
        if (!jsPDF) { alert('PDF library not loaded - please wait a moment and try again.'); return; }

        var doc = new jsPDF('p','mm','a4');
        var W=210, LM=18, RM=16, CW=210-18-16;
        var y=0;

        var PRIMARY=[30,64,175], GREEN=[5,150,105], AMBER=[180,110,0], RED=[200,30,30];
        var WHITE=[255,255,255], LIGHT=[248,250,252], MUTED=[100,116,139], DARK=[17,24,39];

        var comp=compute(), sc=comp.score, ansCount=comp.answered, band=getBand(sc,ansCount);
        var orgName=env['org-name']||'Your Organisation';
        var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
        var scoreCol=sc>=75?GREEN:sc>=50?AMBER:RED;
        var scoreBand=sc>=86?'Certification-Ready':sc>=61?'Nearly Audit-Ready':sc>=31?'Partially Ready':'High Risk';

        // Cover header
        doc.setFillColor(...PRIMARY); doc.rect(0,0,W,42,'F');
        doc.setFillColor(6,182,212); doc.rect(0,40,W,2,'F');

        var logoEl=document.getElementById('pdfLogo');
        doc.setTextColor(...WHITE);
        doc.setFont('helvetica','bold'); doc.setFontSize(18);
        if (logoEl && logoEl.complete && logoEl.naturalWidth > 0) {
          doc.addImage(logoEl,'PNG',LM,8,20,20,undefined,'FAST');
          doc.text('Compliance365', LM+24, 18);
        } else {
          doc.text('Compliance365', LM, 18);
        }
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text('ISO 42001 AI Governance Readiness Report', LM+(logoEl&&logoEl.complete?24:0), 26);
        doc.setFontSize(9);
        doc.text(orgName + '  |  ' + today, LM+(logoEl&&logoEl.complete?24:0), 34);

        y=56;
        // Score summary
        doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,28,4,4,'F');
        doc.setFillColor(...scoreCol); doc.roundedRect(LM,y,6,28,2,2,'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(28); doc.setTextColor(...scoreCol);
        doc.text(sc+'%', LM+16, y+18);
        doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text(scoreBand, LM+44, y+12);
        doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(...MUTED);
        doc.text(band.desc, LM+44, y+19, { maxWidth: CW-50 });
        doc.text(ansCount+'/'+TOTAL_Q+' questions answered', LM+44, y+25);
        y+=36;

        // Domain breakdown
        doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
        doc.text('Domain Breakdown', LM, y); y+=6;

        GROUPS.forEach(function(grp) {
          var s=computeSection(grp.key);
          var p=s.pct===null?0:s.pct;
          var col=p>=75?GREEN:p>=50?AMBER:RED;
          doc.setFillColor(...LIGHT); doc.roundedRect(LM,y,CW,12,2,2,'F');
          doc.setFillColor(...col); doc.roundedRect(LM,y,4,12,1,1,'F');
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...DARK);
          doc.text(grp.title, LM+8, y+7.5);
          var barX=LM+CW-60, barW=50;
          doc.setFillColor(226,232,240); doc.roundedRect(barX,y+4,barW,4,1,1,'F');
          if (p>0) { doc.setFillColor(...col); doc.roundedRect(barX,y+4,barW*(p/100),4,1,1,'F'); }
          doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...col);
          doc.text(s.pct===null?'-':p+'%', barX+barW+4, y+7.5);
          y+=15;
        });

        y+=4;
        // Top gaps
        var gaps=QUESTIONS.filter(function(q){ return state[q.id]===0||state[q.id]===1; });
        if (gaps.length) {
          doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(...DARK);
          doc.text('Priority Gaps', LM, y); y+=6;
          gaps.forEach(function(q) {
            if (y>270) { doc.addPage(); y=16; }
            var v=state[q.id];
            var col=v===0?RED:AMBER;
            var lbl=v===0?'NO':'PARTIAL';
            doc.setFillColor(...(v===0?[255,225,225]:[255,241,194]));
            doc.roundedRect(LM,y,CW,10,2,2,'F');
            doc.setFillColor(...col); doc.roundedRect(LM,y,3,10,1,1,'F');
            var lines=doc.splitTextToSize(q.label, CW-40);
            doc.setFont('helvetica','normal'); doc.setFontSize(8.5); doc.setTextColor(...DARK);
            doc.text(lines, LM+7, y+6.5);
            doc.setFont('helvetica','bold'); doc.setFontSize(8); doc.setTextColor(...col);
            doc.text(lbl, W-RM-14, y+6.5);
            y+=13;
          });
        }

        // Footer
        doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(...MUTED);
        doc.text('Generated by Compliance365  |  compliance365.com.au  |  ISO 42001 AI Governance Readiness Report', LM, 290);

        doc.save('iso42001_readiness_' + (orgName.replace(/[^a-z0-9]/gi,'-')||'report') + '.pdf');
      }
    })();
  </script>
</Base>
