---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Essential Eight Consulting &amp; Maturity Uplift — Australia',
  serviceType: 'Essential Eight Maturity Uplift',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/essential-eight',
  description:
    'Compliance365 delivers Essential Eight assessments, maturity uplift, and ongoing assurance for Australian organisations on the Microsoft 365 stack. Senior-led, fixed-price engagements with audit-ready evidence packs at every milestone.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the Essential Eight?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Essential Eight is the Australian Signals Directorate\'s (ASD) baseline set of eight cyber security mitigation strategies — Application Control, Patch Applications, Office Macro Configuration, User Application Hardening, Restriction of Administrative Privileges, Patch Operating Systems, Multi-Factor Authentication, and Regular Backups. Each is measured across four maturity levels (ML0-ML3). The framework is designed to make it significantly harder for adversaries to compromise systems, steal data, or cause operational disruption.'
      }
    },
    {
      '@type': 'Question',
      name: 'What maturity level should my organisation aim for?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ML2 is the ASD-recommended baseline for most Australian organisations and is increasingly required by cyber insurers, government procurement panels, and enterprise customers. ML3 is appropriate for high-risk environments, government agencies, and defence-adjacent organisations. Most clients start with an honest ML0-1 assessment and build toward ML2 as the first structured programme objective.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does Essential Eight uplift take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A focused SMB engagement covering priority controls typically takes 8-14 weeks. A full mid-market programme covering all eight controls to ML2 runs approximately six months with milestone-gated delivery. Timeline depends on current maturity baseline, estate complexity, and the number of legacy endpoints requiring remediation.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need to buy new tools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For organisations on Microsoft 365 E5, approximately 80-85% of the ML2 technical control surface is achievable using native capabilities — Intune, Defender for Endpoint P2, Entra ID P2 with PIM, and Defender Vulnerability Management. The main gap is third-party M365 backup tooling, which is required for ML2 and not included in E5. We help you select, configure, and evidence the right tooling without unnecessary spend.'
      }
    },
    {
      '@type': 'Question',
      name: 'How is pricing structured?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'All engagements are fixed-price with milestone-based payments tied to evidenced controls. You only pay when controls are demonstrably delivered to the agreed maturity level against ASD evidence requirements. This protects you from cost overruns and aligns our incentives with your outcome.'
      }
    },
    {
      '@type': 'Question',
      name: 'Will the evidence stand up to an external assessor or auditor?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every milestone evidence pack is assembled against ASD\'s published ML2 evidence requirements, with a criteria-mapping index. Each pack passes a four-point internal QA review — completeness, defensibility, currency, and coherence — before submission. The evidence is designed to survive IRAP reviews, cyber insurance audits, customer due diligence, and board-level scrutiny.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is the Essential Eight mandatory for Australian businesses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For non-corporate Commonwealth entities, the Essential Eight is mandatory under the Protective Security Policy Framework (PSPF). For private sector organisations it is not legislatively mandated, but it is increasingly required by cyber insurers, referenced in SOCI Act obligations for critical infrastructure, and expected by large enterprise and government customers in supply chain due diligence.'
      }
    }
  ]
};
---

<Base
  title="Essential Eight Consulting &amp; Maturity Uplift — Australian Mid-Market | Compliance365"
  description="Senior-led Essential Eight assessments, uplift, and assurance for Australian organisations. Fixed-price, evidence-backed, Microsoft 365-native. ML1 to ML2 and beyond."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1>Essential Eight Uplift — Assessed, Implemented &amp; Evidenced</h1>
          <p class="section-lead muted">
            Move from ML0&ndash;1 to ML2 across all eight ASD controls — with audit-ready evidence packs at every milestone, delivered inside your existing Microsoft 365 stack.
          </p>
          <p class="muted">
            The Essential Eight is Australia's baseline cyber security framework. We assess where you stand today, implement controls in the right sequence, and capture defensible evidence as we go — fixed-price, milestone-gated, with no dependency on new tooling for the majority of controls.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">Fixed-price delivery</span>
            <span class="pill">All 8 controls</span>
            <span class="pill">Audit-ready evidence</span>
            <span class="pill">Microsoft 365 native</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">{ctaLabel}</a>
            <a href="#controls" class="btn btn-outline">See all eight controls</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/illus-iso27001.svg`}
            alt="Essential Eight maturity uplift delivered in Microsoft 365"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS THE ESSENTIAL EIGHT -->
  <section class="section">
    <div class="container">
      <h2 class="center">What is the Essential Eight?</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        The Essential Eight is the Australian Signals Directorate's (ASD) baseline cyber security framework — eight mitigation strategies that, when implemented correctly, make it significantly harder for adversaries to compromise your systems, steal data, or disrupt operations.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Australia's Cyber Security Baseline</h3>
          <p class="muted small">
            Mandatory for Commonwealth entities under the PSPF. Increasingly required by cyber insurers, expected by enterprise and government customers in procurement questionnaires, and referenced in SOCI Act obligations for critical infrastructure operators.
          </p>
        </div>
        <div class="card feature center">
          <h3>Four Maturity Levels, One Clear Target</h3>
          <p class="muted small">
            Each control is measured from ML0 (absent or ad-hoc) through to ML3 (active adversary detection). ML2 is the ASD-recommended baseline for most organisations — the level most commonly required by cyber insurers and procurement panels.
          </p>
        </div>
        <div class="card feature center">
          <h3>Microsoft 365 Covers Most of It</h3>
          <p class="muted small">
            For organisations on M365 E5, approximately 80&ndash;85% of the ML2 technical control surface is achievable using native capabilities — Intune, Defender for Endpoint P2, Entra ID P2 with PIM, and Defender Vulnerability Management.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE EIGHT CONTROLS -->
  <section class="section" style="background:#f8fafc;" id="controls">
    <div class="container">
      <h2 class="center">The Eight Controls</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Each control addresses a specific adversary technique. Together they form a layered defence that dramatically reduces the likelihood of a successful attack. Compliance365 delivers all eight to ML2 — configured, evidenced, and handed over in a state your team can sustain.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>1. Application Control</h3>
          <p class="muted small">
            Prevents unapproved or malicious software from executing on workstations and servers. Deployed via WDAC / AppLocker through Intune with ring-based rollout and exception governance for line-of-business applications.
          </p>
        </div>
        <div class="card feature center">
          <h3>2. Patch Applications</h3>
          <p class="muted small">
            Ensures internet-facing and end-user applications are patched within ASD-defined timeframes. Managed through Defender Vulnerability Management and Intune with fortnightly scanning cadence and asset lifecycle oversight.
          </p>
        </div>
        <div class="card feature center">
          <h3>3. Configure Microsoft Office Macros</h3>
          <p class="muted small">
            Blocks or restricts Office macros to prevent a common malware delivery vector. Enforced via Intune ADMX profiles with Defender ASR rules blocking macro-driven child processes and centralised telemetry logging.
          </p>
        </div>
        <div class="card feature center">
          <h3>4. User Application Hardening</h3>
          <p class="muted small">
            Reduces the attack surface of browsers, Office, and PDF software through configuration hardening aligned to ACSC and vendor guidance. Deployed via Intune with compliance reporting and drift monitoring.
          </p>
        </div>
        <div class="card feature center">
          <h3>5. Restrict Administrative Privileges</h3>
          <p class="muted small">
            Limits privileged accounts using Entra PIM with just-in-time elevation, approval workflows, and Windows LAPS for local admin rotation. Privileged events logged centrally with annual revalidation.
          </p>
        </div>
        <div class="card feature center">
          <h3>6. Patch Operating Systems</h3>
          <p class="muted small">
            Remediates OS vulnerabilities within ASD timeframes using Windows Update for Business and Defender Vulnerability Management. Includes legacy endpoint lifecycle management for devices outside standard patch cadence.
          </p>
        </div>
        <div class="card feature center">
          <h3>7. Multi-Factor Authentication</h3>
          <p class="muted small">
            Enforces MFA for all users accessing internet-facing services and important data, with phishing-resistant methods (FIDO2, Windows Hello) for privileged accounts. Conditional Access policies managed via Entra ID P2.
          </p>
        </div>
        <div class="card feature center">
          <h3>8. Regular Backups</h3>
          <p class="muted small">
            Ensures business-critical data, software, and configuration can be restored following an incident. Covers M365 backup tooling selection, immutable retention, restore testing, and a documented, tabletop-tested Disaster Recovery Plan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON CHALLENGES -->
  <section class="section">
    <div class="container">
      <h2 class="center">Common Challenges We Solve</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        Most Australian mid-market organisations have more controls in place than they realise. The problem is usually consistency, evidence, and the path from a maturity assessment to a defensible ML2 position.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>"Our last assessment landed at ML0&ndash;1"</h3>
          <p class="muted small">
            You have a baseline but no clear path forward — with controls that are consistently applied and evidence that holds up to external scrutiny. We turn your assessment into a sequenced delivery programme with milestone-gated evidence at every step.
          </p>
        </div>
        <div class="card feature center">
          <h3>"Insurers and customers are asking harder questions"</h3>
          <p class="muted small">
            Cyber insurance renewals, procurement questionnaires, and customer due diligence reviews are asking for ML2 evidence — not self-attestation. We give you audit-ready evidence packs indexed against ASD's published ML2 requirements.
          </p>
        </div>
        <div class="card feature center">
          <h3>"We don't want a Big-4 invoice for this"</h3>
          <p class="muted small">
            The mid-market doesn't need partner-sold, junior-delivered consulting. You need a senior specialist who scopes, configures, and signs off the evidence themselves — on a fixed price tied to demonstrable outcomes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE DELIVER -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">How We Deliver Essential Eight</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Every control follows the same four-phase delivery model — overlapping across milestones to maintain momentum, but no control is claimed complete until evidence is assessor-ready.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Phase 1: Assess</h3>
          <p class="muted small">
            <strong>Current state &amp; gaps.</strong> Tenant configuration review, asset inventory, current maturity rated against ASD criteria — not a self-assessment questionnaire. Prioritised remediation roadmap with effort estimates and a board-ready summary report.
          </p>
        </div>
        <div class="card feature center">
          <h3>Phase 2: Design</h3>
          <p class="muted small">
            <strong>Configuration &amp; exceptions.</strong> Each control designed to ASD intent, not just literal checklist wording. Pilot rings defined, exception workflows built, rollback plans documented. Steering committee sign-off before any production change.
          </p>
        </div>
        <div class="card feature center">
          <h3>Phase 3: Implement</h3>
          <p class="muted small">
            <strong>Audit mode, then enforce.</strong> Controls deployed in audit mode first, monitored, exceptions triaged, then expanded in tranches before full enforcement. No big-bang changes that break operations. Drift detection stood up before we move on.
          </p>
        </div>
        <div class="card feature center">
          <h3>Phase 4: Evidence</h3>
          <p class="muted small">
            <strong>Pack, QA, sign-off.</strong> Evidence captured at the point of change — never reconstructed later. Each milestone pack indexed against ASD criteria, QA reviewed for completeness and defensibility, and signed off before milestone payment is triggered.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE OPTIONS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Service Options</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Two structured engagement shapes built around the same methodology — scoped to the size and complexity of your environment.
      </p>

      <div class="grid-2" style="margin-top:3rem;max-width:900px;margin-left:auto;margin-right:auto;">
        <div class="card">
          <h3>Essential Eight Assessment</h3>
          <p class="muted small" style="margin-bottom:1rem;">
            A structured current-state assessment that tells you exactly where you sit against ASD ML1, ML2, and ML3 criteria — with a clear, prioritised remediation roadmap. Delivered in 2&ndash;3 weeks.
          </p>
          <ul class="muted small" style="padding-left:1.2rem;margin-bottom:1.5rem;">
            <li>Tenant configuration review across all 8 controls</li>
            <li>Maturity rating mapped to ASD criteria (not self-assessed)</li>
            <li>Prioritised remediation roadmap with effort estimates</li>
            <li>Evidence gap analysis — what you have vs what you need</li>
            <li>Board-ready summary report</li>
          </ul>
          <a href={ctaUrl} class="btn btn-outline">{ctaLabel}</a>
        </div>
        <div class="card" style="border:2px solid #1e40af;">
          <div style="display:inline-block;background:#1e40af;color:white;font-size:0.75rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:4px 12px;border-radius:12px;margin-bottom:1rem;">Most popular</div>
          <h3>ML2 Uplift Programme</h3>
          <p class="muted small" style="margin-bottom:1rem;">
            End-to-end delivery from current state to ML2 attestation across all eight controls. Fixed-price, milestone-gated, with evidenced handover your team can sustain.
          </p>
          <ul class="muted small" style="padding-left:1.2rem;margin-bottom:1.5rem;">
            <li>All eight controls implemented to ML2</li>
            <li>Fixed-price with milestone-gated payments</li>
            <li>Audit-ready evidence pack per milestone</li>
            <li>Documented &amp; tabletop-tested DRP</li>
            <li>BAU runbooks &amp; drift detection dashboards</li>
            <li>30/60/90-day post-engagement watch-list</li>
            <li>vCISO and steering committee integration</li>
          </ul>
          <a href={ctaUrl} class="btn btn-primary">{ctaLabel}</a>
        </div>
      </div>

      <p class="muted center" style="margin-top:2rem;">
        Already at ML2 and looking to sustain or reach ML3?
        <a href={ctaUrl} style="color:#1e40af;font-weight:600;">Talk to us</a> about ongoing assurance retainers.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Essential Eight FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>What is the Essential Eight?</h3>
          <p class="muted">
            The ASD's baseline set of eight cyber security controls — Application Control, Patch Applications, Office Macros, User Application Hardening, Restrict Admin Privileges, Patch OS, MFA, and Regular Backups. Each measured across ML0&ndash;ML3.
          </p>
        </div>
        <div class="card">
          <h3>What maturity level should we aim for?</h3>
          <p class="muted">
            <strong>ML2</strong> is the ASD-recommended baseline for most organisations — the level most required by insurers and procurement panels. ML3 is for high-risk, government, or defence-adjacent environments.
          </p>
        </div>
        <div class="card">
          <h3>Do we need new tools?</h3>
          <p class="muted">
            For M365 E5 organisations, <strong>80&ndash;85%</strong> of ML2 is achievable using native capabilities — Intune, Defender for Endpoint P2, Entra ID P2, and Defender Vulnerability Management. The gap is M365 backup tooling only.
          </p>
        </div>
        <div class="card">
          <h3>How long does uplift take?</h3>
          <p class="muted">
            An assessment takes <strong>2&ndash;3 weeks</strong>. A full ML2 uplift programme across all eight controls runs approximately <strong>six months</strong> with milestone-gated delivery. SMB-focused engagements covering priority controls can complete in <strong>8&ndash;14 weeks</strong>.
          </p>
        </div>
        <div class="card">
          <h3>Will evidence stand up to an auditor?</h3>
          <p class="muted">
            Yes. Every evidence pack is assembled against ASD's published ML2 requirements, QA reviewed for completeness and defensibility, and designed to survive IRAP reviews, cyber insurance audits, and customer due diligence.
          </p>
        </div>
        <div class="card">
          <h3>Is the Essential Eight mandatory?</h3>
          <p class="muted">
            Mandatory for Commonwealth entities under the PSPF. For private sector organisations, it is not legislatively mandated but is increasingly required by insurers, referenced in SOCI Act obligations, and expected by enterprise and government customers in supply chain due diligence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section">
    <div class="container center">
      <h2>Related Services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Pair Essential Eight with ISO 27001 for a unified security posture — or add ISO 27701 for privacy. All frameworks delivered inside the same Microsoft 365 environment.
      </p>

      <div class="pill-row" style="justify-content:center;">
        <a class="pill" href="/services/iso27001">ISO 27001 (Information Security)</a>
        <a class="pill" href="/services/iso27701">ISO 27701 (Privacy)</a>
        <a class="pill" href="/services/iso42001">ISO 42001 (AI Governance)</a>
        <a class="pill" href="/services/soc2">SOC 2</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Not Sure Where Your Essential Eight Maturity Sits?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        A 30-minute call will give you a clear picture of your current maturity position, the most important gaps to close first, and what a realistic uplift programme looks like for your environment. No obligation, no sales pitch.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Book a Free Call
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
        Assessments delivered in 2&ndash;3 weeks. Full ML2 uplift programmes completed in approximately six months.
      </p>
    </div>
  </section>

  <Footer />
</Base>
