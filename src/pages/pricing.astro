---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import {
  MODULES, ADDONS, TIERS, CONTACT_FRAMEWORKS, BUNDLE_DISCOUNTS, ENTERPRISE,
  TRIAL_DAYS, fmtAud, SELF_SERVE, isSelfServeLive
} from '../data/pricing.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office365.com/owa/calendar/Compliance3652@compliance365.com.au/bookings/';
const startUrl = `${base}start/`;
const live = isSelfServeLive();
---
<Base
  title="Pricing — Checkpoint self-serve compliance | Compliance365"
  description="Transparent per-framework pricing for Checkpoint — run ISO 27001, SOC 2, Essential Eight, ISO 42001, ISO 27701 or NIST CSF inside your own Microsoft 365 tenant. 7-day free trial, cancel anytime. From $3,500/year."
>

<Header />

<!-- HERO -->
<section class="svc-hero">
  <CinematicBackground static />
  <div class="svc-hero-copy" style="position:relative;z-index:1;max-width:860px;margin:0 auto;padding:0 22px;text-align:center;">
    <p class="eyebrow">Pricing</p>
    <h1>Compliance software, priced per framework</h1>
    <p class="section-lead">
      Checkpoint runs entirely inside your own Microsoft 365 tenant — no third-party GRC platform, no data leaving your environment. Pick the frameworks you need, start a <strong>{TRIAL_DAYS}-day free trial</strong>, and run the programme yourself. Hiring the same work out as consulting runs $30k–$60k; this is a tenth of that.
    </p>
    <div class="hero-ctas" style="justify-content:center;">
      <a href={startUrl} class="btn-hdk-primary">Start your {TRIAL_DAYS}-day free trial</a>
      <a href="#configure" class="btn-hdk-ghost">Build a quote</a>
    </div>
    <p style="margin-top:1rem;font-size:0.9rem;color:rgba(250,247,241,.55);">
      Card required to start the trial, charged only on day {TRIAL_DAYS + 1} unless you cancel. Prices in AUD, ex GST.
    </p>
  </div>
</section>

<!-- FRAMEWORK PRICE CARDS -->
<section class="section">
  <div class="container">
    <p class="eyebrow" style="text-align:center;">Self-serve frameworks</p>
    <h2 style="text-align:center;margin-bottom:0.75rem;">One annual price per framework</h2>
    <p style="text-align:center;max-width:640px;margin:0 auto 2.5rem;color:var(--muted,#555);">
      Every framework is the full Checkpoint experience — the control set, continuous evidence, posture scanning, reports and the AI tools. The only thing that changes with headcount is the audit/evidence scope, so there are two straightforward tiers.
    </p>

    <div class="price-grid">
      {MODULES.map((m) => (
        <div class={`price-card${m.premium ? ' price-card-premium' : ''}`}>
          {m.premium && <span class="price-flag">Most in demand</span>}
          <h3>{m.name}</h3>
          <p class="price-tag-line">{m.tag}</p>
          <div class="price-tiers">
            <div class="price-tier">
              <span class="pt-amount">{fmtAud(m.prices.micro)}</span>
              <span class="pt-label">/yr · under 50 staff</span>
            </div>
            <div class="price-tier">
              <span class="pt-amount">{fmtAud(m.prices.growth)}</span>
              <span class="pt-label">/yr · 50–250 staff</span>
            </div>
          </div>
          <a href={startUrl} class="btn btn-primary" style="width:100%;text-align:center;margin-top:auto;">Start free trial</a>
        </div>
      ))}
    </div>

    <p style="text-align:center;margin-top:1.75rem;font-size:0.95rem;color:var(--muted,#555);">
      Licensing more than one? {BUNDLE_DISCOUNTS.map((d) => d.label).join(' · ')}. Over 250 staff? <a href="#enterprise" style="color:#8B6820;font-weight:600;">See Enterprise pricing</a> below.
    </p>
  </div>
</section>

<!-- ENTERPRISE PLAN -->
<section class="section" id="enterprise" style="background:#F7F4EE;">
  <div class="container" style="max-width:920px;">
    <p class="eyebrow" style="text-align:center;">250+ staff</p>
    <h2 style="text-align:center;margin-bottom:0.75rem;">Enterprise</h2>
    <p style="text-align:center;max-width:640px;margin:0 auto 2.5rem;color:var(--muted,#555);">
      The same Checkpoint experience as above, scoped to a larger estate. Because headcount above 250 varies enormously — 300 staff and 30,000 staff aren't the same job — the exact annual fee is confirmed in a written quote before you're ever invoiced, but the starting price, billing period and everything included are published here, not hidden behind a sales call.
    </p>

    <div class="ent-card">
      <div class="ent-price-block">
        <div class="ent-price-row">
          <span class="ent-price-label">Standard frameworks</span>
          <span class="ent-price-amount">From {fmtAud(ENTERPRISE.startingPrice)}<span class="ent-price-period">/yr per framework</span></span>
        </div>
        <div class="ent-price-row">
          <span class="ent-price-label">SOC 2</span>
          <span class="ent-price-amount">From {fmtAud(ENTERPRISE.startingPriceSoc2)}<span class="ent-price-period">/yr</span></span>
        </div>
        <div class="ent-price-row">
          <span class="ent-price-label">AI assistant add-on</span>
          <span class="ent-price-amount">{fmtAud(ENTERPRISE.addonPrice)}<span class="ent-price-period">/yr</span></span>
        </div>
        <p class="ent-billing"><b>Billing:</b> {ENTERPRISE.billingPeriod}. Licensing more than one framework? The same bundle discount applies ({BUNDLE_DISCOUNTS.map((d) => d.label).join(' · ')}).</p>
      </div>

      <div class="ent-features-block">
        <p class="ent-features-label">What's included</p>
        <ul class="ent-features">
          {ENTERPRISE.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>

    <p style="text-align:center;margin-top:2rem;">
      <a href={ctaUrl} class="btn btn-primary">Talk to us about your estate</a>
    </p>
    <p style="text-align:center;margin-top:0.75rem;font-size:0.85rem;color:var(--muted,#8A8172);">
      You'll see the exact annual price and term in writing before anything is invoiced or charged — nothing is billed from this conversation alone.
    </p>
  </div>
</section>

<!-- INTERACTIVE CONFIGURATOR -->
<section class="section" id="configure" style="background:#F7F4EE;">
  <div class="container" style="max-width:900px;">
    <p class="eyebrow" style="text-align:center;">Build your quote</p>
    <h2 style="text-align:center;margin-bottom:2rem;">See your exact annual price</h2>

    <div class="cfg-wrap">
      <div class="cfg-controls">
        <div class="cfg-block">
          <label class="cfg-label">Company size</label>
          <div class="cfg-tiers" id="cfgTiers">
            {TIERS.map((t) => (
              <button type="button" class={`cfg-tier${t.id === 'micro' ? ' on' : ''}`} data-tier={t.id}>
                <b>{t.label}</b><span>{t.blurb}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="cfg-block">
          <label class="cfg-label">Frameworks</label>
          <div class="cfg-modules">
            {MODULES.map((m) => (
              <label class="cfg-mod">
                <input type="checkbox" class="cfg-mod-input" data-module={m.id} />
                <span class="cfg-mod-name">{m.name}</span>
                <span class="cfg-mod-tag">{m.tag}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="cfg-block">
          <label class="cfg-label">Add-ons</label>
          <div class="cfg-modules">
            {ADDONS.map((a) => (
              <label class="cfg-mod">
                <input type="checkbox" class="cfg-addon-input" data-addon={a.id} />
                <span class="cfg-mod-name">{a.name}</span>
                <span class="cfg-mod-tag">{a.tag}</span>
              </label>
            ))}
          </div>
        </div>
      </div>

      <aside class="cfg-summary" aria-live="polite">
        <h3 style="margin-top:0;">Your quote</h3>
        <div id="cfgLines" class="cfg-lines">
          <p class="cfg-empty">Pick one or more frameworks to see your price.</p>
        </div>
        <div id="cfgTotalWrap" class="cfg-total-wrap" hidden>
          <div class="cfg-total-row"><span>Annual total</span><span id="cfgTotal" class="cfg-total"></span></div>
          <p class="cfg-total-note">Billed yearly in AUD, ex GST. {TRIAL_DAYS}-day free trial, cancel anytime.</p>
        </div>
        <div id="cfgCustom" class="cfg-custom" hidden>
          <p><b>Enterprise scope.</b> Starting from {fmtAud(ENTERPRISE.startingPrice)}/yr per framework ({fmtAud(ENTERPRISE.startingPriceSoc2)}/yr for SOC 2) — see the full <a href="#enterprise" style="color:#8B6820;font-weight:600;">Enterprise pricing and features</a> above. Your exact annual fee is confirmed in writing before anything is charged.</p>
          <a href={ctaUrl} class="btn btn-primary" style="width:100%;text-align:center;">Talk to us</a>
        </div>
        <a href={startUrl} id="cfgStart" class="btn btn-primary" style="width:100%;text-align:center;margin-top:1rem;" hidden>Start free trial →</a>
      </aside>
    </div>
  </div>
</section>

<!-- HOW THE TRIAL WORKS -->
<section class="section">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow" style="text-align:center;">How the free trial works</p>
    <h2 style="text-align:center;margin-bottom:2.5rem;">From sign-up to running, in minutes</h2>
    <ol class="trial-steps">
      <li><b>Pick your framework and start the trial.</b> Choose what you need above and start a {TRIAL_DAYS}-day free trial. A card secures it, but you're not charged until day {TRIAL_DAYS + 1} — cancel any time before then and you pay nothing.</li>
      <li><b>Sign in with Microsoft.</b> Checkpoint activates against your own tenant — we read your tenant ID straight from your Microsoft sign-in, so there's nothing to copy or configure by hand.</li>
      <li><b>Provisioned automatically.</b> Your Checkpoint workspace — control set, registers, evidence library — is set up inside your own SharePoint the moment you activate. Nothing is emailed, nothing is pasted.</li>
      <li><b>Run your programme.</b> Scan your posture, collect evidence continuously, and produce audit-ready reports. If it's not for you, cancel in one click.</li>
    </ol>
  </div>
</section>

<!-- GOVERNMENT / CONSULTING -->
<section class="section" style="background:#F7F4EE;">
  <div class="container" style="max-width:820px;text-align:center;">
    <p class="eyebrow">Government &amp; regulated</p>
    <h2 style="margin-bottom:0.75rem;">Some frameworks aren't self-serve — on purpose</h2>
    <p style="color:var(--muted,#555);max-width:640px;margin:0 auto 1.5rem;">
      {CONTACT_FRAMEWORKS.map((f) => f.name).join(', ').replace(/, ([^,]*)$/, ' and $1')} involve government sponsorship, security vetting and scoping that a card-and-go flow can't responsibly handle. These are delivered as a consulting-led engagement with Checkpoint included — the same tool, with us alongside you.
    </p>
    <a href={ctaUrl} class="btn btn-outline">Book a call about {CONTACT_FRAMEWORKS.map((f) => f.name).join(' / ')}</a>
  </div>
</section>

<!-- FAQ -->
<section class="section">
  <div class="container" style="max-width:760px;">
    <p class="eyebrow" style="text-align:center;">Questions</p>
    <h2 style="text-align:center;margin-bottom:2.5rem;">Pricing FAQ</h2>
    <div class="faq">
      <details>
        <summary>Is the price really per framework, per year?</summary>
        <p>Yes. Each framework is a separate annual licence. Licence two or more together and the bundle discount ({BUNDLE_DISCOUNTS.map((d) => d.label).join(', ')}) applies automatically to the combined price.</p>
      </details>
      <details>
        <summary>What happens after the {TRIAL_DAYS}-day trial?</summary>
        <p>Your card is charged the annual price on day {TRIAL_DAYS + 1} and your licence continues for the year. Cancel any time during the trial and you're never charged. Cancel after that and your licence runs to the end of the period you've paid for — we don't cut off access mid-term.</p>
      </details>
      <details>
        <summary>Where does my data live?</summary>
        <p>Entirely in your own Microsoft 365 tenant — SharePoint lists you own, in your own region. Checkpoint reads and writes there on your behalf; nothing is copied to us. That's the whole design.</p>
      </details>
      <details>
        <summary>Do I need a consultant?</summary>
        <p>No — self-serve Checkpoint is built to be run by your own team. If you'd rather have expert help, the same tool is available as a consulting-led engagement; <a href={ctaUrl} style="color:#8B6820;font-weight:600;">book a call</a> to talk it through.</p>
      </details>
      <details>
        <summary>How is GST handled?</summary>
        <p>Prices shown are ex GST. GST is applied at checkout where applicable, and your tax invoice is issued automatically by our billing provider.</p>
      </details>
      <details>
        <summary>We're over 250 staff — how does pricing and billing work?</summary>
        <p>Enterprise pricing starts from {fmtAud(ENTERPRISE.startingPrice)}/yr per framework ({fmtAud(ENTERPRISE.startingPriceSoc2)}/yr for SOC 2), billed annually and invoiced rather than charged automatically to a card — see the full <a href="#enterprise" style="color:#8B6820;font-weight:600;">Enterprise plan</a> above for what's included. Because headcount and entity count vary so much above 250 staff, we confirm your exact annual fee in a written quote first; nothing is invoiced or charged before you've agreed to that number.</p>
      </details>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="svc-final-cta">
  <CinematicBackground static />
  <div class="container">
    <h2>Start compliance today, not next quarter</h2>
    <p>Pick a framework, start your {TRIAL_DAYS}-day free trial, and be running inside your own tenant in minutes. Cancel any time.</p>
    <div class="final-buttons">
      <a href={startUrl} class="btn-hdk-primary">Start free trial</a>
      <a href={ctaUrl} class="btn-hdk-ghost">Book a call first</a>
    </div>
  </div>
</section>

<Footer />

<style>
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .price-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid #E4DFD5; border-radius: 14px;
    padding: 1.75rem 1.5rem; box-shadow: 0 2px 14px rgba(0,0,0,.04);
  }
  .price-card-premium { border-color: #A9812E; box-shadow: 0 8px 30px rgba(169,129,46,.14); position: relative; }
  .price-flag {
    position: absolute; top: -11px; left: 1.5rem;
    background: #A9812E; color: #fff; font-size: 10px; font-weight: 800;
    letter-spacing: .12em; text-transform: uppercase; padding: 4px 10px; border-radius: 5px;
  }
  .price-card h3 { margin: 0 0 .25rem; font-size: 1.35rem; }
  .price-tag-line { margin: 0 0 1.25rem; font-size: .82rem; color: #8A8172; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
  .price-tiers { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.5rem; }
  .price-tier { display: flex; align-items: baseline; gap: .5rem; }
  .pt-amount { font-size: 1.5rem; font-weight: 800; color: #0B0B0C; }
  .pt-label { font-size: .82rem; color: #8A8172; }

  /* Enterprise plan */
  .ent-card {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
    background: #fff; border: 1px solid #E4DFD5; border-radius: 14px;
    box-shadow: 0 2px 14px rgba(0,0,0,.04); overflow: hidden;
  }
  .ent-price-block { padding: 1.75rem 1.75rem; border-right: 1px solid #E4DFD5; }
  .ent-price-row { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: .25rem 1rem; padding: .7rem 0; border-bottom: 1px solid #F0ECE4; }
  .ent-price-row:first-child { padding-top: 0; }
  .ent-price-label { font-size: .9rem; color: #4b473e; font-weight: 600; }
  /* No nowrap: at narrow widths (this card is single-column under
     720px, inside a phone-width container) "From $7,500/yr per
     framework" plus its label genuinely doesn't fit one line, and
     nowrap combined with the site's overflow-x:hidden safety net was
     clipping the amount silently instead of wrapping or overflowing
     visibly — the kind of bug a scrollWidth check doesn't catch, since
     the page itself never grows past the viewport. */
  .ent-price-amount { font-size: 1.15rem; font-weight: 800; color: #0B0B0C; text-align: right; }
  .ent-price-period { font-size: .78rem; font-weight: 500; color: #8A8172; margin-left: .25rem; white-space: nowrap; }
  .ent-billing { font-size: .82rem; color: #8A8172; line-height: 1.6; margin: 1rem 0 0; }
  .ent-features-block { padding: 1.75rem 1.75rem; background: #FBF7EF; }
  .ent-features-label { font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #8A8172; margin: 0 0 1rem; }
  .ent-features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .8rem; }
  .ent-features li { position: relative; padding-left: 1.4rem; font-size: .88rem; line-height: 1.55; color: #3A3632; }
  .ent-features li::before { content: '✓'; position: absolute; left: 0; top: 0; color: #A9812E; font-weight: 800; }

  @media (max-width: 720px) {
    .ent-card { grid-template-columns: 1fr; }
    .ent-price-block { border-right: none; border-bottom: 1px solid #E4DFD5; }
  }
  @media (max-width: 420px) {
    /* Below this the label and a "From $X,XXX/yr per framework"-length
       amount don't comfortably share a row even at full card width —
       stack them so the amount gets the whole line instead of being
       squeezed. */
    .ent-price-row { flex-direction: column; align-items: flex-start; gap: .2rem; }
    .ent-price-amount { text-align: left; }
    .ent-price-block, .ent-features-block { padding: 1.5rem 1.25rem; }
  }

  /* Configurator */
  .cfg-wrap { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; align-items: start; }
  .cfg-block { margin-bottom: 1.5rem; }
  .cfg-label { display: block; font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #8A8172; margin-bottom: .6rem; }
  .cfg-tiers { display: flex; gap: 8px; flex-wrap: wrap; }
  .cfg-tier {
    flex: 1; min-width: 120px; text-align: left; cursor: pointer;
    background: #fff; border: 1.5px solid #E4DFD5; border-radius: 10px; padding: .7rem .9rem;
    display: flex; flex-direction: column; gap: 2px; transition: border-color .15s, background .15s;
  }
  .cfg-tier b { font-size: .95rem; color: #0B0B0C; }
  .cfg-tier span { font-size: .78rem; color: #8A8172; }
  .cfg-tier.on { border-color: #A9812E; background: #FBF7EF; }
  .cfg-modules { display: flex; flex-direction: column; gap: 8px; }
  .cfg-mod {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .7rem;
    background: #fff; border: 1.5px solid #E4DFD5; border-radius: 10px; padding: .7rem .9rem; cursor: pointer;
    transition: border-color .15s;
  }
  .cfg-mod:has(input:checked) { border-color: #A9812E; background: #FBF7EF; }
  .cfg-mod-input, .cfg-addon-input { width: 18px; height: 18px; accent-color: #A9812E; }
  .cfg-mod-name { font-weight: 700; color: #0B0B0C; font-size: .95rem; }
  .cfg-mod-tag { font-size: .75rem; color: #8A8172; text-align: right; }
  .cfg-summary { background: #fff; border: 1px solid #E4DFD5; border-radius: 14px; padding: 1.5rem; position: sticky; top: 1rem; }
  .cfg-lines { font-size: .9rem; }
  /* :global — these rows are injected via innerHTML at runtime, so Astro's
     scoped-style data attribute is never on them; a scoped selector
     wouldn't match. Class names are page-specific, so global is safe. */
  :global(.cfg-line) { display: flex; justify-content: space-between; gap: 1rem; padding: .4rem 0; border-bottom: 1px solid #F0ECE4; }
  :global(.cfg-line.discount) { color: #7A6A2E; font-weight: 700; }
  :global(.cfg-empty) { color: #8A8172; font-size: .9rem; margin: 0; }
  .cfg-total-wrap { margin-top: 1rem; }
  .cfg-total-row { display: flex; justify-content: space-between; align-items: baseline; font-weight: 800; font-size: 1.05rem; }
  .cfg-total { font-size: 1.6rem; color: #0B0B0C; }
  .cfg-total-note { font-size: .78rem; color: #8A8172; margin: .5rem 0 0; }
  .cfg-custom p { font-size: .9rem; }

  /* Trial steps + FAQ */
  .trial-steps { list-style: none; counter-reset: step; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .trial-steps li { counter-increment: step; position: relative; padding-left: 3rem; line-height: 1.6; }
  .trial-steps li::before {
    content: counter(step); position: absolute; left: 0; top: -2px;
    width: 2rem; height: 2rem; border-radius: 50%; background: #0B0B0C; color: #FAF7F1;
    display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .95rem;
  }
  .faq details { border-bottom: 1px solid #E4DFD5; padding: 1rem 0; }
  .faq summary { cursor: pointer; font-weight: 700; font-size: 1.05rem; color: #0B0B0C; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before { content: '+'; color: #A9812E; font-weight: 800; margin-right: .6rem; }
  .faq details[open] summary::before { content: '–'; }
  .faq p { margin: .8rem 0 0; color: #555; line-height: 1.7; }

  @media (max-width: 720px) {
    .cfg-wrap { grid-template-columns: 1fr; }
    .cfg-summary { position: static; }
  }
</style>

<script>
  import { MODULES, ADDONS, computeQuote, fmtAud, TRIAL_DAYS } from '../data/pricing.js';

  const tierBtns = Array.from(document.querySelectorAll('.cfg-tier'));
  const modInputs = Array.from(document.querySelectorAll('.cfg-mod-input'));
  const addonInputs = Array.from(document.querySelectorAll('.cfg-addon-input'));
  const linesEl = document.getElementById('cfgLines');
  const totalWrap = document.getElementById('cfgTotalWrap');
  const totalEl = document.getElementById('cfgTotal');
  const customEl = document.getElementById('cfgCustom');
  const startBtn = document.getElementById('cfgStart');

  let tier = 'micro';

  function selectedModules() { return modInputs.filter((i) => i.checked).map((i) => i.dataset.module); }
  function selectedAddons() { return addonInputs.filter((i) => i.checked).map((i) => i.dataset.addon); }

  function render() {
    const mods = selectedModules();
    const adds = selectedAddons();

    if (!mods.length && !adds.length) {
      linesEl.innerHTML = '<p class="cfg-empty">Pick one or more frameworks to see your price.</p>';
      totalWrap.hidden = true; customEl.hidden = true; startBtn.hidden = true;
      return;
    }

    const q = computeQuote(mods, adds, tier);
    let html = '';
    q.moduleLines.forEach((l) => {
      html += `<div class="cfg-line"><span>${l.name}</span><span>${l.price == null ? 'Custom' : fmtAud(l.price)}</span></div>`;
    });
    if (q.discount) {
      html += `<div class="cfg-line discount"><span>${q.discount.label}</span><span>−${fmtAud(q.discount.amount)}</span></div>`;
    }
    q.addonLines.forEach((l) => {
      html += `<div class="cfg-line"><span>${l.name} (add-on)</span><span>${fmtAud(l.price)}</span></div>`;
    });
    linesEl.innerHTML = html;

    if (q.custom) {
      totalWrap.hidden = true; startBtn.hidden = true; customEl.hidden = false;
    } else {
      customEl.hidden = true;
      totalEl.textContent = fmtAud(q.total) + '/yr';
      totalWrap.hidden = false;
      startBtn.hidden = false;
      const params = new URLSearchParams();
      if (mods.length) params.set('modules', mods.join(','));
      if (adds.length) params.set('addons', adds.join(','));
      params.set('tier', tier);
      startBtn.setAttribute('href', startBtn.getAttribute('href').split('?')[0] + '?' + params.toString());
    }
  }

  tierBtns.forEach((b) => b.addEventListener('click', () => {
    tier = b.dataset.tier;
    tierBtns.forEach((x) => x.classList.toggle('on', x === b));
    render();
  }));
  modInputs.concat(addonInputs).forEach((i) => i.addEventListener('change', render));
  render();
</script>
</Base>
