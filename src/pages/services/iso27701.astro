---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const ctaLabel = 'Book a call';

// JSON-LD (Service + FAQ)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO 27701 (Privacy) Consulting – Australia',
  serviceType: 'ISO 27701 PIMS',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/iso27701',
  description:
    'ISO 27701 privacy extension — DPIAs, ROPAs, rights handling, third-party clauses — with audit-ready evidence automated in Microsoft 365 & SharePoint.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is ISO 27701?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 27701 extends ISO 27001 with privacy-specific controls to build a Privacy Information Management System (PIMS) — helping you protect personal data and prove it.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need a new privacy tool?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We embed privacy workflows, DPIAs, ROPAs and evidence directly into your existing Microsoft 365 tools — SharePoint, Forms, Teams, etc.'
      }
    },
    {
      '@type': 'Question',
      name: 'How long does ISO 27701 take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most teams extend an existing ISO 27001 to ISO 27701 in 6–10 weeks. We focus on practical mapping and automation to keep it fast and low-friction.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can you help with privacy audits or customer questions?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — we prepare evidence packs, support privacy assessor Q&A, coach your team, and give you reusable answers that calm procurement and customer concerns.'
      }
    }
  ]
};
---

<Base
  title="ISO 27701 (Privacy) – Fast PIMS Extension for Australian Teams | Compliance365"
  description="Add ISO 27701 privacy to your ISO 27001 — DPIAs, ROPAs, rights handling, third-party clauses — in weeks, inside Microsoft 365, with automated evidence."
  schema={[serviceLd, faqLd]}
>
  <Header />

  <!-- HERO – Business-first, impactful intro -->
  <section class="hero-wrap">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h1>ISO 27701 Privacy – Done Fast & Right</h1>
          <p class="section-lead muted">
            Extend your security into privacy — DPIAs, ROPAs, rights handling, third-party clauses — without new tools or months of delays.
          </p>
          <p class="muted">
            Customers and procurement teams want proof you protect personal data. ISO 27701 gives you that proof — quickly, credibly, and inside your existing Microsoft 365 environment.
          </p>

          <div class="pill-row" style="margin:1.5rem 0;">
            <span class="pill brand">6–10 weeks</span>
            <span class="pill">No new tools</span>
            <span class="pill">Automated evidence</span>
            <span class="pill">Customer-ready</span>
          </div>

          <div class="hero-ctas" style="margin-top:2rem;">
            <a href={ctaUrl} class="btn btn-primary large">{ctaLabel}</a>
            <a href={`${base}checklist/iso27701`} class="btn btn-outline">Free Privacy Readiness Score</a>
          </div>
        </div>

        <div>
          <img
            src={`${base}assets/illus-iso27001.svg`}
            alt="ISO 27701 privacy evidence automated in Microsoft 365 SharePoint"
            class="cover-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHY ISO 27701 MATTERS TO YOUR BUSINESS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Why ISO 27701 Matters to Your Business</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        In today’s world, customers, partners and procurement teams expect strong privacy practices. ISO 27701 proves you protect personal data — helping you win trust and close deals faster.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Win More Deals</h3>
          <p class="muted small">
            Show clients you handle personal data responsibly — often a requirement for enterprise, healthcare and government contracts in Australia.
          </p>
        </div>
        <div class="card feature center">
          <h3>Reduce Privacy Risk</h3>
          <p class="muted small">
            Spot and fix privacy gaps before they become breaches, fines, or reputational damage.
          </p>
        </div>
        <div class="card feature center">
          <h3>Simplify Future Compliance</h3>
          <p class="muted small">
            One framework covers overlapping needs — Australian Privacy Principles, GDPR, HIPAA — without starting from scratch every time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON PRIVACY FEARS WE SOLVE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Common Privacy Fears We Solve</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        We help teams overcome the same concerns — unclear obligations, customer pressure, audit delays, and fear of getting it wrong.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>“We don’t know where to start”</h3>
          <p class="muted small">
            We map your current processes, identify quick wins, and build a clear privacy roadmap — no guesswork.
          </p>
        </div>
        <div class="card feature center">
          <h3>“Customers keep asking for proof”</h3>
          <p class="muted small">
            Ready-to-share DPIAs, ROPAs, and rights-handling logs — stored in SharePoint so you answer in minutes, not weeks.
          </p>
        </div>
        <div class="card feature center">
          <h3>“We’re worried about delays”</h3>
          <p class="muted small">
            Automated workflows and evidence mean procurement gates open faster — no months of back-and-forth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section">
    <div class="container">
      <h2 class="center">What You Get with ISO 27701 Support</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>DPIA Framework</h3>
          <p class="muted small">
            Screening, templates, routing and approvals — embedded in your daily processes.
          </p>
        </div>
        <div class="card feature center">
          <h3>ROPA & Data Lifecycle</h3>
          <p class="muted small">
            Records of processing, retention, deletion and minimisation — all automated.
          </p>
        </div>
        <div class="card feature center">
          <h3>Rights Handling</h3>
          <p class="muted small">
            Access, correction, erasure requests — tracked, fulfilled and evidenced in SharePoint.
          </p>
        </div>
        <div class="card feature center">
          <h3>Third-Party Management</h3>
          <p class="muted small">
            Due diligence, DPAs, sub-processor approvals and ongoing monitoring.
          </p>
        </div>
        <div class="card feature center">
          <h3>Privacy Training & Awareness</h3>
          <p class="muted small">
            Role-based content, onboarding and annual refreshers — delivered in Teams.
          </p>
        </div>
        <div class="card feature center">
          <h3>Audit-Ready Evidence</h3>
          <p class="muted small">
            Live logs, screenshots and exports — mapped directly to ISO 27701 controls.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Typical ISO 27701 Timeline</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Fast, focused, and built around your team — not the other way around.
      </p>

      <div class="grid-4" style="margin-top:3rem;">
        <div class="card feature center">
          <h3>Weeks 1–2</h3>
          <p class="muted small">Gap assessment + privacy roadmap</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 3–5</h3>
          <p class="muted small">DPIAs, ROPAs, rights workflows & controls</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 6–7</h3>
          <p class="muted small">Internal privacy review + fixes</p>
        </div>
        <div class="card feature center">
          <h3>Weeks 8–10</h3>
          <p class="muted small">Final prep + external audit support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">ISO 27701 FAQs</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card">
          <h3>How long does it take?</h3>
          <p class="muted">
            Most teams extend an existing ISO 27001 to ISO 27701 in <strong>6–10 weeks</strong> — faster when we automate evidence.
          </p>
        </div>
        <div class="card">
          <h3>Do we need a new platform?</h3>
          <p class="muted">
            <strong>No.</strong> Privacy workflows and evidence live in your existing Microsoft 365 tools — SharePoint, Forms, Teams.
          </p>
        </div>
        <div class="card">
          <h3>Can you help with privacy audits or customer questions?</h3>
          <p class="muted">
            Yes — we prepare evidence packs, support privacy assessor Q&A, coach your team, and give you reusable answers that calm procurement and customers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="section" style="background:#f8fafc;">
    <div class="container center">
      <h2>Related Services</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        Build on ISO 27701 with stronger security, AI governance or other frameworks — all inside the same environment.
      </p>

      <div class="pill-row" style="justify-content:center;">
        <a class="pill" href="/services/iso27001">ISO 27001 (Security)</a>
        <a class="pill" href="/services/iso42001">ISO 42001 (AI)</a>
        <a class="pill" href="/services/soc2">SOC 2</a>
        <a class="pill" href="/services/essential-eight">Essential Eight</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA – Matching Home page blue -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:8rem 0;">
    <div class="container">
      <h2>Ready to Add Privacy Confidence Fast?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:760px;margin:1.5rem auto;">
        Book a free 30-minute call — we’ll show you how to extend privacy controls, automate evidence, and open procurement gates faster.
      </p>

      <div class="final-buttons" style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:2.5rem;">
        <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Book Free Call Now
        </a>
        <a href={`${base}checklist/iso27701`} class="btn btn-outline large" style="color:white;border-color:white;font-size:1.25rem;padding:1.2rem 2.8rem;">
          Free Privacy Readiness Score
        </a>
      </div>

      <p class="muted small" style="margin-top:2rem;color:rgba(255,255,255,0.8);">
        Most teams extend privacy in under 10 weeks.
      </p>
    </div>
  </section>

  <Footer />
</Base>
