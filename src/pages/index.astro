          </blockquote>
          <figcaption>
            <div class="t-avatar t-initial" aria-hidden="true">H</div>
            <div>
              <strong>Health SaaS</strong> — COO<br/>
              <span class="muted small">ISO 42001 • model inventory & oversight</span>
            </div>
          </figcaption>
        </figure>

        <!-- Slide 3 -->
        <figure class="t-slide">
          <blockquote>
            <svg class="t-quote" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 11h3V5H5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3zm9 0h3V5h-5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3z" fill="currentColor"/>
            </svg>
