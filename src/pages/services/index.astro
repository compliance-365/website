---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

const services = [
  {
    title: 'ISO 27001',
    subtitle: 'Information Security Management',
    summary: 'The baseline certification most enterprise, government, and procurement panels require. Gap analysis, risk treatment, SoA, and audit-ready evidence — all automated in Microsoft 365.',
    url: `${base}services/iso27001`,
    image: `${base}assets/illus-iso27001.svg`,
    tags: ['Gap analysis', 'SoA', 'Risk treatment'],
    best_for: 'SaaS, technology, enterprise supply chain'
  },
  {
    title: 'Essential Eight',
    subtitle: 'ASD Cyber Security Uplift',
    summary: 'Australia\'s baseline cyber security framework — all eight controls assessed, implemented, and evidenced to ML2. Fixed-price, milestone-gated, Microsoft 365-native.',
    url: `${base}services/essential-eight`,
    image: `${base}assets/illus-essential-eight.svg`,
    tags: ['ML2 uplift', 'MFA', 'App control', 'Patch governance'],
    best_for: 'Government supply chain, mid-market, regulated sectors'
  },
  {
    title: 'IS18 (QGEA)',
    subtitle: 'Queensland Government Information Security',
    summary: 'IS18:2018 delivered as what it actually is — an ISO 27001-aligned ISMS plus Essential Eight, plus QGISCF classification, CSU incident reporting, and the accountable officer\'s 30 September annual return. Everything stays inside your own tenant.',
    url: `${base}services/is18`,
    image: `${base}assets/illus-disp-ism-irap.svg`,
    tags: ['QGEA', 'Annual return', 'Essential Eight', 'QGISCF'],
    best_for: 'QLD Government agencies, statutory bodies, ICT suppliers'
  },
  {
    title: 'RFFR (Right Fit For Risk)',
    subtitle: 'DEWR Cyber Security Accreditation',
    summary: 'Right Fit For Risk for Employment Services providers — the full ISM Statement of Applicability (989 controls + 7 program-deed obligations) delivered on an ISO 27001 ISMS with Essential Eight uplift. Nearly a third of the SoA assessed automatically from your Microsoft 365 tenant.',
    url: `${base}services/rffr`,
    image: `${base}assets/illus-disp-ism-irap.svg`,
    tags: ['ISM SoA', 'DEWR', 'ISO 27001 ISMS', 'Essential Eight'],
    best_for: 'Workforce Australia, DES, and other DEWR program providers'
  },
  {
    title: 'ISO 42001',
    subtitle: 'AI Governance &amp; Management System',
    summary: 'Model inventory, AI risk assessments, human oversight, and monitoring — built inside your existing Microsoft 365 stack. Aligned to the Australian AI Safety Standard and EU AI Act.',
    url: `${base}services/iso42001`,
    image: `${base}assets/illus-iso27001.svg`,
    tags: ['AI risk', 'Model inventory', 'Oversight'],
    best_for: 'AI-enabled SaaS, healthcare, financial services'
  },
  {
    title: 'SOC 2 Readiness',
    subtitle: 'Type I &amp; Type II',
    summary: 'Trust Services Criteria mapped to your systems. Type I and Type II readiness with reusable, automated evidence that unlocks US and global enterprise contracts.',
    url: `${base}services/soc2`,
    image: `${base}assets/illus-soc2.svg`,
    tags: ['Type I', 'Type II', 'Trust Services Criteria'],
    best_for: 'SaaS with US or global enterprise customers'
  },
  {
    title: 'ISO 27701',
    subtitle: 'Privacy Information Management',
    summary: 'Extends ISO 27001 into privacy. DPIAs, ROPAs, data rights workflows, and third-party privacy risk — streamlined inside Microsoft 365 without a third-party platform. Aligned to the Australian Privacy Act.',
    url: `${base}services/iso27701`,
    image: `${base}assets/illus-iso27001.svg`,
    tags: ['DPIA', 'ROPA', 'Privacy Act'],
    best_for: 'Healthcare, financial services, data-intensive businesses'
  },
  {
    title: 'DISP / ISM / IRAP',
    subtitle: 'Defence &amp; Government Security',
    summary: 'Defence Industry Security Programme, Information Security Manual, and IRAP readiness. Map your existing Microsoft E5 stack to ASD and ISM requirements and get government panel-ready.',
    url: `${base}services/disp-ism-irap`,
    image: `${base}assets/illus-disp-ism-irap.svg`,
    tags: ['DISP', 'ISM', 'IRAP', 'ASD'],
    best_for: 'Defence contractors, government-adjacent technology firms'
  },
  {
    title: 'NIST CSF',
    subtitle: 'Cybersecurity Framework',
    summary: 'Align to NIST CSF (Identify → Protect → Detect → Respond → Recover) — mapped to ISO 27001 and Essential Eight so work overlaps rather than duplicates.',
    url: `${base}services/nist-csf`,
    image: `${base}assets/illus-nist-csf.svg`,
    tags: ['NIST CSF', 'ISO 27001 mapping', 'Essential Eight mapping'],
    best_for: 'US-aligned organisations, multi-framework programmes'
  }
];

// JSON-LD
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Compliance365 — Services',
  url: 'https://www.compliance365.com.au/services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://www.compliance365.com.au${s.url}`
  }))
};
---
<Base
  title="Compliance Services — ISO 27001, Essential Eight, SOC 2, ISO 42001 | Compliance365"
  description="Senior-led cyber, privacy, and AI governance consulting for Australian organisations. ISO 27001, Essential Eight, ISO 42001, SOC 2, DISP/IRAP — fixed-price, Microsoft 365-native delivery."
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero" style="text-align:center;">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <h1>Compliance services for Australian organisations</h1>
      <p class="section-lead" style="max-width:760px;margin-left:auto;margin-right:auto;">
        Every engagement is delivered by a senior practitioner, fixed-price, with audit-ready evidence at every milestone — inside your existing Microsoft 365 environment, on Checkpoint, our own console included in the engagement. No third-party platform, no junior staff, no surprises.
      </p>
      <ul class="trust-signals" style="margin-left:auto;margin-right:auto;">
        <li>Fixed-price delivery</li>
        <li>Microsoft 365 native</li>
        <li>Senior-led</li>
        <li>All major frameworks</li>
      </ul>
    </div>
  </section>

  <!-- FRAMEWORK FINDER (instant, rule-based) -->
  <section class="section reveal-section" id="finder" style="background:#FAF7F1;" data-base={base} data-cta={ctaUrl}>
    <div class="container">
      <div class="finder">
        <div class="gold-rule-26"></div>
        <p class="finder-eyebrow">Not sure where to start?</p>
        <h2 style="color:#0B0B0C;">Answer three questions. Get your framework.</h2>
        <div>
          <div class="q-label">Your primary sector</div>
          <div class="f-opts" data-f="sector"><span class="f-opt">SaaS / Technology</span><span class="f-opt">Government-adjacent</span><span class="f-opt">Defence / Aerospace</span><span class="f-opt">Healthcare</span><span class="f-opt">Finance / Fintech</span><span class="f-opt">Other</span></div>
          <div class="q-label">What's driving this?</div>
          <div class="f-opts" data-f="driver"><span class="f-opt">Customer requires certification</span><span class="f-opt">Defence / government contract</span><span class="f-opt">Regulatory obligation</span><span class="f-opt">We use AI — need governance</span><span class="f-opt">Sensitive personal data</span><span class="f-opt">Proactive uplift</span></div>
          <div class="q-label">Your primary customers</div>
          <div class="f-opts" data-f="customers"><span class="f-opt">Australian enterprise</span><span class="f-opt">Australian government</span><span class="f-opt">US / global enterprise</span><span class="f-opt">Healthcare systems</span><span class="f-opt">Defence primes</span><span class="f-opt">Internal / B2C</span></div>
        </div>
        <div class="finder-result" id="finderResult">
          <div class="fr-tag">Recommended for you</div>
          <h3 id="frName"></h3>
          <p id="frWhy"></p>
          <p class="fr-pair" id="frPair"></p>
          <div style="margin-top:24px;display:flex;gap:14px;flex-wrap:wrap;">
            <a class="btn btn-primary" id="frLink" href={`${base}services/iso27001/`}>Explore this path →</a>
            <a class="btn btn-outline" href={ctaUrl}>Confirm on a free call</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <style is:global>
    .finder{max-width:900px;margin:0 auto}
    .finder-eyebrow{font-family:Manrope,system-ui,sans-serif;font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#A9812E;font-weight:700;margin:0 0 20px}
    .q-label{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(11,11,12,.6);font-weight:700;margin:26px 0 10px;font-family:Manrope,system-ui,sans-serif}
    .f-opts{display:flex;flex-wrap:wrap;gap:8px}
    .f-opt{border:1px solid rgba(11,11,12,.12);border-radius:3px;padding:9px 16px;font-size:13px;color:rgba(11,11,12,.7);cursor:pointer;transition:all .2s var(--ease,cubic-bezier(.22,1,.36,1));user-select:none;font-family:Manrope,system-ui,sans-serif}
    .f-opt:hover{border-color:#A9812E;color:#0B0B0C}
    .f-opt.sel{background:#A9812E;border-color:#A9812E;color:#FAF7F1;font-weight:700}
    .finder-result{margin-top:34px;background:#0B0B0C;color:#FAF7F1;border:1px solid rgba(216,186,120,.35);border-radius:8px;padding:34px 36px;box-shadow:0 30px 60px rgba(0,0,0,.25);opacity:0;transform:translateY(12px);transition:opacity .6s var(--ease,cubic-bezier(.22,1,.36,1)),transform .6s var(--ease,cubic-bezier(.22,1,.36,1));pointer-events:none}
    .finder-result.show{opacity:1;transform:none;pointer-events:auto}
    .finder-result .fr-tag{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#A9812E;font-weight:700;font-family:Manrope,system-ui,sans-serif}
    .finder-result h3{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:clamp(1.5rem,2.8vw,2.1rem);margin:10px 0 0;color:#FAF7F1}
    .finder-result p{margin:12px 0 0;font-size:14px;line-height:1.75;color:rgba(250,247,241,.62);max-width:64ch}
    .finder-result .fr-pair{margin-top:16px;font-size:12px}
    .finder-result .fr-pair b{color:#D8BA78}
  </style>

  <!-- FRAMEWORK EXPLORER -->
  <section class="section reveal-section" id="frameworks" style="background:#0B0B0C;" data-base={base}>
    <div class="container">
      <div class="gold-rule-26"></div>
      <p class="exp-eyebrow">Frameworks we deliver</p>
      <h2 style="color:#FAF7F1;max-width:26ch;">Seven frameworks. One evidence set. Zero duplicated effort.</h2>
      <p style="color:rgba(250,247,241,.62);max-width:640px;margin:18px 0 0;font-size:15px;line-height:1.75;">Every framework is delivered with the same methodology and evidence infrastructure — so when you need more than one, the work overlaps rather than duplicates. Select a framework to see how it runs.</p>

      <div class="explorer">
        <div class="exp-rail" id="expRail"></div>
        <div class="exp-panel">
          <div class="exp-body" id="expBody">
            <h3 id="expTitle"></h3>
            <p class="exp-who" id="expWho"></p>
            <div class="tl">
              <div class="tl-cap"><span>Typical engagement</span><b id="expWeeks"></b></div>
              <div class="tl-track"><div class="tl-fill" id="expBar"></div></div>
            </div>
            <div class="exp-cols">
              <div><h4>What you get</h4><ul id="expDeliver"></ul></div>
              <div><h4>Shared controls with</h4><div id="expOverlap"></div></div>
            </div>
            <a class="exp-cta" id="expLink" href={`${base}services/iso27001/`}>Explore this framework →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <style is:global>
    .exp-eyebrow{font-family:Manrope,system-ui,sans-serif;font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#A9812E;font-weight:700;margin:0 0 20px}
    .explorer{display:grid;grid-template-columns:255px 1fr;border-radius:8px;overflow:hidden;margin-top:54px;background:#141416;color:#FAF7F1;box-shadow:0 30px 60px rgba(0,0,0,.22)}
    @media(max-width:860px){.explorer{grid-template-columns:1fr}}
    .exp-rail{border-right:1px solid rgba(255,255,255,.14);display:flex;flex-direction:column}
    @media(max-width:860px){.exp-rail{flex-direction:row;overflow-x:auto;border-right:none;border-bottom:1px solid rgba(255,255,255,.14)}}
    .exp-tab{background:none;border:none;border-bottom:1px solid rgba(255,255,255,.14);color:rgba(250,247,241,.62);font-family:Manrope,system-ui,sans-serif;font-size:13px;text-align:left;padding:17px 22px;cursor:pointer;transition:color .2s var(--ease,cubic-bezier(.22,1,.36,1)),background .2s var(--ease,cubic-bezier(.22,1,.36,1));display:flex;align-items:center;gap:10px;white-space:nowrap}
    .exp-tab:hover{color:#FAF7F1}
    .exp-tab.on{color:#FAF7F1;background:#0B0B0C;box-shadow:inset 3px 0 0 #A9812E}
    .exp-tab .exp-tag{font-size:8.5px;letter-spacing:.12em;color:#A9812E;border:1px solid rgba(169,129,46,.5);border-radius:3px;padding:2px 6px;font-weight:700}
    .exp-panel{padding:clamp(28px,4vw,48px);min-height:430px}
    .exp-body{opacity:1;transition:opacity .25s var(--ease,cubic-bezier(.22,1,.36,1))}
    .exp-body.fade{opacity:0}
    .exp-panel h3{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:clamp(1.5rem,2.6vw,2.1rem);color:#FAF7F1;margin:0}
    .exp-who{margin-top:10px;font-size:13.5px;color:rgba(250,247,241,.62);line-height:1.7;max-width:60ch}
    .exp-who strong{color:#D8BA78;font-weight:700}
    .tl{margin-top:28px}
    .tl-cap{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:rgba(250,247,241,.62);font-weight:700;margin-bottom:8px;font-family:Manrope,system-ui,sans-serif}
    .tl-cap b{color:#D8BA78;font-variant-numeric:tabular-nums}
    .tl-track{height:7px;background:rgba(250,247,241,.1);border-radius:99px;overflow:hidden}
    .tl-fill{height:100%;width:0;background:linear-gradient(90deg,#A9812E,#D8BA78);border-radius:99px;transition:width 1s var(--ease,cubic-bezier(.22,1,.36,1))}
    .exp-cols{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:30px}
    @media(max-width:700px){.exp-cols{grid-template-columns:1fr}}
    .exp-cols h4{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#A9812E;font-weight:700;margin:0 0 12px;font-family:Manrope,system-ui,sans-serif}
    .exp-cols ul{list-style:none;margin:0;padding:0}
    .exp-cols li{font-size:13px;color:rgba(250,247,241,.62);line-height:1.6;padding:8px 0 8px 20px;border-bottom:1px solid rgba(255,255,255,.14);position:relative}
    .exp-cols li:last-child{border-bottom:none}
    .exp-cols li::before{content:"";position:absolute;left:0;top:14px;width:8px;height:8px;border:1px solid #A9812E;border-radius:50%}
    .overlap-chip{display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.14);font-size:12.5px;color:rgba(250,247,241,.62)}
    .overlap-chip:last-child{border-bottom:none}
    .overlap-bar{flex:1;height:4px;background:rgba(250,247,241,.1);border-radius:99px;overflow:hidden}
    .overlap-bar i{display:block;height:100%;width:0;background:#A9812E;transition:width .9s var(--ease,cubic-bezier(.22,1,.36,1))}
    .overlap-chip b{color:#D8BA78;font-weight:800;font-size:12px;min-width:34px;text-align:right;font-family:Manrope,system-ui,sans-serif;font-variant-numeric:tabular-nums}
    .exp-cta{display:inline-block;margin-top:30px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#D8BA78;text-decoration:none;font-weight:700;border-bottom:1px solid rgba(216,186,120,.4);padding-bottom:4px;font-family:Manrope,system-ui,sans-serif}
  </style>

  <!-- HOW TO CHOOSE -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">Prefer a quick static guide?</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Most organisations come to us with a specific trigger — a customer requirement, a contract condition, an insurer question, or a failed audit. Use this as a guide, or <a href={ctaUrl} style="color:#A9812E;font-weight:600;">book a free 30-min call</a> and we'll tell you exactly what you need.
      </p>

      <div class="grid-2" style="margin-top:3rem;max-width:900px;margin-left:auto;margin-right:auto;gap:1.5rem;">
        <div class="card spot">
          <strong>Enterprise or government customers are requiring security certification</strong>
          <p class="muted small" style="margin-top:0.5rem;">&rarr; Start with <a href={`${base}services/iso27001/`} style="color:#A9812E;">ISO 27001</a>. If they're US-based, add <a href={`${base}services/soc2/`} style="color:#A9812E;">SOC 2</a>.</p>
        </div>
        <div class="card spot">
          <strong>A government contract or tender requires Essential Eight maturity</strong>
          <p class="muted small" style="margin-top:0.5rem;">&rarr; <a href={`${base}services/essential-eight/`} style="color:#A9812E;">Essential Eight uplift</a> — assessed, implemented to ML2, evidenced.</p>
        </div>
        <div class="card spot">
          <strong>Your cyber insurer is asking for evidence of controls at renewal</strong>
          <p class="muted small" style="margin-top:0.5rem;">&rarr; <a href={`${base}services/essential-eight/`} style="color:#A9812E;">Essential Eight assessment</a> first, then targeted uplift on the gaps they care about.</p>
        </div>
        <div class="card spot">
          <strong>You use AI and customers or regulators are asking how you govern it</strong>
          <p class="muted small" style="margin-top:0.5rem;">&rarr; <a href={`${base}services/iso42001/`} style="color:#A9812E;">ISO 42001</a> — model inventory, risk assessments, human oversight, audit-ready evidence.</p>
        </div>
        <div class="card spot">
          <strong>You handle personal data and need to demonstrate Privacy Act compliance</strong>
          <p class="muted small" style="margin-top:0.5rem;">&rarr; <a href={`${base}services/iso27701/`} style="color:#A9812E;">ISO 27701</a> — DPIAs, ROPAs, data rights workflows, built on top of ISO 27001.</p>
        </div>
        <div class="card spot">
          <strong>You want to enter the defence industry or achieve DISP / IRAP clearance</strong>
          <p class="muted small" style="margin-top:0.5rem;">&rarr; <a href={`${base}services/disp-ism-irap/`} style="color:#A9812E;">DISP / ISM / IRAP</a> — mapped to your Microsoft E5 environment.</p>
        </div>
      </div>

      <p class="muted center" style="margin-top:2rem;font-style:italic;">
        Need more than one? Most mid-market programmes combine 2–3 frameworks — <a href={ctaUrl} style="color:#A9812E;font-weight:600;">we scope them together</a> so the work overlaps rather than duplicates.
      </p>
    </div>
  </section>

  <!-- SERVICE CARDS -->
  <section class="section">
    <div class="container">
      <h2 class="center">All services</h2>

      <div class="grid-3" style="margin-top:3rem;">
        {services.map(s => (
          <a href={s.url} class="card spot" style="text-decoration:none;display:flex;flex-direction:column;">
            <img src={s.image} alt={`${s.title} compliance consulting`} style="height:64px;width:auto;margin-bottom:1rem;object-fit:contain;align-self:flex-start;" loading="lazy" />
            <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1px;color:#A9812E;font-weight:700;margin-bottom:0.4rem;">{s.subtitle}</div>
            <h3 style="margin:0 0 0.75rem;">{s.title}</h3>
            <p class="muted small" style="flex:1;" set:html={s.summary} />
            <div class="pill-row" style="margin:1rem 0 0.75rem;flex-wrap:wrap;gap:0.4rem;">
              {s.tags.map(t => <span class="pill" style="font-size:0.7rem;padding:2px 8px;">{t}</span>)}
            </div>
            <div style="font-size:0.8rem;color:#6b7280;margin-bottom:1rem;"><strong>Best for:</strong> {s.best_for}</div>
            <span style="color:#A9812E;font-weight:600;font-size:0.9rem;margin-top:auto;">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Not sure where to start?</h2>
      <p>
        A free 30-minute call will tell you which framework fits your situation, what the fastest path looks like, and what it's likely to cost. No obligation.
      </p>
      <div class="final-buttons">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free call</a>
        <a href={`${base}checklist/`} class="btn-hdk-ghost">Free readiness score</a>
      </div>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />

  <style is:global>
    :root { --ease: cubic-bezier(.22,1,.36,1); }
    .reveal-section { opacity: 0; transform: translateY(20px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    .reveal-section.is-visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .reveal-section { opacity: 1; transform: none; transition: none; } }
  </style>

  <script is:inline>
  (function () {
    var sections = document.querySelectorAll('.reveal-section');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    sections.forEach(function (s) { io.observe(s); });

    /* ── Framework explorer ── */
    (function () {
      var rail = document.getElementById('expRail');
      if (!rail) return;
      var frameworksSection = document.getElementById('frameworks');
      var BASE = frameworksSection.dataset.base || '/';
      var DATA = {
        'ISO 27001': { tag: null, who: 'Information security management — the baseline certification <strong>enterprise and government procurement</strong> requires before contracts are signed.', min: 8, max: 12,
          deliver: ['Gap analysis & prioritised roadmap', 'Risk treatment plan & Statement of Applicability', 'Evidence automation in SharePoint & Power BI', 'Full external certification support'],
          overlap: [['SOC 2', 70], ['Essential Eight', 55], ['ISO 27701', 85]], u: BASE + 'services/iso27001/' },
        'SOC 2': { tag: null, who: 'Trust Services Criteria mapped to your systems. The certification <strong>US and global enterprise buyers</strong> require before signing SaaS contracts.', min: 6, max: 10,
          deliver: ['Type I & Type II readiness', 'TSC mapped to existing M365 controls', 'Reusable, automated evidence packs', 'Auditor liaison end-to-end'],
          overlap: [['ISO 27001', 70], ['Essential Eight', 45]], u: BASE + 'services/soc2/' },
        'Essential Eight': { tag: null, who: "ASD's eight controls assessed and uplifted to ML2. <strong>Mandatory for Commonwealth entities</strong>, increasingly demanded across government supply chains.", min: 6, max: 10,
          deliver: ['Maturity assessment against ASD model', 'Uplift via Intune & Defender — no third-party tooling', 'ASD-aligned evidence packs', 'Milestone-gated fixed pricing'],
          overlap: [['ISO 27001', 55], ['DISP / IRAP', 65]], u: BASE + 'services/essential-eight/' },
