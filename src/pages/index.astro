---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// URLs used in the hero
const ctaUrl       = 'https://calendly.com/matt-nicholas-compliance365/30min';
const resourcesUrl = base + 'resources';

// SEO helpers for JSON-LD
const org = {
  '@type': 'Organization',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  logo: 'https://www.compliance365.com.au/assets/og-default.png',
  sameAs: ['https://www.linkedin.com/company/compliance-365/']
};

const siteLd = {
  '@type': 'WebSite',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.compliance365.com.au/search?q={query}',
    'query-input': 'required name=query'
  }
};

const servicesLd = [
  { name: 'ISO 27001 Certification Support',       url: 'https://www.compliance365.com.au/services/iso27001' },
  { name: 'ISO 27701 Privacy (PIMS)',              url: 'https://www.compliance365.com.au/services/iso27701' },
  { name: 'ISO 42001 AI Governance (AIMS)',        url: 'https://www.compliance365.com.au/services/iso42001' },
  { name: 'SOC 2 Readiness',                       url: 'https://www.compliance365.com.au/services/soc2' },
  { name: 'Essential Eight Uplift',                url: 'https://www.compliance365.com.au/services/essential-eight' },
  { name: 'DISP / ISM / IRAP',                     url: 'https://www.compliance365.com.au/services/disp-ism-irap' }
].map(s => ({ '@type':'Service', serviceType:s.name, provider:{ '@type':'Organization', name:'Compliance365' }, url:s.url }));

const ld = {
  '@context': 'https://schema.org',
  '@graph': [org, siteLd, ...servicesLd]
};
