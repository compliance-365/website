---
interface Props {
  heading?: string;
  subtext?: string;
  source?: string;
}

const {
  heading = 'Get the monthly Australian compliance digest',
  subtext = 'Practical updates on ISO 27001, Essential Eight, Privacy Act and AI governance — delivered once a month. No spam, unsubscribe any time.',
  source = 'blog-digest',
} = Astro.props;

const formId = `digest-form-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="digest-wrap">
  <div class="digest-inner">
    <div class="digest-text">
      <p class="digest-label">Free monthly digest</p>
      <h3 class="digest-heading">{heading}</h3>
      <p class="digest-sub">{subtext}</p>
    </div>

    <div class="digest-form-wrap">
      <form id={formId} class="digest-form" novalidate>
        <input type="hidden" name="source" value={source} />

        <div class="digest-fields">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="digest-input"
            aria-label="Email address"
          />
          <button type="submit" class="btn btn-primary digest-btn">
            Subscribe free
          </button>
        </div>
        <p class="digest-privacy">
          No spam. Unsubscribe any time. We never share your email.
        </p>
      </form>
      <div id={`${formId}-success`} class="digest-success" style="display:none;">
        <span class="digest-tick">✓</span>
        <div>
          <strong>You're subscribed!</strong>
          <p>Check your inbox — first issue arrives next month.</p>
        </div>
      </div>
      <div id={`${formId}-error`} class="digest-error" style="display:none;">
        Something went wrong — please try again or email <a href="mailto:info@compliance365.com.au">info@compliance365.com.au</a>.
      </div>
    </div>
  </div>
</div>

<script define:vars={{ formId }}>
(function () {
  const SUBSCRIBE_URL = 'https://uclqeiwzgi.execute-api.ap-southeast-2.amazonaws.com/NewDeploy/subscribe';

  const form = document.getElementById(formId);
  if (!form) return;

  const successEl = document.getElementById(formId + '-success');
  const errorEl = document.getElementById(formId + '-error');

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const emailInput = form.querySelector('input[name="email"]');
    const sourceInput = form.querySelector('input[name="source"]');

    const email = emailInput ? emailInput.value.trim() : '';
    const source = sourceInput ? sourceInput.value : 'blog-digest';

    if (!email || !email.includes('@')) {
      emailInput && (emailInput.style.borderColor = '#ef4444');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Subscribing…';

    try {
      const res = await fetch(SUBSCRIBE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source }),
      });

      if (!res.ok) throw new Error('Non-200');

      form.style.display = 'none';
      if (successEl) successEl.style.display = 'flex';
      if (errorEl) errorEl.style.display = 'none';

      // Every other conversion action on the site fires a GA4 event
      // (checklist_completed, contact_form_submit, free_roadmap_signup,
      // ...) so it can be marked a conversion and imported into Google
      // Ads — a successful subscribe here was the one exception.
      try {
        if (typeof gtag === 'function') gtag('event', 'newsletter_signup', { source: source, page_location: window.location.href });
      } catch (_) {}
    } catch (_) {
      btn.disabled = false;
      btn.textContent = 'Subscribe free';
      if (errorEl) errorEl.style.display = 'block';
    }
  });
})();
</script>

<style>
  .digest-wrap {
    background: linear-gradient(135deg, rgba(169,129,46,0.06) 0%, #f0f9ff 100%);
    border: 1px solid rgba(169,129,46,0.15);
    border-radius: 16px;
    padding: 2rem 2.5rem;
    margin: 2.5rem 0;
  }
  .digest-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .digest-label {
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--gold-ink);
    margin: 0 0 8px;
  }
  .digest-heading {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0B0B0C;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .digest-sub {
    font-size: .875rem;
    color: #6B6860;
    margin: 0;
    line-height: 1.6;
  }
  .digest-fields {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .digest-input {
    flex: 1;
    min-width: 180px;
    padding: 10px 14px;
    border: 1px solid #C8C3B8;
    border-radius: 8px;
    font-size: .9rem;
    font-family: inherit;
    outline: none;
    transition: border-color .15s;
    background: #fff;
  }
  .digest-input:focus { border-color: #A9812E; box-shadow: 0 0 0 3px rgba(169,129,46,.1); }
  .digest-btn { border-radius: 8px; padding: 10px 18px; font-size: .9rem; white-space: nowrap; }
  .digest-privacy {
    font-size: .72rem;
    color: #6B6860;
    margin: 8px 0 0;
  }
  .digest-success {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 10px;
  }
  .digest-success strong { color: #166534; font-size: .95rem; }
  .digest-success p { color: #15803d; font-size: .82rem; margin: 4px 0 0; }
  .digest-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    min-width: 28px;
    background: #22c55e;
    color: #fff;
    border-radius: 50%;
    font-size: 14px;
    font-weight: 900;
    flex-shrink: 0;
  }
  .digest-error {
    font-size: .82rem;
    color: #991b1b;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 10px 14px;
    margin-top: 8px;
  }
  .digest-error a { color: #991b1b; }
  @media (max-width: 680px) {
    .digest-inner { grid-template-columns: 1fr; gap: 1.25rem; }
    .digest-wrap { padding: 1.5rem; }
  }
</style>
