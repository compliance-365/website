---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
---

<Base
  title="About Compliance365 — Simplifying Cyber, Privacy & AI Governance"
  description="We help Australian SaaS, tech, healthcare and finance teams achieve fast, defensible compliance without disruption or new tools."
>
  <Header />

  <!-- HERO POSITIONING -->
  <section class="hero-wrap">
    <div class="container">
      <div class="section-head center">
        <h1>Built to make compliance simpler, faster and trusted</h1>
        <p class="section-lead muted">
          Compliance365 turns cyber, privacy and AI governance into a repeatable system — not a painful project.
        </p>

        <div class="pill-row" style="margin:2rem 0;">
          <a href={`${base}services/iso27001`} class="pill">ISO 27001</a>
          <a href={`${base}services/iso27701`} class="pill">Privacy</a>
          <a href={`${base}services/iso42001`} class="pill">AI Governance</a>
          <a href={`${base}services/soc2`} class="pill">SOC 2</a>
          <a href={`${base}services/essential-eight`} class="pill">Essential Eight</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY WE EXIST / OUR STORY -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:3rem;">
        <div>
          <h2>Why Compliance365 Exists</h2>
          <p class="muted">
            Compliance too often feels broken — slow, expensive, disruptive, and disconnected from real business needs.
          </p>
          <p class="muted">
            We’ve seen the same pattern across fast-growing SaaS, tech, and regulated organisations in Australia:
          </p>
          <ul class="muted small" style="padding-left:1.5rem;margin:1.2rem 0;list-style:none;">
            <li>• Over-scoped audits that never seem to end</li>
            <li>• Generic templates that don’t reflect reality</li>
            <li>• New tools pushed as “mandatory”</li>
            <li>• Long timelines that stall deals</li>
            <li>• High costs that drain resources</li>
            <li>• Burnt-out teams chasing evidence</li>
          </ul>
          <p class="muted">
            The truth? Most organisations already have most of what they need. What’s missing is a clear, defensible way to turn existing reality into proof that auditors, customers, and procurement teams can trust — without the chaos.
          </p>
          <p class="muted">
            At Compliance365, we stripped compliance back to what actually matters: what auditors really look for, what evidence genuinely proves control, and what minimum viable remediation looks like without gold-plating or disruption.
          </p>
          <p class="muted">
            That consistent, repeatable approach became ComplianceReady™ — delivering faster audits, lower cost, and far less friction.
          </p>
          <p class="muted" style="font-weight:600;margin-top:1.5rem;">
            You shouldn’t have to choose between growth and doing the right thing.
          </p>
        </div>

<div>
        <img
          src={`${base}assets/about.png`}  <!-- This points to your real file -->
          alt="Compliance365 delivering fast, trusted compliance for Australian teams"
          class="cover-img"
          loading="lazy"
        />
      </div>

        <div>
          <img
            src={`${base}assets/about-team-tech.jpg`}
            alt="Compliance365 delivering fast, trusted compliance for Australian teams"
            class="cover-img"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE HELP YOU ACHIEVE (updated icons) -->
  <section class="section">
    <div class="container">
      <h2 class="center">What We Help You Achieve</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <circle cx="12" cy="9" r="3" />
            </svg>
          </div>
          <h3>Cybersecurity</h3>
          <p class="muted">
            ISO 27001, Essential Eight, SOC 2, DISP — practical controls, fast uplift and audit-ready evidence.
          </p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="4" width="16" height="16" rx="2" />
              <path d="M12 8v8M8 12h8" />
            </svg>
          </div>
          <h3>Privacy</h3>
          <p class="muted">
            ISO 27701, Australian Privacy Act — DPIAs, ROPAs, consent, third-party risk — all streamlined.
          </p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
          </div>
          <h3>AI Governance</h3>
          <p class="muted">
            ISO 42001 — responsible AI, risk assessment, model inventory, oversight and assurance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES - PRIDE with icons -->
  <section class="section">
    <div class="container">
      <h2 class="center">Our Values — PRIDE</h2>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 8v8" />
            </svg>
          </div>
          <h3>P — Put the Customer First</h3>
          <p class="muted small">Tailored frameworks that solve your real challenges — never generic templates.</p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
              <path d="M12 6v12" />
            </svg>
          </div>
          <h3>R — Reward Relationships</h3>
          <p class="muted small">Long-term trust built on clarity, reliability and partnership.</p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M2 12h20" />
            </svg>
          </div>
          <h3>D — Deliver with Excellence</h3>
          <p class="muted small">High-quality outcomes and continuous improvement.</p>
        </div>

        <div class="card feature center">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l9 4.5v9l-9 4.5-9-4.5v-9z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </div>
          <h3>E — Empower Simplicity</h3>
          <p class="muted small">Remove complexity so teams can focus on innovation, not paperwork.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STRONG CTA -->
  <section class="section" style="background:var(--primary);color:white;text-align:center;">
    <div class="container">
      <h2>Ready to simplify compliance?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:680px;margin:1.5rem auto;">
        Book a roadmap call — we’ll show you the fastest path to trusted, audit-ready compliance without disruption.
      </p>
      <a href={ctaUrl} class="btn btn-primary" style="margin-top:1.5rem;background:white;color:var(--primary);">
        Book a Consultation
      </a>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* === On-brand icons for What We Achieve & PRIDE ============= */
  .icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.2rem;
    background: linear-gradient(135deg, rgba(79,70,229,0.12), rgba(6,182,212,0.08));
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--primary);
    border: 2px solid var(--primary);
  }

  .icon svg {
    width: 36px;
    height: 36px;
    stroke-width: 2.2;
  }

  .card.feature.center {
    text-align: center;
  }

  .section-head.center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .section-lead {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-top: 1rem;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin: 1.5rem 0;
  }

  .cover-img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  @media (max-width: 980px) {
    .grid-3, .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
