---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// ✅ Your AWS API Gateway endpoint (same as your working site)
const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';
---

<Base title="Book a Call — Compliance365" description="Pick a 15 or 30 minute slot or send us a quick message.">
  <Header />

  <section class="container section">
    <div class="grid-2" style="align-items:start;gap:40px">
      <!-- LEFT: Calendly -->
      <div>
        <h1>Book a call</h1>
        <p class="muted" style="margin-bottom:10px;">
          Choose a time that works for you — or send us a quick message if you’d prefer.
        </p>
        <ul class="muted" style="margin-bottom:16px;">
          <li>15 or 30 minutes</li>
          <li>Microsoft Teams link auto-generated</li>
          <li>No selling — just practical next steps</li>
        </ul>

        <div class="card" style="padding:0;overflow:hidden;border-radius:16px;">
          <div
            class="calendly-inline-widget"
            data-url="https://calendly.com/matt-nicholas-compliance365/30min"
            style="min-width:320px;height:680px;"
          ></div>
          <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" defer></script>
        </div>
      </div>

      <!-- RIGHT: Contact form -->
      <div>
        <h2 style="margin-top:0">Prefer to send a message?</h2>
        <p class="muted">We’ll reply within 1 business day. Just tell us a bit about what you need help with.</p>

        <div class="card" style="padding:22px;border-radius:16px;">
          <!-- Progressive enhancement: has action+POST, but JS will intercept -->
          <form id="bookContactForm" action={API_URL} method="POST" novalidate style="display:grid;gap:12px;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <input id="bookName" name="name" placeholder="Your name" required
                     autocomplete="name"
                     style="padding:12px;border-radius:10px;border:1px solid #d8dde8;">
              <input id="bookEmail" name="email" type="email" placeholder="Work email" required
                     autocomplete="email"
                     style="padding:12px;border-radius:10px;border:1px solid #d8dde8;">
            </div>

            <input id="bookSubject" name="subject" placeholder="Subject"
                   style="padding:12px;border-radius:10px;border:1px solid #d8dde8;">
            <textarea id="bookMessage" name="message" placeholder="How can we help?" rows="6"
                      style="padding:12px;border-radius:10px;border:1px solid #d8dde8;"></textarea>

            <p id="bookErr" class="small" style="color:#b91c1c;display:none;margin:.25rem 0 0"></p>
            <p id="bookOk" class="small" style="color:#065f46;display:none;margin:.25rem 0 0"></p>

            <button id="bookSubmit" type="submit" class="btn btn-primary" style="margin-top:6px;">Send message</button>
          </form>

          <p class="muted small" style="margin-top:8px;">
            By submitting, you agree to our <a href={base + 'privacy'}>Privacy Policy</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- JS: intercept form submit and POST via fetch -->
 <script is:inline>
  const API_URL = "{API_URL}";
  const form  = document.getElementById('contactForm');
  const btn   = document.getElementById('contactSubmit');
  const errEl = document.getElementById('contactError');

  // ✅ Create a success banner element
  const successEl = document.createElement('p');
  successEl.className = 'small';
  successEl.style.cssText = 'color:#059669;display:none;margin:.6rem 0 0';
  form.appendChild(successEl);

  function validEmail(v){ return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v); }

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();
    errEl.style.display = 'none';
    successEl.style.display = 'none';

    const name    = (document.getElementById('inputName').value || '').trim();
    const email   = (document.getElementById('inputEmail').value || '').trim();
    const subject = (document.getElementById('inputSubject').value || '').trim();
    const message = (document.getElementById('inputMessage').value || '').trim();

    if(name.length < 2){ errEl.textContent = 'Please enter your full name.'; errEl.style.display = 'block'; return; }
    if(!validEmail(email)){ errEl.textContent = 'Please enter a valid work email.'; errEl.style.display = 'block'; return; }

    btn.disabled = true;

    try{
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, subject, message })
      });

      if(!res.ok) throw new Error('Request failed: ' + res.status);

      // ✅ Clear form + show success message
      form.reset();
      successEl.textContent = '✅ Your message has been sent successfully. We’ll reply within 1 business day.';
      successEl.style.display = 'block';
    }catch(err){
      console.error(err);
      errEl.textContent = 'Could not send right now. Please email info@compliance365.com.au or try again.';
      errEl.style.display = 'block';
    }finally{
      btn.disabled = false;
    }
  });
</script>
</Base>
