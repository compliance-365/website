---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book'; // or base + 'contact'
---

<Base
  title="Essential Eight Uplift (ACSC) — Australia | Compliance365"
  description="Practical, auditable uplift across the ACSC Essential Eight maturity model using Microsoft 365 and Azure — evidence captured in SharePoint."
  schema={[
    {
      "@type":"Service",
      "@id":"https://www.compliance365.com.au/services/essential-eight#service",
      "serviceType":"ACSC Essential Eight Uplift",
      "name":"Essential Eight Consulting (Australia)",
      "url":"https://www.compliance365.com.au/services/essential-eight",
      "areaServed":{"@type":"Country","name":"Australia"},
      "provider":{"@type":"Organization","name":"Compliance365","url":"https://www.compliance365.com.au"},
      "offers":{"@type":"Offer","availability":"https://schema.org/InStock"}
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Services","item":"https://www.compliance365.com.au/services"},
        {"@type":"ListItem","position":3,"name":"Essential Eight","item":"https://www.compliance365.com.au/services/essential-eight"}
      ]
    }
  ]}
/>
  <Header />

<Fragment slot="faq">
    <script type="application/ld+json">
      {JSON.stringify(faqLd)}
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="container section">
    <div class="grid-2" style="align-items:center">
      <div>
        <h1>Essential Eight Uplift</h1>
        <p class="muted lead" style="max-width:720px">
          Practical, auditable uplift across the <strong>ACSC Essential Eight</strong> —
          prioritised by risk, business impact, and automation opportunity within your
          Microsoft 365 &amp; Azure environments. We benchmark your current maturity,
          implement controls, and capture <strong>audit-ready evidence</strong>.
        </p>

        <div class="pill-row" style="margin-top:10px">
          <span class="pill">Application control</span>
          <span class="pill">Patch management</span>
          <span class="pill">Macro control</span>
          <span class="pill">User hardening</span>
          <span class="pill">MFA</span>
          <span class="pill">Restrict admin</span>
          <span class="pill">Logging &amp; monitoring</span>
          <span class="pill">Backups</span>
        </div>

        <div style="margin-top:16px">
          <a class="btn btn-primary" href={ctaUrl}>Start your uplift</a>
          <a class="btn btn-ghost" href={base + 'case-studies'}>See results</a>
        </div>
      </div>

      <div class="card" style="padding:0;overflow:hidden;border-radius:22px">
        <img
          src={base + 'assets/illus-essential-eight.svg'}
          alt="Essential Eight visual"
          loading="lazy"
          decoding="async"
          style="width:100%;height:auto;display:block"
        />
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS -->
  <section class="container section">
    <h2>Why the Essential Eight matters</h2>
    <p class="muted" style="max-width:860px">
      The Australian Cyber Security Centre (ACSC) recommends the Essential Eight to mitigate
      the most common cyber threats, including ransomware. Government and many regulated
      industries require uplift to defined maturity levels. We align uplift with your ISMS
      (ISO 27001) and ISM expectations so you get one coherent program — not competing frameworks.
    </p>

    <div class="grid-3" style="margin-top:14px">
      <div class="card feature center">
        <div class="icon" aria-hidden="true">
          <!-- shield -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-4 9-8 10-4-1-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.6"/></svg>
        </div>
        <h3>Mandatory &amp; expected</h3>
        <p class="muted small">Adopted across agencies and critical suppliers; increasingly required in contracts.</p>
      </div>

      <div class="card feature center">
        <div class="icon" aria-hidden="true">
          <!-- link -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M10 14l4-4M7 17a4 4 0 010-6l2-2a4 4 0 016 0M9 15a4 4 0 006 0l2-2a4 4 0 00-6 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </div>
        <h3>Aligned to ISO &amp; ISM</h3>
        <p class="muted small">Maps cleanly to Annex A controls and ISM hardening requirements.</p>
      </div>

      <div class="card feature center">
        <div class="icon" aria-hidden="true">
          <!-- activity -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M3 12h4l2 6 4-12 2 6h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>Reduces breach risk</h3>
        <p class="muted small">Targets the highest-impact mitigations for real-world attacks.</p>
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="container section">
    <h2>Deliverables</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card">
        <h3>Current → Target maturity</h3>
        <p class="muted">
          Evidence-based assessment against ML0–ML3, gap analysis, and a risk-prioritised
          roadmap that balances speed, impact and cost.
        </p>
        <ul class="muted small" style="margin:.2rem 0 0;padding-left:1.1rem">
          <li>Maturity scorecard per strategy</li>
          <li>Quick wins &amp; dependency map</li>
          <li>Executive summary pack</li>
        </ul>
      </div>

      <div class="card">
        <h3>Control implementation</h3>
        <p class="muted">
          Pragmatic uplift mapped to Microsoft 365, Azure and endpoints — Intune baselines,
          Defender hardening, application control and admin reduction.
        </p>
        <ul class="muted small" style="margin:.2rem 0 0;padding-left:1.1rem">
          <li>Intune: device compliance, encryption, baselines</li>
          <li>Defender: ASR rules, EDR, attack surface</li>
          <li>Application control (WDAC/AppLocker)</li>
        </ul>
      </div>

      <div class="card">
        <h3>Audit-ready evidence</h3>
        <p class="muted">
          Repeatable test scripts, exports and screenshots stored in SharePoint with
          retention &amp; versioning. Easy to hand to auditors or IRAP assessors.
        </p>
        <ul class="muted small" style="margin:.2rem 0 0;padding-left:1.1rem">
          <li>PowerShell/Graph exports on cadence</li>
          <li>Monitoring &amp; exception registers</li>
          <li>Before/after artefact packs</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="container section">
    <h2>How we work</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card feature center">
        <div class="icon" aria-hidden="true">
          <!-- list -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h12M4 12h10M4 18h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </div>
        <h3>1) Assess</h3>
        <p class="muted small">Benchmark with live tenant data; confirm scope, risks and quick wins.</p>
      </div>

      <div class="card feature center">
        <div class="icon" aria-hidden="true">
          <!-- plus -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </div>
        <h3>2) Implement &amp; automate</h3>
        <p class="muted small">Harden controls and automate evidence capture inside Microsoft 365.</p>
      </div>

      <div class="card feature center">
        <div class="icon" aria-hidden="true">
          <!-- check -->
          <svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>3) Validate</h3>
        <p class="muted small">Run repeatable tests; prepare artefacts for ISO/ISM or IRAP reviews.</p>
      </div>
    </div>
  </section>

  <!-- STRATEGY QUICK MAP -->
<section class="container section">
  <h2>The Eight Strategies (Explained Simply)</h2>
  <p class="muted" style="max-width:820px;margin-top:-4px">
    The Essential Eight is a practical set of cybersecurity strategies recommended by the
    <strong>Australian Cyber Security Centre (ACSC)</strong>.  
    Each one targets a specific type of attack, helping your organisation reduce the risk of ransomware,
    data theft, or business disruption.
  </p>

  <div class="grid-4" style="margin-top:18px">

    <div class="card center">
      <h3 style="margin:.2rem 0">1. Application Control</h3>
      <p class="muted small">
        Only allow approved and trusted software to run.  
        <em>Example:</em> Staff can install Microsoft Office but not unverified apps or browser extensions.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">2. Patch Applications</h3>
      <p class="muted small">
        Keep programs like browsers, Adobe, and Zoom up to date so attackers can’t exploit old versions.  
        <em>Example:</em> Automatic updates are enforced and tracked weekly.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">3. Configure Office Macros</h3>
      <p class="muted small">
        Macros can automate work — or spread malware. Only allow them from trusted, signed sources.  
        <em>Example:</em> Finance macros are allowed if approved; others are blocked by default.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">4. User Application Hardening</h3>
      <p class="muted small">
        Disable risky features in web browsers and PDF readers that attackers abuse.  
        <em>Example:</em> Blocking Flash, ads, and script-based pop-ups in Edge or Chrome.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">5. Restrict Administrative Privileges</h3>
      <p class="muted small">
        Limit admin access to only those who truly need it — and only when they need it.  
        <em>Example:</em> IT uses just-in-time access or “break-glass” accounts for critical fixes.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">6. Multi-Factor Authentication</h3>
      <p class="muted small">
        Require more than a password to log in — like a phone approval or security key.  
        <em>Example:</em> Microsoft 365 and VPNs always require MFA, even for executives.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">7. Patch Operating Systems</h3>
      <p class="muted small">
        Keep Windows, macOS, and servers current to close security holes.  
        <em>Example:</em> Devices failing to update within 14 days are flagged in Intune.
      </p>
    </div>

    <div class="card center">
      <h3 style="margin:.2rem 0">8. Regular Backups</h3>
      <p class="muted small">
        Protect business data with secure, offline backups that can’t be encrypted by attackers.  
        <em>Example:</em> Files are copied daily to immutable storage and tested monthly for recovery.
      </p>
    </div>

  </div>
</section>

<!-- MATURITY LEVELS -->
<section class="container section bg-light">
  <h2>Understanding the Three Maturity Levels</h2>
  <p class="muted" style="max-width:820px;margin-top:-4px">
    The Australian Cyber Security Centre (ACSC) measures how well your organisation implements
    the Essential Eight using three maturity levels.  
    These levels reflect how consistently the eight strategies are applied — from basic protection
    through to proactive, resilient security.
  </p>

  <div class="grid-3" style="margin-top:18px">

    <div class="card">
      <h3 style="margin:.2rem 0">Maturity Level 1 — <span style="color:var(--primary)">Baseline</span></h3>
      <p class="muted small">
        Focused on preventing opportunistic or “smash-and-grab” attacks.  
        Security settings are applied to key systems but may not be consistent across all devices.  
        <em>Example:</em> Staff use MFA for cloud logins, but older systems may still rely on passwords alone.
      </p>
      <ul class="muted small">
        <li>Basic patching and antivirus in place</li>
        <li>Limited application whitelisting</li>
        <li>Backups performed manually or infrequently</li>
      </ul>
    </div>

    <div class="card">
      <h3 style="margin:.2rem 0">Maturity Level 2 — <span style="color:var(--accent)">Sustainable</span></h3>
      <p class="muted small">
        Controls are standardised and enforced across the business.  
        The organisation can detect and respond to common attack techniques.  
        <em>Example:</em> Application control and MFA are applied consistently to all staff devices.
      </p>
      <ul class="muted small">
        <li>Automated patching and system compliance checks</li>
        <li>Backups tested regularly for restoration</li>
        <li>Privileged access managed with approvals or time limits</li>
      </ul>
    </div>

    <div class="card">
      <h3 style="margin:.2rem 0">Maturity Level 3 — <span style="color:var(--brand-a)">Resilient</span></h3>
      <p class="muted small">
        Designed to resist targeted attacks by sophisticated adversaries.  
        Controls are integrated, monitored, and continuously improved.  
        <em>Example:</em> Privileged accounts use just-in-time access, alerts are automated, and logs feed into a SIEM for visibility.
      </p>
      <ul class="muted small">
        <li>Real-time threat detection and response</li>
        <li>Immutable and off-site backups</li>
        <li>Continuous improvement through regular reviews</li>
      </ul>
    </div>

  </div>

  <p class="muted small" style="margin-top:20px">
    Most Australian organisations aim for <strong>Maturity Level 2</strong> — a practical balance between
    cost and protection.  
    <strong>Level 3</strong> is typically required for government and defence-related systems, while
    <strong>Level 1</strong> may suffice for small businesses beginning their uplift journey.
  </p>
</section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Ready to uplift your Essential Eight maturity?</h3>
        <p class="muted" style="margin:0">Get a risk-based, auditable plan tailored to your environment.</p>
      </div>
      <a class="btn btn-primary" href={ctaUrl}>Book a roadmap call</a>
    </div>
  </section>

<section class="container section">
  <div class="card" style="display:flex;gap:12px;flex-wrap:wrap">
    <strong style="margin-right:8px">Related services:</strong>
    <a class="pill" href="/services/iso27001">ISO 27001</a>
    <a class="pill" href="/services/iso27701">ISO 27701</a>
    <a class="pill" href="/services/iso42001">ISO 42001</a>
    <a class="pill" href="/services/soc2">SOC 2</a>
    <a class="pill" href="/services/essential-eight">Essential Eight</a>
    <a class="pill" href="/services/nist-csf">NIST CSF</a>
    <a class="pill" href="/services/disp-ism-irap">DISP / ISM / IRAP</a>
  </div>
</section>
  <Footer />
</Base>
