xf---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27001 (Security)';

// One source of truth for questions
const QUESTIONS = [
  // Governance & Planning
  { id:'scope',     label:'Clear ISMS scope defined (org units, locations, products/services, interfaces)?', group:'gov' },
  { id:'parties',   label:'Interested parties & their requirements identified and documented?',                group:'gov' },
  { id:'roles',     label:'Security roles, responsibilities and decision forums defined and communicated?',    group:'gov' },
  { id:'objs',      label:'ISMS objectives/KPIs set and reviewed on a cadence?',                               group:'gov' },

  // Risk Management
  { id:'risk-meth', label:'Risk methodology documented and approved (criteria, scoring, acceptance)?',         group:'risk' },
  { id:'risk-reg',  label:'Current risk register with owners, treatments and due dates is maintained?',         group:'risk' },

  // Controls Implementation
  { id:'controls',  label:'Annex A control selection completed with rationale linked to risks?',                group:'ctrl' },
  { id:'tech',      label:'Key technical controls (MFA, logging, backups, hardening) implemented and verified?',group:'ctrl' },
  { id:'soa',       label:'Statement of Applicability (SoA) current, approved and referenced by audits/evidence?', group:'ctrl' },
  { id:'suppliers', label:'Supplier due diligence completed; contracts include security clauses & monitoring?', group:'ctrl' },
  { id:'ops',       label:'Change management includes approvals, testing and rollback plans?',                  group:'ctrl' },

  // Evidence & Improvement
  { id:'evidence',  label:'Evidence captured in Microsoft 365 (SharePoint/Entra/Defender/Purview/Intune) with retention?', group:'ev' },
  { id:'awareness', label:'Security awareness & role-based training tracked with completion records?',          group:'ev' },
  { id:'int-audit', label:'Internal audit program executed; findings tracked to closure?',                      group:'ev' },
  { id:'mgmt-rev',  label:'Management review completed covering status, KPIs, risks and improvements?',         group:'ev' },
  { id:'improve',   label:'Corrective actions logged with owners/dates and reviewed monthly?',                  group:'ev' }
];

const GROUPS = [
  { key:'gov',  title:'Governance & Planning',     blurb:'Scope, stakeholders, roles and objectives.' },
  { key:'risk', title:'Risk Management',           blurb:'Method, register, owners and treatment cadence.' },
  { key:'ctrl', title:'Controls Implementation',   blurb:'Annex A selection, SoA, suppliers and change.' },
  { key:'ev',   title:'Evidence & Improvement',    blurb:'Evidence packs, awareness, internal audit and review.' },
];
---

<Base title="ISO 27001 Readiness Checklist" description="Answer quick questions, get an instant score and a downloadable PDF.">
  <Header />
<img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 27001 Readiness Checklist</h1>
    <p class="muted" style="max-width:800px">
      This quick-scan checklist helps assess your organisation’s readiness for ISO 27001 certification.
      Each question aligns to key implementation steps — from defining scope and risk methodology
      through to evidence management and continual improvement.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">Evaluate how mature your ISMS is across governance, risk, controls and improvement.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small">Select <strong>Yes / Partial / No</strong>. Progress and readiness update automatically.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown and next-step guidance.</p>
      </div>
    </div>
  </section>

  <section class="container section">
     <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill" aria-current="page">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q, i) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 8px;">{q.label}</label>
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

<script is:inline>
(() => {
  'use strict';

  const STANDARD  = "ISO 27001 (Security)";
  const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';

  const QUESTIONS = [
    { id:"scope",     label:"Clear ISMS scope defined (org units, locations, products/services, interfaces)?" },
    { id:"parties",   label:"Interested parties & their requirements identified and documented?" },
    { id:"roles",     label:"Security roles, responsibilities and decision forums defined and communicated?" },
    { id:"objs",      label:"ISMS objectives/KPIs set and reviewed on a cadence?" },
    { id:"risk-meth", label:"Risk methodology documented and approved (criteria, scoring, acceptance)?" },
    { id:"risk-reg",  label:"Current risk register with owners, treatments and due dates is maintained?" },
    { id:"controls",  label:"Annex A control selection completed with rationale linked to risks?" },
    { id:"tech",      label:"Key technical controls (MFA, logging, backups, hardening) implemented and verified?" },
    { id:"soa",       label:"Statement of Applicability (SoA) current, approved and referenced by audits/evidence?" },
    { id:"suppliers", label:"Supplier due diligence completed; contracts include security clauses & monitoring?" },
    { id:"ops",       label:"Change management includes approvals, testing and rollback plans?" },
    { id:"evidence",  label:"Evidence captured in Microsoft 365 (SharePoint/Entra/Defender/Purview/Intune) with retention?" },
    { id:"awareness", label:"Security awareness & role-based training tracked with completion records?" },
    { id:"int-audit", label:"Internal audit program executed; findings tracked to closure?" },
    { id:"mgmt-rev",  label:"Management review completed covering status, KPIs, risks and improvements?" },
    { id:"improve",   label:"Corrective actions logged with owners/dates and reviewed monthly?" }
  ];

  (document.readyState === 'loading')
    ? document.addEventListener('DOMContentLoaded', setup)
    : setup();

  function setup(){
    const form       = document.getElementById('form');
    const bar        = document.getElementById('bar');
    const scoreNum   = document.getElementById('scoreNum');
    const scoreLabel = document.getElementById('scoreLabel');
    const scoreHint  = document.getElementById('scoreHint');
    const resetBtn   = document.getElementById('resetBtn');
    const pdfBtn     = document.getElementById('pdfBtn');

    // Modal bits (keep your existing modal HTML)
    const modal      = document.getElementById('leadModal');
    const leadForm   = document.getElementById('leadForm');
    const cancelLead = document.getElementById('cancelLead');
    const nameEl     = document.getElementById('name');
    const emailEl    = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    // Chip selection (delegated to #form only)
    form.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.opt');
      if(!btn || !form.contains(btn)) return;
      const field = btn.closest('.field'); if(!field) return;
      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);
      state[id] = val;
      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');
      update();
    });

    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
      update();
    });

    // Open modal before PDF
    pdfBtn.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    // Modal controls
    function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if(modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

// Submit → API (SES) → PDF
leadForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const name  = (nameEl?.value || '').trim();
  const email = (emailEl?.value || '').trim();

  if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    alert('Please enter your name and a valid email.');
    return;
  }

  // Compact versions of your control lists
  const Q_MIN = (QUESTIONS || []).map(q => ({ id: q.id, label: q.label, group: q.group }));
  const G_MIN = (GROUPS   || []).map(g => ({ key: g.key, title: g.title }));

  // Build payload for Lambda
  const meta = {
    name,
    email,
    subject: 'Checklist lead: ISO 27001',
    message: JSON.stringify({
      checklist: 'ISO 27001 (Security)',
      timestamp: new Date().toISOString(),
      ua: navigator.userAgent,
      ...compute(state),           // answered, score
      total: QUESTIONS.length,     // total questions
      answers: state,              // id -> 0/1/2
      questions: Q_MIN,            // [{id,label,group}]
      groups: G_MIN                // [{key,title}]
    })
  };

  try {
    await fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(meta)
    });
  } catch (_) {
    /* non-blocking */
  }

  closeModal();
  generatePDF(state, { name, email }); // generate client PDF
});

    // Style the active chips
    const s = document.createElement('style');
    s.textContent = `
      button.opt{cursor:pointer}
      button.opt.active{
        background:#f0f2ff!important;
        border-color:#4F46E5!important;
        color:#1f2a5c!important;
      }`;
    document.head.appendChild(s);

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);
      bar.style.width = pct + '%';
      scoreNum.textContent = `${score}%`;

      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered>0 && score<40)      { label='Early stage';  hint='Focus on scope, risks and core policies first.'; }
      else if (score<70)               { label='In progress';  hint='Finish SoA, implement controls & prep internal audit.'; }
      else if (score<90)               { label='Nearly ready'; hint='Close gaps, capture automated evidence & book your audit.'; }
      else                             { label='Audit-ready';  hint='You look ready. Lock in dates with a cert body.'; }
      scoreLabel.textContent = label;
      scoreHint.textContent  = hint;
    }
  }

  function compute(state){
    const answered = Object.values(state).filter(v => v !== null).length;
    const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
    const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
    return { answered, score: isNaN(score) ? 0 : score };
  }

  // PDF generator (includes "Prepared for")
  function generatePDF(state){
  const { jsPDF } = window.jspdf || {};
  if(!jsPDF){ alert('PDF library not loaded.'); return; }

  const doc = new jsPDF('p','mm','a4');
  const W=210, LM=14, RM=14; let y=16;

  // helpers
  const now = new Date();
  const fmt = (d)=> d.toLocaleDateString(undefined, { year:'numeric', month:'short', day:'numeric' });
  const getLead = ()=>{
    const n = (document.getElementById('name')  || {}).value?.trim() || '';
    const e = (document.getElementById('email') || {}).value?.trim() || '';
    return { name:n, email:e };
  };
  const compute = ()=>{
    const answered=Object.values(state).filter(v=>v!==null).length;
    const scoreRaw=Object.values(state).reduce((a,v)=>a+(v??0),0);
    const score=Math.round((scoreRaw/(Object.keys(state).length*2))*100)||0;
    return { answered, score };
  };
  const hr = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

  const { answered, score } = compute();
  const STATUS = (answered===0)?'Not started' : (score<40)?'Early stage' : (score<70)?'In progress' : (score<90)?'Nearly ready' : 'Audit-ready';
  const LEAD = getLead();

  // ==== Header ====
  doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');         // indigo band
  doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');         // cyan accent

  // Logo (if available)
  try{
    const logoEl = document.getElementById('pdfLogo');
    if (logoEl && logoEl.complete) {
      // draw ~18mm wide, preserve aspect
      const targetW = 18;
      const ratio = (logoEl.naturalHeight||logoEl.height||120) / (logoEl.naturalWidth||logoEl.width||120);
      const targetH = Math.min(18, targetW * ratio);
      doc.addImage(logoEl, 'PNG', LM, 6, targetW, targetH, undefined, 'FAST');
      // Title shifted right to clear logo
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text('ISO 27001 (Security) quick-scan summary', LM + targetW + 4, 22);
    } else {
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text('ISO 27001 (Security) quick-scan summary', LM, 22);
    }
  }catch(_e){
    // fallback text-only
    doc.setTextColor(255,255,255);
    doc.setFont('helvetica','bold'); doc.setFontSize(15);
    doc.text('Compliance365 — Readiness Report', LM, 16);
    doc.setFont('helvetica','normal'); doc.setFontSize(11);
    doc.text('ISO 27001 (Security) quick-scan summary', LM, 22);
  }

  // meta (right side)
  doc.setFontSize(10);
  doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
  if(LEAD.name || LEAD.email){
    const prepared = `Prepared for: ${LEAD.name || ''}${LEAD.name && LEAD.email ? ' • ' : ''}${LEAD.email || ''}`;
    doc.text(prepared, W-RM, 22, { align:'right' });
  }

  // ==== Summary / Score dial ====
  y = 38;
  doc.setTextColor(0); doc.setFont('helvetica','bold'); doc.setFontSize(13);
  doc.text('Your Readiness at a Glance', LM, y);
  y += 8;

  // dial
  const dialX = LM + 26, dialY = y + 24;
  doc.setDrawColor(230,233,242); doc.setLineWidth(6);
  doc.circle(dialX, dialY, 20, 'S');
  doc.setDrawColor(79,70,229);
  const pct = Math.max(0,Math.min(score,100))/100;
  const segs = Math.max(1, Math.round(60*pct));
  for(let i=0;i<segs;i++){
    const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
    const a2 = a1 + 0.1;
    doc.line(dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
             dialX+20*Math.cos(a2), dialY+20*Math.sin(a2));
  }
  doc.setFont('helvetica','bold'); doc.setFontSize(14); doc.setTextColor(17,24,39);
  doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

  // score meta
  doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
  doc.text(`Answered: ${answered}/16`, LM+56, y+4);
  doc.text('Status:',    LM+56, y+12);
  doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
  doc.text(STATUS, LM+74, y+12);

  // quick tips
  doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
  doc.text('Next steps:', LM+56, y+20);
  const tips = (score<40)
    ? ['Lock ISMS scope & roles','Define risk method & start register','Publish core policy set']
    : (score<70)
      ? ['Complete SoA & control mapping','Tighten supplier due diligence','Schedule internal audit']
      : (score<90)
        ? ['Close findings & corrective actions','Automate evidence in M365','Confirm audit dates']
        : ['Maintain cadence (KPIs, reviews)','Refresh risk & SoA quarterly','Keep evidence automated'];
  tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, y+26 + i*5));

  y += 54;

  // ==== Domain bars ====
  doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
  doc.text('Domain Breakdown', LM, y); y += 5;

  const DOMAINS = {
    'Governance & Planning': ['scope','parties','roles','objs'],
    'Risk Management': ['risk-meth','risk-reg'],
    'Controls Implementation': ['controls','tech','soa','suppliers','ops'],
    'Evidence & Improvement': ['evidence','awareness','int-audit','mgmt-rev','improve'],
  };

  Object.entries(DOMAINS).forEach(([name, ids])=>{
    const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
    const max = ids.length*2;
    const p   = Math.round((got/max)*100) || 0;

    // label
    doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(17,24,39);
    doc.text(name, LM, y+5);

    // bar
    const barX = LM + 64, barW = W - LM - RM - 64;
    doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
    doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
    const fillW = Math.max(0, Math.min(barW*(p/100), barW));
    doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

    // % text
    doc.setFont('helvetica','bold'); doc.setTextColor(70);
    doc.text(`${p}%`, barX + barW + 4, y+5);

    y += 11;
  });

  y = hr(y, 6);

  // ==== Top gaps & risks (two columns) ====
  doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
  doc.text('Top Gaps & Risks', LM, y); y += 6;

  const highs=[], meds=[];
  const QMAP = {
    scope:'Scope unclear or incomplete',
    parties:'Interested parties not documented',
    roles:'Roles/forums not formalised',
    objs:'KPIs/objectives missing',
    'risk-meth':'Risk methodology not approved',
    'risk-reg':'Risk register not maintained',
    controls:'Annex A selection incomplete',
    tech:'Core technical controls not verified',
    soa:'SoA not current/approved',
    suppliers:'Supplier due diligence weak',
    ops:'Change management gaps',
    evidence:'Evidence not automated in M365',
    awareness:'Training not tracked',
    'int-audit':'Internal audit not executed',
    'mgmt-rev':'Management review not done',
    improve:'Corrective action cadence weak'
  };
  Object.keys(QMAP).forEach(id=>{
    const v = state[id];
    if(v===0) highs.push(QMAP[id]);
    else if(v===1) meds.push(QMAP[id]);
  });

  const colW = (W - LM - RM - 6)/2;
  const drawList = (title, items, x, color) =>{
    if(items.length===0) return y;
    doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(...color);
    doc.text(title, x, y);
    let yy = y + 4;
    doc.setFont('helvetica','normal'); doc.setTextColor(17,24,39); doc.setFontSize(10);
    items.forEach(t=>{
      const lines = doc.splitTextToSize(`- ${t}`, colW);
      doc.text(lines, x, yy);
      yy += lines.length*4.2 + 1.5;
    });
    return yy;
  };
  const yLeftEnd  = drawList('High (No): address immediately', highs, LM, [239,68,68]);
  const yRightEnd = drawList('Medium (Partial): tighten soon', meds, LM + colW + 6, [99,102,241]);
  y = Math.max(yLeftEnd, yRightEnd) + 4;

  y = hr(y, 4);

  // ==== Detailed responses (refined layout) ====
  doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
  doc.text('Detailed Responses', LM, y); y += 5;

  const QUESTIONS_FLAT = [
    { id:"scope", label:"Clear ISMS scope defined (org units, locations, products/services, interfaces)?" },
    { id:"parties", label:"Interested parties & their requirements identified and documented?" },
    { id:"roles", label:"Security roles, responsibilities and decision forums defined and communicated?" },
    { id:"objs", label:"ISMS objectives/KPIs set and reviewed on a cadence?" },
    { id:"risk-meth", label:"Risk methodology documented and approved (criteria, scoring, acceptance)?" },
    { id:"risk-reg", label:"Current risk register with owners, treatments and due dates is maintained?" },
    { id:"controls", label:"Annex A control selection completed with rationale linked to risks?" },
    { id:"tech", label:"Key technical controls (MFA, logging, backups, hardening) implemented and verified?" },
    { id:"soa", label:"Statement of Applicability (SoA) current, approved and referenced by audits/evidence?" },
    { id:"suppliers", label:"Supplier due diligence completed; contracts include security clauses & monitoring?" },
    { id:"ops", label:"Change management includes approvals, testing and rollback plans?" },
    { id:"evidence", label:"Evidence captured in Microsoft 365 (SharePoint/Entra/Defender/Purview/Intune) with retention?" },
    { id:"awareness", label:"Security awareness & role-based training tracked with completion records?" },
    { id:"int-audit", label:"Internal audit program executed; findings tracked to closure?" },
    { id:"mgmt-rev", label:"Management review completed covering status, KPIs, risks and improvements?" },
    { id:"improve", label:"Corrective actions logged with owners/dates and reviewed monthly?" }
  ];

  // nicer row: soft band + answer pill (colored)
  const drawRow = (idx, text, val)=>{
    if(y>275){ doc.addPage(); y=16; }

    // soft band background
    const rowH = 12 + Math.max(0, doc.splitTextToSize(text, W-LM-RM-40).length-1)*4.2;
    doc.setFillColor(245,247,255); // very light indigo
    doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

    // question
    doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
    const wrapW = W - LM - RM - 40;
    const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
    doc.text(lines, LM+4, y+4);

    // answer pill (right)
    const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
    let fill=[229,231,235], txt=[107,114,128]; // default gray
    if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
    else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
    else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

    doc.setFont('helvetica','bold'); doc.setFontSize(10);
    const tw = doc.getTextWidth(label);
    const pillW = Math.max(22, tw + 8);
    const chipX = W - RM - pillW - 4;
    const chipY = y - 1;
    doc.setDrawColor(222,226,236);
    doc.setFillColor(...fill);
    doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
    doc.setTextColor(...txt);
    doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

    y += rowH + 8;
  };

  QUESTIONS_FLAT.forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

  // ==== CTA ====
  if(y>246){ doc.addPage(); y=16; }
  y += 4;
  const btnW = 178, btnH = 18, btnX = LM, btnY = y;
  doc.setFillColor(79,70,229);
  doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
  doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);
  doc.text('Need help closing gaps? Book a roadmap call', btnX + 6, btnY + 12);
  doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

  // footer
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
  doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

  doc.save('iso27001_readiness.pdf');
}

})();
</script>

