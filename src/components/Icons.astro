---
/**
 * Inline SVG icon sprite — one <symbol> per glyph, referenced via
 * <svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-name"/></svg>
 * Render once (in BaseLayout), rendered content is display:none via the
 * wrapping <svg width="0" height="0">.
 *
 * Grid: 16x16. Stroke: 1.5px, round caps/joins. Colour: currentColor.
 * fill/stroke are set on each <symbol> directly so instances render
 * correctly regardless of CSS inheritance through <use>.
 */
const S = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs set:html={`

    <symbol id="ic-lock" viewBox="0 0 16 16" ${S}>
      <path d="M5.25 7V4.75a2.75 2.75 0 0 1 5.5 0V7"/>
      <rect x="3.25" y="7" width="9.5" height="7" rx="1.5"/>
    </symbol>

    <symbol id="ic-shield" viewBox="0 0 16 16" ${S}>
      <path d="M8 1.5 13 3.3v4.2c0 3.5-2.3 6-5 6.9-2.7-.9-5-3.4-5-6.9V3.3Z"/>
    </symbol>

    <symbol id="ic-ai-chip" viewBox="0 0 16 16" ${S}>
      <rect x="4.5" y="4.5" width="7" height="7" rx="1"/>
      <circle cx="8" cy="8" r="1.05" fill="currentColor" stroke="none"/>
      <path d="M6.5 1.5v3M9.5 1.5v3M6.5 11.5v3M9.5 11.5v3M1.5 6.5h3M1.5 9.5h3M11.5 6.5h3M11.5 9.5h3"/>
    </symbol>

    <symbol id="ic-australia" viewBox="0 0 16 16" ${S}>
      <path d="M5.5 14V2"/>
      <path d="M5.5 2.5 12 3.4v3.7L5.5 6.3Z"/>
      <path d="M3.4 14h4.2"/>
    </symbol>

    <symbol id="ic-check-seal" viewBox="0 0 16 16" ${S}>
      <circle cx="8" cy="7" r="5.25"/>
      <path d="M5.5 7.1 7.15 8.75 10.5 5.4"/>
      <path d="M6 11.8 5.1 14.5 7.2 13.1Z"/>
      <path d="M10 11.8 10.9 14.5 8.8 13.1Z"/>
    </symbol>

    <symbol id="ic-government" viewBox="0 0 16 16" ${S}>
      <path d="M1.5 6.2 8 2l6.5 4.2"/>
      <path d="M2 6.7h12"/>
      <path d="M4 7.2v6M7 7.2v6M9 7.2v6M12 7.2v6"/>
      <path d="M1.5 13.4h13"/>
    </symbol>

    <symbol id="ic-clipboard" viewBox="0 0 16 16" ${S}>
      <rect x="3.5" y="3" width="9" height="11.25" rx="1.25"/>
      <rect x="6" y="1.5" width="4" height="2.25" rx="0.75"/>
      <path d="M5.5 7.5h5M5.5 10h5"/>
    </symbol>

    <symbol id="ic-gift" viewBox="0 0 16 16" ${S}>
      <rect x="2.5" y="7.5" width="11" height="6.5" rx="0.75"/>
      <rect x="1.75" y="5.25" width="12.5" height="2.5" rx="0.6"/>
      <path d="M8 5.25v9"/>
      <path d="M8 5.25c0-1.25-1.3-2.15-2.5-1.8-.9.26-.9 1.36 0 1.8.6.28 1.7.28 2.5 0Z"/>
      <path d="M8 5.25c0-1.25 1.3-2.15 2.5-1.8.9.26.9 1.36 0 1.8-.6.28-1.7.28-2.5 0Z"/>
    </symbol>

    <symbol id="ic-bolt" viewBox="0 0 16 16" ${S}>
      <path d="M9.25 1.5 4.25 9h3.4L6.75 14.5 11.75 7H8.35Z"/>
    </symbol>

    <symbol id="ic-note" viewBox="0 0 16 16" ${S}>
      <path d="M3.5 2h6l3 3v9H3.5Z"/>
      <path d="M9.5 2v3h3"/>
      <path d="M5.5 8.25h5M5.5 10.75h3.5"/>
    </symbol>

    <symbol id="ic-books" viewBox="0 0 16 16" ${S}>
      <rect x="2" y="10" width="12" height="2.5" rx="0.6"/>
      <rect x="2.6" y="7.1" width="10.8" height="2.5" rx="0.6"/>
      <rect x="3.2" y="4.2" width="9.6" height="2.5" rx="0.6"/>
    </symbol>

    <symbol id="ic-insight" viewBox="0 0 16 16" ${S}>
      <circle cx="8" cy="6.75" r="3.25"/>
      <path d="M6.5 9.6v1.65a.75.75 0 0 0 .75.75h1.5a.75.75 0 0 0 .75-.75V9.6"/>
      <path d="M7 13h2"/>
      <path d="M8 1.5v1.4M4.6 3l1 1M11.4 3l-1 1"/>
    </symbol>

    <symbol id="ic-compass" viewBox="0 0 16 16" ${S}>
