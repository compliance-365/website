---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import DigestSignup from '../../components/DigestSignup.astro';
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// ── Featured guides ───────────────────────────────────────
const GUIDES = [
  {
    slug: 'essential-eight-guide',
    title: 'The Essential Eight Explained — Australia\'s Complete Cyber Security Guide',
    desc: 'What the Essential Eight is, the maturity model (ML1/ML2/ML3), all eight controls in detail, who needs it, how to achieve ML2, and what evidence auditors expect. Updated June 2026.',
    img: `${base}assets/illus-essential-eight.svg`,
    badge: 'Essential Eight · ASD',
    readTime: '20 min read',
  },
  {
    slug: 'is18-guide',
    title: 'IS18 Compliance for Queensland Government ICT Suppliers — Complete Guide',
    desc: 'What IS18 requires, how it maps to Essential Eight and ISO 27001, what an IS18 Compliance Statement must contain, and how to achieve compliance in 4–12 weeks. Essential reading for any QLD Government ICT supplier.',
    img: `${base}assets/illus-essential-eight.svg`,
    badge: 'IS18 · Queensland Government',
    readTime: '18 min read',
  },
  {
    slug: 'asd-essentials-framework',
    title: 'ASD Essentials Series: What Replaces the Essential Eight?',
    desc: 'ASD is retiring the Essential Eight and replacing it with the Essentials series — a broader framework covering enterprise IT, OT, cloud and agentic AI. Understand what\'s changing, when, and what to do now.',
    img: `${base}assets/illus-essential-eight.svg`,
    badge: 'Essential Eight · ASD · Transition',
    readTime: '10 min read',
  },
  {
    slug: 'rffr-soa-controls',
    title: 'The RFFR SoA Control Library — Every ISM Control, and What Automates',
    desc: 'Browse the complete Right Fit For Risk Statement of Applicability: all 989 ISM (June 2026) controls plus the 7 program-deed obligations, filterable by guideline, with Essential Eight maturity and Microsoft 365 automation coverage marked on every control.',
    img: `${base}assets/illus-disp-ism-irap.svg`,
    badge: 'RFFR · ISM · DEWR',
    readTime: 'Reference',
  },
  {
    slug: 'inside-statement-of-applicability',
    title: 'Inside a Statement of Applicability (SoA)',
    desc: 'What auditors expect, how risk links to Annex A, and how to build an integrated SoA across ISO 27001, ISO 27701, and ISO 42001 in Microsoft 365.',
    img: `${base}assets/guide-soa.svg`,
    badge: 'ISO 27001 · ISO 27701 · ISO 42001',
    readTime: '12 min read',
  },
  {
    slug: 'what-a-good-ropa-looks-like',
    title: 'What a Good ROPA Looks Like — and Common Mistakes',
    desc: 'The anatomy of a useful Record of Processing Activities with worked examples, common gaps that trigger regulatory enquiries, and a SharePoint-based implementation guide.',
    img: `${base}assets/guide-ropa.svg`,
    badge: 'ISO 27701 · Privacy Act',
    readTime: '10 min read',
  },
  {
    slug: 'ai-governance-readiness',
    title: 'AI Governance Readiness — ISO 42001 Explained',
    desc: 'Model inventory, AI risk and impact assessments, human oversight, and monitoring — a practical guide to building an AI Management System inside Microsoft 365.',
    img: `${base}assets/guide-42001.svg`,
    badge: 'ISO 42001 · AI Governance',
    readTime: '10 min read',
  },
  {
    slug: 'automating-compliance',
    title: 'Automating Compliance in Microsoft 365, Azure & AWS',
    desc: 'How to turn evidence collection, access reviews, and security posture into continuous assurance using tools you already own — no third-party GRC platform required.',
    img: `${base}assets/guide-automating.svg`,
    badge: 'Microsoft 365 · Azure · AWS',
    readTime: '8 min read',
  },
  {
    slug: 'risk-register-sharepoint',
    title: 'How to Build a Risk Register in SharePoint',
    desc: 'Full column schema, conditional formatting JSON, Power Automate flows, and views — one SharePoint List covering ISO 27001, ISO 27701, and ISO 42001. No third-party GRC platform required.',
    img: `${base}assets/guide-automating.svg`,
    badge: 'ISO 27001 · ISO 27701 · ISO 42001',
    readTime: '14 min read',
  },
];

// ── Readiness checklists ──────────────────────────────────
const CHECKLISTS = [
  {
    title: 'ISO 27001 Readiness Checklist',
    desc: 'Score your ISMS across scope, risk management, Annex A controls, SoA, and internal audit. Identify your top gaps and download a prioritised PDF roadmap.',
    img: `${base}assets/blog-iso27001.svg`,
    target: `${base}checklist/iso27001`,
    badge: 'ISO 27001',
    questions: '40 questions',
    time: '~15 min',
  },
  {
    title: 'ISO 27701 Privacy Readiness Checklist',
    desc: 'Assess your PIMS maturity across ROPA, DPIA, data rights handling, consent management, and third-party privacy risk. Aligned to the Australian Privacy Act.',
    img: `${base}assets/blog-iso27701.svg`,
    target: `${base}checklist/iso27701`,
    badge: 'ISO 27701',
    questions: '35 questions',
    time: '~12 min',
  },
  {
    title: 'ISO 42001 AI Governance Checklist',
    desc: 'Score your AI Management System across model inventory, AI risk assessment, human oversight, monitoring, and responsible AI policy. Aligned to the AU AI Safety Standard.',
    img: `${base}assets/blog-iso42001-v2.svg`,
    target: `${base}checklist/iso42001`,
    badge: 'ISO 42001',
    questions: '30 questions',
    time: '~12 min',
  },
  {
    title: 'Essential Eight Readiness Checklist',
    desc: 'Assess your maturity across all eight ASD controls — application control, patching, macros, MFA, admin privileges, backups, and more. Scored to ML1/ML2/ML3 criteria.',
    img: `${base}assets/illus-essential-eight.svg`,
    target: `${base}checklist/essential-eight`,
    badge: 'Essential Eight',
    questions: '45 questions',
    time: '~15 min',
  },
];

// ── Related blog posts ────────────────────────────────────
const POSTS = [
 {
    href: `${base}resources/iso27001-cost-australia`,
    title: 'What ISO 27001 Actually Costs in Australia (2026)',
    desc: 'A practitioner breakdown of certification costs for Australian mid-market organisations — the five real cost components, the GRC platform question, and the line items most cost guides leave out.',
    tag: 'ISO 27001 · Cost',
  },  
{
    href: `${base}blog/3-fears-killing-enterprise-deals`,
    title: '3 Compliance Fears Killing Your Enterprise Deals',
    desc: 'Why enterprise procurement has changed, what buyers are actually looking for, and how to turn compliance into a competitive advantage.',
    tag: 'Enterprise Sales',
  },
  {
    href: `${base}blog/isms-truths`,
    title: '13 Things Most People Don\'t Know About ISO 27001',
    desc: 'ISO 27001 is one of the most misunderstood security standards. Here are 13 surprising truths about the ISMS with practical business examples.',
    tag: 'ISO 27001',
  },
  {
    href: `${base}blog/ai-governance-iso42001-playbook`,
    title: 'ISO 42001 AI Governance: A Simple, Business-Ready Playbook',
    desc: 'A practical guide to implementing ISO 42001 using the tools you already have — Microsoft 365, SharePoint, and simple workflows.',
    tag: 'AI Governance',
  },
];

// JSON-LD — combined into a single graph
const pageLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://www.compliance365.com.au/resources#page',
      url: 'https://www.compliance365.com.au/resources',
      name: 'Compliance Resources — Guides, Checklists & Insights',
      description: 'Free practical guides, interactive readiness checklists, and compliance insights for Australian organisations. ISO 27001, ISO 27701, ISO 42001, Essential Eight, SOC 2.',
      provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.compliance365.com.au/' },
        { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.compliance365.com.au/resources' },
      ],
    },
  ],
};
---

<Base
  title="Compliance Resources — Free Guides, Checklists & Insights | Compliance365"
  description="Free practical guides, interactive readiness checklists, and compliance insights for Australian organisations. ISO 27001, ISO 27701, ISO 42001, Essential Eight, SOC 2."
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Free Resources</p>
      <h1>Practical compliance resources for Australian organisations</h1>
      <p class="section-lead" style="max-width:760px;">
        Guides, interactive readiness checklists, and insights — built around what auditors actually look for, not what makes compliance seem harder than it is. Everything here is free.
      </p>
      <div class="pill-row" style="margin-top:1.5rem;">
        <a href={`${base}training/`} class="pill" style="text-decoration:none;">Training: ISMS, AIMS &amp; PIMS</a>
        <a href="#checklists" class="pill" style="text-decoration:none;">Readiness checklists</a>
        <a href="#guides" class="pill" style="text-decoration:none;">Deep-dive guides</a>
        <a href="#insights" class="pill" style="text-decoration:none;">Insights & articles</a>
      </div>
    </div>
  </section>

  <!-- WHAT'S HERE -->
  <section class="section" style="background:#FAF7F1;padding:3rem 0;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:1rem;align-items:flex-start;">
          <div style="width:44px;height:44px;background:#A9812E;color:white;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;">✓</div>
          <div>
            <strong style="display:block;color:#0B0B0C;margin-bottom:4px;">Interactive checklists</strong>
            <p class="muted small" style="margin:0;">Answer questions, see your score, download a prioritised PDF roadmap. Takes 12–15 minutes. Gives you an honest baseline and the most important gaps to close first.</p>
          </div>
        </div>
        <div style="display:flex;gap:1rem;align-items:flex-start;">
          <div style="width:44px;height:44px;background:#A9812E;color:white;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;">§</div>
          <div>
            <strong style="display:block;color:#0B0B0C;margin-bottom:4px;">Deep-dive guides</strong>
            <p class="muted small" style="margin:0;">Practitioner-level guides on specific topics — what auditors look for, how to build it, what good looks like. Written for CISOs, compliance owners, and technical leads.</p>
          </div>
        </div>
        <div style="display:flex;gap:1rem;align-items:flex-start;">
          <div style="width:44px;height:44px;background:#A9812E;color:white;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;">⌘</div>
          <div>
            <strong style="display:block;color:#0B0B0C;margin-bottom:4px;">Insights & articles</strong>
            <p class="muted small" style="margin:0;">Practical articles on compliance strategy, enterprise sales, and implementation — written for teams that need to make compliance decisions, not just read about them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHECKLISTS (moved up — this is the highest-conversion content) -->
  <section class="section" id="checklists">
    <div class="container">
      <div style="margin-bottom:2rem;">
        <h2 style="margin:0 0 0.5rem;">Interactive readiness checklists</h2>
        <p class="muted" style="margin:0;max-width:700px;">Answer the questions, see your score, and download a prioritised PDF roadmap. Each checklist is mapped to the relevant framework's maturity criteria so the output tells you exactly where you stand — not just whether you pass or fail.</p>
      </div>

      <div style="background:rgba(169,129,46,0.06);border-left:4px solid #A9812E;border-radius:0 8px 8px 0;padding:14px 18px;margin-bottom:2rem;max-width:760px;">
        <strong style="color:#A9812E;font-size:0.875rem;">How the checklists work:</strong>
        <span class="muted" style="font-size:0.875rem;"> Answer yes / partial / no for each control area → your score updates in real time → download a branded PDF with domain breakdown, top gaps, and next-step guidance. Free, no sign-up required.</span>
      </div>

      <div class="grid-2" style="gap:1.5rem;">
        {CHECKLISTS.map(c => (
          <a
            href={c.target}
            style="text-decoration:none;color:inherit;display:flex;gap:1.25rem;align-items:flex-start;"
            class="card"
          >
            <img
              src={c.img}
              alt={c.title}
              style="width:56px;height:56px;object-fit:contain;flex-shrink:0;background:#FAF7F1;border-radius:8px;padding:8px;"
              loading="lazy"
            />
            <div style="flex:1;">
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.5rem;align-items:center;">
                <span class="pill" style="font-size:0.65rem;padding:2px 7px;">{c.badge}</span>
                <span class="muted" style="font-size:0.75rem;">{c.questions} · {c.time}</span>
              </div>
              <h3 style="margin:0 0 0.4rem;font-size:1rem;color:#0B0B0C;">{c.title}</h3>
              <p class="muted" style="margin:0 0 0.75rem;font-size:0.875rem;line-height:1.55;">{c.desc}</p>
              <span style="color:#A9812E;font-weight:600;font-size:0.85rem;">Start checklist →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  <section class="section" style="background:#FAF7F1;" id="guides">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
        <div>
          <h2 style="margin:0 0 0.5rem;">Deep-dive guides</h2>
          <p class="muted" style="margin:0;max-width:600px;">Practitioner-level guides on specific compliance topics. Each one covers the standard, what auditors actually check, how to implement it, and what good evidence looks like.</p>
        </div>
      </div>

      <!-- Featured guide (first one) -->
      <a
        href={`${base}resources/${GUIDES[0].slug}/`}
        style="text-decoration:none;color:inherit;display:grid;grid-template-columns:1fr 1.8fr;gap:2.5rem;align-items:center;background:white;border:1px solid #DDD8CF;border-left:4px solid #A9812E;border-radius:10px;padding:2rem;margin-bottom:1.5rem;"
        class="card"
      >
        <img
          src={GUIDES[0].img}
          alt={GUIDES[0].title}
          style="width:100%;border-radius:8px;aspect-ratio:4/3;object-fit:contain;background:#FAF7F1;padding:1rem;"
          loading="lazy"
        />
        <div>
          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.75rem;align-items:center;">
            <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;background:#A9812E;color:white;padding:3px 10px;border-radius:12px;">Featured</span>
            <span class="pill" style="font-size:0.7rem;padding:2px 8px;">{GUIDES[0].badge}</span>
            <span class="muted" style="font-size:0.8rem;">{GUIDES[0].readTime}</span>
          </div>
          <h3 style="margin:0 0 0.75rem;font-size:1.3rem;color:#0B0B0C;">{GUIDES[0].title}</h3>
          <p class="muted" style="margin:0 0 1.25rem;line-height:1.6;">{GUIDES[0].desc}</p>
          <span style="color:#A9812E;font-weight:600;font-size:0.9rem;">Read guide →</span>
        </div>
      </a>

      <!-- Remaining guides grid -->
      <div class="grid-3" style="gap:1.5rem;">
        {GUIDES.slice(1).map(g => (
          <a
            href={`${base}resources/${g.slug}/`}
            style="text-decoration:none;color:inherit;display:flex;flex-direction:column;"
            class="card"
          >
            <img
              src={g.img}
              alt={g.title}
              style="width:100%;aspect-ratio:16/9;object-fit:contain;background:#FAF7F1;padding:1rem;border-radius:8px;margin-bottom:1rem;"
              loading="lazy"
            />
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.6rem;align-items:center;">
              <span class="pill" style="font-size:0.65rem;padding:2px 7px;">{g.badge}</span>
              <span class="muted" style="font-size:0.75rem;">{g.readTime}</span>
            </div>
            <h3 style="margin:0 0 0.6rem;font-size:1rem;color:#0B0B0C;line-height:1.4;">{g.title}</h3>
            <p class="muted" style="margin:0 0 1rem;font-size:0.875rem;line-height:1.55;flex:1;">{g.desc}</p>
            <span style="color:#A9812E;font-weight:600;font-size:0.85rem;margin-top:auto;">Read guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INSIGHTS -->
  <section class="section" id="insights">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
        <div>
          <h2 style="margin:0 0 0.5rem;">Insights & articles</h2>
          <p class="muted" style="margin:0;max-width:600px;">Practical articles on compliance strategy, enterprise sales, and implementation guidance for Australian organisations.</p>
        </div>
        <a href={`${base}blog/`} style="color:#A9812E;font-weight:600;font-size:0.9rem;text-decoration:none;white-space:nowrap;">View all articles →</a>
      </div>

      <div class="grid-3" style="gap:1.5rem;">
        {POSTS.map(p => (
          <a
            href={p.href}
            style="text-decoration:none;color:inherit;display:flex;flex-direction:column;"
            class="card"
          >
            <span class="pill" style="font-size:0.65rem;padding:2px 7px;margin-bottom:0.75rem;align-self:flex-start;">{p.tag}</span>
            <h3 style="margin:0 0 0.6rem;font-size:1rem;color:#0B0B0C;line-height:1.4;flex:1;">{p.title}</h3>
            <p class="muted" style="margin:0 0 1rem;font-size:0.875rem;line-height:1.55;">{p.desc}</p>
            <span style="color:#A9812E;font-weight:600;font-size:0.85rem;margin-top:auto;">Read article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES CROSS-LINK -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
        <div>
          <h2 style="margin:0 0 0.5rem;">Real outcomes from Australian organisations</h2>
          <p class="muted" style="margin:0;max-width:600px;">See how organisations like yours achieved certification, improved maturity, and unlocked enterprise contracts — with specific timelines and outcomes.</p>
        </div>
        <a href={`${base}case-studies/`} style="color:#A9812E;font-weight:600;font-size:0.9rem;text-decoration:none;white-space:nowrap;">View all case studies →</a>
      </div>

      <div class="grid-2" style="gap:1.5rem;max-width:860px;">
        <a href={`${base}case-studies/fintech-startup/`} style="text-decoration:none;color:inherit;" class="card">
          <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;">
            <span class="pill" style="font-size:0.65rem;padding:2px 7px;">FinTech</span>
            <span style="font-size:0.7rem;background:#dcfce7;color:#166534;padding:2px 8px;border-radius:12px;font-weight:700;">12 weeks</span>
          </div>
          <h3 style="margin:0 0 0.5rem;font-size:1rem;color:#0B0B0C;">ISO 27001 Certification in 12 Weeks</h3>
          <p class="muted" style="margin:0 0 0.75rem;font-size:0.875rem;">Seed-to-Series-A FinTech from fragmented policies to certified ISMS — with reusable sales assurance that closed two enterprise deals immediately after certification.</p>
          <span style="color:#A9812E;font-weight:600;font-size:0.85rem;">Read case study →</span>
        </a>
        <a href={`${base}case-studies/health-saas-iso27701/`} style="text-decoration:none;color:inherit;" class="card">
          <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;">
            <span class="pill" style="font-size:0.65rem;padding:2px 7px;">Healthcare</span>
            <span style="font-size:0.7rem;background:#dcfce7;color:#166534;padding:2px 8px;border-radius:12px;font-weight:700;">10 weeks</span>
          </div>
          <h3 style="margin:0 0 0.5rem;font-size:1rem;color:#0B0B0C;">Zero Maturity to Essential Eight ML2 + ISO 27701 + ISO 42001</h3>
          <p class="muted" style="margin:0 0 0.75rem;font-size:0.875rem;">Health SaaS provider delivered three frameworks in an integrated management system in 10 weeks — unlocking enterprise health system contracts.</p>
          <span style="color:#A9812E;font-weight:600;font-size:0.85rem;">Read case study →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- DIGEST SIGNUP -->
  <section class="section" style="padding-bottom:0;">
    <div class="container" style="max-width:860px;">
      <DigestSignup
        heading="Get the monthly Australian compliance digest"
        subtext="Practical updates on Privacy Act changes, Essential Eight revisions, ISO 27001 news, and real implementation tips — once a month, no spam."
        formName="digest-signup-resources"
      />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Not sure which resource to start with?</h2>
      <p style="max-width:640px;margin-left:auto;margin-right:auto;">
        A free 30-minute call will tell you which framework applies to your situation, what your most important gaps are, and what the fastest path to audit-ready looks like. No obligation.
      </p>
      <div class="final-buttons">
        <a href={`${base}checklist/iso27001/`} class="btn-hdk-primary">
          Start a free checklist
        </a>
        <a href={ctaUrl} class="btn-hdk-ghost" target="_blank" rel="noopener">
          Book a free call
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />
</Base>
