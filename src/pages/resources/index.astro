---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// Featured guides (same as before, just polished presentation)
const GUIDES = [
  {
    slug: 'inside-statement-of-applicability',
    title: 'Inside a Statement of Applicability (SoA)',
    desc: 'What auditors expect, how risk links to Annex A, and practical evidence tips.',
    img: `${base}assets/guide-soa.svg`,
    cta: 'Read guide',
  },
  {
    slug: 'what-a-good-ropa-looks-like',
    title: 'What a Good ROPA Looks Like (and Common Mistakes)',
    desc: 'The anatomy of a useful ROPA with examples of good vs. risky entries.',
    img: `${base}assets/guide-ropa.svg`,
    cta: 'Read guide',
  },
  {
    slug: 'ai-governance-readiness',
    title: 'AI Governance Readiness (ISO 42001)',
    desc: 'Model inventory, AI risk, human oversight and monitoring—explained simply.',
    img: `${base}assets/guide-42001.svg`,
    cta: 'Read guide',
  },
  {
    slug: 'automating-compliance',
    title: 'Automating Compliance in Microsoft 365, Azure & AWS',
    desc: 'Turn evidence, access reviews and posture into continuous assurance—no new platform.',
    img: `${base}assets/guide-automating.svg`,
    cta: 'Read guide',
  },
];

// Interactive checklists (now static cards linking to checklists)
const CHECKLISTS = [
  {
    title: 'ISO 27001 Readiness Checklist',
    desc: '10-point scorecard for scope, risk, controls, SoA and internal audit.',
    img: `${base}assets/blog-iso27001.svg`,
    target: `${base}checklist/iso27001`,
  },
  {
    title: 'ISO 27701 (Privacy) Checklist',
    desc: 'ROPA, DPIA, rights handling, data lifecycle, privacy controls.',
    img: `${base}assets/blog-iso27701.svg`,
    target: `${base}checklist/iso27701`,
  },
  {
    title: 'ISO 42001 (AI) Checklist',
    desc: 'AIMS governance, model inventory, AI risk, human oversight and monitoring.',
    img: `${base}assets/blog-iso42001-v2.svg`,
    target: `${base}checklist/iso42001`,
  },
];
---

<Base
  title="Free ISO, SOC 2 & Essential Eight Checklists & Guides — Compliance365"
  description="Practical checklists and guides for ISO 27001, ISO 27701, ISO 42001, SOC 2 and Essential Eight. Score your readiness or read expert guides."
  schema={[
    {
      "@type":"CollectionPage",
      "@id":"https://www.compliance365.com.au/resources#page",
      "url":"https://www.compliance365.com.au/resources",
      "name":"Resources — Checklists & Guides",
      "description":"Checklists, templates and practical guides for ISO 27001, ISO 27701, ISO 42001, SOC 2 and Essential Eight."
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Resources","item":"https://www.compliance365.com.au/resources"}
      ]
    }
  ]}
>
  <Header />

  <!-- Hero-style intro -->
  <section class="hero-wrap">
    <div class="container">
      <div class="section-head center">
        <h1>Free Checklists & Practical Guides</h1>
        <p class="section-lead muted">
          Score your readiness or read expert guides — everything you need to build confidence and momentum, no fluff.
        </p>
        <p class="muted small" style="margin-top:1rem;opacity:0.9;">
          Trusted by CISOs, compliance owners and IT leaders across Australia.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Guides -->
  <section class="section">
    <div class="container">
      <h2 class="center">Featured Guides</h2>

      <div class="grid-3" style="margin-top:3rem;">
        {GUIDES.map((g) => (
          <a href={`${base}resources/${g.slug}`} class="card feature" style="text-decoration:none;color:inherit;">
            <div class="cover">
              <img
                src={g.img}
                alt={g.title}
                loading="lazy"
                decoding="async"
                style="width:100%;aspect-ratio:16/9;object-fit:contain;background:#fff;border-radius:12px;border:1px solid rgba(10,18,32,.06);padding:10px;"
              />
            </div>
            <h3 style="margin:.4rem 0 0">{g.title}</h3>
            <p class="muted" style="margin:0.75rem 0 1rem;">{g.desc}</p>
            <div class="pill-row" style="margin-top:auto;">
              <span class="pill brand">{g.cta} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Checklists (now static cards) -->
  <section class="section" style="background:#f8fafc;">
    <div class="container">
      <h2 class="center">Interactive Readiness Checklists</h2>
      <p class="muted center" style="max-width:720px;margin:1rem auto 3rem;">
        Answer the questions → see your score → download a PDF roadmap.
      </p>

      <div class="grid-3">
        {CHECKLISTS.map((c) => (
          <a href={c.target} class="card feature" style="text-decoration:none;color:inherit;">
            <div class="cover">
              <img
                src={c.img}
                alt={c.title}
                loading="lazy"
                decoding="async"
                style="width:100%;aspect-ratio:16/9;object-fit:contain;background:#fff;border-radius:12px;border:1px solid rgba(10,18,32,.06);padding:10px;"
              />
            </div>
            <h3 style="margin:.4rem 0 0">{c.title}</h3>
            <p class="muted" style="margin:0.75rem 0 1rem;">{c.desc}</p>
            <div class="pill-row" style="margin-top:auto;">
              <span class="pill brand">Start Checklist →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section final-cta" style="background:var(--primary);color:white;text-align:center;padding:6rem 0;">
    <div class="container">
      <h2>Ready to Score Your Readiness?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:720px;margin:1.5rem auto;">
        Pick a checklist, answer the questions, and download your personalized PDF roadmap — all free.
      </p>

      <a href={`${base}checklist/iso27001`} class="btn btn-primary large" style="margin-top:2rem;background:white;color:var(--primary);">
        Start ISO 27001 Checklist
      </a>
    </div>
  </section>

  <Footer />
</Base>
