---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// Load posts (newest first)
const posts = (await Astro.glob('../../content/blog/*.md'))
  .sort((a, b) =>
    new Date(b.frontmatter.date || 0).getTime() -
    new Date(a.frontmatter.date || 0).getTime()
  );

// Helpers
function coverUrl(img) {
  if (!img) return null;
  if (/^https?:\/\//i.test(img)) return img;
  return base + String(img).replace(/^\//, '');
}

function toSlugFromPath(p) {
  const filename = (p.split('/').pop() || '').replace(/\.md$/i, '');
  return filename;
}

// Build view models to avoid template literals later
const cards = posts.map((post) => {
  const slug = toSlugFromPath(post.file);
  const href = base + 'blog/' + slug;
  const img = coverUrl(post.frontmatter.image);
  const title = String(post.frontmatter.title || '');
  const desc = String(post.frontmatter.description || '');
  const dateStr = post.frontmatter.date
    ? new Date(post.frontmatter.date).toLocaleDateString()
    : '';
  const tags = (post.frontmatter.tags || []).map(String);
  return { href, img, title, desc, dateStr, tags, hay: (title + ' ' + desc).toLowerCase() };
});

// Unique tag list
const tagSet = new Set();
cards.forEach(c => c.tags.forEach(t => tagSet.add(t)));
const allTags = Array.from(tagSet).sort((a, b) => a.localeCompare(b));

// JSON-LD for list page (precomputed to avoid backticks in template)
const postsLd = cards.slice(0, 24).map(c => ({
  "@type": "BlogPosting",
  "headline": c.title,
  "datePublished": posts.find(p => (base + 'blog/' + toSlugFromPath(p.file)) === c.href)?.frontmatter.date || undefined,
  "description": c.desc || undefined,
  "url": 'https://www.compliance365.com.au' + c.href.replace(/^\//, '')
}));

const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Insights — Compliance365",
  "url": "https://www.compliance365.com.au/insights",
  "blogPost": postsLd
};
---

<Base title="Insights — Compliance365" description="Thought leadership on ISO, privacy, AI governance and SOC 2 — with audit-ready evidence patterns in Microsoft 365.">
  <Header />

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="container" style="margin-top:12px">
    <ol class="breadcrumb" style="list-style:none; display:flex; gap:8px; padding:0; margin:0; font-size:.9rem">
      <li><a href={base}>Home</a></li>
      <li aria-current="page" class="muted">Insights</li>
    </ol>
  </nav>

  <section class="container section" aria-labelledby="insights-title">
    <h1 id="insights-title">Insights</h1>
    <p class="muted" style="max-width:860px">
      Practical, audit-ready guidance on <strong>SOC&nbsp;2</strong>, <strong>ISO&nbsp;27001</strong>, <strong>ISO&nbsp;27701</strong>,
      <strong>ISO&nbsp;42001</strong>, and the <strong>ACSC Essential Eight</strong> — with real Microsoft&nbsp;365 / Azure examples.
    </p>

    <!-- Finder -->
    <div class="finder" style="display:grid; gap:12px; margin:18px 0 10px">
      <label for="q" class="small muted" style="font-weight:600">Search Insights</label>
      <input id="q" name="q" type="search"
             placeholder="Search titles & descriptions (e.g. SoA, Essential Eight, SOC 2)"
             aria-label="Search insights" class="input"
             style="border:1px solid rgba(10,18,32,.12); border-radius:10px; padding:10px 12px; max-width:560px" />

      <div class="tags" role="group" aria-label="Filter by tag" style="display:flex; flex-wrap:wrap; gap:8px">
        <button data-tag="__all__" class="pill" aria-pressed="true">All</button>
        {allTags.map(t => <button data-tag={t} class="pill" aria-pressed="false">{t}</button>)}
      </div>
    </div>

    <!-- Cards -->
    <div id="results" class="grid-3" style="margin-top:16px">
      {cards.map((c) => (
        <article class="card lift result"
                 data-tags={c.tags.join(' ').toLowerCase()}
                 data-hay={c.hay}
                 style="overflow:hidden; display:flex; flex-direction:column;">
          {c.img && (
            <a href={c.href} style="display:block; border-radius:12px; overflow:hidden;">
              <img
                src={c.img}
                alt={c.title}
                loading="lazy"
                style="width:100%; aspect-ratio: 16/9; object-fit:cover; border:1px solid rgba(10,18,32,.06); border-radius:12px;"
              />
            </a>
          )}
          <div style="padding-top:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            {c.tags.slice(0,3).map((t) => <span class="pill">{t}</span>)}
          </div>
          <h3 style="margin:.6rem 0 .2rem">
            <a href={c.href} style="color:inherit; text-decoration:none">{c.title}</a>
          </h3>
          <p class="muted" style="margin:0 0 10px">{c.desc}</p>
          <div style="margin-top:auto; display:flex; justify-content:space-between; align-items:center;">
            <span class="small muted">{c.dateStr}</span>
            <a class="pill" href={c.href} aria-label={'Read post: ' + c.title}>Read post →</a>
          </div>
        </article>
      ))}
    </div>

    <p id="no-results" class="muted" style="display:none; margin-top:16px">
      No insights matched your search/filter. Try a different keyword or clear tag filters.
    </p>

    <!-- Client-side filter (no template literals, no externals) -->
    <script is:inline>
      (function(){
        var q = document.getElementById('q');
        var grid = document.getElementById('results');
        var cards = Array.prototype.slice.call(grid ? grid.getElementsByClassName('result') : []);
        var no = document.getElementById('no-results');
        var tagBar = document.querySelector('.tags');
        var activeTag = '__all__';

        function applyFilter(){
          var text = (q && q.value ? q.value : '').trim().toLowerCase();
          var visible = 0;
          for (var i=0;i<cards.length;i++){
            var el = cards[i];
            var hay = el.getAttribute('data-hay') || '';
            var tags = (el.getAttribute('data-tags') || '').split(' ');
            var matchQ = !text || hay.indexOf(text) >= 0;
            var matchTag = activeTag === '__all__' || tags.indexOf(activeTag.toLowerCase()) >= 0;
            var show = matchQ && matchTag;
            el.style.display = show ? '' : 'none';
            if (show) visible++;
          }
          if (no) no.style.display = visible ? 'none' : '';
        }

        if (q) q.addEventListener('input', applyFilter);
        if (tagBar) {
          tagBar.addEventListener('click', function(e){
            var btn = e.target && e.target.closest('button');
            if (!btn) return;
            Array.prototype.forEach.call(tagBar.querySelectorAll('button'), function(b){ b.setAttribute('aria-pressed','false'); });
            btn.setAttribute('aria-pressed','true');
            activeTag = btn.getAttribute('data-tag') || '__all__';
            applyFilter();
          });
        }
        applyFilter();
      })();
    </script>

    <!-- JSON-LD (precomputed) -->
    <script type="application/ld+json" is:inline>{JSON.stringify(blogLd)}</script>
  </section>

  <Footer />
</Base>
