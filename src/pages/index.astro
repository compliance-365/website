---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// URLs used in the hero
const ctaUrl       = 'https://calendly.com/matt-nicholas-compliance365/30min';
const resourcesUrl = base + 'resources';

// SEO helpers for JSON-LD
const org = {
  '@type': 'Organization',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  logo: 'https://www.compliance365.com.au/assets/og-default.png',
  sameAs: ['https://www.linkedin.com/company/compliance-365/']
};

const siteLd = {
  '@type': 'WebSite',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.compliance365.com.au/search?q={query}',
    'query-input': 'required name=query'
  }
};

const servicesLd = [
  { name: 'ISO 27001 Certification Support',       url: 'https://www.compliance365.com.au/services/iso27001' },
  { name: 'ISO 27701 Privacy (PIMS)',              url: 'https://www.compliance365.com.au/services/iso27701' },
  { name: 'ISO 42001 AI Governance (AIMS)',        url: 'https://www.compliance365.com.au/services/iso42001' },
  { name: 'SOC 2 Readiness',                       url: 'https://www.compliance365.com.au/services/soc2' },
  { name: 'Essential Eight Uplift',                url: 'https://www.compliance365.com.au/services/essential-eight' },
  { name: 'DISP / ISM / IRAP',                     url: 'https://www.compliance365.com.au/services/disp-ism-irap' }
].map(s => ({
  '@type':'Service',
  serviceType:s.name,
  provider:{ '@type':'Organization', name:'Compliance365' },
  url:s.url
}));

const ld = {
  '@context': 'https://schema.org',
  '@graph': [org, siteLd, ...servicesLd]
};
---

<Base
  title="Guaranteed Compliance for Security, Privacy & AI — Australia | Compliance365"
  description="Guaranteed compliance for Security, Privacy & AI. Delivered in weeks, inside your environment, at a fraction of the cost. Turn compliance into trust — and trust into revenue."
  schema={[
    {
      "@type":"CollectionPage",
      "@id":"https://www.compliance365.com.au/#home",
      "name":"Compliance365 — Cyber, Privacy & AI Governance",
      "url":"https://www.compliance365.com.au/",
      "description":"Certification and readiness for ISO 27001, ISO 27701, ISO 42001, SOC 2 and Essential Eight in Australia."
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"}
      ]
    }
  ]}
>
  <Header />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>

  <!-- ANNOUNCEMENT BAR -->
  <div style="background:#0b1220;color:#fff">
    <div class="container" style="padding:10px 0; text-align:center;">
      <div class="small" style="opacity:.92">
        ✔ ISO 27001 • ISO 27701 • ISO 42001 ✔ SaaS & Technology Experts ✔ Compliance Delivered Using Your Existing Systems
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container hero hero-grid">

      <div class="hero-left">
        <h1 class="hero-title">
          Guaranteed Compliance for Security, Privacy &amp; AI
        </h1>

        <p class="hero-lede">
          Delivered in Weeks. Inside Your Environment. At a Fraction of the Cost.
        </p>

        <div class="hero-ctas">
          <a class="btn btn-primary" href={ctaUrl}>
            Book No-Obligation Call
          </a>
          <a class="btn btn-ghost" href={`${base}checklist/`}>
            Free ComplianceReady™ Score
          </a>
        </div>

        <p class="muted small" style="margin:14px 0 10px;">
          No New Tools | No Disruption | Affordable
        </p>

        <ul class="hero-benefits6">
          <li><span class="hb-ico"></span>Turn compliance into trust — and trust into revenue</li>
          <li><span class="hb-ico"></span>Stop deals stalling at the final security, privacy and AI hurdle</li>
          <li><span class="hb-ico"></span>Evidence captured inside your environment (M365 / SharePoint)</li>
          <li><span class="hb-ico"></span>Minimal remediation aligned to real auditor expectations</li>
          <li><span class="hb-ico"></span>Less disruption across engineering &amp; delivery</li>
          <li><span class="hb-ico"></span>Clear governance for AI &amp; privacy — without scope creep</li>
        </ul>

        <p class="muted small" style="margin:14px 0 8px;">
          Built for SaaS and technology teams who want to move fast and prove trust — without turning compliance into a monster.
        </p>

        <!-- Email form -->
        <form id="hero-form" class="hero-form" aria-label="Get started">
          <input
            id="hero-email"
            type="email"
            name="email"
            placeholder="Enter your work email"
            required
          />
          <button class="btn btn-primary" type="submit" id="hero-submit">
            Get started
          </button>
          <input type="hidden" name="source" value="hero-email" />
        </form>
        <p id="hero-status" class="muted small" style="margin-top:6px;"></p>
      </div>

      <div class="hero-right">
        <img
          class="hero-image"
          src="/assets/hero-illustration.svg"
          width="480"
          height="300"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          alt="Audit readiness dashboard"
        />
      </div>
    </div>

    <style>
      .hb-ico {
        display:inline-flex;
        align-items:center;
        justify-content:center;
        width:16px;
        height:16px;
        border-radius:50%;
        background:#4154f1;
        color:#fff;
        font-size:12px;
        margin-right:8px;
      }
      .hb-ico::before { content:"✓"; font-weight:700; }
      .hero-ctas {
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-top:14px;
      }
    </style>
  </section>

  <!-- PROBLEM -->
  <section class="container section">
    <div class="card" style="padding:22px;">
      <h2 style="margin:0 0 8px;">Why Your Compliance Is Losing You Deals to Your Competition</h2>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start;">
        <div>
          <h3 style="margin:0 0 6px;">The Real Problem Isn’t Compliance</h3>
          <p class="muted" style="margin:0;">It’s Revenue Stalling at the Final Hurdle.</p>
        </div>
        <div>
          <p style="margin:0;">
            Deals don’t die because of product gaps. They die when security, privacy, and AI proof can’t be produced — fast.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPLIANCEREADY SYSTEM -->
  <section class="container section">
    <h2 style="margin-bottom:8px;">Introducing the ComplianceReady™ System</h2>
    <p class="muted" style="margin-top:-4px;max-width:900px;">
      Compliance isn’t the problem. How it’s done is.
    </p>

    <div class="grid-2" style="margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;">
      <div class="card lift" style="padding:18px;">
        <h3 style="margin:0 0 10px;">Traditional Approach</h3>
        <ul class="small" style="margin:0;padding-left:18px;">
          <li>Long timelines</li>
          <li>Disruption across engineering &amp; delivery</li>
          <li>High consulting costs</li>
          <li>Generic templates that don’t reflect reality</li>
          <li>Over-scoped audits</li>
          <li>New tools forced on teams</li>
        </ul>
      </div>

      <div class="card lift" style="padding:18px;background:#f9fafc;">
        <h3 style="margin:0 0 10px;">ComplianceReady™</h3>
        <ul class="small" style="margin:0;padding-left:18px;">
          <li>Weeks, not months</li>
          <li>Delivered inside your environment</li>
          <li>No unnecessary new tools</li>
          <li>Minimal remediation</li>
          <li>Aligned to real auditor expectations</li>
        </ul>
      </div>
    </div>

    <div style="margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;">
      <div class="card" style="padding:14px;">
        <strong>Reduced procurement friction</strong>
        <div class="muted small">Clear, reusable answers for customers and partners.</div>
      </div>
      <div class="card" style="padding:14px;">
        <strong>Less reliance on engineers</strong>
        <div class="muted small">Evidence and control mapping lives in one place.</div>
      </div>
      <div class="card" style="padding:14px;">
        <strong>Lower total cost</strong>
        <div class="muted small">Cheaper than large consulting engagements or GRC tools.</div>
      </div>
      <div class="card" style="padding:14px;">
        <strong>A system that scales</strong>
        <div class="muted small">As your business grows, assurance stays consistent.</div>
      </div>
    </div>

    <div class="hero-ctas" style="margin-top:16px;">
      <a class="btn btn-primary" href={ctaUrl}>Book a No-Obligation ComplianceReady™ Call</a>
      <a class="btn btn-ghost" href={`${base}checklist/`}>Free ComplianceReady™ Score</a>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="container section">
    <h2>What we deliver</h2>
    <p class="muted" style="margin-top:-4px">
      From cybersecurity and privacy to AI governance — we help you achieve certification-ready results faster, using the tools you already have.
    </p>

    <div class="grid-3" style="margin-top:14px">

      <a class="card lift feature" href={`${base}services/iso27001`} aria-label="Information Security Management">
        <div class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z"/>
            <path d="M12 9v4m-2 0h4"/>
          </svg>
        </div>
        <h3>Information Security</h3>
        <p class="muted">
          Build trust with a clear, documented security framework — protecting data, managing risk, and meeting client and vendor requirements.
        </p>
        <div class="pill-row">
          <span class="pill brand">Secure systems</span>
