---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// Load all markdown case studies
const entries = await Astro.glob('../../../content/case-studies/*.md');

// Sort newest first (by date frontmatter if present, else title)
entries.sort((a, b) => {
  if (a.frontmatter?.date && b.frontmatter?.date) {
    return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
  }
  return (a.frontmatter?.title || '').localeCompare(b.frontmatter?.title || '');
});

// Build enriched case objects from frontmatter
const cases = entries.map((entry) => {
  const parts = entry.file.split('/');
  const filename = parts[parts.length - 1];
  const slug = filename.replace(/\.md$/, '');

  // Parse tags — support both array and comma-separated string
  const rawTags = entry.frontmatter?.tags ?? [];
  const tags = Array.isArray(rawTags)
    ? rawTags
    : String(rawTags).split(',').map((t) => t.trim()).filter(Boolean);

  // Parse outcomes — optional array of short metric strings
  // e.g. outcomes: ["Certified in 10 weeks", "100% first-time pass", "0 new tools"]
  const outcomes = Array.isArray(entry.frontmatter?.outcomes)
    ? entry.frontmatter.outcomes
    : [];

  return {
    href: `${base}case-studies/${slug}`,
    title:    entry.frontmatter?.title    ?? 'Case Study',
    summary:  entry.frontmatter?.summary  ?? '',
    sector:   entry.frontmatter?.sector   ?? '',
    services: entry.frontmatter?.services ?? '',
    timeline: entry.frontmatter?.timeline ?? '',
    tags,
    outcomes,
  };
});

// Collect all unique sectors for the filter bar
const allSectors = [...new Set(cases.flatMap(c =>
  c.sector ? [c.sector.split(',')[0].trim()] : []
))].sort();

// JSON-LD
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Compliance365 — Client Case Studies',
  url: 'https://www.compliance365.com.au/case-studies',
  numberOfItems: cases.length,
  itemListElement: cases.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://www.compliance365.com.au${c.href}`,
    name: c.title,
  }))
};
---
<Base
  title="Case Studies — Real Compliance Results for Australian Organisations | Compliance365"
  description="See how Australian SaaS, healthcare, government, and defence-adjacent organisations achieved ISO 27001, Essential Eight, SOC 2, and ISO 42001 — faster and with less disruption."
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <h1>Real results from Australian organisations</h1>
      <p class="section-lead muted" style="max-width:720px;">
        Every case study is a real engagement — a specific organisation, a specific problem, a specific outcome. No anonymised templates, no synthetic success stories.
      </p>
      <div class="pill-row" style="margin-top:1.5rem;">
        <span class="pill brand">100% first-time pass rate</span>
        <span class="pill">SaaS · Healthcare · Government · Defence</span>
        <span class="pill">ISO 27001 · Essential Eight · SOC 2 · ISO 42001</span>
      </div>
    </div>
  </section>

  <!-- OUTCOMES STRIP -->
  <section style="background:#1e40af;color:white;padding:3rem 0;">
    <div class="container">
      <div class="grid-4" style="text-align:center;">
        <div>
          <div style="font-size:2.4rem;font-weight:800;line-height:1;">4 weeks</div>
          <div style="font-size:0.8rem;opacity:0.8;margin-top:0.4rem;text-transform:uppercase;letter-spacing:1px;">Fastest engagement delivery</div>
        </div>
        <div>
          <div style="font-size:2.4rem;font-weight:800;line-height:1;">100%</div>
          <div style="font-size:0.8rem;opacity:0.8;margin-top:0.4rem;text-transform:uppercase;letter-spacing:1px;">First-time certification pass rate</div>
        </div>
        <div>
          <div style="font-size:2.4rem;font-weight:800;line-height:1;">55%</div>
          <div style="font-size:0.8rem;opacity:0.8;margin-top:0.4rem;text-transform:uppercase;letter-spacing:1px;">Average reduction in evidence collection time</div>
        </div>
        <div>
          <div style="font-size:2.4rem;font-weight:800;line-height:1;">$0</div>
          <div style="font-size:0.8rem;opacity:0.8;margin-top:0.4rem;text-transform:uppercase;letter-spacing:1px;">In new platform licences required</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FILTER BAR + GRID -->
  <section class="section">
    <div class="container">

      {cases.length === 0 ? (
        <!-- Empty state when no case studies are published -->
        <div class="center" style="padding:4rem 0;">
          <h2>Case studies coming soon</h2>
          <p class="muted" style="max-width:560px;margin:1rem auto 2rem;">
            We're in the process of publishing detailed case studies from recent engagements. In the meantime, a 30-minute call is the quickest way to find out whether we've worked on something similar to your situation.
          </p>
          <a href={ctaUrl} class="btn btn-primary">Book a free call</a>
        </div>
      ) : (
        <>
          <!-- Sector filter — JS-powered, degrades gracefully without JS -->
          {allSectors.length > 1 && (
            <div style="margin-bottom:2.5rem;">
              <p class="muted small" style="margin-bottom:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;font-size:0.75rem;">Filter by sector</p>
              <div class="pill-row" style="flex-wrap:wrap;gap:0.5rem;" id="filter-bar">
                <button
                  type="button"
                  class="pill filter-btn active"
                  data-filter="all"
                  style="cursor:pointer;border:none;background:#1e40af;color:white;"
                >All</button>
                {allSectors.map(s => (
                  <button
                    type="button"
                    class="pill filter-btn"
                    data-filter={s.toLowerCase()}
                    style="cursor:pointer;border:none;"
                  >{s}</button>
                ))}
              </div>
            </div>
          )}

          <!-- Case study cards -->
          <div class="grid-2" id="case-grid" style="gap:2rem;">
            {cases.map((c) => (
              <a
                href={c.href}
                class="card case-card"
                style="text-decoration:none;color:inherit;display:flex;flex-direction:column;border-left:4px solid #1e40af;"
                data-sector={c.sector ? c.sector.split(',')[0].trim().toLowerCase() : 'other'}
              >
                <!-- Sector + timeline badges -->
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;align-items:center;">
                  {c.sector && (
                    <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#1e40af;background:#eff6ff;padding:3px 10px;border-radius:12px;">
                      {c.sector.split(',')[0].trim()}
                    </span>
                  )}
                  {c.timeline && (
                    <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#166534;background:#dcfce7;padding:3px 10px;border-radius:12px;">
                      {c.timeline}
                    </span>
                  )}
                </div>

                <!-- Title & summary -->
                <h3 style="margin:0 0 0.75rem;font-size:1.1rem;line-height:1.4;">{c.title}</h3>
                <p class="muted small" style="flex:1;margin:0 0 1.25rem;line-height:1.6;">{c.summary}</p>

                <!-- Outcome metrics (if present in frontmatter) -->
                {c.outcomes.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.25rem;">
                    {c.outcomes.map(o => (
                      <span style="font-size:0.75rem;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;padding:3px 10px;border-radius:8px;font-weight:600;">
                        ✓ {o}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Framework tags -->
                {c.tags.length > 0 && (
                  <div class="pill-row" style="flex-wrap:wrap;gap:0.4rem;margin-bottom:1.25rem;">
                    {c.tags.slice(0, 4).map(t => (
                      <span class="pill" style="font-size:0.7rem;padding:2px 8px;">{t}</span>
                    ))}
                  </div>
                )}

                <span style="color:#1e40af;font-weight:600;font-size:0.875rem;margin-top:auto;">Read case study →</span>
              </a>
            ))}
          </div>

          <!-- Empty state if JS filter hides everything -->
          <div id="no-results" style="display:none;text-align:center;padding:4rem 0;">
            <p class="muted">No case studies match that filter. <button type="button" data-filter="all" class="filter-btn" style="color:#1e40af;background:none;border:none;cursor:pointer;font-weight:600;text-decoration:underline;">Show all</button></p>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- DON'T SEE YOUR SECTOR -->
  {cases.length > 0 && (
    <section class="section" style="background:#f8fafc;">
      <div class="container center">
        <h2>Don't see your sector?</h2>
        <p class="muted" style="max-width:640px;margin:1rem auto 2rem;">
          We work across a wide range of Australian industries. If you don't see a case study that matches your situation, a 30-minute call will tell you whether we've done something similar — and whether we're the right fit.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href={ctaUrl} class="btn btn-primary">Book a free call</a>
          <a href={`${base}services/`} class="btn btn-outline">Browse services</a>
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA -->
  <section class="final-cta" style="background:#1e40af;color:white;text-align:center;padding:6rem 0;">
    <div class="container">
      <h2>Want a result like these?</h2>
      <p class="muted" style="color:rgba(255,255,255,0.9);max-width:640px;margin:1.5rem auto;">
        A free 30-minute call will tell you what a realistic outcome looks like for your organisation — and what it would cost.
      </p>
      <a href={ctaUrl} class="btn btn-primary large" style="background:white;color:#1e40af;font-size:1.1rem;padding:1rem 2.5rem;margin-top:1.5rem;display:inline-block;">
        Book a free call
      </a>
    </div>
  </section>

  <Footer />

  <!-- Filter interaction — lightweight vanilla JS, no framework needed -->
  <script is:inline>
    (function() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards   = document.querySelectorAll('.case-card');
      const noResults = document.getElementById('no-results');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;

          // Update active button styling
          buttons.forEach(b => {
            b.style.background = '';
            b.style.color = '';
            b.classList.remove('active');
          });
          btn.style.background = '#1e40af';
          btn.style.color = 'white';
          btn.classList.add('active');

          // Show / hide cards
          let visible = 0;
          cards.forEach(card => {
            const match = filter === 'all' || card.dataset.sector === filter;
            card.style.display = match ? '' : 'none';
            if (match) visible++;
          });

          // Toggle empty state
          if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
        });
      });
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
</Base>
