---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

// JSON-LD
const org = {
  '@type': 'Organization',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  logo: 'https://www.compliance365.com.au/assets/og-default.png',
  sameAs: ['https://www.linkedin.com/company/compliance-365/']
};

const siteLd = {
  '@type': 'WebSite',
  name: 'Compliance365',
  url: 'https://www.compliance365.com.au',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.compliance365.com.au/search?q={query}',
    'query-input': 'required name=query'
  }
};

const servicesLd = [
  { name: 'ISO 27001 Certification Support', url: 'https://www.compliance365.com.au/services/iso27001' },
  { name: 'ISO 27701 Privacy (PIMS)',        url: 'https://www.compliance365.com.au/services/iso27701' },
  { name: 'ISO 42001 AI Governance (AIMS)',  url: 'https://www.compliance365.com.au/services/iso42001' },
  { name: 'SOC 2 Readiness',                 url: 'https://www.compliance365.com.au/services/soc2' },
  { name: 'Essential Eight Uplift',          url: 'https://www.compliance365.com.au/services/essential-eight' },
  { name: 'DISP / ISM / IRAP',               url: 'https://www.compliance365.com.au/services/disp-ism-irap' },
  { name: 'NIST Cybersecurity Framework',    url: 'https://www.compliance365.com.au/services/nist-csf' }
].map(s => ({
  '@type': 'Service',
  serviceType: s.name,
  provider: { '@type': 'Organization', name: 'Compliance365' },
  url: s.url
}));

const ld = { '@context': 'https://schema.org', '@graph': [org, siteLd, ...servicesLd] };

// Data
const announcement = [
  '✔ ISO 27001 • ISO 27701 • ISO 42001',
  '✔ SaaS & Technology Experts',
  '✔ Compliance Delivered Using Your Existing Systems'
].join('  ');

const fears = [
  {
    title: 'Losing a big deal at the final hurdle',
    body: 'A strong product can still lose when assurance can’t be proven quickly and credibly.',
    icon: '📉'
  },
  {
    title: 'Being labelled “high risk”',
    body: 'Procurement and risk teams default to “no” when evidence is missing, unclear, or inconsistent.',
    icon: '⚠️'
  },
  {
    title: 'Not having answers when proof is requested',
    body: 'Teams scramble across spreadsheets, inboxes and tribal knowledge instead of one defensible evidence trail.',
    icon: '🧾'
  }
];

const desires = [
  {
    title: 'Win deals faster',
    body: 'Security, privacy, and AI compliance should help close deals — not delay them.',
    icon: '🤝'
  },
  {
    title: 'Move through procurement without friction',
    body: 'Weeks, not months. Calm, not chaos.',
    icon: '🛣️'
  },
  {
    title: 'Confidence when customers ask hard questions',
    body: 'Clear, credible answers backed by evidence — without scrambling.',
    icon: '🛡️'
  }
];

const compare = {
  leftTitle: 'Traditional approach',
  left: [
    'Long timelines',
    'Disruption across engineering & delivery',
    'High consulting costs',
    'Generic templates that don’t reflect reality',
    'Over-scoped audits',
    'New tools forced on teams'
  ],
  rightTitle: 'ComplianceReady™',
  right: [
    'Weeks, not months',
    'Delivered inside your environment',
    'No unnecessary new tools',
    'Minimal remediation',
    'Aligned to real auditor expectations'
  ],
  outcomes: [
    { title: 'Faster certification', body: 'Weeks, not months — with a clear scope and a defensible evidence plan.' },
    { title: 'Lower total cost', body: 'Typically lower than large consulting engagements or GRC tool subscriptions.' },
    { title: 'Reduced procurement friction', body: 'Reusable answers for customers, partners and auditors.' },
    { title: 'Less reliance on engineers', body: 'Evidence and mappings live in one place, not in people’s heads.' },
    { title: 'A system that scales', body: 'Assurance stays consistent as your business grows and changes.' }
  ]
};

const phases = [
  {
    n: '1',
    title: 'Scope & Risk Baseline',
    keyQ: 'What is in scope, what risks matter, and what evidence will prove control?',
    outcome: 'A prioritised roadmap across security, privacy and AI — aligned to auditor expectations and deal-critical requirements.'
  },
  {
    n: '2',
    title: 'Remediation & System Build',
    keyQ: 'What is the minimum viable remediation to become audit-ready without disruption?',
    outcome: 'Controls, policies and workflows implemented inside your environment — with evidence capture automated in M365.'
  },
  {
    n: '3',
    title: 'Readiness Validation',
    keyQ: 'If an auditor reviewed us tomorrow, would we pass — and why?',
    outcome: 'Independent validation, evidence traceability, and a clean “audit pack” that stands up to scrutiny.'
  },
  {
    n: '4',
    title: 'Audit & Certification Support',
    keyQ: 'Can we demonstrate compliance confidently, without last-minute chaos?',
    outcome: 'Assessor Q&A support, final evidence packaging, and a calm audit experience with no surprises.'
  }
];

const services = [
  {
    title: 'ISO 27001 (Security)',
    summary: 'Certify your ISMS in 8–12 weeks — gap analysis, risk, SoA, and audit readiness with automation in Microsoft 365.',
    url: base + 'services/iso27001',
    tags: [
      { label: 'Gap analysis', url: base + 'services/iso27001' },
      { label: 'SoA', url: base + 'services/iso27001' }
    ]
  },
  {
    title: 'ISO 27701 (Privacy)',
    summary: 'Extend your ISMS with privacy workflows: DPIAs, ROPAs, data rights, and training aligned to ISO 27701.',
    url: base + 'services/iso27701',
    tags: [
      { label: 'DPIA', url: base + 'services/iso27701' },
      { label: 'ROPA', url: base + 'services/iso27701' }
    ]
  },
  {
    title: 'ISO 42001 (AI Governance)',
    summary: 'Operationalise AI governance: model inventory, AI risk, oversight, and monitoring — with defensible documentation.',
    url: base + 'services/iso42001',
    tags: [
      { label: 'AI risk', url: base + 'services/iso42001' },
      { label: 'Oversight', url: base + 'services/iso42001' }
    ]
  },
  {
    title: 'SOC 2 Readiness (Type I/II)',
    summary: 'Trust Services Criteria mapped to your stack. Type 1 & Type 2 readiness with evidence you can reuse in sales.',
    url: base + 'services/soc2',
    tags: [
      { label: 'Type 1', url: base + 'services/soc2' },
      { label: 'Type 2', url: base + 'services/soc2' }
    ]
  },
  {
    title: 'Essential Eight Uplift',
    summary: 'Practical uplift across patching, macros, app control, MFA and backups — leveraging your Microsoft E5 stack.',
    url: base + 'services/essential-eight',
    tags: [
      { label: 'MFA', url: base + 'services/essential-eight' },
      { label: 'App control', url: base + 'services/essential-eight' }
    ]
  },
  {
    title: 'DISP, ISM & IRAP',
    summary: 'Defence uplift, ISM alignment, and IRAP readiness — with evidence automation and audit support.',
    url: base + 'services/disp-ism-irap',
    tags: [
      { label: 'DISP', url: base + 'services/disp-ism-irap' },
      { label: 'ISM', url: base + 'services/disp-ism-irap' },
      { label: 'IRAP', url: base + 'services/disp-ism-irap' }
    ]
  },
  {
    title: 'NIST Cybersecurity Framework',
    summary: 'Align controls to NIST CSF (Identify, Protect, Detect, Respond, Recover) — mapped to ISO 27001 and Essential Eight.',
    url: base + 'services/nist-csf',
    tags: [
      { label: 'NIST CSF', url: base + 'services/nist-csf' },
      { label: 'Mapping', url: base + 'services/nist-csf' }
    ]
  }
];

const servicePills = [
  { label: 'ISO 27001', url: base + 'services/iso27001', brand: true },
  { label: 'ISO 27701', url: base + 'services/iso27701' },
  { label: 'ISO 42001', url: base + 'services/iso42001' },
  { label: 'SOC 2', url: base + 'services/soc2' },
  { label: 'Essential Eight', url: base + 'services/essential-eight' },
  { label: 'DISP / IRAP', url: base + 'services/disp-ism-irap' },
  { label: 'NIST CSF', url: base + 'services/nist-csf' }
];
---

<Base
  title="Guaranteed Compliance for Security, Privacy & AI — Australia | Compliance365"
  description="Guaranteed compliance for Security, Privacy & AI. Delivered in weeks, inside your environment, at a fraction of the cost. Turn compliance into trust — and trust into revenue."
  schema={[
    {
      "@type":"CollectionPage",
      "@id":"https://www.compliance365.com.au/#home",
      "name":"Compliance365 — Cyber, Privacy & AI Governance",
      "url":"https://www.compliance365.com.au/",
      "description":"Certification and readiness for ISO 27001, ISO 27701, ISO 42001, SOC 2, Essential Eight, DISP/ISM/IRAP and NIST CSF in Australia."
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"}
      ]
    }
  ]}
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>

  <!-- Rotating announcement bar (marquee-style, accessible) -->
  <div class="announce" aria-label="Announcement">
    <div class="container">
      <div class="announce-inner" role="status" aria-live="polite">
        <span class="announce-dot" aria-hidden="true"></span>
        <span class="announce-text">{announcement}</span>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero-wrap" id="top">
    <div class="container hero-grid">
      <div class="hero-left">
        <h1 class="hero-title">Guaranteed Compliance for Security, Privacy &amp; AI</h1>
        <p class="hero-sub">Delivered in Weeks. Inside Your Environment. At a Fraction of the Cost.</p>

        <div class="hero-ctas">
          <a class="btn btn-primary" href={ctaUrl}>Book a No-Obligation Call</a>
          <a class="btn btn-ghost" href={`${base}checklist/`}>Free ComplianceReady™ Score</a>
        </div>

        <div class="hero-meta">
          <span class="kicker">No New Tools</span>
          <span class="kicker">No Disruption</span>
          <span class="kicker">Affordable</span>
        </div>

        <div class="pill-row hero-pills" aria-label="Services">
          {servicePills.map(p => (
            <a class={`pill ${p.brand ? 'brand' : ''}`} href={p.url}>{p.label}</a>
          ))}
        </div>

        <ul class="hero-list" aria-label="Key outcomes">
          <li><span class="tick" aria-hidden="true"></span>Turn compliance into trust — and trust into revenue</li>
          <li><span class="tick" aria-hidden="true"></span>Stop deals stalling at the final security, privacy and AI hurdle</li>
          <li><span class="tick" aria-hidden="true"></span>Evidence captured inside your environment (M365 / SharePoint)</li>
          <li><span class="tick" aria-hidden="true"></span>Minimal remediation aligned to real auditor expectations</li>
          <li><span class="tick" aria-hidden="true"></span>Less disruption across engineering &amp; delivery</li>
          <li><span class="tick" aria-hidden="true"></span>Clear governance for AI &amp; privacy — without scope creep</li>
        </ul>

        <p class="muted small" style="margin:14px 0 8px;">
          Built for SaaS and technology teams who want to move fast and prove trust — without turning compliance into a monster.
        </p>

        <!-- Email form -->
        <form id="hero-form" class="hero-form" aria-label="Get started">
          <input id="hero-email" type="email" name="email" placeholder="Enter your work email" required />
          <button class="btn btn-primary" type="submit" id="hero-submit">Get started</button>
          <input type="hidden" name="source" value="hero-email" />
        </form>
        <p id="hero-status" class="muted small" style="margin-top:6px;"></p>
      </div>

      <div class="hero-right" aria-hidden="true">
        <div class="hero-art">
          <img
            class="hero-image"
            src="/assets/hero-illustration.svg"
            width="560"
            height="360"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            alt=""
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="container section">
    <div class="card pad-xl">
      <h2 style="margin:0 0 10px;">Why Your Compliance Is Losing You Deals to Your Competition</h2>
      <div class="split">
        <div>
          <h3 style="margin:0 0 6px;">The real problem isn’t compliance</h3>
          <p class="muted" style="margin:0;">It’s revenue stalling at the final hurdle.</p>
        </div>
        <div>
          <p style="margin:0;">
            Deals don’t die because of product gaps. They die when security, privacy, and AI proof can’t be produced — fast.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 FEARS -->
  <section class="container section">
    <h2>The 3 biggest fears killing your deals</h2>
    <div class="grid-3" style="margin-top:14px;">
      {fears.map((c) => (
        <div class="card lift pad-lg">
          <div class="card-top">
            <div class="emoji" aria-hidden="true">{c.icon}</div>
            <h3 style="margin:0;">{c.title}</h3>
          </div>
          <p class="muted" style="margin:10px 0 0;">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- DESIRES / WHAT CLIENTS WANT -->
  <section class="container section">
    <h2>What your clients really want</h2>
    <p class="muted" style="margin-top:-6px;max-width:900px;">
      Buyers want confidence. Procurement wants consistency. Auditors want evidence. Your team wants calm.
    </p>

    <div class="grid-3" style="margin-top:14px;">
      {desires.map((c) => (
        <div class="card lift pad-lg">
          <div class="card-top">
            <div class="emoji" aria-hidden="true">{c.icon}</div>
            <h3 style="margin:0;">{c.title}</h3>
          </div>
          <p class="muted" style="margin:10px 0 0;">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- COMPLIANCEREADY -->
  <section class="container section" id="system">
    <div class="section-head">
      <h2 style="margin:0;">Introducing the ComplianceReady™ System</h2>
      <p class="muted" style="margin:6px 0 0;">Trusted by teams who can’t afford delays.</p>
    </div>

    <div class="grid-2" style="margin-top:14px;">
      <div class="card lift pad-lg">
        <h3 style="margin:0 0 10px;">{compare.leftTitle}</h3>
        <ul class="small" style="margin:0;padding-left:18px;">
          {compare.left.map(x => <li>{x}</li>)}
        </ul>
      </div>

      <div class="card lift pad-lg alt">
        <h3 style="margin:0 0 10px;">{compare.rightTitle}</h3>
        <ul class="small" style="margin:0;padding-left:18px;">
          {compare.right.map(x => <li>{x}</li>)}
        </ul>
      </div>
    </div>

    <div class="grid-5" style="margin-top:14px;">
      {compare.outcomes.map(o => (
        <div class="card pad-md">
          <strong>{o.title}</strong>
          <div class="muted small" style="margin-top:6px;">{o.body}</div>
        </div>
      ))}
    </div>

    <div class="cta-band" style="margin-top:16px;">
      <div>
        <h3 style="margin:0 0 4px;">Get compliant &amp; win big deals — fast</h3>
        <div class="muted small">Turn compliance into a deal enabler — not a blocker.</div>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href={ctaUrl}>Book a No-Obligation ComplianceReady™ Call</a>
        <a class="btn btn-ghost" href={`${base}checklist/`}>Free ComplianceReady™ Score</a>
      </div>
    </div>
  </section>

  <!-- 4 PHASES -->
  <section class="container section" id="process">
    <h2>The ComplianceReady™ System — 4 clear phases</h2>
    <div class="grid-4" style="margin-top:14px;">
      {phases.map(p => (
        <div class="card lift pad-lg phase">
          <div class="phase-top">
            <span class="phase-num" aria-hidden="true">{p.n}</span>
            <h3 style="margin:0;">{p.title}</h3>
          </div>

          <div class="phase-block">
            <div class="phase-label">Key question</div>
            <div class="small">{p.keyQ}</div>
          </div>

          <div class="phase-block">
            <div class="phase-label">Outcome</div>
            <div class="muted small">{p.outcome}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
<section id="services" class="container section">
  <h2>What we deliver</h2>
  <p class="muted" style="margin-top:-4px">
    From cybersecurity and privacy to AI governance — we help you achieve certification-ready results faster, using the tools you already have.
  </p>

  <div class="grid-3" style="margin-top:14px">

    <a class="card lift service-card" href={`${base}services/iso27001`} aria-label="Information Security Management">
      ...
    </a>

    <a class="card lift service-card" href={`${base}services/iso27701`} aria-label="Privacy Management">
      ...
    </a>

    <a class="card lift service-card" href={`${base}services/iso42001`} aria-label="AI Governance">
      ...
    </a>

    <a class="card lift service-card" href={`${base}services/essential-eight`} aria-label="Essential Eight uplift">
      ...
    </a>

    <a class="card lift service-card" href={`${base}services/soc2`} aria-label="SOC 2 readiness">
      ...
    </a>

    <a class="card lift service-card" href={`${base}services/disp-ism-irap`} aria-label="Defence & government frameworks">
      ...
    </a>

  </div>
</section>

  <!-- VALUE STRIP / M365 -->
  <section class="container section">
    <div class="card pad-xl center">
      <h3 style="margin:0 0 8px;">Use the tools you already have.</h3>
      <p class="muted lead" style="margin:0 0 20px;">
        No extra platforms or logins. We configure and automate compliance inside your Microsoft&nbsp;365 stack.
      </p>

      <img
        src={(import.meta.env.BASE_URL) + 'assets/ms-tools.svg'}
        alt="Microsoft 365 compliance evidence components"
        loading="lazy"
        decoding="async"
        style="width:100%; max-width:1100px; margin:0 auto; display:block;"
      />

      <p class="muted small" style="margin:20px 0 0;">
        Evidence flows across SharePoint, Entra, Defender, Intune, Purview &amp; Sentinel.
      </p>

      <div style="margin-top:20px;">
        <a class="btn btn-primary" href={ctaUrl}>Book a call →</a>
      </div>
    </div>
  </section>

  <!-- FREE RESOURCES -->
  <section id="resources" class="container section">
    <div class="card pad-xl center">
      <h2 style="margin:0 0 10px;">Free resources to move faster</h2>
      <p class="muted" style="margin:0;max-width:880px;margin-inline:auto;">
        Run a quick health check on your security, privacy and AI programs. Get instant gap scores, a downloadable PDF roadmap,
        and practical guidance you can use internally.
      </p>

      <div class="grid-2" style="margin-top:18px;max-width:900px;margin-inline:auto;">
        <a class="card lift pad-lg mini" href={`${base}checklist/`} aria-label="Free readiness checklists">
          <h3 style="margin:0 0 6px;">Free resources</h3>
          <p class="muted small" style="margin:0;">Interactive readiness checklists, auto scoring, and PDF exports.</p>
          <div class="pill-row" style="margin-top:10px;">
            <span class="pill">Auto score</span>
            <span class="pill">PDF export</span>
            <span class="pill">No account</span>
          </div>
        </a>

        <a class="card lift pad-lg mini" href={`${base}blog`} aria-label="Insights">
          <h3 style="margin:0 0 6px;">Insights</h3>
          <p class="muted small" style="margin:0;">Articles and practical guidance on security, privacy, AI and assurance.</p>
          <div class="pill-row" style="margin-top:10px;">
            <span class="pill">How-to</span>
            <span class="pill">Templates</span>
            <span class="pill">Examples</span>
          </div>
        </a>
      </div>

      <div class="muted small" style="margin-top:16px;max-width:980px;margin-inline:auto;">
        We don’t store your checklist answers. PDFs are generated in your browser. If you share your email, we may send relevant resources. No spam.
        <a class="small" href={(import.meta.env.BASE_URL) + 'privacy'} style="margin-left:10px;">Privacy policy →</a>
      </div>
    </div>
  </section>

  <!-- REAL RESULTS (your existing carousel preserved) -->
  <section id="outcomes" class="container section">
    <h2>Real results</h2>
    <p class="muted" style="margin-top:-4px">What our clients have to say.</p>

    <div class="t-carousel" aria-roledescription="carousel">
      <div class="t-viewport" aria-live="polite">
        <div class="t-track" id="tTrack">
          <figure class="t-slide">
            <blockquote>
              <svg class="t-quote" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 11h3V5H5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3zm9 0h3V5h-5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3z" fill="currentColor"/>
              </svg>
              We expected a long, painful process. Instead, we were audit-ready far faster than planned — using the systems we already had. No drama, no surprises.
            </blockquote>
            <figcaption>
              <div class="t-avatar t-initial" aria-hidden="true">S</div>
              <div>
                <strong>Head of Technology</strong> — SaaS Platform<br/>
                <span class="muted small">Audit-ready evidence • low disruption</span>
              </div>
            </figcaption>
          </figure>

          <figure class="t-slide">
            <blockquote>
              <svg class="t-quote" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 11h3V5H5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3zm9 0h3V5h-5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3z" fill="currentColor"/>
              </svg>
              What stood out was how little disruption there was. Engineering stayed focused on delivery, not chasing evidence or sitting in endless compliance meetings.
            </blockquote>
            <figcaption>
              <div class="t-avatar t-initial" aria-hidden="true">C</div>
              <div>
                <strong>CTO</strong> — High-Growth Tech Company<br/>
                <span class="muted small">Minimal remediation • practical approach</span>
              </div>
            </figcaption>
          </figure>

          <figure class="t-slide">
            <blockquote>
              <svg class="t-quote" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 11h3V5H5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3zm9 0h3V5h-5v6c0 3 2 5 5 5v-2c-2 0-3-1-3-3z" fill="currentColor"/>
              </svg>
              Procurement stopped being a blocker. We finally had clear, defensible answers instead of scrambling late in the sales cycle.
            </blockquote>
            <figcaption>
              <div class="t-avatar t-initial" aria-hidden="true">F</div>
              <div>
                <strong>Founder &amp; CEO</strong> — B2B Software Company<br/>
                <span class="muted small">Reduced friction • reusable evidence</span>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="t-controls" aria-label="Carousel controls">
        <button class="t-btn" id="tPrev" aria-label="Previous">‹</button>
        <div class="t-dots" id="tDots" role="tablist" aria-label="Slides"></div>
        <button class="t-btn" id="tNext" aria-label="Next">›</button>
      </div>
    </div>

    <style is:inline>
      .t-viewport{overflow:hidden;border-radius:18px}
      .t-track{display:flex;flex-wrap:nowrap;transform:translateX(0);transition:transform .6s cubic-bezier(.22,.75,.25,1)}
      .t-slide{flex:0 0 100%;min-width:100%;box-sizing:border-box}
    </style>

    <script is:inline>
      (function(){
        const track = document.getElementById('tTrack');
        const slides = Array.from(track.children);
        const prev   = document.getElementById('tPrev');
        const next   = document.getElementById('tNext');
        const dotsCt = document.getElementById('tDots');

        let index = 0;
        let timer = null;

        slides.forEach((_, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('role','tab');
          b.setAttribute('aria-label', `Go to slide ${i+1}`);
          if(i === 0) b.setAttribute('aria-current','true');
          b.addEventListener('click', () => go(i, true));
          dotsCt.appendChild(b);
        });

        function updateUI(){
          const pct = -(index * 100);
          track.style.transform = `translateX(${pct}%)`;
          [...dotsCt.children].forEach((d, i) => {
            if(i === index) d.setAttribute('aria-current','true'); else d.removeAttribute('aria-current');
          });
        }
        function go(i, stopAuto=false){ index = (i + slides.length) % slides.length; updateUI(); if(stopAuto) restartAuto(); }
        function nextSlide(){ go(index + 1); }
        function prevSlide(){ go(index - 1, true); }

        prev.addEventListener('click', prevSlide);
        next.addEventListener('click', () => go(index + 1, true));

        function startAuto(){ timer = setInterval(nextSlide, 6500); }
        function stopAuto(){ clearInterval(timer); timer = null; }
        function restartAuto(){ stopAuto(); startAuto(); }

        const carousel = document.querySelector('.t-carousel');
        carousel.addEventListener('mouseenter', stopAuto);
        carousel.addEventListener('mouseleave', startAuto);
        carousel.addEventListener('focusin',  stopAuto);
        carousel.addEventListener('focusout', startAuto);

        updateUI();
        startAuto();
        addEventListener('resize', () => updateUI());
      })();
    </script>
  </section>

