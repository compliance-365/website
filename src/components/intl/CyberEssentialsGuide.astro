---
/* /uk/cyber-essentials-microsoft-365/ on www.compliance365.io.
   Matches the UK searches "automate cyber essentials" and "office 365
   cyber essentials". Control content: src/data/cyber-essentials.js. */
import Base from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import CinematicBackground from '../CinematicBackground.astro';
import { CONTROLS, QUESTIONS } from '../../data/cyber-essentials.js';
import { AU_ORIGIN, INTL_ORIGIN } from '../../data/site.js';

const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const url = `${INTL_ORIGIN}/uk/cyber-essentials-microsoft-365/`;
const title = 'Cyber Essentials on Microsoft 365: Automate the Controls';
const description = 'Where each Cyber Essentials control lives in Microsoft 365, Intune, Entra and Defender, which ones can be checked automatically, and what still needs a person.';
const automated = CONTROLS.filter((c) => c.automated).length;
const faq = [
  { q: 'Is Microsoft 365 in scope for Cyber Essentials?', a: 'Yes. Cloud services you use, including Microsoft 365, are in scope, as are the devices that access your organisation’s data, including staff-owned devices used for work.' },
  { q: 'Can Cyber Essentials be fully automated?', a: `Not fully. ${automated} of the 5 controls can be read from your Microsoft 365 tenant. Boundary firewalls and routers sit outside Microsoft 365, so they are checked and attested by hand.` },
  { q: 'Who issues the certificate?', a: 'An IASME-licensed Certification Body, chosen by you. Cyber Essentials is a self-assessment verified by that body; Cyber Essentials Plus adds independent technical testing of your systems.' },
  { q: 'How often does it need renewing?', a: 'Certification is renewed every year, so the controls need to stay true between renewals, not just on the day you submit.' },
];
const articleLd = {
  '@type': 'Article', headline: title, description, url, inLanguage: 'en-GB',
  author: { '@id': `${AU_ORIGIN}/#org` }, publisher: { '@id': `${AU_ORIGIN}/#org` },
  datePublished: '2026-11-01', dateModified: '2026-11-01',
  about: [{ '@type': 'Thing', name: 'Cyber Essentials' }, { '@type': 'Thing', name: 'Microsoft 365' }],
};
const faqLd = { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title={title} description={description} schema={[articleLd, faqLd]}
  breadcrumbs={[
    { name: 'Compliance365', url: `${INTL_ORIGIN}/` },
    { name: 'United Kingdom', url: `${INTL_ORIGIN}/uk/` },
    { name: 'Cyber Essentials on Microsoft 365', url },
  ]}>
  <Header />
  <main id="main-content" tabindex="-1">

  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner" style="grid-template-columns:1fr;max-width:900px;">
      <div class="svc-hero-copy">
        <p class="eyebrow">United Kingdom · Cyber Essentials · Microsoft 365</p>
        <h1>Cyber Essentials on Microsoft 365: <em>{automated} of 5 controls checked automatically.</em></h1>
        <p class="section-lead">Most of what Cyber Essentials asks for is a setting in Microsoft 365, Intune, Entra or Defender. Here is where each control lives, what can be read straight from your tenant, and the one that still needs a person.</p>
        <div class="hero-ctas">
          <a href="/uk/cyber-essentials-checker/" class="btn-hdk-primary">Check your readiness</a>
          <a href={ctaUrl} class="btn-hdk-ghost" target="_blank" rel="noopener">Book a 30-min call</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:#FAF7F1;">
    <div class="container" style="max-width:1000px;">
      <div class="ce-strip" aria-label="The five Cyber Essentials controls">
        {CONTROLS.map((c, i) => (
          <a class="ce-pill" href={`#${c.id}`}>
            <span class="ce-n">{i + 1}</span>{c.name}
            <span class={`ce-auto ${c.automated ? 'is-auto' : 'is-manual'}`}>{c.automated ? 'Read from tenant' : 'Attested'}</span>
          </a>
        ))}
      </div>

      {CONTROLS.map((c, i) => (
        <article class="ce-control" id={c.id}>
          <header>
            <span class="ce-n ce-n-lg">{i + 1}</span>
            <h2>{c.name}</h2>
            <span class={`ce-auto ${c.automated ? 'is-auto' : 'is-manual'}`}>{c.automated ? 'Read from your tenant' : 'Checked by hand'}</span>
          </header>
          <div class="ce-cols">
            <div>
              <h3>What Cyber Essentials asks</h3>
              <ul>{c.asks.map((a) => <li>{a}</li>)}</ul>
            </div>
            <div>
              <h3>Where it lives in Microsoft 365</h3>
              <p>{c.microsoft}</p>
              {c.checks.length > 0 && (
                <p class="ce-checks"><b>Checkpoint checks:</b> {c.checks.length} posture check{c.checks.length === 1 ? '' : 's'} read this control from your tenant and flag it when it drifts.</p>
              )}
            </div>
          </div>
        </article>
      ))}

      <div class="ce-scope">
        <h2>Before you start: scope</h2>
        <p>Cloud services you use, including Microsoft 365, are in scope. So is every device that reaches your organisation's data, including staff-owned laptops and phones used for work. Getting the scope right first saves the most common surprise at submission.</p>
      </div>

      <h2 class="ce-h2">Common questions</h2>
      <div class="ce-faq">
        {faq.map((f, i) => (
          <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>

      <div class="ce-next">
        <div>
          <h3>See where you stand in five minutes</h3>
          <p>{QUESTIONS.length} questions across the five controls. Anything that would fail an assessment is listed as a blocker, with where to fix it in Microsoft 365.</p>
        </div>
        <div class="ce-next-actions">
          <a class="btn-hdk-primary" href="/uk/cyber-essentials-checker/">Start the checker</a>
          <a class="ce-link" href="/uk/">Compliance365 in the UK →</a>
        </div>
      </div>
      <p class="ce-note">General guidance, summarised from the NCSC and IASME Cyber Essentials requirements for IT infrastructure. We prepare your evidence; your certificate is issued by an IASME-licensed Certification Body you choose. Last reviewed 1 November 2026.</p>
    </div>
  </section>

  </main>
  <Footer />

  <style>
    .ce-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: .6rem; margin-bottom: 2rem; }
    .ce-pill { display: flex; flex-direction: column; gap: .35rem; background: #fff; border: 1px solid #E8E1D5; border-radius: 12px; padding: .9rem; text-decoration: none; color: #0B0B0C; font-weight: 800; font-size: .9rem; }
    .ce-pill:hover { border-color: #BE4A1E; }
    .ce-n { display: inline-flex; width: 26px; height: 26px; border-radius: 8px; background: #FBEFE8; color: #A63A12; font-weight: 800; font-size: .8rem; align-items: center; justify-content: center; }
    .ce-n-lg { width: 34px; height: 34px; font-size: 1rem; flex: none; }
    .ce-auto { display: inline-block; width: fit-content; font-size: .68rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; padding: .2rem .5rem; border-radius: 6px; }
    .ce-auto.is-auto { background: #ecfdf5; color: #047857; }
    .ce-auto.is-manual { background: #FEF3C7; color: #92400E; }
    .ce-control { background: #fff; border: 1px solid #E8E1D5; border-radius: 16px; padding: 1.5rem 1.6rem; margin-bottom: 1rem; scroll-margin-top: 90px; }
    .ce-control header { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-bottom: 1rem; }
    .ce-control h2 { margin: 0; font-size: 1.35rem; flex: 1; }
    .ce-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .ce-cols h3 { margin: 0 0 .5rem; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: #A63A12; }
    .ce-cols ul { margin: 0; padding-left: 1.1rem; line-height: 1.65; font-size: .92rem; color: #2A2724; }
    .ce-cols li { margin-bottom: .4rem; }
    .ce-cols p { margin: 0; font-size: .92rem; line-height: 1.65; color: #2A2724; }
    .ce-checks { margin-top: .8rem !important; padding: .7rem .9rem; background: #FAF7F1; border-radius: 10px; font-size: .85rem !important; }
    .ce-scope { margin: 2rem 0; padding: 1.25rem 1.5rem; border-left: 4px solid #BE4A1E; background: #fff; border-radius: 0 12px 12px 0; }
    .ce-scope h2 { margin: 0 0 .4rem; font-size: 1.15rem; }
    .ce-scope p { margin: 0; font-size: .92rem; line-height: 1.65; color: #4A4740; }
    .ce-h2 { margin: 2.5rem 0 1rem; }
    .ce-faq { display: grid; gap: .6rem; }
    .ce-faq details { background: #fff; border: 1px solid #E8E1D5; border-radius: 12px; padding: 1rem 1.2rem; }
    .ce-faq summary { cursor: pointer; font-weight: 800; }
    .ce-faq p { margin: .6rem 0 0; font-size: .92rem; line-height: 1.65; color: #4A4740; }
    .ce-next { margin-top: 2rem; display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: center; background: #0B0B0C; color: #FAF7F1; border-radius: 16px; padding: 1.5rem 1.75rem; }
    .ce-next h3 { margin: 0 0 .3rem; color: #FAF7F1; }
    .ce-next p { margin: 0; color: rgba(250,247,241,.75); font-size: .92rem; }
    .ce-next-actions { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
    .ce-link { color: #F0A97F; font-weight: 700; font-size: .85rem; }
    .ce-note { font-size: .8rem; color: #6B6860; margin-top: 1.25rem; line-height: 1.6; }
    @media (max-width: 820px) { .ce-strip { grid-template-columns: 1fr 1fr; } .ce-cols, .ce-next { grid-template-columns: 1fr; } .ce-next-actions { align-items: flex-start; } }
  </style>
</Base>
