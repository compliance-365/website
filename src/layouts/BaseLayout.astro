---
import '../styles/responsive.css';

const {
  title = 'Compliance365 — Cyber, Privacy & AI Governance',
  description = 'ISO 27001, ISO 42001, ISO 27701 & SOC 2 delivered faster with automation and SharePoint evidence.',
  ogImage = (Astro.site
    ? new URL('assets/og-default.png', Astro.site).toString()
    : (import.meta.env.BASE_URL) + 'assets/og-default.png'),
  schema = []
} = Astro.props ?? {};

const base = import.meta.env.BASE_URL || '/';
const siteUrl = 'https://www.compliance365.com.au';
const canonical = Astro.url?.href || `${siteUrl}/`;

// GA4 — leave '' to disable
const GA_ID = 'G-082VYX6D26';

/** Brand assets (make sure these exist in /public/assets) */
const LOGO_512 = `${siteUrl}/assets/logo-512.png`;
const LOGO_192 = `${siteUrl}/assets/logo-192.png`;

/* ---------------- JSON-LD: Organization + WebSite ---------------- */
const ORG = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Compliance365 Australia',
  alternateName: 'Compliance 365',
  url: siteUrl,
  logo: LOGO_512,
  sameAs: [
    'https://www.linkedin.com/company/compliance-365/'
    // Add more only if you actually own them:
    // ,'https://x.com/compliance365au','https://www.facebook.com/compliance365au/'
  ],
  contactPoint: [{
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'hello@compliance365.com.au',
    areaServed: 'AU'
  }],
  serviceArea: { '@type': 'Country', name: 'Australia' },
  knowsAbout: [
    'ISO 27001','ISO 27701','ISO 42001','SOC 2',
    'ACSC Essential Eight','NIST CSF','IRAP','ISM','DISP'
  ]
};

const WEBSITE = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Compliance365',
  inLanguage: 'en-AU',
  publisher: { '@id': `${siteUrl}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

// Merge any per-page schema passed via <Base schema={...} />
const pageGraph = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const fullGraph = [ORG, WEBSITE, ...pageGraph];
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': fullGraph });
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>

    <!-- Google site verification -->
    <meta name="google-site-verification" content="fVhBOuNty9-ozH-lL9FvtPHiQ25rDMA7PjZIPDdgmbk" />

    <!-- Indexing & meta -->
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#4F46E5" />

    <!-- Discovery hints -->
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteUrl}/sitemap-index.xml`} />
    <link rel="robots" href={`${siteUrl}/robots.txt`} />
    <link rel="ai" href={`${siteUrl}/ai.txt`} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Compliance365" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons / PWA identity -->
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/logo-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta name="application-name" content="Compliance365" />
    <meta name="apple-mobile-web-app-title" content="Compliance365" />
    <meta name="msapplication-TileImage" content={LOGO_192} />
    <meta name="msapplication-TileColor" content="#4F46E5" />

    <!-- Fonts & CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={(import.meta.env.BASE_URL) + 'assets/brand.css'} />
    <link rel="stylesheet" href="/src/styles/parallax.css" />

    <!-- Critical fallback styles -->
    <style>
      body{font-family:Nunito,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;margin:0}
      a{color:#4F46E5}
      .container{max-width:1120px;margin:0 auto;padding:0 22px}
    </style>

    <!-- Consent Mode default (server-safe) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent','default',{
        ad_user_data:'denied',
        ad_personalization:'denied',
        ad_storage:'denied',
        analytics_storage:'denied',
        functionality_storage:'granted',
        security_storage:'granted',
        wait_for_update:500
      });
      // Expose GA ID from server safely
      window.__GA_ID__ = {JSON.stringify(GA_ID)};
    </script>

    <!-- Single JSON-LD block -->
    <script type="application/ld+json" set:html={ldJson}></script>
  </head>

  <body>
    <slot />

    <!-- Cookie Banner -->
    <div id="cookie-banner"
         aria-live="polite"
         style="position:fixed;inset:auto 0 0 0;background:#f8fafc;border-top:1px solid #e2e8f0;
                padding:12px 14px;display:block;z-index:9999;box-shadow:0 -8px 22px -18px rgba(0,0,0,.4)">
      <div class="container" style="display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap">
        <p style="margin:0;flex:1;min-width:260px;font-size:.95rem;line-height:1.4">
          We use cookies to improve your experience and measure traffic.
          See our <a href="/privacy" style="color:#4f46e5">Privacy Policy</a>.
        </p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button id="cookieReject" type="button"
                  style="padding:8px 14px;border-radius:8px;border:1px solid #cbd5e1;background:#fff;cursor:pointer">
            Reject
          </button>
          <button id="cookieAccept" type="button"
                  style="padding:8px 14px;border-radius:8px;border:0;background:#4f46e5;color:#fff;cursor:pointer">
            Accept
          </button>
        </div>
      </div>
    </div>

    <!-- Cookie/Consent controller + GA loader -->
    <script is:inline>
      (function(){
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        const CONSENT_KEY = 'cookieConsentV2';
        const banner = document.getElementById('cookie-banner');

        const GA_MEASUREMENT_ID = window.__GA_ID__ || '';
        const GA_ENABLED = !!GA_MEASUREMENT_ID;

        function show(){ if(banner) banner.style.display='block'; }
        function hide(){ if(banner) banner.style.display='none'; }

        function enableAnalytics(){
          if (!GA_ENABLED || window.__gaLoaded) return;
          window.__gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
          document.head.appendChild(s);
          s.onload = function(){
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
          };
        }

        function apply(choice){
          if(choice === 'accepted'){
            gtag('consent','update',{
              ad_storage:'granted',
              ad_user_data:'granted',
              ad_personalization:'granted',
              analytics_storage:'granted'
            });
            hide();
            enableAnalytics();
          } else if(choice === 'rejected'){
            gtag('consent','update',{
              ad_storage:'denied',
              ad_user_data:'denied',
              ad_personalization:'denied',
              analytics_storage:'denied'
            });
            hide();
          } else {
            show();
          }
        }

        // initial state
        var saved = null;
        try{ saved = localStorage.getItem(CONSENT_KEY); }catch{}
        apply(saved);

        // handlers
        document.addEventListener('click', function(e){
          var btn = e.target.closest('#cookieAccept, #cookieReject');
          if(!btn) return;
          var choice = (btn.id === 'cookieAccept') ? 'accepted' : 'rejected';
          try{ localStorage.setItem(CONSENT_KEY, choice); }catch{}
          apply(choice);
        }, { passive: true });

        // footer hook
        window.showCookieSettings = function(){
          gtag('consent','update',{
            ad_storage:'denied',
            ad_user_data:'denied',
            ad_personalization:'denied',
            analytics_storage:'denied'
          });
          show();
        };
      })();
    </script>

    <!-- Welcome to Country Modal -->
    <div id="welcomeModal"
         style="display:none;position:fixed;inset:0;z-index:9998;
                background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
      <div style="background:#fff;border-radius:14px;max-width:500px;padding:28px;
                  text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.25);">
        <h2 style="margin-top:0;font-weight:900;color:#1e293b;">Welcome to Country</h2>
        <p style="line-height:1.6;font-size:1rem;color:#334155;">
          Compliance365 acknowledges the Traditional Owners of Country throughout Australia — and recognises their continuing connection to land, waters and community.
          We pay our respects to Elders past and present and extend that respect to all First Nations peoples.
        </p>
        <button id="closeWelcome"
                style="margin-top:16px;padding:8px 18px;border:none;border-radius:8px;background:#4f46e5;color:#fff;font-weight:600;cursor:pointer;">
          Continue
        </button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var MODAL_KEY = 'welcomeSeen';
        var modal = document.getElementById('welcomeModal');
        var btn = document.getElementById('closeWelcome');
        try { if (!localStorage.getItem(MODAL_KEY) && modal) modal.style.display = 'flex'; } catch (e) {}
        if (btn) {
          btn.addEventListener('click', function () {
            try { localStorage.setItem(MODAL_KEY, 'yes'); } catch (e) {}
            if (modal && modal.parentNode) modal.parentNode.removeChild(modal);
          });
        }
      })();
    </script>

    <!-- Apollo Website Tracker -->
    <script is:inline>
      (function initApollo(){
        var n = Math.random().toString(36).substring(7);
        var o = document.createElement('script');
        o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n;
        o.async = true; o.defer = true;
        o.onload = function(){ window.trackingFunctions?.onLoad?.({ appId: '68f9c631c8dea80021187ee4' }); };
        document.head.appendChild(o);
      })();
    </script>
  </body>
</html>
