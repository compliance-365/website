---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import '../../styles/case-studies.css';

const base = import.meta.env.BASE_URL || '/';
const site = Astro.site?.toString() || 'https://www.compliance365.com.au';

// Helper: absolute URL for images in JSON-LD
function abs(u) {
  if (!u) return undefined;
  return /^https?:\/\//i.test(u) ? u : new URL(u.replace(/^\/+/, ''), site).toString();
}

/**
 * Supported front-matter in content/case-studies/*.md:
 * - logo: "/images/logos/client.png"
 * - hero: { image: "/images/case-studies/hero.jpg", alt: "Network map" }
 * - sector: "Government"
 * - services: ["ISO 27001", "SOC 2"]
 * - tags: ["IS18","Essential Eight"]
 * - metrics: ["<strong>82%</strong> readiness", "Report in 4 weeks"]
 * - testimonial: { quote, name, title, avatar }
 * - seo: { image, description, keywords }
 * - date, updated
 * - ctaLabel, ctaUrl
 */
export async function getStaticPaths() {
  const entries = await Astro.glob('../../../content/case-studies/*.md');
  return entries.map((entry) => {
    const slug = entry.file.split('/').pop().replace(/\.md$/, '');
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
if (!entry) throw new Error('Case study entry not found');

const fm        = entry.frontmatter ?? {};
const title     = fm.title ?? 'Case Study';
const summary   = fm.summary ?? fm.description ?? '';
const hero      = fm.hero ?? null;
const logo      = fm.logo ?? null;
const sector    = fm.sector ?? null;
const timeline  = fm.timeline ?? null;
const services  = Array.isArray(fm.services) ? fm.services : [];
const tags      = Array.isArray(fm.tags) ? fm.tags : [];
const metrics   = Array.isArray(fm.metrics) ? fm.metrics : [];
const outcomes  = Array.isArray(fm.outcomes) ? fm.outcomes : [];
const testimonial = fm.testimonial ?? null;
const seo       = fm.seo ?? {};
const canonical = `${site}/case-studies/${Astro.params.slug}/`;

// Structured dossier — situation/constraint/delivery/outcome, same
// four-part shape as the homepage's case-study teaser.
const dossier      = fm.dossier ?? null;
const metricsBand  = Array.isArray(fm.metricsBand) ? fm.metricsBand : [];
const frameworks   = Array.isArray(fm.frameworks) ? fm.frameworks : [];

// Normalised image for JSON-LD
const heroImg   = abs(hero?.image) || abs(seo?.image);

// Build JSON-LD without spreads (keeps esbuild happy)
// NOTE: "CaseStudy" is not a schema.org type — Google silently discards nodes
// with an unrecognised @type, so these pages previously emitted no usable
// structured data at all. "Article" is the closest supported type for editorial
// case studies and is eligible for rich results.
const caseStudySchema = {
  "@type": "Article",
  "@id": `${canonical}#article`,
  "headline": title,
  "name": title,
  "url": canonical,
  "isPartOf": { "@id": `${site}#website` },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "author": { "@id": `${site}/#org` },
  "publisher": {
    "@type": "Organization",
    "name": "Compliance365",
    "url": site,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('assets/logo.png', site).toString()
    }
  }
};
if (summary) caseStudySchema.description = summary;
if (heroImg) caseStudySchema.image = heroImg;
if (fm.date) caseStudySchema.datePublished = new Date(fm.date).toISOString();
if (fm.updated) caseStudySchema.dateModified = new Date(fm.updated).toISOString();

const breadcrumbsSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumbs`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",         "item": site + "/" },
    { "@type": "ListItem", "position": 2, "name": "Case Studies", "item": `${site}/case-studies/` },
    { "@type": "ListItem", "position": 3, "name": title,          "item": canonical }
  ]
};

const pageSchema = [caseStudySchema, breadcrumbsSchema];

// CTA defaults
const ctaLabel = fm.ctaLabel ?? 'Book a call';
const ctaUrl   = fm.ctaUrl   ?? `${base}book/`;
---

<Base
  title={seo.title ?? `${title} — Case Study`}
  description={seo.description ?? summary}
  schema={pageSchema}
  ogType="article"
  publishedTime={caseStudySchema.datePublished}
  modifiedTime={caseStudySchema.dateModified}
  articleSection="Case Studies"
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="container" style="position:relative;z-index:1;">
      <a href={`${base}case-studies/`} class="back-link">← Back to Case Studies</a>

      <div class="svc-hero-copy" style="margin-top:22px;max-width:720px;">
        {logo && <img src={logo} alt="Client logo" loading="lazy" style="width:44px;height:44px;object-fit:contain;border-radius:8px;background:#fff;margin-bottom:18px;" />}
        <h1>{title}</h1>
        {summary && <p class="section-lead">{summary}</p>}

        <div class="cs-meta">
          {sector && <span class="cs-pill">{sector}</span>}
          {timeline && <span class="cs-pill"><b>{timeline}</b></span>}
          {services.map((s) => <span class="cs-pill">{s}</span>)}
        </div>

        {metrics.length > 0 ? (
          <div class="cs-metrics">
            {metrics.map((m) => (
              <div class="cs-card">
                <div class="cs-kpi" set:html={m}></div>
              </div>
            ))}
          </div>
        ) : outcomes.length > 0 && (
          <div class="cs-metrics">
            {outcomes.map((o) => (
              <div class="cs-card">
                <div class="cs-kpi">{o}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      {hero?.image && (
        <div class="cs-hero-img">
          <img src={hero.image} alt={hero.alt || 'Case study'} loading="lazy" />
        </div>
      )}
    </div>
  </section>

  <div class="container">
    <!-- Structured dossier: situation → constraint → delivery → outcome -->
    {dossier && (
      <div class="dossier">
        <div class="dossier-head">
          <h3>The engagement</h3>
          {fm.timeline && <span>{fm.timeline}</span>}
        </div>
        {dossier.situation && <div class="d-row"><div class="dk">Situation</div><div class="dv">{dossier.situation}</div></div>}
        {dossier.constraint && <div class="d-row"><div class="dk">Constraint</div><div class="dv">{dossier.constraint}</div></div>}
        {dossier.delivery && <div class="d-row"><div class="dk">Delivery</div><div class="dv">{dossier.delivery}</div></div>}
        {dossier.outcome && <div class="d-row"><div class="dk">Outcome</div><div class="dv"><strong>{dossier.outcome}</strong></div></div>}
      </div>
    )}

    <!-- Metrics band -->
    {metricsBand.length > 0 && (
      <div class="metrics-band">
        {metricsBand.map((m) => (
          <div class="mb-item"><b>{m.value}</b><span>{m.label}</span></div>
        ))}
      </div>
    )}

    <!-- Framework tags — real links to the actual service pages -->
    {frameworks.length > 0 && (
      <div class="fw-tags">
        {frameworks.map((f) => (
          <a href={`${base}services/${f.slug}/`} class="fw-tag">{f.name} →</a>
        ))}
      </div>
    )}
  </div>

  <!-- BODY -->
  <div class="cs-body">
    <article class="prose">
      {entry ? <entry.Content /> : <p>Coming soon.</p>}
    </article>

    <!-- Optional structured testimonial (most case studies embed the quote inline instead) -->
    {testimonial && (
      <div class="cs-quote">
        <p>“{testimonial.quote}”</p>
        <div class="who">
          {testimonial.avatar && <img src={testimonial.avatar} alt="" loading="lazy" />}
          <span>{testimonial.name}{testimonial.title ? ` — ${testimonial.title}` : ''}</span>
        </div>
      </div>
    )}

    <!-- CTA -->
    <section class="cs-cta">
      <div>
        <h3>Need a similar outcome?</h3>
        <p>
          We help government, health, and technology organisations achieve certification faster
          with automated evidence and expert delivery.
        </p>
      </div>
      <a href={ctaUrl} class="btn-hdk-primary">{ctaLabel}</a>
    </section>
  </div>

  <Footer />
</Base>
