---
import Base from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
const base = import.meta.env.BASE_URL || '/';
---
<Base title="Cookie Preferences — Compliance365">
  <Section title="Cookie Preferences">
    <div class="card">
      <p class="muted" style="margin-top:0">
        Toggle analytics cookies. We never use cookies for ads or personalization.
      </p>

      <div style="display:flex;align-items:center;gap:10px;margin:10px 0 16px">
        <input id="analyticsToggle" type="checkbox" />
        <label for="analyticsToggle"><strong>Analytics cookies</strong> (Google Analytics)</label>
      </div>

      <div style="display:flex;gap:8px">
        <button id="saveBtn" class="btn btn-primary">Save</button>
        <a class="btn btn-ghost" href={base}>Cancel</a>
      </div>

      <p class="small muted" style="margin-top:12px">
        See our <a href={base + 'privacy'}>Privacy Policy</a> for details.
      </p>
    </div>
  </Section>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    const KEY = 'c365_consent';
    const toggle = document.getElementById('analyticsToggle');
    const saved = localStorage.getItem(KEY);

    if(saved){
      try{
        const c = JSON.parse(saved);
        toggle.checked = c.analytics_storage === 'granted';
      }catch(_){}
    }

    document.getElementById('saveBtn')?.addEventListener('click', ()=>{
      const consent = {
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'ad_storage': 'denied',
        'analytics_storage': toggle.checked ? 'granted' : 'denied',
        'functionality_storage': 'granted',
        'security_storage': 'granted'
      };
      localStorage.setItem(KEY, JSON.stringify(consent));
      gtag('consent', 'update', consent);
      alert('Your preferences have been saved.');
      window.location.href = '{base}';
    });
  </script>
</Base>
