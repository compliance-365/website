    return (r.data.value||[]).length
      ? { status:"pass", detail:`${r.data.value.length} DLP policies active in Purview.` }
      : { status:"fail", detail:"No DLP policies configured." };
  },
  async labels(g) {
    const r = await g("/beta/security/informationProtection/sensitivityLabels");
    if (!r.ok) return { status:"partial", detail:"Sensitivity label endpoint unavailable — attest manually.", degraded:true };
    return (r.data.value||[]).length
      ? { status:"pass", detail:`${r.data.value.length} sensitivity labels published.` }
      : { status:"fail", detail:"No sensitivity labels published in Purview." };
