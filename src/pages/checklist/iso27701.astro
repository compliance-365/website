---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27701 (Privacy)';

/**
 * Acronym glossary (single source of truth)
 */
const GLOSSARY = {
  PIMS: { term: 'Privacy Information Management System', desc: 'Your organisation’s privacy governance, processes and evidence—how you manage personal information end-to-end.' },
  PII:  { term: 'Personally Identifiable Information', desc: 'Information that can identify a person (directly or indirectly), such as name, email, phone, Medicare number, IP address, or patient ID.' },
  DPO:  { term: 'Data Protection Officer', desc: 'A designated privacy lead (mandatory in some contexts) responsible for privacy oversight, advice, monitoring and reporting.' },
  PO:   { term: 'Privacy Officer', desc: 'The accountable person/team who runs privacy operations day-to-day (may or may not be a formal DPO).' },
  ROPA: { term: 'Record of Processing Activities', desc: 'A register of what personal data you process, why, where it flows, who you share it with, and how long you keep it.' },
  DPIA: { term: 'Data Protection Impact Assessment', desc: 'A structured assessment used when processing is likely to create high privacy risk (e.g., new tech, large-scale sensitive data).' },
  SRR:  { term: 'Subject Rights Request', desc: 'Requests from individuals to access, correct, delete, export or object to how their data is used.' },
  KPI:  { term: 'Key Performance Indicator', desc: 'A measurable target (e.g., “respond to privacy requests within 20 days”).' },
  DPA:  { term: 'Data Processing Agreement', desc: 'A contract clause/set that defines how a vendor must handle personal data and what controls they must apply.' },
  SCC:  { term: 'Standard Contractual Clauses', desc: 'Contract terms commonly used to support international data transfers in certain jurisdictions.' },
  TIA:  { term: 'Transfer Impact Assessment', desc: 'An assessment of transfer risks and safeguards when personal data is sent overseas.' },
  LOC:  { term: 'Local Contract / Local Clauses', desc: 'A local contractual mechanism or clauses used to manage transfer/processing obligations (varies by jurisdiction and contract model).' },
  M365: { term: 'Microsoft 365', desc: 'Microsoft’s productivity and security platform (e.g., SharePoint, Purview, Entra ID, Intune).' },
  Entra: { term: 'Microsoft Entra ID', desc: 'Identity and access management (formerly Azure AD) used to control access and enforce sign-in policies.' },
  Intune:{ term: 'Microsoft Intune', desc: 'Endpoint/device management used to enforce security baselines and configuration policies.' },
  Purview:{ term:'Microsoft Purview', desc:'Information protection, data governance and compliance tooling (labels, retention, DLP, eDiscovery).' },
};

/**
 * Groups (business language)
 */
const GROUPS = [
  { key:'gov', title:'Leadership & Ownership', blurb:'Define scope, assign ownership, keep policies current, track improvement.' },
  { key:'map', title:'Know Your Data',         blurb:'Maintain your data register and understand where personal data flows.' },
  { key:'ctrl',title:'Everyday Privacy Controls', blurb:'Minimise data, control access, manage consent, handle requests, train people.' },
  { key:'tp',  title:'Vendors & Overseas Data', blurb:'Vendor due diligence, contracts, and managing overseas transfers.' },
  { key:'ev',  title:'Audit-Ready Evidence',   blurb:'Store evidence, track metrics, test controls internally, and review with leadership.' },
];

/**
 * Questions (business language + explanations + examples + acronym refs)
 */
const QUESTIONS = [
  // Leadership & Ownership
  {
    id:'pims-scope', group:'gov',
    title:'We’ve clearly defined what personal information we manage and where the privacy program applies.',
    acronyms:['PIMS','PII'],
    why:'We’re looking for a clear scope so privacy obligations don’t fall through gaps (systems, regions, business units, products).',
    examples:[
      'A written scope statement covering products, systems, locations and key data types.',
      'A simple list of “in scope vs out of scope” (with justification).',
      'Privacy boundaries for subsidiaries/tenants/regions (e.g., AU only vs AU + EU).'
    ],
    tip:'Partial usually means “we have a rough idea, but it isn’t documented or consistently applied.”'
  },
  {
    id:'roles-dpo', group:'gov',
    title:'Privacy ownership is assigned and people know who decides, approves and responds.',
    acronyms:['DPO','PO','DPIA'],
    why:'We’re looking for accountability: who owns privacy risk, who runs requests, who signs off DPIAs, and who reports to leadership.',
    examples:[
      'Named privacy owner + backup, with responsibilities documented.',
      'Clear escalation path for complaints and incidents.',
      'A simple RACI for privacy operations (requests, incidents, assessments).'
    ]
  },
  {
    id:'policies', group:'gov',
    title:'Our privacy policies and notices are current, approved, and actually used in practice.',
    acronyms:['SRR'],
    why:'We’re looking for “rules people follow” (not shelfware): notices, consent approach, retention rules, incident handling, and request handling.',
    examples:[
      'Customer privacy notice reviewed in the last 12 months.',
      'Internal procedure for handling access/deletion requests.',
      'Retention rules documented (what is kept, why, and for how long).'
    ]
  },
  {
    id:'objectives', group:'gov',
    title:'We track a small set of privacy targets so leadership can see if privacy is improving.',
    acronyms:['KPI','SRR'],
    why:'We’re looking for measurable privacy performance (e.g., request turnaround, training completion, incidents, assessments completed).',
    examples:[
      'Targets for request response time and backlog.',
      'Quarterly reporting to leadership on trends and hotspots.',
      'Training completion rate by role.'
    ]
  },

  // Know Your Data
  {
    id:'ropa', group:'map',
    title:'We maintain a “what personal data we process and why” register that is kept up to date.',
    acronyms:['ROPA','PII'],
    why:'We’re looking for a defensible register that connects processing activities to purpose, sharing, retention and safeguards.',
    examples:[
      'ROPA entries for core business processes (support, billing, product telemetry).',
      'Each entry includes purpose, categories of data, systems, recipients/vendors and retention.',
      'A simple review cadence (e.g., quarterly or on major changes).'
    ]
  },
  {
    id:'pii-flows', group:'map',
    title:'We can explain where personal data comes from, where it goes, and who we share it with.',
    acronyms:['PII'],
    why:'We’re looking for visibility of data flows so you can answer customer due diligence and respond to incidents quickly.',
    examples:[
      'A diagram showing collection → app → database → analytics → support tooling.',
      'List of vendors/processors that receive personal data.',
      'Identification of cross-border transfers (if any).'
    ]
  },
  {
    id:'dpia', group:'map',
    title:'We assess high-risk changes before launch (new features, new vendors, new uses of data).',
    acronyms:['DPIA'],
    why:'We’re looking for a repeatable method to identify high privacy risk early and document decisions/safeguards.',
    examples:[
      'DPIA trigger rules (e.g., new sensitive data use, large-scale monitoring, new AI profiling).',
      'A DPIA template with risk scoring and sign-off.',
      'Evidence of DPIAs completed for recent major changes.'
    ]
  },

  // Everyday Privacy Controls
  {
    id:'controls', group:'ctrl',
    title:'We only collect what we need, keep it only as long as needed, and restrict access appropriately.',
    acronyms:['PII'],
    why:'We’re looking for privacy-by-design in practice: minimisation, retention, access control, and secure handling.',
    examples:[
      'Default retention periods with auto-deletion where possible.',
      'Access based on role (e.g., support access is time-bound and logged).',
      'Separate environments/data sets for test vs production.'
    ]
  },
  {
    id:'consent', group:'ctrl',
    title:'Where consent is required, we can prove it and we can prove when it was changed or withdrawn.',
    acronyms:[],
    why:'We’re looking for auditable records: what was agreed to, when, how it was captured, and how changes are handled.',
    examples:[
      'Consent logs linked to user/customer records.',
      'Preference centre or settings page with change history.',
      'A process to honour opt-outs in downstream systems (e.g., marketing tools).'
    ]
  },
  {
    id:'rights', group:'ctrl',
    title:'We can reliably handle privacy requests (access, correction, deletion) within a defined timeframe.',
    acronyms:['SRR'],
    why:'We’re looking for a workflow and evidence: intake, identity verification, triage, completion, and response.',
    examples:[
      'Ticket workflow with timestamps and assigned owner.',
      'Identity verification step before disclosure.',
      'Templates for responses and refusal reasons (where applicable).'
    ]
  },
  {
    id:'training', group:'ctrl',
    title:'Privacy training is assigned by role and we can show who completed it.',
    acronyms:[],
    why:'We’re looking for competence evidence—especially for staff who handle personal data, support requests, or manage vendors.',
    examples:[
      'Annual refresher + onboarding module.',
      'Extra training for support, engineering, and leadership.',
      'Completion reports and follow-up for overdue training.'
    ]
  },

  // Vendors & Overseas Data
  {
    id:'processors', group:'tp',
    title:'We assess privacy risk in vendors and contracts clearly define privacy expectations.',
    acronyms:['DPA','SCC'],
    why:'We’re looking for due diligence + contractual coverage + ongoing change control (new sub-processors).',
    examples:[
      'Vendor risk assessment including what data they get and what controls they have.',
      'DPA in place for vendors handling personal data.',
      'Sub-processor register and a notification/review process.'
    ]
  },
  {
    id:'xfer', group:'tp',
    title:'If personal data goes overseas, we assess and document transfer risks and safeguards.',
    acronyms:['SCC','TIA','LOC'],
    why:'We’re looking for evidence that cross-border transfers are understood, approved, and monitored over time.',
    examples:[
      'A register of overseas hosting/support access locations.',
      'Transfer assessment documented for key transfers.',
      'Review trigger when vendors change regions or sub-processors.'
    ]
  },

  // Audit-Ready Evidence
  {
    id:'evidence', group:'ev',
    title:'Privacy evidence is stored in one place with clear versioning so we can answer audits quickly.',
    acronyms:['M365','Purview','Entra','Intune'],
    why:'We’re looking for audit-ready evidence: policies, registers, DPIAs, request logs, vendor contracts, approvals.',
    examples:[
      'SharePoint library with structured folders and naming.',
      'Version control enabled and ownership defined.',
      'Retention labels or a basic retention policy applied.'
    ]
  },
  {
    id:'metrics', group:'ev',
    title:'We report privacy activity so we can spot trends and reduce repeat issues.',
    acronyms:['SRR'],
    why:'We’re looking for operational visibility: request volume, backlog, incidents, DPIAs, vendor reviews.',
    examples:[
      'Monthly dashboard covering request volumes and completion time.',
      'Trends on complaint themes and root causes.',
      'Training completion and overdue metrics.'
    ]
  },
  {
    id:'iaudit', group:'ev',
    title:'We regularly check privacy controls internally and track fixes through to completion.',
    acronyms:[],
    why:'We’re looking for internal assurance: findings, corrective actions, and closure evidence.',
    examples:[
      'Internal audit plan and report.',
      'Corrective action register with owners and dates.',
      'Proof that actions were completed and verified.'
    ]
  },
  {
    id:'review', group:'ev',
    title:'Leadership reviews privacy performance and makes decisions on priorities and resourcing.',
    acronyms:['PIMS'],
    why:'We’re looking for management oversight: risks, incidents, complaints, metrics, and improvement actions.',
    examples:[
      'Management review minutes (quarterly or biannual).',
      'Decisions recorded (e.g., invest in automation, fix backlog).',
      'Actions assigned and tracked to closure.'
    ]
  },
];

// Bundle for JS to consume (single source of truth)
const CHECKLIST_DATA = { STANDARD, GROUPS, QUESTIONS, GLOSSARY };
---

<Base
  title="ISO 27701 Free Privacy Readiness Checklist"
  description="Free ISO 27701 privacy readiness checklist for privacy officers, CISOs and compliance leaders. Assess privacy maturity, see your readiness score and download a PDF roadmap to certification."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 27701 privacy readiness checklist (free)</h1>
    <p class="muted" style="max-width:820px">
      Answer a short set of business-friendly questions to see how mature your privacy practices are.
      You’ll get a readiness score and a PDF report explaining gaps, risks and next steps.
    </p>

    <div class="info-cards">
      <div class="card soft">
        <h4>Objective</h4>
        <p class="small">
          Understand how close you are to a consistent, audit-ready privacy program aligned to ISO 27701.
        </p>
      </div>
      <div class="card soft">
        <h4>Scoring</h4>
        <p class="small"><strong>Yes / Partial / No</strong>. Your progress and score update automatically.</p>
      </div>
      <div class="card soft">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown, top gaps and practical next steps.</p>
      </div>
    </div>
  </section>

  <section class="container section">

    <!-- Tabs -->
    <div class="tabs">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill" aria-current="page">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress">
      <div id="bar" class="progress-bar"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div class="stickyScore">
        <div class="stickyLeft">
          <div class="stickyTitle">Your readiness</div>
          <div class="stickyMeta muted small" id="answeredMeta">0/0 answered</div>
        </div>
        <div class="stickyRight">
          <div id="scoreNum" class="scoreNum">0%</div>
          <div class="scoreText">
            <div><strong id="scoreLabel">Not started</strong></div>
            <div id="scoreHint" class="muted small">Answer the questions to see your readiness.</div>
          </div>
        </div>
      </div>

      <div id="form" class="form-grid">
        {GROUPS.map((grp) => (
          <section class="group">
            <div class="groupHead">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.2rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}>
                  <div class="qTop">
                    <label class="qTitle">{q.title}</label>

                    <div class="qMeta">
                      <button class="linklike" type="button" data-toggle={`ex-${q.id}`}>
                        What we’re looking for (examples)
                      </button>

                      {q.acronyms?.length ? (
                        <span class="qChips">
                          {q.acronyms.map(a => (
                            <span
                              class="chip"
                              title={`${GLOSSARY[a]?.term || a}: ${GLOSSARY[a]?.desc || ''}`}
                            >
                              {a}
                            </span>
                          ))}
                        </span>
                      ) : null}
                    </div>
                  </div>

                  <div id={`ex-${q.id}`} class="explain" style="display:none;">
                    <p class="small" style="margin:0 0 6px;">
                      <strong>What good looks like:</strong> {q.why}
                    </p>
                    <ul class="small" style="margin:0; padding-left:18px;">
                      {q.examples?.map(ex => <li>{ex}</li>)}
                    </ul>
                    {q.tip ? (
                      <p class="small muted" style="margin:8px 0 0;"><strong>Tip:</strong> {q.tip}</p>
                    ) : null}
                  </div>

                  <div class="opts">
                    <button class="opt pill" data-v="2" type="button" title="In place and evidenced">Yes</button>
                    <button class="opt pill" data-v="1" type="button" title="Partly in place or inconsistent">Partial</button>
                    <button class="opt pill" data-v="0" type="button" title="Not in place yet">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Acronym glossary (visible, simple) -->
    <div class="card soft" style="margin-top:14px">
      <h3 style="margin:0 0 6px">Acronym guide (plain English)</h3>
      <p class="muted small" style="margin:0 0 10px">
        Hover over the acronym chips in each question for quick definitions, or use this guide:
      </p>
      <div class="glossaryGrid">
        {Object.entries(GLOSSARY).map(([k,v]) => (
          <div class="glossaryItem">
            <div class="glossKey">{k}</div>
            <div class="glossBody">
              <div class="glossTerm">{v.term}</div>
              <div class="muted small">{v.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <!-- Single source of truth for JS -->
  <script type="application/json" id="checklistData">
    {JSON.stringify(CHECKLIST_DATA)}
  </script>

  <script is:inline>
(() => {
  'use strict';

  const API_URL = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  const dataEl = document.getElementById('checklistData');
  const DATA = dataEl ? JSON.parse(dataEl.textContent) : {};
  const STANDARD = DATA.STANDARD || "ISO 27701 (Privacy)";
  const GROUPS = Array.isArray(DATA.GROUPS) ? DATA.GROUPS : [];
  const QUESTIONS = Array.isArray(DATA.QUESTIONS) ? DATA.QUESTIONS : [];
  const GLOSSARY = DATA.GLOSSARY || {};

  (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

  function setup(){
    const form         = document.getElementById('form');
    const bar          = document.getElementById('bar');
    const scoreNum     = document.getElementById('scoreNum');
    const scoreLabel   = document.getElementById('scoreLabel');
    const scoreHint    = document.getElementById('scoreHint');
    const resetBtn     = document.getElementById('resetBtn');
    const pdfBtn       = document.getElementById('pdfBtn');
    const answeredMeta = document.getElementById('answeredMeta');

    const modal        = document.getElementById('leadModal');
    const leadForm     = document.getElementById('leadForm');
    const cancelLead   = document.getElementById('cancelLead');
    const nameEl       = document.getElementById('name');
    const emailEl      = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    function refreshGroupCounters(){
      let totalAnswered = 0;

      GROUPS.forEach(grp => {
        const total = QUESTIONS.filter(q=>q.group===grp.key).length;
        const ansd  = QUESTIONS
          .filter(q=>q.group===grp.key)
          .map(q=>state[q.id])
          .filter(v=>v!==null).length;

        totalAnswered += ansd;

        const el = document.getElementById('g-'+grp.key);
        if(el) el.textContent = `${ansd}/${total} answered`;
      });

      if (answeredMeta) answeredMeta.textContent = `${totalAnswered}/${QUESTIONS.length} answered`;
    }
    refreshGroupCounters();

    form?.addEventListener('click', (e)=>{
      // Accordion toggle
      const t = e.target.closest('button.linklike');
      if (t && form.contains(t)) {
        const id = t.getAttribute('data-toggle');
        const el = id ? document.getElementById(id) : null;
        if (el) {
          const open = el.style.display !== 'none';
          el.style.display = open ? 'none' : 'block';
          t.textContent = open ? 'What we’re looking for (examples)' : 'Hide details';
        }
        return;
      }

      // Answer select
      const btn = e.target.closest('button.opt'); if(!btn || !form.contains(btn)) return;
      const field = btn.closest('.field'); if(!field) return;
      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);
      state[id] = val;

      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');

      refreshGroupCounters();
      update();
    });

    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form?.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));

      // Reset open explainers
      form?.querySelectorAll('.explain').forEach(el => { el.style.display = 'none'; });
      form?.querySelectorAll('button.linklike').forEach(b => { b.textContent = 'What we’re looking for (examples)'; });

      refreshGroupCounters();
      update();
    });

    pdfBtn?.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if(modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

    leadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name  = (nameEl?.value || '').trim();
      const email = (emailEl?.value || '').trim();

      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('Please enter your name and a valid email.');
        return;
      }

      const Q_MIN = QUESTIONS.map(q => ({ id: q.id, title: q.title, group: q.group }));
      const G_MIN = GROUPS.map(g => ({ key: g.key, title: g.title }));

      const payload = {
        name,
        email,
        subject: `Checklist lead: ${STANDARD}`,
        message: JSON.stringify({
          checklist: STANDARD,
          checklistId: 'iso27701',
          timestamp: new Date().toISOString(),
          ua: navigator.userAgent,
          ...compute(state),
          total: QUESTIONS.length,
          answers: state,
          questions: Q_MIN,
          groups: G_MIN
        })
      };

      try {
        if (!API_URL) throw new Error('API_URL missing');
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const txt = await res.text().catch(()=> '');
        if (!res.ok) {
          console.warn('[27701 lead] POST failed:', res.status, txt);
          alert('We could not notify our team automatically, but your PDF will still download.');
        }
      } catch (err) {
        console.warn('[27701 lead] POST error:', err);
        alert('We could not notify our team automatically, but your PDF will still download.');
      }

      try {
        const s = compute(state);
        if (window.gtag) {
          window.gtag('event', 'checklist_submit', {
            event_category: 'Checklist',
            event_label: STANDARD,
            checklist_standard: STANDARD,
            checklist_id: 'iso27701',
            answered: s.answered,
            score: s.score
          });
        }
      } catch (err) {
        console.warn('GA4 checklist_submit event failed', err);
      }

      closeModal();
      generatePDF(state, { name, email });
    });

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);

      if (bar) bar.style.width = pct + '%';
      if (scoreNum) scoreNum.textContent = `${score}%`;

      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered === 0) {
        label = 'Not started';
        hint  = 'Answer the questions to see your readiness.';
      } else if (score <= 30) {
        label = 'High Risk (0–30)';
        hint  = 'Start with ownership, data register, request handling, vendor contracts, and evidence hygiene.';
      } else if (score <= 60) {
        label = 'Partially Ready (31–60)';
        hint  = 'Prioritise consistency: close foundational gaps and improve evidence so you can answer audits quickly.';
      } else if (score <= 85) {
        label = 'Nearly Audit-Ready (61–85)';
        hint  = 'Close the remaining “Partial/No” items and package evidence for an audit-ready narrative.';
      } else {
        label = 'Certification-Ready (86–100)';
        hint  = 'Focus on validation, evidence freshness and audit preparation.';
      }

      if (scoreLabel) scoreLabel.textContent = label;
      if (scoreHint)  scoreHint.textContent  = hint;
      refreshGroupCounters();
    }
  }

  function compute(state){
    const answered = Object.values(state).filter(v => v !== null).length;
    const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
    const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
    return { answered, score: isNaN(score) ? 0 : score };
  }

  function getBand(score, answered){
    if (!answered) return { key:'na', title:'Not started', desc:'Complete the checklist to generate your Trust Score.' };
    if (score <= 30) return { key:'hr',  title:'0–30 — High Risk',             desc:'Missing privacy foundations. Structured remediation required.' };
    if (score <= 60) return { key:'pr',  title:'31–60 — Partially Ready',      desc:'Core elements exist. Prioritisation and closure of key gaps needed.' };
    if (score <= 85) return { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close minor gaps and package evidence for audit.' };
    return              { key:'cr',      title:'86–100 — Certification-Ready', desc:'Controls largely in place. Focus on validation and audit packaging.' };
  }

  function drawTrustBands(doc, x, y, w, score, answered){
    const pad = 6;
    const rowH = 18;
    const gap = 6;

    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('What Your Trust Score Really Means', x, y);
    y += 6;

    doc.setFont('helvetica','normal');
    doc.setFontSize(10);
    doc.setTextColor(80);
    doc.text('Your ISO 27701 Trust Score shows how close you are to a consistent, audit-ready privacy program.', x, y);
    y += 8;

    if (!answered) {
      doc.setFillColor(243,244,246);
      doc.setDrawColor(229,231,235);
      doc.roundedRect(x, y, w, rowH, 3, 3, 'FD');

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text('Not started', x + pad, y + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(80);
      doc.text('Answer the questions to generate your Trust Score and PDF roadmap.', x + pad, y + 14);

      return y + rowH + 2;
    }

    const rows = [
      { key:'hr',  title:'0–30 — High Risk',              desc:'Missing privacy foundations. Structured remediation required.' },
      { key:'pr',  title:'31–60 — Partially Ready',       desc:'Core elements exist. Prioritisation and closure of key gaps needed.' },
      { key:'nar', title:'61–85 — Nearly Audit-Ready',    desc:'Close minor gaps and package evidence for audit.' },
      { key:'cr',  title:'86–100 — Certification-Ready',  desc:'Controls largely in place. Focus on validation and audit packaging.' },
    ];

    const fills = {
      hr:  [254,226,226],
      pr:  [224,231,255],
      nar: [254,249,195],
      cr:  [209,250,229],
    };

    const band = getBand(score, answered);

    rows.forEach((r, i) => {
      const yy = y + i * (rowH + gap);

      const fc = fills[r.key];
      doc.setFillColor(fc[0], fc[1], fc[2]);
      doc.setDrawColor(229,231,235);
      doc.setLineWidth(0.2);
      doc.roundedRect(x, yy, w, rowH, 4, 4, 'FD');

      if (r.key === band.key) {
        doc.setDrawColor(79,70,229);
        doc.setLineWidth(0.8);
        doc.roundedRect(x, yy, w, rowH, 4, 4, 'S');

        doc.setFillColor(79,70,229);
        doc.roundedRect(x + 2, yy + 2, 3, rowH - 4, 2, 2, 'F');
      }

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text(r.title, x + pad + 4, yy + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(55);
      const lines = doc.splitTextToSize(r.desc, w - (pad * 2) - 8);
      doc.text(lines, x + pad + 4, yy + 14);
    });

    const chip = `Your score: ${score}%`;
    doc.setFont('helvetica','bold'); doc.setFontSize(10);
    const chipW = Math.max(28, doc.getTextWidth(chip) + 10);
    const chipH = 8;
    const chipX = x + w - chipW;
    const chipY = y - 10;

    doc.setFillColor(17,24,39);
    doc.setTextColor(255,255,255);
    doc.roundedRect(chipX, chipY, chipW, chipH, 3, 3, 'F');
    doc.text(chip, chipX + chipW / 2, chipY + 5.6, { align:'center' });

    return y + rows.length * (rowH + gap) - gap + 2;
  }

  function generatePDF(state, lead = {}) {
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ alert('PDF library not loaded.'); return; }

    const doc = new jsPDF('p','mm','a4');
    const W = 210, LM = 14, RM = 14; let y = 16;
    const now = new Date();
    const fmt = d => d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
    const hr  = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

    const vals      = Object.values(state);
    const answered  = vals.filter(v => v !== null).length;
    const scoreRaw  = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const score     = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
    const band      = getBand(score, answered);
    const STATUS    = answered === 0 ? 'Not started' : band.title;

    doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
    doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

    try {
      const logoEl = document.getElementById('pdfLogo');
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);

      if (logoEl && logoEl.complete) {
        const targetW = 18;
        const ratio   = (logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
        const targetH = Math.min(18, targetW * ratio);
        doc.addImage(logoEl,'PNG',LM,6,targetW,targetH,undefined,'FAST');
        doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM + targetW + 4, 22);
      } else {
        doc.text('Compliance365 — Readiness Report', LM, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM, 22);
      }
    } catch (_) {
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text(`${STANDARD} quick-scan summary`, LM, 22);
    }

    doc.setFontSize(10);
    doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
    if (lead?.name || lead?.email) {
      const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
      doc.text(prepared, W-RM, 22, { align:'right' });
    }

    y = 38;
    doc.setTextColor(17,24,39); doc.setFont('helvetica','bold'); doc.setFontSize(13);
    doc.text('Your Readiness at a Glance', LM, y); y += 8;

    const dialX = LM + 26, dialY = y + 24;
    doc.setDrawColor(230,233,242); doc.setLineWidth(6);
    doc.circle(dialX, dialY, 20, 'S');
    doc.setDrawColor(79,70,229);
    const pct = Math.max(0,Math.min(score,100))/100;
    const segs = Math.max(1, Math.round(60*pct));
    for(let i=0;i<segs;i++){
      const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
      const a2 = a1 + 0.1;
      doc.line(
        dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
        dialX+20*Math.cos(a2), dialY+20*Math.sin(a2)
      );
    }
    doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
    doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
    doc.text('Status:',    LM+56, y+12);
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
    doc.text(STATUS, LM+56 + 18, y+12);

    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    doc.text('What this means:', LM+56, y+20);
    const meaningLines = doc.splitTextToSize(band.desc || 'Complete the checklist to generate your Trust Score.', 210 - 14 - 14 - (56));
    doc.text(meaningLines, LM+56, y+26);

    const tips = (!answered)
      ? ['Complete the checklist to generate your Trust Score and PDF roadmap.']
      : (score <= 30)
        ? ['Confirm scope + ownership', 'Stand up data register + high-risk change assessments', 'Prioritise request handling + vendor contracts + evidence first']
        : (score <= 60)
          ? ['Close early-audit gaps (registers, requests, vendors)', 'Tighten overseas transfer assessments (if applicable)', 'Improve evidence consistency (who/what/when)']
          : (score <= 85)
            ? ['Close remaining “Partial/No” items', 'Prepare evidence pack (registers, requests, vendor docs)', 'Schedule internal check + leadership review cadence']
            : ['Validate evidence is current and traceable', 'Run a light internal check', 'Prepare the audit pack and plan certification'];

    let tipsY = y + 26 + (meaningLines.length * 5) + 4;
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39); doc.setFontSize(10);
    doc.text('Next steps:', LM+56, tipsY);
    tipsY += 6;
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, tipsY + i*5));

    y += 64;

    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Domain Breakdown', LM, y); y += 5;

    const DOMAINS = {};
    (Array.isArray(GROUPS)?GROUPS:[]).forEach(g => {
      DOMAINS[g.title] = (Array.isArray(QUESTIONS)?QUESTIONS:[])
        .filter(q => q.group === g.key)
        .map(q => q.id);
    });

    Object.entries(DOMAINS).forEach(([name, ids])=>{
      const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
      const max = ids.length * 2 || 1;
      const p   = Math.round((got/max)*100) || 0;

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      doc.text(name, LM, y+5);

      const barX = LM + 64, barW = W - LM - RM - 64;
      doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
      doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
      const fillW = Math.max(0, Math.min(barW*(p/100), barW));
      doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

      doc.setFont('helvetica','bold'); doc.setTextColor(70);
      doc.text(`${p}%`, barX + barW + 4, y+5);

      y += 11;
    });

    y = hr(y, 6);

    if (y > 180) { doc.addPage(); y = 16; }
    y = drawTrustBands(doc, LM, y, (W - LM - RM), score, answered) + 6;

    // Top Gaps & Risks page
    doc.addPage();
    y = 16;
    y = hr(y, 6);

    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('Top Gaps & Risks', LM, y);
    y += 6;

    // Risk copy aligned to question ids
    const GAP = {
      'pims-scope':'Risk: Unclear scope can lead to uncontrolled personal data handling, missed obligations, and audit nonconformance.',
      'roles-dpo':'Risk: Unclear ownership weakens accountability, decision-making and operational oversight.',
      'policies':'Risk: Missing/outdated policies cause inconsistent handling of personal data and requests.',
      'objectives':'Risk: Without measurable targets, leadership visibility and continual improvement are reduced.',
      'ropa':'Risk: An incomplete data register undermines transparency and defensible compliance.',
      'pii-flows':'Risk: Unmapped data flows increase unknown sharing/transfer risk and slow incident response.',
      'dpia':'Risk: Not assessing high-risk changes increases harm to individuals and regulatory/contract exposure.',
      'controls':'Risk: Weak privacy-by-design controls can cause over-collection, excessive retention, and access drift.',
      'consent':'Risk: Poor consent evidence can lead to disputes, complaints, and unlawful processing concerns.',
      'rights':'Risk: Weak request workflows can miss SLAs, trigger escalation, and cause customer trust damage.',
      'training':'Risk: Incomplete training increases human error and weakens audit evidence of competence.',
      'processors':'Risk: Weak vendor due diligence/contracts increase third-party incidents and contractual noncompliance.',
      'xfer':'Risk: Missing transfer assessments increase the risk of unlawful overseas transfers and enforcement.',
      'evidence':'Risk: Evidence not centralised/versioned reduces audit readiness and traceability.',
      'metrics':'Risk: Missing metrics reduces ability to spot trends, hotspots and resource needs.',
      'iaudit':'Risk: Not checking controls internally allows gaps to persist until an external audit.',
      'review':'Risk: Weak leadership review delays corrective action and improvement.'
    };

    const highs = [], meds = [];
    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach(q=>{
      const v = state[q.id];
      const riskText = GAP[q.id] || 'Risk: A gap here may weaken your privacy posture and audit readiness.';
      if (v===0) highs.push(`${riskText}`);
      else if (v===1) meds.push(`${riskText}`);
    });

    const colW = (W - LM - RM - 6)/2;

    const drawList = (title, items, x, titleColor, accentColor) => {
      if (!items.length) return y;

      doc.setFont('helvetica','bold');
      doc.setFontSize(11);
      doc.setTextColor(...titleColor);
      doc.text(title, x, y);

      let yy = y + 5;
      doc.setFont('helvetica','normal');
      doc.setFontSize(10);
      doc.setTextColor(17,24,39);

      items.forEach((t) => {
        const lines = doc.splitTextToSize(`• ${t}`, colW);
        doc.text(lines, x, yy);
        yy += (lines.length * 4.6) + 1.5;
      });

      doc.setDrawColor(...accentColor);
      doc.setLineWidth(3);
      doc.line(x - 3, y - 2, x - 3, yy - 2);

      return yy;
    };

    const yLeftEnd = drawList('High (No): address first', highs, LM, [239,68,68], [239,68,68]);
    const yRightEnd = drawList('Medium (Partial): tighten next', meds, LM + colW + 6, [99,102,241], [99,102,241]);

    y = Math.max(yLeftEnd, yRightEnd) + 4;
    y = hr(y, 4);

    // Detailed Responses
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Detailed Responses', LM, y); y += 5;

    const drawRow = (idx, q, val)=>{
      if(y>275){ doc.addPage(); y=16; }
      const wrapW = W - LM - RM - 40;

      const detail = q?.why ? `\nWhat we’re looking for: ${q.why}` : '';
      const lines = doc.splitTextToSize(`${idx}. ${q.title}${detail}`, wrapW);
      const rowH  = 12 + Math.max(0, lines.length-1)*4.2;

      doc.setFillColor(245,247,255);
      doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(lines, LM+4, y+4);

      const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
      let fill=[229,231,235], txt=[107,114,128];
      if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
      else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
      else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      const pillW = Math.max(22, doc.getTextWidth(label) + 8);
      const chipX = W - RM - pillW - 4;
      const chipY = y - 1;
      doc.setDrawColor(222,226,236);
      doc.setFillColor(...fill);
      doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
      doc.setTextColor(...txt);
      doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

      y += rowH + 8;
    };

    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach((q,i)=> drawRow(i+1, q, state[q.id]) );

    // CTA
    if(y>246){ doc.addPage(); y=16; }
    y += 4;
    const btnW = 178, btnH = 18, btnX = LM, btnY = y;
    doc.setFillColor(79,70,229);
    doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);

    const ctaText =
      (!answered) ? 'Book a roadmap call' :
      (score <= 30) ? 'Book a scope + remediation roadmap call' :
      (score <= 60) ? 'Book a prioritised remediation roadmap call' :
      (score <= 85) ? 'Book an evidence + audit prep roadmap call' :
                      'Book certification support (audit readiness)';

    doc.text(ctaText, btnX + 6, btnY + 12);
    doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
    doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

    doc.save('iso27701_readiness.pdf');
  }
})();
</script>

