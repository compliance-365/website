---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 42001 (AI Governance)';

// One source of truth for questions
const QUESTIONS = [
  // AIMS governance
  {
    id:'aims-scope',
    label:'AIMS scope defined (AI use cases, systems, models, jurisdictions, boundaries)?',
    group:'gov',
    hint:'Clearly define where AI is used, what is covered by governance, and what is explicitly out of scope.',
    examples:[
      'A documented scope listing AI use cases (e.g. clinical decision support, chatbots, analytics).',
      'Systems and models in scope (vendor AI, internally developed models, GenAI tools).',
      'Geographic and regulatory boundaries (e.g. Australia-only deployment; GDPR-relevant use cases).'
    ]
  },
  {
    id:'roles-oversight',
    label:'AI governance roles & committees defined (owners, reviewers, RACI)?',
    group:'gov',
    hint:'Demonstrate clear accountability for AI decisions, oversight, and escalation.',
    examples:[
      'Named AIMS owner, AI risk owner, and model/use-case owners.',
      'Defined review bodies (e.g. AI governance committee, ethics review panel).',
      'RACI covering design, approval, monitoring, incident handling and retirement.'
    ]
  },
  {
    id:'policies',
    label:'AI policy set approved (acceptable use, risk, data sourcing, transparency)?',
    group:'gov',
    hint:'Policies should guide safe, ethical and compliant AI use across the organisation.',
    examples:[
      'AI Acceptable Use Policy covering staff and contractor use of AI tools.',
      'AI Risk Management or AI Governance Policy aligned to ISO 42001.',
      'Transparency and disclosure policy for customers or end users.'
    ]
  },
  {
    id:'objectives',
    label:'AI objectives/KPIs set and reviewed (accuracy, safety, incidents, drift)?',
    group:'gov',
    hint:'Track whether AI is delivering value safely and within defined risk tolerance.',
    examples:[
      'Defined KPIs such as model accuracy, false positives, bias indicators or incident rates.',
      'Targets and thresholds approved by leadership.',
      'Periodic review of AI performance and risk metrics.'
    ]
  },

  // Risk & impact assessment
  {
    id:'inventory',
    label:'Model/Use-case inventory maintained (purpose, risks, data, owners)?',
    group:'risk',
    hint:'Maintain a single source of truth for all AI systems and use cases.',
    examples:[
      'Inventory of AI use cases with purpose, business owner and technical owner.',
      'Associated datasets, model types, and deployment environments.',
      'Initial risk classification (low/medium/high impact).'
    ]
  },
  {
    id:'risk-method',
    label:'AI risk methodology & impact assessment (AIRA) defined and applied?',
    group:'risk',
    hint:'Use a consistent method to assess AI risks and impacts before deployment and when changes occur.',
    examples:[
      'Documented AI Impact/Risk Assessment (AIRA) template.',
      'Assessment criteria covering safety, bias, legal, ethical and reputational risks.',
      'Completed AIRA records for each material AI use case.'
    ]
  },
  {
    id:'data-ethics',
    label:'Data ethics checks (bias, representativeness, provenance, consent) in place?',
    group:'risk',
    hint:'Ensure training and input data is appropriate, lawful and ethically sourced.',
    examples:[
      'Bias and representativeness assessment for training datasets.',
      'Documented data provenance and sourcing decisions.',
      'Confirmation of consent, licensing or lawful basis for data use.'
    ]
  },

  // Design, controls & oversight
  {
    id:'design-controls',
    label:'Design controls (guardrails, filters, PII minimisation, security) are implemented?',
    group:'ctrl',
    hint:'Build preventative controls into AI systems to reduce harm and misuse.',
    examples:[
      'Prompt filtering, output moderation, or content safety controls.',
      'PII detection, masking or minimisation in prompts and outputs.',
      'Security controls protecting models, APIs and inference endpoints.'
    ]
  },
  {
    id:'human-loop',
    label:'Human oversight defined (review thresholds, escalation, override/kill-switch)?',
    group:'ctrl',
    hint:'Humans must remain accountable for high-risk or impactful AI outcomes.',
    examples:[
      'Defined thresholds requiring human review before action.',
      'Clear escalation paths for unsafe or unexpected outputs.',
      'Ability to disable, pause or override AI systems when required.'
    ]
  },
  {
    id:'eval',
    label:'Evaluation & testing process (fairness, robustness, red-teaming) documented?',
    group:'ctrl',
    hint:'Test AI systems before release and after significant changes.',
    examples:[
      'Pre-deployment testing for accuracy, bias and robustness.',
      'Adversarial or red-teaming exercises for misuse scenarios.',
      'Documented test results and go/no-go decisions.'
    ]
  },

  // Operations & monitoring
  {
    id:'monitor',
    label:'Runtime monitoring (quality, drift, abuse, incidents) with logs & alerts?',
    group:'ops',
    hint:'Monitor AI behaviour in production to detect degradation or misuse.',
    examples:[
      'Monitoring for model drift, performance drops or abnormal outputs.',
      'Logging of prompts, outputs and key decisions (within privacy limits).',
      'Alerts for misuse, abuse patterns or policy violations.'
    ]
  },
  {
    id:'incident',
    label:'Incident handling (AI issues, bias harms, misuse) and post-incident reviews?',
    group:'ops',
    hint:'Treat AI-related issues as formal incidents with learning outcomes.',
    examples:[
      'AI incident categories included in the incident response plan.',
      'Documented handling of bias, hallucinations or harmful outputs.',
      'Post-incident reviews with corrective actions tracked.'
    ]
  },
  {
    id:'records',
    label:'Documentation & records (datasets, versions, configs, decisions) maintained?',
    group:'ops',
    hint:'Maintain traceability for how AI systems were designed and operated.',
    examples:[
      'Version history of models, prompts, configurations and datasets.',
      'Decision logs for approvals, changes and risk acceptances.',
      'Retention aligned to regulatory and audit requirements.'
    ]
  },

  // Suppliers & transparency
  {
    id:'thirdparty',
    label:'Third-party AI/vendor controls (due diligence, model cards, SLAs, restrictions)?',
    group:'sup',
    hint:'Manage risk from external AI providers and embedded models.',
    examples:[
      'Vendor due diligence covering security, privacy, bias and transparency.',
      'Review of model cards, SOC/ISO reports or assurance statements.',
      'Contractual controls: usage limits, data handling, breach notification.'
    ]
  },
  {
    id:'transparency',
    label:'Transparency to users (purpose, limitations, human contact) and opt-outs?',
    group:'sup',
    hint:'Users should understand when AI is used and how to seek help or opt out.',
    examples:[
      'User-facing disclosures explaining AI purpose and limitations.',
      'Clear contact points for human review or complaints.',
      'Documented opt-out or alternative pathways where feasible.'
    ]
  },

  // Evidence & improvement
  {
    id:'evidence',
    label:'Evidence stored in M365 (SharePoint/Sentinel/Purview) with retention/versioning?',
    group:'ev',
    hint:'Evidence should be centralised, controlled and audit-ready.',
    examples:[
      'AIMS evidence library in SharePoint with version control.',
      'Logs and monitoring evidence retained in Sentinel or equivalent.',
      'Purview labels or retention policies applied to AI records.'
    ]
  },
  {
    id:'audits',
    label:'Internal audits/assurance performed; findings & CAPAs tracked to closure?',
    group:'ev',
    hint:'Regular assurance ensures AI governance controls are operating as intended.',
    examples:[
      'Internal AI governance or AIMS audits aligned to ISO 42001.',
      'Findings logged with corrective actions, owners and due dates.',
      'Evidence of verification and closure.'
    ]
  },
  {
    id:'mgmt-review',
    label:'Management review of AIMS performance, risks, incidents and improvements?',
    group:'ev',
    hint:'Leadership should regularly review AI risks, outcomes and improvement opportunities.',
    examples:[
      'Management review minutes covering AI risks, incidents and KPIs.',
      'Decisions on risk acceptance, resourcing or policy changes.',
      'Tracked actions arising from AIMS management reviews.'
    ]
  }
];

const GROUPS = [
  { key:'gov',  title:'AIMS Governance',              blurb:'Scope, roles/committees, policy set, objectives.' },
  { key:'risk', title:'Risk & Impact Assessment',     blurb:'Inventory, AIRA method, data ethics & provenance.' },
  { key:'ctrl', title:'Design, Controls & Oversight', blurb:'Guardrails, human-in-the-loop, evaluation/testing.' },
  { key:'ops',  title:'Operations & Monitoring',      blurb:'Monitoring, incident handling, records & logs.' },
  { key:'sup',  title:'Suppliers & Transparency',     blurb:'Third-party AI due diligence and user transparency.' },
  { key:'ev',   title:'Evidence & Improvement',       blurb:'Evidence management, audits and reviews.' },
];
---

<Base
  title="ISO 42001 Free AI Governance Readiness Checklist"
  description="Free ISO 42001 AI governance readiness checklist for CIOs, CISOs, data and AI leaders. Assess AIMS maturity, see your readiness score and download a PDF roadmap to ISO 42001 certification."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 42001 AI governance readiness checklist (free)</h1>
    <p class="muted" style="max-width:800px">
      Use this free ISO 42001 readiness checklist to assess how mature your AI Management System (AIMS) is across governance, risk, design,
      monitoring and supplier controls. Quickly see how ready your organisation is for ISO 42001 certification and where to focus next.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">
          Gauge ISO 42001 AIMS maturity and identify high-value improvements in your AI governance.
        </p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small"><strong>Yes / Partial / No</strong>. Progress and readiness update automatically.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown and next-step guidance.</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill" aria-current="page">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 6px;">
  {q.label}
</label>

{q.hint && (
  <div class="muted small" style="margin:0 0 8px;">
    {q.hint}
  </div>
)}

{q.examples?.length && (
  <details style="margin:0 0 10px;">
    <summary class="small" style="cursor:pointer;font-weight:700;color:#4F46E5;">
      Show examples
    </summary>
    <ul class="small" style="margin:8px 0 0;padding-left:18px;">
      {q.examples.map(ex => (<li>{ex}</li>))}
    </ul>
  </details>
)}
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
(() => {
  'use strict';

  const STANDARD = "ISO 42001 (AI Governance)";
  const API_URL  = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

  // Browser-side GROUPS (must match page markup keys)
  const GROUPS = [
    { key:'gov',  title:'AIMS Governance' },
    { key:'risk', title:'Risk & Impact Assessment' },
    { key:'ctrl', title:'Design, Controls & Oversight' },
    { key:'ops',  title:'Operations & Monitoring' },
    { key:'sup',  title:'Suppliers & Transparency' },
    { key:'ev',   title:'Evidence & Improvement' },
  ];

  // Browser-side QUESTIONS (with group keys)
  const QUESTIONS = [
    { id:'aims-scope',      label:'AIMS scope defined (AI use cases, systems, models, jurisdictions, boundaries)?', group:'gov' },
    { id:'roles-oversight', label:'AI governance roles & committees defined (owners, reviewers, RACI)?',           group:'gov' },
    { id:'policies',        label:'AI policy set approved (acceptable use, risk, data sourcing, transparency)?',   group:'gov' },
    { id:'objectives',      label:'AI objectives/KPIs set and reviewed (accuracy, safety, incidents, drift)?',     group:'gov' },

    { id:'inventory',       label:'Model/Use-case inventory maintained (purpose, risks, data, owners)?',           group:'risk' },
    { id:'risk-method',     label:'AI risk methodology & impact assessment (AIRA) defined and applied?',           group:'risk' },
    { id:'data-ethics',     label:'Data ethics checks (bias, representativeness, provenance, consent) in place?',  group:'risk' },

    { id:'design-controls', label:'Design controls (guardrails, filters, PII minimisation, security) are implemented?', group:'ctrl' },
    { id:'human-loop',      label:'Human oversight defined (review thresholds, escalation, override/kill-switch)?',     group:'ctrl' },
    { id:'eval',            label:'Evaluation & testing process (fairness, robustness, red-teaming) documented?',       group:'ctrl' },

    { id:'monitor',         label:'Runtime monitoring (quality, drift, abuse, incidents) with logs & alerts?',      group:'ops' },
    { id:'incident',        label:'Incident handling (AI issues, bias harms, misuse) and post-incident reviews?',   group:'ops' },
    { id:'records',         label:'Documentation & records (datasets, versions, configs, decisions) maintained?',   group:'ops' },

    { id:'thirdparty',      label:'Third-party AI/vendor controls (due diligence, model cards, SLAs, restrictions)?', group:'sup' },
    { id:'transparency',    label:'Transparency to users (purpose, limitations, human contact) and opt-outs?',        group:'sup' },

    { id:'evidence',        label:'Evidence stored in M365 (SharePoint/Sentinel/Purview) with retention/versioning?', group:'ev' },
    { id:'audits',          label:'Internal audits/assurance performed; findings & CAPAs tracked to closure?',        group:'ev' },
    { id:'mgmt-review',     label:'Management review of AIMS performance, risks, incidents and improvements?',        group:'ev' }
  ];

  (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

  function setup(){
    const form       = document.getElementById('form');
    const bar        = document.getElementById('bar');
    const scoreNum   = document.getElementById('scoreNum');
    const scoreLabel = document.getElementById('scoreLabel');
    const scoreHint  = document.getElementById('scoreHint');
    const resetBtn   = document.getElementById('resetBtn');
    const pdfBtn     = document.getElementById('pdfBtn');

    const modal      = document.getElementById('leadModal');
    const leadForm   = document.getElementById('leadForm');
    const cancelLead = document.getElementById('cancelLead');
    const nameEl     = document.getElementById('name');
    const emailEl    = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    // ISO27001/27701-style group counters
    function refreshGroupCounters(){
      GROUPS.forEach(grp => {
        const total = QUESTIONS.filter(q=>q.group===grp.key).length;
        const ansd  = QUESTIONS.filter(q=>q.group===grp.key).map(q=>state[q.id]).filter(v=>v!==null).length;
        const el = document.getElementById('g-'+grp.key);
        if(el) el.textContent = `${ansd}/${total} answered`;
      });
    }
    refreshGroupCounters();

    // Click-to-answer (ISO27001 style)
    form?.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.opt'); if(!btn || !form.contains(btn)) return;
      const field = btn.closest('.field'); if(!field) return;
      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);
      state[id] = val;
      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');
      refreshGroupCounters();
      update();
    });

    // Reset
    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form?.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
      refreshGroupCounters();
      update();
    });

    // Open modal before PDF
    pdfBtn?.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if(modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

    // Submit → POST to API → ALWAYS generate PDF
    leadForm?.addEventListener('submit', async (e)=>{
      e.preventDefault();

      const name  = (nameEl?.value || '').trim();
      const email = (emailEl?.value || '').trim();

      if(!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
        alert('Please enter your name and a valid email.');
        return;
      }

      const Q_MIN = QUESTIONS.map(q => ({ id: q.id, label: q.label, group: q.group }));
      const G_MIN = GROUPS.map(g => ({ key: g.key, title: g.title }));

      const payload = {
        name,
        email,
        subject: `Checklist lead: ${STANDARD}`,
        message: JSON.stringify({
          checklist: STANDARD,
          checklistId: 'iso42001',
          timestamp: new Date().toISOString(),
          ua: navigator.userAgent,
          ...compute(state),
          total: QUESTIONS.length,
          answers: state,
          questions: Q_MIN,
          groups: G_MIN
        })
      };

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const txt = await res.text().catch(()=>'');

        if (!res.ok) {
          console.warn('[42001 lead] POST failed:', res.status, txt);
          alert('We could not notify our team automatically, but your PDF will still download.');
        }
      } catch (err) {
        console.warn('[42001 lead] POST error:', err);
        alert('We could not notify our team automatically, but your PDF will still download.');
      }

      // GA4 event
      try {
        const s = compute(state);
        if (window.gtag) {
          window.gtag('event', 'checklist_submit', {
            event_category: 'Checklist',
            event_label: STANDARD,
            checklist_standard: STANDARD,
            checklist_id: 'iso42001',
            answered: s.answered,
            score: s.score
          });
        }
      } catch (err) {
        console.warn('GA4 checklist_submit event failed', err);
      }

      closeModal();
      generatePDF(state, { name, email });
    });

    // active-chip style
    const s = document.createElement('style');
    s.textContent = `button.opt{cursor:pointer}
      button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
    document.head.appendChild(s);

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);
      if (bar) bar.style.width = pct + '%';
      if (scoreNum) scoreNum.textContent = `${score}%`;

      // ISO27001/27701-style bands (AI context)
      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered === 0) {
        label = 'Not started';
        hint  = 'Answer the questions to see your readiness.';
      } else if (score <= 30) {
        label = 'High Risk (0–30)';
        hint  = 'Focus on AIMS scope/ownership, inventory, risk method (AIRA), and baseline guardrails.';
      } else if (score <= 60) {
        label = 'Partially Ready (31–60)';
        hint  = 'Prioritise AIRAs, human oversight, evaluation/testing, and supplier due diligence.';
      } else if (score <= 85) {
        label = 'Nearly Audit-Ready (61–85)';
        hint  = 'Close remaining gaps and strengthen monitoring, incident handling, records and evidence.';
      } else {
        label = 'Certification-Ready (86–100)';
        hint  = 'Focus on validation, evidence packaging and audit preparation.';
      }

      if (scoreLabel) scoreLabel.textContent = label;
      if (scoreHint)  scoreHint.textContent  = hint;
    }
  }

  function compute(state){
    const answered = Object.values(state).filter(v => v !== null).length;
    const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
    const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
    return { answered, score: isNaN(score) ? 0 : score };
  }

  function getBand(score, answered){
    if (!answered) return { key:'na', title:'Not started', desc:'Complete the checklist to generate your Trust Score.' };
    if (score <= 30) return { key:'hr',  title:'0–30 — High Risk',             desc:'Missing AI governance foundations. Structured remediation required.' };
    if (score <= 60) return { key:'pr',  title:'31–60 — Partially Ready',      desc:'Core elements exist. Prioritisation and closure of key gaps needed.' };
    if (score <= 85) return { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close minor gaps and package evidence for audit.' };
    return              { key:'cr',      title:'86–100 — Certification-Ready', desc:'Controls largely in place. Focus on validation and audit packaging.' };
  }

  // Trust Score meaning panel (same structure as ISO27001/27701)
  function drawTrustBands(doc, x, y, w, score, answered){
    const pad = 6;
    const rowH = 18;
    const gap = 6;

    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('What Your Trust Score Really Means', x, y);
    y += 6;

    doc.setFont('helvetica','normal');
    doc.setFontSize(10);
    doc.setTextColor(80);
    doc.text('Your ISO 42001 Trust Score shows how close you already are to certification.', x, y);
    y += 8;

    if (!answered) {
      doc.setFillColor(243,244,246);
      doc.setDrawColor(229,231,235);
      doc.roundedRect(x, y, w, rowH, 3, 3, 'FD');

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text('Not started', x + pad, y + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(80);
      doc.text('Answer the questions to generate your Trust Score and PDF roadmap.', x + pad, y + 14);

      return y + rowH + 2;
    }

    const rows = [
      { key:'hr',  title:'0–30 — High Risk',             desc:'Missing AI governance foundations. Structured remediation required.' },
      { key:'pr',  title:'31–60 — Partially Ready',      desc:'Core elements exist. Prioritisation and closure of key gaps needed.' },
      { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close minor gaps and package evidence for audit.' },
      { key:'cr',  title:'86–100 — Certification-Ready', desc:'Controls largely in place. Focus on validation and audit packaging.' },
    ];

    const fills = {
      hr:  [254,226,226],
      pr:  [224,231,255],
      nar: [254,249,195],
      cr:  [209,250,229],
    };

    const band = getBand(score, answered);

    rows.forEach((r, i) => {
      const yy = y + i * (rowH + gap);

      const fc = fills[r.key];
      doc.setFillColor(fc[0], fc[1], fc[2]);
      doc.setDrawColor(229,231,235);
      doc.setLineWidth(0.2);
      doc.roundedRect(x, yy, w, rowH, 4, 4, 'FD');

      if (r.key === band.key) {
        doc.setDrawColor(79,70,229);
        doc.setLineWidth(0.8);
        doc.roundedRect(x, yy, w, rowH, 4, 4, 'S');

        doc.setFillColor(79,70,229);
        doc.roundedRect(x + 2, yy + 2, 3, rowH - 4, 2, 2, 'F');
      }

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text(r.title, x + pad + 4, yy + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(55);
      const lines = doc.splitTextToSize(r.desc, w - (pad * 2) - 8);
      doc.text(lines, x + pad + 4, yy + 14);
    });

    const chip = `Your score: ${score}%`;
    doc.setFont('helvetica','bold'); doc.setFontSize(10);
    const chipW = Math.max(28, doc.getTextWidth(chip) + 10);
    const chipH = 8;
    const chipX = x + w - chipW;
    const chipY = y - 10;

    doc.setFillColor(17,24,39);
    doc.setTextColor(255,255,255);
    doc.roundedRect(chipX, chipY, chipW, chipH, 3, 3, 'F');
    doc.text(chip, chipX + chipW / 2, chipY + 5.6, { align:'center' });

    return y + rows.length * (rowH + gap) - gap + 2;
  }

  function generatePDF(state, lead = {}) {
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ alert('PDF library not loaded.'); return; }

    const doc = new jsPDF('p','mm','a4');
    const W = 210, LM = 14, RM = 14; let y = 16;

    const now = new Date();
    const fmt = d => d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
    const hr  = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

    const vals      = Object.values(state);
    const answered  = vals.filter(v => v !== null).length;
    const scoreRaw  = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const score     = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
    const band      = getBand(score, answered);
    const STATUS    = answered === 0 ? 'Not started' : band.title;

    // Header band
    doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
    doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

    // Logo + title + subtitle
    try {
      const logoEl = document.getElementById('pdfLogo');
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);

      if (logoEl && logoEl.complete) {
        const targetW = 18;
        const ratio   = (logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
        const targetH = Math.min(18, targetW * ratio);
        doc.addImage(logoEl,'PNG',LM,6,targetW,targetH,undefined,'FAST');
        doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM + targetW + 4, 22);
      } else {
        doc.text('Compliance365 — Readiness Report', LM, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${STANDARD} quick-scan summary`, LM, 22);
      }
    } catch (_) {
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text(`${STANDARD} quick-scan summary`, LM, 22);
    }

    // Date + Prepared for
    doc.setFontSize(10);
    doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
    if (lead?.name || lead?.email) {
      const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
      doc.text(prepared, W-RM, 22, { align:'right' });
    }

    // Summary + dial
    y = 38;
    doc.setTextColor(17,24,39); doc.setFont('helvetica','bold'); doc.setFontSize(13);
    doc.text('Your Readiness at a Glance', LM, y); y += 8;

    const dialX = LM + 26, dialY = y + 24;
    doc.setDrawColor(230,233,242); doc.setLineWidth(6);
    doc.circle(dialX, dialY, 20, 'S');
    doc.setDrawColor(79,70,229);
    const pct = Math.max(0,Math.min(score,100))/100;
    const segs = Math.max(1, Math.round(60*pct));
    for(let i=0;i<segs;i++){
      const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
      const a2 = a1 + 0.1;
      doc.line(
        dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
        dialX+20*Math.cos(a2), dialY+20*Math.sin(a2)
      );
    }
    doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
    doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
    doc.text('Status:',    LM+56, y+12);
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
    doc.text(STATUS, LM+56 + 18, y+12);

    // Band meaning + Next steps
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    doc.text('What this means:', LM+56, y+20);
    const meaningLines = doc.splitTextToSize(band.desc || 'Complete the checklist to generate your Trust Score.', 210 - 14 - 14 - (56));
    doc.text(meaningLines, LM+56, y+26);

    const tips = (!answered)
      ? ['Complete the checklist to generate your Trust Score and PDF roadmap.']
      : (score <= 30)
        ? ['Confirm AIMS scope, ownership and AI policy baseline', 'Stand up inventory + AIRA method and workflow', 'Implement baseline guardrails and human oversight triggers']
        : (score <= 60)
          ? ['Run AIRAs for priority use cases', 'Tighten evaluation/testing (fairness/robustness)', 'Strengthen supplier due diligence + transparency baseline']
          : (score <= 85)
            ? ['Close remaining “Partial/No” gaps', 'Harden monitoring, incident playbooks and records', 'Prepare evidence pack and assurance cadence']
            : ['Validate evidence is current and traceable', 'Run a light internal audit/assurance check', 'Prepare the audit pack and plan certification'];

    let tipsY = y + 26 + (meaningLines.length * 5) + 4;
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39); doc.setFontSize(10);
    doc.text('Next steps:', LM+56, tipsY);
    tipsY += 6;
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, tipsY + i*5));

    y += 64;

    // Domain breakdown
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Domain Breakdown', LM, y); y += 5;

    const DOMAINS = {};
    (Array.isArray(GROUPS)?GROUPS:[]).forEach(g => {
      DOMAINS[g.title] = (Array.isArray(QUESTIONS)?QUESTIONS:[])
        .filter(q => q.group === g.key)
        .map(q => q.id);
    });

    Object.entries(DOMAINS).forEach(([name, ids])=>{
      const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
      const max = ids.length * 2 || 1;
      const p   = Math.round((got/max)*100) || 0;

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      doc.text(name, LM, y+5);

      const barX = LM + 64, barW = W - LM - RM - 64;
      doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
      doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');
      const fillW = Math.max(0, Math.min(barW*(p/100), barW));
      doc.setFillColor(79,70,229); doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

      doc.setFont('helvetica','bold'); doc.setTextColor(70);
      doc.text(`${p}%`, barX + barW + 4, y+5);

      y += 11;
    });

    y = hr(y, 6);

    // Trust Score Bands panel in-PDF
    if (y > 180) { doc.addPage(); y = 16; }
    y = drawTrustBands(doc, LM, y, (W - LM - RM), score, answered) + 6;

    // Always start Top Gaps on a new page
    doc.addPage();
    y = 16;

    // Optional divider
    y = hr(y, 6);

    // Top Gaps & Risks
    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('Top Gaps & Risks', LM, y);
    y += 6;

    const GAP = {
      'aims-scope':
        'Risk: An incomplete AIMS scope may result in unmanaged AI use cases, unclear boundaries, and audit gaps.',
      'roles-oversight':
        'Risk: Unclear oversight roles and decision rights may weaken accountability and timely risk decisions.',
      'policies':
        'Risk: Missing or outdated AI policies may result in inconsistent use, uncontrolled experimentation, and misuse.',
      'objectives':
        'Risk: Without measurable AI objectives/KPIs, management may not detect drift, incidents, or harm trends.',

      'inventory':
        'Risk: A missing inventory can cause “unknown AI” in production, weak ownership, and poor traceability.',
      'risk-method':
        'Risk: Without a defined AIRA method, risk assessments may be inconsistent and fail to prioritise high-impact harms.',
      'data-ethics':
        'Risk: Weak data ethics/provenance checks can increase bias, unlawful data use, and reputational damage.',

      'design-controls':
        'Risk: Missing guardrails and security controls can lead to unsafe outputs, prompt injection, and PII exposure.',
      'human-loop':
        'Risk: Without clear human oversight thresholds and escalation, unsafe or biased outcomes may not be intercepted.',
      'eval':
        'Risk: Lack of documented evaluation/testing reduces confidence in fairness, robustness and safety.',

      'monitor':
        'Risk: Weak monitoring and alerting can delay detection of drift, abuse, model failures, or emerging harms.',
      'incident':
        'Risk: Unclear incident handling for AI issues increases impact duration and reduces lessons learned.',
      'records':
        'Risk: Poor records (datasets, versions, decisions) reduce explainability, traceability and audit defensibility.',

      'thirdparty':
        'Risk: Weak third-party AI due diligence may introduce unmanaged model risks and contractual noncompliance.',
      'transparency':
        'Risk: Insufficient user transparency may cause trust loss, complaints and regulatory scrutiny.',

      'evidence':
        'Risk: Evidence not centralised and version-controlled reduces audit readiness and operational traceability.',
      'audits':
        'Risk: Lack of internal assurance may allow nonconformities and control weaknesses to persist undetected.',
      'mgmt-review':
        'Risk: Incomplete management reviews can delay corrective action and stall continual improvement.'
    };

    const highs = [], meds = [];
    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach(q=>{
      const v = state[q.id];
      if (v===0) highs.push(GAP[q.id] || q.label);
      else if (v===1) meds.push(GAP[q.id] || q.label);
    });

    const colW = (W - LM - RM - 6)/2;

    const drawList = (title, items, x, titleColor, accentColor) => {
      if (!items.length) return y;

      // Title
      doc.setFont('helvetica','bold');
      doc.setFontSize(11);
      doc.setTextColor(...titleColor);
      doc.text(title, x, y);

      // Body
      let yy = y + 5;
      doc.setFont('helvetica','normal');
      doc.setFontSize(10);
      doc.setTextColor(17,24,39);

      items.forEach((t) => {
        const lines = doc.splitTextToSize(`• ${t}`, colW);
        doc.text(lines, x, yy);
        yy += (lines.length * 4.6) + 1.5;
      });

      // Left accent bar sized to actual rendered height
      doc.setDrawColor(...accentColor);
      doc.setLineWidth(3);
      doc.line(x - 3, y - 2, x - 3, yy - 2);

      return yy;
    };

    const yLeftEnd = drawList('High (No): address first', highs, LM, [239,68,68], [239,68,68]);
    const yRightEnd = drawList('Medium (Partial): tighten next', meds, LM + colW + 6, [99,102,241], [99,102,241]);

    y = Math.max(yLeftEnd, yRightEnd) + 4;
    y = hr(y, 4);

    // Detailed Responses
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Detailed Responses', LM, y); y += 5;

    const drawRow = (idx, text, val)=>{
      if(y>275){ doc.addPage(); y=16; }
      const wrapW = W - LM - RM - 40;
      const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
      const rowH  = 12 + Math.max(0, lines.length-1)*4.2;

      doc.setFillColor(245,247,255);
      doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(lines, LM+4, y+4);

      const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
      let fill=[229,231,235], txt=[107,114,128];
      if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
      else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
      else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      const pillW = Math.max(22, doc.getTextWidth(label) + 8);
      const chipX = W - RM - pillW - 4;
      const chipY = y - 1;
      doc.setDrawColor(222,226,236);
      doc.setFillColor(...fill);
      doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
      doc.setTextColor(...txt);
      doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

      y += rowH + 8;
    };

    (Array.isArray(QUESTIONS)?QUESTIONS:[]).forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

    // CTA (band-aware label)
    if(y>246){ doc.addPage(); y=16; }
    y += 4;
    const btnW = 178, btnH = 18, btnX = LM, btnY = y;
    doc.setFillColor(79,70,229);
    doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);

    const ctaText =
      (!answered) ? 'Book a roadmap call' :
      (score <= 30) ? 'Book a scope + remediation roadmap call' :
      (score <= 60) ? 'Book a prioritised remediation roadmap call' :
      (score <= 85) ? 'Book an evidence + audit prep roadmap call' :
                      'Book certification support (audit readiness)';

    doc.text(ctaText, btnX + 6, btnY + 12);
    doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

    // Footer
    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
    doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

    doc.save('iso42001_readiness.pdf');
  }
})();
  </script>

  <!-- Lead capture modal -->
  <div id="leadModal"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); align-items:center; justify-content:center; z-index:2000;">
    <div style="background:#fff; padding:24px; border-radius:14px; max-width:400px; width:100%; box-shadow:0 12px 30px rgba(0,0,0,.2);">
      <h3 style="margin-top:0">Before you download</h3>
      <p class="muted small">
        Enter your details to receive this ISO 42001 readiness report and occasional AI, security and privacy governance updates:
      </p>
      <form id="leadForm">
        <input type="text" id="name" placeholder="Your name"
               style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px">
        <input type="email" id="email" placeholder="Your email"
               style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px">

        <p class="muted tiny" style="margin-top:6px">
          By submitting, you agree to receive relevant updates from Compliance365. You can unsubscribe at any time.
        </p>

        <div style="display:flex; gap:10px; margin-top:12px; justify-content:flex-end;">
          <button type="button" class="btn btn-ghost" id="cancelLead">Cancel</button>
          <button type="submit" class="btn btn-primary">Email my PDF report</button>
        </div>
      </form>
    </div>
  </div>
