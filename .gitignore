# Build output — Netlify builds this from source, never commit it
dist/
.astro/

# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
!.env.example

# Entitlement signing key (tools/issue-entitlement.mjs keygen output),
# per-module content-pack encryption keys, and any issued client
# activation files — never commit these.
entitlement-private.json
tools/module-keys.json
*-entitlement.json
*-activation.json
activation.json

# Premium framework content source (SOC 2, Essential Eight, ISO 42001,
# ISO 27701, DISP/IRAP, NIST CSF, RFFR, CPS 234, AI) — used to be
# committed here in plaintext, readable by anyone in this public repo.
# Now lives in the private compliance-365/Checkpoint-Content repo and is
# checked out into this exact path by CI (see .github/workflows/deploy.yml
# and test.yml) before scripts/build-content-packs.mjs runs. A local
# checkout without access to that private repo simply has none of this —
# same "absence fails safe" posture as tools/module-keys.json above.
checkpoint-content/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
npm-debug.log*
*.log
.claude/

# Design canvas: the .dc.html artboards and canvas.json are the sources and are
# tracked; the seeded page is a ~2.5MB build artifact (the canvas editor is
# baked into it) and is regenerated from those sources, so it is not.
design/*.html
!design/*.dc.html
