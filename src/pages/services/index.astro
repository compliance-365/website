---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// Pull all service .md files from content/services
const raw = await Astro.glob('../../../content/services/*.md');

// Turn each file into a clean card model
const services = raw
  .map((entry) => {
    const parts = entry.file.split('/');
    const filename = parts[parts.length - 1];      // e.g. iso27001.md
    const slug = filename.replace(/\.md$/, '');    // -> iso27001
    return {
      slug,
      href: base + 'services/' + slug,
      title: entry.frontmatter?.title ?? slug.replace(/-/g, ' ').toUpperCase(),
      summary:
        entry.frontmatter?.summary ??
        'Read what’s included, timelines and outcomes for this service.',
      icon: entry.frontmatter?.icon ?? null
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

// Simple JSON-LD for a service list
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Compliance365 Services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(s.href, Astro.site ?? 'https://www.compliance365.com.au').toString(),
    name: s.title
  }))
};
---

<Base
  title="Services — Compliance365"
  description="ISO 27001, ISO 27701, ISO 42001, SOC 2, Essential Eight, DISP/ISM/IRAP — delivered faster with automated evidence inside Microsoft 365."
>
  <Header />

  <section class="container section">
    <header style="margin-bottom: 12px">
      <h1 style="margin:0">Services</h1>
      <p class="muted" style="margin:.3rem 0 0;max-width:780px">
        Pick the outcome you need — ISO, SOC&nbsp;2, Essential Eight or government frameworks. We map the shortest route
        and automate the evidence in Microsoft&nbsp;365 and SharePoint.
      </p>
    </header>

    <div class="grid-3" style="margin-top:14px">
      {services.map((s) => (
        <a class="card lift svc" href={s.href} aria-label={`Learn more about ${s.title}`}>
          <div class="svc-head">
            {s.icon ? (
              <img src={s.icon} alt="" width="24" height="24" loading="lazy" />
            ) : (
              // fallback icon (shield)
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M12 2l8 4v6c0 5-4 9-8 10-4-1-8-5-8-10V6l8-4z" fill="none" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            )}
            <h3 class="svc-title">{s.title}</h3>
          </div>
          <p class="muted" style="margin:.4rem 0 0">{s.summary}</p>
          <span class="pill brand" style="margin-top:.6rem">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <Footer />

  <script type="application/ld+json">
    {JSON.stringify(ld)}
  </script>

  <style>
    /* Optional card polish just for this page (can move to brand.css) */
    .svc { display:block; text-decoration:none }
    .svc-head{ display:flex; align-items:center; gap:.55rem; }
    .svc-title{ margin:0 }
    .card.lift:hover{ transform: translateY(-2px); transition: transform .18s ease; }
  </style>
</Base>
