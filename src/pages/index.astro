<script is:inline>
(function () {
  /* ── Scroll-reveal ── */
  var sections = document.querySelectorAll('.reveal-section');
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  sections.forEach(function (s) { io.observe(s); });

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Posture scan live demo ── */
  (function () {
    var card = document.getElementById('scanCard');
    if (!card) return;
    var fill = document.getElementById('gaugeFill'),
        num = document.getElementById('gaugeNum'),
        rows = document.querySelectorAll('#scanRows .check-row'),
        C = 2 * Math.PI * 52, played = false;
    fill.style.strokeDasharray = C;
    fill.style.strokeDashoffset = C;
    function play() {
      card.classList.add('skel-done');
      rows.forEach(function (r) { r.classList.remove('show'); });
      var t0 = null, target = 52, dur = 1800;
      if (reduced) {
        num.textContent = target;
        fill.style.strokeDashoffset = C * (1 - target / 100);
        rows.forEach(function (r) { r.classList.add('show'); });
        return;
      }
      function frame(ts) {
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
        num.textContent = Math.round(target * e);
        fill.style.strokeDashoffset = C * (1 - (target / 100) * e);
        if (p < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
      rows.forEach(function (r, i) { setTimeout(function () { r.classList.add('show'); }, 500 + i * 320); });
    }
    new IntersectionObserver(function (es, ob) {
      if (es[0].isIntersecting && !played) { played = true; play(); ob.unobserve(card); }
    }, { threshold: 0.4 }).observe(card);
    document.getElementById('scanReplay').addEventListener('click', play);
  })();

  /* ── Platform tax calculator ── */
  (function () {
    var range = document.getElementById('empRange');
    if (!range) return;
    var calcCard = document.getElementById('calcCard');
    var years = 3;
    function fmt(n) { return '$' + Math.round(n / 1000) + 'k'; }
    function update() {
      calcCard.classList.add('skel-done');
      var emp = parseInt(range.value, 10);
      document.getElementById('calcEmp').textContent = emp;
      var licence = 25000 + emp * 80;        /* annual platform licence */
      var plat = licence * years + 55000;    /* + consulting you still need */
      var c365 = 40000 + emp * 90;           /* fixed-price, once */
      document.getElementById('platCost').textContent = fmt(plat);
      document.getElementById('c365Cost').textContent = fmt(c365);
      document.getElementById('savings').textContent = fmt(plat - c365);
      document.getElementById('platBar').style.width = '100%';
      document.getElementById('c365Bar').style.width = Math.max(c365 / plat * 100, 4) + '%';
    }
    range.addEventListener('input', update);
    document.getElementById('yrs').addEventListener('click', function (e) {
      if (!e.target.classList.contains('yr')) return;
      document.querySelectorAll('.yr').forEach(function (y) { y.classList.remove('sel'); });
      e.target.classList.add('sel');
      years = parseInt(e.target.dataset.y, 10);
      update();
    });
    new IntersectionObserver(function (es, ob) {
      if (es[0].isIntersecting) { update(); ob.disconnect(); }
    }, { threshold: 0.3 }).observe(document.querySelector('.calc'));
  })();

  /* ── Scroll-driven 365 cycle ── */
  var cyclePath = document.getElementById('cyclePath');
  var cycleProg = document.getElementById('cycleProg');
  var cycleDot  = document.getElementById('cycleDot');
  var phasesWrap = document.getElementById('phases');
  if (cyclePath && cycleProg && cycleDot && phasesWrap) {
    var L = cyclePath.getTotalLength();
    cycleProg.style.strokeDasharray  = L;
    cycleProg.style.strokeDashoffset = L;
    var phaseEls  = phasesWrap.querySelectorAll('.phase');
    var cycleNum  = document.getElementById('cycleNum');
    var cycleName = document.getElementById('cycleName');
    function updateCycle() {
      var r = phasesWrap.getBoundingClientRect(), vh = window.innerHeight;
      var p = Math.min(Math.max((vh * 0.55 - r.top) / r.height, 0), 0.9999);
      var pt = cyclePath.getPointAtLength(L * p);
      cycleDot.setAttribute('cx', pt.x);
      cycleDot.setAttribute('cy', pt.y);
      cycleProg.style.strokeDashoffset = L * (1 - p);
      var idx = Math.min(Math.floor(p * 4), 3);
      var ph  = phaseEls[idx];
      phaseEls.forEach(function (el, i) { el.classList.toggle('active', i === idx); });
      if (cycleName && cycleNum && cycleName.textContent !== ph.dataset.name) {
        cycleNum.textContent  = ph.dataset.num;
        cycleName.textContent = ph.dataset.name;
      }
    }
    window.addEventListener('scroll', updateCycle, { passive: true });
    updateCycle();
  }
})();
</script>

