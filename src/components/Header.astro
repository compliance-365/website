---
const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book/';
const ctaLabel = 'Book a call';

const { pathname } = Astro.url;
function isActive(path: string) {
  if (path === base) return pathname === base || pathname === '/';
  return pathname.startsWith(path);
}
---

<!-- Thin accent stripe at very top -->
<div class="accent-stripe" aria-hidden="true"></div>

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand -->
    <a href={base} class="brand" aria-label="Compliance365 home">
      <svg class="brand-logo" width="32" height="32" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M176.2,56 A88,88 0 1,0 176.2,144" stroke="#FAF7F1" stroke-width="18" stroke-linecap="round"/>
        <circle cx="188" cy="100" r="14" fill="#A9812E"/>
      </svg>
      <span class="brand-name">COMPLIANCE<span class="brand-365">365</span></span>
    </a>

    <!-- Mobile toggle -->
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primaryNav"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <!-- Primary nav -->
    <nav id="primaryNav" class="nav" aria-label="Primary">
      <a class={`nav-link${isActive(base) && pathname === base ? ' active' : ''}`} href={base}>Home</a>

      <!-- Services dropdown -->
      <div class="nav-dd">
        <button
          class={`nav-link nav-dd-btn${isActive(base + 'services') ? ' active' : ''}`}
          type="button"
          aria-expanded="false"
          aria-controls="servicesMenu"
        >
          Services <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div id="servicesMenu" class="nav-dd-menu" role="menu" aria-label="Services">
          <a role="menuitem" href={base + 'services/iso27001/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-lock"/></svg></span> ISO 27001 — Security
          </a>
          <a role="menuitem" href={base + 'services/iso27701/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-shield"/></svg></span> ISO 27701 — Privacy
          </a>
          <a role="menuitem" href={base + 'services/iso42001/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-ai-chip"/></svg></span> ISO 42001 — AI Governance
          </a>
          <a role="menuitem" href={base + 'services/essential-eight/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-australia"/></svg></span> Essential Eight
          </a>
          <a role="menuitem" href={base + 'services/is18/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-government"/></svg></span> IS18 — QLD Government
          </a>
          <a role="menuitem" href={base + 'services/rffr/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-government"/></svg></span> RFFR — Right Fit For Risk
          </a>
          <a role="menuitem" href={base + 'services/soc2/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-check-seal"/></svg></span> SOC 2
          </a>
          <a role="menuitem" href={base + 'services/disp-ism-irap/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-government"/></svg></span> DISP / ISM / IRAP
          </a>
          <a role="menuitem" href={base + 'services/nist-csf/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-clipboard"/></svg></span> NIST CSF
          </a>
          <hr class="dd-divider" />
          <a role="menuitem" href={base + 'how-we-work/'} class="dd-secondary">How we work →</a>
        </div>
      </div>

      <a class={`nav-link${isActive(base + 'pricing') ? ' active' : ''}`} href={base + 'pricing/'}>Pricing</a>

      <a class={`nav-link nav-link-checkpoint${isActive(base + 'checkpoint-console') ? ' active' : ''}`} href={base + 'checkpoint-console/'}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-compass"/></svg> Checkpoint
      </a>

      <!-- Free Resources dropdown -->
      <div class="nav-dd">
        <button
          class={`nav-link nav-dd-btn${isActive(base + 'checklist') || isActive(base + 'resources') || isActive(base + 'blog') ? ' active' : ''}`}
          type="button"
          aria-expanded="false"
          aria-controls="freeResourcesMenu"
        >
          Free Resources <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div id="freeResourcesMenu" class="nav-dd-menu" role="menu" aria-label="Free Resources">
          <a role="menuitem" href={base + 'free-roadmap/'} style="background:rgba(169,129,46,0.08);border:1px solid rgba(169,129,46,0.2);border-radius:8px;margin-bottom:4px;">
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-gift"/></svg></span> Free starter pack
          </a>
          <a role="menuitem" href={base + 'posture-scan/'} style="background:rgba(169,129,46,0.08);border:1px solid rgba(169,129,46,0.2);border-radius:8px;margin-bottom:4px;">
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-bolt"/></svg></span> Free posture scan
          </a>
          <a role="menuitem" href={base + 'framework-overlap-calculator/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-note"/></svg></span> Framework overlap calculator
          </a>
          <a role="menuitem" href={base + 'ransomware-payment-reporting-checker/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-bolt"/></svg></span> Ransomware reporting checker
          </a>
          <a role="menuitem" href={base + 'cyber-insurance-readiness-check/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-shield"/></svg></span> Cyber insurance readiness check
          </a>
          <a role="menuitem" href={base + 'checklist/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-note"/></svg></span> Free checklists
          </a>
          <a role="menuitem" href={base + 'training/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-books"/></svg></span> Training: ISMS, AIMS &amp; PIMS
          </a>
          <a role="menuitem" href={base + 'resources/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-books"/></svg></span> Guides &amp; resources
          </a>
          <a role="menuitem" href={base + 'blog/'}>
            <span class="dd-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#ic-insight"/></svg></span> Insights
          </a>
        </div>
      </div>

      <a class={`nav-link${isActive(base + 'case-studies') ? ' active' : ''}`} href={base + 'case-studies/'}>Results</a>
      <a class={`nav-link${isActive(base + 'about') ? ' active' : ''}`} href={base + 'about/'}>About</a>
      <a class={`nav-link${isActive(base + 'contact') ? ' active' : ''}`} href={base + 'contact/'}>Contact</a>

      <!-- Search — /search/ has always existed and worked, but was linked
           from neither the header nor the footer, so nothing could reach
           it. Icon-only on desktop (the nav already carries eight items);
           expands to a labelled row in the stacked mobile menu, where an
           unlabelled glyph would read as decoration. -->
      <a
        class={`nav-search${isActive(base + 'search') ? ' active' : ''}`}
        href={base + 'search/'}
        aria-label="Search this site"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="16.5" y1="16.5" x2="21" y2="21"/>
        </svg>
        <span class="nav-search-label">Search</span>
      </a>

      <!-- CTA -->
      <a href={ctaUrl} class="btn-cta" aria-label="Book a call">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2v3M17 2v3M3 10h18M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
        </svg>
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  /* ── Accent stripe ── */
  .accent-stripe {
    height: 3px;
    background: linear-gradient(90deg, #8B6820 0%, #A9812E 50%, #D8BA78 100%);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
  }

  /* ── Header shell ── */
  .site-header {
    position: sticky;
    top: 3px;
    z-index: 50;
    background: #0B0B0C;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    transition: box-shadow 0.3s ease, background 0.3s ease;
  }

  /* Glassmorphism where supported — content glides beneath the ink */
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .site-header {
      background: rgba(11, 11, 12, 0.88);
      -webkit-backdrop-filter: blur(16px) saturate(1.5);
      backdrop-filter: blur(16px) saturate(1.5);
    }
  }

  .site-header.scrolled {
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }

  /* ── Brand ── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-logo {
    display: block;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .brand:hover .brand-logo {
    transform: scale(1.06);
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 300;
    color: #FAF7F1;
    letter-spacing: 0.12em;
    font-family: Manrope, system-ui, sans-serif;
    text-transform: uppercase;
  }

  .brand-365 {
    color: #D8BA78;
    font-weight: 800;
    margin-left: 2px;
    letter-spacing: 0.01em;
  }

  /* ── Nav ── */
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border-radius: 10px;
    color: #D8D5CD;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    opacity: 1;
    transition: background 0.15s, color 0.15s, opacity 0.15s;
    position: relative;
  }

  .nav-link:hover {
    background: rgba(169, 129, 46, 0.1);
    color: #D8BA78;
    opacity: 1;
  }

  .nav-link.active {
    color: #D8BA78;
    opacity: 1;
    background: rgba(169, 129, 46, 0.12);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #A9812E, #D8BA78);
  }

  .nav-link-checkpoint {
    border: 1px solid rgba(169, 129, 46, 0.3);
  }

  .nav-link-checkpoint svg {
    width: 14px;
    height: 14px;
    color: #A9812E;
    flex-shrink: 0;
  }

  .nav-link-checkpoint:hover svg,
  .nav-link-checkpoint.active svg {
    color: #D8BA78;
  }

  /* ── Dropdown ── */
  .nav-dd { position: relative; }

  .nav-dd-btn {
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .chev {
    font-size: 11px;
    opacity: 0.6;
    transition: transform 0.2s;
  }

  .nav-dd.open .chev {
    transform: rotate(180deg);
  }

  .nav-dd-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 240px;
    background: #1B1B1D;
    border: 1px solid rgba(169, 129, 46, 0.2);
    border-radius: 16px;
    padding: 6px;
    box-shadow:
      0 20px 48px rgba(0,0,0,0.5),
      0 4px 12px rgba(0,0,0,0.3);
    display: none;
    z-index: 100;
  }

  .nav-dd-menu a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border-radius: 10px;
    text-decoration: none;
    color: #D8D5CD;
    font-weight: 600;
    font-size: 0.88rem;
    transition: background 0.12s, color 0.12s;
  }

  .nav-dd-menu a:hover {
    background: rgba(169, 129, 46, 0.1);
    color: #D8BA78;
  }

  .dd-icon {
    width: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #A9812E;
  }

  .dd-icon svg {
    width: 16px;
    height: 16px;
  }

  .dd-divider {
    margin: 5px 6px;
    border: none;
    border-top: 1px solid rgba(169, 129, 46, 0.2);
  }

  .dd-secondary {
    opacity: 0.7;
    font-size: 0.83rem !important;
  }

  .nav-dd.open .nav-dd-menu { display: block; }

  /* ── CTA button ── */
  /* Icon-only on desktop, but still a full 44px target rather than a
     24px glyph with nothing around it. */
  .nav-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    padding: 7px 11px;
    border-radius: 10px;
    color: #D8D5CD;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .nav-search svg { width: 18px; height: 18px; flex-shrink: 0; }
  .nav-search:hover { background: rgba(169, 129, 46, 0.1); color: #FAF7F1; }
  .nav-search.active { color: #D8BA78; }
  .nav-search-label {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.88rem;
    color: #D8BA78;
    text-decoration: none;
    white-space: nowrap;
    background: transparent;
    border: 1px solid #A9812E;
    box-shadow: none;
    transition: all 0.2s ease;
    margin-left: 6px;
    letter-spacing: 0.04em;
  }

  .btn-cta:hover {
    background: #A9812E;
    color: #0B0B0C;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(169,129,46,0.3);
  }

  .btn-cta:active { transform: translateY(0); }

  .btn-cta svg {
    width: 15px;
    height: 15px;
    stroke: rgba(255,255,255,0.9);
    fill: none;
    stroke-width: 1.8;
    flex-shrink: 0;
  }

  /* ── Mobile toggle ── */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(169, 129, 46, 0.35);
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    color: #D8D5CD;
    transition: background 0.15s, border-color 0.15s;
  }

  .nav-toggle:hover {
    background: rgba(169, 129, 46, 0.1);
    border-color: rgba(169, 129, 46, 0.5);
    color: #D8BA78;
  }

  @media (max-width: 1020px) {
    .nav-toggle { display: inline-flex; }
    .nav {
      position: absolute;
      top: 67px;
      left: 0;
      right: 0;
      display: grid;
      gap: 2px;
      background: #0B0B0C;
      border-bottom: 1px solid rgba(169, 129, 46, 0.2);
      box-shadow: 0 16px 40px rgba(0,0,0,0.5);
      padding: 10px 14px;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
      z-index: 60;
    }
    .nav.open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .nav-link { width: 100%; justify-content: space-between; }
    /* Checkpoint is a plain icon+label link (not a dropdown), so
       space-between would fling its compass icon and label to opposite
       edges — keep them together, left-aligned, like the other links. */
    .nav-link-checkpoint { justify-content: flex-start; }
    .nav-dd { width: 100%; }
    .nav-dd-menu {
      position: static;
      display: none;
      box-shadow: none;
      border-radius: 10px;
      border: 1px solid rgba(169, 129, 46, 0.2);
      margin-top: 4px;
      background: #1B1B1D;
    }
    .nav-dd.open .nav-dd-menu { display: block; }
    /* In the stacked menu the icon gets its label back and the row
       behaves like every other nav link. */
    .nav-search {
      width: 100%;
      justify-content: flex-start;
      gap: 6px;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .nav-search-label {
      position: static;
      width: auto; height: auto;
      margin: 0; overflow: visible;
      clip: auto; white-space: normal;
    }
    .btn-cta {
      width: 100%;
      justify-content: center;
      margin-top: 4px;
      margin-left: 0;
    }
    .nav-link.active::after { display: none; }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
</style>

<script is:inline>
  (function () {
    const nav = document.getElementById('primaryNav');
    const toggle = document.querySelector('.nav-toggle');
    const dds = document.querySelectorAll('.nav-dd');
    const header = document.querySelector('.site-header');

    // Scroll shadow
    if (header) {
      const onScroll = () => {
        header.classList.toggle('scrolled', window.scrollY > 10);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    function closeAll() {
      dds.forEach(dd => {
        dd.classList.remove('open');
        const btn = dd.querySelector('.nav-dd-btn');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }

    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!open) closeAll();
      });
    }

    dds.forEach(dd => {
      const btn = dd.querySelector('.nav-dd-btn');
      if (!btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = dd.classList.contains('open');
        closeAll();
        if (!isOpen) {
          dd.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (![...dds].some(dd => dd.contains(e.target))) closeAll();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();
</script>
