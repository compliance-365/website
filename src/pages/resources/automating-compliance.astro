---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

const pageTitle = 'Automating Compliance Evidence in Microsoft 365, Azure & AWS';
const pageDesc = 'A practitioner guide to automating ISO 27001, SOC 2, Essential Eight, and ISO 42001 evidence using the platforms you already own — Microsoft 365, Azure, and AWS. No new platform to buy.';

const articleLd = {
  '@type': 'Article',
  headline: pageTitle,
  description: pageDesc,
  datePublished: '2026-05-17',
  dateModified: '2026-05-20',
  about: [
    { '@type': 'Thing', name: 'Compliance automation' },
    { '@type': 'Thing', name: 'ISO 27001' },
    { '@type': 'Thing', name: 'SOC 2' },
    { '@type': 'Thing', name: 'Essential Eight' },
    { '@type': 'Thing', name: 'Microsoft 365' },
    { '@type': 'Thing', name: 'Azure' },
    { '@type': 'Thing', name: 'AWS' }
  ],
  author: { '@type': 'Organization', name: 'Compliance365' },
  publisher: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  isPartOf: { '@id': 'https://www.compliance365.com.au#website' }
};

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do you provide a new compliance tool or platform?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We do not provide or resell a new platform. We automate evidence and controls using tools you already run — Microsoft 365 (Entra ID, Defender, Intune, Purview, Power Automate, Power BI), Azure, and AWS native services.'
      }
    },
    {
      '@type': 'Question',
      name: 'Which frameworks can be automated this way?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 27001, SOC 2 Type II, Essential Eight ML2, ISO 27701, and ISO 42001 — using the same underlying evidence model so audits become repeatable across frameworks.'
      }
    },
    {
      '@type': 'Question',
      name: 'Where does the automated evidence live?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In SharePoint document libraries with retention policies, version history, and metadata enforcement. Power Automate flows capture configuration exports, screenshots, and approval records on a defined cadence and file them into structured dated folders.'
      }
    }
  ]
};

const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.compliance365.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.compliance365.com.au/resources' },
    { '@type': 'ListItem', position: 3, name: 'Automating Compliance', item: 'https://www.compliance365.com.au/resources/automating-compliance' }
  ]
};
---

<Base title={pageTitle} description={pageDesc} schema={[articleLd, faqLd, breadcrumbLd]}>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground />
    <div class="container svc-hero-copy" style="position:relative;z-index:1;">
      <p class="eyebrow">Guide · Compliance Automation</p>
      <h1 style="max-width:880px;">{pageTitle}</h1>
      <p class="section-lead" style="max-width:760px;">
        How to turn evidence collection, access reviews, and security posture into continuous assurance using the platforms you already own. No GRC platform required. No annual licence to renew.
      </p>
      <p style="max-width:760px;font-size:0.95rem;">
        This is the methodology we use on every engagement — written up so you can apply it yourself, or so you can evaluate whether what we propose actually makes sense before booking a call.
      </p>

      <ul class="trust-signals">
        <li>Practitioner guide</li>
        <li>~12 min read</li>
        <li>Microsoft 365 · Azure · AWS</li>
      </ul>
    </div>
  </section>

  <!-- THE CORE ARGUMENT -->
  <section class="section">
    <div class="container">
      <div style="max-width:860px;margin:0 auto;">
        <h2>The case for not buying a GRC platform</h2>
        <p class="muted">
          Most compliance consulting engagements start with a recommendation to buy Vanta, Drata, Secureframe, or one of the Australian alternatives. The argument is reasonable on the surface: a dedicated platform centralises evidence, automates collection, and gives you a single pane of glass for the auditor.
        </p>
        <p class="muted">
          The argument breaks down on closer inspection. These platforms charge $15&ndash;60k per year in licence fees that compound across surveillance audits. They require their own implementation and training. They sit alongside the security tools you already pay for &mdash; Entra ID, Defender, Intune, Purview, Azure Policy, AWS Config &mdash; rather than replacing any of them. And when you eventually outgrow them, your evidence is locked in their format.
        </p>
        <p class="muted">
          The alternative is to treat your existing platforms as the GRC tool. Microsoft 365, Azure, and AWS already generate the configuration data, audit logs, and policy state that auditors want to see. The job isn't to recreate that in a new system &mdash; it's to capture, structure, and retain it where it already lives.
        </p>
        <p class="muted">
          The rest of this guide walks through how we do that across the four areas auditors care about most.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT TO AUTOMATE -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">The four areas worth automating first</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Not all evidence needs to be automated. Some controls are inherently manual (incident post-mortems, management reviews, vendor due diligence). The high-leverage targets for automation are the ones auditors sample heavily and that change frequently enough that manual capture becomes unsustainable.
      </p>

      <div class="grid-2" style="margin-top:3rem;max-width:960px;margin-left:auto;margin-right:auto;">
        <div class="card">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#A9812E;text-transform:uppercase;margin:0 0 0.5rem;">1 of 4</p>
          <h3>Access reviews and privileged access</h3>
          <p class="muted small">
            Quarterly access reviews are an auditor favourite because they prove the least-privilege principle is operating, not just stated. Automated in Entra ID with PIM exports, Conditional Access policy snapshots, and privileged role attestation logs filed monthly. This single area typically saves 20+ hours per audit cycle once it's running.
          </p>
        </div>

        <div class="card">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#A9812E;text-transform:uppercase;margin:0 0 0.5rem;">2 of 4</p>
          <h3>Endpoint and patching posture</h3>
          <p class="muted small">
            Every framework expects evidence that endpoints are managed, patched, and monitored. Defender for Endpoint exposure scores, Intune compliance reports, and patch cadence exports captured fortnightly. The artefacts auditors want to see exist already &mdash; the job is to file them defensibly.
          </p>
        </div>

        <div class="card">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#A9812E;text-transform:uppercase;margin:0 0 0.5rem;">3 of 4</p>
          <h3>Data classification and DLP</h3>
          <p class="muted small">
            ISO 27001, ISO 27701, and SOC 2 all want evidence that sensitive data is classified, protected, and monitored. Purview sensitivity label reports, DLP policy exports, audit log searches, and retention policy state &mdash; automated and dated. Particularly important for the privacy frameworks.
          </p>
        </div>

        <div class="card">
          <p style="font-size:0.7rem;font-weight:700;letter-spacing:1px;color:#A9812E;text-transform:uppercase;margin:0 0 0.5rem;">4 of 4</p>
          <h3>Cloud configuration baselines</h3>
          <p class="muted small">
            For Azure: Azure Policy assignments, compliance state, and conformance against built-in initiatives. For AWS: AWS Config conformance pack results, Security Hub findings, and CloudTrail digest summaries. Both export to the same evidence library structure as the M365 controls.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE TOOLS -->
  <section class="section">
    <div class="container">
      <h2 class="center">The platforms doing the work</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        Six core platforms cover roughly 85% of the evidence surface for ISO 27001, SOC 2, Essential Eight, ISO 27701, and ISO 42001 combined. Each is something you already own if you're on Microsoft 365 E5 with an Azure or AWS footprint.
      </p>

      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature">
          <h3>Entra ID (with P2 + PIM)</h3>
          <p class="muted small">
            Conditional Access policies, MFA enforcement, access reviews, Privileged Identity Management, and identity governance. The single most important platform for compliance automation. PIM exports drive privileged access evidence; access review reports drive least-privilege evidence.
          </p>
        </div>
        <div class="card feature">
          <h3>Defender for Endpoint P2</h3>
          <p class="muted small">
            Endpoint detection and response, vulnerability management, attack surface reduction, and security recommendations. The exposure score, vulnerability dashboard, and ASR rule reports feed directly into Essential Eight, ISO 27001, and SOC 2 evidence.
          </p>
        </div>
        <div class="card feature">
          <h3>Intune</h3>
          <p class="muted small">
            Device compliance, configuration profiles, application protection, and update rings. The platform that operationalises most of the Essential Eight technical controls. Compliance state reports and policy assignment exports are auditor staples.
          </p>
        </div>
        <div class="card feature">
          <h3>Purview</h3>
          <p class="muted small">
            Information protection, data loss prevention, retention policies, audit logs, and eDiscovery. Particularly important for ISO 27701 (privacy) and the Confidentiality TSC under SOC 2. Audit log exports and DLP policy state are the high-frequency artefacts.
          </p>
        </div>
        <div class="card feature">
          <h3>Power Automate &amp; SharePoint</h3>
          <p class="muted small">
            The connective tissue. Power Automate flows run on schedule, pull configuration exports from the platforms above, and file them into a structured SharePoint evidence library with retention and version history. This is what makes the whole pattern continuous.
          </p>
        </div>
        <div class="card feature">
          <h3>Azure Policy + AWS Config</h3>
          <p class="muted small">
            Same model, different cloud. Azure Policy assignments and compliance state for Azure workloads; AWS Config conformance packs and rules for AWS workloads. Both export to the same SharePoint structure as M365 evidence, so auditors see a unified pack.
          </p>
        </div>
      </div>

      <p class="muted center" style="margin-top:2.5rem;font-size:0.9rem;max-width:680px;margin-left:auto;margin-right:auto;">
        Power BI dashboards typically sit on top of this to provide the executive view &mdash; KPIs, trend lines, and posture summaries pulled directly from the evidence library. Useful for steering committees and surveillance audit prep, but not the primary mechanism.
      </p>
    </div>
  </section>

  <!-- THE EVIDENCE STRUCTURE -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">Sample SharePoint evidence structure</h2>
      <p class="muted center" style="max-width:760px;margin:1.5rem auto;">
        A folder pattern we've used across dozens of engagements. The principles: one library per control domain, dated subfolders (YYYY-MM) for sampling consistency, file properties capturing flow run IDs for provenance, retention policies enforcing what auditors expect to see.
      </p>

      <details class="card" style="padding:1.5rem;border-radius:12px;max-width:860px;margin:2rem auto 0;">
        <summary style="cursor:pointer;font-weight:700;color:#A9812E;">View the example folder tree</summary>
        <pre style="margin:1rem 0 0;white-space:pre;overflow:auto;background:#0B0B0C;color:#DDD8CF;padding:1.25rem;border-radius:8px;font-size:0.85rem;line-height:1.5;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;"><code>SharePoint › Evidence Hub
├── 00_Metas/
│   ├── README.md
│   └── Evidence-Register.xlsx
├── 01_SoA-ISO27001/
│   ├── SoA-Register.xlsx
│   ├── Mapping/
│   │   └── SoA-to-Risk-Matrix.xlsx
│   └── Evidence/
│       ├── 2026-04/
│       │   ├── SoA-Change-Log.pdf
│       │   └── Reviewer-Approval.msg
│       └── 2026-05/
│           └── SoA-Change-Log.pdf
├── 02_Risk-Register/
│   ├── Risk-Register.xlsx
│   └── Evidence/
│       ├── 2026-04/Risk-Review-Minutes.pdf
│       └── 2026-05/Risk-Workshop-Attendance.pdf
├── 03_Access-Reviews-Entra/
│   ├── Exports/
│   │   ├── 2026-04/privileged-roles.csv
│   │   ├── 2026-04/mfa-state.csv
│   │   └── 2026-05/mfa-state.csv
│   ├── Screenshots/
│   │   └── 2026-05/PIM-settings.png
│   └── Approvals/
│       └── 2026-05/Access-Review-Approvals.pdf
├── 04_Endpoint-and-Patch-Defender-Intune/
│   ├── Exports/
│   │   ├── 2026-04/device-compliance.csv
│   │   └── 2026-05/defender-exposure-score.csv
│   └── Screenshots/
│       └── 2026-05/patch-profile-baseline.png
├── 05_Data-and-Privacy-Purview/
│   ├── Policies/
│   │   └── 2026-05/Retention-Policy-Settings.pdf
│   ├── Exports/
│   │   └── 2026-05/audit-log-export.csv
│   └── DPIA-ROPA/
│       ├── ROPA-Register.xlsx
│       └── 2026-05/DPIA-Consent-Flow-Approval.pdf
├── 06_Change-and-Release/
│   ├── CI-CD/
│   │   └── 2026-05/pipeline-gates.pdf
│   └── CAB/
│       └── 2026-05/CAB-Minutes.pdf
├── 07_Vendor-and-Third-Parties/
