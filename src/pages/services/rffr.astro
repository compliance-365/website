---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import ScopingWidget from '../../components/ScopingWidget.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import rffr from '../../data/rffr-controls.json';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';
const c = rffr.counts;
const autoPct = Math.round((c.microsoftAutomated / c.ismTotal) * 100);
const assessablePct = Math.round((c.microsoftAssessable / c.ismTotal) * 100);

// Guidelines with the most Microsoft-automatable coverage, for the matrix teaser
const topGuidelines = [...rffr.guidelines].sort((a, b) => b.automated - a.automated).slice(0, 6);

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Right Fit For Risk (RFFR) Cyber Security Accreditation',
  serviceType: 'RFFR / ISM Statement of Applicability Compliance',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/rffr',
  description:
    'Right Fit For Risk (RFFR) accreditation for DEWR Employment Services providers — the full ISM Statement of Applicability built on an ISO 27001 ISMS with Essential Eight uplift, delivered inside your own Microsoft 365 tenant with continuous, automated posture assessment.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Right Fit For Risk (RFFR)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'RFFR is the cyber-security accreditation the Department of Employment and Workplace Relations (DEWR) requires of its Employment Services providers and their subcontractors. It is delivered as an ISMS-based Statement of Applicability: providers must address the Australian Government Information Security Manual (ISM) controls relevant to Non-Classified and OFFICIAL: Sensitive information, plus a set of RFFR obligations derived from the program deeds. Category 1 providers additionally certify their ISMS to ISO 27001.'
      }
    },
    {
      '@type': 'Question',
      name: 'How does RFFR relate to ISO 27001 and the Essential Eight?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'RFFR is built on an Information Security Management System (ISMS). The SoA is structured exactly like an ISO 27001 SoA — every control has an applicability decision, implementation status, evidence and a treatment plan — and Category 1 providers certify that ISMS to ISO 27001:2022. Many ISM controls are the Essential Eight mitigation strategies restated, and the SoA carries the ML1/ML2/ML3 maturity mapping. We deliver all three as one cross-mapped programme so the certification, the E8 uplift and the RFFR SoA are prepared once, not three times.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much of the RFFR SoA can be automated?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `The RFFR SoA has ${c.ismTotal} ISM controls plus ${c.deeds} program-deed obligations. Our Checkpoint console reads your Microsoft 365 tenant through read-only Microsoft Graph checks and directly auto-assesses ${c.microsoftAutomated} ISM controls — the identity, access, system-hardening, logging, cryptography and backup controls where a live Microsoft signal exists, each proposed and confirmed with one click. Including the ${c.e8Mapped} Essential Eight-mapped controls (delivered via the bundled E8 module), about ${assessablePct}% of the SoA is Microsoft-assessable. The remaining governance, personnel, physical and documentation controls stay practitioner-assessed — a Manual result is never silently counted as a pass.`
      }
    },
    {
      '@type': 'Question',
      name: 'What is the difference between a Category 1 and Category 2A provider?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It determines how much of the SoA you must address. Category 1 providers address three worksheets — the RFFR Obligations, the full ISM control set, and the ISO 27001 Annex A controls — and obtain independent ISO 27001 certification. Category 2A providers address two — the RFFR Obligations and the ISM controls — and are not required to certify to ISO 27001 unless they choose to. Both handle OFFICIAL and OFFICIAL: Sensitive information, so both must address every applicable ISM control.'
      }
    },
    {
      '@type': 'Question',
      name: 'Where does our compliance data live during an RFFR engagement?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Inside your own Microsoft 365 tenant, and nowhere else. The Checkpoint console has no backend and no vendor database — every register (the SoA, risks, evidence, incidents, audit trail) is a SharePoint list in your tenant, and posture checks are read from Microsoft Graph in the browser at scan time. RFFR requires that data relating to the Services is not accessible from, transferred to, or stored outside Australia without written departmental approval — an architecture that never copies your posture data to a third-party platform is the cleanest way to hold that line.'
      }
    }
  ]
};
---

<Base
  title="RFFR (Right Fit For Risk) Accreditation — ISM SoA via an ISO 27001 ISMS | Compliance365"
  description={`Right Fit For Risk accreditation for DEWR Employment Services providers. The full ISM Statement of Applicability (${c.ismTotal} controls + ${c.deeds} deed obligations) built on an ISO 27001 ISMS with Essential Eight uplift — around ${assessablePct}% Microsoft-assessable from your own tenant.`}
  ogImage="https://www.compliance365.com.au/og/og-rffr.png"
  schema={[serviceLd, faqLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Services', url: 'https://www.compliance365.com.au/services/' },
    { name: 'RFFR', url: 'https://www.compliance365.com.au/services/rffr/' }
  ]}
>
  <Header />

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">Right Fit For Risk · DEWR · ISM June 2026 · Employment Services</p>
        <h1>RFFR, built through the ISMS — not bolted on beside it.</h1>
        <p class="section-lead">
          Right Fit For Risk is an ISM Statement of Applicability delivered on an ISO 27001-aligned ISMS with Essential Eight uplift. We build that ISMS once and let it carry all three obligations — the {c.ismTotal} ISM controls, the {c.deeds} program-deed requirements, and (for Category 1) ISO 27001 certification — with every register living inside <em>your</em> Microsoft 365 tenant and the technical baseline assessed directly from it.
        </p>

        <ul class="trust-signals">
          <li>Full ISM June 2026 SoA — {c.ismTotal} controls</li>
          <li>Built on an ISO 27001 ISMS backbone</li>
          <li>Essential Eight uplift included ({c.e8Mapped} mapped controls)</li>
          <li>{c.microsoftAssessable} controls Microsoft-assessable ({c.microsoftAutomated} one-click today)</li>
          <li>Data sovereignty — nothing leaves your tenant</li>
        </ul>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
          <a href={`${base}resources/rffr-soa-controls/`} class="btn-hdk-ghost">Browse the full SoA →</a>
        </div>
      </div>

      <div class="svc-hero-image">
        <img
          src={`${base}assets/illus-disp-ism-irap.svg`}
          alt="Illustration of the RFFR Statement of Applicability delivered through an ISO 27001 ISMS"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- WHAT RFFR ACTUALLY IS -->
  <section class="section">
    <div class="container">
      <h2 class="center">RFFR is one accreditation made of three registers</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto 3rem;">
        The department's SoA template stacks three obligations into a single Statement of Applicability. We deliver them as one cross-mapped control set on a shared ISMS, so a control implemented for one is evidenced for all.
      </p>

      <div class="grid-3" style="gap:2rem;">
        <div class="card feature spot">
          <p style="font-size:2rem;font-weight:800;color:#A9812E;margin:0;">{c.deeds}</p>
          <h3 style="margin:0.35rem 0 0.75rem;">RFFR Obligations</h3>
          <p class="muted small">
            The program-deed requirements — positive identity confirmation, pre-employment and Working With Vulnerable People checks, right-to-work, IT administrators who are Australian citizens or permanent residents, and Services data that stays onshore. All flagged as RFFR Core Expectations.
          </p>
        </div>
        <div class="card feature spot" style="border:2px solid #A9812E;">
          <p style="font-size:2rem;font-weight:800;color:#8B6820;margin:0;">{c.ismTotal}</p>
          <h3 style="margin:0.35rem 0 0.75rem;color:#8B6820;">ISM controls (June 2026)</h3>
          <p class="muted small">
            Every ACSC ISM control applicable to Non-Classified and OFFICIAL: Sensitive information, across {c.guidelines} guidelines — from cyber security roles through system hardening, cryptography and gateways. {c.rffrCore} are flagged RFFR Core Expectations for milestone prioritisation.
          </p>
        </div>
        <div class="card feature spot">
          <p style="font-size:2rem;font-weight:800;color:#A9812E;margin:0;">93</p>
          <h3 style="margin:0.35rem 0 0.75rem;">ISO 27001 Annex A</h3>
          <p class="muted small">
            For Category 1 providers seeking independent certification — the 2022 Annex A control set, delivered as our existing ISO 27001 module. Category 2A providers skip this worksheet unless they choose to certify voluntarily.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE BUILD RFFR THROUGH THE ISMS -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">How we build RFFR <em>through</em> the ISMS</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        RFFR isn't a separate rulebook to satisfy alongside your security programme — it <em>is</em> a security programme, expressed as an ISM SoA. So we build the management system first and let it produce the accreditation.
      </p>

      <div class="grid-2" style="margin-top:3rem;gap:2rem;">
        <div class="card feature spot">
          <h3>1. Stand up the ISMS</h3>
          <p class="muted small">
            Scope and boundaries, information security policy, risk methodology and risk register, and the SoA itself — structured to ISO 27001 exactly as the RFFR template expects. This is the system of record every control status and piece of evidence hangs from.
          </p>
        </div>
        <div class="card feature spot">
          <h3>2. Load the SoA as one register</h3>
          <p class="muted small">
            All {c.ismTotal} ISM controls and {c.deeds} deed obligations become a single Statement of Applicability in your tenant — applicability decision, implementation status, evidence, plan, date and owner per control, with RFFR Core Expectations and Essential Eight maturity levels flagged for prioritisation.
          </p>
        </div>
        <div class="card feature spot">
          <h3>3. Cross-map, don't duplicate</h3>
          <p class="muted small">
            Every automatable ISM control carries a cross-reference to its ISO 27001 and Essential Eight equivalents. Implement MFA once and it evidences the ISM control, the ISO control and the E8 strategy together — so a Category 1 provider's certification falls out of the same work as the SoA.
          </p>
        </div>
        <div class="card feature spot">
          <h3>4. Assess automatically, maintain continuously</h3>
          <p class="muted small">
            Read-only Microsoft Graph checks assess the technical controls against your live tenant and propose a status a practitioner confirms with one click. An optional drift monitor re-runs them between milestones, so the posture you attest at accreditation is still true at your next review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE MICROSOFT AUTOMATION STORY -->
  <section class="section">
    <div class="container">
      <h2 class="center">How much of the SoA Microsoft 365 assesses for you</h2>
      <p class="muted center" style="max-width:820px;margin:1.5rem auto;">
        We're deliberately honest about this — automation is a layer, not a silver bullet. The identity, hardening, logging, cryptography and backup controls map to live signals in your Microsoft tenant; the governance, personnel and physical controls are work a practitioner has to attest. We never count a manual control as a pass because a scan couldn't reach it.
      </p>

      <div class="grid-3" style="margin-top:2.5rem;text-align:center;">
        <div class="card spot" style="border:2px solid #A9812E;">
          <p style="font-size:2.5rem;font-weight:800;color:#8B6820;margin:0;">{c.microsoftAutomated}</p>
          <p class="muted small" style="margin-top:0.5rem;"><strong>auto-assessed today</strong> — controls a live Microsoft Graph check proposes a status for, confirmed with one click. No manual evidence gathering.</p>
        </div>
        <div class="card spot">
          <p style="font-size:2.5rem;font-weight:800;color:#A9812E;margin:0;">{c.microsoftAssessable}</p>
          <p class="muted small" style="margin-top:0.5rem;"><strong>Microsoft-assessable</strong> (~{assessablePct}%) once the {c.e8Mapped} Essential Eight-mapped controls in the bundled E8 module are included.</p>
        </div>
        <div class="card spot">
          <p style="font-size:2.5rem;font-weight:800;color:#A9812E;margin:0;">{c.rffrCore}</p>
          <p class="muted small" style="margin-top:0.5rem;"><strong>RFFR Core Expectations</strong> — prioritised first at every milestone, whether automated or manual.</p>
        </div>
      </div>

      <div style="max-width:760px;margin:3rem auto 0;">
        <h3 class="center" style="margin-bottom:1.5rem;">Where the automation lands</h3>
        <table class="rffr-mini-table">
          <thead><tr><th>ISM guideline</th><th style="text-align:right;">Controls</th><th style="text-align:right;">Auto-assessed</th></tr></thead>
          <tbody>
            {topGuidelines.map((g) => (
              <tr>
                <td>{g.name.replace('Guidelines for ', '')}</td>
                <td style="text-align:right;">{g.count}</td>
                <td style="text-align:right;color:#A9812E;font-weight:700;">{g.automated}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="center" style="margin-top:1.5rem;">
          <a href={`${base}resources/rffr-soa-controls/`} class="btn-hdk-ghost">See the full control library &amp; automation matrix →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container">
      <h2 class="center">Who this is for</h2>
      <div class="grid-3" style="margin-top:3rem;">
        <div class="card feature spot">
          <h3>Category 1 providers</h3>
          <p class="muted small">
            Larger providers who must address the RFFR Obligations, the full ISM control set <em>and</em> ISO 27001 Annex A, and obtain independent ISO 27001:2022 certification. One ISMS produces both the SoA and the certification.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Category 2A providers</h3>
          <p class="muted small">
            Providers who address the RFFR Obligations and the ISM controls without mandatory ISO 27001 certification — the same SoA, the same automation, sized to the two worksheets that apply to you.
          </p>
        </div>
        <div class="card feature spot">
          <h3>Subcontractors in the supply chain</h3>
          <p class="muted small">
            Organisations delivering program services under a head provider whose deed flows RFFR down to them. An evidence-backed SoA — honest about gaps, with a credible plan — is what satisfies the department's review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <h2 class="center">Common questions</h2>
      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        <div class="card spot">
          <h3>What is RFFR, exactly?</h3>
          <p class="muted small">
            DEWR's cyber-security accreditation for Employment Services providers. It's delivered as an ISM Statement of Applicability — the ISM controls for Non-Classified and OFFICIAL: Sensitive information plus obligations derived from the program deeds — on an ISO 27001-aligned ISMS.
          </p>
        </div>
        <div class="card spot">
          <h3>How does it relate to ISO 27001 and the Essential Eight?</h3>
          <p class="muted small">
            The SoA is structured like an ISO 27001 SoA and Category 1 providers certify to it; many ISM controls are the Essential Eight strategies restated, with ML1–ML3 mappings carried through. We deliver all three cross-mapped so nothing is done three times.
          </p>
        </div>
        <div class="card spot">
          <h3>How much can Microsoft 365 assess automatically?</h3>
          <p class="muted small">
            {c.microsoftAutomated} ISM controls are auto-assessed today from a live Graph check; with the {c.e8Mapped} Essential Eight-mapped controls included, about {assessablePct}% of the SoA is Microsoft-assessable. Governance, personnel and physical controls stay practitioner-assessed, and a manual result is never counted as a pass.
          </p>
        </div>
        <div class="card spot">
          <h3>Where does our data live?</h3>
          <p class="muted small">
            In your own Microsoft 365 tenant, full stop. No backend, no vendor database — the SoA and every register are SharePoint lists in your tenant, and posture checks never leave the browser. That directly supports RFFR's onshore-data obligation.
          </p>
        </div>
        <div class="card spot">
          <h3>Category 1 or Category 2A — which am I?</h3>
          <p class="muted small">
            It depends on your contract with the department and the scale of services. Category 1 addresses three worksheets and certifies to ISO 27001; Category 2A addresses two and certifies only if it chooses to. We confirm your category and scope the SoA to match on the first call.
          </p>
        </div>
        <div class="card spot">
          <h3>We already have ISO 27001 — what's left?</h3>
          <p class="muted small">
            A strong ISO 27001 ISMS carries much of the governance layer, but RFFR adds the prescriptive ISM technical controls and the deed obligations. We map your existing ISMS across so only the genuinely new ISM and RFFR-specific work gets done.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED FRAMEWORKS -->
  <section class="section" style="background:#FAF7F1;">
    <div class="container center">
      <h2>Related frameworks</h2>
      <p class="muted" style="margin:1rem auto 2rem;max-width:680px;">
        RFFR is built on ISO 27001 and the Essential Eight, and shares its ISM control surface with the DISP / IRAP programme for organisations working across employment and defence government.
      </p>
      <div class="pill-row" style="justify-content:center;flex-wrap:wrap;">
        <a class="pill" href={`${base}services/iso27001/`}>ISO 27001 (Information Security)</a>
        <a class="pill" href={`${base}services/essential-eight/`}>Essential Eight (ASD)</a>
        <a class="pill" href={`${base}services/disp-ism-irap/`}>DISP / IRAP (Defence)</a>
        <a class="pill" href={`${base}resources/rffr-soa-controls/`}>The full RFFR SoA →</a>
      </div>
    </div>
  </section>

  <!-- SCOPING WIDGET -->
  <section class="section">
    <div class="container" style="max-width:720px;">
      <ScopingWidget calendlyUrl={ctaUrl} />
    </div>
  </section>

  <RelatedResources fw="rffr" />

  <!-- FINAL CTA -->
  <section class="svc-final-cta">
    <CinematicBackground static />
    <div class="container">
      <h2>Where do you actually stand against the ISM SoA?</h2>
      <p>
        A free 30-minute call gives you an honest read on your RFFR position — which category applies, how much of the {c.ismTotal}-control SoA your Microsoft 365 tenant already evidences, and what a realistic path to accreditation looks like whether you're a Category 1 provider, a Category 2A provider, or a subcontractor inheriting the obligation.
      </p>
      <div class="final-buttons">
        <a href={ctaUrl} class="btn-hdk-primary">Book a free 30-min call</a>
        <a href={`${base}resources/rffr-soa-controls/`} class="btn-hdk-ghost">Browse the SoA first</a>
      </div>
      <p style="margin-top:1.75rem;">
        <button onclick="window.c365OpenChat && window.c365OpenChat('I\'m looking at your RFFR (Right Fit For Risk) service page. Can you help me understand what RFFR requires, how it relates to ISO 27001 and the Essential Eight, and how much of the ISM SoA can be assessed automatically from Microsoft 365?')" style="background:transparent;border:none;color:rgba(250,247,241,.55);font-size:0.95rem;cursor:pointer;text-decoration:underline;padding:0;">
          Have a question? Ask AI &rarr;
        </button>
      </p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .rffr-mini-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .rffr-mini-table th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6B6860; padding: 0.5rem 0.75rem; border-bottom: 2px solid #DDD8CF; }
  .rffr-mini-table td { padding: 0.55rem 0.75rem; border-bottom: 1px solid #EEE9E0; }
  .rffr-mini-table tbody tr:hover { background: #FAF7F1; }
</style>
