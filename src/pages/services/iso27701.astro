---
import Base from '../../layouts/BaseLayout.astro'; 
import Header from '../../components/Header.astro'; 
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = base + 'book';
const ctaLabel = 'Book a call';

// FAQ Structured Data
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type":"Question",
      "name":"What is ISO 27701?",
      "acceptedAnswer":{
        "@type":"Answer",
        "text":"ISO 27701 extends ISO 27001 to include privacy management requirements, building a Privacy Information Management System (PIMS) that governs how personal data is collected, used, stored, and shared."
      }
    },
    {
      "@type":"Question",
      "name":"Why implement ISO 27701 with ISO 27001?",
      "acceptedAnswer":{
        "@type":"Answer",
        "text":"Because ISO 27701 directly builds on the same control framework and clauses as ISO 27001. You can certify both together using shared risk registers, controls, and audit evidence—saving time and cost."
      }
    },
    {
      "@type":"Question",
      "name":"Do we need new tools for ISO 27701?",
      "acceptedAnswer":{
        "@type":"Answer",
        "text":"No. We embed privacy workflows directly inside Microsoft 365—using SharePoint for evidence, Power Automate for DPIA routing, and Purview for data discovery and classification."
      }
    },
    {
      "@type":"Question",
      "name":"How long does ISO 27701 implementation take?",
      "acceptedAnswer":{
        "@type":"Answer",
        "text":"Add-on to an existing ISO 27001 ISMS: 4–8 weeks. Greenfield ISMS + PIMS: typically 12–16 weeks to audit readiness."
      }
    }
  ]
};
---

<Base
  title="ISO 27701 (Privacy Information Management System) — Australia | Compliance365"
  description="ISO 27701 privacy certification built on your ISO 27001 system — covering DPIAs, ROPAs, data rights, and privacy controls with audit-ready evidence in Microsoft 365."
  schema={[
    {
      "@type":"Service",
      "@id":"https://www.compliance365.com.au/services/iso27701#service",
      "serviceType":"ISO 27701 (PIMS)",
      "name":"ISO 27701 Privacy Implementation (Australia)",
      "url":"https://www.compliance365.com.au/services/iso27701",
      "areaServed":{"@type":"Country","name":"Australia"},
      "provider":{"@type":"Organization","name":"Compliance365","url":"https://www.compliance365.com.au"},
      "offers":{"@type":"Offer","availability":"https://schema.org/InStock"}
    },
    {
      "@type":"BreadcrumbList",
      "itemListElement":[
        {"@type":"ListItem","position":1,"name":"Home","item":"https://www.compliance365.com.au/"},
        {"@type":"ListItem","position":2,"name":"Services","item":"https://www.compliance365.com.au/services"},
        {"@type":"ListItem","position":3,"name":"ISO 27701","item":"https://www.compliance365.com.au/services/iso27701"}
      ]
    }
  ]}
/>
  <Header />

  <Fragment slot="faq">
    <script type="application/ld+json">
      {JSON.stringify(faqLd)}
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="container section">
    <div class="grid-2" style="align-items:center">
      <div>
        <h1>ISO 27701 (Privacy)</h1>
        <p class="muted">
          Extend your <strong>ISO 27001</strong> with a <strong>Privacy Information Management System (PIMS)</strong> covering 
          DPIAs, ROPAs, rights handling, and privacy governance — all delivered inside <strong>Microsoft 365</strong> and SharePoint.
        </p>

        <div class="pill-row no-wrap" style="margin-top:10px">
          <span class="pill">DPIAs</span><span class="pill">ROPA</span><span class="pill">Rights handling</span>
          <span class="pill">Third-party clauses</span><span class="pill">Training</span><span class="pill">Evidence hub</span>
        </div>

        <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
          <a class="btn btn-ghost" href={base + 'case-studies'}>See privacy outcomes</a>
          <a class="btn btn-ghost" href={base + 'checklist/iso27701'}>Try the checklist</a>
        </div>

        <p class="small muted" style="margin-top:10px">
          <strong>Ideal for ISO 27001-certified organisations</strong> that need to demonstrate GDPR, APPs, or HIPAA-aligned privacy governance.
        </p>
      </div>

      <div class="card" style="padding:0;overflow:hidden;border-radius:22px">
        <img
          src={(import.meta.env.BASE_URL)+'assets/illus-iso27001.svg'}
          alt="ISO 27701 privacy evidence in SharePoint"
          style="width:100%;height:auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- WHY ALIGN WITH ISO 27001 -->
  <section class="container section bg-light">
    <h2>Why align ISO 27701 with ISO 27001</h2>
    <p class="muted">
      ISO 27701 is not a standalone standard — it <strong>extends ISO 27001</strong>. 
      By building both under a single management system, your organisation gains:
    </p>
    <ul class="muted">
      <li><strong>Shared controls and evidence:</strong> Policies, risk registers and SoA are reused across both standards.</li>
      <li><strong>Lower certification effort:</strong> One combined audit instead of two parallel ones.</li>
      <li><strong>Unified reporting:</strong> Security and privacy metrics on the same dashboard.</li>
      <li><strong>Future-ready compliance:</strong> Alignment to GDPR, APPs, HIPAA and AI regulations.</li>
    </ul>
  </section>

  <!-- WHAT’S INCLUDED -->
  <section class="container section">
    <h2>What’s included</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card"><h3>DPIA framework</h3><p class="muted">Power Automate templates and threshold logic for privacy impact workflows.</p></div>
      <div class="card"><h3>ROPA & lifecycle</h3><p class="muted">Processing records, retention periods, deletion and minimisation — managed in SharePoint.</p></div>
      <div class="card"><h3>Privacy controls</h3><p class="muted">Purpose limitation, lawful basis, data rights, breach response and lawful transfers.</p></div>
      <div class="card"><h3>Third-party management</h3><p class="muted">Due diligence, DPA clauses and vendor risk integration with your ISMS.</p></div>
      <div class="card"><h3>Training & awareness</h3><p class="muted">Role-based training delivered in Teams or Viva Learning, tracked by completion.</p></div>
      <div class="card"><h3>Evidence Hub</h3><p class="muted">All privacy artefacts filed in SharePoint with metadata and retention tagging.</p></div>
    </div>
  </section>

  <!-- MICROSOFT 365 IMPLEMENTATION -->
  <section class="container section">
    <h2>Delivered inside Microsoft 365</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card small"><h3>Data discovery</h3><p class="muted small"><strong>Microsoft Purview:</strong> data classification, DLP policies, and sensitive info types.</p></div>
      <div class="card small"><h3>Workflows</h3><p class="muted small"><strong>Power Automate + SharePoint:</strong> DPIA, ROPA and incident approval flows.</p></div>
      <div class="card small"><h3>Evidence Hub</h3><p class="muted small"><strong>SharePoint:</strong> retention, metadata, and privacy evidence mapped to controls.</p></div>
    </div>
    <p class="muted" style="margin-top:10px">
      This approach leverages the Microsoft stack your teams already use — no new licenses, portals or training overhead.
    </p>
  </section>

  <!-- OUTCOMES -->
  <section class="container section">
    <h2>Outcomes</h2>
    <div class="grid-3" style="margin-top:14px">
      <div class="card"><h3>Unified ISMS + PIMS</h3><p class="muted">One management system for security and privacy, reducing admin effort.</p></div>
      <div class="card"><h3>Faster assurance</h3><p class="muted">Evidence generated automatically through integrated Microsoft workflows.</p></div>
      <div class="card"><h3>Privacy maturity uplift</h3><p class="muted">Metrics, reporting and audit readiness built into your M365 environment.</p></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container section-tight" style="padding-bottom:70px;">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-radius:22px">
      <div>
        <h3 style="margin:0 0 6px">Ready to extend your ISO 27001?</h3>
        <p class="muted" style="margin:0">Add privacy controls with ISO 27701 — no new platform, faster certification.</p>
      </div>
      <a class="btn btn-primary" href={ctaUrl}>{ctaLabel}</a>
    </div>
  </section>

  <!-- RELATED SERVICES -->
  <section class="container section">
    <div class="card" style="display:flex;gap:12px;flex-wrap:wrap">
      <strong style="margin-right:8px">Related services:</strong>
      <a class="pill" href="/services/iso27001">ISO 27001</a>
      <a class="pill" href="/services/iso27701">ISO 27701</a>
      <a class="pill" href="/services/iso42001">ISO 42001 (AI)</a>
      <a class="pill" href="/services/nist-csf">NIST CSF</a>
      <a class="pill" href="/services/soc2">SOC 2</a>
      <a class="pill" href="/services/essential-eight">Essential Eight</a>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .pill-row.no-wrap { display:flex; gap:10px; flex-wrap:nowrap; overflow:auto; padding-bottom:2px; }
  .pill-row.no-wrap::-webkit-scrollbar { height:6px; }
  .pill { background:#eef2ff; color:#3730a3; font-weight:600; border-radius:9999px; padding:.4rem .9rem; white-space:nowrap; }
</style>
