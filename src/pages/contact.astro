---
import Base from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';

const base = import.meta.env.BASE_URL || '/';
const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';
---

<Base title="Contact — Compliance365" description="Ask a question or request a call. We'll reply within 1 business day.">
  <Header />
  <Section title="Contact us">
    <div class="card spot">
      <h1 style="font-weight:900; font-size:clamp(1.8rem,3vw,2.4rem); margin:0 0 1rem;">
        Contact Compliance365
      </h1>
      <p>
        Email us at <a href="mailto:info@compliance365.com.au">info@compliance365.com.au</a>
        or use the form below.
      </p>

      <form id="contactForm" novalidate>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div style="display:flex;flex-direction:column;gap:4px">
            <label for="inputName" style="font-size:0.85rem;font-weight:600;color:#374151">Your name <span aria-hidden="true" style="color:#b91c1c">*</span></label>
            <input id="inputName" name="name" placeholder="Jane Smith" required autocomplete="name"
                   style="padding:12px;border-radius:10px;border:1px solid #d8dde8">
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <label for="inputEmail" style="font-size:0.85rem;font-weight:600;color:#374151">Work email <span aria-hidden="true" style="color:#b91c1c">*</span></label>
            <input id="inputEmail" name="email" type="email" placeholder="jane@company.com.au" required autocomplete="email"
                   style="padding:12px;border-radius:10px;border:1px solid #d8dde8">
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:4px;margin-top:12px">
          <label for="inputSubject" style="font-size:0.85rem;font-weight:600;color:#374151">Subject</label>
          <input id="inputSubject" name="subject" placeholder="e.g. ISO 27001 scope query"
                 style="padding:12px;border-radius:10px;border:1px solid #d8dde8;width:100%">
        </div>
        <div style="display:flex;flex-direction:column;gap:4px;margin-top:12px">
          <label for="inputMessage" style="font-size:0.85rem;font-weight:600;color:#374151">Message</label>
          <textarea id="inputMessage" name="message" placeholder="How can we help?" rows="6"
                    style="padding:12px;border-radius:10px;border:1px solid #d8dde8;width:100%"></textarea>
        </div>
        
        <p id="contactError" class="small" style="color:#b91c1c;display:none;margin:.4rem 0 0"></p>

        <div style="display:flex;align-items:center;gap:1rem;margin-top:16px;flex-wrap:wrap;">
          <button id="contactSubmit" class="btn btn-primary" type="submit">
            Send
          </button>
          <span style="color:#6B6860;font-size:0.85rem;">or</span>
          <button id="contactAI" type="button" style="padding:10px 18px;border-radius:8px;border:1.5px solid #A9812E;background:white;color:#A9812E;font-size:0.9rem;font-weight:600;cursor:pointer;">
            Get an instant answer from AI &rarr;
          </button>
        </div>
      </form>

      <p class="muted" style="font-size:.9rem;margin-top:10px">
        We'll respond within 1 business day. By submitting, you agree to our
        <a href={base + 'privacy'}>Privacy Policy</a>.
      </p>
    </div>
  </Section>

  <script define:vars={{ API_URL }}>
    const form = document.getElementById('contactForm');
    const btn = document.getElementById('contactSubmit');
    const errEl = document.getElementById('contactError');

    // Create success message element
    const successEl = document.createElement('p');
    successEl.className = 'small';
    successEl.style.cssText = 'color:#059669;display:none;margin:.6rem 0 0';
    form.appendChild(successEl);

    function validEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    }

    document.getElementById('contactAI').addEventListener('click', () => {
      const subject = (document.getElementById('inputSubject').value || '').trim();
      const message = (document.getElementById('inputMessage').value || '').trim();
      const text = [subject, message].filter(Boolean).join(' — ') || 'I have a question about your compliance services.';
      if (typeof window.c365OpenChat === 'function') {
        window.c365OpenChat(text);
      } else {
        alert('AI chat is loading — please try again in a moment.');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      errEl.style.display = 'none';
      successEl.style.display = 'none';

      const name = (document.getElementById('inputName').value || '').trim();
      const email = (document.getElementById('inputEmail').value || '').trim();
      const subject = (document.getElementById('inputSubject').value || '').trim();
      const message = (document.getElementById('inputMessage').value || '').trim();

      // Validation
      if (name.length < 2) {
        errEl.textContent = 'Please enter your full name.';
        errEl.style.display = 'block';
        return;
      }
      if (!validEmail(email)) {
        errEl.textContent = 'Please enter a valid email.';
        errEl.style.display = 'block';
        return;
      }

      btn.disabled = true;

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, subject, message })
        });

        if (!res.ok) {
          const errorText = await res.text().catch(() => '');
          throw new Error(`Request failed: ${res.status} ${errorText}`);
        }

        // Success
        form.reset();
        successEl.textContent = 'Your message has been sent successfully. We\'ll reply within 1 business day.';
        successEl.style.display = 'block';

        // Optional analytics
        try {
          if (typeof clarity === 'function') clarity('event', 'contact_form_submitted');
          if (typeof gtag === 'function') gtag('event', 'contact_form_submit', { page_location: window.location.href });
        } catch (_) {}

      } catch (err) {
        console.error('Contact form error:', err);
        errEl.innerHTML = 'Could not send right now — please email us directly at <a href="mailto:info@compliance365.com.au" style="color:#b91c1c;font-weight:700;">info@compliance365.com.au</a> and we\'ll reply within 1 business day.';
        errEl.style.display = 'block';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
  <Footer />
</Base>
