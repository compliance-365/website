      <!-- Q6 -->
      <article class="faq-card" role="listitem">
        <details>
          <summary>
            <span class="faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h7" stroke-linecap="round"/></svg>
