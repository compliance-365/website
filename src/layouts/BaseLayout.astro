---
import '../styles/responsive.css';

const {
  title = 'Compliance365 — Cyber, Privacy & AI Governance',
  description = 'ISO 27001, ISO 42001, ISO 27701 & SOC 2 delivered faster with automation and SharePoint evidence.',
  ogImage = (Astro.site
    ? new URL('assets/og-default.png', Astro.site).toString()
    : (import.meta.env.BASE_URL) + 'assets/og-default.png'),
  schema = []
} = Astro.props ?? {};

const base = import.meta.env.BASE_URL || '/';
const canonical = Astro.url?.href || 'https://www.compliance365.com.au/';;

// GA4 – leave '' to disable
const GA_ID = 'G-082VYX6D26';

// Base JSON-LD
const baseGraph = [
  {
    "@type": "Organization",
    "name": "Compliance365",
    "url": "https://www.compliance365.com.au",
    "logo": new URL("assets/logo.png", Astro.site ?? "https://www.compliance365.com.au").toString(),
    "sameAs": ["https://www.linkedin.com/company/compliance-365/"],
    "serviceArea": { "@type": "Country", "name": "Australia" },
    "knowsAbout": ["ISO 27001","ISO 27701","ISO 42001","SOC 2","ACSC Essential Eight","NIST CSF","IRAP","ISM","DISP"]
  },
  {
    "@type": "WebSite",
    "url": "https://www.compliance365.com.au",
    "name": "Compliance365",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.compliance365.com.au/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
];

const pageGraph = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const fullGraph = [...baseGraph, ...pageGraph];
/* ✅ NEW: pre-rendered JSON string for JSON-LD */
const ldJson = JSON.stringify({ "@context":"https://schema.org", "@graph": fullGraph });
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>

    <!-- Indexing & meta -->
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#4F46E5" />

    <!-- Discovery hints -->
    <link rel="sitemap" type="application/xml" title="Sitemap" href="https://www.compliance365.com.au/sitemap-index.xml" />
    <link rel="robots" href="https://www.compliance365.com.au/robots.txt" />
    <link rel="ai" href="https://www.compliance365.com.au/ai.txt" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Compliance365" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts & CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href={(import.meta.env.BASE_URL) + 'assets/brand.css'}>

    <!-- Critical fallback styles -->
    <style>
      body{font-family:Nunito,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;margin:0}
      a{color:#4F46E5}
      .container{max-width:1120px;margin:0 auto;padding:0 22px}
    </style>

    <!-- Consent Mode default (server-safe, no window usage above frontmatter) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent','default',{
        ad_user_data:'denied',
        ad_personalization:'denied',
        ad_storage:'denied',
        analytics_storage:'denied',
        functionality_storage:'granted',
        security_storage:'granted',
        wait_for_update:500
      });
      // Expose GA ID from server safely
      window.__GA_ID__ = {JSON.stringify(GA_ID)};
    </script>

  <!-- Single JSON-LD block -->
<script type="application/ld+json">
  {ldJson}
</script>
  </head>

  <body>
    <slot />

    <!-- Cookie Banner -->
    <div id="cookie-banner"
         aria-live="polite"
         style="position:fixed;inset:auto 0 0 0;background:#f8fafc;border-top:1px solid #e2e8f0;
                padding:12px 14px;display:block;z-index:9999;box-shadow:0 -8px 22px -18px rgba(0,0,0,.4)">
      <div class="container" style="display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap">
        <p style="margin:0;flex:1;min-width:260px;font-size:.95rem;line-height:1.4">
          We use cookies to improve your experience and measure traffic.
          See our <a href="/privacy" style="color:#4f46e5">Privacy Policy</a>.
        </p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button id="cookieReject"
                  type="button"
                  style="padding:8px 14px;border-radius:8px;border:1px solid #cbd5e1;background:#fff;cursor:pointer">
            Reject
          </button>
          <button id="cookieAccept"
                  type="button"
                  style="padding:8px 14px;border-radius:8px;border:0;background:#4f46e5;color:#fff;cursor:pointer">
            Accept
          </button>
        </div>
      </div>
    </div>

    <!-- Cookie/Consent controller + GA loader -->
    <script is:inline>
      (function(){
        // Helpers
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        const CONSENT_KEY = 'cookieConsentV2';
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('cookieAccept');
        const rejectBtn = document.getElementById('cookieReject');

        const GA_MEASUREMENT_ID = window.__GA_ID__ || '';
        const GA_ENABLED = !!GA_MEASUREMENT_ID;

        function show(){ if(banner) banner.style.display='block'; }
        function hide(){ if(banner) banner.style.display='none'; }

        function enableAnalytics(){
          if (!GA_ENABLED || window.__gaLoaded) return;
          window.__gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
          document.head.appendChild(s);
          s.onload = function(){
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
          };
        }

        function apply(choice){
          if(choice === 'accepted'){
            gtag('consent','update',{
              ad_storage:'granted',
              ad_user_data:'granted',
              ad_personalization:'granted',
              analytics_storage:'granted'
            });
            hide();
            enableAnalytics();
          }else if(choice === 'rejected'){
            gtag('consent','update',{
              ad_storage:'denied',
              ad_user_data:'denied',
              ad_personalization:'denied',
              analytics_storage:'denied'
            });
            hide();
          }else{
            show();
          }
        }

        // initial state
        var saved = null;
        try{ saved = localStorage.getItem(CONSENT_KEY); }catch{}
        apply(saved);

        // handlers
        document.addEventListener('click', function(e){
          var btn = e.target.closest('#cookieAccept, #cookieReject');
          if(!btn) return;
          var choice = (btn.id === 'cookieAccept') ? 'accepted' : 'rejected';
          try{ localStorage.setItem(CONSENT_KEY, choice); }catch{}
          apply(choice);
        }, { passive: true });

        // footer hook
        window.showCookieSettings = function(){
          gtag('consent','update',{
            ad_storage:'denied',
            ad_user_data:'denied',
            ad_personalization:'denied',
            analytics_storage:'denied'
          });
          show();
        };
      })();
    </script>

    <!-- Welcome to Country Modal (unchanged) -->
    <div id="welcomeModal"
         style="display:none;position:fixed;inset:0;z-index:9998;
                background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
      <div style="background:#fff;border-radius:14px;max-width:500px;padding:28px;
                  text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.25);">
        <h2 style="margin-top:0;font-weight:900;color:#1e293b;">Welcome to Country</h2>
        <p style="line-height:1.6;font-size:1rem;color:#334155;">
          Compliance365 acknowledges the Traditional Owners of Country throughout Australia — and recognises their continuing connection to land, waters and community.
          We pay our respects to Elders past and present and extend that respect to all First Nations peoples.
        </p>
        <button id="closeWelcome"
                style="margin-top:16px;padding:8px 18px;border:none;border-radius:8px;background:#4f46e5;color:#fff;font-weight:600;cursor:pointer;">
          Continue
        </button>
      </div>
    </div>
    <script is:inline>
      (function(){
        const MODAL_KEY='welcomeSeen';
        const modal=document.getElementById('welcomeModal');
        const btn=document.getElementById('closeWelcome');
        try{
          if(!localStorage.getItem(MODAL_KEY)){ modal.style.display='flex'; }
        }catch{}
        btn?.addEventListener('click',()=>{
          try{ localStorage.setItem(MODAL_KEY,'yes'); }catch{}
          modal.remove();
        });
      })();
    </script>
  </body>
</html>
