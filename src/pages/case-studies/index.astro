---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// Load all markdown case studies
const entries = await Astro.glob('../../../content/case-studies/*.md');

// Sort by title (optional)
entries.sort((a,b)=> (a.frontmatter?.title || '').localeCompare(b.frontmatter?.title || ''));

// Build hrefs that match /case-studies/[slug].astro
const cases = entries.map((entry) => {
  const parts = entry.file.split('/');
  const filename = parts[parts.length - 1];          // e.g. "health-saas.md"
  const slug = filename.replace(/\.md$/, '');        // "health-saas"
  return {
    href: `${base}case-studies/${slug}`,
    title: entry.frontmatter?.title ?? 'Case Study',
    summary: entry.frontmatter?.summary ?? '',
  };
});
---

<Base title="Case Studies — Compliance365" description="Real outcomes across ISO 27001, 27701, SOC 2, Essential Eight and more.">
  <Header />

  <section class="container section">
    <h1>Case Studies</h1>
    <p class="muted" style="max-width:820px;margin-top:-4px">
      Real customer outcomes: faster certifications, automated evidence and lasting compliance maturity.
    </p>

    <div class="grid-3" style="margin-top:14px">
      {cases.map((c) => (
        <a href={c.href} class="card lift feature" style="text-decoration:none;color:inherit">
          <h3 style="margin:0 0 6px">{c.title}</h3>
          <p class="muted" style="margin:0 0 10px">{c.summary}</p>

          <div class="pill-row">
            <span class="pill brand">Read more →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Footer />
</Base>
