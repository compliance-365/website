---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 42001 (AI Governance)';

// One source of truth for questions
const QUESTIONS = [
  // AIMS governance
  { id:'aims-scope',   label:'AIMS scope defined (AI use cases, systems, models, jurisdictions, boundaries)?', group:'gov' },
  { id:'roles-oversight', label:'AI governance roles & committees defined (owners, reviewers, RACI)?', group:'gov' },
  { id:'policies',     label:'AI policy set approved (acceptable use, risk, data sourcing, transparency)?', group:'gov' },
  { id:'objectives',   label:'AI objectives/KPIs set and reviewed (accuracy, safety, incidents, drift)?', group:'gov' },

  // Risk & impact assessment
  { id:'inventory',    label:'Model/Use-case inventory maintained (purpose, risks, data, owners)?', group:'risk' },
  { id:'risk-method',  label:'AI risk methodology & impact assessment (AIRA) defined and applied?', group:'risk' },
  { id:'data-ethics',  label:'Data ethics checks (bias, representativeness, provenance, consent) in place?', group:'risk' },

  // Design, controls & oversight
  { id:'design-controls', label:'Design controls (guardrails, filters, PII minimisation, security) are implemented?', group:'ctrl' },
  { id:'human-loop',  label:'Human oversight defined (review thresholds, escalation, override/kill-switch)?', group:'ctrl' },
  { id:'eval',         label:'Evaluation & testing process (fairness, robustness, red-teaming) documented?', group:'ctrl' },

  // Operations & monitoring
  { id:'monitor',      label:'Runtime monitoring (quality, drift, abuse, incidents) with logs & alerts?', group:'ops' },
  { id:'incident',     label:'Incident handling (AI issues, bias harms, misuse) and post-incident reviews?', group:'ops' },
  { id:'records',      label:'Documentation & records (datasets, versions, configs, decisions) maintained?', group:'ops' },

  // Suppliers & transparency
  { id:'thirdparty',   label:'Third-party AI/vendor controls (due diligence, model cards, SLAs, restrictions)?', group:'sup' },
  { id:'transparency', label:'Transparency to users (purpose, limitations, human contact) and opt-outs?', group:'sup' },

  // Evidence & improvement
  { id:'evidence',     label:'Evidence stored in M365 (SharePoint/Sentinel/Purview) with retention/versioning?', group:'ev' },
  { id:'audits',       label:'Internal audits/assurance performed; findings & CAPAs tracked to closure?', group:'ev' },
  { id:'mgmt-review',  label:'Management review of AIMS performance, risks, incidents and improvements?', group:'ev' }
];

const GROUPS = [
  { key:'gov', title:'AIMS Governance',                 blurb:'Scope, roles/committees, policy set, objectives.' },
  { key:'risk',title:'Risk & Impact Assessment',        blurb:'Inventory, AIRA method, data ethics & provenance.' },
  { key:'ctrl',title:'Design, Controls & Oversight',    blurb:'Guardrails, human-in-the-loop, evaluation/testing.' },
  { key:'ops', title:'Operations & Monitoring',         blurb:'Monitoring, incident handling, records & logs.' },
  { key:'sup', title:'Suppliers & Transparency',        blurb:'Third-party AI due diligence and user transparency.' },
  { key:'ev',  title:'Evidence & Improvement',          blurb:'Evidence management, audits and reviews.' },
];
---

<Base title="ISO 42001 Readiness Checklist" description="Answer quick questions, get an instant score and a downloadable PDF.">
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ISO 42001 Readiness Checklist</h1>
    <p class="muted" style="max-width:800px">
      Assess your AI governance against ISO 42001. Score governance, risk, controls, monitoring and transparency—then export a clean PDF for leadership.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Objective</h4>
        <p class="small">Gauge the maturity of your AIMS and identify high-value improvements.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Scoring</h4>
        <p class="small"><strong>Yes / Partial / No</strong>. Progress and readiness update automatically.</p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Output</h4>
        <p class="small">Download a branded PDF with domain breakdown and next-step guidance.</p>
      </div>
    </div>
  </section>

  <section class="container section">
     <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill" aria-current="page">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 8px;">{q.label}</label>
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download PDF</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
  (() => {
    'use strict';

    const STANDARD = "ISO 42001 (AI Governance)";
    const LEAD_ENDPOINT = ""; // optional analytics/lead endpoint

    const QUESTIONS = [
      { id:'aims-scope',   label:'AIMS scope defined (AI use cases, systems, models, jurisdictions, boundaries)?' },
      { id:'roles-oversight', label:'AI governance roles & committees defined (owners, reviewers, RACI)?' },
      { id:'policies',     label:'AI policy set approved (acceptable use, risk, data sourcing, transparency)?' },
      { id:'objectives',   label:'AI objectives/KPIs set and reviewed (accuracy, safety, incidents, drift)?' },
      { id:'inventory',    label:'Model/Use-case inventory maintained (purpose, risks, data, owners)?' },
      { id:'risk-method',  label:'AI risk methodology & impact assessment (AIRA) defined and applied?' },
      { id:'data-ethics',  label:'Data ethics checks (bias, representativeness, provenance, consent) in place?' },
      { id:'design-controls', label:'Design controls (guardrails, filters, PII minimisation, security) are implemented?' },
      { id:'human-loop',   label:'Human oversight defined (review thresholds, escalation, override/kill-switch)?' },
      { id:'eval',         label:'Evaluation & testing process (fairness, robustness, red-teaming) documented?' },
      { id:'monitor',      label:'Runtime monitoring (quality, drift, abuse, incidents) with logs & alerts?' },
      { id:'incident',     label:'Incident handling (AI issues, bias harms, misuse) and post-incident reviews?' },
      { id:'records',      label:'Documentation & records (datasets, versions, configs, decisions) maintained?' },
      { id:'thirdparty',   label:'Third-party AI/vendor controls (due diligence, model cards, SLAs, restrictions)?' },
      { id:'transparency', label:'Transparency to users (purpose, limitations, human contact) and opt-outs?' },
      { id:'evidence',     label:'Evidence stored in M365 (SharePoint/Sentinel/Purview) with retention/versioning?' },
      { id:'audits',       label:'Internal audits/assurance performed; findings & CAPAs tracked to closure?' },
      { id:'mgmt-review',  label:'Management review of AIMS performance, risks, incidents and improvements?' }
    ];

    (document.readyState === 'loading')
      ? document.addEventListener('DOMContentLoaded', setup)
      : setup();

    function setup(){
      const form       = document.getElementById('form');
      const bar        = document.getElementById('bar');
      const scoreNum   = document.getElementById('scoreNum');
      const scoreLabel = document.getElementById('scoreLabel');
      const scoreHint  = document.getElementById('scoreHint');
      const resetBtn   = document.getElementById('resetBtn');
      const pdfBtn     = document.getElementById('pdfBtn');

      const modal      = document.getElementById('leadModal');
      const leadForm   = document.getElementById('leadForm');
      const cancelLead = document.getElementById('cancelLead');
      const nameEl     = document.getElementById('name');
      const emailEl    = document.getElementById('email');

      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

      form.addEventListener('click', (e)=>{
        const btn = e.target.closest('button.opt');
        if(!btn || !form.contains(btn)) return;
        const field = btn.closest('.field'); if(!field) return;
        const id  = field.dataset.id;
        const val = Number(btn.dataset.v);
        state[id] = val;
        field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
        btn.classList.add('active');
        update();
      });

      resetBtn?.addEventListener('click', ()=>{
        Object.keys(state).forEach(k => state[k] = null);
        form.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
        update();
      });

      pdfBtn.addEventListener('click', ()=>{
        const { answered } = compute(state);
        if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
        openModal();
      });

      function openModal(){ if(modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
      function closeModal(){ if(modal){ modal.style.display = 'none'; } }
      cancelLead?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
      document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

      leadForm?.addEventListener('submit', async (e)=>{
        e.preventDefault();
        const name  = (nameEl?.value || '').trim();
        const email = (emailEl?.value || '').trim();
        if(!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ alert('Please enter your name and a valid email.'); return; }

        const meta = {
          checklist: STANDARD,
          timestamp: new Date().toISOString(),
          ...compute(state),
          total: QUESTIONS.length,
          answers: state,
          name, email
        };

        try{
          if(LEAD_ENDPOINT){
            fetch(LEAD_ENDPOINT, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(meta) })
              .catch(()=>{});
          }
        }catch(_){}

        closeModal();
        generatePDF(state);
      });

      const s = document.createElement('style');
      s.textContent = `
        button.opt{cursor:pointer}
        button.opt.active{
          background:#f0f2ff!important;
          border-color:#4F46E5!important;
          color:#1f2a5c!important;
        }`;
      document.head.appendChild(s);

      update();

      function update(){
        const { answered, score } = compute(state);
        const pct = Math.round((answered / QUESTIONS.length) * 100);
        bar.style.width = pct + '%';
        scoreNum.textContent = `${score}%`;

        let label='Not started', hint='Answer the questions to see your readiness.';
        if (answered>0 && score<40)      { label='Early stage';  hint='Lock AIMS scope/roles, policy set and inventory.'; }
        else if (score<70)               { label='In progress';  hint='Run AIRAs, embed guardrails and human oversight.'; }
        else if (score<90)               { label='Nearly ready'; hint='Tighten monitoring, incident handling and records.'; }
        else                             { label='Audit-ready';  hint='Maintain cadence and assure third-party AI.'; }
        scoreLabel.textContent = label;
        scoreHint.textContent  = hint;
      }
    }

    function compute(state){
      const answered = Object.values(state).filter(v => v !== null).length;
      const scoreRaw = Object.values(state).reduce((a,v)=> a + (v ?? 0), 0);
      const score    = Math.round((scoreRaw / (Object.keys(state).length * 2)) * 100);
      return { answered, score: isNaN(score) ? 0 : score };
    }

    function generatePDF(state){
      const { jsPDF } = window.jspdf || {};
      if(!jsPDF){ alert('PDF library not loaded.'); return; }

      const doc = new jsPDF('p','mm','a4');
      const W=210, LM=14, RM=14; let y=16;
      const now = new Date();
      const fmt = d=> d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});

      // header
      doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
      doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

      try{
        const logoEl = document.getElementById('pdfLogo');
        if(logoEl && logoEl.complete){
          const targetW=18, ratio=(logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
          const targetH=Math.min(18,targetW*ratio);
          doc.addImage(logoEl,'PNG',LM,6,targetW,targetH,undefined,'FAST');
          doc.setTextColor(255,255,255);
          doc.setFont('helvetica','bold'); doc.setFontSize(15);
          doc.text('Compliance365 — Readiness Report', LM+targetW+4, 16);
          doc.setFont('helvetica','normal'); doc.setFontSize(11);
          doc.text('ISO 42001 (AI Governance) quick-scan summary', LM+targetW+4, 22);
        } else {
          doc.setTextColor(255,255,255);
          doc.setFont('helvetica','bold'); doc.setFontSize(15);
          doc.text('Compliance365 — Readiness Report', LM, 16);
          doc.setFont('helvetica','normal'); doc.setFontSize(11);
          doc.text('ISO 42001 (AI Governance) quick-scan summary', LM, 22);
        }
      }catch(_){}

      doc.setFontSize(10); doc.text(`Date: ${fmt(now)}`, W-RM, 16, {align:'right'});

      // dial
      y = 38;
      const { answered, score } = compute(state);
      const STATUS = (answered===0)?'Not started' : (score<40)?'Early stage' : (score<70)?'In progress' : (score<90)?'Nearly ready' : 'Audit-ready';

      doc.setTextColor(0); doc.setFont('helvetica','bold'); doc.setFontSize(13);
      doc.text('Your Readiness at a Glance', LM, y); y+=8;

      const dialX=LM+26, dialY=y+24;
      doc.setDrawColor(230,233,242); doc.setLineWidth(6); doc.circle(dialX,dialY,20,'S');
      doc.setDrawColor(79,70,229);
      const pct=Math.max(0,Math.min(score,100))/100, segs=Math.max(1,Math.round(60*pct));
      for(let i=0;i<segs;i++){
        const a1=(-Math.PI/2)+(i/segs)*2*Math.PI, a2=a1+0.1;
        doc.line(dialX+20*Math.cos(a1), dialY+20*Math.sin(a1), dialX+20*Math.cos(a2), dialY+20*Math.sin(a2));
      }
      doc.setFont('helvetica','bold'); doc.setFontSize(14); doc.setTextColor(17,24,39);
      doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

      doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
      doc.text(`Answered: ${answered}/${Object.keys(state).length}`, LM+56, y+4);
      doc.text('Status:', LM+56, y+12);
      doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
      doc.text(STATUS, LM+74, y+12);

      // next steps
      doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
      doc.text('Next steps:', LM+56, y+20);
      const tips = (score<40)
        ? ['Define AIMS scope & roles','Build use-case inventory','Publish AI policy set']
        : (score<70)
          ? ['Run AIRAs for priority uses','Embed guardrails & HITL','Establish evaluation cadence']
          : (score<90)
            ? ['Tune monitoring & incidents','Tighten supplier controls','Harden records & traceability']
            : ['Maintain reviews & metrics','Retest after changes/drift','Assure third-party AI regularly'];
      tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, y+26+i*5));
      y+=54;

      // domains
      doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
      doc.text('Domain Breakdown', LM, y); y+=5;

      const DOMAINS = {
        'AIMS Governance': ['aims-scope','roles-oversight','policies','objectives'],
        'Risk & Impact Assessment': ['inventory','risk-method','data-ethics'],
        'Design, Controls & Oversight': ['design-controls','human-loop','eval'],
        'Operations & Monitoring': ['monitor','incident','records'],
        'Suppliers & Transparency': ['thirdparty','transparency'],
        'Evidence & Improvement': ['evidence','audits','mgmt-review'],
      };

      const hr=(yy,pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM,yy,W-RM,yy); return yy+(pad||0); };

      Object.entries(DOMAINS).forEach(([name, ids])=>{
        const got=ids.reduce((a,id)=>a+(state[id]??0),0);
        const max=ids.length*2;
        const p=Math.round((got/max)*100)||0;
        doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(17,24,39);
        doc.text(name, LM, y+5);
        const barX=LM+64, barW=W-LM-RM-64;
        doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
        doc.roundedRect(barX,y,barW,7,2,2,'F');
        const fillW=Math.max(0,Math.min(barW*(p/100),barW));
        doc.setFillColor(79,70,229); doc.roundedRect(barX,y,fillW,7,2,2,'F');
        doc.setFont('helvetica','bold'); doc.setTextColor(70);
        doc.text(`${p}%`, barX+barW+4, y+5);
        y+=11;
      });

      y = hr(y,6);

      // gaps
      doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
      doc.text('Top Gaps & Risks', LM, y); y+=6;

      const highs=[], meds=[];
      const QMAP = {
        'aims-scope':'AIMS scope incomplete',
        'roles-oversight':'Oversight roles/forums unclear',
        'policies':'AI policy set incomplete',
        'objectives':'AI KPIs not reviewed',
        'inventory':'Model/use-case inventory missing',
        'risk-method':'AIRA method not applied',
        'data-ethics':'Data ethics/bias checks missing',
        'design-controls':'Guardrails/security not embedded',
        'human-loop':'HITL not defined',
        'eval':'Evaluation/testing not documented',
        'monitor':'Monitoring/logging weak',
        'incident':'Incident handling gaps',
        'records':'Records/traceability weak',
        'thirdparty':'Third-party AI DD weak',
        'transparency':'User transparency insufficient',
        'evidence':'Evidence not centralised',
        'audits':'Internal audits not performed',
        'mgmt-review':'Mgmt review missing'
      };
      Object.keys(QMAP).forEach(id=>{
        const v=state[id];
        if(v===0) highs.push(QMAP[id]); else if(v===1) meds.push(QMAP[id]);
      });

      const colW=(W-LM-RM-6)/2;
      const drawList=(title,items,x,color)=>{
        if(items.length===0) return y;
        doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(...color);
        doc.text(title,x,y);
        let yy=y+4;
        doc.setFont('helvetica','normal'); doc.setTextColor(17,24,39); doc.setFontSize(10);
        items.forEach(t=>{ const lines=doc.splitTextToSize(`- ${t}`, colW); doc.text(lines,x,yy); yy+=lines.length*4.2+1.5; });
        return yy;
      };
      const yL=drawList('High (No): address immediately', highs, LM, [239,68,68]);
      const yR=drawList('Medium (Partial): tighten soon', meds, LM+colW+6, [99,102,241]);
      y=Math.max(yL,yR)+4;

      y = hr(y,4);

      // detail
      doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
      doc.text('Detailed Responses', LM, y); y+=5;

      const FLAT = QUESTIONS.map(q=>({id:q.id,label:q.label}));
      const drawRow=(idx,text,val)=>{
        if(y>275){ doc.addPage(); y=16; }
        const rowH=12 + Math.max(0, doc.splitTextToSize(text, W-LM-RM-40).length-1)*4.2;
        doc.setFillColor(245,247,255);
        doc.roundedRect(LM,y-3,W-LM-RM,rowH+6,2,2,'F');
        doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
        const wrapW=W-LM-RM-40;
        const lines=doc.splitTextToSize(`${idx}. ${text}`, wrapW);
        doc.text(lines, LM+4, y+4);
        const label=(val===2)?'Yes':(val===1)?'Partial':(val===0)?'No':'—';
        let fill=[229,231,235], txt=[107,114,128];
        if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
        else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
        else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }
        doc.setFont('helvetica','bold'); doc.setFontSize(10);
        const tw=doc.getTextWidth(label), pillW=Math.max(22, tw+8);
        const chipX=W-RM-pillW-4, chipY=y-1;
        doc.setDrawColor(222,226,236); doc.setFillColor(...fill);
        doc.roundedRect(chipX,chipY,pillW,8,3,3,'F');
        doc.setTextColor(...txt); doc.text(label, chipX+pillW/2, chipY+5.5, {align:'center'});
        y+=rowH+8;
      };
      FLAT.forEach((q,i)=> drawRow(i+1, q.label, state[q.id]));

      if(y>246){ doc.addPage(); y=16; }
      y+=4;
      const btnW=178, btnH=18, btnX=LM, btnY=y;
      doc.setFillColor(79,70,229);
      doc.roundedRect(btnX,btnY,btnW,btnH,3,3,'F');
      doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);
      doc.text('Need help closing gaps? Book a roadmap call', btnX+6, btnY+12);
      doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });
      doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
      doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

      doc.save('iso42001_readiness.pdf');
    }
  })();
  </script>

  <!-- Lead capture modal (same markup as 27001) -->
  <div id="leadModal"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); align-items:center; justify-content:center; z-index:2000;">
    <div style="background:#fff; padding:24px; border-radius:14px; max-width:400px; width:100%; box-shadow:0 12px 30px rgba(0,0,0,.2);">
      <h3 style="margin-top:0">Before you download</h3>
      <p class="muted small">Enter your details so we can send you updates and resources:</p>
      <form id="leadForm">
        <input type="text" id="name" placeholder="Your name" style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px">
        <input type="email" id="email" placeholder="Your email" style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px">
        <div style="display:flex; gap:10px; margin-top:12px; justify-content:flex-end;">
          <button type="button" class="btn btn-ghost" id="cancelLead">Cancel</button>
          <button type="submit" class="btn btn-primary">Continue</button>
        </div>
      </form>
    </div>
  </div>
</Base>
