---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/case-studies.css';

const base = import.meta.env.BASE_URL || '/';
const cases = await Astro.glob('../../../content/case-studies/*.md');
cases.sort((a,b)=>a.frontmatter.title.localeCompare(b.frontmatter.title));
---
<Base title="Case Studies — Compliance365" description="Real outcomes across ISO 27001, 27701, SOC 2, Essential Eight and more.">
  <Header />
  <section class="cs-wrap">
    <h1>Case Studies</h1>
    <p class="muted" style="max-width:820px;margin-top:-4px">
      Real customer outcomes: faster certifications, automated evidence and lasting compliance maturity.
    </p>

    <div class="grid-3" style="margin-top:14px; display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px;">
      {cases.map((c) => {
        const img = c.frontmatter?.seo?.image || c.frontmatter?.hero?.image;
        return (
          <a href={c.url} class="card lift feature" style="text-decoration:none;color:inherit;border:1px solid #e6ebf4;border-radius:14px;overflow:hidden;background:#fff">
            {img && <img src={img} alt="" loading="lazy" style="width:100%;height:140px;object-fit:cover;border-bottom:1px solid #e6ebf4;" />}
            <div style="padding:14px;">
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
                {c.frontmatter?.sector && <span class="cs-pill">{c.frontmatter.sector}</span>}
                {Array.isArray(c.frontmatter?.tags) && c.frontmatter.tags.slice(0,2).map(t => <span class="cs-pill">{t}</span>)}
              </div>
              <h3 style="margin:0 0 6px">{c.frontmatter.title}</h3>
              <p class="muted" style="margin:0 0 10px">{c.frontmatter.summary}</p>
              <span class="pill">Read more →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
  <Footer />
</Base>
