---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
---

<Base
  title="Free readiness checklists — ISO 27001, ISO 27701, ISO 42001, SOC 2, Essential Eight, DISP / ISM / IRAP"
  description="Free cyber, privacy and AI readiness checklists with instant scores, next steps and downloadable PDF reports for ISO 27001, ISO 27701, ISO 42001, SOC 2, ASD Essential Eight and DISP / ISM / IRAP frameworks."
>
  <Header />

  <section class="container section">
    <h1>Free cyber, privacy & AI readiness checklists</h1>
<p class="muted" style="max-width:760px">
  Answer a few quick questions and get an instant readiness score, tailored next steps, and a downloadable PDF
  report for ISO, SOC 2, ASD Essential Eight and government assurance frameworks. Choose a checklist to begin:
</p>

    <div class="grid-3" style="margin-top:16px">

      <!-- ISO 27001 -->
      <a class="card lift feature" href={`${base}checklist/iso27001`} style="color:inherit" aria-label="Start ISO 27001 readiness checklist">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z" stroke="currentColor" stroke-width="1.7"/></svg>
        </div>
        <h3>ISO 27001 (Security)</h3>
        <p class="muted">ISMS scope, risk, controls, SoA and audit-readiness.</p>
        <span class="pill">Start checklist →</span>
      </a>

      <!-- ISO 27701 -->
      <a class="card lift feature" href={`${base}checklist/iso27701`} style="color:inherit" aria-label="Start ISO 27701 readiness checklist">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 7h14M5 12h10M5 17h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </div>
        <h3>ISO 27701 (Privacy)</h3>
        <p class="muted">PIMS, DPIA, ROPA, subject rights and data lifecycle.</p>
        <span class="pill">Start checklist →</span>
      </a>

      <!-- ISO 42001 -->
      <a class="card lift feature" href={`${base}checklist/iso42001`} style="color:inherit" aria-label="Start ISO 42001 readiness checklist">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h10M4 17h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </div>
        <h3>ISO 42001 (AI)</h3>
        <p class="muted">AIMS governance, model inventory, AI risk and oversight.</p>
        <span class="pill">Start checklist →</span>
      </a>

      <!-- SOC 2 -->
      <a class="card lift feature" href={`${base}checklist/soc2`} style="color:inherit" aria-label="Start SOC 2 readiness checklist">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 7h12M6 12h9M6 17h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </div>
        <h3>SOC 2 (Trust Services)</h3>
        <p class="muted">Security, availability, confidentiality, processing integrity and privacy readiness.</p>
        <span class="pill">Start checklist →</span>
      </a>

      <!-- Essential Eight -->
      <a class="card lift feature" href={`${base}checklist/essential-eight`} style="color:inherit" aria-label="Start Essential Eight readiness checklist">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </div>
        <h3>Essential Eight (ACSC)</h3>
        <p class="muted">Maturity levels, mitigation strategies and Microsoft 365 examples.</p>
        <span class="pill">Start checklist →</span>
      </a>

      <!-- DISP / ISM / IRAP -->
      <a class="card lift feature" href={`${base}checklist/disp-ism-irap`} style="color:inherit" aria-label="Start DISP-ISM-IRAP readiness checklist">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 6h14v12H5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </div>
        <h3>DISP / ISM / IRAP (Gov Assurance)</h3>
        <p class="muted">Defence and government assurance frameworks for secure environments.</p>
        <span class="pill">Start checklist →</span>
      </a>

    </div>
  </section>

  <Footer />
</Base>
