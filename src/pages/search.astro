---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Search | Compliance365" 
  description="Search ISO, SOC 2, AI, NIST CSF, and privacy compliance content by Compliance365">
  
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold mb-6 text-slate-800">Search Compliance365</h1>
    <input 
      id="searchInput"
      type="text"
      placeholder="Search ISO 27001, SOC 2, NIST CSF, AI..."
      class="w-full border rounded-lg p-3 mb-8 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />
    <div id="results"></div>
  </section>

  <!-- Load Fuse.js from CDN -->
  <script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2"></script>

  <script is:inline>
    const pages = [
      { title: 'ISO 27001 — Information Security Management', url: '/services/iso27001', description: 'Implement ISO 27001 with automation and SharePoint integration.' },
      { title: 'ISO 27701 — Privacy Information Management', url: '/services/iso27701', description: 'Extend ISO 27001 with privacy workflows and GDPR alignment.' },
      { title: 'ISO 42001 — AI Management Systems', url: '/services/iso42001', description: 'Manage AI transparency, bias, and accountability using ISO 42001.' },
      { title: 'SOC 2 — Trust Service Criteria', url: '/services/soc2', description: 'Achieve faster SOC 2 readiness with audit automation in Microsoft 365.' },
      { title: 'Essential Eight Uplift', url: '/services/essential-eight', description: 'Implement the Essential Eight controls for patching, MFA, backups, and app control.' },
      { title: 'NIST Cybersecurity Framework', url: '/services/nist', description: 'Align with NIST CSF — Identify, Protect, Detect, Respond, Recover — mapped to ISO 27001 and Essential Eight.' },
      { title: 'DISP, ISM & IRAP', url: '/services/disp-ism-irap', description: 'Defence uplift, ISM alignment, and IRAP readiness with Microsoft automation.' }
    ];

    const fuse = new Fuse(pages, { keys: ['title', 'description'], threshold: 0.3 });
    const input = document.getElementById('searchInput');
    const resultsDiv = document.getElementById('results');

    input.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      const results = query ? fuse.search(query) : [];
      resultsDiv.innerHTML = results.length
        ? results.map(r => `
          <a href="${r.item.url}" class="block border-b py-3 hover:bg-gray-50 transition">
            <h2 class="font-semibold text-lg text-indigo-700">${r.item.title}</h2>
            <p class="text-sm text-gray-600">${r.item.description}</p>
          </a>
        `).join('')
        : (query ? '<p class="text-gray-500">No results found.</p>' : '');
    });
  </script>
</BaseLayout>
