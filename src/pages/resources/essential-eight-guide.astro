import Footer from '../../components/Footer.astro';
import DigestSignup from '../../components/DigestSignup.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "The Essential Eight Explained — Australia's Complete Cyber Security Guide (2026)",
  "author": {
    "@type": "Organization",
    "name": "Compliance365",
    "url": "https://www.compliance365.com.au"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Compliance365",
    "url": "https://www.compliance365.com.au",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.compliance365.com.au/logo.png"
    }
  },
  "datePublished": "2026-06-22",
  "dateModified": "2026-06-22",
  "url": "https://www.compliance365.com.au/resources/essential-eight-guide/"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is the Essential Eight mandatory for private sector organisations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not legislatively mandated for most private sector organisations. However it is effectively required by: cyber insurers (ML2 evidence increasingly required for coverage), SOCI Act critical infrastructure operators, federal and state government procurement panels, and enterprise customers running TPRM programmes."
      }
    },
    {
      "@type": "Question",
      "name": "How long does Essential Eight ML2 take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "12-16 weeks for most Australian mid-market organisations on Microsoft 365 E5. This is significantly shorter than the 6-month timelines many consultancies quote, because 80-85% of ML2 is achievable through M365 native tooling — the work is configuration uplift, not greenfield deployment."
      }
    },
    {
      "@type": "Question",
      "name": "How much does Essential Eight ML2 cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Assessment only: $8k-$18k fixed-price (2-3 weeks). ML2 uplift programme: $22k-$120k depending on organisation size and scope. Combined E8 + ISO 27001 engagements typically cost 30-40% less than running them separately."
      }
    },
    {
      "@type": "Question",
      "name": "Do we need to buy new tools for the Essential Eight?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For M365 E5 organisations, approximately 80-85% of ML2 is achievable with native tooling. The one exception is Regular Backups — third-party M365 backup tooling (Veeam, AvePoint, HYCU, Keepit) is required as Microsoft 365 does not include enterprise backup. For E3 environments, additional licensing may be needed."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between the Essential Eight and ISO 27001?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Essential Eight is an Australian-specific, prescriptive framework targeting the most common attack vectors — it's the baseline for government and insurance compliance in Australia. ISO 27001 is an international standard with a broader risk-based scope — required for US, UK, and European enterprise procurement. About 60% of controls overlap, making combined engagements 30-40% more cost-efficient."
      }
    },
    {
      "@type": "Question",
      "name": "What evidence do we need for ML2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ASD publishes specific evidence requirements for each control at each maturity level. Evidence includes: Intune compliance policies with reporting exports, Conditional Access policy configurations, PIM activity logs, vulnerability scan reports with patch compliance rates, backup restoration test records, and a documented exception register. The evidence must be current (not more than 12 months old) and defensible against external assessor scrutiny."
      }
    },
    {
      "@type": "Question",
      "name": "How does Essential Eight relate to the PSPF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The PSPF (Protective Security Policy Framework) mandates Essential Eight compliance for non-corporate Commonwealth entities — federal government departments and most Commonwealth agencies. The current requirement is ML2 as the baseline, with ML3 recommended for high-risk environments. State government agencies are subject to their own frameworks but most align to PSPF as a reference."
      }
    },
    {
      "@type": "Question",
      "name": "What is the ACSC and how does it relate to the Essential Eight?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The ACSC (Australian Cyber Security Centre) is part of ASD (Australian Signals Directorate). The ACSC develops and publishes the Essential Eight, publishes the annual Australian Cyber Threat Report, and coordinates national cyber incident response. The Essential Eight is based directly on ACSC intelligence about the techniques most commonly used in attacks against Australian organisations."
      }
    },
    {
      "@type": "Question",
      "name": "Can we self-assess against the Essential Eight?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, but self-assessment has significant limitations. Many organisations overestimate their maturity because they assess whether a policy exists rather than whether the control is implemented to ASD intent. For cyber insurance purposes, insurer-grade evidence — not self-attestation — is increasingly required. For government procurement, assessor-verified evidence is standard. Self-assessment is a good starting point; external assessment provides defensible evidence."
      }
    },
    {
      "@type": "Question",
      "name": "How often should we reassess our Essential Eight maturity?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ASD recommends at least annual reassessment. In practice, control drift is significant — particularly for patch compliance and application control — and 30% of controls regress within 6 months without continuous monitoring. Organisations at ML2 should have continuous monitoring in place (Defender VM, Intune compliance dashboards, Sentinel alerts) supplemented by quarterly evidence reviews and annual independent reassessment."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
