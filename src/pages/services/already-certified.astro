---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CheckpointShot from '../../components/CheckpointShot.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import { MODULES, fmtAud } from '../../data/pricing.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const isoFrom = fmtAud(MODULES.find((m) => m.id === 'iso27001').prices.micro);

/* What comes across, each matched to what Checkpoint does (1.185.0):
   the certificate record schedules the cycle, the SoA import reads the
   existing spreadsheet, the four register imports, documents uploaded
   as they are, and the posture scan. */
const across = [
  { n: 'Your certificate', d: 'Certification body, certificate number and dates. Your surveillance audits, recertification and the preparation for each go on the compliance calendar.' },
  { n: 'Your Statement of Applicability', d: 'Imported from your existing spreadsheet: applicability, reasons for inclusion and exclusion, status, owners and evidence links for each control. You see every change before it is made.' },
  { n: 'Your registers', d: 'Risks, suppliers, assets and open actions or audit findings, imported from spreadsheets. If your column names differ, you pick which is which.' },
  { n: 'Your policies', d: 'Uploaded as they are, with their review dates tracked. You do not have to switch to our templates.' },
  { n: 'Your Microsoft 365 evidence', d: 'The posture scan checks your tenant against the controls and captures evidence for your next surveillance audit.' }
];

const steps = [
  { n: 'A 30-minute call', d: 'What you are certified to, when your next surveillance audit is, and what you run today. We quote the transfer as a fixed fee.' },
  { n: 'Checkpoint in your tenant', d: 'Installed in your own Microsoft 365. Its registers are SharePoint lists in your tenant, so your ISMS records stay with you.' },
  { n: 'Bring it across', d: 'Certificate, Statement of Applicability, registers and policies, from what you already have. Checkpoint tracks each step on the Dashboard.' },
  { n: 'Check it against your last audit', d: 'We run the first posture scan and go through your last audit report’s findings with you, so anything still open is in Actions with an owner before the surveillance audit.' },
  { n: 'Run the cycle', d: 'Optional: we act as your internal auditor and help you prepare for each surveillance audit, with everything recorded in Checkpoint.' }
];

const faqs = [
  { q: 'Do we have to change certification body?', a: 'No. Your certificate and your certification body stay as they are. Checkpoint changes where your ISMS records live and how they are kept up to date, not who audits you.' },
  { q: 'Our SoA is in a spreadsheet. Will it import?', a: 'Yes, from a CSV saved from Excel. Checkpoint finds the control codes however they are written (A.5.1, 5.1 or "A.5.1 Policies for information security"), shows exactly what will change, and lists any row it cannot place. A code from the 2013 edition, such as A.9.2.1, is listed for you to map to its 2022 control rather than guessed.' },
  { q: 'What about evidence in our current platform?', a: 'Evidence held in SharePoint or OneDrive comes across as links with your SoA. Evidence held inside another platform needs exporting first; we plan that with you on the first call.' },
  { q: 'Do we lose anything we built?', a: 'The import only changes the fields in your file, and never adds or removes a control. Your policies are uploaded as they are. Everything is in your own tenant, so it stays yours if you stop using Checkpoint.' },
  { q: 'We are certified to ISO 27701 or ISO 42001 as well.', a: 'Checkpoint records those certificates and their audit cycles too, and imports a Statement of Applicability for each framework you hold.' }
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Bring an existing ISMS to Checkpoint',
  serviceType: 'ISMS transfer for organisations already certified to ISO 27001',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/already-certified/',
  description: 'For organisations already certified to ISO 27001: bring the certificate, Statement of Applicability, registers and policies into Checkpoint, inside your own Microsoft 365, and keep the certification cycle running.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};
---

<Base
  title="Already ISO 27001 Certified? Bring Your ISMS Across | Compliance365"
  description="Already ISO 27001 certified? Bring your certificate, SoA, registers and policies into Checkpoint in your own Microsoft 365. Keep your certification body."
  schema={[serviceLd, faqLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Services', url: 'https://www.compliance365.com.au/services/' },
    { name: 'Already certified', url: 'https://www.compliance365.com.au/services/already-certified/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">Already certified · ISO 27001 · ISO 27701 · ISO 42001</p>
        <h1>Keep your certificate. <em>Bring your ISMS across.</em></h1>
        <p class="section-lead">
          You have done the hard part. Moving to Checkpoint does not mean starting again: your certificate, Statement of Applicability, registers and policies come across from what you already have.
        </p>
        <p>
          Checkpoint runs inside your own Microsoft 365, so there is no separate platform holding your data. Your certification body stays the same.
        </p>

        <ul class="trust-signals">
          <li>Same certificate, same certification body</li>
          <li>SoA imported from your spreadsheet</li>
          <li>Registers and policies kept</li>
          <li>Surveillance audits on the calendar</li>
          <li>Data stays in your tenant</li>
        </ul>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
          <a href={`${base}pricing/`} class="btn-hdk-ghost">See pricing →</a>
        </div>
      </div>
      <div class="svc-hero-image">
        <img src={`${base}assets/illus-already-certified.svg`} alt="Illustration of an existing ISMS — risk register, Statement of Applicability, policies and audit findings — moving into Checkpoint" width="720" height="470" loading="eager" />
      </div>
    </div>
  </section>

  <!-- WHAT COMES ACROSS -->
  <section class="section" id="across" style="padding-top:3rem;padding-bottom:3rem;background:rgba(190, 74, 30,0.06);">
    <div class="container" style="max-width:960px;">
      <h2 class="center" style="margin-bottom:0.5rem;">What comes across</h2>
      <p class="muted center" style="max-width:720px;margin:0.75rem auto 2rem;">Everything an auditor samples at a surveillance audit, from the records you already keep.</p>
      <div style="display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
        {across.map((a) => (
          <div class="card" style="padding:1.5rem;">
            <h3 style="margin-top:0;">{a.n}</h3>
            <p class="small" style="margin:0;">{a.d}</p>
          </div>
        ))}
      </div>
      <CheckpointShot id="soaIso27001" label="Your Statement of Applicability, once it is across" caption="Each Annex A control keeps the status and justification you already had, now with an owner, a verification date and a link to its evidence." />
      <CheckpointShot id="riskRegister" label="Your risk register, once it is across" />
    </div>
  </section>

  <!-- HOW IT RUNS -->
  <section class="section" id="how">
    <div class="container" style="max-width:1000px;">
      <h2 class="center" style="margin-bottom:0.5rem;">How a transfer runs</h2>
      <p class="muted center" style="max-width:720px;margin:0.75rem auto 2.5rem;">
        Planned around your next surveillance audit, so you go into it with everything in one place.
      </p>
      <div style="display:grid;gap:1rem;">
        {steps.map((s, i) => (
          <div class="card" style="padding:1.25rem 1.5rem;display:grid;gap:0.5rem;">
            <div style="display:flex;gap:0.75rem;align-items:baseline;flex-wrap:wrap;">
              <span class="small muted">Step {i + 1}</span>
              <h3 style="margin:0;font-size:1.05rem;">{s.n}</h3>
            </div>
            <p class="small" style="margin:0;">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COST -->
  <section class="section" id="cost" style="padding-top:3rem;padding-bottom:3rem;background:rgba(190, 74, 30,0.06);">
    <div class="container" style="max-width:820px;">
      <h2 class="center" style="margin-bottom:0.5rem;">What it costs</h2>
      <p class="muted center" style="max-width:720px;margin:0.75rem auto 0;">
        Checkpoint for ISO 27001 is from {isoFrom} a year (AUD), running in the Microsoft 365 you already pay for. The transfer is a fixed fee, quoted after the first call once we know what you are bringing across.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container" style="max-width:820px;">
      <h2 class="center" style="margin-bottom:1.5rem;">Questions</h2>
      {faqs.map((f) => (
        <details class="card" style="padding:1rem 1.25rem;margin-bottom:0.75rem;">
          <summary style="cursor:pointer;font-weight:600;">{f.q}</summary>
          <p class="small" style="margin:0.75rem 0 0;">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section center" id="cta">
    <div class="container" style="max-width:720px;">
      <h2>When is your next <em>surveillance audit</em>?</h2>
      <p class="muted" style="margin:1rem auto 2rem;">
        A 30-minute call. Tell us what you are certified to and what you run today, and we will plan the transfer around your audit date.
      </p>
      <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
    </div>
  </section>

  <RelatedResources fw="iso27001" />

  </main>

  <Footer />
</Base>
