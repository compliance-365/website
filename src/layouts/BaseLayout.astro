---
import '../styles/responsive.css';
import Clarity from "../components/Clarity.astro";
import AIChat from "../components/AIChat.astro";

const {
  title = 'Compliance365 — Cyber, Privacy & AI Governance',
  description = 'ISO 27001, ISO 42001, ISO 27701 & SOC 2 delivered faster with automation and SharePoint evidence.',
  ogImage = (Astro.site
    ? new URL('assets/og-default.png', Astro.site).toString()
    : (import.meta.env.BASE_URL) + 'assets/og-default.png'),
  schema = [],
  breadcrumbs = [] // <-- new breadcrumb array support
} = Astro.props ?? {};
const base = import.meta.env.BASE_URL || '/';
const canonical = Astro.url?.href || 'https://www.compliance365.com.au/';
const LOGO_512 = 'https://www.compliance365.com.au/assets/logo.svg';
const LOGO_192 = 'https://www.compliance365.com.au/assets/logo-192.png';

// Base organization + website schema
const ORG = {
  "@type": ["Organization", "ProfessionalService"],
  "@id": "https://www.compliance365.com.au/#org",
  "name": "Compliance365",
  "legalName": "Compliance365 Pty Ltd",
  "alternateName": ["Compliance 365", "Compliance365 Australia"],
  "description": "Australian compliance consultancy delivering ISO 27001, SOC 2, Essential Eight and ISO 42001 inside your existing Microsoft 365 environment. Fixed-price. Audit-ready in 8–14 weeks.",
  "url": "https://www.compliance365.com.au",
  "logo": {
    "@type": "ImageObject",
    "url": LOGO_512,
    "width": 512,
    "height": 512
  },
  "image": LOGO_512,
  "telephone": "+61468752243",
  "email": "info@compliance365.com.au",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Brisbane",
    "addressRegion": "QLD",
    "addressCountry": "AU"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "info@compliance365.com.au",
    "telephone": "+61468752243",
    "areaServed": "AU",
    "availableLanguage": "English"
  },
  "sameAs": [
    "https://www.linkedin.com/company/compliance-365/",
    "https://www.facebook.com/compliance365AU"
  ],
  "serviceArea": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "City", "name": "Brisbane" },
    { "@type": "City", "name": "Melbourne" },
    { "@type": "City", "name": "Sydney" },
    { "@type": "City", "name": "Canberra" },
    { "@type": "City", "name": "Perth" },
    { "@type": "City", "name": "Adelaide" }
  ],
  "areaServed": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "City", "name": "Brisbane" },
    { "@type": "City", "name": "Melbourne" },
    { "@type": "City", "name": "Sydney" },
    { "@type": "City", "name": "Canberra" },
    { "@type": "City", "name": "Perth" },
    { "@type": "City", "name": "Adelaide" }
  ],
  "knowsAbout": [
    "ISO 27001","ISO 27701","ISO 42001","SOC 2",
    "ACSC Essential Eight","NIST CSF","IRAP","ISM","DISP"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Compliance Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 27001 Certification Support" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 27701 Privacy Management" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 42001 AI Governance" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SOC 2 Certification" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Essential Eight Assessment" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "DISP / ISM / IRAP Advisory" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "NIST CSF Implementation" } }
    ]
  }
};
const WEBSITE = {
  "@type": "WebSite",
  "@id": "https://www.compliance365.com.au/#website",
  "url": "https://www.compliance365.com.au",
  "name": "Compliance365",
  "inLanguage": "en-AU",
  "publisher": { "@id": "https://www.compliance365.com.au/#org" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.compliance365.com.au/search/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
// Breadcrumb Schema if breadcrumbs provided
const BREADCRUMB_SCHEMA = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url
      }))
    }
  : null;
// Merge graph items
const pageGraph = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const fullGraph = [ORG, WEBSITE];
if (BREADCRUMB_SCHEMA) fullGraph.push(BREADCRUMB_SCHEMA);
if (pageGraph.length) fullGraph.push(...pageGraph);
// Add “about” + “mentions” for entity clarity
fullGraph.push({
  "@type": "WebPage",
  "@id": canonical + "#webpage",
  "url": canonical,
  "name": title,
  "about": [
    "Cybersecurity compliance", "Privacy management", "AI governance",
    "ISO 27001", "ISO 27701", "ISO 42001", "SOC 2", "Essential Eight"
  ],
  "mentions": [
    "Australian Privacy Act", "NIST CSF", "IRAP", "ISM", "DISP"
  ]
});
const ldJson = JSON.stringify({ "@context": "https://schema.org", "@graph": fullGraph });
---
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <!-- Google Site Verification for Search Console ✅ -->
    <meta name="google-site-verification" content="fVhBOuNty9-ozH-lL9FvtPHiQ25rDMA7PjZIPDdgmbk" />
    <!-- Meta -->
    <meta name="description" content={description} />
    {Astro.props.robots
      ? <meta name="robots" content={Astro.props.robots} />
      : <meta name="robots" content="index,follow" />
    }
    <meta name="theme-color" content="#1e40af" />
    <!-- Discovery -->
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="https://www.compliance365.com.au/sitemap-index.xml" />
    <link rel="ai" href="https://www.compliance365.com.au/ai.txt" />
    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Compliance365" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Icons -->
    <link rel="icon" href="/assets/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <!-- Fonts: preconnect then async load with display=optional to prevent late LCP repaint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Third-party prefetch -->
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://assets.apollo.io" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <!-- Nunito: async, display=optional prevents font-swap from pushing LCP to ~3 s -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800;900&display=optional"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800;900&display=optional" />
    </noscript>
    <!-- brand.css: preload + async so it never blocks first paint -->
    <link rel="preload" href={(import.meta.env.BASE_URL) + 'assets/brand.css'} as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={(import.meta.env.BASE_URL) + 'assets/brand.css'} /></noscript>
    <!-- Critical CSS inlined — covers every above-fold element so first paint is styled -->
    <style>
      :root{
        --primary:#1e40af;--primary-dark:#1e3a8a;--primary-light:#3b82f6;
        --accent:#06b6d4;--muted:#64748b;--light:#f8fafc;--surface:#fff;
        --border:#e2e8f0;--shadow-sm:0 4px 12px rgba(0,0,0,.06);
        --radius:12px;--radius-lg:20px;
      }
      *,*::before,*::after{box-sizing:border-box}
      html,body{margin:0;padding:0}
      body{font-family:Nunito,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;color:#111827;background:var(--light);line-height:1.65;-webkit-font-smoothing:antialiased}
      img,svg,video{max-width:100%;height:auto;display:block}
      p{margin:0 0 1rem}
      a{color:var(--primary)}
      h1,h2,h3{line-height:1.12;margin:0 0 .7rem;letter-spacing:-.015em;color:var(--primary-dark)}
      h1{font:900 clamp(2.4rem,4vw,3.4rem)/1.12 Nunito,system-ui}
      h2{font:900 clamp(1.8rem,2.6vw,2.2rem)/1.12 Nunito,system-ui}
      h3{font:800 1.25rem/1.12 Nunito,system-ui}
      .container{max-width:1120px;margin:0 auto;padding:0 22px}
      .section{padding:5rem 0}
      .section-tight{padding:2.5rem 0}
      .muted{color:var(--muted)}
      .small{font-size:.875rem}
      .center{text-align:center}
      .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px;border-radius:9999px;font:700 1rem/1 Nunito,system-ui;text-decoration:none;cursor:pointer;border:2px solid transparent;transition:background .2s,color .2s,border-color .2s}
      .btn-primary{background:var(--primary);color:#fff;border-color:var(--primary)}
      .btn-primary:hover{background:var(--primary-dark);border-color:var(--primary-dark)}
      .btn-ghost,.btn-outline{background:transparent;color:var(--primary);border-color:var(--primary)}
      .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
      .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
      .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:2rem}
      /* Header */
      .site-header{position:sticky;top:0;z-index:100;background:#fff;border-bottom:1px solid var(--border);box-shadow:0 1px 8px rgba(0,0,0,.06)}
      .nav-inner{max-width:1120px;margin:0 auto;padding:0 22px;height:64px;display:flex;align-items:center;justify-content:space-between;gap:1rem}
      .brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:800;font-size:1.1rem}
      .brand-name{color:#1e293b;font-weight:800}
      .brand-365{color:#2563eb}
      /* Hero */
      .hero-wrap{padding:5rem 0 3rem;background:var(--light)}
      @media(max-width:768px){
        .grid-2,.grid-3{grid-template-columns:1fr}
        .hero-wrap{padding:3rem 0 2rem}
        .btn{min-height:44px;padding:10px 20px}
      }
    </style>

<!-- Apollo.io Website Tracker – lazy loaded on first interaction -->
    <script is:inline>
      (function () {
        function loadApollo() {
          if (window.__apolloLoaded) return;
          window.__apolloLoaded = true;
          var n = Math.random().toString(36).substring(7),
              o = document.createElement('script');
          o.src = 'https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=' + n;
          o.async = true;
          o.defer = true;
          o.onload = function () {
            window.trackingFunctions.onLoad({ appId: '691c50dec659750019914631' });
          };
          document.head.appendChild(o);
        }
        window.addEventListener('load', loadApollo);
        ['click', 'scroll', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadApollo, { once: true });
        });
      })();
    </script>

    <!-- Google Analytics 4 (GA4) – lazy loaded -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const GA_ID = 'G-082VYX6D26';
        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
        window.addEventListener('load', loadGA);
        ['click','scroll','keydown'].forEach(evt => {
          window.addEventListener(evt, loadGA, { once: true });
        });
      }
    </script>

    <!-- Bing Clarity tracking – lazy loaded on first interaction -->
    <script is:inline>
      (function () {
        function loadClarity() {
          if (window.__clarityLoaded) return;
          window.__clarityLoaded = true;
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "mghgmkzj0r");
        }
        window.addEventListener('load', loadClarity);
        ['click', 'scroll', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadClarity, { once: true });
        });
      })();
    </script>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={ldJson}></script>
  </head>
