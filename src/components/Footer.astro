---
import org from '../../content/globals/footer.json';
const base: string = import.meta.env.BASE_URL || '/';
const company = org?.companyName || 'Compliance365';
const tagline = org?.tagline || 'Cyber, AI & Privacy Compliance';
const abn = org?.abn || '';
const email = org?.email || 'info@compliance365.com.au';
const phone = org?.phone || '';
const privacy = org?.privacyUrl || (base + 'privacy/');
const terms = org?.termsUrl || (base + 'terms/');
const ctaUrl = base + 'book/';
const ctaLabel = 'Book a free call';
---

<footer class="footer">
  <div class="container footer-grid">

    <!-- Brand / socials -->
    <div class="f-col">
      <div class="brandline">
        <img src={base + 'assets/logo.svg'} alt="Compliance365" width="28" height="28" loading="lazy" />
        <strong>{company}</strong>
      </div>
      <p class="muted small" style="margin:.4rem 0 0;line-height:1.5;">{tagline}</p>
      {abn && <p class="small muted" style="margin:.25rem 0 0;">ABN {abn}</p>}
      {phone && (
        <p class="small" style="margin:.3rem 0 0;">
          <a href={`tel:${phone.replace(/\s/g,'')}`} style="color:inherit;text-decoration:none;">{phone}</a>
        </p>
      )}
      <p class="small" style="margin:.2rem 0 0;">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
      <div class="socials" style="margin-top:.75rem;display:flex;gap:.5rem;">
        <a href="https://www.linkedin.com/company/compliance-365/"
           aria-label="Compliance365 on LinkedIn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="9" width="4" height="12" rx="1" fill="currentColor"/>
            <circle cx="5" cy="5" r="2" fill="currentColor"/>
            <path d="M12 9h2.6c3 0 5.4 2.4 5.4 5.4V21h-4v-6.1c0-1.3-1-2.3-2.3-2.3S11.4 13.6 11.4 15V21h-4V9h4v1.3c.6-.8 1.8-1.3 2.6-1.3Z" fill="currentColor"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Services -->
    <nav class="f-col" aria-label="Services">
      <h4>Services</h4>
      <ul class="list-reset">
        <li><a href={base + 'services/iso27001/'}>ISO 27001</a></li>
        <li><a href={base + 'services/iso27701/'}>ISO 27701 (Privacy)</a></li>
        <li><a href={base + 'services/iso42001/'}>ISO 42001 (AI Governance)</a></li>
        <li><a href={base + 'services/essential-eight/'}>Essential Eight</a></li>
        <li><a href={base + 'services/soc2/'}>SOC 2</a></li>
        <li><a href={base + 'services/disp-ism-irap/'}>DISP / ISM / IRAP</a></li>
        <li><a href={base + 'services/nist-csf/'}>NIST CSF</a></li>
      </ul>
    </nav>

    <!-- Resources & Company -->
    <nav class="f-col" aria-label="Resources and company">
      <h4>Resources</h4>
      <ul class="list-reset">
        <li><a href={base + 'checklist/'}>Free readiness checklists</a></li>
        <li><a href={base + 'resources/'}>Guides &amp; resources</a></li>
        <li><a href={base + 'blog/'}>Insights</a></li>
        <li><a href={base + 'case-studies/'}>Client results</a></li>
      </ul>
      <h4 style="margin-top:1.25rem;">Company</h4>
      <ul class="list-reset">
        <li><a href={base + 'about/'}>About us</a></li>
        <li><a href={base + 'how-we-work/'}>How we work</a></li>
        <li><a href={base + 'contact/'}>Contact</a></li>
      </ul>
    </nav>

    <!-- Contact / CTA -->
    <div class="f-col">
      <h4>Get started</h4>
      <p class="small muted" style="margin:.2rem 0 .75rem;line-height:1.5;">
        Fixed-price. Audit-ready in 8–14 weeks. No GRC platform required.
        Based in Brisbane — serving organisations across Australia.
      </p>
      <a href={ctaUrl} class="btn btn-primary" style="display:inline-block;">{ctaLabel}</a>
      <p class="small muted" style="margin:.6rem 0 0;">
        Or try a <a href={base + 'checklist/'}>free readiness checklist</a> first.
      </p>
      <div style="margin-top:1.25rem;display:flex;flex-direction:column;gap:.3rem;">
        <a class="small" href={privacy} style="color:inherit;opacity:.8;">Privacy Policy</a>
        <a class="small" href={terms} style="color:inherit;opacity:.8;">Terms &amp; Conditions</a>
        <a class="small" href={base + 'cookies/'} style="color:inherit;opacity:.8;">Cookie Preferences</a>
      </div>
    </div>

  </div>

  <div class="container footer-bottom">
    <p class="small muted">
      © {new Date().getFullYear()} {company}. All rights reserved.
    </p>
    <p class="small muted acknowledgement">
      <span class="ack-label">We acknowledge Country.</span>
      Compliance365 acknowledges the Traditional Owners of Country throughout Australia
      and recognises their continuing connection to land, waters and community.
      We pay our respects to Elders past and present, and extend that respect to all
      Aboriginal and Torres Strait Islander peoples.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, #fafbff 0%, #ffffff 100%);
    margin-top: 60px;
    padding: 3rem 0 1.25rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .brandline {
    display: flex;
    align-items: center;
    gap: .55rem;
  }

  .socials a {
    color: var(--primary);
    display: inline-flex;
    opacity: 0.8;
    transition: opacity 0.15s;
  }

  .socials a:hover {
    opacity: 1;
  }

  .f-col h4 {
    margin: 0 0 .6rem;
    font-size: .85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #64748b;
  }

  .list-reset {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list-reset li {
    margin: .35rem 0;
  }

  .list-reset a {
    color: var(--fg);
    opacity: .85;
    text-decoration: none;
    font-size: .9rem;
    transition: color 0.15s, opacity 0.15s;
  }

  .list-reset a:hover {
    color: var(--primary);
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: .5rem;
  }

  .footer-bottom .acknowledgement {
    max-width: 780px;
    line-height: 1.6;
  }

  .footer-bottom .ack-label {
    display: block;
    font-weight: 700;
    margin-bottom: 2px;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
