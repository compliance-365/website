---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

const API_URL = 'https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us';
const STANDARD = 'ASD Essential Eight';
const pdfName  = 'essential_eight_readiness.pdf';

const GROUPS = [
  { key:'appctl',    title:'Application Control',         blurb:'Allow-lists for approved executables, libraries, scripts and MSI.' },
  { key:'patchapps', title:'Patch Applications',          blurb:'Timely patching of Internet-facing and high-risk apps.' },
  { key:'macros',    title:'Configure MS Office Macros',  blurb:'Block or tightly control macros from the Internet.' },
  { key:'hardening', title:'User Application Hardening',  blurb:'Disable risky features (e.g., Flash/Java, ads, web trackers).' },
  { key:'admin',     title:'Restrict Admin Privileges',   blurb:'Least privilege, approvals, and JIT/JEA patterns.' },
  { key:'patchos',   title:'Patch Operating Systems',     blurb:'Meet SLAs for OS patches with centralised visibility.' },
  { key:'mfa',       title:'Multi-Factor Authentication', blurb:'MFA for remote, privileged and sensitive access.' },
  { key:'backups',   title:'Regular Backups',             blurb:'Tested, immutable/tamper-evident backups and restores.' },
];

const QUESTIONS = [
  // Application Control
  { id:'ac-scope',    label:'Application allow-listing enforced on workstations/servers for EXE/DLL/Scripts/MSI?', group:'appctl' },
  { id:'ac-source',   label:'Trusted publisher / signed code policies defined with change approval workflow?',      group:'appctl' },
  { id:'ac-logs',     label:'Block & log events centralised (e.g., Defender/MDI/SIEM) with review cadence?',       group:'appctl' },

  // Patch Applications
  { id:'pa-internet', label:'Internet-facing apps (browsers, PDF, Java, email clients) patched within SLA?',       group:'patchapps' },
  { id:'pa-inv',      label:'Application inventory & risk classification maintained with owners?',                  group:'patchapps' },
  { id:'pa-evidence', label:'Automated patch reports captured monthly as evidence (SharePoint/Defender/Intune)?',  group:'patchapps' },

  // Macros
  { id:'ma-block',    label:'Block macros from the Internet; trusted locations/signing enforced?',                 group:'macros' },
  { id:'ma-config',   label:'Group Policy/Intune configuration deployed & tested across all managed devices?',     group:'macros' },
  { id:'ma-except',   label:'Exception process (time-bound, approved, logged) for business-critical macros?',      group:'macros' },

  // User Application Hardening
  { id:'uh-features',  label:'Disable or restrict risky browser features (Flash/legacy plugins, ads, trackers)?', group:'hardening' },
  { id:'uh-downloads', label:'Block executable downloads from the web for standard users?',                       group:'hardening' },
  { id:'uh-verify',    label:'Periodic verification reports/screenshots stored with policy references?',          group:'hardening' },

  // Admin Privileges
  { id:'ad-jit',    label:'Privileged access uses JIT/JEA or PAM; standing admin reduced?',                      group:'admin' },
  { id:'ad-review', label:'Quarterly access reviews/recertification for privileged groups?',                     group:'admin' },
  { id:'ad-seg',    label:'Admin accounts segmented (no email/browsing), dedicated workstations for admin?',     group:'admin' },

  // Patch Operating Systems
  { id:'po-sla',    label:'OS patch SLAs defined (e.g., 48h critical, 2w high) and met with exceptions tracked?', group:'patchos' },
  { id:'po-rings',  label:'Update rings/pilot groups and rollback plans defined & exercised?',                   group:'patchos' },
  { id:'po-report', label:'Compliance dashboards & exportable evidence (Intune/Defender/WSUS) captured?',        group:'patchos' },

  // MFA
  { id:'mfa-scope',  label:'MFA enforced for remote access, privileged roles and sensitive apps?',               group:'mfa' },
  { id:'mfa-method', label:'Phishing-resistant factors (FIDO2/passkeys/Number-match) preferred over SMS?',      group:'mfa' },
  { id:'mfa-gaps',   label:'Break-glass controls documented, tested and monitored?',                             group:'mfa' },

  // Backups
  { id:'bk-scope',   label:'Critical systems & SaaS (M365) in scope with RTO/RPO defined?',                      group:'backups' },
  { id:'bk-immut',   label:'Immutable/tamper-evident copies (air-gapped/object-lock) with separation of duties?',group:'backups' },
  { id:'bk-restore', label:'Periodic restoration tests with evidence and actioned findings?',                    group:'backups' },
];
---

<Base
  title="ASD Essential Eight Free Readiness Checklist"
  description="Free ASD Essential Eight readiness checklist for Australian organisations. Answer quick questions for each mitigation strategy, see your maturity score by domain, and download a branded PDF readiness report to share with executives, boards or auditors."
>
  <Header />

  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- Overview -->
  <section class="container section">
    <h1>ASD Essential Eight readiness checklist (free)</h1>
    <p class="muted" style="max-width:820px">
      Use this free ASD Essential Eight readiness checklist to gauge your cyber security maturity across all eight
      mitigation strategies. Select <strong>Yes / Partial / No</strong> for each item — we’ll calculate your score
      by domain and generate a PDF you can use in risk discussions, audit prep and uplift planning.
    </p>

    <div class="info-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:20px">
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>What this covers</h4>
        <p class="small">
          All eight ASD Essential Eight strategies: Application Control, patching, macros, user application hardening,
          admin privileges, OS patching, MFA and backups — mapped to practical, evidence-ready questions.
        </p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>How scoring works</h4>
        <p class="small">
          Select <strong>Yes = 2</strong>, <strong>Partial = 1</strong>, <strong>No = 0</strong> for each item.
          We calculate an overall readiness score plus a domain-by-domain breakdown.
        </p>
      </div>
      <div class="card" style="padding:16px;border:1px solid #e4e8f0;border-radius:12px;background:#f9fafc">
        <h4>Free PDF output</h4>
        <p class="small">
          Download a free, branded PDF readiness report with a score dial, domain bars, top gaps and detailed responses.
          Your details are sent via a secure AWS endpoint and used only to share the report and relevant security,
          privacy and AI governance updates.
        </p>
      </div>
    </div>
  </section>

  <section class="container section">
    <!-- Tabs -->
    <div style="margin:12px 0 8px;display:flex;gap:10px;flex-wrap:wrap">
      <a href={`${base}checklist/iso27001`} class="pill">ISO 27001</a>
      <a href={`${base}checklist/iso27701`} class="pill">ISO 27701</a>
      <a href={`${base}checklist/iso42001`} class="pill">ISO 42001</a>
      <a href={`${base}checklist/essential-eight`} class="pill" aria-current="page">Essential Eight</a>
      <a href={`${base}checklist/soc2`} class="pill">SOC 2</a>
      <a href={`${base}checklist/disp-ism-irap`} class="pill">DISP / ISM / IRAP</a>
    </div>

    <!-- Progress -->
    <div class="progress" style="height:8px;background:#eef2ff;border-radius:999px;overflow:hidden;margin:10px 0 16px;">
      <div id="bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4F46E5,#06B6D4);transition:width .2s;"></div>
    </div>

    <!-- Form card -->
    <div class="card">
      <div id="form" class="form-grid" style="display:grid;gap:18px;">
        {GROUPS.map((grp) => (
          <section class="group">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <div>
                <h3 style="margin:0">{grp.title}</h3>
                <p class="muted small" style="margin:.1rem 0 0">{grp.blurb}</p>
              </div>
              <div id={`g-${grp.key}`} class="muted small">0/0 answered</div>
            </div>

            <div class="group-fields" style="margin-top:10px;display:grid;gap:12px">
              {QUESTIONS.filter(q => q.group === grp.key).map((q) => (
                <div class="field" data-id={q.id} data-group={q.group}
                     style="padding:12px;border:1px solid rgba(10,18,32,.08);border-radius:12px;background:#fff">
                  <label style="display:block;font-weight:800;margin:0 0 8px;">{q.label}</label>
                  <div class="opts" style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="opt pill" data-v="2" type="button">Yes</button>
                    <button class="opt pill" data-v="1" type="button">Partial</button>
                    <button class="opt pill" data-v="0" type="button">No</button>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="actions" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
        <button class="btn btn-ghost" id="resetBtn" type="button">Reset</button>
        <button class="btn btn-primary" id="pdfBtn" type="button">Download free PDF report</button>
      </div>
    </div>

    <!-- Score -->
    <div class="card" style="margin-top:14px">
      <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
        <div id="scoreNum" style="font-weight:900;font-size:1.6rem;">0%</div>
        <div>
          <strong id="scoreLabel">Not started</strong>
          <p id="scoreHint" class="muted small" style="margin:.2rem 0 0">Answer the questions to see your readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <!-- Unified client logic (Essential Eight: email summary + PDF) -->
  <script
    is:inline
    data-standard={STANDARD}
    data-lead={API_URL}
    data-pdf={pdfName}
    data-q={JSON.stringify(QUESTIONS)}
    data-g={JSON.stringify(GROUPS)}
  >
(() => {
  'use strict';

  const EL        = document.currentScript;
  const STANDARD  = EL.dataset.standard || 'ASD Essential Eight';
  const LEAD_URL  = EL.dataset.lead || '';
  const PDF_NAME  = EL.dataset.pdf || 'essential_eight_readiness.pdf';
  const QUESTIONS = JSON.parse(EL.dataset.q || '[]');
  const GROUPS    = JSON.parse(EL.dataset.g || '[]');

  (document.readyState === 'loading')
    ? document.addEventListener('DOMContentLoaded', setup)
    : setup();

  function setup(){
    const form       = document.getElementById('form');
    const bar        = document.getElementById('bar');
    const scoreNum   = document.getElementById('scoreNum');
    const scoreLabel = document.getElementById('scoreLabel');
    const scoreHint  = document.getElementById('scoreHint');
    const resetBtn   = document.getElementById('resetBtn');
    const pdfBtn     = document.getElementById('pdfBtn');

    const modal      = document.getElementById('leadModal');
    const leadForm   = document.getElementById('leadForm');
    const cancelLead = document.getElementById('cancelLead');
    const nameEl     = document.getElementById('name');
    const emailEl    = document.getElementById('email');

    const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));

    // Group counters
    function refreshGroupCounters(){
      GROUPS.forEach(grp => {
        const total = QUESTIONS.filter(q=>q.group===grp.key).length;
        const ansd  = QUESTIONS.filter(q=>q.group===grp.key).map(q=>state[q.id]).filter(v=>v!==null).length;
        const el = document.getElementById('g-'+grp.key);
        if (el) el.textContent = `${ansd}/${total} answered`;
      });
    }
    refreshGroupCounters();

    // Click-to-answer
    form?.addEventListener('click', (e)=>{
      const btn = e.target.closest('button.opt');
      if (!btn || !form.contains(btn)) return;
      const field = btn.closest('.field');
      if (!field) return;

      const id  = field.dataset.id;
      const val = Number(btn.dataset.v);

      state[id] = val;
      field.querySelectorAll('button.opt').forEach(o => o.classList.remove('active'));
      btn.classList.add('active');

      refreshGroupCounters();
      update();
    });

    // Reset
    resetBtn?.addEventListener('click', ()=>{
      Object.keys(state).forEach(k => state[k] = null);
      form?.querySelectorAll('button.opt.active').forEach(o => o.classList.remove('active'));
      refreshGroupCounters();
      update();
    });

    // Gate PDF behind modal
    pdfBtn?.addEventListener('click', ()=>{
      const { answered } = compute(state);
      if (answered < QUESTIONS.length) { alert('Please answer all questions first.'); return; }
      openModal();
    });

    function openModal(){ if (modal){ modal.style.display = 'flex'; nameEl?.focus(); } }
    function closeModal(){ if (modal){ modal.style.display = 'none'; } }
    cancelLead?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e)=>{ if(e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeModal(); });

    // Submit → POST → ALWAYS generate PDF
    leadForm?.addEventListener('submit', async (e)=>{
      e.preventDefault();

      const name  = (nameEl?.value || '').trim();
      const email = (emailEl?.value || '').trim();

      if(!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
        alert('Please enter your name and a valid email.');
        return;
      }

      const Q_MIN = QUESTIONS.map(q => ({ id:q.id, label:q.label, group:q.group }));
      const G_MIN = GROUPS.map(g => ({ key:g.key, title:g.title }));

      const payload = {
        name,
        email,
        subject: `Checklist lead: ${STANDARD}`,
        message: JSON.stringify({
          checklist: STANDARD,
          checklistId: 'essential8',
          timestamp: new Date().toISOString(),
          ua: navigator.userAgent,
          ...compute(state),
          total: Q_MIN.length,
          answers: state,
          questions: Q_MIN,
          groups: G_MIN
        })
      };

      try{
        if (LEAD_URL){
          const res = await fetch(LEAD_URL, {
            method:'POST',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          const txt = await res.text().catch(()=>'');

          if (!res.ok){
            console.warn('[E8 lead] POST failed:', res.status, txt);
            alert('We could not notify our team automatically, but your PDF will still download.');
          }
        }
      }catch(err){
        console.warn('[E8 lead] POST error:', err);
        alert('We could not notify our team automatically, but your PDF will still download.');
      }

      // GA4 event
      try {
        const s = compute(state);
        if (window.gtag) {
          window.gtag('event', 'checklist_submit', {
            event_category: 'Checklist',
            event_label: STANDARD,
            checklist_standard: STANDARD,
            checklist_id: 'essential8',
            answered: s.answered,
            score: s.score
          });
        }
      } catch (err) {
        console.warn('GA4 checklist_submit event failed', err);
      }

      closeModal();
      generatePDF(state, { name, email }, { standard: STANDARD, file: PDF_NAME, groups: GROUPS, questions: QUESTIONS });
    });

    // Active chip styling
    const s = document.createElement('style');
    s.textContent = `
      button.opt{cursor:pointer}
      button.opt.active{background:#f0f2ff!important;border-color:#4F46E5!important;color:#1f2a5c!important}`;
    document.head.appendChild(s);

    update();

    function update(){
      const { answered, score } = compute(state);
      const pct = Math.round((answered / QUESTIONS.length) * 100);
      if (bar)      bar.style.width      = pct + '%';
      if (scoreNum) scoreNum.textContent = `${score}%`;

      let label='Not started', hint='Answer the questions to see your readiness.';
      if (answered === 0) {
        label = 'Not started';
        hint  = 'Answer the questions to see your readiness.';
      } else if (score <= 30) {
        label = 'High Risk (0–30)';
        hint  = 'Prioritise Application Control, patching and MFA. These break attacker playbooks quickly.';
      } else if (score <= 60) {
        label = 'Partially Ready (31–60)';
        hint  = 'Reduce standing admin, tighten macro controls/exceptions, and stabilise patch SLAs.';
      } else if (score <= 85) {
        label = 'Nearly Audit-Ready (61–85)';
        hint  = 'Strengthen evidence automation, restore testing, and reduce remaining exceptions.';
      } else {
        label = 'Certification-Ready (86–100)';
        hint  = 'Maintain cadence, perform independent checks, and package evidence for assurance.';
      }

      if (scoreLabel) scoreLabel.textContent = label;
      if (scoreHint)  scoreHint.textContent  = hint;
    }
  }

  function compute(state){
    const vals     = Object.values(state);
    const answered = vals.filter(v => v !== null).length;
    const scoreRaw = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const denom    = vals.length * 2 || 1;
    const score    = Math.round((scoreRaw / denom) * 100);
    return { answered, score: isNaN(score) ? 0 : score };
  }

  function getBand(score, answered){
    if (!answered) return { key:'na', title:'Not started', desc:'Complete the checklist to generate your Trust Score.' };
    if (score <= 30) return { key:'hr',  title:'0–30 — High Risk',             desc:'Foundational controls are missing or inconsistent. Prioritised uplift required.' };
    if (score <= 60) return { key:'pr',  title:'31–60 — Partially Ready',      desc:'Core elements exist. Focus on consistency, evidence, and removing exceptions.' };
    if (score <= 85) return { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close remaining gaps and operationalise evidence and governance.' };
    return              { key:'cr',      title:'86–100 — Certification-Ready', desc:'Controls largely in place. Focus on validation, testing and assurance packaging.' };
  }

  function drawTrustBands(doc, x, y, w, score, answered){
    const pad = 6;
    const rowH = 18;
    const gap = 6;

    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(17,24,39);
    doc.text('What Your Trust Score Really Means', x, y);
    y += 6;

    doc.setFont('helvetica','normal');
    doc.setFontSize(10);
    doc.setTextColor(80);
    doc.text('Your Essential Eight Trust Score shows how close you are to a defensible baseline.', x, y);
    y += 8;

    if (!answered) {
      doc.setFillColor(243,244,246);
      doc.setDrawColor(229,231,235);
      doc.roundedRect(x, y, w, rowH, 3, 3, 'FD');

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text('Not started', x + pad, y + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(80);
      doc.text('Answer the questions to generate your Trust Score and PDF roadmap.', x + pad, y + 14);

      return y + rowH + 2;
    }

    const rows = [
      { key:'hr',  title:'0–30 — High Risk',             desc:'Foundational controls are missing or inconsistent. Prioritised uplift required.' },
      { key:'pr',  title:'31–60 — Partially Ready',      desc:'Core elements exist. Focus on consistency, evidence, and removing exceptions.' },
      { key:'nar', title:'61–85 — Nearly Audit-Ready',   desc:'Close remaining gaps and operationalise evidence and governance.' },
      { key:'cr',  title:'86–100 — Certification-Ready', desc:'Controls largely in place. Focus on validation, testing and assurance packaging.' },
    ];

    const fills = {
      hr:  [254,226,226],
      pr:  [224,231,255],
      nar: [254,249,195],
      cr:  [209,250,229],
    };

    const band = getBand(score, answered);

    rows.forEach((r, i) => {
      const yy = y + i * (rowH + gap);

      const fc = fills[r.key];
      doc.setFillColor(fc[0], fc[1], fc[2]);
      doc.setDrawColor(229,231,235);
      doc.setLineWidth(0.2);
      doc.roundedRect(x, yy, w, rowH, 4, 4, 'FD');

      if (r.key === band.key) {
        doc.setDrawColor(79,70,229);
        doc.setLineWidth(0.8);
        doc.roundedRect(x, yy, w, rowH, 4, 4, 'S');

        doc.setFillColor(79,70,229);
        doc.roundedRect(x + 2, yy + 2, 3, rowH - 4, 2, 2, 'F');
      }

      doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(17,24,39);
      doc.text(r.title, x + pad + 4, yy + 7);

      doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(55);
      const lines = doc.splitTextToSize(r.desc, w - (pad * 2) - 8);
      doc.text(lines, x + pad + 4, yy + 14);
    });

    const chip = `Your score: ${score}%`;
    doc.setFont('helvetica','bold'); doc.setFontSize(10);
    const chipW = Math.max(28, doc.getTextWidth(chip) + 10);
    const chipH = 8;
    const chipX = x + w - chipW;
    const chipY = y - 10;

    doc.setFillColor(17,24,39);
    doc.setTextColor(255,255,255);
    doc.roundedRect(chipX, chipY, chipW, chipH, 3, 3, 'F');
    doc.text(chip, chipX + chipW / 2, chipY + 5.6, { align:'center' });

    return y + rows.length * (rowH + gap) - gap + 2;
  }

  function generatePDF(state, lead = {}, { standard, file, groups, questions }){
    const { jsPDF } = window.jspdf || {};
    if(!jsPDF){ alert('PDF library not loaded.'); return; }

    const doc = new jsPDF('p','mm','a4');
    const W=210, LM=14, RM=14; let y=16;

    const now = new Date();
    const fmt = (d)=> d.toLocaleDateString(undefined, { year:'numeric', month:'short', day:'numeric' });
    const hr  = (yy, pad=0)=>{ doc.setDrawColor(235,238,246); doc.line(LM, yy, W-RM, yy); return yy + (pad||0); };

    const vals      = Object.values(state);
    const answered  = vals.filter(v => v !== null).length;
    const scoreRaw  = vals.reduce((a,v)=> a + (v ?? 0), 0);
    const denom2    = vals.length * 2 || 1;
    const score     = Math.round((scoreRaw / denom2) * 100) || 0;
    const band      = getBand(score, answered);
    const STATUS    = answered === 0 ? 'Not started' : band.title;

    // Header
    doc.setFillColor(79,70,229); doc.rect(0,0,W,28,'F');
    doc.setFillColor(6,182,212); doc.rect(0,26,W,2,'F');

    // Logo & title
    try{
      const logoEl = document.getElementById('pdfLogo');
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      if (logoEl && logoEl.complete) {
        const targetW = 18;
        const ratio   = (logoEl.naturalHeight||logoEl.height||120)/(logoEl.naturalWidth||logoEl.width||120);
        const targetH = Math.min(18, targetW * ratio);
        doc.addImage(logoEl, 'PNG', LM, 6, targetW, targetH, undefined, 'FAST');
        doc.text('Compliance365 — Readiness Report', LM + targetW + 4, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${standard} quick-scan summary`, LM + targetW + 4, 22);
      } else {
        doc.text('Compliance365 — Readiness Report', LM, 16);
        doc.setFont('helvetica','normal'); doc.setFontSize(11);
        doc.text(`${standard} quick-scan summary`, LM, 22);
      }
    }catch(_){
      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold'); doc.setFontSize(15);
      doc.text('Compliance365 — Readiness Report', LM, 16);
      doc.setFont('helvetica','normal'); doc.setFontSize(11);
      doc.text(`${standard} quick-scan summary`, LM, 22);
    }

    // meta
    doc.setFontSize(10);
    doc.text(`Date: ${fmt(now)}`, W-RM, 16, { align:'right' });
    if(lead?.name || lead?.email){
      const prepared = `Prepared for: ${lead?.name || ''}${lead?.name && lead?.email ? ' • ' : ''}${lead?.email || ''}`;
      doc.text(prepared, W-RM, 22, { align:'right' });
    }

    // Summary + dial
    y = 38;
    doc.setTextColor(17,24,39); doc.setFont('helvetica','bold'); doc.setFontSize(13);
    doc.text('Your Readiness at a Glance', LM, y); y+=8;

    const dialX = LM + 26, dialY = y + 24;
    doc.setDrawColor(230,233,242); doc.setLineWidth(6);
    doc.circle(dialX, dialY, 20, 'S');
    doc.setDrawColor(79,70,229);
    const pct = Math.max(0,Math.min(score,100))/100;
    const segs = Math.max(1, Math.round(60*pct));
    for(let i=0;i<segs;i++){
      const a1 = (-Math.PI/2) + (i/segs)*2*Math.PI;
      const a2 = a1 + 0.1;
      doc.line(dialX+20*Math.cos(a1), dialY+20*Math.sin(a1),
               dialX+20*Math.cos(a2), dialY+20*Math.sin(a2));
    }
    doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text(`${score}%`, dialX, dialY+4, {align:'center'});

    doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(55);
    doc.text(`Answered: ${answered}/${vals.length}`, LM+56, y+4);
    doc.text('Status:', LM+56, y+12);
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39);
    doc.text(STATUS, LM+56 + 18, y+12);

    // Band meaning + next steps
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    doc.text('What this means:', LM+56, y+20);
    const meaningLines = doc.splitTextToSize(band.desc || 'Complete the checklist to generate your Trust Score.', 210 - 14 - 14 - (56));
    doc.text(meaningLines, LM+56, y+26);

    const tips = (!answered)
      ? ['Complete the checklist to generate your Trust Score and PDF roadmap.']
      : (score <= 30)
        ? ['Prioritise Application Control and MFA first', 'Meet patch SLAs for Internet-facing apps', 'Reduce exceptions and enforce hardening baselines']
        : (score <= 60)
          ? ['Reduce standing admin and segment admin accounts', 'Tighten macro controls and expiring exceptions', 'Automate monthly evidence exports and reviews']
          : (score <= 85)
            ? ['Exercise restores, prove immutability and separation of duties', 'Phase out weak MFA factors', 'Close remaining “Partial/No” gaps']
            : ['Maintain cadence and independent checks', 'Drill restore scenarios and incident response', 'Package evidence for assurance and audits'];

    let tipsY = y + 26 + (meaningLines.length * 5) + 4;
    doc.setFont('helvetica','bold'); doc.setTextColor(17,24,39); doc.setFontSize(10);
    doc.text('Next steps:', LM+56, tipsY);
    tipsY += 6;
    doc.setFont('helvetica','normal'); doc.setTextColor(80); doc.setFontSize(10);
    tips.forEach((t,i)=> doc.text(`- ${t}`, LM+56, tipsY + i*5));

    y += 64;

    // Domain breakdown (dynamic from GROUPS/QUESTIONS)
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Domain Breakdown', LM, y); y += 5;

    const DOMAINS = {};
    (Array.isArray(groups)?groups:[]).forEach(g => {
      DOMAINS[g.title] = (Array.isArray(questions)?questions:[]).filter(q => q.group === g.key).map(q => q.id);
    });

    Object.entries(DOMAINS).forEach(([name, ids])=>{
      const got = ids.reduce((a,id)=> a + (state[id]??0), 0);
      const max = ids.length * 2 || 1;
      const p   = Math.round((got/max)*100) || 0;

      doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(name, LM, y+5);

      const barX = LM + 64, barW = W - LM - RM - 64;
      doc.setDrawColor(230,233,242); doc.setFillColor(238,242,255);
      doc.roundedRect(barX, y, barW, 7, 2, 2, 'F');

      const fillW = Math.max(0, Math.min(barW*(p/100), barW));
      doc.setFillColor(79,70,229);
      doc.roundedRect(barX, y, fillW, 7, 2, 2, 'F');

      doc.setFont('helvetica','bold'); doc.setTextColor(70);
      doc.text(`${p}%`, barX + barW + 4, y+5);

      y += 11;
    });

    y = hr(y, 6);

    // Trust bands panel (same as ISO pages)
    if (y > 180) { doc.addPage(); y = 16; }
    y = drawTrustBands(doc, LM, y, (W - LM - RM), score, answered) + 6;

    // Force Top Gaps to new page (same as ISO pages)
    doc.addPage();
    y = 16;
    y = hr(y, 6);

    // Top gaps & risks (Risk statements + two columns + accent bars)
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Top Gaps & Risks', LM, y); y += 6;

    const GAP = {
      // Application Control
      'ac-scope':'Risk: Without enforced application control, malware and unauthorised code execution become significantly more likely.',
      'ac-source':'Risk: Without trusted publisher/signed code rules, allow-listing becomes brittle and exceptions proliferate.',
      'ac-logs':'Risk: Without central logging and review, control failures and bypass attempts can go undetected.',

      // Patch Applications
      'pa-internet':'Risk: Late patching of Internet-facing applications increases exploitability and ransomware exposure.',
      'pa-inv':'Risk: Without an accurate inventory and ownership, patching cannot be reliably prioritised or evidenced.',
      'pa-evidence':'Risk: Without automated evidence, it is difficult to prove ongoing compliance or detect regression.',

      // Macros
      'ma-block':'Risk: If macros from the Internet are not blocked, phishing-based malware execution risk increases materially.',
      'ma-config':'Risk: Untested or inconsistent deployment creates coverage gaps attackers can target.',
      'ma-except':'Risk: Uncontrolled macro exceptions become permanent backdoors and weaken audit defensibility.',

      // Hardening
      'uh-features':'Risk: Risky browser features/plugins increase drive-by compromise and credential theft pathways.',
      'uh-downloads':'Risk: Allowing executable downloads for standard users increases initial foothold probability.',
      'uh-verify':'Risk: Without periodic verification evidence, hardening posture is hard to sustain or assure.',

      // Admin
      'ad-jit':'Risk: Standing admin privileges increase blast radius and enable rapid lateral movement after compromise.',
      'ad-review':'Risk: Without recertification, privileged access creep persists and becomes difficult to justify.',
      'ad-seg':'Risk: Unsegmented admin accounts/workstations increase compromise likelihood via email and browsing.',

      // Patch OS
      'po-sla':'Risk: Missing OS patch SLAs leaves known vulnerabilities exploitable for extended periods.',
      'po-rings':'Risk: Without rings/rollback plans, patching becomes risky and delays increase.',
      'po-report':'Risk: Without compliance dashboards and exports, you cannot demonstrate coverage or drive remediation.',

      // MFA
      'mfa-scope':'Risk: MFA gaps leave remote access, privileged pathways or sensitive apps exposed to credential attacks.',
      'mfa-method':'Risk: Weak MFA factors are vulnerable to phishing and SIM-swap, reducing real-world effectiveness.',
      'mfa-gaps':'Risk: Unmonitored break-glass accounts create an ungoverned high-privilege bypass.',

      // Backups
      'bk-scope':'Risk: If critical systems/SaaS are out of scope, recovery objectives will not be achievable during incidents.',
      'bk-immut':'Risk: Without immutability/separation of duties, ransomware can encrypt or delete backups.',
      'bk-restore':'Risk: Without restore testing, recovery may fail when it is most needed, extending outage duration.',
    };

    const highs=[], meds=[];
    (Array.isArray(questions)?questions:[]).forEach(q=>{
      const v = state[q.id];
      if (v===0) highs.push(GAP[q.id] || q.label);
      else if (v===1) meds.push(GAP[q.id] || q.label);
    });

    const colW = (W - LM - RM - 6)/2;

    const drawList = (title, items, x, titleColor, accentColor) => {
      if (!items.length) return y;

      doc.setFont('helvetica','bold');
      doc.setFontSize(11);
      doc.setTextColor(...titleColor);
      doc.text(title, x, y);

      let yy = y + 5;
      doc.setFont('helvetica','normal');
      doc.setFontSize(10);
      doc.setTextColor(17,24,39);

      items.forEach((t) => {
        const lines = doc.splitTextToSize(`• ${t}`, colW);
        doc.text(lines, x, yy);
        yy += (lines.length * 4.6) + 1.5;
      });

      doc.setDrawColor(...accentColor);
      doc.setLineWidth(3);
      doc.line(x - 3, y - 2, x - 3, yy - 2);

      return yy;
    };

    const yLeftEnd  = drawList('High (No): address first', highs, LM, [239,68,68], [239,68,68]);
    const yRightEnd = drawList('Medium (Partial): tighten next', meds, LM + colW + 6, [99,102,241], [99,102,241]);
    y = Math.max(yLeftEnd, yRightEnd) + 4;

    y = hr(y, 4);

    // Detailed responses
    doc.setFont('helvetica','bold'); doc.setFontSize(12); doc.setTextColor(17,24,39);
    doc.text('Detailed Responses', LM, y); y += 5;

    const drawRow = (idx, text, val)=>{
      if(y>275){ doc.addPage(); y=16; }
      const wrapW = W - LM - RM - 40;
      const lines = doc.splitTextToSize(`${idx}. ${text}`, wrapW);
      const rowH  = 12 + Math.max(0, lines.length-1)*4.2;

      doc.setFillColor(245,247,255);
      doc.roundedRect(LM, y-3, W-LM-RM, rowH+6, 2, 2, 'F');

      doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(17,24,39);
      doc.text(lines, LM+4, y+4);

      const label = (val===2)?'Yes' : (val===1)?'Partial' : (val===0)?'No' : '—';
      let fill=[229,231,235], txt=[107,114,128];
      if(label==='Yes'){ fill=[209,250,229]; txt=[16,185,129]; }
      else if(label==='Partial'){ fill=[224,231,255]; txt=[99,102,241]; }
      else if(label==='No'){ fill=[254,226,226]; txt=[239,68,68]; }

      doc.setFont('helvetica','bold'); doc.setFontSize(10);
      const pillW = Math.max(22, doc.getTextWidth(label) + 8);
      const chipX = W - RM - pillW - 4;
      const chipY = y - 1;
      doc.setDrawColor(222,226,236);
      doc.setFillColor(...fill);
      doc.roundedRect(chipX, chipY, pillW, 8, 3, 3, 'F');
      doc.setTextColor(...txt);
      doc.text(label, chipX + pillW/2, chipY + 5.5, { align:'center' });

      y += rowH + 8;
    };

    (Array.isArray(questions)?questions:[]).forEach((q,i)=> drawRow(i+1, q.label, state[q.id]) );

    // CTA (band-aware)
    if(y>246){ doc.addPage(); y=16; }
    y += 4;

    const btnW = 178, btnH = 18, btnX = LM, btnY = y;
    doc.setFillColor(79,70,229);
    doc.roundedRect(btnX, btnY, btnW, btnH, 3, 3, 'F');
    doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(12);

    const ctaText =
      (!answered) ? 'Book an Essential Eight uplift call' :
      (score <= 30) ? 'Book a prioritised Essential Eight uplift plan' :
      (score <= 60) ? 'Book a remediation + evidence automation plan' :
      (score <= 85) ? 'Book an evidence + assurance readiness plan' :
                      'Book independent assurance preparation';

    doc.text(ctaText, btnX + 6, btnY + 12);
    doc.link(btnX, btnY, btnW, btnH, { url: 'https://compliance365.com.au/book' });

    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(120);
    doc.text('Generated by Compliance365  •  compliance365.com.au', LM, 290);

    doc.save(file || 'essential_eight_readiness.pdf');
  }
})();
  </script>

  <!-- Lead capture modal -->
  <div id="leadModal"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); align-items:center; justify-content:center; z-index:2000;">
    <div style="background:#fff; padding:24px; border-radius:14px; max-width:400px; width:100%; box-shadow:0 12px 30px rgba(0,0,0,.2);">
      <h3 style="margin-top:0">Before you download</h3>
      <p class="muted small">
        Enter your details to receive your free Essential Eight readiness report and occasional security, privacy and
        AI governance updates. No spam.
      </p>
      <form id="leadForm">
        <input
          type="text"
          id="name"
          placeholder="Your name"
          style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px"
        >
        <input
          type="email"
          id="email"
          placeholder="Work email"
          style="width:100%; margin:6px 0; padding:10px; border:1px solid #ccc; border-radius:8px"
        >

        <div style="display:flex; gap:10px; margin-top:12px; justify-content:flex-end;">
          <button type="button" class="btn btn-ghost" id="cancelLead">Cancel</button>
          <button type="submit" class="btn btn-primary">Email my free Essential Eight PDF</button>
        </div>
      </form>
    </div>
  </div>
</Base>
