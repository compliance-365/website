---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const STANDARD = 'ISO 27001 (Information Security)';

// -- Environment capture (Stage 1) -------------------------
const ENV_FIELDS = [
  { id: 'org-name',     label: 'Organisation name',                   type: 'text',   required: true,  placeholder: 'e.g. Acme Pty Ltd' },
  { id: 'contact-name', label: 'Your name',                            type: 'text',   required: true,  placeholder: 'First and last name' },
  { id: 'contact-email',label: 'Email (where to send your PDF copy)',  type: 'email',  required: true,  placeholder: 'you@yourcompany.com' },
  { id: 'org-sector',   label: 'Primary sector',                       type: 'select', required: true,  options: ['SaaS / Technology','Financial Services / FinTech','Healthcare / HealthTech','Manufacturing','Professional Services','Retail / E-commerce','Government / Government-adjacent','Defence / Defence-adjacent','Education','Other'] },
  { id: 'org-size',     label: 'Organisation size (FTE)',              type: 'select', required: true,  options: ['Under 25','25–100','100–500','500–1,000','Over 1,000'] },
  { id: 'env-licensing',label: 'Microsoft licensing tier',             type: 'select', required: false, options: ['Microsoft 365 E5','Microsoft 365 E3','Microsoft 365 Business Premium','Microsoft 365 Business Standard','No Microsoft 365','Not sure'] },
  { id: 'trigger',      label: 'What is prompting you to look at ISO 27001 now?', type: 'select', required: true, options: ['Enterprise customer requiring certification','Government tender or procurement gate','Cyber insurance renewal','Investor or board requirement','Recent security incident or near-miss','Internal initiative — no external pressure yet','Other / multiple drivers'] },
  { id: 'timeline',     label: 'When do you need to be audit-ready?', type: 'select', required: false, options: ['Within 3 months','3–6 months','6–12 months','12+ months','No fixed deadline'] },
];

// -- Questions — 15 sharpened, 4 sections -------------------
const QUESTIONS = [
  // Governance
  { id:'isms-scope',  group:'gov',      label:'ISMS scope is defined and approved — covering locations, systems, services, and explicit exclusions', hint:'A clear scope statement is the first thing an auditor checks. Vague or missing scope is the most common Stage 1 finding.', examples:['One-page scope statement listing sites, cloud environments, core systems, and customer-facing services in scope','Diagram showing boundaries — e.g. "Production AWS + corporate M365 in scope; personal devices and lab environments out"','Documented exclusions with justification and any compensating controls'] },
  { id:'leadership',  group:'gov',      label:'Top management has assigned roles, committed resources, and is visibly engaged in security governance', hint:'Auditors want evidence that security is owned at executive level — not just delegated to IT.', examples:['ISMS governance chart showing sponsor, ISMS owner, risk owners, and control owners','Leadership-approved policy statement and management review minutes showing security on the agenda','Resourcing decisions (budget, roles, priorities) tied to documented security risks'] },
  { id:'policy',      group:'gov',      label:'Information security policy and supporting policies are current, approved, communicated, and reviewed periodically', hint:'Policies must be version-controlled, dated, and demonstrably acknowledged by staff.', examples:['InfoSec policy with version control, approval date, and next review date documented','Supporting policies covering access control, incident response, change management, supplier security, and acceptable use','Evidence of communication — intranet links, staff acknowledgements, onboarding training records'] },
  { id:'risk-method', group:'gov',      label:'Risk assessment methodology is defined and applied consistently — with criteria, scoring, and risk appetite documented', hint:'Repeatability matters more than complexity. The same method should produce comparable results regardless of who runs the assessment.', examples:['Risk matrix with likelihood and impact definitions, plus scoring guidance for each level','Documented risk acceptance thresholds — who can approve risks at what level','Worked example showing two assessors producing comparable ratings using the methodology'] },
  // Controls & SoA
  { id:'risk-register', group:'controls', label:'A live risk register is maintained — with named owners, treatment plans, due dates, and review cadence', hint:'Auditors look for a register that is actively maintained — not a spreadsheet last updated at certification.', examples:['Risk register entries showing description, affected assets, owner, treatment plan, due date, and current status','Monthly or quarterly review cadence with updates and decisions documented','Linked evidence — tickets, remediation plans, change records, or signed risk acceptance forms'] },
  { id:'soa',         group:'controls', label:'Statement of Applicability is complete — included/excluded controls, justifications, status, owner, and evidence pointers', hint:'The SoA is the audit index. A weak SoA undermines an otherwise strong ISMS.', examples:['Each Annex A control marked applicable / not applicable with documented justification','Implementation status (Implemented / In Progress / Excluded) and named control owner','Direct link to evidence location — SharePoint folder path, configuration export, or system report'] },
  { id:'assets',      group:'controls', label:'Information assets and systems are inventoried, classified, and have assigned owners', hint:'You need to know what you have and what matters most before you can prioritise protection.', examples:['Asset inventory covering applications, infrastructure, data stores, endpoints, and key SaaS tools','Data classification or "crown jewels" register identifying critical systems and sensitive data','Lifecycle process — onboarding, periodic review, and retirement documented'] },
  { id:'access',      group:'controls', label:'Access control is governed — joiner/mover/leaver process, role-based access, MFA, and privileged access controls', hint:'Access reviews and privileged access governance are among the most heavily sampled controls in ISO 27001 audits.', examples:['Documented joiner/mover/leaver process with timelines, approvals, and audit trail','Role-based access groups with periodic access reviews — quarterly for sensitive systems','Privileged access separated, with MFA, just-in-time elevation (e.g. Entra PIM), and centralised logging'] },
  { id:'suppliers',   group:'controls', label:'Third-party and supplier security is governed — risk tiering, contract clauses, and ongoing review', hint:'Supply chain risk is increasingly scrutinised — especially after SolarWinds, Log4j, and MOVEit.', examples:['Vendor risk assessment process tiering suppliers by criticality and data access','Contract clauses covering security obligations, breach notification, audit rights, and sub-processor controls','Annual review of critical suppliers — SOC reports, ISO certificates, questionnaires, incident history'] },
  // Operations & resilience
  { id:'logging',  group:'ops',   label:'Centralised security logging and alerting is in place for identity, endpoints, cloud, and critical applications', hint:'Logs must support both detection and investigation. Without log retention and review evidence, controls fail audit testing.', examples:['Centralised logging covering Entra/SSO, endpoints, cloud audit logs, and key applications','Alert rules for high-risk patterns — impossible travel, admin role changes, excessive failed logins','Documented log retention period and access controls; evidence of alert review and triage'] },
  { id:'vulns',    group:'ops',   label:'A repeatable vulnerability management process is in place — scanning, patching, prioritisation, and verified closure', hint:'Auditors want to see SLAs being met or exceptions being managed — not just that scanning happens.', examples:['Regular vulnerability scanning across infrastructure and applications, with documented frequency and scope','Patch SLAs (e.g. critical within 14 days) with a documented exception process','Remediation tracking — tickets and evidence that high/critical vulnerabilities are resolved or formally accepted'] },
  { id:'incident', group:'ops',   label:'Incident response plan is documented, tested, and improved after exercises or real incidents', hint:'Plans that have never been tested often fail when needed. A tabletop exercise outcome is strong evidence.', examples:['Incident response runbook covering roles, severity levels, escalation paths, and contact list','Tabletop exercise outcomes with lessons learned and an action plan','Post-incident review records showing improvements made after incidents or near-misses'] },
  { id:'backups',  group:'ops',   label:'Backups are configured, monitored, and restore-tested — with RTO and RPO targets aligned to business needs', hint:'Untested backups are not evidence — auditors will sample restore test records.', examples:['Defined RTO and RPO per critical system','Backup schedule, scope, and monitoring/alerts for failed jobs','Documented restore tests and DR/BCP exercises with outcomes and improvements'] },
  // Audit & improvement
  { id:'internal-audit',    group:'audit', label:'Internal ISMS audits are performed against a plan — with findings tracked to verified closure', hint:'Internal audit is mandatory under ISO 27001. The audit must cover all clauses and a sample of Annex A controls.', examples:['Annual internal audit plan covering ISO 27001:2022 clauses 4–10 and a rotating sample of Annex A controls','Audit reports with findings, root cause, corrective actions, owners, and due dates','Evidence that corrective actions are verified closed — not just marked "done"'] },
  { id:'management-review', group:'audit', label:'Management reviews are held at planned intervals — covering risks, incidents, KPIs, audit results, and improvements', hint:'Management review minutes are mandatory evidence and one of the first documents auditors request.', examples:['Management review agenda and minutes covering all required ISO 27001 inputs','Recorded decisions on resourcing, policy changes, risk acceptance, and improvement priorities','Action register with owners, due dates, and closure tracking'] },
];

const GROUPS = [
  { key:'gov',      title:'Governance & ISMS Foundation',  blurb:'Scope, leadership, policy, and risk methodology.', icon:'📋' },
  { key:'controls', title:'Annex A Controls & SoA',         blurb:'Controls, SoA, assets, access, and supplier risk.', icon:'🔐' },
  { key:'ops',      title:'Security Operations & Resilience', blurb:'Logging, vulnerabilities, incidents, backups.', icon:'🛡️' },
  { key:'audit',    title:'Audit, Measurement & Improvement', blurb:'Internal audit and management review.', icon:'📊' },
];

const TOTAL_Q = QUESTIONS.length;
---

<Base
  title="Free ISO 27001 Readiness Checklist  -  Score Your ISMS in 15 Minutes | Compliance365"
  description="Interactive ISO 27001:2022 readiness assessment. Score your ISMS across governance, risk, controls, operations, and audit  -  and download a prioritised PDF roadmap."
>
  <Header />
  <img id="pdfLogo" src={`${base}assets/logo.png`} alt="" style="display:none" width="120" height="120" />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <p style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#1e40af;margin-bottom:1rem;">Free Readiness Assessment</p>
      <h1>ISO 27001 Readiness Checklist</h1>
      <p class="section-lead muted" style="max-width:760px;">
        Score your Information Security Management System against ISO 27001:2022 in 15 minutes. Tell us about your environment, answer 15 sharpened questions, and download a branded PDF roadmap with your top gaps and recommended next steps.
      </p>

      <div style="display:flex;gap:0.5rem;margin-top:2rem;max-width:680px;flex-wrap:wrap;">
        <div class="stage-pill" data-stage="1" style="flex:1;min-width:140px;background:#1e40af;color:white;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">1. Environment</div>
        <div class="stage-pill" data-stage="2" style="flex:1;min-width:140px;background:#e2e8f0;color:#64748b;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">2. Assessment</div>
        <div class="stage-pill" data-stage="3" style="flex:1;min-width:140px;background:#e2e8f0;color:#64748b;padding:10px 16px;border-radius:8px;text-align:center;font-size:0.85rem;font-weight:600;">3. Your Report</div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section style="background:#f8fafc;padding:2rem 0;border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;">
    <div class="container">
      <div class="grid-3" style="gap:1.5rem;">
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">&#9200;</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">~15 minutes</strong><p class="muted small" style="margin:2px 0 0;">15 sharpened questions across 4 ISMS domains, plus a quick environment context block.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">&#9989;</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">Mapped to ISO 27001:2022</strong><p class="muted small" style="margin:2px 0 0;">Calibrated to clauses 4-10 and Annex A controls — the same criteria certification auditors sample.</p></div>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:flex-start;">
          <div style="font-size:1.25rem;">&#128196;</div>
          <div><strong style="color:#0f172a;display:block;font-size:0.9rem;">Branded PDF roadmap</strong><p class="muted small" style="margin:2px 0 0;">Score breakdown, top gaps, and a prioritised 90-day action plan. Emailed copy + instant download.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN -->
  <section class="section">
    <div class="container" style="max-width:1140px;">

      <!-- ----- STAGE 1: Environment ----- -->
      <div id="stage-1" class="stage">
        <div class="card" style="padding:2rem;">
          <h2 style="margin:0 0 0.5rem;">Tell us about your environment</h2>
          <p class="muted" style="margin:0 0 2rem;">A few details to tailor your roadmap. Required fields are marked <span style="color:#dc2626;">*</span>.</p>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {ENV_FIELDS.map(field => (
              <div class="env-field" data-field-id={field.id}>
                <label for={field.id} style="display:block;font-weight:600;color:#0f172a;margin-bottom:0.4rem;font-size:0.9rem;">
                  {field.label}{field.required && <span style="color:#dc2626;">&nbsp;*</span>}
                </label>
                {field.type === 'text' && (
                  <input type="text" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'email' && (
                  <input type="email" id={field.id} name={field.id} placeholder={field.placeholder} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;" />
                )}
                {field.type === 'select' && (
                  <select id={field.id} name={field.id} style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:0.95rem;outline:none;background:white;">
                    <option value="">-- Select an option --</option>
                    {field.options.map(opt => <option value={opt}>{opt}</option>)}
                  </select>
                )}
              </div>
            ))}
          </div>

          <div id="env-error" style="display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-top:1.5rem;font-size:0.9rem;">
            Please complete the required fields.
          </div>

          <div style="display:flex;justify-content:flex-end;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #e2e8f0;">
            <button type="button" id="to-stage-2" class="btn btn-primary large" style="padding:12px 32px;cursor:pointer;">Continue to assessment -></button>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 2: Questions ----- -->
      <div id="stage-2" class="stage" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:flex-start;" id="stage-2-grid">
          <div>
            <!-- Section nav -->
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;background:white;padding:1rem;border-radius:10px;border:1px solid #e2e8f0;">
              {GROUPS.map((grp, i) => (
                <a href={`#section-${grp.key}`} class="section-nav-item" data-section={grp.key} style="padding:6px 12px;border-radius:8px;background:#f1f5f9;color:#475569;font-size:0.8rem;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                  <span>{i + 1}.</span><span>{grp.title}</span><span class="section-progress" data-section={grp.key} style="font-size:0.7rem;opacity:0.7;">0/{QUESTIONS.filter(q => q.group === grp.key).length}</span>
                </a>
              ))}
            </div>

            {GROUPS.map(grp => {
              const grpQs = QUESTIONS.filter(q => q.group === grp.key);
              return (
                <div class="checklist-section card" id={`section-${grp.key}`} style="margin-bottom:1.5rem;padding:2rem;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0;">
                    <div style="flex:1;">
                      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
                        <span style="font-size:1.5rem;">{grp.icon}</span>
                        <h3 style="margin:0;font-size:1.2rem;color:#0f172a;">{grp.title}</h3>
                      </div>
                      <p class="muted small" style="margin:0;">{grp.blurb}</p>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                      <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;">Progress</div>
                      <div class="section-count" data-section={grp.key} style="font-size:1.1rem;font-weight:800;color:#1e40af;">0/{grpQs.length}</div>
                    </div>
                  </div>

                  {grpQs.map((q, qIdx) => (
                    <div class="question field" data-id={q.id} data-group={grp.key} style="padding:1.25rem 0;border-bottom:1px solid #f1f5f9;">
                      <div style="display:flex;gap:1rem;align-items:flex-start;">
                        <div style="width:28px;height:28px;background:#eff6ff;color:#1e40af;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;margin-top:2px;">{qIdx + 1}</div>
                        <div style="flex:1;">
                          <div style="font-weight:600;color:#0f172a;line-height:1.5;margin-bottom:0.5rem;">{q.label}</div>
                          <p class="muted small" style="margin:0 0 0.75rem;font-size:0.85rem;">{q.hint}</p>
                          <details style="margin-bottom:1rem;">
                            <summary style="cursor:pointer;color:#1e40af;font-size:0.8rem;font-weight:600;">View evidence examples -></summary>
                            <ul class="muted small" style="padding-left:1.2rem;margin:0.5rem 0 0;line-height:1.7;">
                              {q.examples.map(ex => <li>{ex}</li>)}
                            </ul>
                          </details>
                          <div class="opts" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                            <button type="button" class="opt" data-v="2" style="padding:8px 20px;border:2px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10003; Yes</button>
                            <button type="button" class="opt" data-v="1" style="padding:8px 20px;border:2px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#9680; Partial</button>
                            <button type="button" class="opt" data-v="0" style="padding:8px 20px;border:2px solid #cbd5e1;background:white;border-radius:8px;cursor:pointer;font-weight:700;font-size:0.85rem;">&#10007; No</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}

            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
              <button type="button" id="back-to-stage-1" class="btn btn-outline" style="cursor:pointer;"><- Back to environment</button>
              <button type="button" id="resetBtn" class="btn btn-outline" style="cursor:pointer;color:#dc2626;border-color:#fca5a5;">Reset all answers</button>
            </div>
          </div>

          <!-- Sticky score panel -->
          <div id="score-panel" style="position:sticky;top:100px;">
            <div class="card" style="padding:1.5rem;">
              <div style="text-align:center;padding-bottom:1.25rem;border-bottom:1px solid #f1f5f9;margin-bottom:1.25rem;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;margin-bottom:0.5rem;">Overall readiness</div>
                <div id="overall-score" style="font-size:3rem;font-weight:800;color:#1e40af;line-height:1;"> - </div>
                <div id="readiness-band" style="font-size:0.85rem;color:#64748b;margin-top:0.4rem;">Answer questions to score</div>
              </div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;font-size:0.8rem;">
                {GROUPS.map(grp => (
                  <div>
                    <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                      <span style="color:#374151;font-size:0.78rem;">{grp.title}</span>
                      <span class="domain-percent" data-section={grp.key} style="font-weight:700;color:#cbd5e1;"> - </span>
                    </div>
                    <div style="background:#f1f5f9;height:6px;border-radius:3px;overflow:hidden;">
                      <div class="domain-bar" data-section={grp.key} style="background:#cbd5e1;width:0%;height:100%;transition:width 0.3s ease;"></div>
                    </div>
                  </div>
                ))}
              </div>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #f1f5f9;">
                <div style="font-size:0.75rem;color:#64748b;margin-bottom:0.5rem;font-weight:600;">
                  <span id="answered-count">0</span> of <span id="total-count">{TOTAL_Q}</span> questions answered
                </div>
                <div style="background:#f1f5f9;height:8px;border-radius:4px;overflow:hidden;">
                  <div id="overall-progress" style="background:#1e40af;width:0%;height:100%;transition:width 0.3s ease;"></div>
                </div>
              </div>
              <button type="button" id="pdfBtn" class="btn btn-primary" disabled style="width:100%;margin-top:1.5rem;padding:14px;cursor:not-allowed;opacity:0.5;">Generate PDF report</button>
              <p class="muted small" style="text-align:center;margin:0.75rem 0 0;font-size:0.75rem;" id="pdf-helper">Available once all questions are answered</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ----- STAGE 3: Confirmation ----- -->
      <div id="stage-3" class="stage" style="display:none;">
        <div class="card" style="padding:3rem;text-align:center;">
          <div style="font-size:3rem;margin-bottom:1rem;">&#10003;</div>
          <h2 style="margin:0 0 0.5rem;">Your report is ready</h2>
          <p class="muted" style="margin:0 0 2rem;max-width:520px;margin-left:auto;margin-right:auto;">Your PDF has downloaded automatically. A copy of your responses has been sent to our team  -  we'll follow up if you'd like to discuss the results.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="https://calendly.com/matt-nicholas-compliance365/30min" class="btn btn-primary" target="_blank" rel="noopener">Book a free 30-min call</a>
            <a href={`${base}checklist`} class="btn btn-outline">Try another framework</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />

  <!-- jsPDF -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js" defer></script>

  <script is:inline>
    (() => {
      'use strict';

      const STANDARD = "ISO 27001 (Information Security)";
      const API_URL  = "https://zzb9g575zh.execute-api.ap-southeast-2.amazonaws.com/Prod/contact-us";

      // Mirror server data on the client
      const GROUPS = [
        { key:'gov',      title:'Governance & ISMS Foundation' },
        { key:'controls', title:'Annex A Controls & SoA' },
        { key:'ops',      title:'Security Operations & Resilience' },
        { key:'audit',    title:'Audit, Measurement & Improvement' },
      ];

      const QUESTIONS = [
        { id:'isms-scope',        group:'gov',      label:'ISMS scope is defined and approved — covering locations, systems, services, and explicit exclusions' },
        { id:'leadership',        group:'gov',      label:'Top management has assigned roles, committed resources, and is visibly engaged in security governance' },
        { id:'policy',            group:'gov',      label:'Information security policy and supporting policies are current, approved, communicated, and reviewed periodically' },
        { id:'risk-method',       group:'gov',      label:'Risk assessment methodology is defined and applied consistently — with criteria, scoring, and risk appetite documented' },
        { id:'risk-register',     group:'controls', label:'A live risk register is maintained — with named owners, treatment plans, due dates, and review cadence' },
        { id:'soa',               group:'controls', label:'Statement of Applicability is complete — included/excluded controls, justifications, status, owner, and evidence pointers' },
        { id:'assets',            group:'controls', label:'Information assets and systems are inventoried, classified, and have assigned owners' },
        { id:'access',            group:'controls', label:'Access control is governed — joiner/mover/leaver, role-based access, MFA, and privileged access controls' },
        { id:'suppliers',         group:'controls', label:'Third-party and supplier security is governed — risk tiering, contract clauses, and ongoing review' },
        { id:'logging',           group:'ops',      label:'Centralised security logging and alerting is in place for identity, endpoints, cloud, and critical applications' },
        { id:'vulns',             group:'ops',      label:'A repeatable vulnerability management process is in place — scanning, patching, prioritisation, and verified closure' },
        { id:'incident',          group:'ops',      label:'Incident response plan is documented, tested, and improved after exercises or real incidents' },
        { id:'backups',           group:'ops',      label:'Backups are configured, monitored, and restore-tested — with RTO and RPO targets aligned to business needs' },
        { id:'internal-audit',    group:'audit',    label:'Internal ISMS audits are performed against a plan — with findings tracked to verified closure' },
        { id:'management-review', group:'audit',    label:'Management reviews are held at planned intervals — covering risks, incidents, KPIs, audit results, and improvements' },
      ];

      const TOTAL_Q = QUESTIONS.length;

      // State
      const state = Object.fromEntries(QUESTIONS.map(q => [q.id, null]));
      const env = {};

      (document.readyState === 'loading') ? document.addEventListener('DOMContentLoaded', setup) : setup();

      function setup() {
        // Stage transitions
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        const pills  = document.querySelectorAll('.stage-pill');

        function setStage(n) {
          [stage1, stage2, stage3].forEach((el, i) => { if (el) el.style.display = (i + 1 === n) ? '' : 'none'; });
          pills.forEach(p => {
            const s = parseInt(p.dataset.stage, 10);
            p.style.background = (s === n) ? '#1e40af' : (s < n ? '#16a34a' : '#e2e8f0');
            p.style.color = (s <= n) ? 'white' : '#64748b';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Stage 1 to 2
        document.getElementById('to-stage-2').addEventListener('click', function() {
          // Read all fields by ID - simple and reliable
          var allIds = ['org-name','contact-name','contact-email','org-sector','org-size','env-licensing','trigger','timeline'];
          var reqIds  = ['org-name','contact-name','contact-email','org-sector','org-size','trigger'];

          allIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) env[id] = el.value ? el.value.trim() : '';
          });

          var valid = true;
          reqIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (!env[id]) {
              valid = false;
              el.style.borderColor = '#dc2626';
              el.style.background  = '#fef2f2';
            } else {
              el.style.borderColor = '#cbd5e1';
              el.style.background  = 'white';
            }
          });

          var errEl = document.getElementById('env-error');
          if (!valid) {
            errEl.style.display = 'block';
            errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
          errEl.style.display = 'none';
          setStage(2);
        });

        document.getElementById('back-to-stage-1').addEventListener('click', () => setStage(1));

        // Click-to-answer
        document.querySelectorAll('.opt').forEach(btn => {
          btn.addEventListener('click', () => {
            const field = btn.closest('.field');
            const id = field.dataset.id;
            const val = Number(btn.dataset.v);
            state[id] = val;
            field.querySelectorAll('.opt').forEach(o => {
              o.classList.remove('active');
              o.style.background = 'white';
              o.style.color = '#0f172a';
              o.style.borderColor = '#cbd5e1';
            });
            btn.classList.add('active');
            // Colour by value
            if (val === 2) { btn.style.background = '#16a34a'; btn.style.color = 'white'; btn.style.borderColor = '#16a34a'; }
            else if (val === 1) { btn.style.background = '#d97706'; btn.style.color = 'white'; btn.style.borderColor = '#d97706'; }
            else { btn.style.background = '#dc2626'; btn.style.color = 'white'; btn.style.borderColor = '#dc2626'; }
            update();
          });
        });

        // Reset
        document.getElementById('resetBtn').addEventListener('click', () => {
          if (!confirm('Reset all answers?')) return;
          Object.keys(state).forEach(k => state[k] = null);
          document.querySelectorAll('.opt').forEach(o => {
            o.classList.remove('active');
            o.style.background = 'white';
            o.style.color = '#0f172a';
            o.style.borderColor = '#cbd5e1';
          });
          update();
        });

        // PDF generation
        document.getElementById('pdfBtn').addEventListener('click', async () => {
          const { answered } = compute();
          if (answered < TOTAL_Q) { alert('Please answer all questions first.'); return; }
          const btn = document.getElementById('pdfBtn');
          btn.disabled = true;
          btn.textContent = 'Generating...';
          try {
            generatePDF();
            await submitToApi();
            setStage(3);
          } catch (err) {
            console.error(err);
            alert('Something went wrong  -  your PDF should still have downloaded.');
          } finally {
            btn.disabled = false;
            btn.textContent = 'Generate PDF report';
          }
        });

        update();
      }

      function compute() {
        const vals = Object.values(state);
        const answered = vals.filter(v => v !== null).length;
        const scoreRaw = vals.reduce((a, v) => a + (v ?? 0), 0);
        const score = Math.round((scoreRaw / (vals.length * 2)) * 100) || 0;
        return { answered, score: isNaN(score) ? 0 : score };
      }

      function computeSection(grpKey) {
        const ids = QUESTIONS.filter(q => q.group === grpKey).map(q => q.id);
        let answered = 0, sum = 0;
        ids.forEach(id => {
          if (state[id] !== null) { answered++; sum += state[id]; }
        });
        const pct = answered === 0 ? null : Math.round((sum / (ids.length * 2)) * 100);
        return { answered, total: ids.length, pct };
      }

      function getBand(score, answered) {
        if (!answered) return { key: 'na', label: 'Not started', desc: 'Answer questions to score', color: '#64748b' };
        if (score >= 86) return { key: 'cr', label: 'Certification-Ready', desc: 'Strong posture  -  focus on validation and audit packaging', color: '#16a34a' };
        if (score >= 61) return { key: 'nar', label: 'Nearly Audit-Ready', desc: 'Close minor gaps and focus on evidence packaging', color: '#1e40af' };
        if (score >= 31) return { key: 'pr', label: 'Partially Ready', desc: 'Many core elements in place  -  focus and prioritisation needed', color: '#d97706' };
        return { key: 'hr', label: 'High Risk', desc: 'Missing foundational controls  -  structured remediation required', color: '#dc2626' };
      }

      function barColor(pct) {
        if (pct === null) return '#cbd5e1';
        if (pct >= 75) return '#16a34a';
        if (pct >= 50) return '#d97706';
        return '#dc2626';
      }

      function update() {
        const { answered, score } = compute();
        const band = getBand(score, answered);

        // Overall
        document.getElementById('overall-score').textContent = answered === 0 ? ' - ' : score + '%';
        document.getElementById('overall-score').style.color = band.color;
        document.getElementById('readiness-band').textContent = band.label + (answered > 0 ? '  -  ' + band.desc : '');
        document.getElementById('readiness-band').style.color = band.color;
        document.getElementById('answered-count').textContent = answered;
        document.getElementById('overall-progress').style.width = (answered / TOTAL_Q * 100) + '%';

        // Per-section
        GROUPS.forEach(grp => {
          const { answered: a, total, pct } = computeSection(grp.key);
          document.querySelectorAll(`.section-count[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-progress[data-section="${grp.key}"]`).forEach(el => el.textContent = `${a}/${total}`);
          document.querySelectorAll(`.section-nav-item[data-section="${grp.key}"]`).forEach(el => {
            el.style.background = a === total ? '#dcfce7' : '#f1f5f9';
            el.style.color = a === total ? '#166534' : '#475569';
          });
          const bar = document.querySelector(`.domain-bar[data-section="${grp.key}"]`);
          const pctEl = document.querySelector(`.domain-percent[data-section="${grp.key}"]`);
          if (bar && pctEl) {
            if (pct === null) {
              bar.style.width = '0%'; bar.style.background = '#cbd5e1';
              pctEl.textContent = ' - '; pctEl.style.color = '#cbd5e1';
            } else {
              bar.style.width = pct + '%'; bar.style.background = barColor(pct);
              pctEl.textContent = pct + '%'; pctEl.style.color = barColor(pct);
            }
          }
        });

        // Enable PDF
        const allDone = answered === TOTAL_Q;
        const btn = document.getElementById('pdfBtn');
        btn.disabled = !allDone;
        btn.style.cursor = allDone ? 'pointer' : 'not-allowed';
        btn.style.opacity = allDone ? '1' : '0.5';
        document.getElementById('pdf-helper').textContent = allDone
          ? 'Click to generate and email your report'
          : `${TOTAL_Q - answered} question${TOTAL_Q - answered === 1 ? '' : 's'} remaining`;
      }

      // Submit to AWS Lambda
      async function submitToApi() {
        if (!API_URL) return;
        const { answered, score } = compute();
        const sectionScores = GROUPS.map(g => ({ title: g.title, ...computeSection(g.key) }));

        const lines = [];
        lines.push('=== ISO 27001 READINESS CHECKLIST SUBMISSION ===\n');
        lines.push('--- ENVIRONMENT ---');
        lines.push(`Organisation: ${env['org-name'] || ''}`);
        lines.push(`Contact: ${env['contact-name'] || ''} <${env['contact-email'] || ''}>`);
        lines.push(`Sector: ${env['org-sector'] || ''}`);
        lines.push(`Size: ${env['org-size'] || ''}`);
        lines.push(`Microsoft licensing: ${env['env-licensing'] || ''}`);
        lines.push(`Trigger: ${env['trigger'] || ''}`);
        lines.push(`Audit-ready timeline: ${env['timeline'] || ''}\n`);
        lines.push('--- SCORES ---');
        lines.push(`Overall: ${score}%  (${answered}/${TOTAL_Q} answered)`);
        sectionScores.forEach(s => lines.push(`  ${s.title}: ${s.pct === null ? 'N/A' : s.pct + '%'}`));
        lines.push('\n--- RESPONSES ---');
        QUESTIONS.forEach(q => {
          const v = state[q.id];
          const label = v === 2 ? 'YES' : v === 1 ? 'PARTIAL' : v === 0 ? 'NO' : 'UNANSWERED';
          lines.push(`[${label}] ${q.label}`);
        });

        const payload = {
          name: env['contact-name'] || env['org-name'] || 'Anonymous',
          email: env['contact-email'] || 'noreply@compliance365.com.au',
          subject: `ISO 27001 Checklist  -  ${env['org-name'] || 'Anonymous'}  -  ${score}%`,
          message: lines.join('\n'),
        };

        try {
          await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.warn('API submission failed:', err);
        }
      }

      // ===========================================================
      // PDF Generation  -  branded, multi-page, executive-ready
      // ===========================================================
      function generatePDF() {
        var jsPDFLib = window.jspdf || {};
        var jsPDF = jsPDFLib.jsPDF;
        if (!jsPDF) { alert('PDF library not loaded - please wait a moment and try again.'); return; }
        try {

        // ---- Layout ----
        var doc = new jsPDF('p','mm','a4');
        var W=210, H=297, LM=18, RM=16, CW=210-18-16;
        var y=0;

        // ---- Brand palette (matches brand.css exactly) ----
        var PRIMARY   = [30, 64, 175];    // #1e40af
        var PRIMARY_D = [30, 58, 138];    // #1e3a8a
        var PRIMARY_L = [59, 130, 246];   // #3b82f6
        var ACCENT    = [6, 182, 212];    // #06b6d4 teal
        var NAVY      = [5,  12,  28];    // very dark bg for cover
        var LIGHT     = [248,250,252];    // #f8fafc
        var BORDER    = [226,232,240];    // #e2e8f0
        var MUTED     = [100,116,139];    // #64748b
        var WHITE     = [255,255,255];
        var GREEN     = [5, 150, 105];   // emerald-600
        var GREEN_LT  = [209,250,229];   // emerald-100
        var AMBER     = [180, 110,  0];  // amber-700
        var AMBER_LT  = [255,241,194];   // amber-100
        var RED       = [200,  30,  30]; // red-700
        var RED_LT    = [255,225,225];   // red-100
        var DARK_TXT  = [17, 24, 39];     // #111827 body text

        // ---- All computed values ----
        var comp=compute(), sc=comp.score, ansCount=comp.answered, band=getBand(sc,ansCount);
        var orgName=env['org-name']||'Your Organisation';
        var sector=env['org-sector']||'', orgSize=env['org-size']||'';
        var licensing=env['env-licensing']||'', trigger=env['trigger']||'';
        var timeline=env['timeline']||'', cName=env['contact-name']||'';
        var cEmail=env['contact-email']||'';
        var safeOrg=orgName.replace(/[^a-z0-9]/gi,'-');
        var today=new Date().toLocaleDateString('en-AU',{day:'2-digit',month:'long',year:'numeric'});
        var rptId='C365-'+new Date().getFullYear()+'-'+Math.random().toString(36).substr(2,5).toUpperCase();
        var scoreCol   = sc>=75?GREEN:sc>=50?AMBER:RED;
        var scoreLt    = sc>=75?GREEN_LT:sc>=50?AMBER_LT:RED_LT;
        var scoreBand  = sc>=86?'Certification-Ready':sc>=61?'Nearly Audit-Ready':sc>=31?'Partially Ready':'High Risk';
        var bandDesc   = sc>=86?'Focus on evidence currency and surveillance audit preparation.':sc>=61?'Close identified gaps and tighten evidence packaging.':sc>=31?'An 8-12 week focused programme would close priority gaps.':'A 12-16 week programme is recommended before pursuing certification.';
        var logoEl=document.getElementById('pdfLogo');
        var hasLogo=logoEl&&logoEl.complete&&logoEl.naturalWidth>0;

        // ---- Full PDF group + question data ----
        var GPDF=[
          {key:'gov',      title:'Governance & ISMS Foundation',      blurb:'Scope, leadership, policy and risk methodology'},
          {key:'controls', title:'Annex A Controls & SoA',             blurb:'Controls, SoA, assets, access and supplier risk'},
          {key:'ops',      title:'Security Operations & Resilience',   blurb:'Logging, vulnerabilities, incidents and backups'},
          {key:'audit',    title:'Audit, Measurement & Improvement',   blurb:'Internal audit and management review'},
        ];
        var QPDF=[
          {id:'isms-scope',        group:'gov',      label:'ISMS scope defined and approved',                               hint:'A clear scope statement is the first thing an auditor checks. Vague or missing scope is the most common Stage 1 finding.'},
          {id:'leadership',        group:'gov',      label:'Top management visibly engaged in security governance',          hint:'Auditors want evidence security is owned at executive level, not just delegated to IT.'},
          {id:'policy',            group:'gov',      label:'Information security policies current, approved and communicated',hint:'Policies must be version-controlled, dated and demonstrably acknowledged by staff.'},
          {id:'risk-method',       group:'gov',      label:'Risk assessment methodology defined and applied consistently',   hint:'Repeatability matters. The same method should produce comparable results regardless of who runs it.'},
          {id:'risk-register',     group:'controls', label:'Live risk register with owners, treatments and review cadence',  hint:'Auditors look for a register actively maintained, not a spreadsheet last updated at certification.'},
          {id:'soa',               group:'controls', label:'Statement of Applicability complete with evidence pointers',     hint:'The SoA is the audit index. A weak SoA undermines an otherwise strong ISMS.'},
          {id:'assets',            group:'controls', label:'Information assets inventoried, classified and owned',           hint:'You need to know what you have and what matters most before you can prioritise protection.'},
          {id:'access',            group:'controls', label:'Access control governed - JML, RBAC, MFA and privileged access', hint:'Access reviews and privileged access governance are among the most heavily sampled controls.'},
          {id:'suppliers',         group:'controls', label:'Supplier security governed with risk tiering and reviews',       hint:'Supply chain risk is increasingly scrutinised after SolarWinds, Log4j and MOVEit.'},
          {id:'logging',           group:'ops',      label:'Centralised security logging and alerting in place',             hint:'Logs must support both detection and investigation. Without retention evidence, controls fail testing.'},
          {id:'vulns',             group:'ops',      label:'Repeatable vulnerability management process in place',           hint:'Auditors want to see SLAs being met or exceptions managed, not just that scanning happens.'},
          {id:'incident',          group:'ops',      label:'Incident response plan documented and tested',                   hint:'Plans that have never been tested often fail when needed. A tabletop exercise outcome is strong evidence.'},
          {id:'backups',           group:'ops',      label:'Backups configured, monitored and restore-tested',               hint:'Untested backups are not evidence. Auditors will sample restore test records.'},
          {id:'internal-audit',    group:'audit',    label:'Internal ISMS audits performed against a plan',                  hint:'Internal audit is mandatory. Must cover all clauses and a sample of Annex A controls.'},
          {id:'management-review', group:'audit',    label:'Management reviews held at planned intervals',                   hint:'Management review minutes are mandatory evidence and one of the first documents auditors request.'},
        ];

        function computeSecPDF(key){
          var qs=QPDF.filter(function(q){return q.group===key;});
          var answered=0, sum=0;
          qs.forEach(function(q){if(state[q.id]!==null){answered++;sum+=state[q.id];}});
          var pct=answered===0?null:Math.round((sum/(qs.length*2))*100);
          return {answered:answered,total:qs.length,pct:pct};
        }

        // ---- Drawing primitives ----
        function fc(c){doc.setFillColor(c[0],c[1],c[2]);}
        function tc(c){doc.setTextColor(c[0],c[1],c[2]);}
        function dc(c){doc.setDrawColor(c[0],c[1],c[2]);}
        function bf(s){doc.setFont('helvetica','bold');doc.setFontSize(s);}
        function nf(s){doc.setFont('helvetica','normal');doc.setFontSize(s);}
        function rr(x,y,w,h,r,sty){if(w>0&&h>0)doc.roundedRect(x,y,w,h,Math.min(r,w/2,h/2),Math.min(r,w/2,h/2),sty);}

        function badge(txt,bg,fg,bx,by,bw,bh){
          bh=bh||6; bw=Math.max(bw,doc.getTextWidth(txt)*0.7+10);
          fc(bg); rr(bx,by,bw,bh,1.5,'F');
          bf(7); tc(fg); doc.text(txt,bx+bw/2,by+bh*0.73,{align:'center'});
        }

        function hbar(x,by,bw,bh,pct,col){
          fc([220,228,240]); rr(x,by,bw,bh,bh/2,'F');
          if(pct>0){fc(col);rr(x,by,bw*(Math.min(pct,100)/100),bh,bh/2,'F');}
        }

        // ---- Circular score gauge ----
        function scoreGauge(cx,cy,r,pct,col,lt){
          // Outer ring track
          fc([220,228,240]); doc.circle(cx,cy,r,'F');
          // Filled arc — simulate with filled circle + white inner mask
          fc(col); doc.circle(cx,cy,r,'F');
          // White donut hole
          fc(WHITE); doc.circle(cx,cy,r*0.62,'F');
          // Score text inside
          bf(Math.round(r*1.1)); tc(col); doc.text(pct+'%',cx,cy+r*0.38,{align:'center'});
        }

        // ---- Interior page chrome ----
        function chrome(){
          // Header bar with gradient feel (two-tone)
          fc(PRIMARY_D); doc.rect(0,0,W,11,'F');
          fc(PRIMARY);   doc.rect(0,9,W,4,'F');
          // Teal accent line
          fc(ACCENT); doc.rect(0,13,W,0.8,'F');
          // Logo
          if(hasLogo){
            try{doc.addImage(logoEl,'PNG',LM,1.5,8,8,undefined,'FAST');}catch(e){}
            bf(7.5); tc(WHITE); doc.text('COMPLIANCE365',LM+11,7);
            nf(6); tc([180,220,250]); doc.text('ISO 27001:2022 Readiness Report',LM+11,11);
          } else {
            bf(8); tc(WHITE); doc.text('COMPLIANCE365',LM,7);
            nf(6); tc([180,220,250]); doc.text('ISO 27001:2022 Readiness Report',LM,11);
          }
          nf(6); tc([180,220,250]);
          doc.text(rptId+'   CONFIDENTIAL',W-RM,7,{align:'right'});
          // Footer
          dc(BORDER); doc.setLineWidth(0.2); doc.line(LM,H-10,W-RM,H-10);
          nf(6.5); tc(MUTED);
          doc.text('compliance365.com.au',LM,H-6);
          doc.text('Prepared for '+orgName,W/2,H-6,{align:'center'});
          bf(6.5); doc.text('Page '+doc.internal.getNumberOfPages(),W-RM,H-6,{align:'right'});
        }

        var PY=21;
        function np(){doc.addPage();chrome();y=PY;}
        function need(h){if(y+h>H-14)np();}

        // ---- Section heading with left accent ----
        function secHead(num,title,sub){
          need(18);
          // Number badge
          fc(PRIMARY); rr(LM,y,7,7,1,'F');
          bf(7); tc(WHITE); doc.text(num,LM+3.5,y+5,{align:'center'});
          // Title
          bf(15); tc(PRIMARY_D); doc.text(title,LM+10,y+6);
          y+=10;
          if(sub){nf(8.5);tc(MUTED);doc.text(sub,LM+10,y);y+=6;}
          // Accent underline
          fc(ACCENT); doc.rect(LM+10,y,30,0.6,'F');
          y+=5;
        }

        // ---- Stat card ----
        function statCard(cx,cy,cw,ch,label,val,col,sub){
          // Shadow feel — slightly offset dark rect
          fc([210,218,235]); rr(cx+0.8,cy+0.8,cw,ch,3,'F');
          // Card face
          fc(WHITE); rr(cx,cy,cw,ch,3,'F');
          // Colored top bar (5mm)
          fc(col); rr(cx,cy,cw,5,3,'F');
          doc.rect(cx,cy+3,cw,2,'F');
          // Label
          nf(6.5); tc(MUTED); doc.text(label.toUpperCase(),cx+cw/2,cy+12,{align:'center'});
          // Large centered value
          bf(28); tc(col); doc.text(String(val),cx+cw/2,cy+27,{align:'center'});
          // Sub label
          nf(7); tc(MUTED); doc.text(sub||'',cx+cw/2,cy+34,{align:'center'});
        }

        // =====================================================
        // COVER PAGE
        // =====================================================
        // Full-bleed dark background
        fc(NAVY); doc.rect(0,0,W,H,'F');
        // Teal accent strip top
        fc(ACCENT); doc.rect(0,0,W,3,'F');
        // Blue gradient panel (bottom 40%)
        fc(PRIMARY_D); doc.rect(0,H*0.6,W,H*0.4,'F');
        fc(PRIMARY);   doc.rect(0,H*0.65,W,H*0.35,'F');
        fc(ACCENT);    doc.rect(0,H*0.6,W,0.6,'F');

        // Right column darker panel
        fc([8,18,50]); doc.rect(W*0.62,0,W*0.38,H*0.6,'F');
        fc([15,30,80]); doc.rect(W*0.62,0,0.4,H*0.6,'F');

        // Brand mark / logo
        if(hasLogo){
          try{doc.addImage(logoEl,'PNG',LM,20,28,28,undefined,'FAST');}catch(e){}
          bf(15); tc(WHITE); doc.text('COMPLIANCE365',LM+32,30);
          nf(9); tc([160,200,255]); doc.text('Cyber | Privacy | AI Governance',LM+32,38);
        } else {
          bf(18); tc(WHITE); doc.text('COMPLIANCE365',LM,30);
          nf(10); tc([160,200,255]); doc.text('Cyber | Privacy | AI Governance',LM,39);
        }
        // CONFIDENTIAL badge (teal)
        badge('CONFIDENTIAL',ACCENT,[5,12,28],W-RM-36,18,36,6.5);

        // Main title
        nf(10); tc([160,200,255]); doc.text('READINESS ASSESSMENT REPORT',LM,72);
        fc(ACCENT); doc.rect(LM,76,24,1,'F');
        bf(40); tc(WHITE); doc.text('ISO 27001',LM,98);
        bf(18); tc([160,200,255]); doc.text(':2022',LM,110);
        nf(12); tc([130,175,235]); doc.text('Information Security',LM,120);
        nf(12); doc.text('Management System',LM,129);

        // White info card
        fc(WHITE); rr(LM,H*0.6+8,120,64,2,'F');
        // Score accent strip on card
        fc(scoreCol); doc.rect(LM,H*0.6+8,120,2,'F');

        bf(7.5); tc(MUTED); doc.text('PREPARED FOR',LM+8,H*0.6+18);
        bf(16); tc(PRIMARY_D);
        var dn=orgName.length>22?orgName.substr(0,20)+'..':orgName;
        doc.text(dn,LM+8,H*0.6+28);
        nf(8.5); tc(MUTED);
        var cr=H*0.6+36;
        if(sector){doc.text(sector,LM+8,cr);cr+=6;}
        if(orgSize){doc.text(orgSize+' FTE',LM+8,cr);cr+=6;}
        if(cName){doc.text('Contact: '+cName,LM+8,cr);}

        // Score gauge circle (right of info card)
        var gCx=LM+100, gCy=H*0.6+38, gR=18;
        // Outer ring (dark bg)
        fc([8,18,50]); doc.circle(gCx,gCy,gR+2,'F');
        // Track ring
        fc([40,60,120]); doc.circle(gCx,gCy,gR,'F');
        // Score fill circle
        fc(scoreCol); doc.circle(gCx,gCy,gR,'F');
        // White donut hole
        fc(WHITE); doc.circle(gCx,gCy,gR*0.58,'F');
        // Score % inside
        bf(14); tc(scoreCol); doc.text(sc+'%',gCx,gCy+3,{align:'center'});
        // Band label below gauge
        bf(7); tc(WHITE); doc.text(scoreBand,gCx,gCy+gR+7,{align:'center'});
        nf(6); tc([160,200,255]); doc.text(ansCount+'/'+QPDF.length+' answered',gCx,gCy+gR+13,{align:'center'});

        // Bottom metadata strip
        nf(7.5); tc([160,200,255]);
        doc.text('GENERATED',LM,H-40); doc.text('REPORT ID',LM+52,H-40); doc.text('FRAMEWORK',LM+118,H-40);
        bf(9.5); tc(WHITE);
        doc.text(today,LM,H-32); doc.text(rptId,LM+52,H-32); doc.text('ISO 27001:2022',LM+118,H-32);
        nf(7); tc([130,175,235]);
        doc.text('compliance365.com.au',LM,H-12);
        doc.text(rptId+' - CONFIDENTIAL',W-RM,H-12,{align:'right'});

        // =====================================================
        // EXECUTIVE SUMMARY
        // =====================================================
        np();
        secHead('01','Executive Summary','Your ISO 27001:2022 readiness at a glance.');

        // --- Dynamic written summary ---
        var allDom=GPDF.map(function(g){var cs=computeSecPDF(g.key);return{title:g.title,pct:cs.pct||0};}).sort(function(a,b){return b.pct-a.pct;});
        var bestDom=allDom[0], worstDom=allDom[allDom.length-1];
        var noCtrl=QPDF.filter(function(q){return state[q.id]===0;}).length;
        var partCtrl=QPDF.filter(function(q){return state[q.id]===1;}).length;
        var gF=QPDF.filter(function(q){return state[q.id]===0||state[q.id]===1;}).length;
        var sA=QPDF.filter(function(q){return state[q.id]===2;}).length;

        var execPara='';
        if(sc>=75){
          execPara=orgName+' demonstrates a strong ISO 27001:2022 posture, achieving '+sc+'% across '+QPDF.length+' assessed controls ('+scoreBand+'). '+sA+' controls are fully evidenced and operating effectively. '+gF+' item'+(gF===1?' requires':'s require')+' attention before the certification audit — primarily in the '+worstDom.title+' domain ('+worstDom.pct+'%). A targeted 4-8 week evidence packaging and pre-audit programme is recommended.';
        } else if(sc>=50){
          execPara=orgName+' has an overall ISO 27001:2022 readiness score of '+sc+'% ('+scoreBand+') across '+QPDF.length+' control areas. '+sA+' control'+(sA===1?' is':'s are')+' fully in place; '+noCtrl+' '+(noCtrl===1?'is':'are')+' not yet implemented and '+partCtrl+' are partially complete. Performance is strongest in '+bestDom.title+' ('+bestDom.pct+'%) and weakest in '+worstDom.title+' ('+worstDom.pct+'%). An 8-12 week structured uplift programme is recommended before pursuing certification.';
        } else {
          execPara=orgName+' has an overall ISO 27001:2022 readiness score of '+sc+'% ('+scoreBand+') across '+QPDF.length+' control areas. '+noCtrl+' control'+(noCtrl===1?' is':'s are')+' not in place and '+partCtrl+' are partially implemented, indicating that foundational ISMS work is required. The lowest-scoring domain is '+worstDom.title+' at '+worstDom.pct+'%, and the programme should begin with governance foundations before progressing to control implementation. A 12-16 week structured programme is recommended before certification can be pursued.';
        }

        need(24);
        fc([241,245,249]); rr(LM,y,CW,20,2,'F');
        fc(PRIMARY); doc.rect(LM,y,3,20,'F');
        nf(9); tc(DARK_TXT);
        var epLines=doc.splitTextToSize(execPara,CW-10);
        doc.text(epLines.slice(0,4),LM+7,y+5.5,{lineHeightFactor:1.6});
        y+=Math.min(4,epLines.length)*5.5+8;

        // 4 stat cards
        need(42);
        var cw4=(CW-9)/4;
        statCard(LM,         y,cw4,38,'Readiness Score',sc+'%',scoreCol,scoreBand);
        statCard(LM+cw4+3,   y,cw4,38,'Questions',ansCount+'/'+QPDF.length,PRIMARY,'Answered');
        statCard(LM+(cw4+3)*2,y,cw4,38,'Gaps Found',gF,gF>0?RED:GREEN,'Partial or missing');
        statCard(LM+(cw4+3)*3,y,cw4,38,'Strong Areas',sA,sA>0?GREEN:MUTED,'Fully in place');
        y+=44;

        // Domain tiles 2x2 — clean split layout
        need(82);
        var tw=(CW-6)/2, th=36, lAcc=3, scoreW=26;
        GPDF.forEach(function(grp,i){
          var cs=computeSecPDF(grp.key);
          var col2=cs.pct===null?MUTED:cs.pct>=75?GREEN:cs.pct>=50?AMBER:RED;
          var lt2=cs.pct>=75?GREEN_LT:cs.pct>=50?AMBER_LT:RED_LT;
          var pStr=cs.pct===null?'N/A':cs.pct+'%';
          var status=cs.pct===null?'N/A':cs.pct>=75?'STRONG':cs.pct>=50?'DEVELOPING':'NEEDS UPLIFT';
          var tx=LM+(i%2)*(tw+6), ty=y+Math.floor(i/2)*(th+5);
          var textX=tx+lAcc+5, textW=tw-lAcc-scoreW-8;
          // Shadow
          fc([210,218,235]); rr(tx+0.8,ty+0.8,tw,th,2,'F');
          // Card
          fc(WHITE); rr(tx,ty,tw,th,2,'F');
          // Top colour bar
          fc(col2); rr(tx,ty,tw,3.5,2,'F'); doc.rect(tx,ty+2,tw,1.5,'F');
          // Left accent
          fc(col2); doc.rect(tx,ty+3.5,lAcc,th-3.5,'F');
          // Score panel (right) — light fill, no text overflow
          fc(lt2); doc.rect(tx+tw-scoreW,ty+3.5,scoreW,th-3.5,'F');
          dc(BORDER); doc.setLineWidth(0.15);
          doc.line(tx+tw-scoreW,ty+3.5,tx+tw-scoreW,ty+th);
          bf(20); tc(col2); doc.text(pStr,tx+tw-scoreW/2,ty+18,{align:'center'});
          nf(5.5); tc(MUTED); doc.text('SCORE',tx+tw-scoreW/2,ty+23,{align:'center'});
          // Number circle
          fc(col2); rr(textX,ty+7,7,7,1.5,'F');
          bf(7); tc(WHITE); doc.text(String(i+1),textX+3.5,ty+12,{align:'center'});
          // Title — clamped to textW
          var titleL=doc.splitTextToSize(grp.title,textW);
          bf(9); tc(PRIMARY_D); doc.text(titleL[0],textX+10,ty+11);
          // Blurb
          var blurbL=doc.splitTextToSize(grp.blurb,textW);
          nf(6.5); tc(MUTED); doc.text(blurbL[0],textX+10,ty+16.5);
          doc.text(cs.answered+'/'+cs.total+' answered',textX+10,ty+21);
          // Progress bar — constrained to textW
          hbar(textX+10,ty+24.5,textW-4,3.5,cs.pct||0,col2);
          // Status pill — constrained width
          var sw=Math.min(doc.getTextWidth(status)*0.65+8,textW-2);
          badge(status,lt2,col2,textX+10,ty+29.5,sw,5.5);
        });
        y+=2*(th+5)+6;

        // Key finding callout
        need(26);
        // Two-tone banner: score colour left, blue right
        fc(scoreLt); rr(LM,y,CW*0.48,22,2,'F');
        fc([235,241,252]); rr(LM+CW*0.48,y,CW*0.52,22,2,'F');
        fc(scoreCol); doc.rect(LM,y,3,22,'F');
        dc(BORDER); doc.setLineWidth(0.2); rr(LM,y,CW,22,2,'S');
        bf(6.5); tc(scoreCol); doc.text('KEY FINDING',LM+7,y+6);
        var fh2=sc>=86?'Certification-ready posture':sc>=61?'Strong foundation — close remaining gaps':sc>=31?'Structured uplift programme recommended':'Material remediation required before certification';
        bf(10); tc(PRIMARY_D); doc.text(fh2,LM+7,y+13);
        nf(7.5); tc(MUTED); doc.text(bandDesc,LM+7,y+19);
        // Right: recommended timeline
        var tLabel=sc>=75?'4–8 weeks':sc>=50?'8–12 weeks':'12–16 weeks';
        bf(6.5); tc(PRIMARY); doc.text('RECOMMENDED PROGRAMME',LM+CW*0.5,y+6);
        bf(18); tc(PRIMARY_D); doc.text(tLabel,LM+CW*0.5,y+16);
        nf(7); tc(MUTED); doc.text('to certification readiness',LM+CW*0.5,y+21);
        y+=28;

        // Context table
        y+=5;
        bf(11); tc(PRIMARY_D); doc.text('Engagement Context',LM,y+6); y+=10;
        var rows=[
          ['Organisation',orgName],['Sector',sector],['Size',orgSize],
          ['M365 Licensing',licensing],['Trigger',trigger],['Timeline',timeline],
          ['Contact',cName+(cEmail?' - '+cEmail:'')],['Report Date',today]
        ];
        rows.forEach(function(r,i){
          need(8);
          if(i%2===0){fc(LIGHT);doc.rect(LM,y-1,CW,7.5,'F');}
          nf(8.5); tc(MUTED); doc.text(r[0],LM+3,y+4);
          bf(8.5); tc(DARK_TXT);
          var vl=doc.splitTextToSize(String(r[1]||'-'),CW-52);
          doc.text(vl,LM+52,y+4);
          y+=Math.max(7.5,vl.length*4.5);
        });

        // =====================================================
        // DOMAIN BREAKDOWN
        // =====================================================
        np();
        secHead('02','Domain Breakdown','Your performance across each ISMS domain.');

        GPDF.forEach(function(grp,idx){
          var cs=computeSecPDF(grp.key);
          var col3=cs.pct===null?MUTED:cs.pct>=75?GREEN:cs.pct>=50?AMBER:RED;
          var lt3=cs.pct>=75?GREEN_LT:cs.pct>=50?AMBER_LT:RED_LT;
          var pStr3=cs.pct===null?'N/A':cs.pct+'%';
          var status3=cs.pct===null?'N/A':cs.pct>=75?'STRONG':cs.pct>=50?'DEVELOPING':'NEEDS UPLIFT';
          var ch3=38;
          need(ch3+6);
          // Shadow
          fc([210,218,235]); rr(LM+0.8,y+0.8,CW,ch3,3,'F');
          // Card
          fc(WHITE); rr(LM,y,CW,ch3,3,'F');
          // Colored left panel (30% width)
          var lw=CW*0.28;
          fc(col3); rr(LM,y,lw,ch3,3,'F');
          doc.rect(LM+lw-2,y,2,ch3,'F');
          // Number circle in left panel
          fc(WHITE); doc.setFillColor(255,255,255,0.25);
          rr(LM+6,y+5,10,10,2,'F');
          fc(WHITE); bf(10); tc(col3); doc.text(String(idx+1),LM+11,y+12.5,{align:'center'});
          // Big score in left panel
          bf(28); tc(WHITE); doc.text(pStr3,LM+lw/2,y+28,{align:'center'});
          nf(7); tc(WHITE); doc.setFillColor(255,255,255);
          doc.text('OUT OF 100%',LM+lw/2,y+34,{align:'center'});
          // Right: title, blurb, bar, pill
          bf(12); tc(PRIMARY_D); doc.text(grp.title,LM+lw+8,y+10);
          nf(7.5); tc(MUTED); doc.text(grp.blurb,LM+lw+8,y+16);
          doc.text(cs.answered+'/'+cs.total+' questions answered',LM+lw+8,y+21.5);
          // Thick progress bar
          hbar(LM+lw+8,y+26,CW-lw-14,5,cs.pct||0,col3);
          // Percentage label next to bar
          nf(7.5); tc(col3); doc.text(pStr3,LM+CW-4,y+29.5,{align:'right'});
          // Status pill
          var sw4=doc.getTextWidth(status3)*0.65+10;
          badge(status3,lt3,col3,LM+lw+8,y+ch3-9,sw4,6);
          y+=ch3+6;
        });

        // =====================================================
        // TOP PRIORITY GAPS
        // =====================================================
        var gaps=[];
        QPDF.forEach(function(q){
          var v=state[q.id];
          if(v===0||v===1){
            var g=GPDF.find(function(g){return g.key===q.group;})||{title:q.group};
            gaps.push({q:q,sev:v===0?2:1,grp:g.title});
          }
        });
        gaps.sort(function(a,b){return b.sev-a.sev;});

        if(gaps.length>0){
          np();
          secHead('03','Top Priority Gaps','Highest-impact items ranked by severity. Address these first.');

          gaps.slice(0,5).forEach(function(gap,i){
            var gc=gap.sev===2?RED:AMBER;
            var gb=gap.sev===2?RED_LT:AMBER_LT;
            var sv=gap.sev===2?'CRITICAL GAP':'PARTIAL';
            var ql=doc.splitTextToSize(gap.q.label,CW-14);
            var hl=doc.splitTextToSize(gap.q.hint,CW-14);
            var bh=16+ql.length*5+hl.length*4.5+4;
            need(bh+6);
            // Card
            fc(WHITE); rr(LM,y,CW,bh,2,'F');
            dc(gc); doc.setLineWidth(0.4); rr(LM,y,CW,bh,2,'S');
            // Top strip
            fc(gc); doc.rect(LM,y,CW,2.5,'F');
            // Left accent
            fc(gc); doc.rect(LM,y,3,bh,'F');
            // Number circle
            fc(gc); rr(LM+7,y+7,8,8,1.5,'F');
            bf(8); tc(WHITE); doc.text(String(i+1),LM+11,y+12.5,{align:'center'});
            // Severity badge + group
            var sw5=doc.getTextWidth(sv)*0.7+10;
            badge(sv,gc,WHITE,LM+19,y+6,sw5,6.5);
            nf(7); tc(MUTED); doc.text(gap.grp.toUpperCase(),LM+sw5+23,y+10.5);
            // Question label
            bf(9.5); tc(PRIMARY_D); doc.text(ql,LM+19,y+16);
            // Action hint
            var hTop=y+16+ql.length*5+1;
            nf(7.5); tc([80,80,80]); doc.text(hl,LM+19,hTop);
            y+=bh+6;
          });
        }

        // =====================================================
        // 90-DAY ROADMAP
        // =====================================================
        np();
        secHead('04','90-Day Roadmap','Phased action plan calibrated to your readiness score of '+sc+'%.');

        var isLow=sc<50;
        var phases=[
          {name:'PHASE 1',weeks:'WEEKS 1 TO 4',sub:'Foundation & Governance',col:PRIMARY_D,items:isLow
            ?['Define ISMS scope and obtain leadership approval','Establish governance roles and responsibilities','Document risk methodology with criteria and appetite','Begin asset inventory and classification']
            :['Refresh ISMS scope and validate governance roles','Update risk register with current risk treatments','Validate Statement of Applicability against current scope','Confirm management review cadence and inputs']},
          {name:'PHASE 2',weeks:'WEEKS 5 TO 8',sub:'Control Implementation',col:PRIMARY,items:isLow
            ?['Implement Statement of Applicability with named owners','Stand up access control - JML process, RBAC and MFA','Establish supplier risk assessment programme','Deploy centralised logging and alerting']
            :['Close highest-priority gaps identified in this report','Verify access reviews are operating to schedule','Refresh critical supplier assessments','Run an alert review and tuning cycle']},
          {name:'PHASE 3',weeks:'WEEKS 9 TO 12',sub:'Audit Readiness',col:ACCENT,items:isLow
            ?['Conduct first internal ISMS audit - full clause coverage','Test incident response with a tabletop exercise','Validate backup restore for all critical systems','Hold management review and document all decisions']
            :['Schedule internal audit covering identified priority gaps','Run an incident response tabletop exercise','Test restore procedures and update RTO and RPO targets','Prepare evidence pack for certification audit']},
        ];

        phases.forEach(function(ph){
          var phH=12+ph.items.length*6+5;
          need(phH+4);
          // Phase header card
          fc(ph.col); rr(LM,y,CW,11,1,'F');
          bf(9); tc(WHITE); doc.text(ph.name,LM+6,y+5);
          nf(7.5); tc([200,230,255]);
          if(ph.col===ACCENT) tc([5,50,70]);
          doc.text(ph.weeks+' - '+ph.sub,W-RM-4,y+5,{align:'right'});
          y+=14;
          nf(9); tc(DARK_TXT);
          ph.items.forEach(function(item){
            need(7);
            fc(ph.col); rr(LM+4,y+2,2,2,0.5,'F');
            var il=doc.splitTextToSize(item,CW-11);
            doc.text(il,LM+9,y+4.5);
            y+=il.length*4.5+1.5;
          });
          y+=5;
        });

        // =====================================================
        // DETAILED RESPONSES
        // =====================================================
        np();
        secHead('05','Detailed Responses','Your full answer to every assessment question.');

        GPDF.forEach(function(grp){
          var cs=computeSecPDF(grp.key);
          var gc4=cs.pct===null?MUTED:cs.pct>=75?GREEN:cs.pct>=50?AMBER:RED;
          var ps4=cs.pct===null?'N/A':cs.pct+'%';
          need(12);
          // Domain header
          fc(PRIMARY_D); rr(LM,y,CW,8,1,'F');
          // Top teal strip on domain header
          fc(ACCENT); doc.rect(LM,y,CW,1.2,'F');
          bf(9); tc(WHITE); doc.text(grp.title,LM+5,y+5.5);
          tc(gc4); bf(9); doc.text(ps4,W-RM-4,y+5.5,{align:'right'});
          y+=11;

          QPDF.filter(function(q){return q.group===grp.key;}).forEach(function(q,qi){
            var v=state[q.id];
            var lbl=v===2?'YES':v===1?'PARTIAL':v===0?'NO':'-';
            var lc =v===2?GREEN:v===1?AMBER:v===0?RED:MUTED;
            var lb =v===2?GREEN_LT:v===1?AMBER_LT:v===0?RED_LT:LIGHT;
            var ql3=doc.splitTextToSize((qi+1)+'. '+q.label,CW-30);
            var rowH=Math.max(ql3.length*4.5+5,14);
            need(rowH+2);
            // Alternating row background
            if(qi%2===0){fc([245,248,252]);doc.rect(LM,y,CW,rowH,'F');}
            // Coloured left stripe by answer
            fc(lc); doc.rect(LM,y,2,rowH,'F');
            dc(BORDER); doc.setLineWidth(0.15);
            doc.line(LM,y+rowH,LM+CW,y+rowH);
            nf(8.5); tc(DARK_TXT); doc.text(ql3,LM+6,y+4.5);
            // Badge — right-aligned, vertically centred in row
            var bw3=Math.max(doc.getTextWidth(lbl)*0.7+12,20);
            var bh3=7;
            badge(lbl,lb,lc,W-RM-bw3-2,y+(rowH-bh3)/2,bw3,bh3);
            y+=rowH;
          });
          y+=5;
        });

        // =====================================================
        // NEXT STEPS
        // =====================================================
        np();
        // Full-width hero banner
        fc(PRIMARY_D); doc.rect(0,y-4,W,50,'F');
        fc(ACCENT); doc.rect(0,y-4,W,1,'F');
        fc([8,18,50]); doc.rect(W*0.55,y-4,W*0.45,51,'F');
        fc(PRIMARY); doc.rect(W*0.55,y-4,0.4,51,'F');

        bf(8); tc(ACCENT); doc.text('SECTION 06',LM,y+7);
        bf(26); tc(WHITE); doc.text("What's next?",LM,y+22);
        nf(9.5); tc([160,200,255]);
        doc.text('Three structured paths forward.',LM,y+30);
        y+=55;

        var paths=[
          {n:'01',title:'Self-led',sub:'Use this report as your action plan',feat:false,
           desc:'Use the priority gaps and 90-day roadmap as your internal action list. Free Compliance365 resources at compliance365.com.au/resources can support implementation.'},
          {n:'02',title:'Structured assessment',sub:'2-3 week formal gap assessment',feat:true,
           desc:'A senior practitioner reviews your environment, validates this self-assessment, and produces a board-ready remediation roadmap with effort estimates and fixed-price milestones.'},
          {n:'03',title:'Full certification programme',sub:'8-14 week end-to-end delivery',feat:false,
           desc:'Senior-led implementation to certification. Fixed-price, milestone-gated, audit-ready evidence at every step. 100% first-time certification pass rate.'},
        ];

        paths.forEach(function(p){
          need(36);
          var ph=32;
          fc(WHITE); rr(LM,y,CW,ph,2,'F');
          dc(BORDER); doc.setLineWidth(0.3); rr(LM,y,CW,ph,2,'S');
          // Top accent strip - primary for normal, teal for featured
          var stripCol=p.feat?ACCENT:PRIMARY;
          fc(stripCol); doc.rect(LM,y,CW,2,'F');
          // Left accent
          fc(PRIMARY); doc.rect(LM,y,2.5,ph,'F');

          if(p.feat){
            // Gold-teal featured badge, RIGHT side
            badge('RECOMMENDED',ACCENT,[5,12,28],W-RM-38,y+5,38,6);
          }

          // Option number
          bf(8); tc(PRIMARY); doc.text(p.n,LM+7,y+9);
          // Title
          bf(13); tc(PRIMARY_D); doc.text(p.title,LM+7,y+16);
          // Sub
          nf(8); tc(MUTED); doc.text(p.sub,LM+7,y+21.5);
          // Description
          nf(8); tc([60,60,80]);
          var dl=doc.splitTextToSize(p.desc,CW-14);
          doc.text(dl.slice(0,2),LM+7,y+26.5);
          y+=ph+5;
        });

        // CTA banner
        need(24);
        y+=4;
        fc(PRIMARY_D); rr(LM,y,CW,22,2,'F');
        fc(ACCENT); doc.rect(LM,y,3,22,'F');
        fc(ACCENT); doc.rect(LM,y,CW,1.5,'F');
        bf(12); tc(WHITE); doc.text('Ready to discuss your results?',LM+7,y+9);
        nf(8.5); tc([160,200,255]);
        doc.text('Book a free 30-minute call - no obligation, no sales pitch.',LM+7,y+15.5);
        bf(9); tc(ACCENT);
        doc.text('compliance365.com.au/book',W-RM-4,y+12,{align:'right'});

        doc.save('ISO27001-Readiness-'+safeOrg+'.pdf');

        } catch(err) {
          console.error('PDF error:',err);
          alert('PDF generation failed: '+err.message);
        }
      }
    })();
  </script>

  <style>
    .opt:hover:not(.active) { border-color:#1e40af !important; }
    .question.answered { background:#fafbfc; }
    @media (max-width:900px) {
      #stage-2-grid { grid-template-columns:1fr !important; }
      #score-panel { position:static !important; }
    }
  </style>
</Base>
