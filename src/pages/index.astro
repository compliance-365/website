  s.crossOrigin = 'anonymous';
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
  s.onload = init3D;
  s.onerror = function(){ /* fallback SVG already showing */ };
  document.head.appendChild(s);
  function init3D(){
    if (typeof THREE === 'undefined') return;
    try {
      var W = stage.clientWidth, H = stage.clientHeight;
      var scene = new THREE.Scene();
      var camera = new THREE.PerspectiveCamera(40, W/H, .1, 100);
      camera.position.set(0, 0, 6.4);
      var renderer = new THREE.WebGLRenderer({antialias:true,alpha:true});
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(W, H);
      stage.appendChild(renderer.domElement);
      stage.classList.add('has3d');
      var group = new THREE.Group();
      scene.add(group);
      var ARC = Math.PI * 1.72;
      var ring = new THREE.Mesh(
        new THREE.TorusGeometry(1.9, 0.13, 32, 200, ARC),
        new THREE.MeshStandardMaterial({color:0xFAF7F1,metalness:.55,roughness:.35})
      );
      ring.rotation.z = (Math.PI*2-ARC)/2;
      group.add(ring);
      var capMat = new THREE.MeshStandardMaterial({color:0xFAF7F1,metalness:.55,roughness:.35});
      [(Math.PI*2-ARC)/2,(Math.PI*2-ARC)/2+ARC].forEach(function(a){
        var c = new THREE.Mesh(new THREE.SphereGeometry(.13,24,24),capMat);
        c.position.set(Math.cos(a)*1.9,Math.sin(a)*1.9,0);
        group.add(c);
      });
      var checkpoint = new THREE.Mesh(
        new THREE.SphereGeometry(.17,32,32),
        new THREE.MeshStandardMaterial({color:0xA9812E,emissive:0xA9812E,emissiveIntensity:.55,metalness:.4,roughness:.3})
      );
      checkpoint.position.set(1.9,0,0);
      group.add(checkpoint);
      var goldLight = new THREE.PointLight(0xD8BA78,1.2,4);
      goldLight.position.set(1.9,0,.4);
      group.add(goldLight);
      var core = new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.IcosahedronGeometry(.85,1)),
        new THREE.LineBasicMaterial({color:0xA9812E,transparent:true,opacity:.28})
      );
      group.add(core);
      function badge(txt){
        var c = document.createElement('canvas'); c.width=256; c.height=80;
        var g = c.getContext('2d');
        g.fillStyle='rgba(20,20,22,.92)';
        g.strokeStyle='rgba(216,186,120,.55)'; g.lineWidth=2;
        if(g.roundRect){g.beginPath();g.roundRect(4,10,248,60,8);g.fill();g.stroke();}
        else{g.fillRect(4,10,248,60);g.strokeRect(4,10,248,60);}
        g.fillStyle='#FAF7F1'; g.font='500 26px Manrope,sans-serif';
        g.textAlign='center'; g.textBaseline='middle'; g.fillText(txt,128,41);
        var sp = new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true}));
        sp.scale.set(.95,.30,1);
        return sp;
      }
      var orbit = new THREE.Group();
      orbit.rotation.x = .42;
      group.add(orbit);
      var labels=['ISO 27001','SOC 2','ESSENTIAL 8','ISO 42001'];
      var pivots=labels.map(function(txt,i){
        var p=new THREE.Group();
        var b=badge(txt); b.position.x=2.85;
        p.add(b); p.rotation.z=i*Math.PI/2;
        orbit.add(p); return p;
      });
      orbit.add(new THREE.Mesh(
        new THREE.TorusGeometry(2.85,.0035,8,160),
        new THREE.MeshBasicMaterial({color:0xD8BA78,transparent:true,opacity:.14})
      ));
      var N=400,pos=new Float32Array(N*3);
      for(var i=0;i<N*3;i++) pos[i]=(Math.random()-.5)*13;
      var pGeo=new THREE.BufferGeometry();
      pGeo.setAttribute('position',new THREE.BufferAttribute(pos,3));
      scene.add(new THREE.Points(pGeo,new THREE.PointsMaterial({color:0xD8BA78,size:.015,transparent:true,opacity:.35,blending:THREE.AdditiveBlending,depthWrite:false})));
      var key=new THREE.DirectionalLight(0xFFF4E0,1.6); key.position.set(-3,4,5); scene.add(key);
      scene.add(new THREE.AmbientLight(0x404040,1.1));
      window.addEventListener('resize',function(){
        var w=stage.clientWidth,h=stage.clientHeight;
        camera.aspect=w/h; camera.updateProjectionMatrix(); renderer.setSize(w,h);
      });
      var tx=0,ty=0;
      window.addEventListener('mousemove',function(e){
        tx=(e.clientX/window.innerWidth-.5)*.5;
        ty=(e.clientY/window.innerHeight-.5)*.35;
      });
      var visible=true;
      if('IntersectionObserver' in window)
        new IntersectionObserver(function(en){visible=en[0].isIntersecting;}).observe(stage);
      var clock=new THREE.Clock();
      function tick(){
        requestAnimationFrame(tick);
        if(!visible) return;
        var t=clock.getElapsedTime();
        if(!reduced){
          group.rotation.y+=((Math.sin(t*.25)*.28+tx)-group.rotation.y)*.04;
          group.rotation.x+=((Math.sin(t*.18)*.10+ty)-group.rotation.x)*.04;
          core.rotation.y=-t*.25; core.rotation.x=t*.12;
          pivots.forEach(function(p,i){p.rotation.z=t*(.16+i*.02)+i*Math.PI/2;});
          checkpoint.material.emissiveIntensity=.45+Math.sin(t*1.6)*.18;
          goldLight.intensity=1.0+Math.sin(t*1.6)*.35;
        }
        renderer.render(scene,camera);
      }
      tick();
    } catch(e) { /* fallback SVG shows */ }
  }
})();
</script>

</Base>
