---
/* A "get your free readiness score" box for the guides, placed near the
   top of the page.

   Clarity shows visitors scroll about a third of the way down a page on
   average, so the checklist links at the foot of the guides went unseen,
   yet the one real lead of the Google Ads trial came guide → checklist.
   This puts that step where readers actually are. Question count and
   time come from src/data/checklists.js, the same data as /checklist/.
   A click is named checklist_click by BaseLayout's tracking. */
import { CHECKLISTS } from '../data/checklists.js';
import LinkedInFollow from './LinkedInFollow.astro';

const { checklist } = Astro.props;
const c = CHECKLISTS.find((x) => x.slug === checklist);
if (!c) throw new Error(`ReadinessScoreBox: no checklist "${checklist}"`);
const base = import.meta.env.BASE_URL || '/';
---

<section class="rsb-wrap" aria-label={`Free ${c.title} readiness score`}>
  <div class="container rsb-inner">
    <div class="rsb-card band-light">
      <div class="rsb-copy">
        <p class="rsb-eyebrow">Free {c.title} readiness score</p>
        <p class="rsb-head">Where does your organisation stand?</p>
        <p class="rsb-text">Answer {c.questions} questions in about {c.time.replace(' min', ' minutes')} and get your score with a prioritised PDF roadmap. No call, no obligation.</p>
      </div>
      <a href={`${base}checklist/${c.slug}/`} class="rsb-btn">Get my free score →</a>
    </div>
    <LinkedInFollow />
  </div>
</section>

<style>
  .rsb-wrap { padding: 2rem 0; }
  .rsb-inner { max-width: 900px; }
  .rsb-card { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; background: #fff; border: 2px solid #BE4A1E; border-radius: 16px; padding: 1.5rem 1.75rem; box-shadow: 0 4px 18px rgba(11,11,12,0.06); }
  .rsb-eyebrow { margin: 0 0 0.35rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent-ink); }
  .rsb-head { margin: 0 0 0.35rem; font-size: 1.2rem; font-weight: 700; color: #0B0B0C; }
  .rsb-text { margin: 0; color: var(--text-subtle); line-height: 1.55; }
  .rsb-btn { flex-shrink: 0; display: inline-flex; align-items: center; background: #BE4A1E; color: var(--on-accent); border-radius: 10px; padding: 0.85rem 1.35rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .rsb-btn:hover { background: #A63A12; }
  @media (max-width: 700px) {
    .rsb-card { flex-direction: column; align-items: stretch; text-align: center; padding: 1.35rem; }
    .rsb-btn { justify-content: center; }
  }
</style>
