---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://calendly.com/matt-nicholas-compliance365/30min';

const pageTitle = 'Compliance Consulting Locations — Brisbane, Sydney, Melbourne, Perth & Adelaide | Compliance365';
const pageDesc = 'Compliance365 delivers ISO 27001, SOC 2, Essential Eight, ISO 42001, and DISP/ISM/IRAP consulting to businesses in Brisbane, Sydney, Melbourne, Canberra, Perth, Adelaide, and across Australia — fixed-price, Microsoft 365-native.';

const cities = [
  {
    name: 'Brisbane',
    slug: 'brisbane',
    tag: 'HQ · Queensland Government & defence',
    desc: 'Compliance365 is headquartered in Brisbane, delivering ISO 27001, Essential Eight, and DISP/ISM/IRAP for Queensland Government suppliers, defence contractors, and the Brisbane tech sector.'
  },
  {
    name: 'Sydney',
    slug: 'sydney',
    tag: 'Enterprise & fintech',
    desc: 'ISO 27001 and SOC 2 readiness for Sydney SaaS, fintech, and enterprise-facing businesses navigating NSW Government and ASX-listed customer security requirements.'
  },
  {
    name: 'Melbourne',
    slug: 'melbourne',
    tag: 'Healthcare & financial services',
    desc: 'ISO 27001, ISO 27701, and Essential Eight for Melbourne healthcare providers, financial services, and Victorian Government suppliers handling sensitive personal information.'
  },
  {
    name: 'Canberra',
    slug: 'canberra',
    tag: 'Federal government & defence',
    desc: 'DISP, ISM alignment, IRAP readiness, and Essential Eight ML2 for Canberra-based Commonwealth suppliers and defence contractors operating at OFFICIAL and PROTECTED levels.'
  },
  {
    name: 'Perth',
    slug: 'perth',
    tag: 'Mining, defence & WA Government',
    desc: 'ISO 27001, Essential Eight, and DISP/IRAP for Perth mining, resources, defence, and WA Government ICT suppliers navigating procurement and cyber insurance requirements.'
  },
  {
    name: 'Adelaide',
    slug: 'adelaide',
    tag: 'AUKUS defence & space sector',
    desc: 'DISP, Essential Eight ML2, ISO 27001, and ISO 42001 for Adelaide defence contractors, AUKUS supply chain suppliers, space sector companies, and SA Government ICT providers.'
  }
];

const breadcrumbsLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.compliance365.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://www.compliance365.com.au/locations/' }
  ]
};
---

<Base title={pageTitle} description={pageDesc} schema={[breadcrumbsLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Locations', url: 'https://www.compliance365.com.au/locations/' }
  ]}
>
  <Header />

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="container">
      <p class="eyebrow">Brisbane · Sydney · Melbourne · Canberra · Perth · Adelaide · Australia-Wide</p>
      <h1 style="max-width:820px;">Compliance consulting, wherever you are in Australia.</h1>
      <p class="section-lead muted" style="max-width:720px;">
        Compliance365 is headquartered in Brisbane and works with organisations across Australia — on-site when it counts, remote where it's faster. ISO 27001, SOC 2, Essential Eight, ISO 42001, ISO 27701, and DISP/ISM/IRAP, delivered inside your existing Microsoft 365 environment.
      </p>
      <div class="hero-ctas" style="margin-top:2rem;">
        <a href={ctaUrl} class="btn btn-primary large">Book a free consultation</a>
        <a href={`${base}checklist/`} class="btn btn-outline">Free readiness checklists</a>
      </div>
    </div>
  </section>

  <!-- CITY CARDS -->
  <section class="section">
    <div class="container">
      <h2 class="center">Find your local compliance specialist</h2>
      <p class="muted center" style="max-width:720px;margin:1.5rem auto;">
        Every engagement is fixed-price, milestone-gated, and delivered the same way — wherever you're based.
      </p>

      <div class="grid-2" style="max-width:960px;margin:3rem auto 0;">
        {cities.map((city) => (
          <a href={`${base}locations/${city.slug}/`} class="card" style="text-decoration:none;color:inherit;border-left:4px solid #1e40af;">
            <h3 style="margin:0 0 .25rem;">{city.name}</h3>
            <p style="margin:0 0 .75rem;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#1e40af;">{city.tag}</p>
            <p class="muted small" style="margin:0;">{city.desc}</p>
            <p style="margin:1rem 0 0;color:#1e40af;font-weight:700;font-size:.875rem;">View {city.name} services →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AUSTRALIA-WIDE -->
  <section class="section" style="background:#f8fafc;">
    <div class="container" style="max-width:860px;text-align:center;">
      <h2>Not listed above?</h2>
      <p class="muted">
        We work with organisations across regional Australia and internationally too. Most engagement work happens remotely inside Microsoft 365, with on-site visits scheduled where they add the most value.
      </p>
      <div style="margin-top:2rem;">
        <a href={ctaUrl} class="btn btn-primary large">Book a free 30-min call</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
