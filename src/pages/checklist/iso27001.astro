            doc.setFont('helvetica', 'bold');
            doc.setFontSize(7);
            doc.text('RECOMMENDED', W - RM - 4 - fpW / 2, y + 7.5, { align: 'center' });
          }

          doc.setTextColor(...p.color);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(8);
          doc.text(p.num, LM + 6, y + 7);

          doc.setTextColor(...NAVY);
          doc.setFontSize(13);
          doc.text(p.title, LM + 6, y + 15);

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8);
          doc.setTextColor(...GREY);
          doc.text(p.sub, LM + 6, y + 20);

          doc.setTextColor(60, 60, 60);
          doc.setFontSize(8.5);
          const dLines = doc.splitTextToSize(p.desc, CONTENT_W - 12);
          doc.text(dLines, LM + 6, y + 25);

          y += 38;
        });

        // CTA banner at bottom
        ensure(28);
        y += 4;
        doc.setFillColor(...NAVY);
        doc.roundedRect(LM, y, CONTENT_W, 24, 2, 2, 'F');
        doc.setFillColor(...GOLD);
        doc.rect(LM, y, 2, 24, 'F');

        doc.setTextColor(...GOLD);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(7);
        doc.text('READY TO TALK?', LM + 6, y + 7);

        doc.setTextColor(...WHITE);
        doc.setFontSize(12);
        doc.text('Book a free 30-minute consultation', LM + 6, y + 14);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.setTextColor(...LIGHT_BLUE);
        doc.text('No sales pitch - we will tell you honestly what you need and what the fastest path looks like.', LM + 6, y + 19);

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.setTextColor(...GOLD);
        doc.text('compliance365.com.au/book', W - RM - 6, y + 14, { align: 'right' });
        doc.link(LM, y, CONTENT_W, 24, { url: 'https://compliance365.com.au/book' });

        // Save
        const safeOrg = (env['org-name'] || 'Report').replace(/[^a-z0-9]/gi, '-');
        doc.save('ISO27001-Readiness-' + safeOrg + '.pdf');
      }

    })();
  </script>

  <style>
    .opt:hover:not(.active) { border-color:#1e40af !important; }
    .question.answered { background:#fafbfc; }
    @media (max-width:900px) {
      #stage-2-grid { grid-template-columns:1fr !important; }
      #score-panel { position:static !important; }
    }
  </style>
</Base>
