---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CheckpointShot from '../../components/CheckpointShot.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import { CONSULTING_DAY_RATE, fmtAud } from '../../data/pricing.js';

const base = import.meta.env.BASE_URL || '/';
const ctaUrl = 'https://outlook.office.com/book/Compliance3652@compliance365.com.au/?ismsaljsauthenabled';
const dayRate = fmtAud(CONSULTING_DAY_RATE);

/* Compliance365's own delivery numbers: a typical internal audit takes about
   five days done the usual way, and about two and a half run in
   Checkpoint, because the workpack and evidence are already in place. */
const USUAL_DAYS = 5;
const CHECKPOINT_DAYS = 2.5;
const checkpointCost = fmtAud(CHECKPOINT_DAYS * CONSULTING_DAY_RATE);

/* What an engagement covers, in the order it runs. Every step names
   what happens in Checkpoint so the page only claims what the app does:
   the 12-month programme (riskiest areas first), the workpack pre-filled
   from the registers, and findings raised straight into Actions. */
const steps = [
  { n: 'Plan the programme',
    d: 'A 12-month internal audit programme, riskiest areas first, so findings surface while there is still time to fix them before the certification body arrives.' },
  { n: 'Prepare the workpack',
    d: 'Each audit gets a workpack in Checkpoint, pre-filled from your registers and pre-tested against your scan results, records and evidence. Each line shows what passed, what failed and a suggested result, and samples are drawn for us. We confirm every result ourselves.' },
  { n: 'Run the audit',
    d: 'We interview owners on a timetable Checkpoint builds, with calendar invites and the questions prepared, sample evidence and test that controls operate as described. Independent of the people who built and run them.' },
  { n: 'Raise and track findings',
    d: 'Nonconformities and observations go straight into your Actions register with an owner and a due date, linked back to the audit that raised them. When an action closes, Checkpoint re-tests the control to show whether the fix worked.' },
  { n: 'Report and close',
    d: 'A closing meeting pack and an audit report your auditor can read, filed as evidence automatically, and findings verified closed rather than just marked done. Between audits, the audit radar keeps checking your registers for anything an auditor would raise.' }
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Internal Audit as a Service',
  serviceType: 'Internal audit for ISO 27001, ISO 27701 and ISO 42001',
  provider: { '@type': 'Organization', name: 'Compliance365', url: 'https://www.compliance365.com.au' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  url: 'https://www.compliance365.com.au/services/internal-audit/',
  description:
    'Independent internal audits for ISO 27001, ISO 27701 and ISO 42001 management systems, planned, run and tracked in Checkpoint inside your own Microsoft 365 tenant.',
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock' }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is an internal audit mandatory for ISO 27001?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Clause 9.2 of ISO 27001 requires internal audits at planned intervals, against an audit programme, by auditors chosen to keep the process objective and impartial. A certification body will expect to see at least one completed internal audit before the Stage 2 audit. ISO 27701 and ISO 42001 have the same requirement in their own clause 9.2.'
      }
    },
    {
      '@type': 'Question',
      name: 'Can we do our own internal audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can, as long as the auditor does not audit their own work. In a small team the person who built the ISMS is usually the only one who knows it well, which makes impartiality hard to show. That is the most common reason teams bring in an independent internal auditor.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do we need Checkpoint to use this service?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The audit is planned, run and tracked in Checkpoint, which sits inside your own Microsoft 365 tenant, so the workpack, evidence and findings stay in your environment and link to the rest of your registers. Clients who already run Checkpoint themselves can buy the internal audit as consulting days.'
      }
    }
  ]
};
---

<Base
  title="Internal Audit for ISO 27001, 27701 and 42001 | Compliance365"
  description="Independent internal audits for ISO 27001, ISO 27701 and ISO 42001: planned, run and tracked in Checkpoint, inside your own Microsoft 365 tenant."
  schema={[serviceLd, faqLd]}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.compliance365.com.au/' },
    { name: 'Services', url: 'https://www.compliance365.com.au/services/' },
    { name: 'Internal audit', url: 'https://www.compliance365.com.au/services/internal-audit/' }
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="svc-hero">
    <CinematicBackground static />
    <div class="svc-hero-inner">
      <div class="svc-hero-copy">
        <p class="eyebrow">Internal audit · ISO 27001 · ISO 27701 · ISO 42001</p>
        <h1>An independent internal audit, <em>run in Checkpoint</em></h1>
        <p class="section-lead">
          Every ISO management system needs an internal audit before certification, and every year after. The auditor must not audit their own work, and in a small team that is usually the hard part.
        </p>
        <p>
          We act as your internal auditor. The programme, workpack, evidence and findings all live in Checkpoint, in your own Microsoft 365 tenant, linked to the registers they test.
        </p>

        <ul class="trust-signals">
          <li>Clause 9.2 audit programme</li>
          <li>Independent of your team</li>
          <li>About {CHECKPOINT_DAYS} days, not {USUAL_DAYS}</li>
          <li>Findings tracked to closure</li>
          <li>Data never leaves your tenant</li>
        </ul>

        <div class="hero-ctas">
          <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
          <a href={`${base}pricing/`} class="btn-hdk-ghost">See pricing →</a>
        </div>
      </div>
      <div class="svc-hero-image">
        <img src={`${base}assets/illus-internal-audit.svg`} alt="Illustration of an internal audit programme across ISO clauses 4 to 10, with findings tracked from raised to closed" width="720" height="470" loading="eager" />
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section" id="why" style="padding-top:3rem;padding-bottom:3rem;background:rgba(190, 74, 30,0.06);">
    <div class="container" style="max-width:960px;">
      <h2 class="center" style="margin-bottom:0.5rem;">Why teams bring in an internal auditor</h2>
      <div style="display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));margin-top:2rem;">
        <div class="card" style="padding:1.5rem;">
          <h3 style="margin-top:0;">It is required</h3>
          <p class="small">Clause 9.2 asks for internal audits at planned intervals against a programme. Your certification body will look for a completed one before Stage 2.</p>
        </div>
        <div class="card" style="padding:1.5rem;">
          <h3 style="margin-top:0;">It must be impartial</h3>
          <p class="small">The person who wrote the policies and runs the controls cannot credibly audit them. An outside auditor settles that question.</p>
        </div>
        <div class="card" style="padding:1.5rem;">
          <h3 style="margin-top:0;">It finds problems early</h3>
          <p class="small">A good internal audit finds the nonconformities your certification auditor would have found, while you still have time to fix them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT RUNS -->
  <section class="section" id="how">
    <div class="container" style="max-width:1000px;">
      <h2 class="center" style="margin-bottom:0.5rem;">How an engagement runs</h2>
      <p class="muted center" style="max-width:720px;margin:0.75rem auto 2.5rem;">
        Five steps, all recorded in Checkpoint so the next audit starts from where this one finished.
      </p>
      <div style="display:grid;gap:1rem;">
        {steps.map((s, i) => (
          <div class="card" style="padding:1.25rem 1.5rem;display:grid;gap:0.5rem;">
            <div style="display:flex;gap:0.75rem;align-items:baseline;flex-wrap:wrap;">
              <span class="small muted">Step {i + 1}</span>
              <h3 style="margin:0;font-size:1.05rem;">{s.n}</h3>
            </div>
            <p class="small" style="margin:0;">{s.d}</p>
          </div>
        ))}
      </div>
      <CheckpointShot id="internalAudits" label="The audit programme in Checkpoint" caption="Before fieldwork starts, the audit radar cross-checks your registers, scan results and records for what an auditor would raise. The programme underneath is your clause 9.2 record." />
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id="pricing" style="padding-top:3rem;padding-bottom:3rem;background:rgba(190, 74, 30,0.06);">
    <div class="container" style="max-width:820px;">
      <h2 class="center" style="margin-bottom:0.5rem;">What it costs</h2>
      <p class="muted center" style="max-width:720px;margin:0.75rem auto 2rem;">
        An internal audit usually takes about {USUAL_DAYS} days. Run in Checkpoint it takes about {CHECKPOINT_DAYS}, because the workpack arrives pre-filled from your registers, the evidence is already linked, and findings go straight into Actions instead of a spreadsheet.
      </p>
      <div style="display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
        <div class="card" style="padding:1.5rem;">
          <p class="eyebrow" style="margin-top:0;">The usual way</p>
          <h3 style="margin:0.25rem 0 0.5rem;">About {USUAL_DAYS} days</h3>
          <p class="small" style="margin:0;">Gathering documents, building the checklist, chasing evidence and writing up findings by hand.</p>
        </div>
        <div class="card" style="padding:1.5rem;">
          <p class="eyebrow" style="margin-top:0;">In Checkpoint</p>
          <h3 style="margin:0.25rem 0 0.5rem;">About {CHECKPOINT_DAYS} days</h3>
          <p class="small" style="margin:0;">Around {checkpointCost} at {dayRate} a day (AUD, ex GST). We confirm the days with you before anything is booked, based on the frameworks and sites in scope.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section center" id="cta">
    <div class="container" style="max-width:720px;">
      <h2>Need an internal audit before your <em>Stage 2</em>?</h2>
      <p class="muted" style="margin:1rem auto 2rem;">
        A 30-minute call. Tell us your certification date and what is in scope, and we will tell you how long the audit needs and when it should run.
      </p>
      <a href={ctaUrl} class="btn-hdk-primary">Book a 30-min call</a>
    </div>
  </section>

  <RelatedResources fw="iso27001" />

  </main>

  <Footer />
</Base>
