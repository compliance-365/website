---
import Base from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL || '/';

// Load all posts (newest first)
const posts = (await Astro.glob('../../content/blog/*.md'))
  .sort((a,b) => new Date(b.frontmatter.date || 0).getTime() - new Date(a.frontmatter.date || 0).getTime());

// Helpers
function coverUrl(img?: string) {
  if (!img) return null;
  if (/^https?:\/\//i.test(img)) return img;
  return `${base}${String(img).replace(/^\//,'')}`;
}

const slugify = (s: string) =>
  s.toLowerCase().trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const allTags = Array.from(new Set(
  posts.flatMap(p => (p.frontmatter?.tags || []) as string[])
)).sort((a,b) => a.localeCompare(b));

const canonical = Astro.url?.href || 'https://www.compliance365.com.au/blog/';
---

<Base title="Insights — Compliance365" description="Audit-ready insights on SOC 2, ISO 27001, ISO 27701, ISO 42001 and Essential Eight with practical Microsoft 365 examples.">
  <Header />

  <!-- Header / intro -->
  <section class="container section" aria-labelledby="insights-title">
    <h1 id="insights-title">Insights</h1>
    <p class="muted" style="max-width:860px">
      Practical, <strong>audit-ready guidance</strong> on <strong>SOC&nbsp;2</strong>, <strong>ISO&nbsp;27001</strong>,
      <strong>ISO&nbsp;27701</strong>, <strong>ISO&nbsp;42001</strong>, and the <strong>ACSC Essential Eight</strong> —
      with <strong>Microsoft&nbsp;365 / Azure</strong> examples you can copy into your evidence folders.
      Browse by topic or search to find <em>checklists</em>, <em>timelines</em>, and <em>implementation patterns</em>
      that pass auditor sampling.
    </p>

    <!-- Controls: search + tag pills -->
    <div class="container" style="padding:0; margin-top:18px">
      <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap">
        <label for="insights-search" class="visually-hidden">Search insights</label>
        <input
          id="insights-search"
          type="search"
          placeholder="Search (e.g. SOC 2 evidence, DPIA, Annex A)…"
          style="flex:1; min-width:260px; padding:10px 12px; border-radius:10px; border:1px solid rgba(10,18,32,.12)"
        />

        <span class="small muted" id="insights-count" aria-live="polite"></span>
      </div>

      <!-- Tag filter pills -->
      <div id="tag-pills" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:12px">
        {allTags.map((t) => {
          const slug = slugify(t);
          return (
            <button
              type="button"
              class="pill"
              data-tag={slug}
              aria-pressed="false"
              title={`Filter by ${t}`}
              style="cursor:pointer"
            >
              {t}
            </button>
          );
        })}
        <!-- Clear pill -->
        <button type="button" class="pill" data-clear="true" title="Clear filters" style="cursor:pointer">Clear</button>
      </div>
    </div>
  </section>

  <!-- Cards -->
  <section class="container section" aria-label="Insight posts">
    <div class="grid-3" id="insights-grid" style="margin-top:16px">
      {posts.map((post) => {
        const filename = post.file.split('/').pop() || '';
        const slug = filename.replace(/\.md$/i, '');
        const href = `${base}blog/${slug}`;
        const img  = coverUrl(post.frontmatter.image);

        const tagSlugs = (post.frontmatter.tags || []).map((t: string) => slugify(t));
        const dataTags = tagSlugs.join(' ');

        return (
          <article
            class="card lift"
            data-tags={dataTags}
            data-title={(post.frontmatter.title || '').toLowerCase()}
            data-desc={(post.frontmatter.description || '').toLowerCase()}
            style="overflow:hidden; display:flex; flex-direction:column;"
          >
            {img && (
              <a href={href} style="display:block; border-radius:12px; overflow:hidden;">
                <img
                  src={img}
                  alt={post.frontmatter.title}
                  loading="lazy"
                  style="width:100%; aspect-ratio: 16/9; object-fit:cover; border:1px solid rgba(10,18,32,.06); border-radius:12px;"
                />
              </a>
            )}
            <div style="padding-top:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
              {(post.frontmatter.tags || []).slice(0,3).map((t: string) => (
                <span class="pill" aria-label={`Tagged: ${t}`}>{t}</span>
              ))}
            </div>
            <h3 style="margin:.6rem 0 .2rem">
              <a href={href} style="color:inherit; text-decoration:none">{post.frontmatter.title}</a>
            </h3>
            <p class="muted" style="margin:0 0 10px">{post.frontmatter.description}</p>
            <div style="margin-top:auto; display:flex; justify-content:space-between; align-items:center;">
              <span class="small muted">
  {post.frontmatter.date
    ? new Date(post.frontmatter.date).toLocaleDateString("en-AU", {
        day: "2-digit",
        month: "long",
        year: "numeric"
      })
    : ''}
</span>
              <a class="pill" href={href}>Read post →</a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty state -->
    <div id="no-results" style="display:none; margin-top:20px; padding:16px; border:1px dashed rgba(10,18,32,.15); border-radius:12px;">
      <strong>No insights found.</strong> Try clearing filters or using different keywords.
    </div>
  </section>

  <Footer />

  <!-- Filtering logic -->
  <script is:inline>
    (function() {
      const qs = new URLSearchParams(location.search);
      const grid = document.getElementById('insights-grid');
      const cards = Array.from(grid.querySelectorAll('article'));
      const pills = Array.from(document.querySelectorAll('#tag-pills [data-tag]'));
      const clearBtn = document.querySelector('#tag-pills [data-clear]');
      const countEl = document.getElementById('insights-count');
      const emptyEl = document.getElementById('no-results');
      const searchInput = document.getElementById('insights-search');

      const slugify = (s) => s.toLowerCase().trim()
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');

      // Initialize from URL (?tag=..., ?q=...)
      let activeTag = qs.get('tag') || '';
      let query = qs.get('q') || '';

      if (searchInput) searchInput.value = query;

      const setURL = () => {
        const url = new URL(location.href);
        if (activeTag) url.searchParams.set('tag', activeTag); else url.searchParams.delete('tag');
        if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
        history.replaceState({}, '', url);
      };

      const applyFilter = () => {
        let visible = 0;
        const q = (query || '').toLowerCase().trim();

        cards.forEach(card => {
          const tags = (card.getAttribute('data-tags') || '').split(/\s+/).filter(Boolean);
          const title = card.getAttribute('data-title') || '';
          const desc  = card.getAttribute('data-desc') || '';

          const matchesTag = !activeTag || tags.includes(activeTag);
          const matchesQ   = !q || title.includes(q) || desc.includes(q);

          const show = matchesTag && matchesQ;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        // pill ARIA pressed state
        pills.forEach(p => p.setAttribute('aria-pressed', p.getAttribute('data-tag') === activeTag ? 'true' : 'false'));

        // count + empty state
        if (countEl) countEl.textContent = visible ? `${visible} post${visible>1?'s':''}` : '';
        if (emptyEl) emptyEl.style.display = visible ? 'none' : 'block';
      };

      // Events
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          const tag = pill.getAttribute('data-tag');
          activeTag = (activeTag === tag) ? '' : tag; // toggle
          setURL();
          applyFilter();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          activeTag = '';
          query = '';
          if (searchInput) searchInput.value = '';
          setURL();
          applyFilter();
        });
      }

      if (searchInput) {
        let t;
        searchInput.addEventListener('input', () => {
          clearTimeout(t);
          t = setTimeout(() => {
            query = searchInput.value || '';
            setURL();
            applyFilter();
          }, 200);
        });
      }

      // Initial selection if ?tag provided; normalise common aliases
      if (activeTag) {
        // Map common inputs (e.g., soc2 -> soc-2)
        if (activeTag === 'soc2') activeTag = 'soc-2';
      }

      applyFilter();
    })();
  </script>
</Base>
